{
    "name": "rhetoric/spikes-types",
    "description": "Throwaway Phase 0 typeof, hydration, and property-hook spikes. Not a package.",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "tyhp/core": "@dev"
    },
    "require-dev": {
        "tyhpdef/php": "@dev"
    },
    "extra": {
        "tyhp": {
            "require": {
                "tyhpdef/php": "@dev"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Rhetoric\\Spikes\\Types\\": "build/Rhetoric/Spikes/Types/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../packages/dist/tyhp-core/805.latest"
        },
        {
            "type": "path",
            "url": "../../../packages/tyhpdef/php"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "tyhp/core": true
        }
    }
}
