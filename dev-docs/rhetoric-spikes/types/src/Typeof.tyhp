<?tyhp

namespace Rhetoric\Spikes\Types;

class Blog {}

class Post {}

class Table<T> {
    public function modelType(): \Tyhp\Type {
        return typeof(T);
    }
}

class Context {
    public function table<T>(): \Tyhp\Type {
        return typeof(T);
    }

    public \Tyhp\Type $blogs {
        get => $this->table<Blog>();
    }
}

final class TypeofProbe {
    public static function main(): void {
        echo "=== spike 3 typeof ===\n";
        echo 'php=' . \PHP_VERSION . "\n";
        Table<Blog> $blogs = new Table<Blog>();
        Table<Post> $posts = new Table<Post>();
        echo 'Table<Blog>::modelType=' . (string) $blogs->modelType() . "\n";
        echo 'Table<Post>::modelType=' . (string) $posts->modelType() . "\n";
        Context $context = new Context();
        echo 'Context::table<Blog>=' . (string) $context->table<Blog>() . "\n";
        echo 'Context::table<Post>=' . (string) $context->table<Post>() . "\n";
        echo 'hook blogs=' . (string) $context->blogs . "\n";
    }
}
