<?tyhp

namespace Rhetoric\Spikes\Expr;

type Address = struct {
    string $city = '';
    string $street = '';
};

class Blog {
    public int $id = 0;
    public string $name = '';
    public array<Post> $posts = [];
    public Address $address = new Address();
}

class Post {
    public int $id = 0;
    public int $blogId = 0;
    public ?Blog $blog = null;
    public Blog $requiredBlog;
    public string $title = '';
    public TitleBox $titleBox;
    public int $rating = 0;
    public ?\DateTimeImmutable $deletedAt = null;
    public int $ownerId = 0;

    public function __construct() {
        $this->requiredBlog = new Blog();
        $this->titleBox = new TitleBox();
    }
}

class TitleBox {
    public string $value = '';

    public function startsWith(string $prefix): bool {
        return \str_starts_with($this->value, $prefix);
    }
}
