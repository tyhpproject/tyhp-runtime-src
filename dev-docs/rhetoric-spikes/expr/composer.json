{
    "name": "rhetoric/spikes-expr",
    "description": "Throwaway Phase 0 expression-tree spikes. Not a package.",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "tyhp/core": "@dev",
        "tyhp/lambda": "@dev"
    },
    "require-dev": {
        "tyhpdef/php": "@dev"
    },
    "extra": {
        "tyhp": {
            "require": {
                "tyhpdef/php": "@dev"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Rhetoric\\Spikes\\Expr\\": "build/Rhetoric/Spikes/Expr/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../packages/dist/tyhp-core/805.latest"
        },
        {
            "type": "path",
            "url": "../../../packages/dist/tyhp-lambda/805.latest"
        },
        {
            "type": "path",
            "url": "../../../packages/tyhpdef/php"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "tyhp/core": true
        }
    }
}
