<?tyhp

namespace Rhetoric\Spikes\Expr;

use Tyhp\Expression;

class TitleProbe {
    public string $title = '';
}

function takeTitle(Expression<callable(TitleProbe): bool> $expr): Expression<callable(TitleProbe): bool> {
    return $expr;
}

function probe(): void {
    takeTitle(fn ($p) => $p->title->startsWith('x'));
}
