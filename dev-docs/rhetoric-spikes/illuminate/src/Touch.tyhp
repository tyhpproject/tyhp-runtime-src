<?tyhp

namespace Rhetoric\Spikes\Illuminate;

use Illuminate\Console\Command;
use Illuminate\Database\Connection;
use Illuminate\Database\Migrations\Migration;
use Illuminate\Database\Migrations\Migrator;
use Illuminate\Database\Query\Builder as QueryBuilder;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Database\Schema\Builder as SchemaBuilder;
use Illuminate\Pagination\CursorPaginator;
use Illuminate\Pagination\LengthAwarePaginator;
use Illuminate\Support\ServiceProvider;

function touchIlluminate(
    QueryBuilder $query,
    Connection $connection,
    SchemaBuilder $schema,
    Blueprint $table,
    Migration $migration,
    Migrator $migrator,
    Command $command,
    LengthAwarePaginator $pages,
    CursorPaginator $cursor,
): void {
    $query->where('id', '=', 1);
    $query->whereNull('deleted_at');
    $query->whereIn('id', [1, 2]);
    $connection->transaction<int>(function (): int { return 1; });
    $schema->create('posts', function (Blueprint $blueprint): void {
        $blueprint->id();
        $blueprint->string('title');
    });
    $table->integer('rating')->default(0);
    $migrator->setConnection('mysql');
    $migrator->getMigrationFiles(['/tmp/migrations']);
    $migrator->runPending([], []);
    $command->info('rhetoric');
    $pages->count();
    $cursor->count();
    bool $inside = $migration->withinTransaction;
    (void) $inside;
}

final class ProbeProvider extends ServiceProvider {
    public function register(): void {
        $this->optimizes(optimize: 'rhetoric:cache', clear: 'rhetoric:clear');
    }
}
