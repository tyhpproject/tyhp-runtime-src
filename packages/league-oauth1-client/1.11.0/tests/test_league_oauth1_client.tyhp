<?tyhp

function test_oauth1_twitter(): \League\OAuth1\Client\Server\Twitter
{
    return new \League\OAuth1\Client\Server\Twitter([
        'identifier' => 'key',
        'secret' => 'secret',
        'callback_uri' => 'https://example.com/callback',
    ]);
}

function test_oauth1_authorization_url(\League\OAuth1\Client\Server\Twitter $server): string
{
    return $server->getAuthorizationUrl('temp-token', ['oauth_callback' => 'https://example.com/callback']);
}

function test_oauth1_http_client(\League\OAuth1\Client\Server\Server $server): \GuzzleHttp\Client
{
    return $server->createHttpClient();
}

function test_oauth1_credentials(): string
{
    $creds = new \League\OAuth1\Client\Credentials\ClientCredentials();
    $creds->setIdentifier('key');
    $creds->setSecret('secret');
    $creds->setCallbackUri('https://example.com/callback');
    return $creds->getIdentifier();
}
