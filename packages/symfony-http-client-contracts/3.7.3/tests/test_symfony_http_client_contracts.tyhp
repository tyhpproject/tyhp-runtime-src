<?tyhp

function test_symfony_http_client_request(\Symfony\Contracts\HttpClient\HttpClientInterface $client): \Symfony\Contracts\HttpClient\ResponseInterface
{
    return $client->request('GET', 'https://example.com', ['timeout' => 1.0]);
}

function test_symfony_http_client_with_options(\Symfony\Contracts\HttpClient\HttpClientInterface $client): \Symfony\Contracts\HttpClient\HttpClientInterface
{
    return $client->withOptions(['base_uri' => 'https://example.com']);
}

function test_symfony_http_client_stream(\Symfony\Contracts\HttpClient\HttpClientInterface $client, \Symfony\Contracts\HttpClient\ResponseInterface $response): \Symfony\Contracts\HttpClient\ResponseStreamInterface
{
    return $client->stream($response);
}

function test_symfony_http_response_headers(\Symfony\Contracts\HttpClient\ResponseInterface $response): \Symfony\Contracts\HttpClient\HeaderMap
{
    return $response->getHeaders();
}

function test_symfony_http_response_json(\Symfony\Contracts\HttpClient\ResponseInterface $response): \Symfony\Contracts\HttpClient\JsonArray
{
    return $response->toArray();
}

function test_symfony_http_response_info_canceled(\Symfony\Contracts\HttpClient\ResponseInterface $response): bool
{
    return $response->getInfo('canceled');
}

function test_symfony_http_response_info_code(\Symfony\Contracts\HttpClient\ResponseInterface $response): int
{
    return $response->getInfo('http_code');
}

function test_symfony_http_chunk_informational(\Symfony\Contracts\HttpClient\ChunkInterface $chunk): ?\Symfony\Contracts\HttpClient\InformationalStatus
{
    return $chunk->getInformationalStatus();
}

function test_symfony_http_exception(\Symfony\Contracts\HttpClient\Exception\HttpExceptionInterface $e): \Symfony\Contracts\HttpClient\ResponseInterface
{
    return $e->getResponse();
}
