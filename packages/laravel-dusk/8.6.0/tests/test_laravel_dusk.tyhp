<?tyhp

function test_chrome_process(): \Laravel\Dusk\Chrome\ChromeProcess
{
    return new \Laravel\Dusk\Chrome\ChromeProcess();
}

function test_dusk_selector_attribute(): void
{
    \Laravel\Dusk\Dusk::selectorHtmlAttribute('dusk');
}

function test_chrome_driver_slug(): string
{
    return \Laravel\Dusk\OperatingSystem::chromeDriverSlug('linux');
}

function test_browser_visit(\Laravel\Dusk\Browser $browser): \Laravel\Dusk\Browser
{
    return $browser->visit('/');
}

function test_element_resolver_format(\Laravel\Dusk\ElementResolver $resolver): string
{
    return $resolver->format('body');
}
