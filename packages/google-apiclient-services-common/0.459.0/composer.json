{
    "name": "tyhpdef/google-apiclient-services-common-impl",
    "description": "Implementation package for tyhpdef/google-apiclient-services-common. Require tyhpdef/google-apiclient-services-common, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "0.459.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "public": "tyhpdef/google-apiclient-services-common",
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/google-apiclient": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "google/apiclient": "2.19.4"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/google-apiclient": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../google-apiclient/2.19.4"
        }
    ]
}
