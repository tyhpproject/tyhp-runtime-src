<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Shared Google model, collection, service, and resource contracts.
 */

namespace Google {
    /**
     * Iteration yields the collection_key element. Subclasses bind T.
     */
    // @overlay-against: class Collection extends \Google\Model implements \Iterator, \Countable
    partial class Collection<T = mixed> extends \Google\Model implements \Iterator, \Countable;

    // @overlay-against: class Collection extends \Google\Model implements \Iterator, \Countable
    partial class Collection {
        // @overlay-against: mixed $collection_key
        protected string $collection_key ?? 'items';

        // @overlay-against: function current(): mixed
        public function current(): T|false|null;

        // @overlay-against: function key(): mixed
        public function key(): int|string|null;

        // @overlay-against: function next(): mixed
        public function next(): T|false;

        // @overlay-against: function offsetExists(mixed $offset): bool
        public function offsetExists(int|string $offset): bool;

        // @overlay-against: function offsetGet(mixed $offset): mixed
        public function offsetGet(int|string $offset): mixed;

        // @overlay-against: function offsetSet(mixed $offset, mixed $value): void
        public function offsetSet(int|string $offset, mixed $value): void;

        // @overlay-against: function offsetUnset(mixed $offset): void
        public function offsetUnset(int|string $offset): void;
    }

    /**
     * JSON seeding, simple-object export, and array-key maps.
     */
    // @overlay-against: class Model implements \ArrayAccess
    partial class Model {
        // @overlay-against: mixed $internal_gapi_mappings
        protected array<string, string> $internal_gapi_mappings ?? [];

        // @overlay-against: mixed $modelData
        protected array<string, mixed> $modelData ?? [];

        // @overlay-against: mixed $processed
        protected array<string, bool> $processed ?? [];

        // @overlay-against: function __construct(): void
        public final function __construct(array<string, mixed> $data = []): void;

        // @overlay-against: function __isset(mixed $key): mixed
        public function __isset(string $key): bool;

        // @overlay-against: function __unset(mixed $key): mixed
        public function __unset(string $key): void;

        // @overlay-against: function assertIsArray(array $obj, string $method): mixed
        public function assertIsArray(array<int|string, mixed> $obj, string $method): void;

        // @overlay-against: function dataType(mixed $key): mixed
        protected function dataType(string $key): string|null;

        // @overlay-against: function gapiInit(): mixed
        protected function gapiInit(): void;

        // @overlay-against: function isAssociativeArray(array $array): bool
        protected function isAssociativeArray(array<int|string, mixed> $array): bool;

        // @overlay-against: function keyType(mixed $key): mixed
        protected function keyType(string $key): \__ClassName|null;

        // @overlay-against: function mapTypes(array $array): void
        protected function mapTypes(array<int|string, mixed> $array): void;

        // @overlay-against: function toSimpleObject(): mixed
        public function toSimpleObject(): \stdClass;
    }

    /**
     * Service URLs are strings. The constructor takes a client or a client config map.
     */
    // @overlay-against: class Service
    partial class Service {
        // @overlay-against: mixed $availableScopes
        public array<int, string>|null $availableScopes;

        // @overlay-against: mixed $batchPath
        public string $batchPath;

        // @overlay-against: mixed $rootUrl
        public string $rootUrl;

        // @overlay-against: mixed $rootUrlTemplate
        public string $rootUrlTemplate;

        // @overlay-against: mixed $serviceName
        public string $serviceName;

        // @overlay-against: mixed $servicePath
        public string $servicePath;

        // @overlay-against: mixed $version
        public string $version;

        // @overlay-against: function __construct(mixed $clientOrConfig): void
        public function __construct(\Google\Client|array<string, mixed> $clientOrConfig = []): void;
    }
}

namespace Google\Service {
    /**
     * One object in `\Google\Service\Exception::getErrors()`.
     */
    type ServiceError = struct {
        ?string $domain;
        ?string $reason;
        ?string $message;
        ?string $locationType;
        ?string $location;
    };

    // @overlay-against: class Exception extends \Google\Exception
    partial class Exception {
        // @overlay-against: mixed $errors
        protected array<int, ServiceError>|null $errors ?? [];

        // @overlay-against: function getErrors(): array|null
        public function getErrors(): array<int, ServiceError>|null;
    }

    /**
     * `call()` forwards a parameter map and an optional response class-string.
     */
    // @overlay-against: class Resource
    partial class Resource {
        // @overlay-against: function __construct(mixed $service, mixed $serviceName, mixed $resourceName, mixed $resource): void
        public function __construct(\Google\Service $service, string $serviceName, string $resourceName, array<string, mixed> $resource): void;

        /**
         * @param \__ClassName<T>|null $expectedClass
         * @return T|\Psr\Http\Message\RequestInterface|\Psr\Http\Message\ResponseInterface|array<string, mixed>
         */
        // @overlay-against: function call(string $name, array $arguments, string $expectedClass): mixed
        public function call<T>(string $name, array<int, array<string, mixed>> $arguments, \__ClassName<T>|null $expectedClass = null): T|\Psr\Http\Message\RequestInterface|\Psr\Http\Message\ResponseInterface|array<string, mixed>;

        // @overlay-against: function convertToArrayAndStripNulls(mixed $o): mixed
        protected function convertToArrayAndStripNulls(object|array<int|string, mixed> $o): array<int|string, mixed>;

        // @overlay-against: function createRequestUri(string $restPath, array $params): string
        public function createRequestUri(string $restPath, array<string, array<string, mixed>> $params): string;
    }
}
