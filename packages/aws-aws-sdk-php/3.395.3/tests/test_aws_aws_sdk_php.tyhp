<?tyhp

function test_aws_sdk_create_s3(): \Aws\S3\S3Client
{
    $sdk = new \Aws\Sdk(['region' => 'us-east-1', 'version' => 'latest']);
    return $sdk->createS3(['region' => 'us-east-1', 'version' => 'latest']);
}

function test_aws_result_search(\Aws\Result $result): mixed
{
    return $result->search('Contents[].Key');
}

function test_aws_s3_construct(): \Aws\S3\S3Client
{
    return new \Aws\S3\S3Client(['region' => 'us-east-1', 'version' => 'latest']);
}
