<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * URI template expansion variables use array-key maps from the PHP source.
 */

namespace GuzzleHttp\UriTemplate {
    /**
     * Variables passed to `UriTemplate::expand()`. PHP documents
     * `array<array-key, mixed>`.
     */
    type UriTemplateVariables = array<int|string, mixed>;

    /**
     * Overlay: expansion input is an array-key map, matching the PHP `@param`.
     */
    // @overlay-against: class UriTemplate
    partial class UriTemplate {
        /**
         * @param string $template RFC 6570 template.
         * @param \GuzzleHttp\UriTemplate\UriTemplateVariables $variables Values substituted into the template.
         * @throws \InvalidArgumentException When the template syntax or referenced variable shape is invalid
         * @throws \RuntimeException
         */
        // @overlay-against: function expand(string $template, array $variables): string
        public static function expand(string $template, \GuzzleHttp\UriTemplate\UriTemplateVariables $variables): string;
    }
}
