<?tyhp

function test_guzzlehttp_uri_template_expand(string $template, \GuzzleHttp\UriTemplate\UriTemplateVariables $variables): string
{
    return \GuzzleHttp\UriTemplate\UriTemplate::expand($template, $variables);
}

function test_guzzlehttp_uri_template_expand_list(): string
{
    return \GuzzleHttp\UriTemplate\UriTemplate::expand('/users/{id}', ['id' => '42']);
}
