<?tyhp

function test_chillerlan_php_qrcode_package_loads(): bool
{
    $options = new \chillerlan\QRCode\QROptions(['version' => 1]);
    array<int, int> $coefficients = [];
    $coefficients[] = 1;
    $coefficients[] = 0;
    $poly = new \chillerlan\QRCode\Common\GenericGFPoly($coefficients);
    $code = new \chillerlan\QRCode\QRCode($options);
    $code->addByteSegment('hi');
    return $poly->getCoefficients()[0] == 1;
}
