<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Coefficient lists are ints. Data segments are QRDataModeInterface values.
 * Bit buffers, luminance rows, and QR matrices use int lists.
 */

namespace chillerlan\QRCode\Common {
    // @overlay-against: class GenericGFPoly
    partial class GenericGFPoly {
        // @overlay-against: function __construct(array $coefficients, ?int $degree): void
        public function __construct(array<int, int> $coefficients, ?int $degree = null): void;
    }
}

namespace chillerlan\QRCode\Data {
    // @overlay-against: class QRData
    partial class QRData {
        // @overlay-against: function __construct(\chillerlan\Settings\SettingsContainerInterface $options, array $dataSegments): void
        public function __construct(\chillerlan\Settings\SettingsContainerInterface $options, array<int, \chillerlan\QRCode\Data\QRDataModeInterface> $dataSegments = []): void;
    }

    /**
     * Overlay: numeric matrix, or booleans when `$boolean` is true.
     */
    // @overlay-against: class QRMatrix
    partial class QRMatrix {
        // @overlay-against: function checkTypeIn(int $x, int $y, array $M_TYPES): bool
        public function checkTypeIn(int $x, int $y, array<int, int> $M_TYPES): bool;

        // @overlay-against: function matrix(?bool $boolean): array
        public function matrix(true $boolean): array<int, array<int, bool>>;

        // @overlay-against: function matrix(?bool $boolean): array
        public function matrix(false|null $boolean = null): array<int, array<int, int>>;

        // @overlay-against: function matrix(?bool $boolean): array
        public function matrix(?bool $boolean = null): array<int, array<int, int>>|array<int, array<int, bool>>;
    }

    // @overlay-against: class ReedSolomonEncoder
    partial class ReedSolomonEncoder {
        // @overlay-against: function interleaveEcBytes(\chillerlan\QRCode\Common\BitBuffer $bitBuffer): array
        public function interleaveEcBytes(\chillerlan\QRCode\Common\BitBuffer $bitBuffer): array<int, int>;
    }
}

namespace chillerlan\QRCode\Common {
    /**
     * Overlay: one version's Reed-Solomon block table.
     * Index 0 is the ECC codeword count. Index 1 is the block groups.
     */
    type VersionRsBlocks = struct {
        int 0 as $eccCodewords;
        array<int, array<int, int>> 1 as $groups;
    };

    // @overlay-against: class BitBuffer
    partial class BitBuffer {
        // @overlay-against: function getBuffer(): array
        public function getBuffer(): array<int, int>;
    }

    // @overlay-against: class LuminanceSourceAbstract implements \chillerlan\QRCode\Common\LuminanceSourceInterface
    partial class LuminanceSourceAbstract {
        // @overlay-against: function getLuminances(): array
        public function getLuminances(): array<int, int|float>;

        // @overlay-against: function getRow(int $y): array
        public function getRow(int $y): array<int, int|float>;
    }

    // @overlay-against: interface LuminanceSourceInterface
    partial interface LuminanceSourceInterface {
        // @overlay-against: function getLuminances(): array
        public function getLuminances(): array<int, int|float>;

        // @overlay-against: function getRow(int $y): array
        public function getRow(int $y): array<int, int|float>;
    }

    // @overlay-against: class MaskPattern
    partial class MaskPattern {
        // @overlay-against: function testRule1(array $matrix, int $height, int $width): int
        public static function testRule1(array<int, array<int, int|bool>> $matrix, int $height, int $width): int;

        // @overlay-against: function testRule2(array $matrix, int $height, int $width): int
        public static function testRule2(array<int, array<int, int|bool>> $matrix, int $height, int $width): int;

        // @overlay-against: function testRule3(array $matrix, int $height, int $width): int
        public static function testRule3(array<int, array<int, int|bool>> $matrix, int $height, int $width): int;

        // @overlay-against: function testRule4(array $matrix, int $height, int $width): int
        public static function testRule4(array<int, array<int, int|bool>> $matrix, int $height, int $width): int;

        // @overlay-against: function getMask(): \Closure
        public function getMask(): \Closure<callable(int, int): bool>;
    }

    // @overlay-against: class Version
    partial class Version {
        // @overlay-against: function getRSBlocks(\chillerlan\QRCode\Common\EccLevel $eccLevel): array
        public function getRSBlocks(\chillerlan\QRCode\Common\EccLevel $eccLevel): VersionRsBlocks;
    }
}

namespace chillerlan\QRCode\Decoder {
    // @overlay-against: class BitMatrix extends \chillerlan\QRCode\Data\QRMatrix
    partial class BitMatrix {
        // @overlay-against: function readCodewords(): array
        public function readCodewords(): array<int, int>;
    }

    // @overlay-against: class ReedSolomonDecoder
    partial class ReedSolomonDecoder {
        // @overlay-against: function decode(array $rawCodewords): \chillerlan\QRCode\Common\BitBuffer
        public function decode(array<int, int> $rawCodewords): \chillerlan\QRCode\Common\BitBuffer;
    }
}
