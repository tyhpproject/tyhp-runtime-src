{
    "name": "tyhpdef/symfony-maker-bundle",
    "description": "Tyhp type definitions for the Composer package symfony/maker-bundle (1.67.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.67.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-console": "@dev",
                "tyhpdef/symfony-config": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/symfony-string": "@dev",
                "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
                "tyhpdef/symfony-translation-contracts": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/symfony-event-dispatcher": "@dev",
                "tyhpdef/php-ext-dom": "@dev",
                "tyhpdef/psr-event-dispatcher": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/maker-bundle": "1.67.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/symfony-config": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/symfony-string": "@dev",
        "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
        "tyhpdef/symfony-translation-contracts": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/symfony-event-dispatcher": "@dev",
        "tyhpdef/php-ext-dom": "@dev",
        "tyhpdef/psr-event-dispatcher": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../symfony-console/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-service-contracts/3.7.3"
        },
        {
            "type": "path",
            "url": "../../symfony-string/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-event-dispatcher-contracts/3.7.1"
        },
        {
            "type": "path",
            "url": "../../symfony-translation-contracts/3.7.1"
        },
        {
            "type": "path",
            "url": "../../psr-log/3.0.2"
        },
        {
            "type": "path",
            "url": "../../psr-container/2.0.2"
        },
        {
            "type": "path",
            "url": "../../symfony-config/7.4.17"
        },
        {
            "type": "path",
            "url": "../../symfony-event-dispatcher/7.4.17"
        },
        {
            "type": "path",
            "url": "../../php-ext-dom"
        },
        {
            "type": "path",
            "url": "../../psr-event-dispatcher/1.0.0"
        }
    ]
}
