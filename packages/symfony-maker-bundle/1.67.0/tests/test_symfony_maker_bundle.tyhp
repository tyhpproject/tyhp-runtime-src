<?tyhp

function test_str_has_suffix(): bool
{
    return \Symfony\Bundle\MakerBundle\Str::hasSuffix('FooController', 'Controller');
}

function test_str_as_class_name(): string
{
    return \Symfony\Bundle\MakerBundle\Str::asClassName('featured product', 'Entity');
}

function test_make_controller_command_name(): string
{
    return \Symfony\Bundle\MakerBundle\Maker\MakeController::getCommandName();
}
