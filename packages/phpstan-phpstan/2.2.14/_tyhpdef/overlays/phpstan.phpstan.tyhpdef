    /**
     * @api
     */
    interface IdentifierRuleError extends \PHPStan\Rules\RuleError {
        public function getIdentifier(): string;
    }

    /**
     * @api
     */
    interface Rule {
        public function getNodeType(): string;

        /**
         * @return array<int, \PHPStan\Rules\IdentifierRuleError>
         */
        public function processNode(\PhpParser\Node $node, \PHPStan\Analyser\Scope $scope): array<int, \PHPStan\Rules\IdentifierRuleError>;
    }

    /**
     * @api
     */
    final class RuleErrorBuilder {
        public static function message(string $message): self;

        public function identifier(string $identifier): self;

        public function line(int $line): self;

        public function build(): \PHPStan\Rules\RuleError;
    }
}

