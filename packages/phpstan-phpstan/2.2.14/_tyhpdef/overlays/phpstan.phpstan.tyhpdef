<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Extension API copied from the extracted phpstan.phar source.
 * TrinaryLogic lazy callbacks are `callable(T): self`.
 */

namespace PHPStan {
    /**
     * Overlay: lazy folds take a list and a callback that returns TrinaryLogic.
     */
    // @overlay-against: class TrinaryLogic
    partial class TrinaryLogic {
        /**
         * @param array<int|string, T> $objects
         * @param callable(T): self $callback
         */
        // @overlay-against: function lazyAnd(array $objects, callable $callback): self
        public function lazyAnd<T>(array<int|string, T> $objects, callable(T): self $callback): self;

        /**
         * @param array<int|string, T> $objects
         * @param callable(T): self $callback
         */
        // @overlay-against: function lazyOr(array $objects, callable $callback): self
        public function lazyOr<T>(array<int|string, T> $objects, callable(T): self $callback): self;

        /**
         * @param array<int|string, T> $objects
         * @param callable(T): self $callback
         */
        // @overlay-against: function lazyExtremeIdentity(array $objects, callable $callback): self
        public static function lazyExtremeIdentity<T>(array<int|string, T> $objects, callable(T): self $callback): self;

        /**
         * @param array<int|string, T> $objects
         * @param callable(T): self $callback
         */
        // @overlay-against: function lazyMaxMin(array $objects, callable $callback): self
        public static function lazyMaxMin<T>(array<int|string, T> $objects, callable(T): self $callback): self;
    }
}

namespace PHPStan\Rules {
    /**
