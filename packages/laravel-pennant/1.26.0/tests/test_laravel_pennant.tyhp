<?tyhp

namespace App\Features {
    class NewUsers {}
}

function test_lazily_resolved_feature(): \Laravel\Pennant\LazilyResolvedFeature
{
    return new \Laravel\Pennant\LazilyResolvedFeature(\App\Features\NewUsers::class);
}

function test_feature_scopeable(\Laravel\Pennant\Contracts\FeatureScopeable $scope): mixed
{
    return $scope->toFeatureIdentifier('array');
}

function test_feature_name(): string
{
    return \Laravel\Pennant\Feature::name('new-users');
}

function test_global_scope(): string
{
    return (new \Laravel\Pennant\GlobalScope())->featureScopeSerialize();
}

function test_feature_manager(\Illuminate\Contracts\Container\Container $container): \Laravel\Pennant\FeatureManager
{
    return new \Laravel\Pennant\FeatureManager($container);
}

function test_array_driver(\Illuminate\Contracts\Events\Dispatcher $events): \Laravel\Pennant\Drivers\ArrayDriver
{
    return new \Laravel\Pennant\Drivers\ArrayDriver($events, []);
}

function test_features_purged(): \Laravel\Pennant\Events\FeaturesPurged
{
    return new \Laravel\Pennant\Events\FeaturesPurged(['new-users']);
}
