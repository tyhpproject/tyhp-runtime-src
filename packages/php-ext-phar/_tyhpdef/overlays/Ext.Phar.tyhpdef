<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Phar / PharData path → PharFileInfo iterator and ArrayAccess.
 * Metadata is mixed (any PHP value); no stable array shape.
 * Declaration order: TYHPDEF_ORDERING.md.
 */

/**
 * Overlay: `Phar::getSignature()` / `PharData::getSignature()`.
 */
type PharSignature = struct {
    string $hash;
    string $hash_type;
};

/**
 * Overlay: `webPhar()` `$mimeTypes` values.
 * `0` is `Phar::PHP`, `1` is `Phar::PHPS`; any other integer is rejected.
 */
type PharWebMime = 0|1|string;

// @overlay-against: class Phar extends \RecursiveDirectoryIterator implements \RecursiveIterator, \Iterator, \Traversable, \SeekableIterator, \Stringable, \Countable, \ArrayAccess
partial class Phar implements \RecursiveIterator<string, PharFileInfo>, \Iterator<string, PharFileInfo>, \Traversable<string, PharFileInfo>, \SeekableIterator<string, PharFileInfo>, \Stringable, \Countable, \ArrayAccess<string, PharFileInfo>;

// @overlay-against: class Phar extends \RecursiveDirectoryIterator implements \RecursiveIterator, \Iterator, \Traversable, \SeekableIterator, \Stringable, \Countable, \ArrayAccess
partial class Phar {
    // @overlay-against: function mungServer(array $variables): void
    static public function mungServer(array<int, string> $variables): void;

    // @overlay-against: function webPhar(?string $alias, ?string $index, ?string $fileNotFoundScript, array $mimeTypes, ?callable $rewrite): void
    static public function webPhar(
        ?string $alias = null,
        ?string $index = null,
        ?string $fileNotFoundScript = null,
        array<string, PharWebMime> $mimeTypes = [],
        ?callable(string): string|false $rewrite = null
    ): void;

    // @overlay-against: function buildFromDirectory(string $directory, string $pattern): array
    public function buildFromDirectory(string $directory, string $pattern = ''): array<string, string>;

    // @overlay-against: function buildFromIterator(\Traversable $iterator, ?string $baseDirectory): array
    public function buildFromIterator(\Traversable $iterator, ?string $baseDirectory = null): array<string, string>;

    // @overlay-against: function extractTo(string $directory, array|string|null $files, bool $overwrite): bool
    public function extractTo(string $directory, array<int, string>|string|null $files = null, bool $overwrite = false): bool;

    // @overlay-against: function getSignature(): array|false
    public function getSignature(): PharSignature|false;

    // @overlay-against: function offsetExists(mixed $localName): bool
    public function offsetExists(string $localName): bool;

    // @overlay-against: function offsetGet(mixed $localName): \SplFileInfo
    public function offsetGet(string $localName): PharFileInfo;

    // @overlay-against: function offsetSet(mixed $localName, mixed $value): void
    public function offsetSet(string $localName, mixed $value): void;

    // @overlay-against: function offsetUnset(mixed $localName): void
    public function offsetUnset(string $localName): void;
}

// @overlay-against: class PharData extends \RecursiveDirectoryIterator implements \RecursiveIterator, \Iterator, \Traversable, \SeekableIterator, \Stringable, \Countable, \ArrayAccess
partial class PharData implements \RecursiveIterator<string, PharFileInfo>, \Iterator<string, PharFileInfo>, \Traversable<string, PharFileInfo>, \SeekableIterator<string, PharFileInfo>, \Stringable, \Countable, \ArrayAccess<string, PharFileInfo>;

// @overlay-against: class PharData extends \RecursiveDirectoryIterator implements \RecursiveIterator, \Iterator, \Traversable, \SeekableIterator, \Stringable, \Countable, \ArrayAccess
partial class PharData {
    // @overlay-against: function mungServer(array $variables): void
    static public function mungServer(array<int, string> $variables): void;

    // @overlay-against: function webPhar(?string $alias, ?string $index, ?string $fileNotFoundScript, array $mimeTypes, ?callable $rewrite): void
    static public function webPhar(
        ?string $alias = null,
        ?string $index = null,
        ?string $fileNotFoundScript = null,
        array<string, PharWebMime> $mimeTypes = [],
        ?callable(string): string|false $rewrite = null
    ): void;

    // @overlay-against: function buildFromDirectory(string $directory, string $pattern): array
    public function buildFromDirectory(string $directory, string $pattern = ''): array<string, string>;

    // @overlay-against: function buildFromIterator(\Traversable $iterator, ?string $baseDirectory): array
    public function buildFromIterator(\Traversable $iterator, ?string $baseDirectory = null): array<string, string>;

    // @overlay-against: function extractTo(string $directory, array|string|null $files, bool $overwrite): bool
    public function extractTo(string $directory, array<int, string>|string|null $files = null, bool $overwrite = false): bool;

    // @overlay-against: function getSignature(): array|false
    public function getSignature(): PharSignature|false;

    // @overlay-against: function offsetExists(mixed $localName): bool
    public function offsetExists(string $localName): bool;

    // @overlay-against: function offsetGet(mixed $localName): \SplFileInfo
    public function offsetGet(string $localName): PharFileInfo;

    // @overlay-against: function offsetSet(mixed $localName, mixed $value): void
    public function offsetSet(string $localName, mixed $value): void;

    // @overlay-against: function offsetUnset(mixed $localName): void
    public function offsetUnset(string $localName): void;
}
