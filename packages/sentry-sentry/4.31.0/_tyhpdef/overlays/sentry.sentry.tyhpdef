        public function __construct(?\Sentry\Integration\RequestFetcherInterface $requestFetcher = null, array<string, mixed> $options = []): void;
    }
}

namespace Sentry\Tracing {
    // @overlay-against: class Span
    partial class Span {
        // @overlay-against: function getTraceContext(): array
        public function getTraceContext(): array<string, mixed>;
    }
