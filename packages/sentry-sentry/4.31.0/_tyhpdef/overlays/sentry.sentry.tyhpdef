namespace Sentry {
    /**
     * Overlay: `init()` / `ClientBuilder::create()` options.
     */
    type InitOptions = struct {
        ?bool $attach_metric_code_locations;
        ?bool $attach_stacktrace;
        ?callable $before_breadcrumb;
        ?callable $before_send;
        ?callable $before_send_check_in;
        ?callable $before_send_log;
        ?callable $before_send_transaction;
        ?bool $capture_silenced_errors;
        int|null $context_lines;
        ?bool $default_integrations;
        string|bool|\Sentry\Dsn|null $dsn;
        ?bool $enable_logs;
        ?bool $enable_metrics;
        string|null $environment;
        int|null $error_types;
        \Sentry\HttpClient\HttpClientInterface|null $http_client;
        ?bool $http_compression;
        int|float|null $http_connect_timeout;
        string|null $http_proxy;
        string|null $http_proxy_authentication;
        ?bool $http_ssl_verify_peer;
        int|float|null $http_timeout;
        ?bool $http_enable_curl_share_handle;
        ?array<int, string> $ignore_exceptions;
        ?array<int, string> $ignore_transactions;
        ?array<int, string> $in_app_exclude;
        ?array<int, string> $in_app_include;
        array<int, \Sentry\Integration\IntegrationInterface>|(callable(array<int, \Sentry\Integration\IntegrationInterface>): array<int, \Sentry\Integration\IntegrationInterface>)|null $integrations;
        \Psr\Log\LoggerInterface|null $logger;
        int|null $log_flush_threshold;
        int|null $metric_flush_threshold;
        ?int $max_breadcrumbs;
        ?string $max_request_body_size;
        ?int $max_value_length;
        int|null $org_id;
        ?array<int, string> $prefixes;
        int|float|null $profiles_sample_rate;
        callable|null $profiles_sampler;
        string|null $release;
        int|float|null $sample_rate;
        ?int $send_attempts;
        ?bool $send_default_pii;
        ?string $server_name;
        ?bool $spotlight;
        ?string $spotlight_url;
        ?bool $strict_trace_continuation;
        ?array<int, string> $tags;
        array<int, string>|null $trace_propagation_targets;
        int|float|null $traces_sample_rate;
        callable|null $traces_sampler;
        \Sentry\Transport\TransportInterface|null $transport;
    };

    // @overlay-against: function init(array $options): void
    function init(InitOptions|array<string, mixed> $options = []): void;
}

namespace Sentry\Integration {
    // @overlay-against: class RequestIntegration implements \Sentry\Integration\IntegrationInterface
    partial class RequestIntegration {
