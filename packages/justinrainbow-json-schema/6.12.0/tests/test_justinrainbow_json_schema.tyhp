<?tyhp

function test_justinrainbow_json_schema_rfc3339(): \DateTime|null
{
    return \JsonSchema\Rfc3339::createFromString('2026-09-16T12:00:00Z');
}

function test_justinrainbow_json_schema_storage(): \JsonSchema\SchemaStorage
{
    $storage = new \JsonSchema\SchemaStorage();
    $storage->addSchema('https://example.test/schema');
    return $storage;
}

function test_justinrainbow_validator_validate(): int
{
    $data = new \stdClass();
    $validator = new \JsonSchema\Validator();
    return $validator->validate($data);
}
