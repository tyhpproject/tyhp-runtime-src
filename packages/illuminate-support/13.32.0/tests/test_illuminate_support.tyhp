<?tyhp

function test_str_of(): \Illuminate\Support\Stringable
{
    return \Illuminate\Support\Str::of('tyhp');
}

function test_str_ascii(): string
{
    return \Illuminate\Support\Str::ascii('tyhp');
}

function test_class_basename(): string
{
    return class_basename(\Illuminate\Support\Str::class);
}

function test_tap_value(): mixed
{
    return tap('ok', static function (string $value): void {
    });
}

function test_optional_null(): mixed
{
    return optional(null);
}

function test_blank_empty(): bool
{
    return blank('');
}

function test_str_length(): int
{
    return \Illuminate\Support\Str::length('tyhp');
}
