<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Global helpers and Illuminate\Support functions are `fallback function`
 * because each PHP declaration is gated by `function_exists`.
 */

fallback function append_config(array<int|string, mixed> $array): array<int|string, mixed>;
fallback function blank(mixed $value): bool;
fallback function class_basename(object|string $class): string;
fallback function class_uses_recursive(object|string $class): array<string, __TraitName>;
fallback function e(\Illuminate\Contracts\Support\DeferringDisplayableValue|\Illuminate\Contracts\Support\Htmlable|\BackedEnum|string|int|float|null $value, bool $doubleEncode = true): string;
fallback function env(string $key, mixed $default = null): mixed;
fallback function filled(mixed $value): bool;
fallback function fluent<TKey extends int|string = int|string, TValue = mixed>(iterable<TKey, TValue>|object|null $value = null): \Illuminate\Support\Fluent<TKey, TValue>;
fallback function laravel_cloud(): bool;
fallback function literal(mixed ...$arguments): mixed;
fallback function object_get<TValue extends object>(TValue $object, string|null $key = null, mixed $default = null): TValue|mixed;
fallback function once<TReturnType>(callable(): TReturnType $callback): TReturnType;
fallback function optional<TValue>(TValue $value = null, callable|null $callback = null): \Illuminate\Support\Optional|null|mixed;
fallback function preg_replace_array(string $pattern, array<int, string> $replacements, string $subject): string;
fallback function retry<TValue>(int|array<int, int> $times, callable(int): TValue $callback, \Carbon\CarbonInterval|int|\Closure $sleepMilliseconds = 0, (callable(\Throwable): bool)|null $when = null): TValue;
fallback function str(null $string = null): object;
fallback function str(string $string): \Illuminate\Support\Stringable;
fallback function tap<TValue>(TValue $value, callable|null $callback = null): TValue|\Illuminate\Support\HigherOrderTapProxy<TValue>;
fallback function throw_if<TValue>(TValue $condition, \Throwable|\__ClassName<\Throwable>|\Closure|string $exception = 'RuntimeException', mixed ...$parameters): TValue;
fallback function throw_unless<TValue>(TValue $condition, \Throwable|\__ClassName<\Throwable>|\Closure|string $exception = 'RuntimeException', mixed ...$parameters): TValue;
fallback function trait_uses_recursive(object|string $trait): array<string, __TraitName>;
fallback function transform<TValue, TReturn, TDefault>(TValue $value, callable(TValue): TReturn $callback, TDefault|(callable(TValue): TDefault) $default = null): TReturn|TDefault;
fallback function windows_os(): bool;
fallback function with<TValue, TReturn = TValue>(TValue $value, callable|null $callback = null): TValue|TReturn;

namespace Illuminate\Support {
    /**
     * Overlay: `defer()` is a named callback or the deferred collection.
     */
    fallback function artisan_binary(): string;
    fallback function days(int|float $days): \Carbon\CarbonInterval;
    fallback function defer(?callable $callback = null, ?string $name = null, bool $always = false): \Illuminate\Support\Defer\DeferredCallback|\Illuminate\Support\Defer\DeferredCallbackCollection;
    fallback function hours(int|float $hours): \Carbon\CarbonInterval;
    fallback function microseconds(int|float $microseconds): \Carbon\CarbonInterval;
    fallback function milliseconds(int|float $milliseconds): \Carbon\CarbonInterval;
    fallback function minutes(int|float $minutes): \Carbon\CarbonInterval;
    fallback function months(int $months): \Carbon\CarbonInterval;
    fallback function now(\DateTimeZone|\UnitEnum|string|null $tz = null): \Illuminate\Support\Carbon;
    fallback function php_binary(): string;
    fallback function seconds(int|float $seconds): \Carbon\CarbonInterval;
    fallback function weeks(int $weeks): \Carbon\CarbonInterval;
    fallback function years(int $years): \Carbon\CarbonInterval;

    /**
     * Overlay: this package does not require `tyhpdef/nesbot-carbon`, so
     * `\Carbon\Carbon` is an extern. A full replace drops that extends
     * (header-only `partial` would keep it). Subclass methods stay.
     */
    // @overlay-against: class Carbon extends \Carbon\Carbon implements \Illuminate\Support\Traits\Conditionable, \Illuminate\Support\Traits\Dumpable
    class Carbon {
        use \Illuminate\Support\Traits\Conditionable, \Illuminate\Support\Traits\Dumpable;
        // @overlay-against: function setTestNow(mixed $testNow): void
        public static function setTestNow(mixed $testNow = null): void;
        // @overlay-against: function createFromId(\Ramsey\Uuid\Uuid|\Symfony\Component\Uid\Ulid|string $id): static
        public static function createFromId(\Ramsey\Uuid\Uuid|\Symfony\Component\Uid\Ulid|string $id): static;
        // @overlay-against: function plus(int $years, int $months, int $weeks, int $days, int $hours, int $minutes, int $seconds, int $microseconds, ?bool $overflow): static
        public function plus(int $years = 0, int $months = 0, int $weeks = 0, int $days = 0, int $hours = 0, int $minutes = 0, int $seconds = 0, int $microseconds = 0, ?bool $overflow = null): static;
        // @overlay-against: function minus(int $years, int $months, int $weeks, int $days, int $hours, int $minutes, int $seconds, int $microseconds, ?bool $overflow): static
        public function minus(int $years = 0, int $months = 0, int $weeks = 0, int $days = 0, int $hours = 0, int $minutes = 0, int $seconds = 0, int $microseconds = 0, ?bool $overflow = null): static;
    }

    /**
     * Overlay: `length()` is a character count.
     */
    // @overlay-against: class Str implements \Illuminate\Support\Traits\Macroable
    partial class Str {
        // @overlay-against: function length(string $value, string|null $encoding): mixed
        public static function length(string $value, string|null $encoding = null): int;
    }
}

namespace Illuminate\Support\Facades {
    /**
     * Overlay: Queue fake helpers after Testing\Fakes\QueueFake is omitted
     * (it extends illuminate/queue, which this package does not require).
     */
    // @overlay-against: class Queue extends \Illuminate\Support\Facades\Facade
    partial class Queue {
        // @overlay-against: function fake(array|string $jobsToFake): \Illuminate\Support\Testing\Fakes\QueueFake
        public static function fake(array|string $jobsToFake = []): mixed;
        // @overlay-against: function fakeExcept(array|string $jobsToAllow): \Illuminate\Support\Testing\Fakes\QueueFake
        public static function fakeExcept(array<int, string>|string $jobsToAllow): mixed;
        // @overlay-against: function except(array|string $jobsToBeQueued): \Illuminate\Support\Testing\Fakes\QueueFake
        public static function except(array|string $jobsToBeQueued): mixed;
        // @overlay-against: function serializeAndRestore(bool $serializeAndRestore): \Illuminate\Support\Testing\Fakes\QueueFake
        public static function serializeAndRestore(bool $serializeAndRestore): mixed;
        // @overlay-against: function beforePushing(callable $callback): \Illuminate\Support\Testing\Fakes\QueueFake
        public static function beforePushing(callable $callback): mixed;
        // @overlay-against: function afterPushing(callable $callback): \Illuminate\Support\Testing\Fakes\QueueFake
        public static function afterPushing(callable $callback): mixed;
    }
}

namespace Illuminate\Support\Testing\Fakes {
    // @overlay-against: class BatchFake extends \Illuminate\Bus\Batch
    omit class BatchFake {};
    // @overlay-against: class BatchRepositoryFake implements \Illuminate\Bus\BatchRepository
    omit class BatchRepositoryFake {};
    // @overlay-against: class PendingBatchFake extends \Illuminate\Bus\PendingBatch implements \Illuminate\Support\Traits\ReflectsClosures
    omit class PendingBatchFake {};
    // @overlay-against: class PendingChainFake extends \Illuminate\Foundation\Bus\PendingChain
    omit class PendingChainFake {};
    // @overlay-against: class PendingMailFake extends \Illuminate\Mail\PendingMail
    omit class PendingMailFake {};
    // @overlay-against: class QueueFake extends \Illuminate\Queue\QueueManager implements \Illuminate\Support\Testing\Fakes\Fake, \Illuminate\Contracts\Queue\Queue, \Illuminate\Queue\Attributes\ReadsQueueAttributes, \Illuminate\Support\Traits\ReflectsClosures
    omit class QueueFake {};
}

