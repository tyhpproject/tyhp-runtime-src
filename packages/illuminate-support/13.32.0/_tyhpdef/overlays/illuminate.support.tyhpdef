        public static function dd(\Closure|array<int, callable> $benchmarkables, int $iterations = 1): never;
        // @overlay-against: function measure(\Closure|array $benchmarkables, int $iterations): array|float
        public static function measure(\Closure|array<int, callable> $benchmarkables, int $iterations = 1): array<int, float|int|null>|float;
        // @overlay-against: function value(callable $callback): array
        public static function value<TReturn extends mixed>(callable $callback): (struct { TReturn '0' as $item0; float '1' as $item1; });
