namespace Laravel\Cashier {
    // @overlay-against: class Cashier
    partial class Cashier {
        /**
         * Overlay: the default customer model is a model class name.
         */
        // @overlay-against: string $customerModel
        public static __ClassName<\Illuminate\Database\Eloquent\Model> $customerModel ?? 'App\\Models\\User';

        /**
         * Overlay: the subscription item model is a model class name.
         */
        // @overlay-against: string $subscriptionItemModel
        public static __ClassName<\Illuminate\Database\Eloquent\Model> $subscriptionItemModel ?? \Laravel\Cashier\SubscriptionItem::class;

        /**
         * Overlay: the subscription model is a model class name.
         */
        // @overlay-against: string $subscriptionModel
        public static __ClassName<\Illuminate\Database\Eloquent\Model> $subscriptionModel ?? \Laravel\Cashier\Subscription::class;

        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function formatAmount(int $amount, ?string $currency, ?string $locale, array $options): string
        public static function formatAmount(int $amount, ?string $currency = null, ?string $locale = null, array<string, mixed> $options = []): string;

        /**
         * Overlay: `formatAmount()` invokes the callback with the amount, currency, locale, and options.
         */
        // @overlay-against: function formatCurrencyUsing(callable $callback): void
        public static function formatCurrencyUsing(callable(int, ?string, ?string, array<string, mixed>): string $callback): void;

        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function stripe(array $options): \Stripe\StripeClient
        public static function stripe(array<string, mixed> $options = []): \Stripe\StripeClient;
    }

    /**
     * Overlay: documented array shape.
     */
    type InvoiceInvoiceLineItemsParams = struct {
        ?string $ending_before;
        ?array<int, string> $expand;
        ?int $limit;
        ?string $starting_after;
    };

    /**
     * Overlay: documented array shape.
     */
    type SubscriptionBuilderWithBillingThresholdsThresholds = struct {
        int|null $amount_gte;
        bool|null $reset_billing_cycle_anchor;
    };

