<?tyhp

function test_symfony_cache_get(\Symfony\Contracts\Cache\CacheInterface $cache): string
{
    return $cache->get('key', function (\Psr\Cache\CacheItemInterface $item, bool $save): string {
        return 'value';
    });
}

function test_symfony_cache_delete(\Symfony\Contracts\Cache\CacheInterface $cache, string $key): bool
{
    return $cache->delete($key);
}

function test_symfony_cache_item_tag(\Symfony\Contracts\Cache\ItemInterface $item): \Symfony\Contracts\Cache\ItemInterface
{
    return $item->tag(['users', 'list']);
}

function test_symfony_cache_item_metadata(\Symfony\Contracts\Cache\ItemInterface $item): \Symfony\Contracts\Cache\CacheItemMetadata
{
    return $item->getMetadata();
}

function test_symfony_cache_invalidate_tags(\Symfony\Contracts\Cache\TagAwareCacheInterface $cache): bool
{
    return $cache->invalidateTags(['users']);
}

function test_symfony_cache_namespace(\Symfony\Contracts\Cache\NamespacedPoolInterface $pool): \Symfony\Contracts\Cache\NamespacedPoolInterface
{
    return $pool->withSubNamespace('tenant');
}
