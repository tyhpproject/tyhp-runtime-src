<?tyhp

function test_league_uri_new(): \League\Uri\Uri
{
    return \League\Uri\Uri::new('https://example.com/path');
}

function test_league_uri_try_new(): ?\League\Uri\Uri
{
    return \League\Uri\Uri::tryNew('https://example.com');
}

function test_league_http_factory(): \Psr\Http\Message\UriInterface
{
    return (new \League\Uri\HttpFactory())->createUri('https://example.com/x');
}

function test_league_uri_scheme(): \League\Uri\UriScheme
{
    return \League\Uri\UriScheme::Https;
}
