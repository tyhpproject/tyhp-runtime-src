<?tyhp

function test_money_construct(): \Money\Money
{
    return new \Money\Money(100, new \Money\Currency('USD'));
}

function test_money_add(\Money\Money $a, \Money\Money $b): \Money\Money
{
    return $a->add($b);
}

function test_money_amount(\Money\Money $m): string
{
    return $m->getAmount();
}
