<?tyhp

function test_psr_simple_cache_get_default_string(\Psr\SimpleCache\CacheInterface $cache): string
{
    return $cache->get('missing', 'fallback');
}

function test_psr_simple_cache_set_with_ttl(\Psr\SimpleCache\CacheInterface $cache, string $key, mixed $value): bool
{
    return $cache->set($key, $value, 60) && $cache->set($key, $value, new \DateInterval('PT1M')) && $cache->set($key, $value, null);
}

function test_psr_simple_cache_get_multiple(\Psr\SimpleCache\CacheInterface $cache): iterable<string, int>
{
    return $cache->getMultiple(['a', 'b'], 0);
}

function test_psr_simple_cache_set_multiple(\Psr\SimpleCache\CacheInterface $cache): bool
{
    return $cache->setMultiple(['a' => 1, 'b' => 2], 30);
}

function test_psr_simple_cache_delete_has_clear(\Psr\SimpleCache\CacheInterface $cache, string $key): bool
{
    return $cache->has($key) && $cache->delete($key) && $cache->deleteMultiple([$key]) && $cache->clear();
}

function test_psr_simple_cache_invalid_argument(\Psr\SimpleCache\InvalidArgumentException $e): \Psr\SimpleCache\CacheException
{
    return $e;
}
