        public function __construct(__ClassName<\Symfony\Component\Uid\Uuid>|int $defaultClass = \Symfony\Component\Uid\UuidV7::class, __ClassName<\Symfony\Component\Uid\Uuid>|int $timeBasedClass = \Symfony\Component\Uid\UuidV7::class, __ClassName<\Symfony\Component\Uid\Uuid>|int $nameBasedClass = \Symfony\Component\Uid\UuidV5::class, __ClassName<\Symfony\Component\Uid\Uuid>|int $randomBasedClass = \Symfony\Component\Uid\UuidV4::class, \Symfony\Component\Uid\Uuid|string|null $timeBasedNode = null, \Symfony\Component\Uid\Uuid|string|null $nameBasedNamespace = null): void;
