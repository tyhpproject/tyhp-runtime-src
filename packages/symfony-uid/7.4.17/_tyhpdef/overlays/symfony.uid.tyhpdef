<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * HashableInterface omitted from Layer 1 (conditional `ext-ds` / `@internal`); omit console commands.
 * Factory `$class` arguments are class-strings. `UuidFactory` also accepts a numeric UUID version.
 */

namespace Symfony\Component\Uid {
    /**
     * Overlay: `AbstractUid` implements this `@internal` interface; harvest skipped the conditional declaration.
     * Fallback branch (no `ext-ds`) declares `equals` and `hash`.
     */
    interface HashableInterface {
        public function equals(mixed $other): bool;

        public function hash(): string;
    }

    /**
     * Overlay: `1 << n` format flags harvested as `mixed`. Values match `Uuid.php`.
     * `isValid` reads an optional format mask via `func_get_arg` (not in the reflected signature).
     */
    // @overlay-against: class Uuid extends \Symfony\Component\Uid\AbstractUid
    partial class Uuid {
        // @overlay-against: const mixed FORMAT_BASE_32
        public const int FORMAT_BASE_32 ?? 2;

        // @overlay-against: const mixed FORMAT_BASE_58
        public const int FORMAT_BASE_58 ?? 4;

        // @overlay-against: const mixed FORMAT_RFC_4122
        public const int FORMAT_RFC_4122 ?? 8;

        // @overlay-against: const mixed FORMAT_RFC_9562
        public const int FORMAT_RFC_9562 ?? 8;

        /**
         * @param int $format Bitmask of `FORMAT_*`. Default is `FORMAT_RFC_9562`.
         */
        // @overlay-against: function isValid(string $uuid): bool
        public static function isValid(string $uuid, int $format = 8): bool;
    }
}

