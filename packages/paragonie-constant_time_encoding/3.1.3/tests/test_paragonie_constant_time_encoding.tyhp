<?tyhp

function test_base64_encode(): string
{
    return \ParagonIE\ConstantTime\Base64::encode('hi');
}

function test_base64_decode(): string
{
    return \ParagonIE\ConstantTime\Base64::decode('aGk=');
}

function test_hex_encode(): string
{
    return \ParagonIE\ConstantTime\Hex::encode('hi');
}
