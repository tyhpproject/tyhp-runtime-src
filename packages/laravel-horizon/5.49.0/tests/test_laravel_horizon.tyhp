<?tyhp

function test_horizon_job_payload(): \Laravel\Horizon\JobPayload
{
    return new \Laravel\Horizon\JobPayload('{"uuid":"1","displayName":"App\\\\Jobs\\\\Example"}');
}

function test_horizon_job_payload_id(): string
{
    return (new \Laravel\Horizon\JobPayload('{"id":"job-1"}'))->id();
}

function test_horizon_php_binary_path(): string
{
    return \Laravel\Horizon\PhpBinary::path();
}

function test_horizon_master_supervisor_name(): string
{
    return \Laravel\Horizon\MasterSupervisor::name();
}

function test_horizon_script_variables(): array
{
    return \Laravel\Horizon\Horizon::scriptVariables();
}
