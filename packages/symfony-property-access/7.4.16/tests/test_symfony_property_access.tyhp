<?tyhp

function test_property_access_get(): mixed
{
    $accessor = \Symfony\Component\PropertyAccess\PropertyAccess::createPropertyAccessor();
    return $accessor->getValue(['name' => 'Ada'], '[name]');
}

function test_property_access_readable(): bool
{
    $accessor = \Symfony\Component\PropertyAccess\PropertyAccess::createPropertyAccessor();
    return $accessor->isReadable(['name' => 'Ada'], '[name]');
}
