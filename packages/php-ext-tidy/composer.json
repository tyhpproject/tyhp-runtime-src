{
    "name": "tyhpdef/php-ext-tidy",
    "description": "Tyhp type definitions for the PHP tidy extension (8.2+). Version-specific APIs are gated via declare(php=\u2026) / #[\\Tyhp\\Php] (Story 20.5).",
    "keywords": ["dev", "static analysis"],
    "type": "library",
    "license": "Apache-2.0",
    "version": "0.1",
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "supported-minors": [
                "8.2",
                "8.3",
                "8.4",
                "8.5"
            ],
            "extensions": [
                "tidy"
            ],
            "require": {
                "tyhpdef/php": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-tidy": "*"
    },
    "require-dev": {
        "tyhpdef/php": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php"
        }
    ]
}
