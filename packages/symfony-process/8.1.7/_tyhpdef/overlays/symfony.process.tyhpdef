        /**
         * @param \Symfony\Component\Process\ProcessOutputCallback|null $callback
         */
        // @overlay-against: function wait(callable|null $callback): int
        public function wait(?\Symfony\Component\Process\ProcessOutputCallback $callback = null): int;

        /**
         * Native `waitUntil` requires a callable; PHPDoc allows null. Match the native signature plus the bool return.
         */
        // @overlay-against: function waitUntil(callable|null $callback): bool
        public function waitUntil(\Symfony\Component\Process\ProcessWaitUntilCallback $callback): bool;
    

        /**
