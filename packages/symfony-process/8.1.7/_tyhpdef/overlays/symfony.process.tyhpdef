        // @overlay-against: function run(callable|null $callback, \Symfony\Component\Process\ProcessEnvArray $env): int
        public function run(?\Symfony\Component\Process\ProcessOutputCallback $callback = null, \Symfony\Component\Process\ProcessEnvArray $env = []): int;

        /**
