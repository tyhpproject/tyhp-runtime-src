namespace Symfony\Component\Process {
    /**
     * argv-style command. List literals infer `array<int|string, string>`.
     */
    type CommandArgv = array<int|string, string>;

    /**
     * STDOUT/STDERR callback from PHPDoc `(callable('out'|'err', string):void)|null`.
     */
    type ProcessOutputCallback = callable(string, string): void;

    /**
     * `waitUntil` PHPDoc `(callable('out'|'err', string):bool)`.
     */
    type ProcessWaitUntilCallback = callable(string, string): bool;

    /**
     * Overlay: suffix and extra-dir lists are strings. Harvest left bare `array`.
     */
    // @overlay-against: class ExecutableFinder
    partial class ExecutableFinder {
        /**
         * @param array<int, string> $suffixes
         */
        // @overlay-against: function setSuffixes(array $suffixes): void
        public function setSuffixes(array<int, string> $suffixes): void;

        /**
         * @param array<int, string> $extraDirs
         */
        // @overlay-against: function find(string $name, ?string $default, array $extraDirs): ?string
        public function find(string $name, ?string $default = null, array<int, string> $extraDirs = []): ?string;
    }

    /**
     * Overlay: PHPDoc `list<non-empty-string>`. Harvest left `array<int, mixed>`.
     */
    // @overlay-against: class PhpExecutableFinder
    partial class PhpExecutableFinder {
        /**
         * @return array<int, string>
         */
        // @overlay-against: function findArguments(): array
        public function findArguments(): array<int, string>;
    }

