<?tyhp

function test_process_argv(): int
{
    $process = new \Symfony\Component\Process\Process(['php', '-v'], null, ['LANG' => 'C']);
    return $process->run();
}

function test_process_shell(): string
{
    $process = \Symfony\Component\Process\Process::fromShellCommandline('echo hello');
    $process->run();
    return $process->getOutput();
}

function test_process_php_finder(): string|false
{
    return (new \Symfony\Component\Process\PhpExecutableFinder())->find();
}
