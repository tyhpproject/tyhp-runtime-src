<?tyhp

function test_jsonlint_lint_ok(): null|\Seld\JsonLint\ParsingException
{
    $parser = new \Seld\JsonLint\JsonParser();
    return $parser->lint('{"a":1}');
}

function test_jsonlint_parse(): mixed
{
    $parser = new \Seld\JsonLint\JsonParser();
    return $parser->parse('{"a":1}', \Seld\JsonLint\JsonParser::PARSE_TO_ASSOC);
}
