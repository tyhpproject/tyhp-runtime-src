namespace DanHarrin\LivewireRateLimiting {
    /**
     * Overlay: attempt counts and decay are ints; the method name is a string; the component is an object.
     */
    // @overlay-against: trait WithRateLimiting
    partial trait WithRateLimiting {
        // @overlay-against: function clearRateLimiter(mixed $method, mixed $component): mixed
        protected function clearRateLimiter(?string $method = null, object|null $component = null): void;

        // @overlay-against: function getRateLimitKey(mixed $method, mixed $component): mixed
        protected function getRateLimitKey(?string $method, object|null $component = null): string;

        // @overlay-against: function hitRateLimiter(mixed $method, mixed $decaySeconds, mixed $component): mixed
        protected function hitRateLimiter(?string $method = null, int $decaySeconds = 60, object|null $component = null): void;

        // @overlay-against: function isRateLimited(mixed $maxAttempts, mixed $method, mixed $component): mixed
        protected function isRateLimited(int $maxAttempts, ?string $method = null, object|null $component = null): bool;

        // @overlay-against: function rateLimit(mixed $maxAttempts, mixed $decaySeconds, mixed $method, mixed $component): mixed
        protected function rateLimit(int $maxAttempts, int $decaySeconds = 60, ?string $method = null, object|null $component = null): void;
    }
}

namespace DanHarrin\LivewireRateLimiting\Exceptions {
    /**
     * Overlay: component, method, IP, and seconds-until-available match the thrown values.
     */
    // @overlay-against: class TooManyRequestsException extends \Symfony\Component\HttpKernel\Exception\HttpException
    partial class TooManyRequestsException {
        // @overlay-against: mixed $component
        public object $component;

        // @overlay-against: mixed $ip
        public string $ip;

        // @overlay-against: mixed $method
        public string $method;

        // @overlay-against: mixed $minutesUntilAvailable
        public int $minutesUntilAvailable;

        // @overlay-against: mixed $secondsUntilAvailable
        public int $secondsUntilAvailable;

        // @overlay-against: function __construct(mixed $component, mixed $method, mixed $ip, mixed $secondsUntilAvailable): void
        public function __construct(object $component, string $method, string $ip, int $secondsUntilAvailable): void;
    }
}
