<?tyhp

function test_mailable(): \Illuminate\Mail\Mailable
{
    return new \Illuminate\Mail\Mailable();
}

function test_mailable_address(): \Illuminate\Mail\Mailables\Address
{
    return new \Illuminate\Mail\Mailables\Address('ada@example.com', 'Ada');
}

function test_mailable_envelope(): \Illuminate\Mail\Mailables\Envelope
{
    return new \Illuminate\Mail\Mailables\Envelope(null, [], [], [], [], 'Hello');
}

function test_mailable_content(): \Illuminate\Mail\Mailables\Content
{
    return new \Illuminate\Mail\Mailables\Content();
}

function test_array_transport(): \Illuminate\Mail\Transport\ArrayTransport
{
    return new \Illuminate\Mail\Transport\ArrayTransport();
}

function test_mailer(\Illuminate\Contracts\View\Factory $views): \Illuminate\Mail\Mailer
{
    return new \Illuminate\Mail\Mailer('array', $views, new \Illuminate\Mail\Transport\ArrayTransport());
}

function test_attachment_from_path(): \Illuminate\Mail\Attachment
{
    return \Illuminate\Mail\Attachment::fromPath('/tmp/mail.txt');
}
