<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * EnumMap key/value parameters, and serialize hooks that always throw.
 */

namespace DASPRiD\Enum {
    /**
     * Serialize and clone are rejected. `__callStatic` forwards to `valueOf`.
     */
    // @overlay-against: class AbstractEnum
    partial class AbstractEnum {
        /**
         * @param array<int|string, mixed> $arguments
         */
        // @overlay-against: function __callStatic(string $name, array $arguments): self
        public static final function __callStatic(string $name, array<int|string, mixed> $arguments): self;

        // @overlay-against: function __clone(): mixed
        public final function __clone(): never;

        // @overlay-against: function __serialize(): array
        public final function __serialize(): never;

        // @overlay-against: function __sleep(): array
        public final function __sleep(): never;

        // @overlay-against: function __unserialize(mixed $arg): void
        public final function __unserialize(mixed $arg): never;
    }

    /**
     * Key type is an AbstractEnum class-string. Values are instances of `$valueType`.
     */
    // @overlay-against: class EnumMap implements \Serializable, \IteratorAggregate
    partial class EnumMap<TKey extends \DASPRiD\Enum\AbstractEnum = \DASPRiD\Enum\AbstractEnum, TValue extends object = object> implements \IteratorAggregate<TKey, TValue>;

    /**
     * Map operations follow `TKey` / `TValue`. `get` is null when the key is absent
     * or stored as null.
     */
    // @overlay-against: class EnumMap implements \Serializable, \IteratorAggregate
    partial class EnumMap {
        /**
         * @param \__ClassName<TKey> $keyType
         * @param \__ClassName<TValue> $valueType
         */
        // @overlay-against: function __construct(string $keyType, string $valueType, bool $allowNullValues): void
        public function __construct(\__ClassName<TKey> $keyType, \__ClassName<TValue> $valueType, bool $allowNullValues): void;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function __serialize(): array
        public function __serialize(): array<string, mixed>;

        /**
         * @param array<string, mixed> $data
         */
        // @overlay-against: function __unserialize(array $data): void
        public function __unserialize(array<string, mixed> $data): void;

        // @overlay-against: function containsKey(\DASPRiD\Enum\AbstractEnum $key): bool
        public function containsKey(TKey $key): bool;

        // @overlay-against: function containsValue(mixed $value): bool
        public function containsValue(TValue|null $value): bool;

        /**
         * @param \__ClassName<TKey> $keyType
         * @param \__ClassName<TValue> $valueType
         */
        // @overlay-against: function expect(string $keyType, string $valueType, bool $allowNullValues): void
        public function expect(\__ClassName<TKey> $keyType, \__ClassName<TValue> $valueType, bool $allowNullValues): void;

        // @overlay-against: function get(\DASPRiD\Enum\AbstractEnum $key): mixed
        public function get(TKey $key): TValue|null;

        // @overlay-against: function getIterator(): \Traversable
        public function getIterator(): \Traversable<TKey, TValue>;

        // @overlay-against: function put(\DASPRiD\Enum\AbstractEnum $key, mixed $value): mixed
        public function put(TKey $key, TValue|null $value): TValue|null;

        // @overlay-against: function remove(\DASPRiD\Enum\AbstractEnum $key): mixed
        public function remove(TKey $key): TValue|null;

        // @overlay-against: function unserialize(mixed $serialized): void
        public function unserialize(string $serialized): void;

        /**
         * @return array<int|string, TValue>
         */
        // @overlay-against: function values(): array
        public function values(): array<int|string, TValue>;
    }

    /**
     * Clone and serialize are rejected.
     */
    // @overlay-against: class NullValue
    partial class NullValue {
        // @overlay-against: function __clone(): mixed
        public final function __clone(): never;

        // @overlay-against: function __serialize(): array
        public final function __serialize(): never;

        // @overlay-against: function __sleep(): array
        public final function __sleep(): never;

        // @overlay-against: function __unserialize(mixed $arg): void
        public final function __unserialize(mixed $arg): never;
    }
}
