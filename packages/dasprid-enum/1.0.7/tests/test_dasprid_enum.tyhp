<?tyhp

function test_enum_value_of(\DASPRiD\Enum\AbstractEnum $e): \DASPRiD\Enum\AbstractEnum
{
    return $e::valueOf($e->name());
}

function test_enum_name(\DASPRiD\Enum\AbstractEnum $e): string
{
    return $e->name();
}

function test_enum_ordinal(\DASPRiD\Enum\AbstractEnum $e): int
{
    return $e->ordinal();
}
