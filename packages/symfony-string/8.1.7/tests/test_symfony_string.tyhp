<?tyhp

function test_string_unicode_contains(): bool
{
    $s = new \Symfony\Component\String\UnicodeString('Hello Tyhp');
    return $s->containsAny(['Tyhp', 'PHP']);
}

function test_string_byte_after(): string
{
    return (string) (new \Symfony\Component\String\ByteString('foo/bar'))->after('/');
}

function test_string_slugger(): string
{
    $slugger = new \Symfony\Component\String\Slugger\AsciiSlugger('en');
    $slugger->setLocale('en');
    return (string) $slugger->slug('Hello World');
}

function test_string_inflector(\Symfony\Component\String\Inflector\InflectorInterface $inflector): string
{
    $forms = $inflector->pluralize('child');
    return $forms[0];
}
