<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Needle lists on AbstractString (PHPDoc `string|string[]`) plus AsciiSlugger (omitted from Layer 1).
 * Same public tightenings as this version's Layer 1. __serialize is a string map; __sleep is not on this version.
 */

namespace Symfony\Component\String {

    /**
     * Callback passed to LazyString::fromCallable, or a [Closure, method] lazy-callable.
     */
    type LazyStringCallback = (callable(mixed ...): string)|array<int, \Closure|string>;

    /**
     * preg_match / preg_match_all result. Symfony always sets PREG_UNMATCHED_AS_NULL.
     * Bitwise OR of the PREG_* constants is not a literal, so it stays on this union.
     */
    type MatchResult = array<int|string, string|null>|array<int|string, \Symfony\Component\String\PregMatchOffset|null>|array<int|string, array<int, string|null>>|array<int, array<int|string, string|null>>|array<int|string, array<int, \Symfony\Component\String\PregMatchOffset|null>>|array<int, array<int|string, \Symfony\Component\String\PregMatchOffset|null>>;

    /**
     * One string or a list of strings used as search needles / suffixes.
     * Tyhp encoding of PHPDoc `string|string[]`; harvest left `string|iterable`.
     */
    type NeedleList = string|iterable<int|string, string>;

    /**
     * One capture from preg_match with PREG_OFFSET_CAPTURE. Unmatched groups are null.
     */
    type PregMatchOffset = struct {
        string|null 0 as $text;
        int 1 as $offset;
    };

    /**
     * preg_replace_callback passed to replaceMatches. The subject string is the replacement when $to is a string.
     */
    type ReplaceMatchesCallback = callable(array<int|string, string>): string;


