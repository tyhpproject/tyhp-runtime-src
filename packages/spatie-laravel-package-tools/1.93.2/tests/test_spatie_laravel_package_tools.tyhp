<?tyhp

function test_package_name(): string
{
    return (new \Spatie\LaravelPackageTools\Package())->name('laravel-tools')->shortName();
}

function test_package_set_base_path(): \Spatie\LaravelPackageTools\Package
{
    return (new \Spatie\LaravelPackageTools\Package())->setBasePath('/tmp/pkg');
}
