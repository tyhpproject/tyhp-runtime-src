<?tyhp

function test_fqsen_new(): \phpDocumentor\Reflection\Fqsen
{
    return new \phpDocumentor\Reflection\Fqsen('\\Foo\\Bar');
}

function test_fqsen_name(\phpDocumentor\Reflection\Fqsen $fqsen): string
{
    return $fqsen->getName();
}

function test_fqsen_string(\phpDocumentor\Reflection\Fqsen $fqsen): string
{
    return (string) $fqsen;
}

function test_location(): \phpDocumentor\Reflection\Location
{
    return new \phpDocumentor\Reflection\Location(10, 4);
}
