<?tyhp

function test_serializable_closure_new(): \Laravel\SerializableClosure\SerializableClosure
{
    return new \Laravel\SerializableClosure\SerializableClosure(static fn (): int => 1);
}

function test_serializable_closure_get(): \Closure
{
    return (new \Laravel\SerializableClosure\SerializableClosure(static fn (): int => 1))->getClosure();
}

function test_serializable_unsigned(): \Laravel\SerializableClosure\UnsignedSerializableClosure
{
    return \Laravel\SerializableClosure\SerializableClosure::unsigned(static fn (): string => 'ok');
}

function test_serializable_secret(): void
{
    \Laravel\SerializableClosure\SerializableClosure::setSecretKey('secret');
}

function test_serializable_hmac_sign(\Laravel\SerializableClosure\Signers\Hmac $hmac): \Laravel\SerializableClosure\Contracts\ClosureSignature
{
    return $hmac->sign('payload');
}
