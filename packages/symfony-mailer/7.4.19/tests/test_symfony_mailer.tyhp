<?tyhp

function test_mailer_transport_from_dsn(): \Symfony\Component\Mailer\Transport\TransportInterface
{
    return \Symfony\Component\Mailer\Transport::fromDsn('null://null');
}

function test_mailer_send(\Symfony\Component\Mailer\MailerInterface $mailer): void
{
    $email = (new \Symfony\Component\Mime\Email())
        ->from('from@example.com')
        ->to('to@example.com')
        ->subject('Hello')
        ->text('plain');
    $mailer->send($email);
}

function test_mailer_construct_and_envelope(): \Symfony\Component\Mailer\Envelope
{
    $transport = \Symfony\Component\Mailer\Transport::fromDsn('null://null');
    $mailer = new \Symfony\Component\Mailer\Mailer($transport);
    $email = (new \Symfony\Component\Mime\Email())
        ->from('from@example.com')
        ->to('to@example.com')
        ->subject('Hello')
        ->text('plain');
    $mailer->send($email);
    $envelope = \Symfony\Component\Mailer\Envelope::create($email);
    return $envelope;
}
