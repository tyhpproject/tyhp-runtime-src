{
    "name": "tyhpdef/driftingly-rector-laravel",
    "description": "Tyhp type definitions for the Composer package driftingly/rector-laravel (2.6.2).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.6.2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": "8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/rector-rector": "@dev",
                "tyhpdef/nikic-php-parser": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "driftingly/rector-laravel": "2.6.2"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/rector-rector": "@dev",
        "tyhpdef/nikic-php-parser": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../laravel-framework/13.32.0"
        },
        {
            "type": "path",
            "url": "../../rector-rector/2.6.7"
        },
        {
            "type": "path",
            "url": "../../nikic-php-parser/5.9.0"
        }
    ]
}
