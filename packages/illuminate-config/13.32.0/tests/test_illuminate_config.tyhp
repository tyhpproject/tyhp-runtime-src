<?tyhp

function test_config_has(): bool
{
    $repo = new \Illuminate\Config\Repository(['app' => ['name' => 'tyhp']]);
    return $repo->has('app.name');
}

function test_config_string(): string
{
    $repo = new \Illuminate\Config\Repository(['app' => ['name' => 'tyhp']]);
    return $repo->string('app.name');
}

function test_config_collection(): \Illuminate\Support\Collection<int|string, mixed>
{
    $repo = new \Illuminate\Config\Repository(['items' => [1, 2, 3]]);
    return $repo->collection('items');
}

function test_config_all(): array<string, mixed>
{
    $repo = new \Illuminate\Config\Repository(['a' => 1]);
    return $repo->all();
}
