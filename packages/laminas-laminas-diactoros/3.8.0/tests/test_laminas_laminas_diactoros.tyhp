<?tyhp

function test_laminas_request(): \Psr\Http\Message\RequestInterface
{
    return new \Laminas\Diactoros\Request('https://example.com', 'GET');
}

function test_laminas_response(): \Psr\Http\Message\ResponseInterface
{
    return new \Laminas\Diactoros\Response('php://memory', 204);
}

function test_laminas_uri(): \Psr\Http\Message\UriInterface
{
    return new \Laminas\Diactoros\Uri('https://example.com/path');
}

function test_laminas_server_request(): \Psr\Http\Message\ServerRequestInterface
{
    return new \Laminas\Diactoros\ServerRequest(['REQUEST_METHOD' => 'GET'], [], 'https://example.com', 'GET');
}

function test_laminas_request_factory(): \Psr\Http\Message\RequestInterface
{
    return (new \Laminas\Diactoros\RequestFactory())->createRequest('POST', 'https://example.com');
}
