<?tyhp

function test_stripe_client(): \Stripe\StripeClient
{
    return new \Stripe\StripeClient('sk_test_tyhp');
}

function test_stripe_set_api_key(): void
{
    \Stripe\Stripe::setApiKey('sk_test_tyhp');
}

function test_stripe_get_api_key(\Stripe\StripeClient $client): ?string
{
    return $client->getApiKey();
}
