<?tyhp

function test_http_client_create(): \Symfony\Contracts\HttpClient\HttpClientInterface
{
    return \Symfony\Component\HttpClient\HttpClient::create();
}

function test_http_client_mock_request(): \Symfony\Contracts\HttpClient\ResponseInterface
{
    $client = new \Symfony\Component\HttpClient\MockHttpClient();
    return $client->request('GET', 'https://example.test/');
}
