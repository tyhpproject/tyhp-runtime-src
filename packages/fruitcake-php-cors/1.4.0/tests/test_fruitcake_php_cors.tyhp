<?tyhp

function test_fruitcake_php_cors_construct(): \Fruitcake\Cors\CorsService
{
    return new \Fruitcake\Cors\CorsService();
}

function test_fruitcake_php_cors_set_options(\Fruitcake\Cors\CorsService $cors, \Fruitcake\Cors\CorsServiceCorsInputOptions $options): void
{
    $cors->setOptions($options);
}

function test_fruitcake_php_cors_is_cors(\Fruitcake\Cors\CorsService $cors): bool
{
    $request = \Symfony\Component\HttpFoundation\Request::create('https://example.com/api', 'GET');
    return $cors->isCorsRequest($request);
}

function test_fruitcake_php_cors_is_preflight(\Fruitcake\Cors\CorsService $cors, \Symfony\Component\HttpFoundation\Request $request): bool
{
    return $cors->isPreflightRequest($request);
}

function test_fruitcake_php_cors_handle_preflight(\Fruitcake\Cors\CorsService $cors, \Symfony\Component\HttpFoundation\Request $request): \Symfony\Component\HttpFoundation\Response
{
    return $cors->handlePreflightRequest($request);
}

function test_fruitcake_php_cors_add_actual(\Fruitcake\Cors\CorsService $cors, \Symfony\Component\HttpFoundation\Request $request): \Symfony\Component\HttpFoundation\Response
{
    $response = new \Symfony\Component\HttpFoundation\Response('ok', 200);
    return $cors->addActualRequestHeaders($response, $request);
}

function test_fruitcake_php_cors_is_origin_allowed(\Fruitcake\Cors\CorsService $cors, \Symfony\Component\HttpFoundation\Request $request): bool
{
    return $cors->isOriginAllowed($request);
}

function test_fruitcake_php_cors_vary(\Fruitcake\Cors\CorsService $cors, \Symfony\Component\HttpFoundation\Response $response): \Symfony\Component\HttpFoundation\Response
{
    return $cors->varyHeader($response, 'Origin');
}

function test_fruitcake_php_cors_invalid_option(): \Fruitcake\Cors\Exceptions\InvalidOptionException
{
    return new \Fruitcake\Cors\Exceptions\InvalidOptionException('bad option');
}
