<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Route maps, method/scheme lists, match parameters, compiled-route tables, unwrapped-peer omits, @internal loader traits.
 */

namespace Symfony\Component\Routing {
    /**
     * Tyhp encoding of vendor `string|string[]` for HTTP methods or URI schemes.
     */
    type MethodOrSchemeList = string|array<int|string, string>;

    /**
     * Route::__serialize payload. Schemes and methods are stored as string lists. Requirement values are sanitized to strings.
     */
    type RouteState = struct {
        string $path;
        string $host;
        array<string, mixed> $defaults;
        array<string, string> $requirements;
        array<string, mixed> $options;
        array<int, string> $schemes;
        array<int, string> $methods;
        string $condition;
        ?\Symfony\Component\Routing\CompiledRoute $compiled;
    };

    /**
     * `Alias::getDeprecation()` package, version, and message.
     */
    type AliasDeprecation = struct {
        string $package;
        string $version;
        string $message;
    };

    /**
     * Route name => Route.
     */
    type RouteMap = array<string, \Symfony\Component\Routing\Route>;

    /**
     * One traced route-match attempt (`log`, `name`, `level`, `path`).
     */
    type RouteMatchTrace = struct {
        string $log;
        ?string $name;
        int $level;
        ?string $path;
    };

    /**
     * `Router::setOptions()` keys. Every field is optional; omitted keys keep the Router defaults.
     */
    type RouterOptions = struct {
        ?string $cache_dir;
        ?bool $debug;
        ?__ClassName<\Symfony\Component\Routing\Generator\UrlGeneratorInterface> $generator_class;
        ?__ClassName<\Symfony\Component\Routing\Generator\Dumper\GeneratorDumperInterface> $generator_dumper_class;
        ?__ClassName<\Symfony\Component\Routing\Matcher\UrlMatcherInterface> $matcher_class;
        ?__ClassName<\Symfony\Component\Routing\Matcher\Dumper\MatcherDumperInterface> $matcher_dumper_class;
        ?string $resource_type;
        ?bool $strict_requirements;
    };

    /**
     * Tyhp encoding: defaults/requirements/options are string-keyed maps; methods/schemes use `MethodOrSchemeList`.
     */
    // @overlay-against: class Route
    partial class Route {
        /**
         * @param array<string, mixed> $defaults
         * @param array<string, string|\Stringable> $requirements
         * @param array<string, mixed> $options
         * @param \Symfony\Component\Routing\MethodOrSchemeList $schemes
         * @param \Symfony\Component\Routing\MethodOrSchemeList $methods
         */
        // @overlay-against: function __construct(string $path, array $defaults, array $requirements, array $options, ?string $host, string|array $schemes, string|array $methods, ?string $condition): void
        public function __construct(
            string $path,
            array<string, mixed> $defaults = [],
            array<string, string|\Stringable> $requirements = [],
            array<string, mixed> $options = [],
            ?string $host = '',
            \Symfony\Component\Routing\MethodOrSchemeList $schemes = [],
            \Symfony\Component\Routing\MethodOrSchemeList $methods = [],
            ?string $condition = ''
        ): void;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function getDefaults(): array
        public function getDefaults(): array<string, mixed>;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function getOptions(): array
        public function getOptions(): array<string, mixed>;

        /**
         * @return array<string, string|\Stringable>
         */
        // @overlay-against: function getRequirements(): array
        public function getRequirements(): array<string, string|\Stringable>;

        /**
         * @param \Symfony\Component\Routing\MethodOrSchemeList $methods
         */
        // @overlay-against: function setMethods(string|array $methods): static
        public function setMethods(\Symfony\Component\Routing\MethodOrSchemeList $methods): static;

        /**
         * @param \Symfony\Component\Routing\MethodOrSchemeList $schemes
         */
        // @overlay-against: function setSchemes(string|array $schemes): static
        public function setSchemes(\Symfony\Component\Routing\MethodOrSchemeList $schemes): static;

        // @overlay-against: function __serialize(): array
        public function __serialize(): \Symfony\Component\Routing\RouteState;
    

        /**
         * @param string|array<string> $schemes
         * @param string|array<string> $methods
         */
        // @overlay-against: function __construct(string $path, array $defaults, array $requirements, array $options, ?string $host, string|array $schemes, string|array $methods, ?string $condition): void
        public function __construct(string $path, array<string, mixed> $defaults = [], array<string, string|\Stringable> $requirements = [], array<string, mixed> $options = [], ?string $host = '', \Symfony\Component\Routing\MethodOrSchemeList $schemes = [], \Symfony\Component\Routing\MethodOrSchemeList $methods = [], ?string $condition = ''): void;

        /**
         * @return array<string>
         */
        // @overlay-against: function getMethods(): array
        public function getMethods(): array<int, string>;

        /**
         * @return array<string>
         */
        // @overlay-against: function getSchemes(): array
        public function getSchemes(): array<int, string>;

        /**
         * @param array<string, mixed> $defaults
         */
        // @overlay-against: function addDefaults(array $defaults): static
        public function addDefaults(array<string, mixed> $defaults): static;

        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function addOptions(array $options): static
        public function addOptions(array<string, mixed> $options): static;

        /**
         * @param array<string, string|\Stringable> $requirements
         */
        // @overlay-against: function addRequirements(array $requirements): static
        public function addRequirements(array<string, string|\Stringable> $requirements): static;

        /**
         * @param array<string, mixed> $defaults
         */
        // @overlay-against: function setDefaults(array $defaults): static
        public function setDefaults(array<string, mixed> $defaults): static;

        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function setOptions(array $options): static
        public function setOptions(array<string, mixed> $options): static;

        /**
         * @param array<string, string|\Stringable> $requirements
         */
        // @overlay-against: function setRequirements(array $requirements): static
        public function setRequirements(array<string, string|\Stringable> $requirements): static;
    }

    /**
     * Tyhp encoding: collection iteration is `string => Route`; `remove()` accepts a name list.
     */
    // @overlay-against: class RouteCollection implements \IteratorAggregate, \Countable
    partial class RouteCollection implements \IteratorAggregate<string, \Symfony\Component\Routing\Route>, \Countable;
    // @overlay-against: class RouteCollection implements \IteratorAggregate, \Countable
    partial class RouteCollection {
        /**
         * @param array<string, mixed> $defaults
         * @param array<string, string|\Stringable> $requirements
         */
        // @overlay-against: function addPrefix(string $prefix, array $defaults, array $requirements): void
        public function addPrefix(string $prefix, array<string, mixed> $defaults = [], array<string, string|\Stringable> $requirements = []): void;

        /**
         * @return \ArrayIterator<string, \Symfony\Component\Routing\Route>
         */
        // @overlay-against: function getIterator(): \ArrayIterator
        public function getIterator(): \ArrayIterator<string, \Symfony\Component\Routing\Route>;

        /**
         * @param string|array<int|string, string> $name
         */
        // @overlay-against: function remove(string|array $name): void
        public function remove(string|array<int|string, string> $name): void;
    

        /**
         * @return array<\Symfony\Component\Config\Resource\ResourceInterface>
         */
        // @overlay-against: function getResources(): array
        public function getResources(): array<string, \Symfony\Component\Config\Resource\ResourceInterface>;

        /**
         * @param string|array<string> $methods
         */
        // @overlay-against: function setMethods(string|array $methods): void
        public function setMethods(\Symfony\Component\Routing\MethodOrSchemeList $methods): void;

        /**
         * @param string|array<string> $schemes
         */
        // @overlay-against: function setSchemes(string|array $schemes): void
        public function setSchemes(\Symfony\Component\Routing\MethodOrSchemeList $schemes): void;

        /**
         * @param array<string, mixed> $defaults
         * @param array<string, string|\Stringable> $requirements
         */
        // @overlay-against: function setHost(?string $pattern, array $defaults, array $requirements): void
        public function setHost(?string $pattern, array<string, mixed> $defaults = [], array<string, string|\Stringable> $requirements = []): void;

        /**
         * @param array<string, mixed> $defaults
         */
        // @overlay-against: function addDefaults(array $defaults): void
        public function addDefaults(array<string, mixed> $defaults): void;

        /**
         * @param array<string, string|\Stringable> $requirements
         */
        // @overlay-against: function addRequirements(array $requirements): void
        public function addRequirements(array<string, string|\Stringable> $requirements): void;

        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function addOptions(array $options): void
        public function addOptions(array<string, mixed> $options): void;
    }

    /**
     * Overlay: deprecation template is a fixed package/version/message map.
     */
    // @overlay-against: class Alias
    partial class Alias {
        /**
         * @return \Symfony\Component\Routing\AliasDeprecation
         */
        // @overlay-against: function getDeprecation(string $name): array
        public function getDeprecation(string $name): \Symfony\Component\Routing\AliasDeprecation;
    }

    /**
     * Overlay: path/host variable names are string lists; tokens are lists of string tuples.
     */
    // @overlay-against: class CompiledRoute
    partial class CompiledRoute {
        /**
         * @param array<int|string, array<int|string, string>> $tokens
         * @param array<int|string, string> $pathVariables
         * @param array<int|string, array<int|string, string>> $hostTokens
         * @param array<int|string, string> $hostVariables
         * @param array<int|string, string> $variables
         */
        // @overlay-against: function __construct(string $staticPrefix, string $regex, array $tokens, array $pathVariables, ?string $hostRegex, array $hostTokens, array $hostVariables, array $variables): void
        public function __construct(string $staticPrefix, string $regex, array<int|string, array<int|string, string>> $tokens, array<int|string, string> $pathVariables, ?string $hostRegex = null, array<int|string, array<int|string, string>> $hostTokens = [], array<int|string, string> $hostVariables = [], array<int|string, string> $variables = []): void;

        /**
         * @return array<int, array<int, string>>
         */
        // @overlay-against: function getTokens(): array
        public function getTokens(): array<int, array<int, string>>;

        /**
         * @return array<int, array<int, string>>
         */
        // @overlay-against: function getHostTokens(): array
        public function getHostTokens(): array<int, array<int, string>>;

        /**
         * @return array<int, string>
         */
        // @overlay-against: function getVariables(): array
        public function getVariables(): array<int, string>;

        /**
         * @return array<int, string>
         */
        // @overlay-against: function getPathVariables(): array
        public function getPathVariables(): array<int, string>;

        /**
         * @return array<int, string>
         */
        // @overlay-against: function getHostVariables(): array
        public function getHostVariables(): array<int, string>;
    }

    /**
     * Overlay: request parameters are a string-keyed map.
     */
    // @overlay-against: class RequestContext
    partial class RequestContext {
        /**
         * @param array<string, mixed>|null $parameters
         */
        // @overlay-against: function __construct(string $baseUrl, string $method, string $host, string $scheme, int $httpPort, int $httpsPort, string $path, string $queryString, ?array $parameters): void
        public function __construct(string $baseUrl = '', string $method = 'GET', string $host = 'localhost', string $scheme = 'http', int $httpPort = 80, int $httpsPort = 443, string $path = '/', string $queryString = '', array<string, mixed>|null $parameters = null): void;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function getParameters(): array
        public function getParameters(): array<string, mixed>;

        /**
         * @param array<string, mixed> $parameters
         */
        // @overlay-against: function setParameters(array $parameters): static
        public function setParameters(array<string, mixed> $parameters): static;
    }

    /**
     * Overlay: router options are `RouterOptions`; match results and generate parameters are string-keyed maps.
     */
    // @overlay-against: class Router implements \Symfony\Component\Routing\RouterInterface, \Symfony\Component\Routing\Matcher\RequestMatcherInterface
    partial class Router {
        /**
         * @param \Symfony\Component\Routing\RouterOptions $options
         */
        // @overlay-against: function __construct(\Symfony\Component\Config\Loader\LoaderInterface $loader, mixed $resource, array $options, ?\Symfony\Component\Routing\RequestContext $context, ?\Psr\Log\LoggerInterface $logger, ?string $defaultLocale): void
        public function __construct(\Symfony\Component\Config\Loader\LoaderInterface $loader, mixed $resource, \Symfony\Component\Routing\RouterOptions $options = [], ?\Symfony\Component\Routing\RequestContext $context = null, ?\Psr\Log\LoggerInterface $logger = null, ?string $defaultLocale = null): void;

        /**
         * @param \Symfony\Component\Routing\RouterOptions $options
         */
        // @overlay-against: function setOptions(array $options): void
        public function setOptions(\Symfony\Component\Routing\RouterOptions $options): void;

        /**
         * @param array<string, mixed> $parameters
         */
        // @overlay-against: function generate(string $name, array $parameters, int $referenceType): string
        public function generate(string $name, array<string, mixed> $parameters = [], int $referenceType = self::ABSOLUTE_PATH): string;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function match(string $pathinfo): array
        public function match(string $pathinfo): array<string, mixed>;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function matchRequest(\Symfony\Component\HttpFoundation\Request $request): array
        public function matchRequest(\Symfony\Component\HttpFoundation\Request $request): array<string, mixed>;
    }
}

namespace Symfony\Component\Routing\DependencyInjection {
    /**
     * Omit: compiler pass implements the optional `symfony/dependency-injection` peer.
     */
    // @overlay-against: class AddExpressionLanguageProvidersPass implements \Symfony\Component\DependencyInjection\Compiler\CompilerPassInterface
    omit class AddExpressionLanguageProvidersPass {
    }

    /**
     * Omit: compiler pass implements the optional `symfony/dependency-injection` peer.
     */
    // @overlay-against: class RoutingControllerPass implements \Symfony\Component\DependencyInjection\Compiler\CompilerPassInterface, \Symfony\Component\DependencyInjection\Compiler\PriorityTaggedServiceTrait
    omit final class RoutingControllerPass {
    }

    /**
     * Omit: compiler pass implements the optional `symfony/dependency-injection` peer.
     */
    // @overlay-against: class RoutingResolverPass implements \Symfony\Component\DependencyInjection\Compiler\CompilerPassInterface, \Symfony\Component\DependencyInjection\Compiler\PriorityTaggedServiceTrait
    omit class RoutingResolverPass {
    }
}

namespace Symfony\Component\Routing\Loader\Configurator\Traits {
    /**
     * Harvest miss: `@internal` trait omitted from Layer 1. Used by XML/YAML/PHP route loaders.
     */
    trait HostTrait {
        /**
         * @param string|array<string, string> $hosts
         */
        final protected function addHost(\Symfony\Component\Routing\RouteCollection $routes, string|array<string, string> $hosts): void;
    }

    /**
     * Harvest miss: `@internal` trait omitted from Layer 1. Used by XML/YAML/PHP route loaders.
     */
    trait LocalizedRouteTrait {
        /**
         * @param string|array<string, string> $path
         * @param ?array<string, string> $prefixes
         */
        final protected function createLocalizedRoute(
            \Symfony\Component\Routing\RouteCollection $collection,
            string $name,
            string|array<string, string> $path,
            string $namePrefix = '',
            ?array<string, string> $prefixes = null
        ): \Symfony\Component\Routing\RouteCollection;
    }

    /**
     * Harvest miss: `@internal` trait omitted from Layer 1. Used by XML/YAML/PHP route loaders.
     */
    trait PrefixTrait {
        /**
         * @param string|array<string, string> $prefix
         */
        final protected function addPrefix(\Symfony\Component\Routing\RouteCollection $routes, string|array<string, string> $prefix, bool $trailingSlashOnRoot): void;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `RouteTrait`.
     */
    // @overlay-against: trait RouteTrait
    partial trait RouteTrait {
        /**
         * @param array<string> $methods
         */
        // @overlay-against: function methods(array $methods): static
        public function methods(array<int|string, string> $methods): static;

        /**
         * @param array<string> $schemes
         */
        // @overlay-against: function schemes(array $schemes): static
        public function schemes(array<int|string, string> $schemes): static;

        /**
         * @param array<string, mixed> $defaults
         */
        // @overlay-against: function defaults(array $defaults): static
        public function defaults(array<string, mixed> $defaults): static;

        /**
         * @param array<string, string|\Stringable> $requirements
         */
        // @overlay-against: function requirements(array $requirements): static
        public function requirements(array<string, string|\Stringable> $requirements): static;

        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function options(array $options): static
        public function options(array<string, mixed> $options): static;

        /**
         * @param callable|string|array<int|string, mixed> $controller
         */
        // @overlay-against: function controller(callable|string|array $controller): static
        public function controller(callable|string|array<int|string, mixed> $controller): static;
    }

    /**
     * Overlay: localized path maps are `locale => path`.
     */
    // @overlay-against: trait AddTrait implements \Symfony\Component\Routing\Loader\Configurator\Traits\LocalizedRouteTrait
    partial trait AddTrait {
        /**
         * @param string|array<string, string> $path
         */
        // @overlay-against: function add(string $name, string|array $path): \Symfony\Component\Routing\Loader\Configurator\RouteConfigurator
        public function add(string $name, string|array<string, string> $path): \Symfony\Component\Routing\Loader\Configurator\RouteConfigurator;

        /**
         * @param string|array<string, string> $path
         */
        // @overlay-against: function __invoke(string $name, string|array $path): \Symfony\Component\Routing\Loader\Configurator\RouteConfigurator
        public function __invoke(string $name, string|array<string, string> $path): \Symfony\Component\Routing\Loader\Configurator\RouteConfigurator;
    }
}

namespace Symfony\Component\Routing\Matcher {
    /**
     * Omit: optional `symfony/expression-language` peer.
     */
    // @overlay-against: class ExpressionLanguageProvider implements \Symfony\Component\ExpressionLanguage\ExpressionFunctionProviderInterface
    omit class ExpressionLanguageProvider {
    }

    // @overlay-against: class RedirectableUrlMatcher extends \Symfony\Component\Routing\Matcher\UrlMatcher implements \Symfony\Component\Routing\Matcher\RedirectableUrlMatcherInterface
    partial class RedirectableUrlMatcher {
        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function match(string $pathinfo): array
        public function match(string $pathinfo): array<string, mixed>;
    }

    // @overlay-against: interface RedirectableUrlMatcherInterface
    partial interface RedirectableUrlMatcherInterface {
        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function redirect(string $path, string $route, ?string $scheme): array
        public function redirect(string $path, string $route, ?string $scheme = null): array<string, mixed>;
    }

    // @overlay-against: interface RequestMatcherInterface
    partial interface RequestMatcherInterface {
        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function matchRequest(\Symfony\Component\HttpFoundation\Request $request): array
        public function matchRequest(\Symfony\Component\HttpFoundation\Request $request): array<string, mixed>;
    }

    // @overlay-against: class TraceableUrlMatcher extends \Symfony\Component\Routing\Matcher\UrlMatcher
    partial class TraceableUrlMatcher {
        /**
         * @return array<int, \Symfony\Component\Routing\RouteMatchTrace>
         */
        // @overlay-against: function getTraces(string $pathinfo): array
        public function getTraces(string $pathinfo): array<int, \Symfony\Component\Routing\RouteMatchTrace>;

        /**
         * @return array<int, \Symfony\Component\Routing\RouteMatchTrace>
         */
        // @overlay-against: function getTracesForRequest(\Symfony\Component\HttpFoundation\Request $request): array
        public function getTracesForRequest(\Symfony\Component\HttpFoundation\Request $request): array<int, \Symfony\Component\Routing\RouteMatchTrace>;
    }

    // @overlay-against: class UrlMatcher implements \Symfony\Component\Routing\Matcher\UrlMatcherInterface, \Symfony\Component\Routing\Matcher\RequestMatcherInterface
    partial class UrlMatcher {
        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function match(string $pathinfo): array
        public function match(string $pathinfo): array<string, mixed>;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function matchRequest(\Symfony\Component\HttpFoundation\Request $request): array
        public function matchRequest(\Symfony\Component\HttpFoundation\Request $request): array<string, mixed>;
    }

    // @overlay-against: interface UrlMatcherInterface
    partial interface UrlMatcherInterface {
        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function match(string $pathinfo): array
        public function match(string $pathinfo): array<string, mixed>;
    }

    // @overlay-against: class CompiledUrlMatcher extends \Symfony\Component\Routing\Matcher\UrlMatcher implements \Symfony\Component\Routing\Matcher\Dumper\CompiledUrlMatcherTrait
    partial class CompiledUrlMatcher {
        /**
         * @param array<string, mixed> $compiledRoutes
         */
        // @overlay-against: function __construct(array $compiledRoutes, \Symfony\Component\Routing\RequestContext $context): void
        public function __construct(array<string, mixed> $compiledRoutes, \Symfony\Component\Routing\RequestContext $context): void;
    }
}

namespace Symfony\Component\Routing\Matcher\Dumper {
    /**
     * Harvest miss: `@internal` trait omitted from Layer 1. Used by compiled URL matchers.
     */
    trait CompiledUrlMatcherTrait {
        /**
         * @return array<string, mixed>
         */
        public function match(string $pathinfo): array<string, mixed>;
    }

    // @overlay-against: class CompiledUrlMatcherDumper extends \Symfony\Component\Routing\Matcher\Dumper\MatcherDumper
