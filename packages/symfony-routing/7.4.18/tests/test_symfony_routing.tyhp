<?tyhp

function test_routing_route_methods(): array<int, string>
{
    $route = new \Symfony\Component\Routing\Route('/users/{id}', ['id' => '1'], ['id' => '\\d+'], [], null, 'https', ['GET', 'HEAD']);
    return $route->setMethods('GET')->getMethods();
}

function test_routing_collection(): ?\Symfony\Component\Routing\Route
{
    $collection = new \Symfony\Component\Routing\RouteCollection();
    $collection->add('home', new \Symfony\Component\Routing\Route('/'));
    return $collection->get('home');
}

function test_routing_request_context(): string
{
    $context = \Symfony\Component\Routing\RequestContext::fromUri('https://example.com/app', 'example.com', 'https');
    return $context->getHost();
}
