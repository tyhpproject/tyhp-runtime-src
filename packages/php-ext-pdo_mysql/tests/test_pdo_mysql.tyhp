<?tyhp

function test_pdo_mysql_constants(): int
{
    return PDO::MYSQL_ATTR_INIT_COMMAND;
}

// `Pdo\Mysql` (PHP 8.4+ named PDO driver subclass) is only in scope when
// compiling for `output.phpVersion` >= 8.4 — see tyhp-php8.4.json.
declare(php=">=8.4") {
    function test_pdo_mysql_driver_class(\Pdo\Mysql $conn): int
    {
        return $conn->getWarningCount() + \Pdo\Mysql::ATTR_USE_BUFFERED_QUERY;
    }
}
