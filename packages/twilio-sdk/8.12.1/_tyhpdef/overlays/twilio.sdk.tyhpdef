    }

    // @overlay-against: class Values implements \ArrayAccess
    partial class Values {
        // @overlay-against: mixed $options
        protected array<string, mixed> $options;
        // @overlay-against: function array_get(array $array, string $key, ?string $default): mixed
        public static function array_get(array<string, mixed> $array, string $key, ?string $default = null): mixed;
