        public static function of(array<string, mixed> $array): array<string, mixed>;
        // @overlay-against: function __construct(array $options): void
        public function __construct(array<string, mixed> $options): void;
        // @overlay-against: function offsetExists(mixed $offset): bool
        public function offsetExists(string $offset): bool;
        // @overlay-against: function offsetGet(mixed $offset): mixed
        public function offsetGet(string $offset): mixed;
        // @overlay-against: function offsetSet(mixed $offset, mixed $value): void
        public function offsetSet(string $offset, mixed $value): void;
        // @overlay-against: function offsetUnset(mixed $offset): void
        public function offsetUnset(string $offset): void;
    }

    // @overlay-against: class Version
    partial class Version {
        // @overlay-against: function request(string $method, string $uri, array $params, array $data, array $headers, ?string $username, ?string $password, ?int $timeout): \Twilio\Http\Response
        public function request(string $method, string $uri, array<string, mixed> $params = [], array<string, mixed> $data = [], array<string, string> $headers = [], ?string $username = null, ?string $password = null, ?int $timeout = null): \Twilio\Http\Response;
        // @overlay-against: function readLimits(?int $limit, ?int $pageSize): array
        public function readLimits(?int $limit = null, ?int $pageSize = null): ReadLimits;
        // @overlay-against: function page(string $method, string $uri, array $params, array $data, array $headers, ?string $username, ?string $password, ?int $timeout): \Twilio\Http\Response
        public function page(string $method, string $uri, array<string, mixed> $params = [], array<string, mixed> $data = [], array<string, string> $headers = [], ?string $username = null, ?string $password = null, ?int $timeout = null): \Twilio\Http\Response;
        // @overlay-against: function stream(\Twilio\Page $page, mixed $limit, mixed $pageLimit): \Twilio\Stream
        public function stream(\Twilio\Page $page, int|string|null $limit = null, int|string|null $pageLimit = null): \Twilio\Stream;
        // @overlay-against: function handleRequest(string $method, string $uri, array $params, array $data, array $headers, ?string $operation, ?string $username, ?string $password, ?int $timeout): \Twilio\Http\Response
        public function handleRequest(string $method, string $uri, array<string, mixed> $params = [], array<string, mixed> $data = [], array<string, string> $headers = [], ?string $operation = "", ?string $username = null, ?string $password = null, ?int $timeout = null): \Twilio\Http\Response;
    }

    // @overlay-against: class VersionInfo
    partial class VersionInfo {
        // @overlay-against: function string(): mixed
        public static function string(): string;
    }
}

namespace Twilio\Base {
    // @overlay-against: class BaseClient
    partial class BaseClient {
        // @overlay-against: mixed $username
        protected ?string $username;
        // @overlay-against: mixed $password
        protected ?string $password;
        // @overlay-against: mixed $credentialProvider
        protected ?\Twilio\CredentialProvider\CredentialProvider $credentialProvider;
        // @overlay-against: mixed $accountSid
        protected ?string $accountSid;
        // @overlay-against: mixed $region
        protected ?string $region;
        // @overlay-against: mixed $edge
        protected ?string $edge;
        // @overlay-against: mixed $httpClient
        protected \Twilio\Http\Client $httpClient;
        // @overlay-against: mixed $environment
        protected array<string, string> $environment;
        // @overlay-against: mixed $userAgentExtensions
        protected array<int|string, string> $userAgentExtensions;
        // @overlay-against: mixed $logLevel
        protected ?string $logLevel;
        // @overlay-against: function __construct(?string $username, ?string $password, ?string $accountSid, ?string $region, ?\Twilio\Http\Client $httpClient, array $environment, array $userAgentExtensions): void
        public function __construct(?string $username = null, ?string $password = null, ?string $accountSid = null, ?string $region = null, ?\Twilio\Http\Client $httpClient = null, array<string, string> $environment = null, array<int|string, string> $userAgentExtensions = null): void;
        // @overlay-against: function request(string $method, string $uri, array $params, array $data, array $headers, ?string $username, ?string $password, ?int $timeout, ?\Twilio\AuthStrategy\AuthStrategy $authStrategy): \Twilio\Http\Response
        public function request(string $method, string $uri, array<string, mixed> $params = [], array<string, mixed> $data = [], array<string, string> $headers = [], ?string $username = null, ?string $password = null, ?int $timeout = null, ?\Twilio\AuthStrategy\AuthStrategy $authStrategy = null): \Twilio\Http\Response;
    }

    // @overlay-against: class PhoneNumberCapabilities
    partial class PhoneNumberCapabilities {
        // @overlay-against: mixed $mms
        protected bool|string $mms;
        // @overlay-against: mixed $sms
        protected bool|string $sms;
        // @overlay-against: mixed $voice
        protected bool|string $voice;
        // @overlay-against: mixed $fax
        protected bool|string $fax;
        // @overlay-against: function __construct(array $capabilities): void
        public function __construct(array<string, mixed> $capabilities): void;
        // @overlay-against: function __get(string $name): mixed
        public function __get(string $name): bool;
    }
}

namespace Twilio\Http {
    // @overlay-against: interface Client
    partial interface Client {
        // @overlay-against: function request(string $method, string $url, array $params, array $data, array $headers, ?string $user, ?string $password, ?int $timeout, ?\Twilio\AuthStrategy\AuthStrategy $authStrategy): \Twilio\Http\Response
        public function request(string $method, string $url, array<string, mixed> $params = [], array<string, mixed> $data = [], array<string, string> $headers = [], ?string $user = null, ?string $password = null, ?int $timeout = null, ?\Twilio\AuthStrategy\AuthStrategy $authStrategy = null): \Twilio\Http\Response;
    }

    // @overlay-against: class CurlClient implements \Twilio\Http\Client
    partial class CurlClient {
        // @overlay-against: mixed $curlOptions
        protected array<int, mixed> $curlOptions;
        // @overlay-against: mixed $lastRequest
        public ?array<int, mixed> $lastRequest;
        // @overlay-against: mixed $lastResponse
        public ?\Twilio\Http\Response $lastResponse;
        // @overlay-against: function __construct(array $options): void
        public function __construct(array<int, mixed> $options = []): void;
        // @overlay-against: function request(string $method, string $url, array $params, array $data, array $headers, ?string $user, ?string $password, ?int $timeout, ?\Twilio\AuthStrategy\AuthStrategy $authStrategy): \Twilio\Http\Response
        public function request(string $method, string $url, array<string, mixed> $params = [], array<string, mixed> $data = [], array<string, string> $headers = [], ?string $user = null, ?string $password = null, ?int $timeout = null, ?\Twilio\AuthStrategy\AuthStrategy $authStrategy = null): \Twilio\Http\Response;
        // @overlay-against: function options(string $method, string $url, array $params, array $data, array $headers, ?string $user, ?string $password, ?int $timeout, ?\Twilio\AuthStrategy\AuthStrategy $authStrategy): array
        public function options(string $method, string $url, array<string, mixed> $params = [], array<string, mixed> $data = [], array<string, string> $headers = [], ?string $user = null, ?string $password = null, ?int $timeout = null, ?\Twilio\AuthStrategy\AuthStrategy $authStrategy = null): array<int, mixed>;
        // @overlay-against: function buildQuery(?array $params): string
        public function buildQuery(array<string, mixed>|null $params): string;
    }

    // @overlay-against: class File
    partial class File {
        // @overlay-against: function __construct(string $fileName, mixed $contents, ?string $contentType): void
        public function __construct(string $fileName, string|resource|null $contents = null, ?string $contentType = null): void;
        // @overlay-against: function getContents(): mixed
        public function getContents(): string|resource|null;
    }

    // @overlay-against: class GuzzleClient implements \Twilio\Http\Client
    partial class GuzzleClient {
        // @overlay-against: function request(string $method, string $url, array $params, array $data, array $headers, ?string $user, ?string $password, ?int $timeout, ?\Twilio\AuthStrategy\AuthStrategy $authStrategy): \Twilio\Http\Response
        public function request(string $method, string $url, array<string, mixed> $params = [], array<string, mixed> $data = [], array<string, string> $headers = [], ?string $user = null, ?string $password = null, ?int $timeout = null, ?\Twilio\AuthStrategy\AuthStrategy $authStrategy = null): \Twilio\Http\Response;
    }

    // @overlay-against: class Response
    partial class Response {
        // @overlay-against: mixed $headers
        protected array<string, string|array<int, string>>|null $headers;
        // @overlay-against: mixed $content
        protected ?string $content;
        // @overlay-against: mixed $statusCode
        protected int $statusCode;
        // @overlay-against: function __construct(int $statusCode, ?string $content, ?array $headers): void
        public function __construct(int $statusCode, ?string $content, array<string, string|array<int, string>>|null $headers = []): void;
        // @overlay-against: function getContent(): mixed
        public function getContent(): array<int|string, mixed>|string|int|float|bool|null;
        // @overlay-against: function getHeaders(): array
        public function getHeaders(): array<string, string|array<int, string>>|null;
    }
}

namespace Twilio\Http\BearerToken {
