    // @overlay-against: class Page implements \Iterator
    partial class Page {
        // @overlay-against: mixed $metaKeys
        protected static array<int, string> $metaKeys;
        // @overlay-against: mixed $version
        protected \Twilio\Version $version;
        // @overlay-against: mixed $payload
        protected array<string, mixed> $payload;
        // @overlay-against: mixed $solution
        protected array<string, string> $solution;
        // @overlay-against: mixed $records
        protected \ArrayIterator $records;
        // @overlay-against: function buildInstance(array $payload): mixed
        public abstract function buildInstance(array<string, mixed> $payload): mixed;
        // @overlay-against: function isPagingEol(?array $content): bool
        protected function isPagingEol(array<string, mixed>|null $content): bool;
        // @overlay-against: function loadPage(): array
        protected function loadPage(): array<int, array<string, mixed>>;
        // @overlay-against: function processResponse(\Twilio\Http\Response $response): mixed
        protected function processResponse(\Twilio\Http\Response $response): void;
        // @overlay-against: function key(): mixed
        public function key(): int|string|null;
    }

    // @overlay-against: class Serialize
    partial class Serialize {
        // @overlay-against: function prefixedCollapsibleMap(mixed $map, string $prefix): array
        public static function prefixedCollapsibleMap(array<string, mixed>|string|null $map, string $prefix): array<string, mixed>;
        // @overlay-against: function iso8601Date(mixed $dateTime): string
        public static function iso8601Date(\DateTimeInterface|string|null $dateTime): string;
        // @overlay-against: function iso8601DateTime(mixed $dateTime): string
        public static function iso8601DateTime(\DateTimeInterface|string|null $dateTime): string;
        // @overlay-against: function booleanToString(mixed $boolOrStr): mixed
        public static function booleanToString(bool|string|null $boolOrStr): string|null;
        // @overlay-against: function map(mixed $values, mixed $map_func): mixed
        public static function map(mixed $values, callable(mixed): mixed $map_func): mixed;
