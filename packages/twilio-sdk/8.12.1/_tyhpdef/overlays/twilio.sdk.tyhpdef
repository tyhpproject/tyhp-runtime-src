        // @overlay-against: mixed $solution
        protected array<string, string> $solution;
        // @overlay-against: function toArray(): array
        public function toArray(): array<string, mixed>;
        // @overlay-against: function __isset(mixed $name): bool
        public function __isset(string $name): bool;
    }

    // @overlay-against: class ListResource
    partial class ListResource {
        // @overlay-against: mixed $version
        protected \Twilio\Version $version;
