<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * OpenAPI leftovers name types that are not in the twilio/sdk 8.12.1 PHP tarball.
 * Member `omit` is a skeleton (name only) so the overlay does not mention those missing types.
 * Generated Rest List, Instance, Page, Context, and Options types stay on Layer 1.
 */

namespace Twilio {
    type ReadLimits = struct {
        int|string $limit;
        int|string $pageSize;
        int|string $pageLimit;
    };

    // @overlay-against: class ApiV1Version extends \Twilio\Version
    partial class ApiV1Version {
        // @overlay-against: mixed $apiVersion
        protected string $apiVersion;
    }

    // @overlay-against: class Deserialize
    partial class Deserialize {
        // @overlay-against: function phoneNumberCapabilities(array|null $arr): \Twilio\Base\PhoneNumberCapabilities|array
        public static function phoneNumberCapabilities(array<string, mixed>|null $arr): \Twilio\Base\PhoneNumberCapabilities|array<string, mixed>|null;
    }

    // @overlay-against: class Domain
    partial class Domain {
        // @overlay-against: function request(string $method, string $uri, array $params, array $data, array $headers, ?string $user, ?string $password, ?int $timeout): \Twilio\Http\Response
        public function request(string $method, string $uri, array<string, mixed> $params = [], array<string, mixed> $data = [], array<string, string> $headers = [], ?string $user = null, ?string $password = null, ?int $timeout = null): \Twilio\Http\Response;
    }

    // @overlay-against: class InstanceContext
