        // @overlay-against: mixed $nextToken
        protected ?string $nextToken;
        // @overlay-against: mixed $previousToken
        protected ?string $previousToken;
        // @overlay-against: mixed $url
        protected string $url;
        // @overlay-against: mixed $queryParams
        protected array<string, mixed> $queryParams;
        // @overlay-against: mixed $previousPageUrl
        protected ?string $previousPageUrl;
        // @overlay-against: mixed $nextPageUrl
        protected ?string $nextPageUrl;
        // @overlay-against: function loadPage(): array
