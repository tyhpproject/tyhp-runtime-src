{
    "name": "tyhpdef/twilio-sdk",
    "description": "Tyhp type definitions for the Composer package twilio/sdk (8.12.1).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "8.12.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/guzzlehttp-guzzle": "@dev",
                "tyhpdef/guzzlehttp-psr7": "@dev",
                "tyhpdef/guzzlehttp-promises": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "twilio/sdk": "8.12.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/guzzlehttp-guzzle": "@dev",
        "tyhpdef/guzzlehttp-psr7": "@dev",
        "tyhpdef/guzzlehttp-promises": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-guzzle/8.2.0"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-psr7/3.1.0"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-promises/3.0.2"
        }
    ]
}
