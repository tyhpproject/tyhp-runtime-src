<?tyhp

function test_socialite_oauth2_user(): \Laravel\Socialite\Two\User
{
    return \Laravel\Socialite\Two\User::fake(['id' => '1', 'name' => 'Ada']);
}

function test_socialite_abstract_user(): \Laravel\Socialite\AbstractUser
{
    return \Laravel\Socialite\Two\User::fake(['email' => 'ada@example.com']);
}

function test_socialite_user_id(): string
{
    return \Laravel\Socialite\Two\User::fake(['id' => '42'])->getId();
}

function test_socialite_fake_driver(): \Laravel\Socialite\Testing\SocialiteFake
{
    return \Laravel\Socialite\Socialite::fake('github', \Laravel\Socialite\Two\User::fake());
}

function test_socialite_provider_user(\Laravel\Socialite\Two\ProviderInterface $provider): \Laravel\Socialite\Two\User
{
    return $provider->user();
}
