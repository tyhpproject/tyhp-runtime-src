<?tyhp

function test_psr_link_href_and_templated(\Psr\Link\LinkInterface $link): string
{
    if ($link->isTemplated()) {
        return $link->getHref();
    }
    return $link->getHref();
}

function test_psr_link_rels(\Psr\Link\LinkInterface $link): array<int, string>
{
    return $link->getRels();
}

function test_psr_link_attributes(\Psr\Link\LinkInterface $link): \Psr\Link\LinkAttributes
{
    return $link->getAttributes();
}

function test_psr_link_provider(\Psr\Link\LinkProviderInterface $provider, string $rel): iterable<\Psr\Link\LinkInterface>
{
    return $provider->getLinksByRel($rel);
}

function test_psr_link_evolvable(\Psr\Link\EvolvableLinkInterface $link): \Psr\Link\EvolvableLinkInterface
{
    return $link->withHref('/next')->withRel('next')->withAttribute('title', 'Next')->withoutRel('prev')->withoutAttribute('hreflang');
}

function test_psr_link_evolvable_provider(\Psr\Link\EvolvableLinkProviderInterface $provider, \Psr\Link\LinkInterface $link): \Psr\Link\EvolvableLinkProviderInterface
{
    return $provider->withLink($link)->withoutLink($link);
}
