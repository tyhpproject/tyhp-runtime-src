<?tyhp

function test_application_factory(): \Laravel\Octane\ApplicationFactory
{
    return new \Laravel\Octane\ApplicationFactory('/tmp/app');
}

function test_request_context(): \Laravel\Octane\RequestContext
{
    return new \Laravel\Octane\RequestContext();
}

function test_mime_type(): string|array
{
    return \Laravel\Octane\MimeType::get('html');
}

function test_octane_write_error(): void
{
    \Laravel\Octane\Octane::writeError('boom');
}

function test_worker(
    \Laravel\Octane\ApplicationFactory $factory,
    \Laravel\Octane\Contracts\Client $client,
): \Laravel\Octane\Worker {
    return new \Laravel\Octane\Worker($factory, $client);
}

function test_octane_format_exception(): string
{
    return \Laravel\Octane\Octane::formatExceptionForClient(new \RuntimeException('x'), false);
}
