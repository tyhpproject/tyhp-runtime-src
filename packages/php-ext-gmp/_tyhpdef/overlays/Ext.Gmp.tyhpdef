/**
 * Overlay: `gmp_div_qr()` `[quotient, remainder]` pair.
 */
type GmpDivQr = struct {
    \GMP 0 as $quotient;
    \GMP 1 as $remainder;
};

/**
 * Overlay: `gmp_gcdext()` `{g, s, t}` such that `a*s + b*t = g = gcd(a,b)`.
 */
type GmpGcdExt = struct {
    \GMP $g;
    \GMP $s;
    \GMP $t;
};

/**
 * Overlay: `gmp_rootrem()` / `gmp_sqrtrem()` `[root, remainder]` pair.
 */
type GmpRootRem = struct {
    \GMP 0 as $root;
    \GMP 1 as $remainder;
};

// @overlay-against: function gmp_cmp(\GMP|string|int $num1, \GMP|string|int $num2): int
function gmp_cmp(\GMP|string|int $num1, \GMP|string|int $num2): -1|0|1;

// @overlay-against: function gmp_div_qr(\GMP|string|int $num1, \GMP|string|int $num2, int $rounding_mode): array
function gmp_div_qr(\GMP|string|int $num1, \GMP|string|int $num2, int $rounding_mode = GMP_ROUND_ZERO): GmpDivQr;

// @overlay-against: function gmp_gcdext(\GMP|string|int $num1, \GMP|string|int $num2): array
function gmp_gcdext(\GMP|string|int $num1, \GMP|string|int $num2): GmpGcdExt;

// @overlay-against: function gmp_jacobi(\GMP|string|int $num1, \GMP|string|int $num2): int
function gmp_jacobi(\GMP|string|int $num1, \GMP|string|int $num2): -1|0|1;

// @overlay-against: function gmp_kronecker(\GMP|string|int $num1, \GMP|string|int $num2): int
function gmp_kronecker(\GMP|string|int $num1, \GMP|string|int $num2): -1|0|1;

// @overlay-against: function gmp_legendre(\GMP|string|int $num1, \GMP|string|int $num2): int
function gmp_legendre(\GMP|string|int $num1, \GMP|string|int $num2): -1|0|1;

// @overlay-against: function gmp_prob_prime(\GMP|string|int $num, int $repetitions): int
function gmp_prob_prime(\GMP|string|int $num, int $repetitions = 10): 0|1|2;

// @overlay-against: function gmp_rootrem(\GMP|string|int $num, int $nth): array
function gmp_rootrem(\GMP|string|int $num, int $nth): GmpRootRem;

// @overlay-against: function gmp_sign(\GMP|string|int $num): int
function gmp_sign(\GMP|string|int $num): -1|0|1;

// @overlay-against: function gmp_sqrtrem(\GMP|string|int $num): array
function gmp_sqrtrem(\GMP|string|int $num): GmpRootRem;

