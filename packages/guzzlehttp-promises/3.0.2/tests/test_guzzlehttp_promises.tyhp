<?tyhp

function test_guzzle_promise_wait(\GuzzleHttp\Promise\PromiseInterface<string, \Throwable> $promise): string
{
    return $promise->wait(true);
}

function test_guzzle_promise_wait_no_unwrap(\GuzzleHttp\Promise\PromiseInterface $promise): null
{
    return $promise->wait(false);
}

function test_guzzle_promise_state(\GuzzleHttp\Promise\PromiseInterface $promise): \GuzzleHttp\Promise\PromiseState
{
    return $promise->getState();
}

function test_guzzle_promise_then(\GuzzleHttp\Promise\PromiseInterface<int, \Throwable> $promise): \GuzzleHttp\Promise\PromiseInterface
{
    return $promise->then(function (int $value): string {
        return (string) $value;
    });
}

function test_guzzle_create_promise_for_value(): \GuzzleHttp\Promise\PromiseInterface
{
    return \GuzzleHttp\Promise\Create::promiseFor('ok');
}

function test_guzzle_utils_inspect(\GuzzleHttp\Promise\PromiseInterface<string, \Throwable> $promise): \GuzzleHttp\Promise\PromiseInspection<string, \Throwable>
{
    return \GuzzleHttp\Promise\Utils::inspect($promise);
}

function test_guzzle_promise_is_pending(\GuzzleHttp\Promise\PromiseInterface $promise): bool
{
    return \GuzzleHttp\Promise\GuzzleHttpPromiseIs::pending($promise);
}

function test_guzzle_promisor(\GuzzleHttp\Promise\PromisorInterface<string, \Throwable> $promisor): \GuzzleHttp\Promise\PromiseInterface<string, \Throwable>
{
    return $promisor->promise();
}
