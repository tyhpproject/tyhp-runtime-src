        // @overlay-against: function registerUndefinedFunctionCallback(callable $callable): void
        public function registerUndefinedFunctionCallback(callable(string): (\Twig\TwigFunction|false) $callable): void;
        // @overlay-against: function mergeGlobals(array $context): array
