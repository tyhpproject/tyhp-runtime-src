<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Internal expression helpers are referenced by harvested nodes but are not
 * themselves in the Layer 1 class list. PHPUnit test-case helpers are omitted
 * from the library surface.
 * Template context is a string-keyed map. Callable options are an open string-keyed bag.
 */

namespace Twig {
    type EnvironmentOptions = struct {
        ?bool $debug;
        ?string $charset;
        \Twig\Cache\CacheInterface|string|false|null $cache;
        ?bool $auto_reload;
        ?bool $strict_variables;
        string|false|(callable(string): string|false)|null $autoescape;
        ?int $optimizations;
        ?bool $use_yield;
    };

    type LexerOptions = struct {
        ?array<int, string> $tag_comment;
        ?array<int, string> $tag_block;
        ?array<int, string> $tag_variable;
        ?string $whitespace_trim;
        ?string $whitespace_line_trim;
        ?string $whitespace_line_chars;
        ?array<int, string> $interpolation;
    };

    type PhpClassCallable = struct {
        \__ClassName 0 as $class;
        string 1 as $method;
    };

    type ImportedSymbol = struct {
        ?string $name;
        ?\Twig\Node\Expression\Variable\AssignTemplateVariable $node;
    };

    // @overlay-against: class AbstractTwigCallable implements \Twig\TwigCallableInterface
    partial class AbstractTwigCallable {
        // @overlay-against: mixed $options
        protected array<string, mixed> $options;
        // @overlay-against: function __construct(string $name, mixed $callable, array $options): void
        public function __construct(string $name, callable|PhpClassCallable|null $callable = null, array<string, mixed> $options = []): void;
        // @overlay-against: function getCallable(): callable|array|null
        public function getCallable(): callable|PhpClassCallable|null;
        // @overlay-against: function withDynamicArguments(string $name, string $dynamicName, array $arguments): self
        public function withDynamicArguments(string $name, string $dynamicName, array<string, mixed> $arguments): self;
        // @overlay-against: function setArguments(array $arguments): void
        deprecated public function setArguments(array<string, mixed> $arguments): void;
        // @overlay-against: function getArguments(): array
        public function getArguments(): array<string, mixed>;
    }

    // @overlay-against: class Compiler
    partial class Compiler {
        // @overlay-against: function write(mixed $strings): static
        public function write(string ...$strings): static;
        // @overlay-against: function getDebugInfo(): array
        public function getDebugInfo(): array<int, int>;
    }

