        public function render(string|\Twig\TemplateWrapper $name, array<string, mixed> $context = []): string;
        // @overlay-against: function display(string|\Twig\TemplateWrapper $name, array $context): void
        public function display(string|\Twig\TemplateWrapper $name, array<string, mixed> $context = []): void;
        // @overlay-against: function registerUndefinedTokenParserCallback(callable $callable): void
        public function registerUndefinedTokenParserCallback(callable(string): (\Twig\TokenParser\TokenParserInterface|false) $callable): void;
        // @overlay-against: function registerUndefinedFilterCallback(callable $callable): void
        public function registerUndefinedFilterCallback(callable(string): (\Twig\TwigFilter|false) $callable): void;
        // @overlay-against: function registerUndefinedTestCallback(callable $callable): void
