<?tyhp

function test_pcre_is_match(): bool
{
    return \Composer\Pcre\Preg::isMatch('/^a+$/', 'aaa');
}

function test_pcre_replace(): string
{
    return \Composer\Pcre\Preg::replace('/a/', 'b', 'aaa');
}

function test_pcre_split(): array<int, string>
{
    return \Composer\Pcre\Preg::split('/,/', 'a,b,c');
}
