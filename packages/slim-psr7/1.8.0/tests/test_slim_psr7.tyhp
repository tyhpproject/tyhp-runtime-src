<?tyhp

function test_slim_request(): \Psr\Http\Message\RequestInterface
{
    return (new \Slim\Psr7\Factory\RequestFactory())->createRequest('GET', 'https://example.com');
}

function test_slim_response(): \Psr\Http\Message\ResponseInterface
{
    return (new \Slim\Psr7\Factory\ResponseFactory())->createResponse(204);
}

function test_slim_uri(): \Psr\Http\Message\UriInterface
{
    return (new \Slim\Psr7\Factory\UriFactory())->createUri('https://example.com/path');
}

function test_slim_server_request(): \Psr\Http\Message\ServerRequestInterface
{
    return (new \Slim\Psr7\Factory\ServerRequestFactory())->createServerRequest('POST', 'https://example.com');
}

function test_slim_stream(): \Psr\Http\Message\StreamInterface
{
    return (new \Slim\Psr7\Factory\StreamFactory())->createStream('hello');
}
