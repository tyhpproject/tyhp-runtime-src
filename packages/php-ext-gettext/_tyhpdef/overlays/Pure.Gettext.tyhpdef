<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef`  (not under `overlays/stubs/`)
 * Follows TYHPDEF_ORDERING.md.
 * Pure lookup helpers. `bindtextdomain` / `textdomain` mutate domain state
 * and are not marked Pure. Layer 1 signatures are otherwise exact.
 */

#[\Tyhp\Optimize\Pure]
// @overlay-against: function _
partial function _;

#[\Tyhp\Optimize\Pure]
// @overlay-against: function gettext
partial function gettext;

#[\Tyhp\Optimize\Pure]
// @overlay-against: function ngettext
partial function ngettext;
