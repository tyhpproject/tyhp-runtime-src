<?tyhp

function test_doctrine_inflector_create(): \Doctrine\Inflector\Inflector
{
    return \Doctrine\Inflector\InflectorFactory::create()->build();
}

function test_doctrine_inflector_english(): \Doctrine\Inflector\Inflector
{
    return \Doctrine\Inflector\InflectorFactory::createForLanguage(\Doctrine\Inflector\Language::ENGLISH)->build();
}

function test_doctrine_inflector_pluralize(\Doctrine\Inflector\Inflector $inflector): string
{
    return $inflector->pluralize('child');
}

function test_doctrine_inflector_tableize(\Doctrine\Inflector\Inflector $inflector): string
{
    return $inflector->tableize('ModelName');
}
