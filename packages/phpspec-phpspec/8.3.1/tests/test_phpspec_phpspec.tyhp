<?tyhp

function test_phpspec_object_behavior_class(): string
{
    return \PhpSpec\ObjectBehavior::class;
}

function test_phpspec_filesystem(): \PhpSpec\Util\Filesystem
{
    return new \PhpSpec\Util\Filesystem();
}

function test_phpspec_filesystem_path_exists(): bool
{
    $fs = new \PhpSpec\Util\Filesystem();
    return $fs->pathExists('/tmp');
}
