<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Pure hash functions.
 */
// md5 / sha1 / crc32 are declared in Ext.Standard; hash is declared in Ext.Hash.

// @overlay-against: function crc32(string $string): int
#[\Tyhp\Optimize\Pure]
// @overlay-against: function crc32
partial function crc32;

// @overlay-against: function hash(string $algo, string $data, bool $binary = false, array $options = []): string
#[\Tyhp\Optimize\Pure]
// @overlay-against: function hash
partial function hash;

// @overlay-against: function md5(string $string, bool $binary = false): string
#[\Tyhp\Optimize\Pure]
// @overlay-against: function md5
partial function md5;

// @overlay-against: function sha1(string $string, bool $binary = false): string
#[\Tyhp\Optimize\Pure]
// @overlay-against: function sha1
partial function sha1;
