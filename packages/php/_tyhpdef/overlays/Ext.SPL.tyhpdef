<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef`  (not under `overlays/stubs/`)
 * SPL signature enrichments: generic defaults, subclass `implements` remaps,
 * iterator wrapper constructors, and name-map / callable free functions.
 * Not Pure.
 *
 * Class-name parameters follow Core `is_a` / `get_parent_class`: a generic
 * object overload and a branded `__ClassName<T>` (plus `__InterfaceName` /
 * `__TraitName` where PHP accepts those). Missing names return false.
 */

/**
 * Overlay: `SplFileObject::getCsvControl()` indexed triple
 * (separator, enclosure, escape).
 */
type SplCsvControl = struct {
    string 0 as $separator;
    string 1 as $enclosure;
    string 2 as $escape;
};

/**
 * Overlay: interfaces implemented by an object. Missing type returns false.
 *
 * @template T Object type.
 * @param T $object_or_class Object instance.
 * @param bool $autoload Autoload when the type is not loaded.
 * @return array<string, __InterfaceName>|false Implemented interfaces.
 */
// @overlay-against: function class_implements(mixed $object_or_class, bool $autoload): array|false
function class_implements<T extends object>(
    T $object_or_class,
    bool $autoload = true
): array<string, __InterfaceName>|false;

/**
 * Overlay: interfaces implemented by a class name (`Foo::class` / `class_exists`).
 *
 * @template T Named class.
 * @param __ClassName<T> $object_or_class Class name.
 * @param bool $autoload Autoload when the name is not loaded.
 * @return array<string, __InterfaceName>|false Implemented interfaces.
 */
// @overlay-against: function class_implements(mixed $object_or_class, bool $autoload): array|false
function class_implements<T extends object>(
    __ClassName<T> $object_or_class,
    bool $autoload = true
): array<string, __InterfaceName>|false;

/**
 * Overlay: interfaces extended by an interface name (`interface_exists`).
 *
 * @template T Named interface.
 * @param __InterfaceName<T> $object_or_class Interface name.
 * @param bool $autoload Autoload when the name is not loaded.
 * @return array<string, __InterfaceName>|false Extended interfaces.
 */
// @overlay-against: function class_implements(mixed $object_or_class, bool $autoload): array|false
function class_implements<T extends object>(
    __InterfaceName<T> $object_or_class,
    bool $autoload = true
): array<string, __InterfaceName>|false;

/**
 * Overlay: parent class names of an object. Missing type returns false.
 *
 * @template T Object type.
 * @param T $object_or_class Object instance.
 * @param bool $autoload Autoload when the type is not loaded.
 * @return array<string, __SuperTypeName<T>>|false Parent class names.
 */
// @overlay-against: function class_parents(mixed $object_or_class, bool $autoload): array|false
function class_parents<T extends object>(
    T $object_or_class,
    bool $autoload = true
): array<string, __SuperTypeName<T>>|false;

/**
 * Overlay: parent class names of a class name (`Foo::class` / `class_exists`).
 *
 * @template T Named class.
 * @param __ClassName<T> $object_or_class Class name.
 * @param bool $autoload Autoload when the name is not loaded.
 * @return array<string, __SuperTypeName<T>>|false Parent class names.
 */
// @overlay-against: function class_parents(mixed $object_or_class, bool $autoload): array|false
function class_parents<T extends object>(
    __ClassName<T> $object_or_class,
    bool $autoload = true
): array<string, __SuperTypeName<T>>|false;

/**
 * Overlay: traits used by an object (not traits used by parent classes).
 *
 * @template T Object type.
 * @param T $object_or_class Object instance.
 * @param bool $autoload Autoload when the type is not loaded.
 * @return array<string, __TraitName>|false Used trait names.
 */
// @overlay-against: function class_uses(mixed $object_or_class, bool $autoload): array|false
function class_uses<T extends object>(
    T $object_or_class,
    bool $autoload = true
): array<string, __TraitName>|false;

/**
 * Overlay: traits used by a class name (`Foo::class` / `class_exists`).
 *
 * @template T Named class.
 * @param __ClassName<T> $object_or_class Class name.
 * @param bool $autoload Autoload when the name is not loaded.
 * @return array<string, __TraitName>|false Used trait names.
 */
// @overlay-against: function class_uses(mixed $object_or_class, bool $autoload): array|false
function class_uses<T extends object>(
    __ClassName<T> $object_or_class,
    bool $autoload = true
): array<string, __TraitName>|false;

/**
 * Overlay: traits used by a trait name (`trait_exists`).
 *
 * @param __TraitName $object_or_class Trait name.
 * @param bool $autoload Autoload when the name is not loaded.
 * @return array<string, __TraitName>|false Used trait names.
 */
// @overlay-against: function class_uses(mixed $object_or_class, bool $autoload): array|false
function class_uses(
    __TraitName $object_or_class,
    bool $autoload = true
): array<string, __TraitName>|false;

/**
 * Overlay: no extra `$args`. Callback is nullary and must return true to continue.
 *
 * @param \Traversable<TKey, TValue> $iterator Iterator to walk.
 * @param callable(): bool $callback Return true to keep iterating.
 * @param null $args No extra arguments.
 * @return int Number of iterations (until the callback returns false).
 */
// @overlay-against: function iterator_apply(\Traversable $iterator, callable $callback, ?array $args): int
function iterator_apply<TKey, TValue>(
    \Traversable<TKey, TValue> $iterator,
    callable(): bool $callback,
    null $args = null
): int;

/**
 * Overlay: `$args` as a positional list. Callback may have any arity; return is
 * pinned to bool (`callable(...): bool`). Tuple is the usual PHP list bag.
 *
 * @param \Traversable<TKey, TValue> $iterator Iterator to walk.
 * @param TCallable $callback Must return true to keep iterating.
 * @param __CallableParametersTuple<TCallable> $args Extra arguments, positional.
 * @return int Number of iterations (until the callback returns false).
 */
// @overlay-against: function iterator_apply(\Traversable $iterator, callable $callback, ?array $args): int
function iterator_apply<TKey, TValue, TCallable extends callable(...): bool>(
    \Traversable<TKey, TValue> $iterator,
    TCallable $callback,
    __CallableParametersTuple<TCallable> $args
): int;

/**
 * Overlay: `$args` as a named-parameter bag. Same return pin as the Tuple overload.
 *
 * @param \Traversable<TKey, TValue> $iterator Iterator to walk.
 * @param TCallable $callback Must return true to keep iterating.
 * @param __CallableParametersStruct<TCallable> $args Extra arguments, named.
 * @return int Number of iterations (until the callback returns false).
 */
// @overlay-against: function iterator_apply(\Traversable $iterator, callable $callback, ?array $args): int
function iterator_apply<TKey, TValue, TCallable extends callable(...): bool>(
    \Traversable<TKey, TValue> $iterator,
    TCallable $callback,
    __CallableParametersStruct<TCallable> $args
): int;

/**
 * Overlay: typed traversable/array input. Return is still the element count.
 *
 * @param \Traversable<TKey, TValue>|array<TKey, TValue> $iterator Iterator to count.
 * @return int Element count (iterator position is not preserved).
 */
// @overlay-against: function iterator_count(\Traversable|array $iterator): int
function iterator_count<TKey, TValue>(
    \Traversable<TKey, TValue>|array<TKey, TValue> $iterator
): int;

// true keeps TKey; false reindexes to int. bool catch-all is the union of both.
// @overlay-against: function iterator_to_array(\Traversable|array $iterator, bool $preserve_keys): array
function iterator_to_array<TKey extends int|string, TValue>(
    \Traversable<TKey, TValue>|array<TKey, TValue> $iterator,
    true $preserve_keys
): array<TKey, TValue>;
// @overlay-against: function iterator_to_array(\Traversable|array $iterator, bool $preserve_keys): array
function iterator_to_array<TKey extends int|string, TValue>(
    \Traversable<TKey, TValue>|array<TKey, TValue> $iterator,
    false $preserve_keys
): array<int, TValue>;
// @overlay-against: function iterator_to_array(\Traversable|array $iterator, bool $preserve_keys): array
function iterator_to_array<TKey extends int|string, TValue>(
    \Traversable<TKey, TValue>|array<TKey, TValue> $iterator,
    bool $preserve_keys = true
): array<TKey, TValue>|array<int, TValue>;

/**
 * Overlay: class name passed to the default autoloader.
 */
// @overlay-against: function spl_autoload(string $class, ?string $file_extensions): void
function spl_autoload(__ClassName $class, ?string $file_extensions = null): void;

/**
 * Overlay: class name passed through the autoload queue.
 */
// @overlay-against: function spl_autoload_call(string $class): void
function spl_autoload_call(__ClassName $class): void;

/**
 * Overlay: registered autoload callbacks. PHP 8+ always returns an array.
 *
 * @return array<int, callable(string): void> Queue entries.
 */
// @overlay-against: function spl_autoload_functions(): array
function spl_autoload_functions(): array<int, callable(string): void>;

/**
 * Overlay: typed autoload callback (`string $class): void`).
 *
 * @param callable(string): void $callback Autoloader, or null for `spl_autoload()`.
 * @param bool $throw Ignored since PHP 8 (always throws TypeError on invalid callbacks).
 * @param bool $prepend Prepend on the queue when true.
 * @return bool Success.
 */
// @overlay-against: function spl_autoload_register(?callable $callback, bool $throw, bool $prepend): bool
function spl_autoload_register(
    ?callable(string): void $callback = null,
    bool $throw = true,
    bool $prepend = false
): bool;

/**
 * Overlay: autoload function name (`function_exists`).
 *
 * @param __FunctionName $callback Function name.
 * @return bool Success.
 */
// @overlay-against: function spl_autoload_register(?callable $callback, bool $throw, bool $prepend): bool
function spl_autoload_register(__FunctionName $callback, bool $throw = true, bool $prepend = false): bool;

/**
 * Overlay: typed autoload callback.
 *
 * @param callable(string): void $callback Autoloader to remove.
 * @return bool Success.
 */
// @overlay-against: function spl_autoload_unregister(callable $callback): bool
function spl_autoload_unregister(callable(string): void $callback): bool;

/**
 * Overlay: autoload function name (`function_exists`).
 *
 * @param __FunctionName $callback Function name.
 * @return bool Success.
 */
// @overlay-against: function spl_autoload_unregister(callable $callback): bool
function spl_autoload_unregister(__FunctionName $callback): bool;

/**
 * Overlay: available SPL class short-name => short-name map.
 *
 * @return array<string, __ClassName> Registered SPL classes.
 */
// @overlay-against: function spl_classes(): array
function spl_classes(): array<string, __ClassName>;

// @overlay-against: class AppendIterator extends \IteratorIterator implements \Iterator, \Traversable, \OuterIterator
partial class AppendIterator<TKey = mixed, TValue = mixed, TIterator extends \Iterator<TKey, TValue> = \Iterator<TKey, TValue>> implements \Iterator<TKey, TValue>, \OuterIterator<TKey, TValue>, \Traversable;
// @overlay-against: class AppendIterator extends \IteratorIterator implements \Iterator, \Traversable, \OuterIterator
partial class AppendIterator {
    // @overlay-against: function append(\Iterator $iterator): void
    public function append(TIterator $iterator): void;
    // @overlay-against: function getArrayIterator(): \ArrayIterator
    public function getArrayIterator(): \ArrayIterator<int, TIterator>;
}

// @overlay-against: class ArrayIterator implements \SeekableIterator, \Traversable, \Iterator, \ArrayAccess, \Serializable, \Countable
partial class ArrayIterator<TKey = string|int, TValue = mixed> implements \SeekableIterator<TKey, TValue>, \Iterator<TKey, TValue>, \ArrayAccess<TKey, TValue>, \Traversable, \Serializable, \Countable;
// @overlay-against: class ArrayIterator implements \SeekableIterator, \Traversable, \Iterator, \ArrayAccess, \Serializable, \Countable
partial class ArrayIterator {
    // @overlay-against: function __construct(object|array $array, int $flags): void
    public function __construct(array<TKey, TValue>|object $array = [], int $flags = 0): void;
    // @overlay-against: function __debugInfo(): array
    public function __debugInfo(): array<string, mixed>;
    // @overlay-against: function __serialize(): array
    public function __serialize(): array<int|string, mixed>;
    // @overlay-against: function __unserialize(array $data): void
    public function __unserialize(array<int|string, mixed> $data): void;
    // Extra null from Layer 2 is dropped the same way as Iterator::current.
    // @overlay-against: function current(): mixed
    public function current(): TValue;
    // @overlay-against: function key(): string|int|null
    public function key(): TKey;
    // @overlay-against: function offsetGet(mixed $key): mixed
    public function offsetGet(TKey $key): TValue;
    #[\Tyhp\Php("<8.3")]
    // @overlay-against: function uasort(callable $callback): bool
    public function uasort(callable(TValue, TValue): int $callback): bool;
    #[\Tyhp\Php(">=8.3")]
    // @overlay-against: function uasort(callable $callback): true
    public function uasort(callable(TValue, TValue): int $callback): true;
    #[\Tyhp\Php("<8.3")]
    // @overlay-against: function uksort(callable $callback): bool
    public function uksort(callable(TKey, TKey): int $callback): bool;
    #[\Tyhp\Php(">=8.3")]
    // @overlay-against: function uksort(callable $callback): true
    public function uksort(callable(TKey, TKey): int $callback): true;
}

// @overlay-against: class ArrayObject implements \IteratorAggregate, \Traversable, \ArrayAccess, \Serializable, \Countable
partial class ArrayObject<TKey = string|int, TValue = mixed>;
// @overlay-against: class ArrayObject implements \IteratorAggregate, \Traversable, \ArrayAccess, \Serializable, \Countable
partial class ArrayObject {
    // @overlay-against: function __construct(object|array $array, int $flags, string $iteratorClass): void
    public function __construct(
        array<TKey, TValue>|object $array = [],
        int $flags = 0,
        __CompatibleTypeName<\ArrayIterator> $iteratorClass = "ArrayIterator"
    ): void;
    // @overlay-against: function __debugInfo(): array
    public function __debugInfo(): array<string, mixed>;
    // @overlay-against: function __serialize(): array
    public function __serialize(): array<int|string, mixed>;
    // @overlay-against: function __unserialize(array $data): void
    public function __unserialize(array<int|string, mixed> $data): void;
    // @overlay-against: function exchangeArray(object|array $array): array
    public function exchangeArray(array<TKey, TValue>|object $array): array<TKey, TValue>;
    // $iteratorClass is chosen at runtime, so the declared return is Iterator, not ArrayIterator.
    // @overlay-against: function getIterator(): \Iterator
    public function getIterator(): \Iterator<TKey, TValue>;
    // @overlay-against: function getIteratorClass(): string
    public function getIteratorClass(): __CompatibleTypeName<\ArrayIterator>;
    // @overlay-against: function setIteratorClass(string $iteratorClass): void
    public function setIteratorClass(__CompatibleTypeName<\ArrayIterator> $iteratorClass): void;
    #[\Tyhp\Php("<8.3")]
    // @overlay-against: function uasort(callable $callback): bool
    public function uasort(callable(TValue, TValue): int $callback): bool;
    #[\Tyhp\Php(">=8.3")]
    // @overlay-against: function uasort(callable $callback): true
    public function uasort(callable(TValue, TValue): int $callback): true;
    #[\Tyhp\Php("<8.3")]
    // @overlay-against: function uksort(callable $callback): bool
    public function uksort(callable(TKey, TKey): int $callback): bool;
    #[\Tyhp\Php(">=8.3")]
    // @overlay-against: function uksort(callable $callback): true
    public function uksort(callable(TKey, TKey): int $callback): true;
}

// Layer 2 offsetGet/offsetSet used string; cache keys follow TKey.
// @overlay-against: class CachingIterator extends \IteratorIterator implements \Stringable, \Iterator, \Traversable, \OuterIterator, \ArrayAccess, \Countable
partial class CachingIterator<TKey = mixed, TValue = mixed, TIterator extends \Iterator<TKey, TValue> = \Iterator<TKey, TValue>> implements \Iterator<TKey, TValue>, \OuterIterator<TKey, TValue>, \ArrayAccess<TKey, TValue>, \Stringable, \Traversable, \Countable;
// @overlay-against: class CachingIterator extends \IteratorIterator implements \Stringable, \Iterator, \Traversable, \OuterIterator, \ArrayAccess, \Countable
partial class CachingIterator {
    // @overlay-against: function __construct(\Iterator $iterator, int $flags): void
    public function __construct(TIterator $iterator, int $flags = CachingIterator::CALL_TOSTRING): void;
    // @overlay-against: function getCache(): array
    public function getCache(): array<TKey, TValue>;
    // @overlay-against: function offsetExists(mixed $key): bool
    public function offsetExists(TKey $key): bool;
    // @overlay-against: function offsetGet(mixed $key): mixed
    public function offsetGet(TKey $key): TValue;
    // @overlay-against: function offsetSet(mixed $key, mixed $value): void
    public function offsetSet(TKey $key, TValue $value): void;
    // @overlay-against: function offsetUnset(mixed $key): void
    public function offsetUnset(TKey $key): void;
}

// @overlay-against: class CallbackFilterIterator extends \FilterIterator implements \OuterIterator, \Traversable, \Iterator
partial class CallbackFilterIterator<TKey = mixed, TValue = mixed, TIterator extends \Iterator<TKey, TValue> = \Iterator<TKey, TValue>> implements \Iterator<TKey, TValue>, \OuterIterator<TKey, TValue>, \Traversable;
// @overlay-against: class CallbackFilterIterator extends \FilterIterator implements \OuterIterator, \Traversable, \Iterator
partial class CallbackFilterIterator {
    // @overlay-against: function __construct(\Iterator $iterator, callable $callback): void
    public function __construct(TIterator $iterator, callable(TValue, TKey, TIterator): bool $callback): void;
}

// Layer 2 restates untyped Iterator, which would shadow SeekableIterator<int, DirectoryIterator>.
// @overlay-against: class DirectoryIterator extends \SplFileInfo implements \Stringable, \SeekableIterator, \Traversable, \Iterator
partial class DirectoryIterator implements \SeekableIterator<int, \DirectoryIterator>, \Iterator<int, \DirectoryIterator>, \Traversable, \Stringable;

// CURRENT_AS_* union; flag-precise current() is not expressible in tyhpdef.
// @overlay-against: class FilesystemIterator extends \DirectoryIterator implements \Iterator, \Traversable, \SeekableIterator, \Stringable
partial class FilesystemIterator implements \SeekableIterator<string, \SplFileInfo|string|self>, \Iterator<string, \SplFileInfo|string|self>, \Traversable, \Stringable;

// FilterIterator's inner iterator must be Iterator (L1); Layer 2 bound Traversable is looser.
// @overlay-against: class FilterIterator extends \IteratorIterator implements \Iterator, \Traversable, \OuterIterator
partial class FilterIterator<TKey = mixed, TValue = mixed, TIterator extends \Iterator<TKey, TValue> = \Iterator<TKey, TValue>> implements \Iterator<TKey, TValue>, \OuterIterator<TKey, TValue>, \Traversable;
// @overlay-against: class FilterIterator extends \IteratorIterator implements \Iterator, \Traversable, \OuterIterator
partial class FilterIterator {
    // @overlay-against: function __construct(\Iterator $iterator): void
    public function __construct(TIterator $iterator): void;
}

// CURRENT_AS_SELF on a GlobIterator yields GlobIterator, not the parent FilesystemIterator.
// @overlay-against: class GlobIterator extends \FilesystemIterator implements \Stringable, \SeekableIterator, \Traversable, \Iterator, \Countable
partial class GlobIterator implements \SeekableIterator<string, \SplFileInfo|string|self>, \Iterator<string, \SplFileInfo|string|self>, \Traversable, \Stringable, \Countable;

// @overlay-against: class InfiniteIterator extends \IteratorIterator implements \Iterator, \Traversable, \OuterIterator
partial class InfiniteIterator<TKey = mixed, TValue = mixed, TIterator extends \Iterator<TKey, TValue> = \Iterator<TKey, TValue>> implements \Iterator<TKey, TValue>, \OuterIterator<TKey, TValue>, \Traversable;
// @overlay-against: class InfiniteIterator extends \IteratorIterator implements \Iterator, \Traversable, \OuterIterator
partial class InfiniteIterator {
    // @overlay-against: function __construct(\Iterator $iterator): void
    public function __construct(TIterator $iterator): void;
}

// Wrapper iterators: Layer 2 often has TKey/TValue without defaults and restates untyped Iterator.
// @overlay-against: class IteratorIterator implements \OuterIterator, \Traversable, \Iterator
partial class IteratorIterator<TKey = mixed, TValue = mixed, TIterator extends \Traversable<TKey, TValue> = \Traversable<TKey, TValue>> implements \Iterator<TKey, TValue>, \OuterIterator<TKey, TValue>, \Traversable;
// @overlay-against: class IteratorIterator implements \OuterIterator, \Traversable, \Iterator
partial class IteratorIterator {
    // @overlay-against: function __construct(\Traversable $iterator, ?string $class): void
    public function __construct(TIterator $iterator, ?__ClassName $class = null): void;
    // Extra null from Layer 2 is dropped the same way as Iterator::current / key.
    // @overlay-against: function current(): mixed
    public function current(): TValue;
    // @overlay-against: function getInnerIterator(): ?\Iterator
    public function getInnerIterator(): ?\Iterator<TKey, TValue>;
    // @overlay-against: function key(): mixed
    public function key(): TKey;
}

// @overlay-against: class LimitIterator extends \IteratorIterator implements \Iterator, \Traversable, \OuterIterator
partial class LimitIterator<TKey = mixed, TValue = mixed, TIterator extends \Iterator<TKey, TValue> = \Iterator<TKey, TValue>> implements \Iterator<TKey, TValue>, \OuterIterator<TKey, TValue>, \Traversable;
// @overlay-against: class LimitIterator extends \IteratorIterator implements \Iterator, \Traversable, \OuterIterator
partial class LimitIterator {
    // @overlay-against: function __construct(\Iterator $iterator, int $offset, int $limit): void
    public function __construct(TIterator $iterator, int $offset = 0, int $limit = -1): void;
}

// current()/key() return parallel arrays, so foreach is not Iterator<TKey, TValue>.
// @overlay-against: class MultipleIterator implements \Iterator, \Traversable
partial class MultipleIterator<TKey = mixed, TValue = mixed> implements \Iterator<array<int|string, TKey>, array<int|string, TValue>>, \Traversable;
// @overlay-against: class MultipleIterator implements \Iterator, \Traversable
partial class MultipleIterator {
    // @overlay-against: function __debugInfo(): array
    public function __debugInfo(): array<string, mixed>;
    // @overlay-against: function attachIterator(\Iterator $iterator, string|int|null $info): void
    public function attachIterator(\Iterator<TKey, TValue> $iterator, string|int|null $info = null): void;
    // @overlay-against: function containsIterator(\Iterator $iterator): bool
    public function containsIterator(\Iterator<TKey, TValue> $iterator): bool;
    // @overlay-against: function current(): array
    public function current(): array<int|string, TValue>;
    // @overlay-against: function detachIterator(\Iterator $iterator): void
    public function detachIterator(\Iterator<TKey, TValue> $iterator): void;
    // @overlay-against: function key(): array
    public function key(): array<int|string, TKey>;
}

// @overlay-against: class NoRewindIterator extends \IteratorIterator implements \Iterator, \Traversable, \OuterIterator
partial class NoRewindIterator<TKey = mixed, TValue = mixed, TIterator extends \Iterator<TKey, TValue> = \Iterator<TKey, TValue>> implements \Iterator<TKey, TValue>, \OuterIterator<TKey, TValue>, \Traversable;
// @overlay-against: class NoRewindIterator extends \IteratorIterator implements \Iterator, \Traversable, \OuterIterator
partial class NoRewindIterator {
    // @overlay-against: function __construct(\Iterator $iterator): void
    public function __construct(TIterator $iterator): void;
}

// @overlay-against: interface OuterIterator
partial interface OuterIterator<TKey = mixed, TValue = mixed>;
// @overlay-against: interface OuterIterator
partial interface OuterIterator {
    // @overlay-against: function getInnerIterator(): ?\Iterator
    public function getInnerIterator(): ?\Iterator<TKey, TValue>;
}

// @overlay-against: class ParentIterator extends \RecursiveFilterIterator implements \RecursiveIterator, \Iterator, \Traversable, \OuterIterator
partial class ParentIterator<TKey = mixed, TValue = mixed, TIterator extends \RecursiveIterator<TKey, TValue> = \RecursiveIterator<TKey, TValue>> implements \Iterator<TKey, TValue>, \OuterIterator<TKey, TValue>, \RecursiveIterator<TKey, TValue>, \Traversable;
// @overlay-against: class ParentIterator extends \RecursiveFilterIterator implements \RecursiveIterator, \Iterator, \Traversable, \OuterIterator
partial class ParentIterator {
    // @overlay-against: function __construct(\RecursiveIterator $iterator): void
    public function __construct(TIterator $iterator): void;
}

// Layer 2 restates untyped Iterator/ArrayAccess, which would shadow the typed SeekableIterator clause.
// @overlay-against: class RecursiveArrayIterator extends \ArrayIterator implements \Countable, \Serializable, \ArrayAccess, \Iterator, \Traversable, \SeekableIterator, \RecursiveIterator
partial class RecursiveArrayIterator<TKey = string|int, TValue = mixed> implements \RecursiveIterator<TKey, TValue>, \SeekableIterator<TKey, TValue>, \Iterator<TKey, TValue>, \ArrayAccess<TKey, TValue>, \Traversable, \Countable, \Serializable;
// @overlay-against: class RecursiveArrayIterator extends \ArrayIterator implements \Countable, \Serializable, \ArrayAccess, \Iterator, \Traversable, \SeekableIterator, \RecursiveIterator
partial class RecursiveArrayIterator {
    // @overlay-against: function getChildren(): ?\RecursiveArrayIterator
    public function getChildren(): ?\RecursiveArrayIterator<TKey, TValue>;
}

// Inner iterator must be RecursiveIterator so getChildren() can wrap it.
// @overlay-against: class RecursiveCachingIterator extends \CachingIterator implements \Countable, \ArrayAccess, \OuterIterator, \Traversable, \Iterator, \Stringable, \RecursiveIterator
partial class RecursiveCachingIterator<TKey = mixed, TValue = mixed, TIterator extends \RecursiveIterator<TKey, TValue> = \RecursiveIterator<TKey, TValue>> implements \Iterator<TKey, TValue>, \OuterIterator<TKey, TValue>, \RecursiveIterator<TKey, TValue>, \ArrayAccess<TKey, TValue>, \Stringable, \Traversable, \Countable;
// @overlay-against: class RecursiveCachingIterator extends \CachingIterator implements \Countable, \ArrayAccess, \OuterIterator, \Traversable, \Iterator, \Stringable, \RecursiveIterator
partial class RecursiveCachingIterator {
