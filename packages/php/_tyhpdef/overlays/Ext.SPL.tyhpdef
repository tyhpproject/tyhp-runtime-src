partial class SplFileObject implements \Iterator<int, array<int, string|null>|string|false>, \SeekableIterator<int, array<int, string|null>|string|false>, \RecursiveIterator<int, array<int, string|null>|string|false>, \Traversable, \Stringable;
// @overlay-against: class SplFileObject extends \SplFileInfo implements \Stringable, \RecursiveIterator, \Traversable, \Iterator, \SeekableIterator
partial class SplFileObject {
    // @overlay-against: function current(): array|string|false
    public function current(): array<int, string|null>|string|false;
    // @overlay-against: function fgetcsv(string $separator, string $enclosure, string $escape): array|false
    public function fgetcsv(
        string $separator = ',',
        string $enclosure = '"',
        string $escape = '\\'
    ): array<int, string|null>|false;
    // @overlay-against: function fputcsv(array $fields, string $separator, string $enclosure, string $escape, string $eol): int|false
    public function fputcsv(
        array<int|string, string|int|float|bool|null> $fields,
        string $separator = ',',
        string $enclosure = '"',
        string $escape = '\\',
        string $eol = '\n'
    ): int|false;
    // @overlay-against: function fscanf(string $format, mixed $vars): array|int|null
    public function fscanf(string $format, mixed &...$vars): array<int, mixed>|int|null;
    // @overlay-against: function fstat(): array
    public function fstat(): StatInfo;
    // @overlay-against: function getCsvControl(): array
    public function getCsvControl(): SplCsvControl;
}

