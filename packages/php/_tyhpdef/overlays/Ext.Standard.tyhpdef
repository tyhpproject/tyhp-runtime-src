/**
 * Overlay: `int` is `"integer"`.
 */
// @overlay-against: function gettype(mixed $value): string
function gettype(int $value): 'integer';

/**
 * Overlay: `float` is `"double"`.
 */
// @overlay-against: function gettype(mixed $value): string
function gettype(float $value): 'double';

/**
 * Overlay: `bool` is `"boolean"`.
 */
// @overlay-against: function gettype(mixed $value): string
function gettype(bool $value): 'boolean';

/**
 * Overlay: `string` stays `"string"`.
 */
// @overlay-against: function gettype(mixed $value): string
function gettype(string $value): 'string';

/**
 * Overlay: an array is `"array"`.
 */
// @overlay-against: function gettype(mixed $value): string
function gettype(array $value): 'array';

/**
 * Overlay: an object is `"object"`.
 */
// @overlay-against: function gettype(mixed $value): string
function gettype(object $value): 'object';

/**
 * Overlay: a resource is `"resource"` or `"resource (closed)"`.
 */
// @overlay-against: function gettype(mixed $value): string
function gettype(resource $value): 'resource'|'resource (closed)';

/**
 * Overlay: `null` is `"NULL"`.
 */
// @overlay-against: function gettype(mixed $value): string
function gettype(null $value): 'NULL';

/**
 * Overlay: runtime `mixed` is the closed `gettype()` spelling set.
 */
// @overlay-against: function gettype(mixed $value): string
function gettype(mixed $value): GettypeName;

/**
 * Overlay: matching paths as a list of strings.
 */
// @overlay-against: function glob(string $pattern, int $flags): array|false
function glob(string $pattern, int $flags = 0): array<int, string>|false;

/**
 * Overlay: header callback runs with no arguments when headers are about to be sent.
 */
// @overlay-against: function header_register_callback(callable $callback): bool
function header_register_callback(callable(): void $callback): bool;

/**
 * Overlay: response headers already prepared for sending.
 */
// @overlay-against: function headers_list(): array
function headers_list(): array<int, string>;

/**
 * Overlay: default / `false` is `[seconds, nanoseconds]`.
 */
// @overlay-against: function hrtime(bool $as_number): array|int|float|false
function hrtime(false $as_number = false): HrTimeParts|false;

/**
 * Overlay: `true` is nanoseconds as int or float.
 */
// @overlay-against: function hrtime(bool $as_number): array|int|float|false
function hrtime(true $as_number): int|float|false;

/**
 * Overlay: runtime-bool `$as_number` catch-all.
 */
// @overlay-against: function hrtime(bool $as_number): array|int|float|false
function hrtime(bool $as_number = false): HrTimeParts|int|float|false;

