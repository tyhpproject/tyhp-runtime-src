    array<TKey, TValue>|object &$array,
    callable(TValue, TKey, mixed): void $callback,
    mixed $arg = null
): true;

// @overlay-against: function arsort(array $array, int $flags): true
function arsort<TKey extends int|string, TValue>(array<TKey, TValue> &$array, int $flags = \SORT_REGULAR): true;

// @overlay-against: function asort(array $array, int $flags): true
function asort<TKey extends int|string, TValue>(array<TKey, TValue> &$array, int $flags = \SORT_REGULAR): true;

// @overlay-against: function compact(mixed $var_name, mixed $var_names): array
function compact(mixed $var_name, mixed ...$var_names): array<string, mixed>;

// @overlay-against: function count(\Countable|array $value, int $mode): int
function count(\Countable|array<int|string, mixed> $value, int $mode = \COUNT_NORMAL): int;

/**
 * Overlay: default / `0` is a 256-slot byte-frequency map.
 */
// @overlay-against: function count_chars(string $string, int $mode): array|string
function count_chars(string $string, 0 $mode = 0): array<int, int>;

/**
 * Overlay: `1` is used bytes only; `2` is unused bytes.
 */
// @overlay-against: function count_chars(string $string, int $mode): array|string
function count_chars(string $string, 1 $mode): array<int, int>;
// @overlay-against: function count_chars(string $string, int $mode): array|string
function count_chars(string $string, 2 $mode): array<int, int>;

/**
 * Overlay: `3` is a string of used unique bytes; `4` is unused unique bytes.
 */
// @overlay-against: function count_chars(string $string, int $mode): array|string
function count_chars(string $string, 3 $mode): string;
// @overlay-against: function count_chars(string $string, int $mode): array|string
function count_chars(string $string, 4 $mode): string;

/**
 * Overlay: runtime-int `$mode` catch-all.
 */
// @overlay-against: function count_chars(string $string, int $mode): array|string
function count_chars(string $string, int $mode = 0): array<int, int>|string;

// @overlay-against: function current(object|array $array): mixed
function current<TKey extends int|string, TValue>(array<TKey, TValue>|object $array): TValue|false;

