    string $hostname,
    int $type = \DNS_ANY,
    ?array<int, DnsRecord|DnsRawRecord> &$authoritative_name_servers = null,
    ?array<int, DnsRecord|DnsRawRecord> &$additional_records = null,
    bool $raw = false
): array<int, DnsRecord|DnsRawRecord>|false;

