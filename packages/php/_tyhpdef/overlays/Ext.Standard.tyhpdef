<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Standard signature enrichments: stub array-shapes as structs, generics,
 * type-guard returns, and overloads that narrow Layer 1 `array`/`mixed`.
 * Not Pure (see Pure.Standard.tyhpdef).
 */

/**
 * Overlay: `setcookie()` / `setrawcookie()` `$expires_or_options` array form.
 */
type CookieOptions = struct {
    ?int $expires;
    ?string $path;
    ?string $domain;
    ?bool $secure;
    ?bool $httponly;
    ?string $samesite;
};

/**
 * Overlay: one `dns_get_record()` row when `$raw` is true.
 * `$type` is the numeric DNS type id and `$data` is the unparsed RDATA.
 */
type DnsRawRecord = struct {
    string $host;
    string $class;
    int $type;
    int $ttl;
    string $data;
};

/**
 * Overlay: one `dns_get_record()` row when `$raw` is false.
 * Common keys are always present; type-specific keys are omitted as null.
 * `$flags` is an int for CAA and a string for NAPTR.
 */
type DnsRecord = struct {
    string $host;
    string $class;
    string $type;
    int $ttl;
    ?string $ip;
    ?string $ipv6;
    ?int $masklen;
    ?string $chain;
    ?int $pri;
    ?int $weight;
    ?int $port;
    ?string $target;
    ?string $mname;
    ?string $rname;
    ?int $serial;
    ?int $refresh;
    ?int $retry;
    ?int $expire;
    ?int 'minimum-ttl' as $minimum_ttl;
    ?string $txt;
    ?array<int, string> $entries;
    ?string $cpu;
    ?string $os;
    int|string|null $flags;
    ?string $tag;
    ?string $value;
    ?int $order;
    ?int $pref;
    ?string $services;
    ?string $regex;
    ?string $replacement;
};

/**
 * Overlay: `hrtime(false)` `[seconds, nanoseconds]` pair.
 */
type HrTimeParts = struct {
    int 0 as $seconds;
    int 1 as $nanoseconds;
};

/**
 * Overlay: `getimagesize()` / `getimagesizefromstring()` array-shape return.
 * Numeric keys `0`–`3` are PHP's width, height, IMAGETYPE_*, and HTML attr string.
 */
type ImageSizeInfo = struct {
    int 0 as $width;
    int 1 as $height;
    int 2 as $imageType;
    string 3 as $htmlAttr;
    string $mime;
    ?int $bits;
    ?int $channels;
};

/**
 * Overlay: one `ini_get_all($ext, true)` setting (`global_value`, `local_value`, `access`).
 */
type IniSettingDetails = struct {
    string|false|null $global_value;
    string|false|null $local_value;
    int $access;
};

/**
 * Overlay: `error_get_last()` array-shape return as `LastError`.
 */
type LastError = struct {
    int $type;
    string $message;
    string $file;
    int $line;
};

/**
 * Overlay: `localeconv()` array-shape return. `grouping` / `mon_grouping`
 * are lists of grouping sizes (`CHAR_MAX` means “no more”).
 */
type LocaleConv = struct {
    string $decimal_point;
    string $thousands_sep;
    array<int, int> $grouping;
    string $int_curr_symbol;
    string $currency_symbol;
    string $mon_decimal_point;
    string $mon_thousands_sep;
    array<int, int> $mon_grouping;
    string $positive_sign;
    string $negative_sign;
    int $int_frac_digits;
    int $frac_digits;
    int $p_cs_precedes;
    int $p_sep_by_space;
    int $n_cs_precedes;
    int $n_sep_by_space;
    int $p_sign_posn;
    int $n_sign_posn;
    int $int_p_cs_precedes;
    int $int_p_sep_by_space;
    int $int_n_cs_precedes;
    int $int_n_sep_by_space;
    int $int_p_sign_posn;
    int $int_n_sign_posn;
};

/**
 * Overlay: `time_nanosleep()` remainder when interrupted by a signal.
 */
type NanosleepRemainder = struct {
    int $seconds;
    int $nanoseconds;
};

/**
 * Overlay: one adapter from `net_get_interfaces()`. `$mac` and `$mtu` are absent on some adapters.
 */
type NetworkInterface = struct {
    array<int, NetworkInterfaceAddress> $unicast;
    bool $up;
    ?string $mac;
    ?int $mtu;
};

/**
 * Overlay: one address inside `net_get_interfaces()` `$unicast`.
 */
type NetworkInterfaceAddress = struct {
    int $flags;
    int $family;
    string $address;
    ?string $netmask;
    ?string $broadcast;
};

/**
 * Overlay: one level from `ob_get_status()`.
 */
type OutputBufferStatus = struct {
    string $name;
    int $type;
    int $flags;
    int $level;
    int $chunk_size;
    int $buffer_size;
    int $buffer_used;
};

/**
 * Overlay: `request_parse_body()` return. Index 0 is the post fields; index 1 is the files map.
 */
type ParsedRequestBody = struct {
    array<string, mixed> 0 as $post;
    array<string, mixed> 1 as $files;
};

/**
 * Overlay: `parse_url` array-shape return as `ParseUrlComponents`.
 * `$scheme` through `$fragment` are the PHP `parse_url()` keys; omitted keys are null.
 */
type ParseUrlComponents = struct {
    ?string $scheme;
    ?string $host;
    ?int $port;
    ?string $user;
    ?string $pass;
    ?string $path;
    ?string $query;
    ?string $fragment;
};

/**
 * Overlay: `password_hash()` / `password_needs_rehash()` / `password_get_info()` options.
 * `$cost` is bcrypt; the other fields are Argon2.
 */
type PasswordHashOptions = struct {
    ?int $cost;
    ?int $memory_cost;
    ?int $time_cost;
    ?int $threads;
};

/**
 * Overlay: `password_get_info()` array-shape return.
 */
type PasswordInfo = struct {
    string|int $algo;
    string $algoName;
    PasswordHashOptions $options;
};

/**
 * Overlay: `pathinfo()` associative return as `PathInfo`.
 */
type PathInfo = struct {
    string $dirname;
    string $basename;
    ?string $extension;
    string $filename;
};

/**
 * Overlay: `proc_open()` descriptor spec entry (`['pipe', 'r'|'w']`,
 * `['file', $path, $mode]`, `['pty']`) as a positional struct.
 */
type ProcDescriptor = struct {
    'pipe'|'file'|'pty' 0 as $type;
    ?string 1 as $arg1;
    ?string 2 as $arg2;
};

/**
 * Overlay: `proc_open()` `$options` keys (Windows-oriented; all optional).
 */
type ProcOpenOptions = struct {
    ?bool $bypass_shell;
    ?bool $suppress_errors;
    ?bool $blocking_pipes;
    ?bool $create_process_group;
    ?bool $create_new_console;
};

/**
 * Overlay: `proc_get_status()` array-shape return as `ProcStatus`.
 */
type ProcStatus = struct {
    string $command;
    int $pid;
    bool $running;
    bool $signaled;
    bool $stopped;
    int $exitcode;
    int $termsig;
    int $stopsig;
};

/**
 * Overlay: one `realpath_cache_get()` entry. The outer key is the original path.
 */
type RealpathCacheEntry = struct {
    string $key;
    bool $is_dir;
    string $realpath;
    int $expires;
};

/**
 * Overlay: `request_parse_body()` `$options`.
 */
type RequestParseOptions = struct {
    int|string|null $post_max_size;
    ?int $max_input_vars;
    ?int $max_multipart_body_parts;
    ?int $max_file_uploads;
};

/**
 * Overlay: `getrusage()` array-shape return. Dotted PHP keys are aliased.
 * Some keys are missing on Windows, so fields are optional.
 */
type Rusage = struct {
    ?int $ru_oublock;
    ?int $ru_inblock;
    ?int $ru_msgsnd;
    ?int $ru_msgrcv;
    ?int $ru_maxrss;
    ?int $ru_ixrss;
    ?int $ru_idrss;
    ?int $ru_minflt;
    ?int $ru_majflt;
    ?int $ru_nsignals;
    ?int $ru_nvcsw;
    ?int $ru_nivcsw;
    ?int $ru_nswap;
    ?int 'ru_utime.tv_usec' as $ru_utime_tv_usec;
    ?int 'ru_utime.tv_sec' as $ru_utime_tv_sec;
    ?int 'ru_stime.tv_usec' as $ru_stime_tv_usec;
    ?int 'ru_stime.tv_sec' as $ru_stime_tv_sec;
};

/**
 * Overlay: `stat()` / `lstat()` / `fstat()` array-shape return. PHP exposes
 * both named keys and numeric indexes `0`–`12`.
 */
type StatInfo = struct {
    int 0 as $devIndex;
    int 1 as $inoIndex;
    int 2 as $modeIndex;
    int 3 as $nlinkIndex;
    int 4 as $uidIndex;
    int 5 as $gidIndex;
    int 6 as $rdevIndex;
    int 7 as $sizeIndex;
    int 8 as $atimeIndex;
    int 9 as $mtimeIndex;
    int 10 as $ctimeIndex;
    int 11 as $blksizeIndex;
    int 12 as $blocksIndex;
    int $dev;
    int $ino;
    int $mode;
    int $nlink;
    int $uid;
    int $gid;
    int $rdev;
    int $size;
    int $atime;
    int $mtime;
    int $ctime;
    int $blksize;
    int $blocks;
};

/**
 * Overlay: `stream_context_get_params()` array-shape return.
 */
type StreamContextParams = struct {
    array<string, array<string, mixed>> $options;
    ?callable $notification;
};

/**
 * Overlay: `stream_get_meta_data()` array-shape return as `StreamMetadata`.
 */
type StreamMetadata = struct {
    bool $timed_out;
    bool $blocked;
    bool $eof;
    int $unread_bytes;
    string $stream_type;
    string $wrapper_type;
    mixed $wrapper_data;
    string $mode;
    bool $seekable;
    string $uri;
    ?array<string, mixed> $crypto;
    ?string $mediatype;
};

/**
 * Overlay: deprecated `strptime()` array-shape return.
 */
type StrptimeResult = struct {
    int $tm_sec;
    int $tm_min;
    int $tm_hour;
    int $tm_mday;
    int $tm_mon;
    int $tm_year;
    int $tm_wday;
    int $tm_yday;
    string $unparsed;
};

/**
 * Overlay: `gettimeofday(false)` array-shape return as `TimeOfDay`.
 */
type TimeOfDay = struct {
    int $sec;
    int $usec;
    int $minuteswest;
    int $dsttime;
};

/**
 * Overlay: `unserialize()` `$options` (`allowed_classes`, `max_depth`).
 */
type UnserializeOptions = struct {
    bool|array<int, string> $allowed_classes;
    ?int $max_depth;
};

/**
 * Overlay: `gettype()` result. Closed set of PHP spellings (`float` is `"double"`).
 */
type GettypeName = 'boolean'|'integer'|'double'|'string'|'array'|'object'|'resource'|'resource (closed)'|'NULL'|'unknown type';

/**
 * Overlay: `ob_start()` handler. The phase argument is optional.
 */
type OutputHandlerCallback = (callable(string, int): string)&(callable(string): string);

/**
 * Overlay: one `$descriptor_spec` value — pipe/file/pty array, `ProcDescriptor`,
 * or an already-open stream.
 */
type ProcDescriptorValue = ProcDescriptor|array<int, string>|resource;

// @overlay-against: function abs(int|float $num): int|float
function abs<T extends int|float>(T $num): T;

// @overlay-against: function array_chunk(array $array, int $length, bool $preserve_keys): array
function array_chunk<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    int $length,
    bool $preserve_keys = false
): array<int, array<TKey, TValue>>;

/**
 * Overlay: rows are unshaped; the extracted column is `mixed` keyed by int or string.
 */
// @overlay-against: function array_column(array $array, string|int|null $column_key, string|int|null $index_key): array
function array_column<TRow extends array<int|string, mixed>|object>(
    array<int|string, TRow> $array,
    string|int|null $column_key,
    string|int|null $index_key = null
): array<int|string, mixed>;

// @overlay-against: function array_combine(array $keys, array $values): array
function array_combine<TKey extends int|string, TValue>(
    array<int|string, TKey> $keys,
    array<int|string, TValue> $values
): array<TKey, TValue>;

/**
 * Overlay: values must be `int` or `string`; they become keys, counts are `int`.
 */
// @overlay-against: function array_count_values(array $array): array
function array_count_values<TValue extends int|string>(
    array<int|string, TValue> $array
): array<TValue, int>;

// @overlay-against: function array_diff(array $array, array $arrays): array
function array_diff<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed> ...$arrays
): array<TKey, TValue>;

// @overlay-against: function array_diff_assoc(array $array, array $arrays): array
function array_diff_assoc<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed> ...$arrays
): array<TKey, TValue>;

// @overlay-against: function array_diff_key(array $array, array $arrays): array
function array_diff_key<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed> ...$arrays
): array<TKey, TValue>;

/**
 * Overlay: remaining args mix comparison arrays and a key-compare callable.
 */
// @overlay-against: function array_diff_uassoc(array $array, mixed $rest): array
function array_diff_uassoc<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed>|callable ...$rest
): array<TKey, TValue>;

/**
 * Overlay: remaining args mix comparison arrays and a key-compare callable.
 */
// @overlay-against: function array_diff_ukey(array $array, mixed $rest): array
function array_diff_ukey<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed>|callable ...$rest
): array<TKey, TValue>;

// @overlay-against: function array_fill(int $start_index, int $count, mixed $value): array
function array_fill<TValue>(int $start_index, int $count, TValue $value): array<int, TValue>;

/**
 * Overlay: default mode (`0`) passes each value to the callback.
 */
// @overlay-against: function array_filter(array $array, ?callable $callback, int $mode): array
function array_filter<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    callable(TValue): bool $callback,
    0 $mode = 0
): array<TKey, TValue>;

/**
 * Overlay: `ARRAY_FILTER_USE_BOTH` (`1`) passes value then key.
 */
// @overlay-against: function array_filter(array $array, ?callable $callback, int $mode): array
function array_filter<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    callable(TValue, TKey): bool $callback,
    1 $mode
): array<TKey, TValue>;

/**
 * Overlay: `ARRAY_FILTER_USE_KEY` (`2`) passes only the key.
 */
// @overlay-against: function array_filter(array $array, ?callable $callback, int $mode): array
function array_filter<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    callable(TKey): bool $callback,
    2 $mode
): array<TKey, TValue>;

/**
 * Overlay: null callback (falsy filter) and runtime-int `$mode` catch-all.
 */
// @overlay-against: function array_filter(array $array, ?callable $callback, int $mode): array
function array_filter<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    ?callable $callback = null,
    int $mode = 0
): array<TKey, TValue>;

// @overlay-against: function array_intersect(array $array, array $arrays): array
function array_intersect<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed> ...$arrays
): array<TKey, TValue>;

// @overlay-against: function array_intersect_assoc(array $array, array $arrays): array
function array_intersect_assoc<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed> ...$arrays
): array<TKey, TValue>;

// @overlay-against: function array_intersect_key(array $array, array $arrays): array
function array_intersect_key<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed> ...$arrays
): array<TKey, TValue>;

/**
 * Overlay: remaining args mix comparison arrays and a key-compare callable.
 */
// @overlay-against: function array_intersect_uassoc(array $array, mixed $rest): array
function array_intersect_uassoc<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed>|callable ...$rest
): array<TKey, TValue>;

/**
 * Overlay: remaining args mix comparison arrays and a key-compare callable.
 */
// @overlay-against: function array_intersect_ukey(array $array, mixed $rest): array
function array_intersect_ukey<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed>|callable ...$rest
): array<TKey, TValue>;

// @overlay-against: function array_is_list(array $array): bool
function array_is_list<TKey extends int|string, TValue>(array<TKey, TValue> $array): bool;

// @overlay-against: function array_key_exists(mixed $key, array $array): bool
function array_key_exists<TKey extends int|string, TValue>(TKey $key, array<TKey, TValue> $array): $array[$key] is TValue;

// @overlay-against: function array_key_first(array $array): string|int|null
function array_key_first<TKey extends int|string, TValue>(array<TKey, TValue> $array): ?TKey;

// @overlay-against: function array_key_last(array $array): string|int|null
function array_key_last<TKey extends int|string, TValue>(array<TKey, TValue> $array): ?TKey;

/**
 * Overlay: all keys; `$filter_value` is optional (Layer 1 harvest required it).
 */
// @overlay-against: function array_keys(array $array, mixed $filter_value, bool $strict): array
function array_keys<TKey extends int|string, TValue>(array<TKey, TValue> $array): array<int, TKey>;

/**
 * Overlay: keys whose values equal `$filter_value`.
 */
// @overlay-against: function array_keys(array $array, mixed $filter_value, bool $strict): array
function array_keys<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    TValue $filter_value,
    bool $strict = false
): array<int, TKey>;

/**
 * Overlay: single-array map; `TResult` is the callback return (including void/never).
 */
// @overlay-against: function array_map(?callable $callback, array $array, array $arrays): array
function array_map<TKey extends int|string, TValue, TResult extends void|never|mixed>(
    callable(TValue): TResult $callback,
    array<TKey, TValue> $array
): array<TKey, TResult>;

// zip operation when callback is null
// @overlay-against: function array_map(?callable $callback, array $array, array $arrays): array
function array_map<TValue>(null $callback, array<TValue> $array, array<TValue> ...$arrays): array<int, array<int, TValue>>;

/**
 * Overlay: extra-array zip uses Slice from index 1 (`TMin = 1`) so a one-array call
 * stays on the key-preserving overload. TZip is the non-null element schema; callback
 * parameters are a spliced `__Nullable` pack.
 */
// @overlay-against: function array_map(?callable $callback, array $array, array $arrays): array
function array_map<TZip extends callable>(
    callable(__Nullable<__CallableParametersRest<TZip>> ...): __CallableReturnType<TZip> $callback,
    array<__CallableParametersSlice<TZip, 0>> $array,
    array<__CallableParametersSlice<TZip, 1, 1>> ...$arrays
): array<int, __CallableReturnType<TZip>>;

// @overlay-against: function array_merge(array $arrays): array
function array_merge<TKey extends int|string, TValue>(array<TKey, TValue> ...$arrays): array<TKey, TValue>;

// @overlay-against: function array_merge_recursive(array $arrays): array
function array_merge_recursive<TKey extends int|string, TValue>(array<TKey, TValue> ...$arrays): array<TKey, TValue>;

// @overlay-against: function array_pad(array $array, int $length, mixed $value): array
function array_pad<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    int $length,
    TValue $value
): array<TKey, TValue>;

// @overlay-against: function array_pop(array $array): mixed
function array_pop<TKey extends int|string, TValue>(array<TKey, TValue> &$array): ?TValue;

// @overlay-against: function array_product(array $array): int|float
function array_product<TKey extends int|string, TValue extends int|float>(array<TKey, TValue> $array): int|float;

// @overlay-against: function array_push(array $array, mixed $values): int
function array_push<TKey extends int|string, TValue>(array<TKey, TValue> &$array, TValue ...$values): int;

/**
 * Overlay: default `$num = 1` returns a single key.
 */
// @overlay-against: function array_rand(array $array, int $num): array|string|int
function array_rand<TKey extends int|string, TValue>(array<TKey, TValue> $array): TKey;

/**
 * Overlay: literal `1` is a single key (same as omitting `$num`).
 */
// @overlay-against: function array_rand(array $array, int $num): array|string|int
function array_rand<TKey extends int|string, TValue>(array<TKey, TValue> $array, 1 $num): TKey;

/**
 * Overlay: `$num > 1` is a list of keys; a runtime int is the union.
 */
// @overlay-against: function array_rand(array $array, int $num): array|string|int
function array_rand<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    int $num
): array<int, TKey>|TKey;

/**
 * Overlay: `$callback` is `(TCarry, TValue): TCarry`; the carry is not inverted with the element type.
 */
// @overlay-against: function array_reduce(array $array, callable $callback, mixed $initial): mixed
function array_reduce<TValue, TCarry>(
    array<TValue> $array,
    callable(TCarry, TValue): TCarry $callback,
    TCarry $initial = null
): TCarry;

// @overlay-against: function array_replace(array $array, array $replacements): array
function array_replace<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<TKey, TValue> ...$replacements
): array<TKey, TValue>;

// @overlay-against: function array_replace_recursive(array $array, array $replacements): array
function array_replace_recursive<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<TKey, TValue> ...$replacements
): array<TKey, TValue>;

// @overlay-against: function array_reverse(array $array, bool $preserve_keys): array
function array_reverse<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    bool $preserve_keys = false
): array<TKey, TValue>;

// @overlay-against: function array_search(mixed $needle, array $haystack, bool $strict): string|int|false
function array_search<TKey extends int|string, TValue>(
    TValue $needle,
    array<TKey, TValue> $haystack,
    bool $strict = false
): TKey|false;

// @overlay-against: function array_shift(array $array): mixed
function array_shift<TKey extends int|string, TValue>(array<TKey, TValue> &$array): ?TValue;

// @overlay-against: function array_slice(array $array, int $offset, ?int $length, bool $preserve_keys): array
function array_slice<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    int $offset,
    ?int $length = null,
    bool $preserve_keys = false
): array<TKey, TValue>;

// @overlay-against: function array_splice(array $array, int $offset, ?int $length, mixed $replacement): array
function array_splice<TKey extends int|string, TValue>(
    array<TKey, TValue> &$array,
    int $offset,
    ?int $length = null,
    mixed $replacement = []
): array<TKey, TValue>;

// @overlay-against: function array_sum(array $array): int|float
function array_sum<TKey extends int|string, TValue extends int|float>(array<TKey, TValue> $array): int|float;

/**
 * Overlay: remaining args mix comparison arrays and a value-compare callable.
 */
// @overlay-against: function array_udiff(array $array, mixed $rest): array
function array_udiff<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed>|callable ...$rest
): array<TKey, TValue>;

/**
 * Overlay: remaining args mix comparison arrays and a value-compare callable.
 */
// @overlay-against: function array_udiff_assoc(array $array, mixed $rest): array
function array_udiff_assoc<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed>|callable ...$rest
): array<TKey, TValue>;

/**
 * Overlay: remaining args mix comparison arrays and value/key-compare callables.
 */
// @overlay-against: function array_udiff_uassoc(array $array, mixed $rest): array
function array_udiff_uassoc<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed>|callable ...$rest
): array<TKey, TValue>;

/**
 * Overlay: remaining args mix comparison arrays and a value-compare callable.
 */
// @overlay-against: function array_uintersect(array $array, mixed $rest): array
function array_uintersect<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed>|callable ...$rest
): array<TKey, TValue>;

/**
 * Overlay: remaining args mix comparison arrays and a value-compare callable.
 */
// @overlay-against: function array_uintersect_assoc(array $array, mixed $rest): array
function array_uintersect_assoc<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed>|callable ...$rest
): array<TKey, TValue>;

/**
 * Overlay: remaining args mix comparison arrays and value/key-compare callables.
 */
// @overlay-against: function array_uintersect_uassoc(array $array, mixed $rest): array
function array_uintersect_uassoc<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    array<int|string, mixed>|callable ...$rest
): array<TKey, TValue>;

// @overlay-against: function array_unique(array $array, int $flags): array
function array_unique<TKey extends int|string, TValue>(
    array<TKey, TValue> $array,
    int $flags = \SORT_STRING
): array<TKey, TValue>;

// @overlay-against: function array_unshift(array $array, mixed $values): int
function array_unshift<TKey extends int|string, TValue>(array<TKey, TValue> &$array, TValue ...$values): int;

// @overlay-against: function array_values(array $array): array
function array_values<TKey extends int|string, TValue>(array<TKey, TValue> $array): array<int, TValue>;

/**
 * Overlay: restore optional `$arg`; callback is value, key, then the extra arg.
 */
// @overlay-against: function array_walk(object|array $array, callable $callback, mixed $arg): true
