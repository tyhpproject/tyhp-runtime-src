 */
// @overlay-against: function parse_url(string $url, int $component): array|string|int|false|null
function parse_url(string $url, 0 $component): string|false|null;

/**
 * Overlay: `PHP_URL_HOST` (`1`) returns the host string.
 *
 * @param string $url The URL to parse.
 * @param 1 $component `PHP_URL_HOST`.
 * @return string|false|null Host, false on failure, or null if absent.
 */
// @overlay-against: function parse_url(string $url, int $component): array|string|int|false|null
function parse_url(string $url, 1 $component): string|false|null;

/**
 * Overlay: `PHP_URL_PORT` (`2`) narrows the return to a port number.
 *
 * @param string $url The URL to parse.
 * @param 2 $component `PHP_URL_PORT`.
 * @return int|false|null Port, false on failure, or null if the component is absent.
 */
// @overlay-against: function parse_url(string $url, int $component): array|string|int|false|null
function parse_url(string $url, 2 $component): int|false|null;

/**
 * Overlay: `PHP_URL_USER` (`3`) returns the user string.
 *
 * @param string $url The URL to parse.
 * @param 3 $component `PHP_URL_USER`.
 * @return string|false|null User, false on failure, or null if absent.
 */
// @overlay-against: function parse_url(string $url, int $component): array|string|int|false|null
function parse_url(string $url, 3 $component): string|false|null;

/**
 * Overlay: `PHP_URL_PASS` (`4`) returns the password string.
 *
 * @param string $url The URL to parse.
 * @param 4 $component `PHP_URL_PASS`.
 * @return string|false|null Password, false on failure, or null if absent.
 */
// @overlay-against: function parse_url(string $url, int $component): array|string|int|false|null
function parse_url(string $url, 4 $component): string|false|null;

/**
 * Overlay: `PHP_URL_PATH` (`5`) returns the path string.
 *
 * @param string $url The URL to parse.
 * @param 5 $component `PHP_URL_PATH`.
 * @return string|false|null Path, false on failure, or null if absent.
 */
// @overlay-against: function parse_url(string $url, int $component): array|string|int|false|null
function parse_url(string $url, 5 $component): string|false|null;

/**
