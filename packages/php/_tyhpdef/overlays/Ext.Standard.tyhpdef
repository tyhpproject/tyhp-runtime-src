    false $raw = false
): array<int, DnsRecord>|false;

/**
 * Overlay: `$raw = true` rows are `DnsRawRecord` (`$type` is an int, `$data` is unparsed).
 */
// @overlay-against: function dns_get_record(string $hostname, int $type, mixed $authoritative_name_servers, mixed $additional_records, bool $raw): array|false
