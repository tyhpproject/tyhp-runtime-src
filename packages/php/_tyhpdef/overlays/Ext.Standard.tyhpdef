 * @return string|false|null Query, false on failure, or null if absent.
 */
// @overlay-against: function parse_url(string $url, int $component): array|string|int|false|null
function parse_url(string $url, 6 $component): string|false|null;

/**
 * Overlay: `PHP_URL_FRAGMENT` (`7`) returns the fragment string.
 *
 * @param string $url The URL to parse.
 * @param 7 $component `PHP_URL_FRAGMENT`.
 * @return string|false|null Fragment, false on failure, or null if absent.
 */
// @overlay-against: function parse_url(string $url, int $component): array|string|int|false|null
function parse_url(string $url, 7 $component): string|false|null;

/**
