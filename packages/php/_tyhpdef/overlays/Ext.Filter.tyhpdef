<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef`  (not under `overlays/stubs/`)
 * Filter signature enrichments: `filter_var` / `filter_input` literal-filter
 * overloads, options structs, and generic `array` replacements. Not Pure.
 *
 * Filter-id overloads use integer literals (Decision 18: `const int NAME ?? N`
 * is literal `N` at the call site). Bitwise `|` of `FILTER_*` constants is not
 * folded to a literal, so those calls use the `int` catch-all.
 */

/**
 * Overlay: names returned by `filter_list()` / accepted by `filter_id()`.
 */
type FilterName = 'add_slashes'|'boolean'|'callback'|'email'|'encoded'|'float'|'full_special_chars'|'int'|'number_float'|'number_int'|'special_chars'|'string'|'stripped'|'unsafe_raw'|'url'|'validate_domain'|'validate_email'|'validate_ip'|'validate_mac'|'validate_regexp'|'validate_url';

/**
 * Overlay: nested `"options"` for a per-key `filter_*_array` spec or `FilterVarOptions`.
 * Inner bags are filter-specific; `FILTER_CALLBACK` stores the callback on this key.
 */
type FilterNestedOptions = FilterIntRangeOptions|FilterFloatRangeOptions|FilterRegexpPattern|(callable(string): mixed);

/**
 * Overlay: sanitization filter ids and `FILTER_DEFAULT` / `FILTER_UNSAFE_RAW` (`516`).
 * `FILTER_SANITIZE_STRING` / `FILTER_SANITIZE_STRIPPED` share `513`.
 */
type FilterSanitizeId = 513|514|515|516|517|518|519|520|522|523;

/**
 * Overlay: string-returning validation filter ids (`FILTER_VALIDATE_REGEXP`…`DOMAIN`).
 */
type FilterValidateStringId = 272|273|274|275|276|277;

/**
 * Overlay: `FILTER_CALLBACK` (`1024`) options. The PHP `"options"` key is the callback.
 * PHP documents `callback(string $value): mixed` — scalars are converted to string
 * before the callback runs. `T` is the callback's return (the filtered value).
 *
 * @template T Callback return type.
 */
type FilterCallbackOptions<T = mixed> = struct {
    callable(string): T $options;
    ?int $flags;
};

/**
 * Overlay: per-key spec in `filter_var_array` / `filter_input_array` option maps.
 * `$filter` is a `FILTER_*` id; `$options` is that filter's option bag or callback.
 */
type FilterFieldSpec = struct {
    int $filter;
    ?int $flags;
    ?FilterNestedOptions $options;
};

/**
 * Overlay: `FILTER_VALIDATE_FLOAT` option array (`flags` + nested range/decimal).
 *
 * @template TDefault Value returned when filtering fails if `"default"` is set.
 */
type FilterFloatOptions<TDefault = float> = struct {
    ?int $flags;
    ?FilterFloatRangeOptions<TDefault> $options;
};

/**
 * Overlay: nested `"options"` for `FILTER_VALIDATE_FLOAT`.
 *
 * @template TDefault Value returned when filtering fails if `"default"` is set.
 */
type FilterFloatRangeOptions<TDefault = float> = struct {
    ?string $decimal;
    ?float $min_range;
    ?float $max_range;
    ?TDefault $default;
};

/**
 * Overlay: `FILTER_VALIDATE_INT` option array (`flags` + nested min/max/default).
 *
 * @template TDefault Value returned when filtering fails if `"default"` is set.
 */
type FilterIntOptions<TDefault = int> = struct {
    ?int $flags;
    ?FilterIntRangeOptions<TDefault> $options;
};

/**
 * Overlay: nested `"options"` for `FILTER_VALIDATE_INT`.
 *
 * @template TDefault Value returned when filtering fails if `"default"` is set.
 */
type FilterIntRangeOptions<TDefault = int> = struct {
    ?int $min_range;
    ?int $max_range;
    ?TDefault $default;
};

/**
 * Overlay: `FILTER_VALIDATE_REGEXP` option array. `"regexp"` is required.
 *
 * @template TDefault Value returned when filtering fails if `"default"` is set.
 */
type FilterRegexpOptions<TDefault = string> = struct {
    ?int $flags;
    FilterRegexpPattern<TDefault> $options;
};

/**
 * Overlay: nested `"options"` for `FILTER_VALIDATE_REGEXP`.
 *
 * @template TDefault Value returned when filtering fails if `"default"` is set.
 */
type FilterRegexpPattern<TDefault = string> = struct {
    string $regexp;
    ?TDefault $default;
};

/**
 * Overlay: generic flags/options bag (`"flags"`, `"options"`, optional `"filter"`).
 */
type FilterVarOptions = struct {
    ?int $flags;
    ?int $filter;
    ?FilterNestedOptions $options;
};

/**
 * Overlay: known filter names resolve to that filter's id.
 *
 * @param FilterName $name A name from `filter_list()`.
 * @return int Filter id.
 */
// @overlay-against: function filter_id(string $name): int|false
function filter_id(FilterName $name): int;

/**
 * Overlay: unknown names may be missing (`false`).
 *
 * @param string $name Filter name.
 * @return int|false Filter id, or false if `$name` is not a filter.
 */
// @overlay-against: function filter_id(string $name): int|false
function filter_id(string $name): int|false;

/**
 * Overlay: default `FILTER_DEFAULT` — raw string, or false/null when missing/failing.
 *
 * @param int $type One of `INPUT_GET` / `INPUT_POST` / `INPUT_COOKIE` / `INPUT_SERVER` / `INPUT_ENV`.
 * @param string $var_name Variable name in that input array.
 * @return string|false|null Filtered string, false on filter failure, or null if unset.
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name): string|false|null;

/**
 * Overlay: `FILTER_VALIDATE_INT` (`257`). Unset is null; failure is false.
 *
 * @param 257 $filter `FILTER_VALIDATE_INT`.
 * @param 0 $options No flags.
 * @return int|false|null
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, 257 $filter, 0 $options = 0): int|false|null;

/**
 * Overlay: `FILTER_VALIDATE_INT` with a flags bitmask or options struct.
 *
 * @param 257 $filter `FILTER_VALIDATE_INT`.
 * @return int|false|null
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, 257 $filter, FilterIntOptions|array<string, mixed>|int $options): int|false|null;

/**
 * Overlay: `FILTER_VALIDATE_BOOL` / `FILTER_VALIDATE_BOOLEAN` (`258`).
 *
 * @param 258 $filter `FILTER_VALIDATE_BOOL`.
 * @param 0 $options No flags.
 * @return bool|null Bool result, or null if unset. Failure is `false` (a bool).
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, 258 $filter, 0 $options = 0): bool|null;

/**
 * Overlay: `FILTER_VALIDATE_BOOL` with flags or an options struct.
 *
 * @param 258 $filter `FILTER_VALIDATE_BOOL`.
 * @return bool|null
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, 258 $filter, FilterVarOptions|array<string, mixed>|int $options): bool|null;

/**
 * Overlay: `FILTER_VALIDATE_FLOAT` (`259`).
 *
 * @param 259 $filter `FILTER_VALIDATE_FLOAT`.
 * @param 0 $options No flags.
 * @return float|false|null
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, 259 $filter, 0 $options = 0): float|false|null;

/**
 * Overlay: `FILTER_VALIDATE_FLOAT` with flags or an options struct.
 *
 * @param 259 $filter `FILTER_VALIDATE_FLOAT`.
 * @return float|false|null
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, 259 $filter, FilterFloatOptions|array<string, mixed>|int $options): float|false|null;

/**
 * Overlay: string-returning validation filters (`FILTER_VALIDATE_EMAIL`, URL, IP, …).
 *
 * @param FilterValidateStringId $filter A `FILTER_VALIDATE_*` string filter.
 * @param 0 $options No flags.
 * @return string|false|null
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, FilterValidateStringId $filter, 0 $options = 0): string|false|null;

/**
 * Overlay: string-returning validation filters with flags or options.
 *
 * @param FilterValidateStringId $filter A `FILTER_VALIDATE_*` string filter.
 * @return string|false|null
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, FilterValidateStringId $filter, FilterRegexpOptions|FilterVarOptions|array<string, mixed>|int $options): string|false|null;

/**
 * Overlay: sanitization filters and `FILTER_DEFAULT`.
 *
 * @param FilterSanitizeId $filter A `FILTER_SANITIZE_*` id or `FILTER_DEFAULT`.
 * @param 0 $options No flags.
 * @return string|false|null
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, FilterSanitizeId $filter = 516, 0 $options = 0): string|false|null;

/**
 * Overlay: sanitization filters with flags or options.
 *
 * @param FilterSanitizeId $filter A `FILTER_SANITIZE_*` id or `FILTER_DEFAULT`.
 * @return string|false|null
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, FilterSanitizeId $filter, FilterVarOptions|array<string, mixed>|int $options): string|false|null;

/**
 * Overlay: `FILTER_CALLBACK` (`1024`). Missing input is null; otherwise the callback's return.
 *
 * @template TCallable of callable
 * @param 1024 $filter `FILTER_CALLBACK`.
 * @param array<string, TCallable> $options Callback under `"options"`.
 * @return __CallableReturnType<TCallable>|null
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input<TCallable extends callable>(
    int $type,
    string $var_name,
    1024 $filter,
    array<string, TCallable> $options
): __CallableReturnType<TCallable>|null;

/**
 * Overlay: `FILTER_CALLBACK` with a runtime flags bitmask.
 *
 * @param 1024 $filter `FILTER_CALLBACK`.
 * @return mixed
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, 1024 $filter, int $options): mixed;

/**
 * Overlay: runtime `int` filter (including unfolded `FILTER_* | FILTER_*`).
 *
 * @param int $type One of the `INPUT_*` constants.
 * @param string $var_name Variable name in that input array.
 * @param int $filter Any `FILTER_*` id.
 * @param FilterVarOptions|array<string, mixed>|int $options Flags bitmask or options array.
 * @return mixed Filtered value, false on failure, or null if unset.
 */
// @overlay-against: function filter_input(int $type, string $var_name, int $filter, array|int $options): mixed
function filter_input(int $type, string $var_name, int $filter = FILTER_DEFAULT, FilterVarOptions|array<string, mixed>|int $options = 0): mixed;

/**
 * Overlay: per-key filter specs. Result keys match the spec keys.
 *
 * @template TKey
 * @param array<TKey, mixed> $options Map of field name → filter id or `FilterFieldSpec`.
 * @param bool $add_empty Add missing keys as null.
 * @return array<TKey, mixed>|false|null
 */
// @overlay-against: function filter_input_array(int $type, array|int $options, bool $add_empty): array|false|null
function filter_input_array<TKey>(
    int $type,
    array<TKey, mixed> $options,
    bool $add_empty = true
): array<TKey, mixed>|false|null;

/**
 * Overlay: apply one filter id to every input variable of `$type`.
 *
 * @param int $type One of the `INPUT_*` constants.
 * @param int $options Filter id applied to each entry (`FILTER_DEFAULT` when omitted).
 * @param bool $add_empty Add missing keys as null.
 * @return array<string, mixed>|false|null Map of filtered values, false on failure, or null if that input type is empty.
 */
// @overlay-against: function filter_input_array(int $type, array|int $options, bool $add_empty): array|false|null
function filter_input_array(int $type, int $options = FILTER_DEFAULT, bool $add_empty = true): array<string, mixed>|false|null;

/**
 * Overlay: `FILTER_VALIDATE_INT` applied to every input variable of `$type`.
 *
 * @param 257 $options `FILTER_VALIDATE_INT`.
 * @return array<string, int|false|null>|false|null
 */
// @overlay-against: function filter_input_array(int $type, array|int $options, bool $add_empty): array|false|null
function filter_input_array(int $type, 257 $options, bool $add_empty = true): array<string, int|false|null>|false|null;

/**
 * Overlay: `FILTER_VALIDATE_BOOL` applied to every input variable of `$type`.
 *
 * @param 258 $options `FILTER_VALIDATE_BOOL`.
 * @return array<string, bool|null>|false|null
 */
// @overlay-against: function filter_input_array(int $type, array|int $options, bool $add_empty): array|false|null
function filter_input_array(int $type, 258 $options, bool $add_empty = true): array<string, bool|null>|false|null;

/**
 * Overlay: `FILTER_VALIDATE_FLOAT` applied to every input variable of `$type`.
 *
 * @param 259 $options `FILTER_VALIDATE_FLOAT`.
 * @return array<string, float|false|null>|false|null
 */
// @overlay-against: function filter_input_array(int $type, array|int $options, bool $add_empty): array|false|null
function filter_input_array(int $type, 259 $options, bool $add_empty = true): array<string, float|false|null>|false|null;

/**
 * Overlay: string-returning validation filter applied to every input variable of `$type`.
 *
 * @param FilterValidateStringId $options A `FILTER_VALIDATE_*` string filter.
 * @return array<string, string|false|null>|false|null
 */
// @overlay-against: function filter_input_array(int $type, array|int $options, bool $add_empty): array|false|null
function filter_input_array(int $type, FilterValidateStringId $options, bool $add_empty = true): array<string, string|false|null>|false|null;

/**
 * Overlay: sanitization filter / `FILTER_DEFAULT` applied to every input variable of `$type`.
