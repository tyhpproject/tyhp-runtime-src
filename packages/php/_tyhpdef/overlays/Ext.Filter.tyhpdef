 * @param int $value Integer to validate.
 * @param 257 $filter `FILTER_VALIDATE_INT`.
 * @param 0 $options No flags.
 * @return int The same integer.
 */
// @overlay-against: function filter_var(mixed $value, int $filter, array|int $options): mixed
function filter_var(int $value, 257 $filter, 0 $options = 0): int;

/**
 * Overlay: `FILTER_VALIDATE_INT` (`257`). Failure is false.
