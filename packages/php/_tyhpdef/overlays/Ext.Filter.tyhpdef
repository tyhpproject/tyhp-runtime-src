// @overlay-against: function filter_input_array(int $type, array|int $options, bool $add_empty): array|false|null
function filter_input_array(int $type, FilterSanitizeId $options, bool $add_empty = true): array<string, string|false|null>|false|null;

/**
 * Overlay: supported filter names as a list of strings (indexes are not filter ids).
