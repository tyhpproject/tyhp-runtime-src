<?tyhp

namespace OverlayTests\Date;

function getdate_fieldAccess_secondsAndTimestampAreInt(): void {
    $d = \getdate();
    int $seconds = $d->seconds;
    int $timestamp = $d->timestamp;
}

function datePeriod_threeArgConstructor_getIteratorYieldsTDate(\DateTime $start, \DateInterval $interval, \DateTime $end): void {
    new \DatePeriod($start, $interval, $end);
    $period = new \DatePeriod<\DateTime, \DateTime>($start, $interval, $end);
    \Iterator<int, \DateTime> $it = $period->getIterator();
    \DateTime $fromStart = $period->getStartDate();
    foreach ($period as $key => $date) {
        int $checkKey = $key;
        \DateTime $checkDate = $date;
    }
}

function dateInterval_daysProperty_isInt(\DateInterval $interval): int {
    return $interval->d;
}

function dateTime_lessThanAndSpaceship_typeCheckAgainstDateTimeInterface(\DateTime $dt, \DateTimeInterface $other, \DateTimeImmutable $imm, \DateTime $otherDt): void {
    bool $less = $dt < $other;
    int $spaceship = $dt <=> $other;
    bool $immutableLess = $imm < $otherDt;
}

function dateTime_plusInterval_isDateTime(\DateTime $dt, \DateInterval $interval, \DateTimeImmutable $imm): void {
    \DateTime $added = $dt + $interval;
    \DateTimeImmutable $addedImm = $imm + $interval;
    \DateTime $subbed = $dt - $interval;
}

function dateTime_minusDateTime_isDateInterval(\DateTime $dt, \DateTimeInterface $other, \DateTimeImmutable $imm): void {
    \DateInterval $diff = $dt - $other;
    \DateInterval $diffImm = $imm - $other;
}

function dateParse_resultFields_areStructNotArray(): void {
    $parsed = \date_parse("now");
    int|false $year = $parsed->year;
    float|false $fraction = $parsed->fraction;
    array<int, string> $errors = $parsed->errors;
    bool $isLocal = $parsed->is_localtime;
}

function dateTime_serialize_isDateTimeSerializeState(\DateTime $dt, \DateTimeImmutable $imm, \DateTimeInterface $iface): void {
    \DateTimeSerializeState $fromDt = $dt->__serialize();
    \DateTimeSerializeState $fromImm = $imm->__serialize();
    \DateTimeSerializeState $fromIface = $iface->__serialize();
}
