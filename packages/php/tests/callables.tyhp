<?tyhp

namespace OverlayTests\Callables;

function greet(string $name, int $age): string {
    return $name;
}

function forwardStaticCall_infersReturnAndChecksRestArgs(): void {
    string $s = \forward_static_call(greet(...), 'Ada', 36);
}

function forwardStaticCallUnsafe_acceptsUntypedArgs(callable $cb, mixed $a, mixed $b): mixed {
    return \forward_static_call_unsafe($cb, $a, $b);
}

function forwardStaticCallArray_namedBag_assignsAndReturnsCallableReturnType(): void {
    string $s = \forward_static_call_array(greet(...), ['name' => 'Ada', 'age' => 36]);
}

function forwardStaticCallArray_positionalBag_assignsAndReturnsCallableReturnType(): void {
    string $s = \forward_static_call_array(greet(...), ['Ada', 36]);
}

function forwardStaticCallArray_callableArgs2Variable_selectsTupleAndReturnsCallableReturnType(\CallableArgs2<string, int> $args): void {
    string $s = \forward_static_call_array(greet(...), $args);
}

function forwardStaticCallArrayUnsafe_acceptsUntypedArray(callable $cb, array $args): mixed {
    return \forward_static_call_array_unsafe($cb, $args);
}

function registerShutdownFunction_checksRestArgs(): void {
    \register_shutdown_function(greet(...), 'Ada', 36);
}
