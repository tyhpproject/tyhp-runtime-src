<?tyhp

namespace OverlayTests\Json;

function jsonDecode_trueAssociative_isJsonAssocOrNull(string $s): \JsonAssoc|null {
    return \json_decode($s, true);
}

function jsonDecode_falseAssociative_isJsonObjectOrNull(string $s): \JsonObject|null {
    return \json_decode($s, false);
}

function jsonDecode_defaultCall_isJsonObjectOrNull(string $s): \JsonObject|null {
    return \json_decode($s);
}

function jsonDecode_trueThrowOnError_isJsonAssoc(string $s): \JsonAssoc {
    return \json_decode($s, true, 512, \JSON_THROW_ON_ERROR);
}

function jsonDecode_objectAsArrayFlag_isJsonAssocOrNull(string $s): \JsonAssoc|null {
    return \json_decode($s, null, 512, \JSON_OBJECT_AS_ARRAY);
}

function jsonDecode_assocResult_isUsableAsArray(string $s): int {
    \JsonAssoc|null $decoded = \json_decode($s, true);
    if (\is_array($decoded)) {
        return \count($decoded);
    }
    return 0;
}

function jsonDecode_namedThrowOnErrorFlags_isJsonAssoc(string $s): \JsonAssoc {
    return \json_decode($s, true, flags: \JSON_THROW_ON_ERROR);
}

function jsonDecode_namedObjectAsArrayFlags_isJsonAssocOrNull(string $s): \JsonAssoc|null {
    return \json_decode($s, flags: \JSON_OBJECT_AS_ARRAY);
}

function jsonEncode_throwOnError_isString(mixed $v): string {
    return \json_encode($v, \JSON_THROW_ON_ERROR);
}

function jsonEncode_defaultFlags_isStringOrFalse(mixed $v): string|false {
    return \json_encode($v);
}

declare(php=">=8.3") {
    function json_validate_gated(string $s): bool {
        return \json_validate($s);
    }
}
