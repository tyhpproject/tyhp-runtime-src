<?tyhp

namespace OverlayTests\Standard;

function strReplace_stringSubject_isString_andChainsIntoLtrim(string $s): string {
    return \ltrim(\str_replace('a', 'b', $s), ' ');
}

function strReplace_arraySubject_isArrayOfString(array<int, string> $s): array<int, string> {
    return \str_replace('a', 'b', $s);
}

function strReplace_arraySearchAndReplace_isString(string $s): string {
    return \str_replace(['a', 'b'], ['x', 'y'], $s);
}

function strIreplace_arraySearch_isString(string $s): string {
    return \str_ireplace(['A'], ['x'], $s);
}

function strWordCount_default_isInt(string $s): int {
    return \str_word_count($s);
}

function strWordCount_format1_isStringList(string $s): array<int, string> {
    return \str_word_count($s, 1);
}

function strWordCount_format2_isOffsetMap(string $s): array<int, string> {
    return \str_word_count($s, 2);
}

function stripTags_stringAllowed_isString(string $s): string {
    return \strip_tags($s, '<p><a>');
}

function stripTags_tagNameList_isString(string $s): string {
    return \strip_tags($s, ['p', 'a']);
}

function arrayMap_callbackReturn_isArrayOfString(): array<string> {
    return \array_map(fn(int $n): string => (string) $n, [1, 2]);
}

function isInt_guardReturn_narrowsMixedToInt(mixed $x): void {
    if (\is_int($x)) {
        int $y = $x;
    }
}

class User {
}

function arrayValues_reindexesToIntKeys(array<string, User> $users): array<int, User> {
    return \array_values($users);
}

function arrayReduce_carryIsNotInvertedWithElementType(array<int> $nums): int {
    return \array_reduce($nums, fn(int $c, int $n): int => $c + $n, 0);
}

function arraySearch_returnsKeyOrFalse(User $user, array<string, User> $users): string|false {
    return \array_search($user, $users);
}

function arrayKeys_noFilterValueRequired(array<string, int> $arr): array<int, string> {
    return \array_keys($arr);
}

function arrayKeys_withFilter_stillReturnsKeys(array<string, int> $arr): array<int, string> {
    return \array_keys($arr, 1, true);
}

function minMax_arrayArgument_returnsElementNotArray(array<int> $arr): int {
    int $fromLiteral = \min([1, 2, 3]);
    int $fromVariable = \min($arr);
    int $maxFromLiteral = \max([1, 2, 3]);
    return $fromVariable;
}

function minMax_variadic_returnsElementType(): int {
    int $mn = \min(1, 2, 3);
    int $mx = \max(1, 2, 3);
    return $mn;
}

declare(php=">=8.4") {
    function arrayFind_gated_returnsNullableTValue(array<int, User> $users): ?User {
        return \array_find($users, fn(User $u, int $k): bool => true);
    }

    function arrayFindKey_gated_returnsNullableTKey(array<int, User> $users): ?int {
        return \array_find_key($users, fn(User $u, int $k): bool => true);
    }

    function arrayAny_gated(array<int, User> $users): bool {
        return \array_any($users, fn(User $u, int $k): bool => true);
    }

    function arrayAll_gated(array<int, User> $users): bool {
        return \array_all($users, fn(User $u, int $k): bool => true);
    }
}

declare(php=">=8.5") {
    function arrayFirst_gated_returnsNullableTValue(array<int, User> $users): ?User {
        return \array_first($users);
    }

    function arrayLast_gated_returnsNullableTValue(array<int, User> $users): ?User {
        return \array_last($users);
    }
}

function parseUrl_omittedComponent_isStructOrFalse(string $u): \ParseUrlComponents|false {
    return \parse_url($u);
}

function parseUrl_literal2_isIntOrFalseOrNull(string $u): int|false|null {
    return \parse_url($u, 2);
}

function parseUrl_literalMinus1_isStructOrFalse(string $u): \ParseUrlComponents|false {
    return \parse_url($u, -1);
}

function parseUrl_phpUrlHostConst_selectsStringOverload(string $u): string|false|null {
    return \parse_url($u, \PHP_URL_HOST);
}

function implode_separatorAndArray_isString(): string {
    return \implode(',', ['a', 'b']);
}

function join_arrayOnly_isString(): string {
    return \join(['a', 'b']);
}

function range_mixedBounds_isIntFloatOrStringList(string|int|float $start, string|int|float $end): array<int, int|float|string> {
    return \range($start, $end);
}

function arrayDiff_preservesKeyAndValue(array<string, int> $a, array<int, int> $b): array<string, int> {
    return \array_diff($a, $b);
}

function getenv_noName_isArrayOrFalse(): array<string, string>|false {
    return \getenv();
}

function getenv_named_isStringOrFalse(): string|false {
    return \getenv('PATH');
}

function substrReplace_arraySubject_isArrayOfString(array<int, string> $s): array<int, string> {
    return \substr_replace($s, 'x', 0, 1);
}

function gettype_int_isInteger(): 'integer' {
    return \gettype(1);
}

function gettype_float_isDouble(): 'double' {
    return \gettype(1.5);
}

function gettype_null_isNull(): 'NULL' {
    return \gettype(null);
}

function microtime_true_isFloat(): float {
    return \microtime(true);
}

function microtime_default_isString(): string {
    return \microtime();
}

function versionCompare_noOperator_isOrdering(): -1|0|1 {
    return \version_compare('1.0.0', '1.1.0');
}

function versionCompare_operator_isBool(): bool {
    return \version_compare('1.0.0', '1.1.0', '<');
}

function max_strings_isString(): string {
    return \max('a', 'b');
}
