<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 *
 * Omit bundle / debug command: they extend unwrapped HttpKernel + Console peers.
 * Live event payloads, form values, and LiveProp writable paths.
 */

namespace Symfony\UX\LiveComponent {
    /**
     * One entry from `LiveResponder::getBrowserEventsToDispatch()`.
     */
    type LiveBrowserEvent = struct {
        string $event;
        array<string, mixed> $payload;
    };

    /**
     * One entry from `LiveResponder::getEventsToEmit()`.
     */
    type LiveEmitEvent = struct {
        string $event;
        array<string, mixed> $data;
        ?string $target;
        ?string $componentName;
    };

    /**
     * Overlay: emit payloads are string-keyed maps.
     */
    // @overlay-against: trait ComponentToolsTrait
    partial trait ComponentToolsTrait {
        /**
         * @param array<string, mixed> $data
         */
        // @overlay-against: function emit(string $eventName, array $data, ?string $componentName): void
        public function emit(string $eventName, array<string, mixed> $data = [], ?string $componentName = null): void;

        /**
         * @param array<string, mixed> $data
         */
        // @overlay-against: function emitUp(string $eventName, array $data, ?string $componentName): void
        public function emitUp(string $eventName, array<string, mixed> $data = [], ?string $componentName = null): void;

        /**
         * @param array<string, mixed> $data
         */
        // @overlay-against: function emitSelf(string $eventName, array $data): void
        public function emitSelf(string $eventName, array<string, mixed> $data = []): void;

        /**
         * @param array<string, mixed> $payload
         */
        // @overlay-against: function dispatchBrowserEvent(string $eventName, array $payload): void
        public function dispatchBrowserEvent(string $eventName, array<string, mixed> $payload = []): void;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `ComponentValidatorInterface`.
     */
    // @overlay-against: interface ComponentValidatorInterface
    partial interface ComponentValidatorInterface {
        /**
         * @return array<int, \Symfony\Component\Validator\ConstraintViolation>
         */
        // @overlay-against: function validateField(object $component, string $propertyName): array
        public function validateField(object $component, string $propertyName): array<int, \Symfony\Component\Validator\ConstraintViolation>;
    }

    /**
     * Overlay: raw form values and the field-name list that has been validated.
     */
    // @overlay-against: trait ComponentWithFormTrait
    partial trait ComponentWithFormTrait {
        /**
         * @var array<string, mixed>
         */
        // @overlay-against: array $formValues
        public array<string, mixed> $formValues ?? [];

        /**
         * @var array<int, string>
         */
        // @overlay-against: array $validatedFields
        public array<int, string> $validatedFields ?? [];
    }

    /**
     * Extends unwrapped `\Symfony\Component\HttpKernel\Bundle\Bundle`.
     */
    // @overlay-against: class LiveComponentBundle extends \Symfony\Component\HttpKernel\Bundle\Bundle
    omit class LiveComponentBundle {
    }

    /**
     * Overlay: events queued for the next render.
     */
    // @overlay-against: class LiveResponder
    partial class LiveResponder {
        /**
         * @param array<string, mixed> $payload
         */
        // @overlay-against: function dispatchBrowserEvent(string $event, array $payload): void
        public function dispatchBrowserEvent(string $event, array<string, mixed> $payload = []): void;

        /**
         * @param array<string, mixed> $data
         */
        // @overlay-against: function emit(string $eventName, array $data, ?string $componentName): void
        public function emit(string $eventName, array<string, mixed> $data = [], ?string $componentName = null): void;

        /**
         * @param array<string, mixed> $data
         */
        // @overlay-against: function emitSelf(string $eventName, array $data): void
        public function emitSelf(string $eventName, array<string, mixed> $data = []): void;

        /**
         * @param array<string, mixed> $data
         */
        // @overlay-against: function emitUp(string $eventName, array $data, ?string $componentName): void
        public function emitUp(string $eventName, array<string, mixed> $data = [], ?string $componentName = null): void;

        /**
         * @return array<int, \Symfony\UX\LiveComponent\LiveBrowserEvent>
         */
        // @overlay-against: function getBrowserEventsToDispatch(): array
        public function getBrowserEventsToDispatch(): array<int, \Symfony\UX\LiveComponent\LiveBrowserEvent>;

        /**
         * @return array<int, \Symfony\UX\LiveComponent\LiveEmitEvent>
         */
        // @overlay-against: function getEventsToEmit(): array
        public function getEventsToEmit(): array<int, \Symfony\UX\LiveComponent\LiveEmitEvent>;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `ValidatableComponentTrait`.
     */
    // @overlay-against: trait ValidatableComponentTrait
    partial trait ValidatableComponentTrait {
        /**
         * @var array<int, string>
         */
        // @overlay-against: array $validatedFields
        public array<int, string> $validatedFields ?? [];

        /**
         * @return array<int, \Symfony\Component\Validator\ConstraintViolation>
         */
        // @overlay-against: function getErrors(string $propertyPath): array
        public function getErrors(string $propertyPath): array<int, \Symfony\Component\Validator\ConstraintViolation>;
    }
}

namespace Symfony\UX\LiveComponent\Attribute {
    /**
     * Overlay: writable paths, serializer context, and `onUpdated` method names.
     */
    // @overlay-against: class LiveProp
    partial class LiveProp {
        /**
         * @param bool|array<int|string, string> $writable
         * @param array<string, mixed> $serializationContext
         * @param string|array<int|string, string>|null $onUpdated
         */
        // @overlay-against: function __construct(bool|array $writable, ?string $hydrateWith, ?string $dehydrateWith, bool $useSerializerForHydration, array $serializationContext, ?string $fieldName, ?string $format, bool $updateFromParent, string|array|null $onUpdated, bool|\Symfony\UX\LiveComponent\Metadata\UrlMapping $url, ?string $modifier): void
        public function __construct(bool|array<int|string, string> $writable = false, ?string $hydrateWith = null, ?string $dehydrateWith = null, bool $useSerializerForHydration = false, array<string, mixed> $serializationContext = [], ?string $fieldName = null, ?string $format = null, bool $updateFromParent = false, string|array<int|string, string>|null $onUpdated = null, bool|\Symfony\UX\LiveComponent\Metadata\UrlMapping $url = false, ?string $modifier = null): void;

        /**
         * @return string|array<int, string>|null
         */
        // @overlay-against: function onUpdated(): string|array|null
        public function onUpdated(): string|array<int, string>|null;

        /**
         * @param string|array<int|string, string>|null $onUpdated
         */
        // @overlay-against: function withOnUpdated(string|array|null $onUpdated): self
        public function withOnUpdated(string|array<int|string, string>|null $onUpdated): self;

        /**
         * @param array<string, mixed> $serializationContext
         */
        // @overlay-against: function withSerializationContext(array $serializationContext): self
        public function withSerializationContext(array<string, mixed> $serializationContext): self;

        /**
         * @param bool|array<int|string, string> $writable
         */
        // @overlay-against: function withWritable(bool|array $writable): self
        public function withWritable(bool|array<int|string, string> $writable): self;
    }
}

namespace Symfony\UX\LiveComponent\Command {
    /**
     * Extends unwrapped `\Symfony\Component\Console\Command\Command`.
     */
    // @overlay-against: class LiveComponentDebugCommand extends \Symfony\Component\Console\Command\Command
    omit class LiveComponentDebugCommand {
    }
}

namespace Symfony\UX\LiveComponent\Hydration {
    /**
     * Overlay: PHPDoc shapes harvest left loose on `HydrationExtensionInterface`.
     */
    // @overlay-against: interface HydrationExtensionInterface
    partial interface HydrationExtensionInterface {
        /**
         * @param __ClassName $className
         */
        // @overlay-against: function hydrate(mixed $value, string $className): ?object
        public function hydrate(mixed $value, __ClassName $className): ?object;

        /**
         * @param __ClassName $className
         */
        // @overlay-against: function supports(string $className): bool
        public function supports(__ClassName $className): bool;
    }
}

namespace Symfony\UX\LiveComponent\Component {
    /**
     * Overlay: PHPDoc shapes harvest left loose on `ComponentValidationErrors`.
     */
    // @overlay-against: class ComponentValidationErrors implements \Countable
    partial class ComponentValidationErrors {
        /**
         * @return array<string>
         */
        // @overlay-against: function getAll(string $propertyPath): array
        public function getAll(string $propertyPath): array<string>;

        /**
         * @return array<\Symfony\Component\Validator\ConstraintViolation>
         */
        // @overlay-against: function getViolations(string $propertyPath): array
        public function getViolations(string $propertyPath): array<int, \Symfony\Component\Validator\ConstraintViolation>;

        /**
         * @param array<int, \Symfony\Component\Validator\ConstraintViolation> $constraintViolations
         */
        // @overlay-against: function set(string $propertyName, array $constraintViolations): void
        public function set(string $propertyName, array<int, \Symfony\Component\Validator\ConstraintViolation> $constraintViolations): void;

        /**
         * @param array<string, array<int, \Symfony\Component\Validator\ConstraintViolation>> $errors
         */
        // @overlay-against: function setAll(array $errors): void
        public function setAll(array<string, array<int, \Symfony\Component\Validator\ConstraintViolation>> $errors): void;
    }
}
