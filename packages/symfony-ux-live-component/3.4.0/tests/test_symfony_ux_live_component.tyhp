<?tyhp

function test_as_live_component_name(): \Symfony\UX\LiveComponent\Attribute\AsLiveComponent
{
    return new \Symfony\UX\LiveComponent\Attribute\AsLiveComponent('Todo');
}

function test_live_prop(): \Symfony\UX\LiveComponent\Attribute\LiveProp
{
    return new \Symfony\UX\LiveComponent\Attribute\LiveProp();
}

function test_live_responder_emit(): void
{
    (new \Symfony\UX\LiveComponent\LiveResponder())->emit('itemUpdated');
}
