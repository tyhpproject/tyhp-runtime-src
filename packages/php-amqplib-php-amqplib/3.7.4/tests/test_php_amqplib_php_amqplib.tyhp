<?tyhp

function test_amqp_message_body(): string
{
    $message = new \PhpAmqpLib\Message\AMQPMessage('hello');
    return $message->getBody();
}

function test_amqp_message_properties(): \PhpAmqpLib\Message\AMQPMessage
{
    array<string, mixed> $properties = ['content_type' => 'text/plain'];
    return new \PhpAmqpLib\Message\AMQPMessage('hello', $properties);
}
