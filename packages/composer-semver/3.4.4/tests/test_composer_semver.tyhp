<?tyhp

function test_semver_satisfies(): bool
{
    return \Composer\Semver\Semver::satisfies('1.2.3', '^1.0');
}

function test_semver_satisfied_by(): array<int|string, string>
{
    return \Composer\Semver\Semver::satisfiedBy(['1.0.0', '2.0.0'], '^1.0');
}

function test_semver_parse_constraints(): \Composer\Semver\Constraint\ConstraintInterface
{
    $parser = new \Composer\Semver\VersionParser();
    return $parser->parseConstraints('^8.2');
}

function test_semver_compare(): bool
{
    return \Composer\Semver\Comparator::greaterThan('2.0.0', '1.0.0');
}
