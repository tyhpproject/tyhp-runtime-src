<?tyhp

function test_css_convert(): string
{
    $inliner = new \TijsVerkoyen\CssToInlineStyles\CssToInlineStyles();
    return $inliner->convert('<p class="x">hi</p>', 'p.x{color:red}');
}

function test_css_convert_html_only(): string
{
    $inliner = new \TijsVerkoyen\CssToInlineStyles\CssToInlineStyles();
    return $inliner->convert('<style>p{color:blue}</style><p>hi</p>');
}
