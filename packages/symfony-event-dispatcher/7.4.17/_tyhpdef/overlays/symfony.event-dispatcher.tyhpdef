namespace Symfony\Component\EventDispatcher\Debug {
    /**
     * Profiler row for one wrapped listener.
     */
    type WrappedListenerInfo = struct {
        string $event;
        ?int $priority;
        string $pretty;
        mixed $stub;
    };

    /**
     * Overlay: wrapped listener is a callback or a `[object|class, method]` pair.
     */
    // @overlay-against: class WrappedListener
    partial class WrappedListener {
        /**
         * @param (callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void)|array<int, object|string> $listener
         */
        // @overlay-against: function __construct(callable|array $listener, ?string $name, \Symfony\Component\Stopwatch\Stopwatch $stopwatch, ?\Symfony\Component\EventDispatcher\EventDispatcherInterface $dispatcher, ?int $priority): void
        public function __construct((callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void)|array<int, object|string> $listener, ?string $name, \Symfony\Component\Stopwatch\Stopwatch $stopwatch, ?\Symfony\Component\EventDispatcher\EventDispatcherInterface $dispatcher = null, ?int $priority = null): void;

        /**
         * @return \Symfony\Component\EventDispatcher\Debug\WrappedListenerInfo
         */
        // @overlay-against: function getInfo(string $eventName): array
        public function getInfo(string $eventName): \Symfony\Component\EventDispatcher\Debug\WrappedListenerInfo;

        /**
         * @return (callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void)|array<int, object|string>
         */
        // @overlay-against: function getWrappedListener(): callable|array
        public function getWrappedListener(): (callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void)|array<int, object|string>;
    }
}
