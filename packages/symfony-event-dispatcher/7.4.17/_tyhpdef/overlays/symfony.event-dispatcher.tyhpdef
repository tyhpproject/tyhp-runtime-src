     */
    // @overlay-against: interface EventDispatcherInterface
    partial interface EventDispatcherInterface {
        /**
         * @param callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void $listener
         */
        // @overlay-against: function addListener(string $eventName, callable $listener, int $priority): void
        public function addListener(string $eventName, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void $listener, int $priority = 0): void;

        /**
         * @return array<string, array<int, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void>>
         */
        // @overlay-against: function getListeners(?string $eventName): array
        public function getListeners(null $eventName = null): array<string, array<int, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void>>;

        /**
         * @return array<int, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void>
         */
        // @overlay-against: function getListeners(?string $eventName): array
        public function getListeners(string $eventName): array<int, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void>;

        /**
         * @param callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void $listener
         */
        // @overlay-against: function getListenerPriority(string $eventName, callable $listener): ?int
        public function getListenerPriority(string $eventName, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void $listener): ?int;

        /**
         * @param callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void $listener
         */
        // @overlay-against: function removeListener(string $eventName, callable $listener): void
        public function removeListener(string $eventName, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void $listener): void;
    }

    /**
     * Overlay: subscriber map from the interface PHPDoc. Harvest left bare `array` inside the value union.
     */
    // @overlay-against: interface EventSubscriberInterface
    partial interface EventSubscriberInterface {
        /**
         * @return array<string, string|array<int, string|int>|array<int, array<int, string|int>>>
         */
        // @overlay-against: function getSubscribedEvents(): array
        public static function getSubscribedEvents(): array<string, string|array<int, string|int>|array<int, array<int, string|int>>>;
