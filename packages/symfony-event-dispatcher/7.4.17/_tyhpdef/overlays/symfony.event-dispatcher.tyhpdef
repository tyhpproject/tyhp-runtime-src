namespace Symfony\Component\EventDispatcher {
    /**
     * Tyhp encoding of contracts PHPDoc `@param T $event` / `@return T` (L1 is `object`).
     */
    // @overlay-against: class EventDispatcher implements \Symfony\Component\EventDispatcher\EventDispatcherInterface
    partial class EventDispatcher {
        /**
         * @param T $event
         * @return T
         */
        // @overlay-against: function dispatch(object $event, ?string $eventName): object
        public function dispatch<T extends object>(T $event, ?string $eventName = null): T;

        /**
         * @param (callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void)|array<int, object|string> $listener
         */
        // @overlay-against: function addListener(string $eventName, callable|array $listener, int $priority): void
        public function addListener(string $eventName, (callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void)|array<int, object|string> $listener, int $priority = 0): void;

        /**
         * @param array<int, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void> $listeners
         */
        // @overlay-against: function callListeners(array $listeners, string $eventName, object $event): void
        protected function callListeners(array<int, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void> $listeners, string $eventName, object $event): void;

        /**
         * @return array<string, array<int, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void>>
         */
        // @overlay-against: function getListeners(?string $eventName): array
        public function getListeners(null $eventName = null): array<string, array<int, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void>>;

        /**
         * @return array<int, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void>
         */
        // @overlay-against: function getListeners(?string $eventName): array
        public function getListeners(string $eventName): array<int, callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void>;

        /**
         * @param (callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void)|array<int, object|string> $listener
         */
        // @overlay-against: function getListenerPriority(string $eventName, callable|array $listener): ?int
        public function getListenerPriority(string $eventName, (callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void)|array<int, object|string> $listener): ?int;

        /**
         * @param (callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void)|array<int, object|string> $listener
         */
        // @overlay-against: function removeListener(string $eventName, callable|array $listener): void
        public function removeListener(string $eventName, (callable(object, string, \Symfony\Component\EventDispatcher\EventDispatcherInterface): void)|array<int, object|string> $listener): void;
    }

    /**
     * Argument map is `array<string, mixed>`. Iteration matches `@implements`.
     */
    // @overlay-against: class GenericEvent extends \Symfony\Contracts\EventDispatcher\Event implements \ArrayAccess, \IteratorAggregate
    partial class GenericEvent implements \ArrayAccess<string, mixed>, \IteratorAggregate<string, mixed>;

    // @overlay-against: class GenericEvent extends \Symfony\Contracts\EventDispatcher\Event implements \ArrayAccess, \IteratorAggregate
    partial class GenericEvent {
        /**
         * @param array<string, mixed> $arguments
         */
        // @overlay-against: function __construct(mixed $subject, array $arguments): void
        public function __construct(mixed $subject = null, array<string, mixed> $arguments = []): void;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function getArguments(): array
        public function getArguments(): array<string, mixed>;

        /**
         * @return \ArrayIterator<string, mixed>
         */
        // @overlay-against: function getIterator(): \ArrayIterator
        public function getIterator(): \ArrayIterator<string, mixed>;

        /**
         * @param array<string, mixed> $args
         */
        // @overlay-against: function setArguments(array $args): static
        public function setArguments(array<string, mixed> $args = []): static;
    }
}

namespace Symfony\Component\EventDispatcher\Debug {
    /**
     * Harvest miss: class omitted from Layer 1 (HttpKernel's TraceableEventDispatcher extends it).
     * Stopwatch is an extern peer in this package. Trailing `$requestStack` / `$disabled` omitted
     * (unwrapped http-foundation peer); 2–3 arg arity matches typical construction.
     */
    class TraceableEventDispatcher implements \Symfony\Component\EventDispatcher\EventDispatcherInterface {
        public function __construct(
            \Symfony\Component\EventDispatcher\EventDispatcherInterface $dispatcher,
            \Symfony\Component\Stopwatch\Stopwatch $stopwatch,
            ?\Psr\Log\LoggerInterface $logger = null
        ): void;

        public function addListener(string $eventName, callable $listener, int $priority = 0): void;

        public function addSubscriber(\Symfony\Component\EventDispatcher\EventSubscriberInterface $subscriber): void;

        public function dispatch<T extends object>(T $event, ?string $eventName = null): T;

        public function getListenerPriority(string $eventName, callable $listener): ?int;

        public function getListeners(?string $eventName = null): array<array<int, callable>|callable>;

        public function hasListeners(?string $eventName = null): bool;

        public function removeListener(string $eventName, callable $listener): void;

        public function removeSubscriber(\Symfony\Component\EventDispatcher\EventSubscriberInterface $subscriber): void;
    }
}

