<?tyhp

function test_ai_ulid(): string
{
    return \Laravel\Ai\ulid();
}

function test_ai_tool_choice(): \Laravel\Ai\ToolChoice
{
    return \Laravel\Ai\ToolChoice::tool('search');
}

function test_ai_tool_choice_from_string(): \Laravel\Ai\ToolChoice
{
    return \Laravel\Ai\ToolChoice::from('auto');
}

function test_ai_user_message(): \Laravel\Ai\Messages\UserMessage
{
    return new \Laravel\Ai\Messages\UserMessage('hello');
}

function test_ai_exception(): \Laravel\Ai\Exceptions\AiException
{
    return new \Laravel\Ai\Exceptions\AiException('failed');
}
