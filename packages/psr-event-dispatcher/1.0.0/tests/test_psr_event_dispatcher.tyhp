<?tyhp

function test_psr_event_dispatcher_dispatch(\Psr\EventDispatcher\EventDispatcherInterface $dispatcher, \stdClass $event): \stdClass
{
    return $dispatcher->dispatch($event);
}

function test_psr_event_dispatcher_listeners(\Psr\EventDispatcher\ListenerProviderInterface $provider, \stdClass $event): iterable<\Psr\EventDispatcher\EventListener<\stdClass>>
{
    return $provider->getListenersForEvent($event);
}

function test_psr_event_dispatcher_stoppable(\Psr\EventDispatcher\StoppableEventInterface $event): bool
{
    return $event->isPropagationStopped();
}

function test_psr_event_dispatcher_invoke_listener(\Psr\EventDispatcher\EventListener<\stdClass> $listener, \stdClass $event): void
{
    $listener($event);
}
