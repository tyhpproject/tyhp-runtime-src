<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Passkeys, Google2FA, and App\Models\User are unwrapped — omit types that name them.
 */

namespace Laravel\Fortify {
    // @overlay-against: class Fortify
    partial class Fortify {
        /**
         * Overlay: a class or callback that creates users (`CreatesNewUsers`).
         */
        // @overlay-against: function createUsersUsing(callable|string $callback): void
        public static function createUsersUsing(callable|__CompatibleTypeName<\Laravel\Fortify\Contracts\CreatesNewUsers>|__InterfaceName<\Laravel\Fortify\Contracts\CreatesNewUsers> $callback): void;

        /**
         * Overlay: a class or callback that redirects for two-factor authentication.
         */
        // @overlay-against: function redirectUserForTwoFactorAuthenticationUsing(callable|string $callback): void
        public static function redirectUserForTwoFactorAuthenticationUsing(callable|__CompatibleTypeName<\Laravel\Fortify\Contracts\RedirectsIfTwoFactorAuthenticatable>|__InterfaceName<\Laravel\Fortify\Contracts\RedirectsIfTwoFactorAuthenticatable> $callback): void;

        /**
         * Overlay: a class or callback that resets user passwords.
         */
        // @overlay-against: function resetUserPasswordsUsing(callable|string $callback): void
        public static function resetUserPasswordsUsing(callable|__CompatibleTypeName<\Laravel\Fortify\Contracts\ResetsUserPasswords>|__InterfaceName<\Laravel\Fortify\Contracts\ResetsUserPasswords> $callback): void;

        /**
         * Overlay: a class or callback that updates user passwords.
         */
        // @overlay-against: function updateUserPasswordsUsing(callable|string $callback): void
        public static function updateUserPasswordsUsing(callable|__CompatibleTypeName<\Laravel\Fortify\Contracts\UpdatesUserPasswords>|__InterfaceName<\Laravel\Fortify\Contracts\UpdatesUserPasswords> $callback): void;

        /**
         * Overlay: a class or callback that updates user profile information.
         */
        // @overlay-against: function updateUserProfileInformationUsing(callable|string $callback): void
        public static function updateUserProfileInformationUsing(callable|__CompatibleTypeName<\Laravel\Fortify\Contracts\UpdatesUserProfileInformation>|__InterfaceName<\Laravel\Fortify\Contracts\UpdatesUserProfileInformation> $callback): void;
    }

    // @overlay-against: trait PasskeyAuthenticatable implements \Laravel\Passkeys\PasskeyAuthenticatable
    omit trait PasskeyAuthenticatable {
    }

    // @overlay-against: trait TwoFactorAuthenticatable
    partial trait TwoFactorAuthenticatable {
        /**
         * Overlay: recovery codes are strings (`RecoveryCode::generate()`, `string $code`).
         */
        // @overlay-against: function recoveryCodes(): array
        public function recoveryCodes(): array<int, string>;
    }

    // @overlay-against: class TwoFactorAuthenticationProvider implements \Laravel\Fortify\Contracts\TwoFactorAuthenticationProvider
    omit class TwoFactorAuthenticationProvider {
    }
}

