         */
        // @overlay-against: function handle(\Illuminate\Http\Request $request, callable $next): mixed
        public function handle(\Illuminate\Http\Request $request, callable(\Illuminate\Http\Request): mixed $next): mixed;
    }

    // @overlay-against: class RedirectIfTwoFactorAuthenticatable implements \Laravel\Fortify\Contracts\RedirectsIfTwoFactorAuthenticatable
    partial class RedirectIfTwoFactorAuthenticatable {
        /**
         * Overlay: `handle()` returns `$next($request)`.
         */
        // @overlay-against: function handle(\Illuminate\Http\Request $request, callable $next): mixed
        public function handle(\Illuminate\Http\Request $request, callable(\Illuminate\Http\Request): mixed $next): mixed;
    }
}

namespace Laravel\Fortify\Contracts {
    // @overlay-against: interface PasskeyUser
    omit interface PasskeyUser {
    }

    // @overlay-against: interface RedirectsIfTwoFactorAuthenticatable
    partial interface RedirectsIfTwoFactorAuthenticatable {
        /**
         * Overlay: `RedirectIfTwoFactorAuthenticatable::handle()` returns `$next($request)`.
         */
        // @overlay-against: function handle(\Illuminate\Http\Request $request, callable $next): mixed
        public function handle(\Illuminate\Http\Request $request, callable(\Illuminate\Http\Request): mixed $next): mixed;
