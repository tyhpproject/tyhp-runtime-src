<?tyhp

function test_fortify_username(): string
{
    return \Laravel\Fortify\Fortify::username();
}

function test_fortify_email(): string
{
    return \Laravel\Fortify\Fortify::email();
}

function test_fortify_create_users_using(): void
{
    \Laravel\Fortify\Fortify::createUsersUsing(\Laravel\Fortify\Contracts\CreatesNewUsers::class);
}

function test_fortify_ignore_routes(): \Laravel\Fortify\Fortify
{
    return \Laravel\Fortify\Fortify::ignoreRoutes();
}

function test_features_enabled(): bool
{
    return \Laravel\Fortify\Features::enabled(\Laravel\Fortify\Features::registration());
}

function test_features_has_profile(): bool
{
    return \Laravel\Fortify\Features::hasProfileFeatures();
}

function test_creates_new_users(\Laravel\Fortify\Contracts\CreatesNewUsers $creator, array $input): \Illuminate\Foundation\Auth\User
{
    return $creator->create($input);
}

function test_recovery_code(): string
{
    return \Laravel\Fortify\RecoveryCode::generate();
}

function test_route_path(): string
{
    return \Laravel\Fortify\RoutePath::for('login', '/login');
}
