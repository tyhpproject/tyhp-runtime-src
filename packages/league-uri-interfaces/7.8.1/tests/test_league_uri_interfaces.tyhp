<?tyhp

function test_league_uri_encoder_user(): ?string
{
    return \League\Uri\Encoder::encodeUser('alice');
}

function test_league_uri_to_string(\League\Uri\Contracts\UriInterface $uri): string
{
    return $uri->toString();
}

function test_league_uri_scheme(\League\Uri\Contracts\UriInterface $uri): ?string
{
    return $uri->getScheme();
}
