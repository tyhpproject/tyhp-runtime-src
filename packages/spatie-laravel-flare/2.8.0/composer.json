{
    "name": "tyhpdef/spatie-laravel-flare",
    "description": "Tyhp type definitions for the Composer package spatie/laravel-flare (2.8.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.8.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/spatie-flare-client-php": "@dev",
                "tyhpdef/illuminate-support": "@dev",
                "tyhpdef/spatie-error-solutions": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "spatie/laravel-flare": "2.8.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/spatie-flare-client-php": "@dev",
        "tyhpdef/illuminate-support": "@dev",
        "tyhpdef/spatie-error-solutions": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../spatie-flare-client-php/2.10.2"
        },
        {
            "type": "path",
            "url": "../../illuminate-support/13.33.0"
        },
        {
            "type": "path",
            "url": "../../spatie-error-solutions/2.0.5"
        }
    ]
}
