<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Class maps are FQCN → file path.
 */

namespace Composer\ClassMapGenerator {
    /**
     * Overlay: one PSR scan violation. `warning` is the message; `className` is the offending class.
     */
    type PsrViolation = struct {
        string $warning;
        string $className;
    };

    /**
     * Overlay: class name → file path. Ambiguous classes map a name to every path that defined it.
     */
    // @overlay-against: class ClassMap implements \Countable
    partial class ClassMap {
        // @overlay-against: array $map
        public array<string, string> $map ?? [];

        // @overlay-against: function getAmbiguousClasses(mixed $duplicatesFilter): array
        public function getAmbiguousClasses(string|false $duplicatesFilter = '{/(test|fixture|example|stub)s?/}i'): array<string, array<int, string>>;

        /**
         * @param string|false $duplicatesFilter Pattern that excludes dummy paths, or false to keep them.
         * @return array<int, array<int, string>> Sets of paths that differ only by casing.
         */
        public function getAmbiguousFolders(string|false $duplicatesFilter = '{/(test|fixture|example|stub)s?/}i'): array<int, array<int, string>>;

        /**
         * @return array<string, string>
         */
        // @overlay-against: function getMap(): array
        public function getMap(): array<string, string>;

        // @overlay-against: function getRawPsrViolations(): array
        public function getRawPsrViolations(): array<string, array<int, PsrViolation>>;
    }

    /**
     * Overlay: createMap() returns FQCN → path.
     */
    // @overlay-against: class ClassMapGenerator
    partial class ClassMapGenerator {
        /**
         * @return array<string, string>
         */
        // @overlay-against: function createMap(string|\Traversable|array $path): array
        public static function createMap(string|\Traversable<\SplFileInfo>|array<int, \SplFileInfo> $path): array<string, string>;
    }

    // @overlay-against: class FileList
    partial class FileList {
        // @overlay-against: array $files
        public array<string, true> $files ?? [];
    }
}
