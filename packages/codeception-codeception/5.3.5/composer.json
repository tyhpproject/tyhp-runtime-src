{
    "name": "tyhpdef/codeception-codeception",
    "description": "Tyhp type definitions for the Composer package codeception/codeception (5.3.5).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "5.3.5.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-console": "@dev",
                "tyhpdef/symfony-event-dispatcher": "@dev",
                "tyhpdef/phpunit-phpunit": "@dev",
                "tyhpdef/symfony-finder": "@dev",
                "tyhpdef/php-http-httplug": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "codeception/codeception": "5.3.5"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/symfony-event-dispatcher": "@dev",
        "tyhpdef/phpunit-phpunit": "@dev",
        "tyhpdef/symfony-finder": "@dev",
        "tyhpdef/php-http-httplug": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../phpunit-phpunit/12.5.35"
        },
        {
            "type": "path",
            "url": "../../php-http-httplug/2.4.1"
        },
        {
            "type": "path",
            "url": "../../php-http-promise/1.3.1"
        },
        {
            "type": "path",
            "url": "../../symfony-console/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-event-dispatcher/7.4.17"
        },
        {
            "type": "path",
            "url": "../../symfony-finder/7.4.19"
        }
    ]
}
