<?tyhp

function test_scenario_feature(\Codeception\Scenario $scenario): string
{
    $scenario->setFeature('login');
    return $scenario->getFeature();
}

function test_actor_want_to(\Codeception\Actor $actor): void
{
    $actor->wantTo('open the dashboard');
}

function test_module_name(\Codeception\Module $module): string
{
    return $module->_getName();
}
