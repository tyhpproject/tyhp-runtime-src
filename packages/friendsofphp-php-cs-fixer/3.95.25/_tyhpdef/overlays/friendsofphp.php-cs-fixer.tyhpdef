<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Tighter signatures for the harvested public fixer contracts.
 */

namespace PhpCsFixer\FixerDefinition {
    // @overlay-against: interface FixerDefinitionInterface
    interface FixerDefinitionInterface {
        // @overlay-against: function getSummary(): string
        public function getSummary(): string;

        // @overlay-against: function getDescription(): ?string
        public function getDescription(): ?string;

        // @overlay-against: function getRiskyDescription(): ?string
        public function getRiskyDescription(): ?string;

        /**
         * @return array<int, \PhpCsFixer\FixerDefinition\CodeSampleInterface>
         */
        // @overlay-against: function getCodeSamples(): array
        public function getCodeSamples(): array<int, \PhpCsFixer\FixerDefinition\CodeSampleInterface>;
    }

    interface CodeSampleInterface {
        public function getCode(): string;

        /**
         * @return array<string, mixed>|null
         */
        public function getConfiguration(): ?array;
    }
}

namespace PhpCsFixer\Fixer {
    // @overlay-against: interface FixerInterface
    interface FixerInterface {
        // @overlay-against: function isCandidate(\PhpCsFixer\Tokenizer\Tokens $tokens): bool
        public function isCandidate(\PhpCsFixer\Tokenizer\Tokens $tokens): bool;

        // @overlay-against: function isRisky(): bool
        public function isRisky(): bool;

        // @overlay-against: function fix(\SplFileInfo $file, \PhpCsFixer\Tokenizer\Tokens $tokens): void
        public function fix(\SplFileInfo $file, \PhpCsFixer\Tokenizer\Tokens $tokens): void;

        // @overlay-against: function getDefinition(): \PhpCsFixer\FixerDefinition\FixerDefinitionInterface
        public function getDefinition(): \PhpCsFixer\FixerDefinition\FixerDefinitionInterface;

        // @overlay-against: function getName(): string
        public function getName(): string;

        // @overlay-against: function getPriority(): int
        public function getPriority(): int;

        // @overlay-against: function supports(\SplFileInfo $file): bool
        public function supports(\SplFileInfo $file): bool;
    }
}

namespace PhpCsFixer\RuleSet {
    interface RuleSetInterface {
        /**
         * @param array<string, array<string, mixed>|bool> $set
         */
        public function __construct(array<string, array<string, mixed>|bool> $set = []);

        /**
         * @return array<string, mixed>|null
         */
        public function getRuleConfiguration(string $rule): ?array;

        /**
         * @return array<string, array<string, mixed>|true>
         */
        public function getRules(): array<string, array<string, mixed>|true>;

        public function hasRule(string $rule): bool;
    }
}

namespace PhpCsFixer\Tokenizer {
    /**
     * One brace/parenthesis/bracket edge from `Tokens::getBlockEdgeDefinitions()`.
     */
    type BlockEdge = struct {
        string|array<int, int|string> $start;
        string|array<int, int|string> $end;
    };

    /**
     * Array form of `Token::getPrototype()`: `[id, content]`.
     */
    type TokenPrototype = struct {
        int 0 as $id;
        string 1 as $content;
    };

    // @overlay-against: class Token
    partial class Token {
        // @overlay-against: function getCastTokenKinds(): array
        public static function getCastTokenKinds(): array<int, int>;

        // @overlay-against: function getClassyTokenKinds(): array
        public static function getClassyTokenKinds(): array<int, int>;

        // @overlay-against: function getKeywords(): array
        public static function getKeywords(): array<int, int>;

        // @overlay-against: function getMagicConstants(): array
        public static function getMagicConstants(): array<int, int>;

        // @overlay-against: function getObjectOperatorKinds(): array
        public static function getObjectOperatorKinds(): array<int, int>;

        // @overlay-against: function getPrototype(): array|string
        public function getPrototype(): string|TokenPrototype;
    }

    // @overlay-against: class Tokens extends \SplFixedArray
    partial class Tokens {
        // @overlay-against: function getBlockEdgeDefinitions(): array
        public static function getBlockEdgeDefinitions(): array<int, BlockEdge>;

        // @overlay-against: function findGivenKind(mixed $possibleKind, int $start, ?int $end): array
        public function findGivenKind(int|array<int, int> $possibleKind, int $start = 0, int|null $end = null): array<int, \PhpCsFixer\Tokenizer\Token>|array<int, array<int, \PhpCsFixer\Tokenizer\Token>>;
    }
}
