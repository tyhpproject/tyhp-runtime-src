<?tyhp

function test_token_from_string(): \PhpCsFixer\Tokenizer\Token
{
    return new \PhpCsFixer\Tokenizer\Token('<?php');
}

function test_token_content(\PhpCsFixer\Tokenizer\Token $token): string
{
    return $token->getContent();
}

function test_fixer_name(\PhpCsFixer\Fixer\FixerInterface $fixer): string
{
    return $fixer->getName();
}

function test_ruleset_has_rule(\PhpCsFixer\RuleSet\RuleSetInterface $rules): bool
{
    return $rules->hasRule('@PSR12');
}
