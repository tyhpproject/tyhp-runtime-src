<?tyhp

function test_cookie_jar(): \Illuminate\Cookie\CookieJar
{
    return new \Illuminate\Cookie\CookieJar();
}

function test_cookie_make(\Illuminate\Cookie\CookieJar $jar): \Symfony\Component\HttpFoundation\Cookie
{
    return $jar->make('name', 'value');
}

function test_cookie_value_prefix(): string
{
    return \Illuminate\Cookie\CookieValuePrefix::create('name', 'key');
}
