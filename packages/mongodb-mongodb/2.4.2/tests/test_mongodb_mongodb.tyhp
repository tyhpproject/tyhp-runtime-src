<?tyhp

function test_mongo_client(): \MongoDB\Client
{
    return new \MongoDB\Client('mongodb://127.0.0.1');
}

function test_mongo_default_uri(): string
{
    return \MongoDB\Client::DEFAULT_URI;
}

function test_mongo_manager(): \MongoDB\Driver\Manager
{
    return (new \MongoDB\Client('mongodb://127.0.0.1'))->getManager();
}

function test_mongo_gridfs_bucket(): \MongoDB\GridFS\Bucket
{
    return (new \MongoDB\Client('mongodb://127.0.0.1'))->getDatabase('test')->selectGridFSBucket();
}

function test_mongo_pipeline(): \MongoDB\Builder\Pipeline
{
    return new \MongoDB\Builder\Pipeline();
}

function test_mongo_encoder_can_encode(\MongoDB\Codec\Encoder $encoder): bool
{
    return $encoder->canEncode(1);
}

function test_mongo_find(\MongoDB\Collection $collection): \MongoDB\Driver\CursorInterface
{
    return $collection->find([]);
}
