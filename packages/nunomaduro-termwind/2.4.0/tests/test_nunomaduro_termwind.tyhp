<?tyhp

function test_termwind_parse(): string
{
    return \Termwind\parse('<div>hi</div>');
}

function test_termwind_div(): \Termwind\Components\Div
{
    return \Termwind\Termwind::div('hello', 'font-bold');
}

function test_termwind_render_using(?\Symfony\Component\Console\Output\OutputInterface $out): void
{
    \Termwind\renderUsing($out);
}

function test_termwind_element_to_string(\Termwind\Components\Div $div): string
{
    return $div->toString();
}
