<?tyhp

function test_in_rule(): \Illuminate\Validation\Rules\In
{
    return new \Illuminate\Validation\Rules\In('a');
}

function test_validator(): \Illuminate\Validation\Validator
{
    return new \Illuminate\Validation\Validator(new \Illuminate\Translation\Translator(new \Illuminate\Translation\ArrayLoader(), 'en'), ['n' => 'a'], ['n' => 'required']);
}

function test_unauthorized(): \Illuminate\Validation\UnauthorizedException
{
    return new \Illuminate\Validation\UnauthorizedException();
}
