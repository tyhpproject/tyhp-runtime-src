<?tyhp

function test_annotation_reader_new(): \Doctrine\Common\Annotations\AnnotationReader
{
    return new \Doctrine\Common\Annotations\AnnotationReader();
}

function test_annotation_class_list(\Doctrine\Common\Annotations\Reader $reader, \ReflectionClass $class): array<int|string, object>
{
    return $reader->getClassAnnotations($class);
}

function test_doc_lexer_new(): \Doctrine\Common\Annotations\DocLexer
{
    return new \Doctrine\Common\Annotations\DocLexer();
}

function test_doc_lexer_input(\Doctrine\Common\Annotations\DocLexer $lexer): void
{
    $lexer->setInput('@Foo');
}
