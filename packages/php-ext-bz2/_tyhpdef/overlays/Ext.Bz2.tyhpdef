<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `bzerror()` array shape. Encode/decode and bz handles are already typed in L1/L2.
 * Declaration order: TYHPDEF_ORDERING.md.
 */

/**
 * Overlay: `bzerror()` `{errno, errstr}` pair.
 */
type BzError = struct {
    int $errno;
    string $errstr;
};

#[\Tyhp\Optimize\Pure]
// @overlay-against: function bzcompress
partial function bzcompress;

#[\Tyhp\Optimize\Pure]
// @overlay-against: function bzdecompress
partial function bzdecompress;

// @overlay-against: function bzerror(mixed $bz): array
function bzerror(resource $bz): BzError;
