<?tyhp

namespace Tyhp\Exceptions;

/**
 * This process cannot run a parallel task.
 *
 * A CLI program hosts the pool itself and needs ext-pcntl and ext-posix.
 * Any other SAPI connects to a worker service named by TYHP_PARALLEL_SOCKET.
 */
final class ParallelUnavailableException extends ParallelException {
    public function __construct(string $message): parent($message) {}
}
