<?tyhp

namespace Tyhp;

/**
 * An exception thrown inside a worker process, copied back to the caller.
 *
 * `trace` is the worker's getTraceAsString(), cut to 32 KiB. `code` is the
 * exception code when it is an int, otherwise 0.
 */
type ParallelRemoteError = struct {
    string $class = '';
    string $message = '';
    int $code = 0;
    string $file = '';
    int $line = 0;
    string $trace = '';
};
