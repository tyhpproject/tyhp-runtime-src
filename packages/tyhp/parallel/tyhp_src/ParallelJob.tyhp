<?tyhp

namespace Tyhp;

/** A serialized task waiting for, or running on, a worker. */
internal final class ParallelJob {
    public function __construct(
        public readonly int $id,
        public readonly string $payload,
        public readonly \Closure<callable(string): void> $onSuccess,
        public readonly \Closure<callable(\Throwable): void> $onFailure,
    ) {}
}
