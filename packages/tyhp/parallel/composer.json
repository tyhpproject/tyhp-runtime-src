{
  "name": "tyhp/parallel",
  "description": "Tyhp runtime parallel — process pool for isolated CPU work (Task.Run, Parallel.For, ForEach, Invoke)",
  "type": "library",
  "bin": [
    "bin/tyhp-parallel"
  ],
  "license": "Apache-2.0",
  "version": "0.2",
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "require": {
        "tyhpdef/php": "@dev"
      },
      "package": {
        "include": [
          "./package.tyhpdef"
        ],
        "exclude": [],
        "overlay": [],
        "source": {
          "tagless": false
        }
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "tyhp/core": "@dev",
    "tyhp/async": "@dev"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/php-ext-pcntl": "@dev",
    "tyhpdef/php-ext-posix": "@dev",
    "tyhp/compiler": "@dev"
  },
  "autoload": {
    "psr-4": {
      "Tyhp\\": "src/Tyhp/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tyhp\\Tests\\Parallel\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../tyhpdef/php"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-pcntl"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-posix"
    },
    {
      "type": "path",
      "url": "../../dist/tyhp-core/802.latest"
    },
    {
      "type": "path",
      "url": "../../dist/tyhp-async/802.latest"
    },
    {
      "type": "path",
      "url": "../compiler"
    }
  ],
  "config": {
    "allow-plugins": {
      "tyhp/core": true
    }
  }
}
