<?tyhp

namespace Tyhp;

use Tyhp\Exceptions\OperationCancelledException;
use Tyhp\Exceptions\TimeoutException;

/**
 * Singleton event loop that drives all async operations.
 *
 * Provides cooperative Fiber scheduling, timer management, and real I/O
 * via stream_select(). Follows a tick-based model inspired by Node.js's
 * libuv and ReactPHP's event loop.
 *
 * Tick order:
 *  1. Process microtask queue (Fiber resumes, deferred callbacks)
 *  2. Process timer queue (expired delay/interval callbacks)
 *  3. Poll I/O via stream_select (non-blocking read/write on streams)
 *  4. Process I/O callbacks (handlers for ready streams)
 *  5. Check for completion (all queues empty + root settled?)
 */
final class EventLoop {
    private static ?EventLoop $instance = null;

    private \SplQueue<callable(): void> $microtaskQueue;
    private \SplPriorityQueue $timerQueue;

    private array<int, resource> $readStreams = [];
    private array<int, resource> $writeStreams = [];
    private array<int, callable(resource): void> $readCallbacks = [];
    private array<int, callable(resource): void> $writeCallbacks = [];

    private \SplQueue<EventLoopFiberItem> $fiberResumeQueue;

    private bool $running = false;
    private int $nextTimerId = 0;
    private array<string, bool> $activeTimers = [];

    private bool $streamsDirty = true;
    private array<int, resource> $cachedReadStreams = [];
    private array<int, resource> $cachedWriteStreams = [];

    /** Fibers this loop has started (weakly held). A cancelled run unwinds the suspended ones. */
    private \WeakMap $startedFibers;

    /** Fibers a cancelled run gave up on. The loop never starts or resumes them again. */
    private \WeakMap $abandonedFibers;

    private function __construct() {
        $this->microtaskQueue = new \SplQueue<callable(): void>();
        $this->fiberResumeQueue = new \SplQueue<EventLoopFiberItem>();
        $this->timerQueue = new \SplPriorityQueue();
        $this->timerQueue->setExtractFlags(\SplPriorityQueue::EXTR_DATA);
        $this->startedFibers = new \WeakMap();
        $this->abandonedFibers = new \WeakMap();
    }

    public static function getInstance(): EventLoop {
        return self::$instance ??= new EventLoop();
    }

    /**
     * Discards the shared loop so the next {@see getInstance()} starts a fresh one. Call it in a
     * forked child that must not inherit the parent's timers, fibers, or streams, and between tests.
     */
    public static function resetInstance(): void {
        self::$instance = null;
    }

    // ── Fiber Scheduling ─────────────────────────────────────────────

    /**
     * Schedules a Fiber to be started on the next microtask drain.
     */
    public function scheduleFiber(\Fiber<mixed, callable(): void> $fiber): void {
        $this->fiberResumeQueue->enqueue(new EventLoopFiberItem($fiber, 'start'));
    }

    /**
     * Schedules a suspended Fiber to be resumed with a value.
     */
    public function scheduleFiberResume(\Fiber<mixed, callable> $fiber, mixed $value = null): void {
        $this->fiberResumeQueue->enqueue(new EventLoopFiberItem($fiber, 'resume', value: $value));
    }

    /**
     * Schedules a suspended Fiber to be resumed with a thrown exception.
     */
    public function scheduleFiberThrow(\Fiber<mixed, callable> $fiber, \Throwable $error): void {
        $this->fiberResumeQueue->enqueue(new EventLoopFiberItem($fiber, 'throw', error: $error));
    }

    // ── Timers ───────────────────────────────────────────────────────

    /**
     * Schedules a one-shot callback to fire after the given delay.
     * Uses hrtime(true) (nanosecond monotonic clock) for timing precision.
     */
    public function delay(int $ms, callable(): void $callback): string {
        string $id = 'timer_' . $this->nextTimerId++;
        $this->activeTimers[$id] = true;

        int $fireAt = \hrtime(true) + ($ms * 1_000_000);

        $this->timerQueue->insert(
            new EventLoopTimerItem($id, $callback, 0, $fireAt),
            -$fireAt
        );

        return $id;
    }

    /**
     * Cancels a previously scheduled timer.
     * Cancelled timers are lazily removed from the priority queue on extraction.
     */
    public function cancelTimer(string $id): void {
        unset($this->activeTimers[$id]);
    }

    /**
     * Schedules a recurring callback to fire at the given interval.
     */
    public function interval(int $ms, callable(): void $callback): string {
        string $id = 'timer_' . $this->nextTimerId++;
        $this->activeTimers[$id] = true;

        int $fireAt = \hrtime(true) + ($ms * 1_000_000);

        $this->timerQueue->insert(
            new EventLoopTimerItem($id, $callback, $ms, $fireAt),
            -$fireAt
        );

        return $id;
    }

    // ── I/O Watchers ─────────────────────────────────────────────────

    public function addReadStream(mixed $stream, callable(resource): void $callback): void {
        if (!\is_resource($stream) || \get_resource_type($stream) !== 'stream') {
            throw new \InvalidArgumentException('Expected a valid stream resource');
        }
        int $id = (int) $stream;
        $this->readStreams[$id] = $stream;
        $this->readCallbacks[$id] = $callback;
        $this->streamsDirty = true;
    }

    public function addWriteStream(mixed $stream, callable(resource): void $callback): void {
        if (!\is_resource($stream) || \get_resource_type($stream) !== 'stream') {
            throw new \InvalidArgumentException('Expected a valid stream resource');
        }
        int $id = (int) $stream;
        $this->writeStreams[$id] = $stream;
        $this->writeCallbacks[$id] = $callback;
        $this->streamsDirty = true;
    }

    public function removeReadStream(mixed $stream): void {
        int $id = (int) $stream;
        unset($this->readStreams[$id], $this->readCallbacks[$id]);
        $this->streamsDirty = true;
    }

    public function removeWriteStream(mixed $stream): void {
        int $id = (int) $stream;
        unset($this->writeStreams[$id], $this->writeCallbacks[$id]);
        $this->streamsDirty = true;
    }

    // ── Deferred / Microtasks ────────────────────────────────────────

    /**
     * Alias of `queueMicrotask()`: queues the callback on the microtask queue.
     */
    public function defer(callable(): void $callback): void {
        $this->microtaskQueue->enqueue($callback);
    }

    /**
     * Queues a microtask to run before timers and I/O.
     * Microtasks are drained completely before moving to the next phase.
     */
    public function queueMicrotask(callable(): void $callback): void {
        $this->microtaskQueue->enqueue($callback);
    }

    // ── Lifecycle ────────────────────────────────────────────────────

    /**
     * Runs the event loop until the root Promise has settled and no work is immediately runnable.
     * Timers that are not yet due and stream watchers do not keep it running.
     * Blocks until the Promise resolves (returning the value) or rejects (throwing).
     *
     * When `$token` is given, cancellation is checked once per loop iteration, after the
     * microtask, timer, and I/O phases. If it has been requested while the root Promise is still
     * pending, the loop is shut down without waiting for I/O again and `run` throws
     * `OperationCancelledException`. If the root Promise settled in the same iteration, its own
     * result or error is returned or thrown instead and nothing is torn down.
     *
     * Shutting down stops all of the loop's work, not only the root's:
     *  - queued microtasks and queued fiber starts are dropped; the Promise of a fiber that never
     *    started is rejected with `OperationCancelledException`;
     *  - every timer and interval is cancelled and every stream watcher is removed (the streams
     *    themselves are not closed);
     *  - every fiber suspended on a pending Promise is unwound by throwing
     *    `OperationCancelledException` into it, so its `finally` blocks run (and unregister their
     *    cancellation callbacks), and its own Promise is rejected with that exception. A fiber that
     *    catches the exception and suspends again is rejected and abandoned instead. No fiber the loop
     *    gave up on is ever started or resumed again, even if the Promise it awaited settles later;
     *  - an error thrown by that cleanup code is attached as the `previous` exception of the one
     *    thrown from `run`.
     *
     * The loop is reusable afterwards. Cancellation is noticed at the next iteration, so a single
     * callback that never returns control to the loop is not interrupted. An already-cancelled
     * token is rejected by `Promise::run()` before the loop starts.
     */
    public function run<T extends __Awaited<void|mixed> = mixed>(Promise<T> $rootPromise, ?CancellationToken $token = null): T {
        if ($this->running) {
            throw new \LogicException('EventLoop::run() called re-entrantly — use await instead of run() inside an async context');
        }

        $this->running = true;

        try {
            while ($this->running) {
                $this->processMicrotasks();
                $this->processTimers();
                $this->pollIO();

                if ($token !== null && !$rootPromise->isCompleted() && $token->isCancellationRequested()) {
                    throw $this->shutDown($token);
                }

                if ($rootPromise->isCompleted() && $this->isEmpty()) {
                    break;
                }

                if (!$this->hasImmediateWork()) {
                    if ($rootPromise->isCompleted()) {
                        break;
                    }
                    $this->waitForIO();
                }
            }
        } finally {
            $this->running = false;
        }

        if ($rootPromise->isFaulted()) {
            throw $rootPromise->getError() ?? new \RuntimeException('Promise faulted without an error.');
        }

        return $rootPromise->getResult();
    }

    /**
     * Runs the event loop until the given Promise settles or timeout expires.
     * Used by Promise::wait() to block synchronous callers.
     */
    public function runUntilSettled(Promise $promise, int $timeoutMs = -1): mixed {
        if ($this->running) {
            throw new \LogicException('EventLoop::runUntilSettled() called re-entrantly — use await instead of run() inside an async context');
        }

        $this->running = true;
        int $deadline = $timeoutMs > 0
            ? \hrtime(true) + ($timeoutMs * 1_000_000)
            : -1;

        try {
            while ($this->running) {
                $this->processMicrotasks();
                $this->processTimers();
                $this->pollIO();

                if ($promise->isCompleted()) {
                    break;
                }

                if ($deadline > 0 && \hrtime(true) >= $deadline) {
                    throw new TimeoutException(
                        'Promise did not settle within ' . $timeoutMs . 'ms timeout',
                        $timeoutMs
                    );
                }

                if (!$this->hasImmediateWork()) {
                    $this->waitForIO($deadline);
                }
            }
        } finally {
            $this->running = false;
        }

        if ($promise->isFaulted()) {
            throw $promise->getError() ?? new \RuntimeException('Promise faulted without an error.');
        }

        return $promise->getResult();
    }

    /**
     * Performs a single tick of the event loop.
     * Returns true if there is still pending work to do.
     */
    public function tick(): bool {
        $this->processMicrotasks();
        $this->processTimers();
        $this->pollIO();

        return $this->hasPendingWork();
    }

    public function stop(): void {
        $this->running = false;
    }

    public function isRunning(): bool {
        return $this->running;
    }

    // ── Internal ─────────────────────────────────────────────────────

    /**
     * Drains the entire microtask queue, including any microtasks enqueued
     * during processing. Also drains the fiber resume queue between items.
     */
    private function processMicrotasks(): void {
        $this->drainFiberQueue();

        while (!$this->microtaskQueue->isEmpty()) {
            callable(): void $callback = $this->microtaskQueue->dequeue();
            $callback();
            $this->drainFiberQueue();
        }
    }

    /**
     * Processes queued Fiber start/resume/throw operations.
     * When a Fiber throws an unhandled exception, the associated Promise
     * is rejected via the Fiber-to-Promise WeakMap.
     */
    private function drainFiberQueue(): void {
        while (!$this->fiberResumeQueue->isEmpty()) {
            mixed $raw = $this->fiberResumeQueue->dequeue();
            if (!($raw instanceof EventLoopFiberItem)) {
                continue;
            }
            EventLoopFiberItem $item = $raw;

            if (isset($this->abandonedFibers[$item->fiber])) {
                continue;
            }

            try {
                if ($item->action === 'start') {
                    $this->startedFibers[$item->fiber] = true;
                    $item->fiber->start();
                } else if ($item->action === 'resume') {
                    $item->fiber->resume($item->value);
                } else if ($item->action === 'throw') {
                    if (!($item->error instanceof \Throwable)) {
                        throw new \InvalidArgumentException('Fiber throw scheduled without a Throwable');
                    }
                    $item->fiber->throw($item->error);
                }
            } catch (\Throwable $e) {
                \WeakMap $fiberMap = Promise::getFiberMap();
                if (isset($fiberMap[$item->fiber])) {
                    mixed $owner = $fiberMap[$item->fiber];
                    if ($owner instanceof Promise) {
                        $owner->doReject($e);
                    } else {
                        throw $e;
                    }
                } else {
                    throw $e;
                }
            }
        }
    }

    /**
     * Fires callbacks for all expired timers.
     * Uses hrtime(true) for nanosecond precision.
     * Cancelled timers are skipped on extraction.
     * Interval timers are re-inserted for their next fire time.
     */
    private function processTimers(): void {
        int $now = (int) \hrtime(true);

        while (!$this->timerQueue->isEmpty()) {
            mixed $raw = $this->timerQueue->top();
            if (!($raw instanceof EventLoopTimerItem)) {
                $this->timerQueue->extract();
                continue;
            }
            EventLoopTimerItem $timer = $raw;

            if ($timer->fireAt > $now) {
                break;
            }

            $this->timerQueue->extract();

            if (!isset($this->activeTimers[$timer->id])) {
                continue;
            }

            try {
                ($timer->callback)();
            } catch (\Throwable $e) {
                throw $e;
            }

            if ($timer->interval > 0 && isset($this->activeTimers[$timer->id])) {
                int $nextFireAt = \hrtime(true) + ($timer->interval * 1_000_000);
                $this->timerQueue->insert(
                    new EventLoopTimerItem($timer->id, $timer->callback, $timer->interval, $nextFireAt),
                    -$nextFireAt
                );
            } else {
                unset($this->activeTimers[$timer->id]);
            }
        }
    }

    /**
     * Non-blocking I/O poll via stream_select() with zero timeout.
     */
    private function pollIO(): void {
        if (empty($this->readStreams) && empty($this->writeStreams)) {
            return;
        }

        if ($this->streamsDirty) {
            $this->cachedReadStreams = \array_values($this->readStreams);
            $this->cachedWriteStreams = \array_values($this->writeStreams);
            $this->streamsDirty = false;
        }

        ?array<int|string, resource> $read = $this->cachedReadStreams;
        ?array<int|string, resource> $write = $this->cachedWriteStreams;
        ?array<int|string, resource> $except = null;

        mixed $changed = @\stream_select($read, $write, $except, 0, 0);

        if ($changed === false || $changed === 0) {
            return;
        }

        foreach ($read as $stream) {
            if (!\is_resource($stream)) {
                continue;
            }
            int $id = (int) $stream;
            if (isset($this->readCallbacks[$id])) {
                try {
                    ($this->readCallbacks[$id])($stream);
                } catch (\Throwable $e) {
                    $this->removeReadStream($stream);
                    throw $e;
                }
            }
        }

        foreach ($write as $stream) {
            if (!\is_resource($stream)) {
                continue;
            }
            int $id = (int) $stream;
            if (isset($this->writeCallbacks[$id])) {
                try {
                    ($this->writeCallbacks[$id])($stream);
                } catch (\Throwable $e) {
                    $this->removeWriteStream($stream);
                    throw $e;
                }
            }
        }
    }

    /**
     * Blocking wait when there is no immediate work.
     * Blocks on stream_select() or usleep() with a calculated timeout.
     */
    private function waitForIO(int $deadline = -1): void {
        int $timeoutUs = 1_000_000;

        if (!$this->timerQueue->isEmpty()) {
            mixed $rawNext = $this->timerQueue->top();
            if ($rawNext instanceof EventLoopTimerItem) {
                int $untilNs = $rawNext->fireAt - \hrtime(true);
                if ($untilNs <= 0) {
                    return;
                }
                $timeoutUs = \min($timeoutUs, \max(1, (int) ($untilNs / 1_000)));
            }
        }

        if ($deadline > 0) {
            int $untilDeadlineNs = $deadline - \hrtime(true);
            if ($untilDeadlineNs <= 0) {
                return;
            }
            $timeoutUs = \min($timeoutUs, \max(1, (int) ($untilDeadlineNs / 1_000)));
        }

        if (empty($this->readStreams) && empty($this->writeStreams)) {
            \usleep(\max(1, $timeoutUs));
            return;
        }

        if ($this->streamsDirty) {
            $this->cachedReadStreams = \array_values($this->readStreams);
            $this->cachedWriteStreams = \array_values($this->writeStreams);
            $this->streamsDirty = false;
        }

        ?array<int|string, resource> $read = $this->cachedReadStreams;
        ?array<int|string, resource> $write = $this->cachedWriteStreams;
        ?array<int|string, resource> $except = null;

        int $seconds = (int) \floor($timeoutUs / 1_000_000);
        int $microseconds = $timeoutUs % 1_000_000;

        mixed $changed = @\stream_select($read, $write, $except, $seconds, $microseconds);

        if ($changed === false || $changed === 0) {
            return;
        }

        foreach ($read as $stream) {
            if (!\is_resource($stream)) {
                continue;
            }
            int $id = (int) $stream;
            if (isset($this->readCallbacks[$id])) {
                try {
                    ($this->readCallbacks[$id])($stream);
                } catch (\Throwable $e) {
                    $this->removeReadStream($stream);
                    throw $e;
                }
            }
        }

        foreach ($write as $stream) {
            if (!\is_resource($stream)) {
                continue;
            }
            int $id = (int) $stream;
            if (isset($this->writeCallbacks[$id])) {
                try {
                    ($this->writeCallbacks[$id])($stream);
                } catch (\Throwable $e) {
                    $this->removeWriteStream($stream);
                    throw $e;
                }
            }
        }
    }

    /**
     * Stops all of the loop's work after the token of a run was cancelled and returns the exception
     * for `run()` to throw. See {@see run()} for the guarantees.
     */
    private function shutDown(CancellationToken $token): OperationCancelledException {
        OperationCancelledException $reason = new OperationCancelledException($token);
        ?\Throwable $cleanupError = null;
        \WeakMap $fiberMap = Promise::getFiberMap();

        // Fibers that can still run: everything suspended, plus whatever is queued.
        // Marking them abandoned first guarantees none of them is resumed from here on.
        array<\Fiber> $suspended = [];
        array<\Fiber> $neverStarted = [];
        foreach ($this->startedFibers as $fiber => $_) {
            if ($fiber instanceof \Fiber && !isset($this->abandonedFibers[$fiber])) {
                $this->abandonedFibers[$fiber] = true;
                if ($fiber->isSuspended()) {
                    $suspended[] = $fiber;
                }
            }
        }
        foreach ($this->fiberResumeQueue as $queued) {
            if (!($queued instanceof EventLoopFiberItem)) {
                continue;
            }
            mixed $queuedFiber = $queued->fiber;
            if (!($queuedFiber instanceof \Fiber) || isset($this->abandonedFibers[$queuedFiber])) {
                continue;
            }
            $this->abandonedFibers[$queuedFiber] = true;
            if ($queued->action === 'start') {
                $neverStarted[] = $queuedFiber;
            } else if ($queuedFiber->isSuspended()) {
                $suspended[] = $queuedFiber;
            }
        }

        $this->clearScheduledWork();

        try {
            foreach ($neverStarted as $fiber) {
                try {
                    $this->rejectOwner($fiberMap, $fiber, $reason);
                } catch (\Throwable $e) {
                    $cleanupError ??= $e;
                }
            }

            foreach ($suspended as $fiber) {
                if (!$fiber->isSuspended()) {
                    continue;
                }
                try {
                    $fiber->throw($reason);
                } catch (\Throwable $e) {
                    $cleanupError ??= $e;
                }
                if (!$fiber->isTerminated()) {
                    // It caught the exception and went back to sleep; it will not be resumed.
                    try {
                        $this->rejectOwner($fiberMap, $fiber, $reason);
                    } catch (\Throwable $e) {
                        $cleanupError ??= $e;
                    }
                }
            }
        } finally {
            // Cleanup code may have queued or registered new work.
            $this->clearScheduledWork();
        }

        return $cleanupError === null
            ? $reason
            : new OperationCancelledException($token, 'The operation was cancelled', $cleanupError);
    }

    private function rejectOwner(\WeakMap $fiberMap, \Fiber $fiber, \Throwable $reason): void {
        if (isset($fiberMap[$fiber])) {
            mixed $owner = $fiberMap[$fiber];
            if ($owner instanceof Promise) {
                $owner->doReject($reason);
            }
        }
    }

    /**
     * Drops queued microtasks and fiber starts/resumes, all timers and intervals, and all stream
     * watchers.
     */
    private function clearScheduledWork(): void {
        $this->fiberResumeQueue = new \SplQueue<EventLoopFiberItem>();
        $this->microtaskQueue = new \SplQueue<callable(): void>();
        $this->timerQueue = new \SplPriorityQueue();
        $this->timerQueue->setExtractFlags(\SplPriorityQueue::EXTR_DATA);
        $this->activeTimers = [];
        $this->readStreams = [];
        $this->writeStreams = [];
        $this->readCallbacks = [];
        $this->writeCallbacks = [];
        $this->cachedReadStreams = [];
        $this->cachedWriteStreams = [];
        $this->streamsDirty = true;
    }

    private function isEmpty(): bool {
        return $this->fiberResumeQueue->isEmpty()
            && $this->microtaskQueue->isEmpty()
            && empty($this->activeTimers)
            && empty($this->readStreams)
            && empty($this->writeStreams);
    }

    private function hasImmediateWork(): bool {
        if (!$this->fiberResumeQueue->isEmpty() || !$this->microtaskQueue->isEmpty()) {
            return true;
        }

        if (!$this->timerQueue->isEmpty()) {
            mixed $rawNext = $this->timerQueue->top();
            if ($rawNext instanceof EventLoopTimerItem
                && $rawNext->fireAt <= \hrtime(true)) {
                return true;
            }
        }

        return false;
    }

    private function hasPendingWork(): bool {
        return !$this->fiberResumeQueue->isEmpty()
            || !$this->microtaskQueue->isEmpty()
            || !empty($this->activeTimers)
            || !empty($this->readStreams)
            || !empty($this->writeStreams);
    }
}
