<?tyhp

namespace Tyhp;

use Tyhp\Contracts\AsyncIsDisposable;
use Tyhp\Contracts\IsDisposable;
use Tyhp\Exceptions\AggregateException;

final class DisposableHelper {
    private function __construct() {}

    /**
     * Disposes one or more disposable resources asynchronously.
     * Resources are disposed in reverse order (LIFO).
     * An uninitialized lazy object is skipped.
     */
    async public static function dispose(IsDisposable|AsyncIsDisposable ...$disposables): void {
        array<\Throwable> $errors = [];

        foreach (\array_reverse($disposables) as $disposable) {
            // Same skip as DisposableScope: an uninitialized lazy object is not disposed.
            if (self::isUninitializedLazyObject($disposable)) {
                continue;
            }
            try {
                if ($disposable instanceof AsyncIsDisposable) {
                    await $disposable->disposeAsync();
                } else if ($disposable instanceof IsDisposable) {
                    $disposable->dispose();
                }
            } catch (\Throwable $e) {
                $errors[] = $e;
            }
        }

        if (!empty($errors)) {
            foreach ($errors as $err) {
                \trigger_error(
                    \sprintf('DisposableHelper disposal error [%s]: %s', \get_class($err), $err->getMessage()),
                    E_USER_WARNING
                );
            }
            if (\count($errors) === 1) {
                throw $errors[0];
            }
            throw new AggregateException($errors, 'One or more errors during disposal');
        }
    }

    /**
     * True for a PHP 8.4+ lazy object that has not been initialized. Checking does
     * not initialize it. PHP before 8.4 has no lazy objects.
     *
     * Every build compiles against the PHP 8.2 reflection signatures, which omit
     * `isUninitializedLazyObject`, so the call goes through `call_user_func`. The
     * version test keeps older PHP from calling a method it does not have, and
     * lets a build for an older PHP still skip ghosts when it runs on 8.4 or newer.
     */
    private static function isUninitializedLazyObject(object $object): bool {
        if (\PHP_VERSION_ID < 80400) {
            return false;
        }

        return \call_user_func([new \ReflectionClass($object), 'isUninitializedLazyObject'], $object) === true;
    }
}
