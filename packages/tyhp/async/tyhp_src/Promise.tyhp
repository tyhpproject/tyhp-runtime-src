<?tyhp

namespace Tyhp;

use Tyhp\Exceptions\AggregateException;
use Tyhp\Exceptions\AsyncContextException;
use Tyhp\Exceptions\InvalidPromiseStateException;
use Tyhp\Exceptions\OperationCancelledException;
use Tyhp\Exceptions\TimeoutException;

/**
 * Core Promise implementation built on PHP Fibers.
 *
 * Combines JavaScript's then/catch/finally API with C#'s Task-style patterns.
 * Each Promise wraps a dedicated Fiber that executes an async operation.
 * The Fiber can be suspended via _await() and resumed when the awaited
 * Promise settles.
 *
 * The default TReturn must be `mixed` so PHP users that do not specify generics
 * will get it is `Promise<mixed>`
 */
final class Promise<TReturn extends __Awaited<void|mixed> = __Awaited<mixed>> {
    private PromiseState $state = PromiseState::Pending;
    private ?TReturn $value = null;
    private ?\Throwable $error = null;
    private ?\Fiber<mixed, callable(): void> $fiber = null;

    private array<callable(): void> $onSettled = [];

    /**
     * Maps Fibers to their owning Promise. WeakMap prevents memory leaks.
     * @internal Accessed by EventLoop.
     */
    private static ?\WeakMap $fiberToPromise = null;

    /**
     * Returns the Fiber-to-Promise mapping, initializing it on first access.
     * @internal Accessed by EventLoop.
     */
    public static function getFiberMap(): \WeakMap {
        return self::$fiberToPromise ??= new \WeakMap();
    }

    /**
     * Creates a new Promise that wraps the given executor in a Fiber.
     * The Fiber is scheduled with the event loop, not started immediately.
     */
    public function __construct(callable(): TReturn|Promise<TReturn> $executor, bool $immediateResolve = false) {
        if ($immediateResolve) {
            $this->doResolve($executor());
        } else {
            $this->initFiber($executor);
        }
    }

    private function initFiber(callable(): TReturn|Promise<TReturn> $executor): void {
        $this->fiber = new \Fiber<mixed, callable(): void>(function () use ($executor): void {
            try {
                TReturn|Promise<TReturn> $result = $executor();
                $this->doResolve($result);
            } catch (\Throwable $e) {
                if ($this->state !== PromiseState::Pending) {
                    throw $e;
                }
                $this->doReject($e);
            }
        });

        self::getFiberMap()[$this->fiber] = $this;
        EventLoop::getInstance()->scheduleFiber($this->fiber);
    }

    /**
     * Wraps a callable in a Promise.
     * The `async` keyword desugars to this internally.
     */
    public static function _async<T extends void|mixed>(callable(): T $fn): self<__Awaited<T>> {
        // DEV NOTE: Do not make this method itself `async` — that would wrap an extra
        // Promise layer. `return async { ... }` starts one Promise and is the intended form. This method would cause recursion.
        return new self<__Awaited<T>>($fn);
    }

    /**
     * Suspends the current Fiber until the given Promise settles.
     * The `await` keyword desugars to this internally.
     */
    public static function _await<T extends __Awaited<void|mixed>>(Promise<T> $promise): __Awaited<T> {
        if ($promise->state === PromiseState::Fulfilled) {
            return $promise->value ?? self::resolveMissingValue<T>('await resumed with no value for a non-nullable, non-void awaited type.');
        }
        if ($promise->state === PromiseState::Rejected) {
            throw $promise->error ?? new InvalidPromiseStateException('Promise was rejected without an error.');
        }

        ?\Fiber $currentFiber = \Fiber::getCurrent();
        if ($currentFiber === null) {
            throw new AsyncContextException('await can only be called from within an async context');
        }

        $promise->onSettled[] = static function () use ($currentFiber, $promise): void {
            if ($promise->state === PromiseState::Fulfilled) {
                EventLoop::getInstance()->scheduleFiberResume($currentFiber, $promise->value);
            } else {
                EventLoop::getInstance()->scheduleFiberThrow(
                    $currentFiber,
                    $promise->error ?? new InvalidPromiseStateException('Promise was rejected without an error.'));
            }
        };

        mixed $resumed = \Fiber::suspend(null);
        return ($resumed is T ? $resumed : null)
            ?? self::resolveMissingValue<T>('await resumed with no value for a non-nullable, non-void awaited type.');
    }

    /**
     * Cooperatively yields to other Promise Fibers already queued on the EventLoop.
     *
     * Returns an already-scheduled no-op Promise. Awaiting it suspends the current
     * Fiber so the loop can drain other pending Fiber starts/resumes before
     * continuing. Prefer this in tight async loops when you only need to share
     * the CPU with sibling tasks (similar to `await Promise.resolve()` in JS).
     *
     * Does not wait for timers or I/O — use yieldTick() or delay() for that.
     *
     * @example `await Promise::yield();`
     */
    public static function yield(): self<void>
    {
        // DEV NOTE: Do not make this method itself `async` — that would wrap an extra
        // Promise layer. `return async { ... }` starts one Promise and is the intended form.
        return async {};
    }

    /**
     * Cooperatively yields until after the EventLoop's timer phase.
     *
     * Equivalent to delay(0): schedules a 0ms timer and settles when it fires,
     * so awaiting this lets queued Fibers run and also advances past the current
     * microtask/Fiber drain into timer processing (a "macrotask" deferral).
     * Use when yield() is not enough — e.g. you need other delay()/timer work
     * to run before resuming, or you want a full loop turn of deferral.
     *
     * @example `await Promise::yieldTick();`
     */
    public static function yieldTick(): self<void>
    {
        // DEV NOTE: Do not make this method itself `async` — that would wrap an extra
        // Promise layer. `delay` is already async; returning it yields one Promise<void>.
        return Promise::delay(0);
    }

    /**
     * Registers fulfillment and/or rejection handlers, returning a new Promise.
     */
    async public function then(
        null $onFulfilled = null,
        null $onRejected = null
    ): TReturn;
    async public function then(
        null $onFulfilled,
        callable(\Throwable): TReturn $onRejected
    ): TReturn;
    async public function then<TThenReturn>(
        callable(TReturn): TThenReturn $onFulfilled,
        ?callable(\Throwable): TThenReturn $onRejected = null
    ): TThenReturn;
    async public function then<TThenReturn>(
        ?callable(TReturn): TThenReturn $onFulfilled = null,
        null|(callable(\Throwable): TThenReturn)|(callable(\Throwable): TReturn) $onRejected = null
    ): TThenReturn|TReturn {
        try {
            TReturn $value = await $this;
            return $onFulfilled !== null ? $onFulfilled($value) : $value;
        } catch (\Throwable $e) {
            if ($onRejected !== null) {
                return $onRejected($e);
            }
            throw $e;
        }
    }

    /**
     * Registers a rejection handler.
     */
    public function catch(callable(\Throwable): TReturn $onRejected): self<TReturn> {
        // DEV NOTE: Do not make this method itself `async` — that would wrap an extra
        // Promise layer.
        return $this->then(null, $onRejected);
    }

    /**
     * Registers a handler that runs when this Promise settles, regardless of outcome.
     * The original value or error propagates through unchanged.
     *
     * We do not use a `} finally {` block because we only execute the finally callback
     * when the promise settles (finishes or throws), and not under other conditions.
     */
    async public function finally(callable(): void|mixed $onFinally): TReturn {
        try {
            TReturn $value = await $this;
            $onFinally();
            return $value;
        } catch (\Throwable $e) {
            $onFinally();
            throw $e;
        }
    }

    /**
     * Registers a continuation that receives both the result and error (C# style).
     */
    async public function continueWith<TContinueReturn>(callable(?TReturn, ?\Throwable): TContinueReturn $continuation): TContinueReturn {
        try {
            mixed $value = await $this;
            return $continuation($value, null);
        } catch (\Throwable $e) {
            return $continuation(null, $e);
        }
    }

    /**
     * JS Promise.resolve: adopt an existing Promise, or return an already-fulfilled
     * Promise for a plain value (no Fiber).
     *
     * Passing a Promise returns that same instance — even if it is still pending. That is
     * flatten/adopt, not "force fulfilled". Use resolved() when you need a new
     * immediately-fulfilled Promise and do not want to unwrap.
     */
    public static function resolve<T extends __Awaited<void|mixed>>(null|T|Promise<T> $value = null): self<T> {
        if ($value === null) {
            $value = self::resolveMissingValue<T>('resolve called with no value for a non-nullable, non-void type.');
        }
        if ($value instanceof self<T>) {
            return $value;
        }

        return self::resolved<T>($value);
    }

    /**
     * JS Promise.reject: an already-rejected Promise (no Fiber).
     */
    public static function reject<T extends __Awaited<void|mixed> = void>(\Throwable $reason): self<T> {
        return self::rejected<T>($reason);
    }

    /**
     * Creates a new Promise fulfilled with the given value, without scheduling a Fiber.
     * When `$value` is omitted or null, uses `default(T)`.
     *
     * Always returns a new Promise; `resolve()` returns an existing Promise unchanged.
     * When `$value` is a Promise, the new Promise adopts it and settles when that Promise
     * settles, whatever `T` is. The result type is `Promise<__Awaited<T>>`, so
     * `resolved<Promise<int>>($p)` is a `Promise<int>`, never a promise of a promise.
     */
    public static function resolved<T extends void|mixed = void>(?T $value = null): self<__Awaited<T>> {
        return new self<__Awaited<T>>(fn(): T => $value ?? default(T), true);
    }

    /**
     * Creates an already-rejected Promise with the given error.
     * Rejects immediately without scheduling a Fiber. `reject()` is an alias.
     */
    public static function rejected<T extends void|mixed = void>(\Throwable $error): self<__Awaited<T>> {
        $promise = new self<__Awaited<T>>(fn(): T => default(T), true);
        $promise->state = PromiseState::Pending;
        $promise->doReject($error);
        return $promise;
    }

    /**
     * Creates a pending Promise that is settled from outside.
     * Returns a Deferred: call `getPromise()` for the Promise, then `resolve()` or `reject()`
     * to settle it. A Deferred settles only once; a second call throws.
     */
    public static function withResolvers<T extends void|mixed>(): \Tyhp\Deferred<__Awaited<T>> {
        return new \Tyhp\Deferred<__Awaited<T>>();
    }

    /**
     * Blocks the current thread until this Promise settles or the timeout expires.
     * Runs the event loop until settlement.
     */
    public function wait(int $timeoutMs = -1): mixed {
        return EventLoop::getInstance()->runUntilSettled($this, $timeoutMs);
    }

    /**
     * Gets the resolved value or throws the rejection reason.
     */
    public function getResult(): TReturn {
        if ($this->state === PromiseState::Pending) {
            throw new InvalidPromiseStateException('Cannot get result of a pending Promise');
        }
        if ($this->state === PromiseState::Rejected) {
            throw $this->error ?? new InvalidPromiseStateException('Promise was rejected without an error.');
        }
        return $this->value ?? self::resolveMissingValue<TReturn>('getResult called with no available value for a non-nullable, non-void type.');
    }

    public function getState(): PromiseState {
        return $this->state;
    }

    public function isCompleted(): bool {
        return $this->state !== PromiseState::Pending;
    }

    public function isFulfilled(): bool {
        return $this->state === PromiseState::Fulfilled;
    }

    public function isFaulted(): bool {
        return $this->state === PromiseState::Rejected;
    }

    public function getError(): ?\Throwable {
        return $this->error;
    }

    /**
     * Entry point for async code from synchronous PHP.
     *
     * Runs `$fn` in a new Fiber, drives the event loop until that work settles, and returns
     * the value. `$fn` may be a plain callable, an `async` closure or arrow function, or any
     * callable that returns a Promise; a returned Promise is awaited. If `$fn` throws, or the
     * Promise it returns rejects, the exception is rethrown here. Throws `\LogicException`
     * when the loop is already running.
     *
     * With a `$token`, an already-cancelled token throws `OperationCancelledException` before
     * `$fn` is called. Otherwise the event loop checks the token once per iteration, and if it is
     * cancelled while the work is still pending, the whole loop is shut down and `run` throws
     * `OperationCancelledException`; work that has settled by then keeps its own result or error.
     * Shutting down cancels every timer, interval, and stream watcher, drops queued work, and
     * unwinds every fiber suspended on a pending Promise (see `EventLoop::run()`).
     */
    public static function run<T extends void|mixed>(callable(): T $fn, ?CancellationToken $token = null): __Awaited<T> {
        $token?->throwIfCancellationRequested();
        return EventLoop::getInstance()->run(self::_async<T>($fn), $token);
    }

    /**
     * Creates a Promise that resolves after the specified delay.
     * Supports CancellationToken for cooperative cancellation.
     */
    async public static function delay(int $ms, ?CancellationToken $token = null): void {
        if ($ms < 0) {
            throw new \InvalidArgumentException('Delay milliseconds must be non-negative.');
        }

        $token?->throwIfCancellationRequested();

        Deferred<void> $deferred = new Deferred<void>();
        string $timerId = EventLoop::getInstance()->delay($ms, function () use ($deferred): void {
            $deferred->resolve();
        });

        ?\Closure $unregister = null;
        if ($token !== null) {
            CancellationToken $ct = $token;
            $unregister = $ct->register(function () use ($deferred, $timerId, $ct): void {
                if ($deferred->getPromise()->isCompleted()) {
                    return;
                }
                EventLoop::getInstance()->cancelTimer($timerId);
                $deferred->reject(new OperationCancelledException($ct));
            });
        }

        try {
            await $deferred->getPromise();
        } finally {
            if ($unregister !== null) {
                $unregister();
            }
        }
    }

    /**
     * Waits for all Promises to resolve and returns their results.
     */
    async public static function all<T extends __Awaited<void|mixed> = mixed>(array<Promise<T>> $promises, ?CancellationToken $token = null): array<T> {
        array<T> $results = [];
        foreach ($promises as $key => $promise) {
            $token?->throwIfCancellationRequested();
            $results[$key] = await $promise;
        }
        return $results;
    }

    /**
     * C# Task.WhenAll-style alias for all().
     */
    public static function whenAll<T extends __Awaited<void|mixed> = mixed>(Promise<T> ...$promises): self<array<int|string, T>> {
        // DEV NOTE: Do not make this method itself `async` — that would wrap an extra
        // Promise layer. `all` is already async; returning it yields one Promise.
        return self::all<T>($promises);
    }

    /**
     * Waits for all Promises to settle and returns a JS-style outcome object for each.
     * Never rejects itself. Input keys are preserved.
     *
     * Each outcome has `status` `'fulfilled'` or `'rejected'`. Fulfilled outcomes carry
     * `value`; rejected outcomes carry `reason` (a Throwable).
     */
    async public static function allSettled<
        T extends __Awaited<void|mixed> = mixed,
        TKey extends int|string = int|string
    >(array<TKey, Promise<T>> $promises): array<TKey, PromiseSettledResult<T>> {
        array<TKey, PromiseSettledResult<T>> $results = [];
        foreach ($promises as $key => $promise) {
            try {
                ?T $value = await $promise;
                $results[$key] = new PromiseSettledResult<T>(status: 'fulfilled', value: $value);
            } catch (\Throwable $e) {
                $results[$key] = new PromiseSettledResult<T>(status: 'rejected', reason: $e);
            }
        }
        return $results;
    }

    /**
     * Resolves or rejects with the first Promise to settle.
     */
    async public static function race<T extends __Awaited<void|mixed>>(array<Promise<T>> $promises, ?CancellationToken $token = null): __Awaited<T> {
        $token?->throwIfCancellationRequested();

        if (empty($promises)) {
            throw new \InvalidArgumentException('race() requires at least one Promise; an empty array would produce a Promise that never settles and leaks resources.');
        }

        Deferred<T> $deferred = new Deferred<T>();
        bool $settled = false;

        foreach ($promises as $promise) {
            $promise->then(
                function (?T $value) use ($deferred, &$settled): void {
                    if (!$settled) {
                        $settled = true;
                        $deferred->resolve($value);
                    }
                },
                function (\Throwable $error) use ($deferred, &$settled): void {
                    if (!$settled) {
                        $settled = true;
                        $deferred->reject($error);
                    }
                }
            );
        }

        ?\Closure $unregister = null;
        if ($token !== null) {
            CancellationToken $ct = $token;
            $unregister = $ct->register(function () use ($deferred, &$settled, $ct): void {
                if (!$settled) {
                    $settled = true;
                    $deferred->reject(new OperationCancelledException($ct));
                }
            });
        }

        try {
            return await $deferred->getPromise();
        } finally {
            if ($unregister !== null) {
                $unregister();
            }
        }
    }

    /**
     * C# Task.WhenAny-style alias for race().
     */
    public static function whenAny<T extends __Awaited<void|mixed>>(Promise<T> ...$promises): self<__Awaited<T>> {
        // DEV NOTE: Do not make this method itself `async` — that would wrap an extra
        // Promise layer. `race` is already async; returning it yields one Promise.
        return self::race<T>($promises);
    }

    /**
     * Resolves with the first fulfilled Promise; rejects if all reject.
     */
    async public static function any<T extends __Awaited<void|mixed>>(array<Promise<T>> $promises, ?CancellationToken $token = null): __Awaited<T> {
        $token?->throwIfCancellationRequested();

        if (empty($promises)) {
            throw new AggregateException([], 'All promises were rejected');
        }

        Deferred<T> $deferred = new Deferred<T>();
        array<\Throwable> $errors = [];
        int $remaining = \count($promises);
        bool $resolved = false;

        foreach ($promises as $key => $promise) {
            $promise->then(
                function (?T $value) use ($deferred, &$resolved): void {
                    if (!$resolved) {
                        $resolved = true;
                        $deferred->resolve($value);
                    }
                },
                function (\Throwable $error) use ($key, $deferred, &$errors, &$remaining, &$resolved): void {
                    if ($resolved) {
                        return;
                    }
                    $errors[$key] = $error;
                    $remaining--;
                    if ($remaining === 0) {
                        $deferred->reject(
                            new AggregateException($errors, 'All promises were rejected')
                        );
                    }
                }
            );
        }

        ?\Closure $unregister = null;
        if ($token !== null) {
            CancellationToken $ct = $token;
            $unregister = $ct->register(function () use ($deferred, &$resolved, $ct): void {
                if (!$resolved) {
                    $resolved = true;
                    $deferred->reject(new OperationCancelledException($ct));
                }
            });
        }

        try {
            return await $deferred->getPromise();
        } finally {
            if ($unregister !== null) {
                $unregister();
            }
        }
    }

    /**
     * Rejects with TimeoutException if the Promise does not settle within the deadline.
     * Implemented as a race between the original Promise and a delay.
     */
    public static function timeout<T extends __Awaited<void|mixed>>(Promise<T> $promise, int $ms, ?CancellationToken $token = null): self<__Awaited<T>> {
        // DEV NOTE: Do not make this method itself `async` — that would wrap an extra
        // Promise layer. `race` is already async; returning it yields one Promise.
        return self::race<T>([
            $promise,
            self::delay($ms, $token)->then(function () use ($ms): T {
                throw new TimeoutException('Operation timed out', $ms);
            }),
        ], $token);
    }

    /**
     * Processes items through a callable with bounded concurrency.
     * Results are returned in the original input order.
     */
    async public static function batch<TItem, TBatchReturn extends __Awaited<void|mixed>>(
        array<TItem> $items,
        callable(TItem): Promise<TBatchReturn> $processor,
        int $concurrency = 5,
        ?CancellationToken $token = null
    ): array<int, TBatchReturn> {
        array<int, TBatchReturn> $results = [];
        array<int, Promise<TBatchReturn>> $active = [];
        array<TItem> $itemQueue = \array_values($items);
        int $nextIndex = 0;

        while ($nextIndex < \count($itemQueue) || !empty($active)) {
            $token?->throwIfCancellationRequested();

            while (\count($active) < $concurrency && $nextIndex < \count($itemQueue)) {
                int $idx = $nextIndex++;
                Promise<TBatchReturn> $result = $processor($itemQueue[$idx]);
                if (!($result instanceof self)) {
                    throw new \InvalidArgumentException(
                        'batch() $processor must return a Promise, got ' . \get_debug_type($result) . ' for item at index ' . $idx
                    );
                }
                $active[$idx] = $result;
            }

            if (!empty($active)) {
                array<int, PromiseSettledResult<TBatchReturn>> $settledResult =
                    await self::allSettled<TBatchReturn, int>($active);
                foreach ($settledResult as $idx => $outcome) {
                    if ($outcome->status === 'fulfilled') {
                        ?TBatchReturn $fulfilledValue = $outcome->value;
                        if ($fulfilledValue is TBatchReturn) {
                            $results[$idx] = $fulfilledValue;
                        } else {
                            // Fulfilled void-like settlement stores null; accept as TBatchReturn only
                            // when the type argument admits it — otherwise surface a clear error.
                            throw new \InvalidArgumentException(
                                'batch() settled Promise had a null fulfilled value incompatible with ' . nameof(TBatchReturn));
                        }
                        unset($active[$idx]);
                    } else if ($outcome->reason instanceof \Throwable) {
                        throw $outcome->reason;
                    } else {
                        throw new \InvalidArgumentException(
                            'batch() settled Promise was rejected without a Throwable reason');
                    }
                }
            }
        }

        \ksort($results);
        return $results;
    }

    /**
     * Adapts a Generator (coroutine-style) into a Promise.
     * Each yield $promise suspends the generator and awaits the Promise.
     *
     * // TODO: need generics for generator to get return type, for now this is typed as mixed
     */
    async public static function fromGenerator(\Generator $generator): mixed {
        while ($generator->valid()) {
            mixed $yielded = $generator->current();
            if ($yielded instanceof self) {
                try {
                    $generator->send(await $yielded);
                } catch (\Throwable $e) {
                    $generator->throw($e);
                }
            } else {
                $generator->send($yielded);
            }
        }
        return $generator->getReturn();
    }

    /**
     * Transitions this Promise to the Fulfilled state.
     * If the value is itself a Promise, this Promise adopts its eventual state.
     *
     * @internal Used by the Fiber executor wrapper and EventLoop.
     */
    public function doResolve(TReturn|Promise<TReturn>|null $value): void {
        if ($this->state !== PromiseState::Pending) {
            return;
        }

        if ($value === $this) {
            $this->doReject(new \LogicException('A Promise cannot be resolved with itself'));
            return;
        }

        if ($value instanceof self<TReturn>) {
            if ($value->state === PromiseState::Fulfilled) {
                $this->doResolve($value->value);
            } else if ($value->state === PromiseState::Rejected) {
                $this->doReject($value->error ?? new InvalidPromiseStateException('Promise was rejected without an error.'));
            } else {
                // PromiseState::Pending
                $value->onSettled[] = function () use ($value): void {
                    if ($value->state === PromiseState::Fulfilled) {
                        $this->doResolve($value->value);
                    } else {
                        $this->doReject($value->error ?? new InvalidPromiseStateException('Promise was rejected without an error.'));
                    }
                };
            }
            return;
        } elseif ($value is TReturn) {
            // The `self` branch above has already handled (and returned for) the case
            // where `$value` is itself a Promise, so everything reaching here is unconditionally
            // `?TReturn`. (`$value instanceof TReturn` would now reify to `\Tyhp\Type::is` via
            // GenericObject, but an extra runtime check is unnecessary after the Promise branch.)
            $this->state = PromiseState::Fulfilled;
            $this->value = $value;
            $this->processCallbacks();
            return;
        }

        throw new \InvalidArgumentException("value incompatible with ${nameof(TReturn)} of Promise");
    }

    /**
     * Transitions this Promise to the Rejected state.
     *
     * @internal Used by the Fiber executor wrapper and EventLoop.
     */
    public function doReject(\Throwable $reason): void {
        if ($this->state !== PromiseState::Pending) {
            return;
        }

        $this->state = PromiseState::Rejected;
        $this->error = $reason;
        $this->processCallbacks();
    }

    private function processCallbacks(): void {
        array<callable(): void> $callbacks = $this->onSettled;
        $this->onSettled = [];
        array<\Throwable> $exceptions = [];
        foreach ($callbacks as $callback) {
            try {
                $callback();
            } catch (\Throwable $e) {
                $exceptions[] = $e;
            }
        }
        $this->fiber = null;
        if (\count($exceptions) === 1) {
            throw $exceptions[0];
        }
        if (\count($exceptions) > 1) {
            throw new \RuntimeException(
                'Multiple exceptions thrown during Promise settlement callbacks (' . \count($exceptions) . ' total)',
                0,
                $exceptions[0]
            );
        }
    }

    private static function resolveMissingValue<T>(string $invalidMessage): T {
        \Tyhp\Type $type = typeof(T);
        if (\Tyhp\Type::compatible($type, \Tyhp\Type::void()) || $type->isNullable()) {
            return default(T);
        }
        throw new InvalidPromiseStateException($invalidMessage);
    }
}
