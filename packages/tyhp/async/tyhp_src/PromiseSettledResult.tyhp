<?tyhp

namespace Tyhp;

/**
 * One settled outcome from {@see Promise::allSettled}, matching JavaScript's
 * `Promise.allSettled` result objects: `{status, value}` or `{status, reason}`.
 *
 * `status` is `'fulfilled'` or `'rejected'`. Fulfilled outcomes set `value`;
 * rejected outcomes set `reason`.
 */
final class PromiseSettledResult<T extends void|mixed = mixed>
{
    public function __construct(
        public string $status,
        public ?T $value = null,
        public ?\Throwable $reason = null,
    ): void {}
}
