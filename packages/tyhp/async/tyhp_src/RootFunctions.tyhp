<?tyhp

/**
 * Runs `$fn` on the event loop and returns its Promise.
 *
 * PHP spelling of {@see \Tyhp\Promise::_async()}. The callable's return type is the
 * settled type: `async(fn(): int => 1)` is `Promise<int>`.
 *
 * Skipped when a global `async` already exists.
 */
fallback function _async<T extends void|mixed>(callable(): T $fn): \Tyhp\Promise<__Awaited<T>>
{
    return \Tyhp\Promise::_async<T>($fn);
}

/**
 * Suspends the current fiber until `$promise` settles.
 *
 * PHP spelling of {@see \Tyhp\Promise::_await()}. Returns the fulfilled value, or
 * throws the rejection. Must run inside an async fiber.
 *
 * Skipped when a global `await` already exists.
 */
fallback function _await<T extends __Awaited<void|mixed>>(\Tyhp\Promise<T> $promise): __Awaited<T>
{
    return \Tyhp\Promise::_await<T>($promise);
}

/**
 * Enters async code from synchronous PHP and blocks until `$fn` settles.
 *
 * PHP spelling of {@see \Tyhp\Promise::run()}. Drives the event loop for this
 * call, then returns the settled value or throws the rejection. `await` runs
 * inside the fiber this starts.
 *
 * Skipped when a global `asyncMain` already exists.
 */
fallback function _asyncMain<T extends void|mixed>(
    callable(): T $fn,
    ?\Tyhp\CancellationToken $token = null,
): __Awaited<T> {
    return \Tyhp\Promise::run<T>($fn, $token);
}
