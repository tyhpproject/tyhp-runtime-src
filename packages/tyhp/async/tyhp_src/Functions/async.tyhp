<?tyhp

namespace Tyhp;

/**
 * Runs `$fn` on the event loop and returns its Promise.
 *
 * The callable's return type is the settled type: `async(fn (): int => 1)` is `Promise<int>`.
 */
#[\Tyhp\InferGeneric]
function async<T extends void|mixed>(callable(): T $fn): Promise<__Awaited<T>>
{
    return Promise::_async<T>($fn);
}
