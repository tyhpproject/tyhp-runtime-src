<?tyhp

namespace Tyhp\Rhetoric\Migrations;

/**
 * Renders a migration plan as one plain PHP anonymous migration class.
 */
final class LaravelMigrationWriter {
    public static function source(string $context, string $fromHash, string $toHash, MigrationPlan $plan, bool $defer = false, bool $independent = false): string {
        string $up = self::body($plan->operations, $plan->warnings);
        string $down = $plan->reversible()
            ? self::body(MapDiffer::invert($plan->operations), [])
            : "        throw new \\RuntimeException('This Rhetoric migration cannot be reversed.');";
        string $flags = '';
        if ($defer) {
            $flags = "    public bool \$deferred = true;\n    public bool \$independent = " . ($independent ? 'true' : 'false') . ";\n\n";
        }

        return "<?php\n\n"
            . "use Illuminate\\Database\\Migrations\\Migration;\n"
            . "use Illuminate\\Database\\Schema\\Blueprint;\n"
            . "use Illuminate\\Support\\Facades\\DB;\n"
            . "use Illuminate\\Support\\Facades\\Schema;\n\n"
            . "/**\n"
            . " * Generated by Rhetoric.\n"
            . " * Context: " . $context . "\n"
            . " * From: " . $fromHash . "\n"
            . " * Snapshot: " . $toHash . "\n"
            . " */\n"
            . "return new class extends Migration\n"
            . "{\n"
            . $flags
            . "    public function up(): void\n"
            . "    {\n"
            . $up . "\n"
            . "    }\n\n"
            . "    public function down(): void\n"
            . "    {\n"
            . $down . "\n"
            . "    }\n"
            . "};\n";
    }

    /**
     * @param array<int, Operation> $operations
     * @param array<int, string> $warnings
     */
    private static function body(array<int, Operation> $operations, array<int, string> $warnings): string {
        array<int, string> $lines = [];
        foreach ($warnings as $warning) {
            $lines[] = '        // ' . self::comment($warning);
        }
        if ($operations === []) {
            $lines[] = '        // No schema changes.';
        }
        foreach ($operations as $operation) {
            $lines[] = '        ' . self::statement($operation);
        }

        return \implode("\n", $lines);
    }

    private static function statement(Operation $operation): string {
        if ($operation->kind === OperationKind::CreateTable) {
            if ($operation->defined === null) {
                throw new \InvalidArgumentException('A create table operation needs a table definition.');
            }

            return self::schema('create', $operation->table, ColumnBlueprint::createLines($operation->defined));
        }
        if ($operation->kind === OperationKind::DropTable) {
            return 'Schema::dropIfExists(' . ColumnBlueprint::literal($operation->table) . ');';
        }
        if ($operation->kind === OperationKind::AddColumn) {
            return self::columnStatement($operation, false);
        }
        if ($operation->kind === OperationKind::AlterColumn) {
            return self::columnStatement($operation, true);
        }
        if ($operation->kind === OperationKind::DropColumn) {
            if ($operation->column === null) {
                throw new \InvalidArgumentException('A drop column operation needs a column.');
            }

            return self::schema('table', $operation->table, [
                '$table->dropColumn(' . ColumnBlueprint::literal($operation->column->name) . ');',
            ]);
        }
        if ($operation->kind === OperationKind::RenameColumn) {
            if ($operation->fromName === null || $operation->toName === null) {
                throw new \InvalidArgumentException('A rename operation needs both names.');
            }

            return self::schema('table', $operation->table, [
                '$table->renameColumn(' . ColumnBlueprint::literal($operation->fromName) . ', ' . ColumnBlueprint::literal($operation->toName) . ');',
            ]);
        }
        if ($operation->kind === OperationKind::AddIndex) {
            if ($operation->index === null) {
                throw new \InvalidArgumentException('An index operation needs an index.');
            }

            return self::schema('table', $operation->table, [ColumnBlueprint::index($operation->index) . ';']);
        }
        if ($operation->kind === OperationKind::DropIndex) {
            if ($operation->index === null) {
                throw new \InvalidArgumentException('An index operation needs an index.');
            }
            string $method = $operation->index->unique ? 'dropUnique' : 'dropIndex';

            return self::schema('table', $operation->table, [
                '$table->' . $method . '(' . ColumnBlueprint::literal($operation->index->name) . ');',
            ]);
        }
        if ($operation->kind === OperationKind::AddForeignKey) {
            if ($operation->foreignKey === null) {
                throw new \InvalidArgumentException('A foreign key operation needs a foreign key.');
            }

            return self::schema('table', $operation->table, [ColumnBlueprint::foreign($operation->table, $operation->foreignKey) . ';']);
        }
        if ($operation->kind === OperationKind::DropForeignKey) {
            if ($operation->foreignKey === null) {
                throw new \InvalidArgumentException('A foreign key operation needs a foreign key.');
            }

            return self::schema('table', $operation->table, [
                ColumnBlueprint::dropForeign($operation->table, $operation->foreignKey),
            ]);
        }
        if ($operation->kind === OperationKind::AddTimestamps) {
            return self::schema('table', $operation->table, ['$table->timestamps();']);
        }
        if ($operation->kind === OperationKind::DropTimestamps) {
            return self::schema('table', $operation->table, ['$table->dropTimestamps();']);
        }
        if ($operation->kind === OperationKind::SeedInsert || $operation->kind === OperationKind::SeedDelete) {
            return self::seed($operation);
        }

        throw new \InvalidArgumentException('Unknown migration operation.');
    }

    private static function columnStatement(Operation $operation, bool $change): string {
        if ($operation->column === null) {
            throw new \InvalidArgumentException('A column operation needs a column.');
        }

        return self::schema('table', $operation->table, [ColumnBlueprint::column($operation->column, $change) . ';']);
    }

    /**
     * @param array<int, string> $lines
     */
    private static function schema(string $method, string $table, array<int, string> $lines): string {
        string $body = '';
        foreach ($lines as $line) {
            $body .= "\n            " . $line;
        }

        return 'Schema::' . $method . '(' . ColumnBlueprint::literal($table) . ', function (Blueprint $table): void {'
            . $body . "\n        });";
    }

    private static function seed(Operation $operation): string {
        if ($operation->row === null) {
            throw new \InvalidArgumentException('A seed operation needs a row.');
        }
        string $table = ColumnBlueprint::literal($operation->table);
        if ($operation->kind === OperationKind::SeedInsert) {
            return 'DB::table(' . $table . ')->insert(' . ColumnBlueprint::literal($operation->row) . ');';
        }
        string $query = 'DB::table(' . $table . ')';
        foreach ($operation->row as $column => $value) {
            if ($value === null) {
                $query .= '->whereNull(' . ColumnBlueprint::literal($column) . ')';
            } else {
                $query .= '->where(' . ColumnBlueprint::literal($column) . ', ' . ColumnBlueprint::literal($value) . ')';
            }
        }

        return $query . '->delete();';
    }

    private static function comment(string $warning): string {
        string $text = \str_replace(["\r", "\n"], ' ', $warning);

        return \str_replace('*/', '* /', $text);
    }
}
