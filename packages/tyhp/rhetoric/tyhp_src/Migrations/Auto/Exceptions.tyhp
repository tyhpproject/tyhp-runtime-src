<?tyhp

namespace Tyhp\Rhetoric\Migrations\Auto;

class MigrationsInProgressException extends \Symfony\Component\HttpKernel\Exception\ServiceUnavailableHttpException {
    public function __construct(int $retryAfter, string $message = 'Migrations are in progress.', ?\Throwable $previous = null): parent($retryAfter, $message, $previous) {}
}

class MigrationFailedException extends \Symfony\Component\HttpKernel\Exception\ServiceUnavailableHttpException {
    public function __construct(int $retryAfter, string $message = 'A migration failed.', ?\Throwable $previous = null): parent($retryAfter, $message, $previous) {}
}

final class AutoMigrationFailed {
    public function __construct(
        public string $connection,
        public string $set,
        public string $error,
        public int $attempts,
    ) {}
}
