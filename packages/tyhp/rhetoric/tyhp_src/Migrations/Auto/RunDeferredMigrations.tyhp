<?tyhp

namespace Tyhp\Rhetoric\Migrations\Auto;

final class RunDeferredMigrations implements \Illuminate\Contracts\Queue\ShouldQueue {
    public ?string $queue;

    public function __construct(
        public string $connectionName,
        public ?string $migrationSet,
        ?string $queue,
    ) {
        $this->queue = $queue;
    }

    public function handle(): void {
        AutoMigrator::migrateDeferred($this->connectionName, $this->migrationSet, null, 'queue');
    }
}
