<?tyhp

namespace Tyhp\Rhetoric\Laravel\Commands;

class RemoveMigrationCommand extends \Illuminate\Console\Command {
    public function __construct() {
        parent::__construct();
        $this->setName('rhetoric:remove-migration');
        $this->setDescription('Delete the latest Rhetoric migration for a context and restore its snapshot.');
        $this->addOption('context', null, \Symfony\Component\Console\Input\InputOption::VALUE_REQUIRED, 'Context class');
        $this->addOption('path', null, \Symfony\Component\Console\Input\InputOption::VALUE_REQUIRED, 'Migrations directory');
        $this->addOption('snapshot', null, \Symfony\Component\Console\Input\InputOption::VALUE_REQUIRED, 'Snapshot directory');
    }

    public function handle(): int {
        try {
            string $path = CommandContext::workspace($this, $this->text('snapshot'), $this->text('path'))->remove(
                CommandContext::resolve($this, $this->text('context')),
                CommandContext::repository($this),
            );
            CommandContext::forgetManifest($this);
            $this->info($path);

            return 0;
        } catch (\Throwable $exception) {
            $this->error($exception->getMessage());

            return 1;
        }
    }

    private function text(string $option): ?string {
        mixed $value = $this->option($option);
        if (!\is_string($value) || $value === '') {
            return null;
        }

        return $value;
    }
}
