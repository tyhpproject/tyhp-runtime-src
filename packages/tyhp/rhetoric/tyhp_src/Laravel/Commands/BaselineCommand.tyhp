<?tyhp

namespace Tyhp\Rhetoric\Laravel\Commands;

use Tyhp\Rhetoric\Context;
use Tyhp\Rhetoric\Migrations\SchemaExtractor;

class BaselineCommand extends \Illuminate\Console\Command {
    public function __construct() {
        parent::__construct();
        $this->setName('rhetoric:baseline');
        $this->setDescription('Write a snapshot of a context without a migration.');
        $this->addOption('context', null, \Symfony\Component\Console\Input\InputOption::VALUE_REQUIRED, 'Context class');
        $this->addOption('snapshot', null, \Symfony\Component\Console\Input\InputOption::VALUE_REQUIRED, 'Snapshot directory');
    }

    public function handle(): int {
        try {
            Context $context = CommandContext::resolve($this, $this->text('context'));
            \Tyhp\Rhetoric\Migrations\SnapshotStore $store = CommandContext::workspace($this, $this->text('snapshot'), null)->snapshots();
            $store->save(SchemaExtractor::extract($context->mapping()));
            $this->info('Wrote ' . $store->path($context::class));

            return 0;
        } catch (\Throwable $exception) {
            $this->error($exception->getMessage());

            return 1;
        }
    }

    private function text(string $option): ?string {
        mixed $value = $this->option($option);
        if (!\is_string($value) || $value === '') {
            return null;
        }

        return $value;
    }
}
