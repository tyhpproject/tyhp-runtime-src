<?tyhp

namespace Tyhp\Rhetoric\Attributes;

use Tyhp\Rhetoric\OnDelete;

#[\Attribute(\Attribute::TARGET_PROPERTY)]
class ForeignKey {
    public function __construct(
        public __ClassName $target,
        public ?string $referencedColumn = null,
        public OnDelete $onDelete = OnDelete::Restrict,
    ) {}
}
