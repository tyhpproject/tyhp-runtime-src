<?tyhp

namespace Tyhp\Rhetoric\Casts;

final class BoolCast extends \Tyhp\Rhetoric\Casts\Cast<bool, int> {
    public function get(mixed $value): ?bool {
        if ($value === null) {
            return null;
        }

        return $value === true || $value === 1 || $value === '1';
    }

    public function set(mixed $value): ?int {
        if ($value === null) {
            return null;
        }

        // A stored 1 or '1' stays 1, so a value that already went through set() is not flipped.
        return $value === true || $value === 1 || $value === '1' ? 1 : 0;
    }
}
