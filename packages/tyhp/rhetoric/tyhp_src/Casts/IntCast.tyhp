<?tyhp

namespace Tyhp\Rhetoric\Casts;

final class IntCast extends \Tyhp\Rhetoric\Casts\Cast<int, int> {
    public function get(mixed $value): ?int {
        return $this->number($value);
    }

    public function set(mixed $value): ?int {
        return $this->number($value);
    }

    private function number(mixed $value): ?int {
        if ($value === null) {
            return null;
        }
        if (\is_int($value)) {
            return $value;
        }
        if ((\is_string($value) || \is_float($value)) && \is_numeric($value)) {
            return (int)$value;
        }

        throw new \InvalidArgumentException('An int column requires an int.');
    }
}
