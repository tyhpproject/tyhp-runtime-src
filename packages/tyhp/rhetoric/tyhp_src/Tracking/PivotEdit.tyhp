<?tyhp

namespace Tyhp\Rhetoric\Tracking;

/**
 * One pivot row to insert or delete because a belongsToMany collection changed.
 * Keys are read at save time, after generated keys exist.
 */
final class PivotEdit {
    public function __construct(
        public object $owner,
        public object $related,
        public string $table,
        public string $ownerColumn,
        public string $relatedColumn,
        public bool $insert,
    ) {}
}
