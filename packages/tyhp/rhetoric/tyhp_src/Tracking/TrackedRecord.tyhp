<?tyhp

namespace Tyhp\Rhetoric\Tracking;

use Tyhp\Rhetoric\Mapping\ModelMap;

final class TrackedRecord {
    /**
     * @param array<string, mixed> $original
     * @param array<string, bool> $dirty
     */
    public function __construct(
        public object $model,
        public ModelMap $map,
        public TrackingState $state,
        public array<string, mixed> $original,
        public bool $forceDirty,
        public array<string, bool> $dirty,
        /** @var array<string, array<int, object>> */
        public array<string, array<int, object>> $relationMembers = [],
        public bool $relationDirty = false,
    ) {}
}
