<?tyhp

namespace Tyhp\Rhetoric\Mapping;

final class ColumnMap {
    public function __construct(
        public readonly string $property,
        public readonly string $name,
        public readonly string $type,
        public readonly bool $nullable,
        public readonly ?int $maxLength,
        public readonly ?int $precision,
        public readonly ?int $scale,
        public readonly bool $generated,
        public readonly ?string $comment,
        public readonly ?CastSlot $cast = null,
        public readonly bool $hasDefault = false,
        public readonly mixed $default = null,
        public readonly bool $text = false,
        public readonly ?string $blueprintType = null,
        public readonly ?string $castClass = null,
        public readonly bool $json = false,
        public readonly bool $shadow = false,
        public readonly bool $concurrency = false,
        public readonly bool $rowVersion = false,
        public readonly bool $deferred = false,
    ) {}
}
