<?tyhp

namespace Tyhp\Rhetoric\Mapping;

use Tyhp\Rhetoric\OnDelete;

final class ForeignKeyMap {
    public function __construct(
        public readonly string $name,
        public readonly array<int, string> $properties,
        public readonly array<int, string> $columns,
        public readonly __ClassName $referencedClass,
        public readonly string $referencedTable,
        public readonly array<int, string> $referencedColumns,
        public readonly OnDelete $onDelete,
    ) {}
}
