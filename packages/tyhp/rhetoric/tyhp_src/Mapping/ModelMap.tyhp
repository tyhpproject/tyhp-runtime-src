<?tyhp

namespace Tyhp\Rhetoric\Mapping;

final class ModelMap {
    public function __construct(
        public readonly __ClassName $class,
        public readonly string $table,
        public readonly ?string $comment,
        public readonly array<string, ColumnMap> $columns,
        public readonly ?KeyMap $key,
        public readonly array<int, KeyMap> $alternateKeys,
        public readonly array<int, IndexMap> $indexes,
        public readonly array<int, ForeignKeyMap> $foreignKeys,
        public readonly array<string, RelationMap> $relations,
        public readonly bool $timestamps = false,
        public readonly array<int, array<string, mixed>> $seeds = [],
        public readonly array<int, \Tyhp\Expression> $globalScopes = [],
        public readonly bool $softDeletes = false,
        public readonly ?string $deletedAtProperty = null,
        public readonly ?string $deletedAtColumn = null,
        public readonly bool $readOnly = false,
        public readonly bool $view = false,
        public readonly ?string $discriminatorProperty = null,
        public readonly ?string $discriminatorColumn = null,
        public readonly ?string $discriminatorValue = null,
        public readonly ?__ClassName $rootClass = null,
        public readonly array<string, __ClassName> $discriminatorTypes = [],
        public readonly array<int, __ClassName> $observers = [],
    ) {}

    public function hasColumn(string $property): bool {
        return isset($this->columns[$property]);
    }

    public function column(string $property): ColumnMap {
        if (!isset($this->columns[$property])) {
            throw new \InvalidArgumentException($this->class . ' has no mapped column ' . $property . '.');
        }

        return $this->columns[$property];
    }

    public function hasRelation(string $property): bool {
        return isset($this->relations[$property]);
    }

    public function relation(string $property): RelationMap {
        if (!isset($this->relations[$property])) {
            throw new \InvalidArgumentException($this->class . ' has no relation ' . $property . '.');
        }

        return $this->relations[$property];
    }
}
