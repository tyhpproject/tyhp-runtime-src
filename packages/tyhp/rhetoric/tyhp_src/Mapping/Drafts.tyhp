<?tyhp

namespace Tyhp\Rhetoric\Mapping;

use Tyhp\Rhetoric\OnDelete;

final class ColumnDraft {
    public function __construct(
        public string $property,
        public string $name,
        public string $type,
        public bool $nullable,
        public ?int $maxLength = null,
        public ?int $precision = null,
        public ?int $scale = null,
        public bool $generated = false,
        public ?string $comment = null,
        public bool $generatedSet = false,
        public bool $hasDefault = false,
        public mixed $default = null,
        public bool $text = false,
        public ?string $columnType = null,
        public ?string $castClass = null,
    ) {}

    public bool $json = false;
    public bool $shadow = false;
    public bool $concurrency = false;
    public bool $rowVersion = false;
    public bool $deferred = false;
}

final class RelationDraft {
    public function __construct(
        public string $property,
        public RelationKind $kind,
        public __ClassName $relatedClass,
        public ?string $inverseProperty = null,
        public ?string $foreignKeyProperty = null,
        public ?OnDelete $onDelete = null,
        public ?string $referencedColumn = null,
        public ?string $pivotTable = null,
        public bool $onDeleteFluent = false,
        public ?__ClassName $pivotClass = null,
        public ?string $pivotForeignKey = null,
        public ?string $pivotRelatedKey = null,
    ) {}
}

final class ForeignKeyDraft {
    public function __construct(
        public string $property,
        public __ClassName $referencedClass,
        public ?string $referencedColumn,
        public OnDelete $onDelete,
    ) {}
}

final class ModelDraft {
    public function __construct(
        public __ClassName $class,
    ) {}

    public string $table = '';
    public ?string $comment = null;
    public array<string, PropertyFacts> $facts = [];
    public array<string, ColumnDraft> $columns = [];
    public array<string, RelationDraft> $relations = [];
    public ?array<int, string> $keyProperties = null;
    public array<int, array<int, string>> $alternateKeys = [];
    public array<int, IndexConfig> $indexes = [];
    public array<int, ForeignKeyDraft> $foreignKeys = [];
    public bool $timestamps = false;
    public array<int, array<string, mixed>> $seeds = [];
    public array<int, \Tyhp\Expression> $globalScopes = [];
    public bool $softDeletes = false;
    public ?string $deletedAtProperty = null;
    public ?string $deletedAtColumn = null;
    public bool $keyless = false;
    public bool $readOnly = false;
    public bool $view = false;
    public bool $tableExplicit = false;
    public ?string $discriminatorProperty = null;
    public ?string $discriminatorValue = null;
    public ?__ClassName $rootClass = null;
    /** @var array<string, __ClassName> */
    public array<string, __ClassName> $discriminatorTypes = [];
    public array<int, __ClassName> $observers = [];
    public array<string, bool> $embedded = [];
    public array<string, bool> $asJson = [];
}
