<?tyhp

namespace Tyhp\Rhetoric\Mapping;

use Tyhp\Rhetoric\OnDelete;

/**
 * A relation recorded on a model. Delete behavior is stored and not executed.
 *
 * For belongsTo, the foreign key property is on this model. For hasOne and hasMany
 * it is on the related model. belongsToMany names a pivot table and the two pivot
 * foreign-key columns instead.
 */
final class RelationMap {
    public function __construct(
        public readonly string $property,
        public readonly RelationKind $kind,
        public readonly __ClassName $relatedClass,
        public readonly ?string $inverseProperty,
        public readonly ?string $foreignKeyProperty,
        public readonly ?string $foreignKeyColumn,
        public readonly OnDelete $onDelete,
        public readonly ?string $pivotTable,
        public readonly ?string $pivotForeignKey,
        public readonly ?string $pivotRelatedKey,
        public readonly ?__ClassName $pivotClass = null,
    ) {}
}
