<?tyhp

namespace Tyhp\Rhetoric\Mapping;

final class ColumnConfig {
    public ?string $name = null;
    public ?int $maxLength = null;
    public ?int $precision = null;
    public ?int $scale = null;
    public ?bool $generated = null;
    public ?string $comment = null;
    public ?string $blueprintType = null;
    public ?bool $text = null;
    public ?bool $hasDefault = null;
    public mixed $default = null;
    public ?string $castClass = null;
    public bool $asJson = false;
    public bool $embedded = false;
    public bool $concurrency = false;
    public bool $rowVersion = false;
    public ?\Tyhp\Type $valueType = null;
}
