<?tyhp

namespace Tyhp\Rhetoric\Mapping;

use Tyhp\Rhetoric\Context;

/**
 * Stand-in for a context captured by a scope when that scope is read back from the mapping cache.
 * Query translation reads the context that is running the query.
 */
final class ArchivedContext extends Context {
    /**
     * @return array<string, mixed>
     */
    public function __serialize(): array<string, mixed> {
        return [];
    }

    /**
     * @param array<string, mixed> $data
     */
    public function __unserialize(array<string, mixed> $data): void {
        (void)$data;
    }
}
