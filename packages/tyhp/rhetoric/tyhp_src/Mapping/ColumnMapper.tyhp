<?tyhp

namespace Tyhp\Rhetoric\Mapping;

final class ColumnMapper {
    public function __construct(
        private ColumnConfig $column,
    ) {}

    public function name(string $name): self {
        $this->column->name = $name;

        return $this;
    }

    public function maxLength(int $length): self {
        $this->column->maxLength = $length;

        return $this;
    }

    public function precision(int $precision, int $scale = 0): self {
        $this->column->precision = $precision;
        $this->column->scale = $scale;

        return $this;
    }

    public function generated(bool $generated = true): self {
        $this->column->generated = $generated;

        return $this;
    }

    public function comment(string $comment): self {
        $this->column->comment = $comment;

        return $this;
    }

    public function type(string $type): self {
        $this->column->blueprintType = $type;

        return $this;
    }

    public function text(): self {
        $this->column->text = true;

        return $this;
    }

    public function default(mixed $value): self {
        $this->column->hasDefault = true;
        $this->column->default = $value;

        return $this;
    }

    public function cast(__ClassName $cast): self {
        $this->column->castClass = $cast;

        return $this;
    }

    public function asJson(): self {
        $this->column->asJson = true;

        return $this;
    }

    public function embedded(): self {
        $this->column->embedded = true;

        return $this;
    }
}
