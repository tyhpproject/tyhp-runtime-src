<?tyhp

namespace Tyhp\Rhetoric\Observers;

class Observer {
    public function creating(object $model): void {
        (void)$model;
    }

    public function created(object $model): void {
        (void)$model;
    }

    public function updating(object $model): void {
        (void)$model;
    }

    public function updated(object $model): void {
        (void)$model;
    }

    public function saving(object $model): void {
        (void)$model;
    }

    public function saved(object $model): void {
        (void)$model;
    }

    public function deleting(object $model): void {
        (void)$model;
    }

    public function deleted(object $model): void {
        (void)$model;
    }

    public function restoring(object $model): void {
        (void)$model;
    }

    public function restored(object $model): void {
        (void)$model;
    }
}
