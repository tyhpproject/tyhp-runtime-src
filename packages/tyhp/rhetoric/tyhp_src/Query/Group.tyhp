<?tyhp

namespace Tyhp\Rhetoric\Query;

/**
 * The row a grouped query projects. `key` is the grouped value. The aggregate
 * methods are translated; calling them in PHP returns an empty result.
 */
final class Group<T> {
    public mixed $key = null;

    public function count(): int {
        return 0;
    }

    public function sum(\Tyhp\Expression<callable(T): int|float> $selector): int|float {
        (void)$selector;

        return 0;
    }

    public function min(\Tyhp\Expression<callable(T): mixed> $selector): mixed {
        (void)$selector;

        return null;
    }

    public function max(\Tyhp\Expression<callable(T): mixed> $selector): mixed {
        (void)$selector;

        return null;
    }

    public function avg(\Tyhp\Expression<callable(T): int|float> $selector): ?float {
        (void)$selector;

        return null;
    }
}
