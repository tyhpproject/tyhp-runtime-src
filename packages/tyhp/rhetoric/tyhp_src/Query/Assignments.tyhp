<?tyhp

namespace Tyhp\Rhetoric\Query;

/**
 * Column assignments for a bulk update. The closure runs in PHP; each
 * argument of `assign` is an expression tree.
 */
final class Assignments<T> {
    /** @var array<int, Assignment> */
    public array<int, Assignment> $pairs = [];

    public function assign(
        \Tyhp\Expression<callable(T): mixed> $column,
        \Tyhp\Expression<callable(T): mixed> $value,
    ): void {
        $this->pairs[] = new Assignment($column, $value);
    }
}
