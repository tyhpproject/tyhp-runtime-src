<?tyhp

namespace Tyhp\Rhetoric\Query;

use Tyhp\Rhetoric\Mapping\RelationKind;

/**
 * Columns of one eager-loaded relation that share the query with its parent.
 */
final class EagerSpan {
    /**
     * @param array<int, string> $columns
     * @param array<int, string> $tail
     */
    public function __construct(
        public string $property,
        public __ClassName $relatedClass,
        public RelationKind $kind,
        public string $prefix,
        public string $keyColumn,
        public array<int, string> $columns,
        public array<int, string> $tail,
        public int $parent,
    ) {}
}
