<?tyhp

namespace Tyhp\Rhetoric\Query;

final class SqlPiece {
    /**
     * @param array<int, mixed> $bindings
     */
    public function __construct(
        public readonly string $sql,
        public readonly array<int, mixed> $bindings,
        public readonly string $valueType,
        public readonly bool $nullable,
        public readonly ?string $column,
        public readonly bool $isNull,
    ) {}

    /**
     * @param array<int, mixed> $extra
     * @return array<int, mixed>
     */
    public function withBindings(array<int, mixed> $extra): array<int, mixed> {
        array<int, mixed> $bindings = $this->bindings;
        foreach ($extra as $binding) {
            $bindings[] = $binding;
        }

        return $bindings;
    }
}
