<?tyhp

namespace Tyhp\Rhetoric\Fixtures;

use Tyhp\Rhetoric\Context;
use Tyhp\Rhetoric\Mapping\Mapper;
use Tyhp\Rhetoric\Table;

class LedgerContext extends Context {
    public Table<Ledger> $ledgers {
        get => $this->table<Ledger>();
    }

    public Table<Stamp> $stamps {
        get => $this->table<Stamp>();
    }

    protected function map(Mapper $map): void {
        $map->model<Ledger>()->key(fn (Ledger $ledger) => $ledger->code);
        $map->model<Stamp>()->column(fn (Stamp $stamp) => $stamp->id)->generated(false);
    }
}
