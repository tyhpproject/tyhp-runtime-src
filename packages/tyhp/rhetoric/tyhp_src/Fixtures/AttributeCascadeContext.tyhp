<?tyhp

namespace Tyhp\Rhetoric\Fixtures;

use Tyhp\Rhetoric\Context;
use Tyhp\Rhetoric\Mapping\Mapper;
use Tyhp\Rhetoric\OnDelete;
use Tyhp\Rhetoric\Table;

class AttributeCascadeContext extends Context {
    public Table<AttributeBlog> $blogs {
        get => $this->table<AttributeBlog>();
    }

    public Table<AttributePost> $posts {
        get => $this->table<AttributePost>();
    }

    protected function map(Mapper $map): void {
        $map->model<AttributeBlog>()
            ->hasMany(fn (AttributeBlog $blog) => $blog->entries)
            ->onDelete(OnDelete::Cascade);
    }
}
