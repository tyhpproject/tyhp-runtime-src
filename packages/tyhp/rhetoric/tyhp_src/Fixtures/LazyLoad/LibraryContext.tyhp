<?tyhp

namespace Tyhp\Rhetoric\Fixtures\LazyLoad;

use Tyhp\Rhetoric\Context;
use Tyhp\Rhetoric\Mapping\Mapper;
use Tyhp\Rhetoric\Table;

class LibraryContext extends Context {
    public function __construct(string $name) {
        $this->connection = $name;
    }

    public Table<\Tyhp\Rhetoric\Fixtures\LazyLoad\Author> $authors {
        get => $this->table<\Tyhp\Rhetoric\Fixtures\LazyLoad\Author>();
    }

    public Table<\Tyhp\Rhetoric\Fixtures\LazyLoad\Article> $articles {
        get => $this->table<\Tyhp\Rhetoric\Fixtures\LazyLoad\Article>();
    }

    public Table<\Tyhp\Rhetoric\Fixtures\LazyLoad\Label> $labels {
        get => $this->table<\Tyhp\Rhetoric\Fixtures\LazyLoad\Label>();
    }

    protected function map(Mapper $map): void {
        $map->model<\Tyhp\Rhetoric\Fixtures\LazyLoad\Author>();
        $map->model<\Tyhp\Rhetoric\Fixtures\LazyLoad\Article>();
        $map->model<\Tyhp\Rhetoric\Fixtures\LazyLoad\Label>();
        $map->model<\Tyhp\Rhetoric\Fixtures\LazyLoad\Profile>();
    }
}
