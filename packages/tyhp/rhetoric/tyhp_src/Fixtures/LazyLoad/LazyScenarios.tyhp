<?tyhp

namespace Tyhp\Rhetoric\Fixtures\LazyLoad;

class LazyScenarios {
    /**
     * @return array<int, Author>
     */
    public static function authorsWithArticles(LibraryContext $context): array<int, Author> {
        return $context->authors->with(fn (Author $author) => $author->articles)->all();
    }
}
