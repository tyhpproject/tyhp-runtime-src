<?tyhp

namespace Tyhp\Rhetoric\Fixtures;

use Tyhp\Rhetoric\Mapping\Conventions;

class PrefixConventions extends Conventions {
    public function tableName(__ClassName $modelClass): string {
        mixed $name = parent::tableName($modelClass);
        if (!\is_string($name)) {
            throw new \TypeError('A table name must be a string.');
        }

        return 'app_' . $name;
    }
}
