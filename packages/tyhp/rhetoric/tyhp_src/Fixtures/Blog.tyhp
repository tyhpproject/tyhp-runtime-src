<?tyhp

namespace Tyhp\Rhetoric\Fixtures;

class Blog {
    public int $id = 0;

    public string $name = '';

    public ?string $url = null;

    public array<Post> $posts = [];

    public string $backed = 'init' {
        get => $this->backed;
        set(string $value) {
            $this->backed = $value;
        }
    }

    public string $virtual {
        get => 'virtual-value';
    }
}
