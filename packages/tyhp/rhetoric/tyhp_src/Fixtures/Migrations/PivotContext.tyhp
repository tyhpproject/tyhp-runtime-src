<?tyhp

namespace Tyhp\Rhetoric\Fixtures\Migrations;

use Tyhp\Rhetoric\Context;
use Tyhp\Rhetoric\Mapping\Mapper;

class PivotContext extends Context {
    public static string $shape = 'plain';

    protected function map(Mapper $map): void {
        if (self::$shape === 'plain') {
            $map->model<\Tyhp\Rhetoric\Fixtures\Migrations\Plain\Post>();
            $map->model<\Tyhp\Rhetoric\Fixtures\Migrations\Plain\Tag>();
        } elseif (self::$shape === 'linked') {
            $map->model<\Tyhp\Rhetoric\Fixtures\Migrations\Linked\Post>();
            $map->model<\Tyhp\Rhetoric\Fixtures\Migrations\Linked\Tag>();
        }
    }
}
