<?tyhp

namespace Tyhp\Rhetoric\Fixtures\Discovered;

use Tyhp\Rhetoric\Fixtures\FluentPost;
use Tyhp\Rhetoric\Mapping\ModelMapper;
use Tyhp\Rhetoric\Mapping\ModelMapping;

class PostMapping extends ModelMapping<FluentPost> {
    protected function configure(ModelMapper<FluentPost> $model): void {
        $model->hasIndex(fn (FluentPost $post) => $post->rating);
    }
}
