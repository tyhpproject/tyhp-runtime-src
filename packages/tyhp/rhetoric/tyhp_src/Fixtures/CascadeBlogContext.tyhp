<?tyhp

namespace Tyhp\Rhetoric\Fixtures;

use Tyhp\Rhetoric\Context;
use Tyhp\Rhetoric\Mapping\Mapper;
use Tyhp\Rhetoric\OnDelete;
use Tyhp\Rhetoric\Table;

class CascadeBlogContext extends Context {
    public Table<Blog> $blogs {
        get => $this->table<Blog>();
    }

    public Table<Post> $posts {
        get => $this->table<Post>();
    }

    protected function map(Mapper $map): void {
        $map->model<Blog>()
            ->hasMany(fn (Blog $blog) => $blog->posts)
            ->onDelete(OnDelete::Cascade);
    }
}
