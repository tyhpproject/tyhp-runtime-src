<?tyhp

namespace Tyhp\Rhetoric\Fixtures;

use Tyhp\Rhetoric\Context;
use Tyhp\Rhetoric\Mapping\Mapper;
use Tyhp\Rhetoric\Table;

/**
 * Maps `Blog` to a different table than `QueryContext` does, on the same connection.
 */
class QueryPrefixedContext extends Context {
    public function __construct(string $name) {
        $this->connection = $name;
    }

    public Table<Blog> $blogs {
        get => $this->table<Blog>();
    }

    protected function map(Mapper $map): void {
        $map->conventions(new PrefixConventions());
    }
}
