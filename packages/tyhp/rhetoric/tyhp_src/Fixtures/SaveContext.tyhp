<?tyhp

namespace Tyhp\Rhetoric\Fixtures;

use Tyhp\Rhetoric\Context;
use Tyhp\Rhetoric\Table;

class SaveContext extends Context {
    public function __construct(string $name) {
        $this->connection = $name;
    }

    public Table<SaveBlog> $blogs {
        get => $this->table<SaveBlog>();
    }

    public Table<SavePost> $posts {
        get => $this->table<SavePost>();
    }

    public Table<Employee> $employees {
        get => $this->table<Employee>();
    }

    public Table<KeyedNote> $notes {
        get => $this->table<KeyedNote>();
    }

    public Table<StampNote> $stampNotes {
        get => $this->table<StampNote>();
    }

    public Table<Folder> $folders {
        get => $this->table<Folder>();
    }

    public Table<Ring> $rings {
        get => $this->table<Ring>();
    }
}
