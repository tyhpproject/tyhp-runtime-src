        readonly public string $property;
        readonly public \Tyhp\Rhetoric\Mapping\RelationKind $kind;
        readonly public __ClassName $relatedClass;
        readonly public ?string $inverseProperty;
        readonly public ?string $foreignKeyProperty;
        readonly public ?string $foreignKeyColumn;
        readonly public \Tyhp\Rhetoric\OnDelete $onDelete;
        readonly public ?string $pivotTable;
        readonly public ?string $pivotForeignKey;
