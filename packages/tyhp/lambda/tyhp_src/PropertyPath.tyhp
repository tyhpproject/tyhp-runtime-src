<?tyhp

namespace Tyhp;

/**
 * A property-access chain extracted from a lambda or built via {@see PropertyPathBuilder}.
 *
 * @template TCallableShape of callable
 * @extends Expression<TCallableShape>
 */
class PropertyPath<TCallableShape extends callable> extends Expression<TCallableShape> {
    public readonly array<string> $path;

    /** @var array<bool> */
    private array<bool> $nullSafeFlags;

    /**
     * @param array<string> $path Property names in access order.
     * @param bool $allowEmpty When true, an empty path is allowed (identity / builder root).
     * @param array<bool> $nullSafeFlags Per-segment `?->` flags aligned with $path; missing entries are false.
     */
    public function __construct(
        string $sourceType,
        string $resultType,
        array<string> $path,
        ?\Closure<TCallableShape> $callable = null,
        bool $allowEmpty = false,
        array<bool> $nullSafeFlags = [],
    ) {
        $this->nullSafeFlags = $nullSafeFlags;
        if ($path === [] && !$allowEmpty) {
            throw new \InvalidArgumentException(nameof(PropertyPath) . ' requires at least one path segment.');
        }

        $this->path = $path;

        \Tyhp\Expression\Structs\PathNode $pathNodes = Expression\FluentSupport::buildPathNodes(
            $sourceType,
            $path,
            $nullSafeFlags,
        );

        parent::__construct(
            $pathNodes->body,
            [$pathNodes->parameterExpression],
            $callable,
            $resultType,
        );
    }

    /**
     * Build a property path from the source class, the property names, and the closure that reads them.
     *
     * The callable shape is taken from `$callable`. When that closure declares a return type,
     * it is used. Otherwise the type is read from the properties named in `$path` on
     * `$sourceType`, including `?` when a segment is null-safe or the property allows null.
     * Callers do not pass a type string or a generic argument.
     *
     * @template TCallable of callable
     * @param class-string|string $sourceType Source object class (for example `User::class`).
     * @param array<string> $path Property names in access order.
     * @param array<bool> $nullSafeFlags Per-segment `?->` flags aligned with `$path`. Missing entries are false.
     *
     * @phpstan-template TCallable of callable
     * @phpstan-param class-string|string $sourceType
     * @phpstan-param array<string> $path
     * @phpstan-param array<bool> $nullSafeFlags
     * @phpstan-return PropertyPath<TCallable>
     *
     * @psalm-template TCallable of callable
     * @psalm-param class-string|string $sourceType
     * @psalm-param list<string> $path
     * @psalm-param list<bool> $nullSafeFlags
     * @psalm-return PropertyPath<TCallable>
     */
    public static function from<TCallable extends callable>(
        string $sourceType,
        array<string> $path,
        \Closure<TCallable> $callable,
        array<bool> $nullSafeFlags = [],
    ): PropertyPath<TCallable> {
        return new PropertyPath<TCallable>(
            $sourceType,
            self::inferResultType($callable, $sourceType, $path, $nullSafeFlags),
            $path,
            $callable,
            false,
            $nullSafeFlags,
        );
    }

    /**
     * Result type for {@see PropertyPath::from()}: the closure's return type, then the
     * declared type of the last property in `$path`.
     *
     * @param array<string> $path
     * @param array<bool> $nullSafeFlags
     */
    private static function inferResultType(
        \Closure $callable,
        string $sourceType,
        array<string> $path,
        array<bool> $nullSafeFlags,
    ): string {
        ?string $fromCallable = self::callableReturnTypeName($callable);
        if ($fromCallable !== null) {
            return $fromCallable;
        }

        ?string $fromPath = self::reflectPathType($sourceType, $path, $nullSafeFlags);
        if ($fromPath !== null) {
            return $fromPath;
        }

        return 'mixed';
    }

    /**
     * PHP return type of `$callable`, or null when it is absent or `mixed`.
     */
    protected static function callableReturnTypeName(\Closure $callable): ?string {
        ?Type $type = Type::fromCallableReturn($callable);
        if ($type === null) {
            return null;
        }

        string $name = (string)$type;
        if ($name === '' || $name === 'mixed') {
            return null;
        }

        return $name;
    }

    /**
     * Walk `$path` on `$sourceType` and spell the last property's PHP type.
     * A null-safe segment or a nullable property makes the result nullable.
     *
     * @param array<string> $path
     * @param array<bool> $nullSafeFlags
     */
    private static function reflectPathType(
        string $sourceType,
        array<string> $path,
        array<bool> $nullSafeFlags,
    ): ?string {
        if ($path === [] || !\class_exists($sourceType)) {
            return null;
        }

        string $class = $sourceType;
        bool $nullable = false;
        int $count = \count($path);
        for (int $i = 0; $i < $count; $i++) {
            if (!\class_exists($class)) {
                return null;
            }

            \ReflectionProperty $property;
            try {
                $property = new \ReflectionProperty($class, $path[$i]);
            } catch (\Throwable $e) {
                (void)$e;
                return null;
            }

            ?\ReflectionType $reflected = $property->getType();
            if ($reflected === null) {
                return null;
            }

            if (($nullSafeFlags[$i] ?? false) || $reflected->allowsNull()) {
                $nullable = true;
            }

            if ($i < $count - 1) {
                ?string $next = self::nextPathClass($reflected, $class);
                if ($next === null) {
                    return null;
                }
                $class = $next;
                continue;
            }

            string $text = (string)Type::fromReflectionType($reflected, $class);
            if ($text === '' || $text === 'mixed') {
                return null;
            }

            if ($nullable && !self::spellingIsNullable($text)) {
                return '?' . $text;
            }

            return $text;
        }

        return null;
    }

    /**
     * Class to continue a property walk through, when this segment's type names one class.
     */
    private static function nextPathClass(\ReflectionType $type, string $declaringClass): ?string {
        if (!($type instanceof \ReflectionNamedType) || $type->isBuiltin()) {
            return null;
        }

        string $name = $type->getName();
        if ($name === 'self' || $name === 'static') {
            return $declaringClass;
        }

        if ($name === 'parent') {
            string|false $parent = \get_parent_class($declaringClass);
            if (!\is_string($parent)) {
                return null;
            }
            return $parent;
        }

        return $name;
    }

    private static function spellingIsNullable(string $type): bool {
        return \str_starts_with($type, '?') || \str_contains($type, '|null') || \str_contains($type, 'null|');
    }

    public function getPropertyName(): string {
        $key = \array_key_last($this->path);
        if ($key === null) {
            // path is empty
            return '';
        }
        return $this->path[$key] ?? '';
    }

    public function getPath(): string {
        return \implode('.', $this->path);
    }

    public function getSegments(): array<string> {
        return $this->path;
    }

    /**
     * Start a fluent property path. `__get` records each segment.
     * `nullSafe()` marks only the next segment. `backedBy()` stores the closure
     * whose return type is the path result.
     *
     * @template T of object
     * @param class-string<T> $sourceType
     * @return PropertyPathBuilder<T>
     */
    public static function on<T extends object>(__ClassName<T> $sourceType): PropertyPathBuilder<T> {
        return new PropertyPathBuilder<T>($sourceType);
    }

    public function getValue(mixed $source): __CallableReturnType<TCallableShape> {
        ?\Closure $native = $this->nativeClosure();
        mixed $result = $native !== null
            ? $native($source)
            : $this->walkPublic($source);
        // Always stash first so callers who catch can inspect the mismatched value.
        $this->lastResult = $result;
        if ($result is __CallableReturnType<TCallableShape>) {
            return $result;
        }

        throw new Exceptions\IncompatibleTypeException(
            typeof(__CallableReturnType<TCallableShape>),
            Type::of($result),
            nameof($this->lastResult),
        );
    }

    /**
     * Public `->` / `?->` only. A null receiver on a null-safe segment returns null
     * and does not read the rest of the path.
     */
    private function walkPublic(mixed $source): mixed {
        mixed $value = $source;
        int $count = \count($this->path);
        for (int $i = 0; $i < $count; $i++) {
            bool $nullSafe = $this->nullSafeFlags[$i] ?? false;
            if ($nullSafe && $value === null) {
                return null;
            }
            if (!\is_object($value)) {
                throw new \TypeError(
                    'Cannot read property "' . $this->path[$i] . '" on ' . \get_debug_type($value) . '.',
                );
            }
            string $segment = $this->path[$i];
            $value = $value->{$segment};
        }
        return $value;
    }
}
