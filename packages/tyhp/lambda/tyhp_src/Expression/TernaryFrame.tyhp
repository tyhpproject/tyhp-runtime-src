<?tyhp

namespace Tyhp\Expression;

/**
 * One open `then` / `else` while a fluent chain is still being built.
 */
final class TernaryFrame {
    /**
     * @param 'true'|'false' $phase
     */
    public function __construct(
        public readonly ExpressionNode $condition,
        public readonly ?ExpressionNode $ifTrue,
        public readonly string $phase,
    ) {}
}
