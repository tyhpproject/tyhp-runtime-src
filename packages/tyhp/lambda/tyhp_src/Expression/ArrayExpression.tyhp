<?tyhp

namespace Tyhp\Expression;

/**
 * An array literal such as `[1, 2, 3]` or `['id' => $u->id, 'name' => $u->name]`.
 * Items keep their source order.
 */
final class ArrayExpression extends ExpressionNode {
    public readonly array<ArrayItem> $items;

    /**
     * @param array<ArrayItem> $items
     */
    public function __construct(
        array<ArrayItem> $items,
        string $type = 'array',
    ) {
        $this->items = $items;
        parent::__construct($type, 'array');
    }

    public function accept(ExpressionVisitor $visitor): mixed {
        return $visitor->visitArray($this);
    }
}
