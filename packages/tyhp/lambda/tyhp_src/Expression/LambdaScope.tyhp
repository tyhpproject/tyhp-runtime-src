<?tyhp

namespace Tyhp\Expression;

/**
 * Arguments of one {@see LambdaExpression} call while {@see ExpressionInterpreter} walks its
 * body. `$parent` is the enclosing lambda's scope, or null at the top level.
 *
 * @internal
 */
final class LambdaScope {
    /**
     * @param array<ParameterExpression> $parameters
     * @param array<int|string, mixed> $args
     */
    public function __construct(
        public readonly array<ParameterExpression> $parameters,
        public readonly array<int|string, mixed> $args,
        public readonly ?LambdaScope $parent,
    ) {}
}
