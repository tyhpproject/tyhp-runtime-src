<?tyhp

namespace Tyhp\Expression;

/**
 * A value resolved while building a fluent chain, plus the parameters it introduced.
 *
 * @internal
 */
final class ResolvedOperand {
    /**
     * @param array<ParameterExpression> $parameters
     * @param array<ParameterExpression> $roots
     */
    public function __construct(
        public readonly ExpressionNode $node,
        public readonly array<ParameterExpression> $parameters,
        public readonly array<ParameterExpression> $roots,
    ) {}
}
