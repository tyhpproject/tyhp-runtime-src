<?tyhp

namespace Tyhp\Expression;

/**
 * One element of an {@see ArrayExpression}. `$key` is null for an element without an explicit
 * key (`[$a, $b]`), so it takes the next integer key.
 */
final class ArrayItem {
    public function __construct(
        public readonly ExpressionNode $value,
        public readonly ?ExpressionNode $key = null,
    ) {}
}
