<?tyhp

/**
 * Starts a fluent property-path / expression builder for `$sourceType`.
 *
 * PHP spelling of {@see \Tyhp\Expression::of()}. `_expr(User::class)->age->gte(18)`
 * and `_expr(User::class, 'address', 'city')` are that call.
 *
 * Skipped when a global `_expr` already exists.
 *
 * @template T of object
 * @param class-string<T> $sourceType Source object class (e.g. `User::class`).
 * @param string|array<string> ...$segments Optional path segments (`'a', 'b'` or `['a', 'b']`).
 * @return \Tyhp\PropertyPathBuilder<T>&T
 *
 * @phpstan-template T of object
 * @phpstan-param class-string<T> $sourceType
 * @phpstan-param string|array<string> ...$segments
 * @phpstan-return \Tyhp\PropertyPathBuilder<T>&T
 *
 * @psalm-template T of object
 * @psalm-param class-string<T> $sourceType
 * @psalm-param string|list<string> ...$segments
 * @psalm-return \Tyhp\PropertyPathBuilder<T>&T
 */
#[\Tyhp\InferGeneric]
fallback function _expr<T extends object>(\__ClassName<T> $sourceType, string|array ...$segments): \Tyhp\PropertyPathBuilder<T>
{
    return \Tyhp\Expression::of<T>($sourceType, ...$segments);
}

/**
 * Starts a fluent property path for `$sourceType`.
 *
 * PHP spelling of {@see \Tyhp\PropertyPath::on()}. `_path(User::class)->name` is that call.
 *
 * Skipped when a global `_path` already exists.
 *
 * @template T of object
 * @param class-string<T> $sourceType
 * @return \Tyhp\PropertyPathBuilder<T>&T
 *
 * @phpstan-template T of object
 * @phpstan-param class-string<T> $sourceType
 * @phpstan-return \Tyhp\PropertyPathBuilder<T>&T
 *
 * @psalm-template T of object
 * @psalm-param class-string<T> $sourceType
 * @psalm-return \Tyhp\PropertyPathBuilder<T>&T
 */
#[\Tyhp\InferGeneric]
fallback function _path<T extends object>(\__ClassName<T> $sourceType): \Tyhp\PropertyPathBuilder<T>
{
    return \Tyhp\PropertyPath::on<T>($sourceType);
}
