{
  "name": "tyhp/lambda",
  "description": "Tyhp parsable lambdas: PropertyPath and Expression tree runtime classes",
  "type": "library",
  "license": "Apache-2.0",
  "version": "0.4",
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "require": {
        "tyhpdef/php": "@dev"
      },
      "package": {
        "include": [
          "./package.tyhpdef"
        ],
        "exclude": [],
        "overlay": [],
        "source": {
          "tagless": false
        }
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "tyhp/core": "@dev"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/php-ext-tokenizer": "@dev",
    "tyhpdef/php-ext-tyhp": "@dev",
    "tyhp/compiler": "@dev"
  },
  "suggest": {
    "ext-tyhp": "Expression::fromClosure and PropertyPath::fromClosure read the closure through the module. Install with: pie install tyhp/ext-tyhp"
  },
  "autoload": {
    "psr-4": {
      "Tyhp\\": "src/Tyhp/"
    },
    "files": [
      "src/_functions.php"
    ],
    "classmap": [
      "php/EvalClosure.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tyhp\\Tests\\Lambda\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../tyhpdef/php"
    },
    {
      "type": "path",
      "url": "../../dist/tyhp-core/802.latest"
    },
    {
      "type": "path",
      "url": "../compiler"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-tyhp"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-tokenizer"
    }
  ],
  "config": {
    "allow-plugins": {
      "tyhp/core": true
    }
  }
}
