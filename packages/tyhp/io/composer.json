{
  "name": "tyhp/io",
  "description": "Tyhp runtime io — HTTP, processes, files, sockets, Redis, and databases on the tyhp/async event loop",
  "type": "library",
  "license": "Apache-2.0",
  "version": "0.2",
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "require": {
        "tyhpdef/php": "@dev"
      },
      "package": {
        "include": [
          "./package.tyhpdef"
        ],
        "exclude": [],
        "overlay": [],
        "source": {
          "tagless": false
        }
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "tyhp/core": "@dev",
    "tyhp/async": "@dev"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/php-ext-curl": "@dev",
    "tyhpdef/php-ext-pgsql": "@dev",
    "tyhpdef/php-ext-mysqli": "@dev",
    "tyhpdef/php-ext-pdo": "@dev",
    "tyhp/parallel": "@dev",
    "tyhp/compiler": "@dev"
  },
  "suggest": {
    "ext-curl": "Required by HttpClient",
    "ext-pgsql": "Required by PostgresConnection",
    "ext-mysqli": "Required by MySqlConnection",
    "ext-pdo": "Required by PdoConnection",
    "tyhp/parallel": "Runs PdoConnection, Dns, and Offload work in worker processes instead of blocking the event loop"
  },
  "autoload": {
    "psr-4": {
      "Tyhp\\": "src/Tyhp/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tyhp\\Tests\\Io\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../tyhpdef/php"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-curl"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-pgsql"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-mysqli"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-pdo"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-pcntl"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-posix"
    },
    {
      "type": "path",
      "url": "../../dist/tyhp-core/802.latest"
    },
    {
      "type": "path",
      "url": "../../dist/tyhp-async/802.latest"
    },
    {
      "type": "path",
      "url": "../../dist/tyhp-parallel/802.latest"
    },
    {
      "type": "path",
      "url": "../compiler"
    }
  ],
  "config": {
    "allow-plugins": {
      "tyhp/core": true
    }
  }
}
