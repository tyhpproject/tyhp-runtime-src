<?tyhp

namespace Tyhp\Io\Http;

/**
 * One HTTP request for HttpClient::sendAsync().
 *
 * url is required. A non-empty body is sent with any method. Timeouts are in
 * milliseconds; timeoutMs covers the whole transfer and 0 means no limit.
 */
type HttpRequest = struct {
    string $url = '';
    string $method = 'GET';
    array<string, string> $headers = [];
    string $body = '';
    int $timeoutMs = 30000;
    int $connectTimeoutMs = 10000;
    bool $followRedirects = true;
    int $maxRedirects = 5;
    bool $verifyTls = true;
};
