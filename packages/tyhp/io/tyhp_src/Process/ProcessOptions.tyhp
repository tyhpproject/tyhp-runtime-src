<?tyhp

namespace Tyhp\Io\Process;

/**
 * Options for Process::runAsync().
 *
 * cwd and env default to this process's working directory and environment.
 * input is written to the command's stdin, which is then closed. timeoutMs of 0
 * means no limit; when it elapses the command is killed.
 */
type ProcessOptions = struct {
    ?string $cwd;
    ?array<string, string> $env;
    string $input = '';
    int $timeoutMs = 0;
};
