<?tyhp

namespace Tyhp\Io\Process;

/**
 * The outcome of a finished command.
 *
 * signal is the number of the signal that ended the command, or 0 when it
 * exited normally; exitCode is then 128 + signal, as a shell reports it.
 */
type ProcessResult = struct {
    array<int, string> $command = [];
    int $exitCode = 0;
    int $signal = 0;
    string $stdout = '';
    string $stderr = '';
};
