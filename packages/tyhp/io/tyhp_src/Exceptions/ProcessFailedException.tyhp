<?tyhp

namespace Tyhp\Io\Exceptions;

use Tyhp\Io\Process\ProcessResult;

/**
 * Thrown by Process::mustRunAsync() when the command exits with a non-zero code.
 * The code is the exit code.
 */
final class ProcessFailedException extends IoException {
    private ProcessResult $result;

    public function __construct(ProcessResult $result): parent(
        'The command "' . \implode(' ', $result->command) . '" exited with code ' . $result->exitCode
            . ($result->stderr !== '' ? ': ' . \trim($result->stderr) : '.'),
        $result->exitCode
    ) {
        $this->result = $result;
    }

    public function getResult(): ProcessResult {
        return $this->result;
    }
}
