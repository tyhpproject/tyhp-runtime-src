<?tyhp

namespace Tyhp\Io\Exceptions;

/**
 * Thrown when a database connection or statement fails.
 * getSqlState() returns the five-character SQLSTATE when the driver reports one.
 */
final class DbException extends IoException {
    private string $sqlState;

    public function __construct(string $message, string $sqlState = '', ?\Throwable $previous = null): parent($message, 0, $previous) {
        $this->sqlState = $sqlState;
    }

    public function getSqlState(): string {
        return $this->sqlState;
    }
}
