<?tyhp

namespace Tyhp\Io\Exceptions;

/**
 * Thrown when an HTTP request fails before a response arrives: DNS, connect,
 * TLS, or transfer errors. The code is the curl error number.
 */
class HttpException extends IoException {
    public function __construct(string $message, int $code = 0, ?\Throwable $previous = null): parent($message, $code, $previous) {}
}
