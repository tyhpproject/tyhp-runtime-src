<?tyhp

namespace Tyhp\Io\Exceptions;

use Tyhp\Io\Http\HttpResponse;

/**
 * Thrown by HttpResponse::ensureSuccess() for a status outside 200–299.
 * The code is the HTTP status.
 */
final class HttpStatusException extends HttpException {
    private HttpResponse $response;

    public function __construct(HttpResponse $response): parent(
        'HTTP ' . $response->status . ' from ' . $response->url,
        $response->status
    ) {
        $this->response = $response;
    }

    public function getResponse(): HttpResponse {
        return $this->response;
    }
}
