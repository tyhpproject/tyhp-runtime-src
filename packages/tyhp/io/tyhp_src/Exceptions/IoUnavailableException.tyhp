<?tyhp

namespace Tyhp\Io\Exceptions;

/**
 * Thrown when this PHP process lacks the extension an operation needs.
 */
final class IoUnavailableException extends IoException {
    public function __construct(string $message, ?\Throwable $previous = null): parent($message, 0, $previous) {}

    internal static function requireExtension(string $extension, string $feature): void {
        if (!\extension_loaded($extension)) {
            throw new IoUnavailableException($feature . ' requires the PHP ' . $extension . ' extension.');
        }
    }
}
