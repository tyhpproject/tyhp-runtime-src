<?tyhp

namespace Tyhp\Io\Redis;

/**
 * Connection settings for RedisClient::connectAsync().
 *
 * tls connects with tls:// and verifies the server certificate against host.
 * password alone sends AUTH password; username and password send AUTH username password.
 */
type RedisOptions = struct {
    string $host = '127.0.0.1';
    int $port = 6379;
    bool $tls = false;
    ?string $username;
    ?string $password;
    int $database = 0;
    int $connectTimeoutMs = 10000;
};
