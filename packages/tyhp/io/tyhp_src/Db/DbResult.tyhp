<?tyhp

namespace Tyhp\Io\Db;

use Tyhp\Exceptions\IncompatibleTypeException;
use Tyhp\Type;

/**
 * The rows and counts from one statement.
 *
 * Rows are keyed by column name, and SQL NULL arrives as null. How the other
 * column values are typed depends on the connection:
 *
 * - PostgresConnection converts integer columns to int, float4/float8 columns
 *   to float, and boolean columns to bool; every other column is a string.
 * - MySqlConnection returns integer and float columns as int and float. A
 *   BOOLEAN column is TINYINT(1), so it arrives as int. Other columns are
 *   strings.
 * - PdoConnection returns the values exactly as the PDO driver and its
 *   attributes produce them; nothing is converted.
 *
 * lastInsertId is set when the driver reports one for the statement.
 */
final class DbResult {
    public function __construct(
        public readonly array<int, array<string, mixed>> $rows = [],
        public readonly int $affectedRows = 0,
        public readonly ?string $lastInsertId = null
    ) {}

    public function count(): int {
        return \count($this->rows);
    }

    public function first(): ?array<string, mixed> {
        return $this->rows[0] ?? null;
    }

    /**
     * Returns the first column of the first row, or null when there are no rows.
     */
    public function scalar(): mixed {
        ?array<string, mixed> $row = $this->first();
        if ($row === null) {
            return null;
        }
        foreach ($row as $value) {
            return $value;
        }
        return null;
    }

    /**
     * Returns every row as T. Throws IncompatibleTypeException for the first row
     * that does not match T.
     */
    public function rowsAs<T extends struct>(): array<int, T> {
        array<int, T> $typed = [];
        foreach ($this->rows as $row) {
            if (!Type::isType<T>($row)) {
                throw new IncompatibleTypeException(typeof(T), Type::of($row));
            }
            $typed[] = $row;
        }
        return $typed;
    }

    /**
     * Returns the first row as T, or null when there are no rows.
     */
    public function firstAs<T extends struct>(): ?T {
        ?array<string, mixed> $row = $this->first();
        if ($row === null) {
            return null;
        }
        if (!Type::isType<T>($row)) {
            throw new IncompatibleTypeException(typeof(T), Type::of($row));
        }
        return $row;
    }
}
