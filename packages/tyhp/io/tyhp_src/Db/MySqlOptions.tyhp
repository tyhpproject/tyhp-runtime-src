<?tyhp

namespace Tyhp\Io\Db;

/**
 * Connection settings for MySqlConnection::connectAsync(). socket, when set, is a
 * Unix socket path. mysqli uses it only when host is "localhost"; for any other
 * host the connection goes over TCP to host and port and socket is ignored.
 */
type MySqlOptions = struct {
    string $host = '127.0.0.1';
    int $port = 3306;
    string $user = 'root';
    string $password = '';
    string $database = '';
    string $charset = 'utf8mb4';
    ?string $socket;
    int $connectTimeoutSeconds = 10;
};
