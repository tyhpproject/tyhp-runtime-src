<?tyhp

namespace Tyhp\Io\Db;

/**
 * Settings for PdoConnection. attributes are passed to the PDO constructor;
 * PDO::ATTR_ERRMODE is always PDO::ERRMODE_EXCEPTION.
 */
type PdoOptions = struct {
    string $dsn = '';
    ?string $username;
    ?string $password;
    array<int, int|string|bool> $attributes = [];
};
