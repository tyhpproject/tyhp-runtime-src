<?tyhp

namespace Tyhp\Io\File;

use Tyhp\Contracts\AsyncIterable;
use Tyhp\Contracts\AsyncIterator;

internal final class FileLines implements AsyncIterable<string> {
    public function __construct(private readonly string $path) {}

    public function getAsyncIterator(): AsyncIterator<string> {
        return new FileLineIterator($this->path);
    }
}
