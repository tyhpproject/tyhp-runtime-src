<?tyhp

namespace Tyhp;

/**
 * Runtime description of a Tyhp type.
 *
 * `@template T` is a phantom parameter so `Type<int>` can name the value a factory
 * describes. It is not a Tyhp generic on this class.
 *
 * @template T
 * @phpstan-template T
 * @psalm-template T
 *
 * @method static Type<string> string()
 * @method static Type<int> int()
 * @method static Type<float> float()
 * @method static Type<bool> bool()
 * @method static Type<null> null()
 * @method static Type<void> void()
 * @method static Type<mixed> mixed()
 * @method static Type<never> never()
 * @method static Type<array> array()
 * @method static Type<object> object()
 * @method static Type<callable> callable()
 * @method static Type<iterable> iterable()
 * @method static Type<resource> resource()
 * @method static Type nullable(TypeLike|string $type)
 * @method static Type list(TypeLike|string $value)
 * @method static Type map(TypeLike|string $key, TypeLike|string $value)
 * @method static Type struct(array<int|string, TypeLike|string>|string|null $name = null, array<int|string, TypeLike|string> $fields = [], array<int, int|string>|null $requiredKeys = null)
 * @method static Type optional(TypeLike|string $type)
 * @method static Type generic(string $generic, TypeLike|string ...$args)
 * @method static Type union(TypeLike|string ...$types)
 * @method static Type intersection(TypeLike|string ...$types)
 * @method static Type parse(string $spelling)
 * @method static Type of(mixed $value)
 * @method static Type fromClassName(string $className)
 */
class Type implements \Stringable, TypeLike
{
    /** Documented as `use Tyhp\Type as T`. Each constant is the matching {@see BuiltIn} case. */
    public const BuiltIn string = BuiltIn::string;

    public const BuiltIn int = BuiltIn::int;

    public const BuiltIn float = BuiltIn::float;

    public const BuiltIn bool = BuiltIn::bool;

    public const BuiltIn null = BuiltIn::null;

    public const BuiltIn void = BuiltIn::void;

    public const BuiltIn mixed = BuiltIn::mixed;

    public const BuiltIn never = BuiltIn::never;

    public const BuiltIn array = BuiltIn::array;

    public const BuiltIn object = BuiltIn::object;

    public const BuiltIn callable = BuiltIn::callable;

    public const BuiltIn iterable = BuiltIn::iterable;

    public const BuiltIn resource = BuiltIn::resource;

    private static array<string, self> $singletons = [];

    private static array<string, \Closure> $registry = [];

    /// The exception a registered declaration's factory threw while {@see typeFromExtGraph()} built a
    /// {@see ref()}. {@see parse()} rethrows it: the factory has already run, and running it again
    /// through the PHP parser would not reproduce the failure.
    private static ?\Throwable $extRefFailure = null;

    private static array<string, array<int, self>> $cachedTypes = [];

    private static array<string, array<int, array<int, self>>> $cachedGenerics = [];

    /// Declared property types read by {@see fromProperty()}, keyed by lowercase class `::` property.
    private static array<string, self> $propertyTypes = [];

    private bool $immutable = false;

    private ?self $forward = null;

    private bool $placeholder = false;

    private bool $resolving = false;

    private ?self $lazyInner = null;

    private string $lazyOp = '';

    private ?string $lazyName = null;

    protected function __construct(
        private string $kind,
        private ?string $name = null,
        private array<self|NamedType> $typeArgs = [],
        private bool $isReadOnly = false,
        private bool $isNullable = false,
        private array<int|string, self> $structFields = [],
        private array<int, int|string> $structRequiredKeys = [],
        private array<int, string> $objectShapeMethods = [],
        private array<int, string> $objectShapeProperties = [],
        private ?string $declaredName = null,
        private array<string, bool> $objectShapeMethodSigned = [],
        private array<string, array<int, string>> $objectShapeParamNames = [],
        private array<string, array<int, self>> $objectShapeParamTypes = [],
        private array<string, array<int, bool>> $objectShapeParamOptional = [],
        private array<string, array<int, bool>> $objectShapeParamVariadic = [],
        private array<string, self> $objectShapeReturns = [],
        private array<string, bool> $objectShapeHasReturn = [],
        /// Builder cursor for param() / returns(). Not part of type identity.
        private ?string $objectShapeOpenMethod = null,
    ): void {}

    /**
     * Scalar factories, {@see nullable()}, and {@see optional()} are dispatched here
     * so an instance call such as `->nullable()` or `->optional($name, $type)` is not
     * a static method. PHP uses one method slot for both forms. `nullable` stays
     * magic on purpose: a real method would reject `Type::nullable($type)`.
     */
    public static function __callStatic(string $name, array<int, mixed> $arguments): self
    {
        if ($name === 'nullable') {
            if (\count($arguments) !== 1) {
                throw new Exceptions\InvalidTypeException(
                    'nullable() requires one Type argument.',
                );
            }

            mixed $argument = $arguments[0];
            if (!$argument instanceof TypeLike && !\is_string($argument)) {
                throw new Exceptions\InvalidTypeException(
                    'nullable() requires one Type argument.',
                );
            }

            return self::requireType($argument)->asNullable();
        }

        if ($name === 'optional') {
            if (\count($arguments) !== 1) {
                throw new Exceptions\InvalidTypeException(
                    'optional() requires one type argument.',
                );
            }

            mixed $argument = $arguments[0];
            if (!$argument instanceof TypeLike && !\is_string($argument)) {
                throw new Exceptions\InvalidTypeException(
                    'optional() requires one type argument.',
                );
            }

            return self::optionalType(self::requireType($argument));
        }

        if (\count($arguments) !== 0) {
            throw new Exceptions\InvalidTypeException(
                'Type factory "' . $name . '" does not take arguments.',
            );
        }

        return self::scalar($name);
    }

    private static function scalar(string $name): self
    {
        if (\array_key_exists($name, self::$singletons)) {
            return self::$singletons[$name];
        }

        self $created = match ($name) {
            'string' => new self('scalar', 'string'),
            'int' => new self('scalar', 'int'),
            'float' => new self('scalar', 'float'),
            'bool' => new self('scalar', 'bool'),
            'null' => new self('scalar', 'null', isNullable: true),
            'void' => new self('scalar', 'void'),
            'mixed' => new self('scalar', 'mixed'),
            'never' => new self('scalar', 'never'),
            'array' => new self('scalar', 'array'),
            'object' => new self('scalar', 'object'),
            'callable' => new self('scalar', 'callable'),
            'iterable' => new self('scalar', 'iterable'),
            'resource' => new self('scalar', 'resource'),
            default => throw new Exceptions\InvalidTypeException(
                'Unknown type factory "' . $name . '".',
            ),
        };

        self::$singletons[$name] = $created->immutable();

        return self::$singletons[$name];
    }

    public static function union(TypeLike|string ...$types): self
    {
        array<self> $resolved = [];
        foreach ($types as $type) {
            $resolved[] = self::requireType($type);
        }

        if (\count($resolved) === 0) {
            return new self('union');
        }

        array<self|NamedType> $flattened = [];
        foreach ($resolved as $type) {
            if ($type->kind === 'union') {
                foreach ($type->typeArgs as $member) {
                    $flattened[] = $member;
                }
            } else {
                $flattened[] = $type;
            }
        }

        array<self|NamedType> $unique = [];
        foreach ($flattened as $type) {
            foreach ($unique as $existing) {
                if ($type === $existing) {
                    continue 2;
                }
            }
            $unique[] = $type;
        }

        if (\count($unique) < 2) {
            throw new Exceptions\InvalidTypeException(
                'Union type requires at least 2 member types.',
            );
        }

        return new self('union', null, $unique);
    }

    public static function intersection(TypeLike|string ...$types): self
    {
        array<self> $resolved = [];
        foreach ($types as $type) {
            $resolved[] = self::requireType($type);
        }

        if (\count($resolved) === 0) {
            return new self('intersection');
        }

        array<self|NamedType> $flattened = [];
        foreach ($resolved as $type) {
            if ($type->kind === 'intersection') {
                foreach ($type->typeArgs as $member) {
                    $flattened[] = $member;
                }
            } else {
                $flattened[] = $type;
            }
        }

        array<self|NamedType> $unique = [];
        foreach ($flattened as $type) {
            foreach ($unique as $existing) {
                if ($type === $existing) {
                    continue 2;
                }
            }
            $unique[] = $type;
        }

        if (\count($unique) < 2) {
            throw new Exceptions\InvalidTypeException(
                'Intersection type requires at least 2 member types.',
            );
        }

        return new self('intersection', null, $unique);
    }

    /**
     * The runtime form of `__Awaited<T>`: the type a value has once every `\Tyhp\Promise`
     * layer has settled. A promise of `X` becomes the awaited type of `X`; a bare `Promise`
     * (a callable that only reports `\Tyhp\Promise` as its return type) becomes `mixed`.
     * Unions and nullable types are unwrapped member by member. Every other type, including
     * `mixed` and `void`, is returned unchanged.
     */
    public static function awaited(TypeLike|string $type): self
    {
        if (!$type instanceof self) {
            return self::awaited(self::requireType($type));
        }

        if ($type instanceof NamedType) {
            return self::awaited($type->getUnderlyingType());
        }

        if ($type->forward !== null || $type->lazyInner !== null) {
            return self::awaited($type->follow());
        }

        if ($type->kind === 'scalar') {
            return $type;
        }

        if ($type->isNullable) {
            return self::awaited(new self(
                $type->kind,
                $type->name,
                $type->typeArgs,
                $type->isReadOnly,
                false,
                $type->structFields,
                $type->structRequiredKeys,
                $type->objectShapeMethods,
                $type->objectShapeProperties,
                $type->declaredName,
                $type->objectShapeMethodSigned,
                $type->objectShapeParamNames,
                $type->objectShapeParamTypes,
                $type->objectShapeParamOptional,
                $type->objectShapeParamVariadic,
                $type->objectShapeReturns,
                $type->objectShapeHasReturn,
                $type->objectShapeOpenMethod,
            ))->asNullable();
        }

        if ($type->kind === 'union') {
            array<self> $settled = [];
            foreach ($type->typeArgs as $member) {
                self $awaitedMember = self::awaited($member);
                if ($awaitedMember->kind === 'scalar' && $awaitedMember->name === 'mixed') {
                    return $awaitedMember;
                }

                if (!\in_array($awaitedMember, $settled, true)) {
                    $settled[] = $awaitedMember;
                }
            }

            return \count($settled) === 1 ? $settled[0] : self::union(...$settled);
        }

        if ($type->kind !== 'class' && $type->kind !== 'generic') {
            return $type;
        }

        if (\strtolower(\ltrim($type->name ?? '', '\\')) !== 'tyhp\\promise') {
            return $type;
        }

        if ($type->kind === 'generic' && \count($type->typeArgs) > 0) {
            return self::awaited($type->typeArgs[0]);
        }

        return self::scalar('mixed');
    }

    /**
     * A generic type. Arguments are positional, named after the declared parameters,
     * or mixed (named after positional). A {@see NamedType} is stored as given.
     * `array` and `iterable` take one argument (`TValue`) or two (`TKey`, `TValue`).
     *
     * @template TClass of object
     *
     * @param class-string<TClass> $className
     *
     * @return self<TClass>
     *
     * @phpstan-template TClass of object
     * @phpstan-param class-string<TClass> $className
     * @phpstan-return self<TClass>
     *
     * @psalm-template TClass of object
     * @psalm-param class-string<TClass> $className
     * @psalm-return self<TClass>
     */
    public static function generic(string $className, TypeLike|string ...$params): self
    {
        string $normalized = \ltrim($className, '\\');
        string $lower = \strtolower($normalized);
        array<int, TypeLike|string> $positional = [];
        array<string, TypeLike|string> $named = [];
        array<int|string, mixed> $raw = [];
        foreach ($params as $key => $param) {
            $raw[$key] = $param;
        }

        foreach ($raw as $key => $param) {
            if (!$param instanceof TypeLike && !\is_string($param)) {
                throw new Exceptions\InvalidTypeException(
                    'generic() type arguments must be a Type, BuiltIn, or class-string.',
                );
            }

            if (\is_int($key)) {
                $positional[] = $param;
            } else {
                $named[$key] = $param;
            }
        }

        int $supplied = \count($positional) + \count($named);
        if ($supplied === 0) {
            // The builder form the compiler emits: `generic(X::class)->param('T', $t)`.
            return new self('generic', $normalized, []);
        }

        if (($lower === 'array' || $lower === 'iterable') && $supplied > 2) {
            throw new Exceptions\InvalidTypeException(
                'Type "' . $normalized . '" takes at most two type arguments.',
            );
        }

        ?array<int, string> $declared = self::declaredGenericNames($normalized, $supplied);
        if ($declared === null) {
            if ($named !== []) {
                throw new Exceptions\InvalidTypeException(
                    'Class "' . $normalized . '" has no type parameter names. Pass type arguments by position.',
                );
            }

            array<int, NamedType> $plain = [];
            foreach ($positional as $index => $param) {
                $plain[] = self::asNamedArgument($param, 'T' . (string) $index);
            }

            return new self('generic', $normalized, $plain);
        }

        if (\count($positional) > \count($declared)) {
            throw new Exceptions\InvalidTypeException(
                'Generic type "' . $normalized . '" expects ' . (string) \count($declared)
                . ' type argument(s), ' . (string) $supplied . ' given.',
            );
        }

        array<int, ?NamedType> $slots = [];
        foreach ($declared as $index => $declaredName) {
            (void) $declaredName;
            $slots[$index] = null;
        }

        foreach ($positional as $index => $param) {
            $slots[$index] = self::asNamedArgument($param, $declared[$index] ?? ('T' . (string) $index));
        }

        foreach ($named as $parameterName => $param) {
            int $slot = -1;
            foreach ($declared as $index => $declaredName) {
                if ($declaredName === $parameterName) {
                    $slot = $index;
                    break;
                }
            }

            if ($slot < 0) {
                throw new Exceptions\InvalidTypeException(
                    'Unknown type parameter "' . $parameterName . '" for "' . $normalized . '".',
                );
            }

            if ($slots[$slot] !== null) {
                throw new Exceptions\InvalidTypeException(
                    'Type parameter "' . $parameterName . '" is already filled by position.',
                );
            }

            $slots[$slot] = self::asNamedArgument($param, $parameterName);
        }

        if ($supplied !== \count($declared)) {
            throw new Exceptions\InvalidTypeException(
                'Generic type "' . $normalized . '" expects ' . (string) \count($declared)
                . ' type argument(s), ' . (string) $supplied . ' given.',
            );
        }

        array<int, NamedType> $arguments = [];
        foreach ($slots as $slot) {
            if (!$slot instanceof NamedType) {
                throw new Exceptions\InvalidTypeException(
                    'Generic type "' . $normalized . '" expects ' . (string) \count($declared)
                    . ' type argument(s), ' . (string) $supplied . ' given.',
                );
            }

            $arguments[] = $slot;
        }

        return new self('generic', $normalized, $arguments);
    }

    /**
     * A Tyhp struct shape: an associative array with named (or aliased) keys.
     * An array first argument is the field map. Every field is required unless it is
     * wrapped in {@see optional()}. The name is optional (`name:` / `fields:`).
     * The three-argument form still uses `$requiredKeys` as the required-key list,
     * including an empty list. Extra keys on a value are ignored.
     */
    public static function struct(
        array<int|string, TypeLike|string>|string|null $name = null,
        array<int|string, TypeLike|string> $fields = [],
        ?array<int, int|string> $requiredKeys = null,
    ): self {
        if (\is_array($name)) {
            if ($fields !== [] || $requiredKeys !== null) {
                throw new Exceptions\InvalidTypeException(
                    'struct() with an array field map takes no further arguments. Pass the name as struct(name: ..., fields: ...).',
                );
            }

            return self::structFromFields(null, $name, null);
        }

        if (\is_string($name) || $name === null) {
            return self::structFromFields($name, $fields, $requiredKeys);
        }

        throw new Exceptions\InvalidTypeException(
            'struct() name must be a string or null.',
        );
    }

    /**
     * A Tyhp object shape matched by public member names.
     * `$methods` / `$properties` are required public names with no signature.
     * Use {@see shape()}, {@see method()}, {@see param()}, and {@see returns()}
     * to record parameter and return types. Extra members on a value are ignored.
     * `__construct` is constructability-only and must not be listed.
     * This descriptor is for guards / matching; it does not construct instances.
     */
    public static function objectShape(
        string $name,
        array<int, string> $methods = [],
        array<int, string> $properties = [],
    ): self {
        return new self(
            'objectShape',
            $name,
            [],
            false,
            false,
            [],
            [],
            $methods,
            $properties,
        );
    }

    /**
     * A Tyhp callable shape: an invokable type matched by existence (v1).
     * `$name` is the alias (or `callable` for an inline shape). Extra callable
     * forms are ignored. Signatures are not compared — `\is_callable` is enough.
     * This descriptor is for `is` guards / matching; it does not construct values.
     */
    public static function callableShape(?string $name = null): self
    {
        return new self('callableShape', $name);
    }

    public static fn fromClassName(string $className): self => self::$singletons["class:$className"] ??= (new self('class', $className))->immutable();

    /**
     * Record a declaration without running `$factory`. The first {@see ref()} of that name
     * runs the closure, then stamps `$refName` with {@see name()}.
     * Registering the same name again throws {@see Exceptions\InvalidTypeException}
     * and leaves the first factory in place.
     */
    public static function register(string $name, \Closure $factory): void
    {
        if (\array_key_exists($name, self::$registry)) {
            throw new Exceptions\InvalidTypeException(
                'Type declaration "' . $name . '" is already registered.',
            );
        }

        self::$registry[$name] = $factory;
        unset(self::$cachedTypes[$name], self::$cachedGenerics[$name]);
    }

    /**
     * The type registered under `$refName`. Unknown names throw.
     * Cached by declaration name plus the structure of `$generics`.
     * A placeholder is cached before the closure runs so a nested ref of the same
     * declaration does not recurse forever.
     */
    public static function ref(string $refName, TypeLike|string ...$generics): self
    {
        array<int, self> $resolved = [];
        int $index = 0;
        foreach ($generics as $generic) {
            $resolved[$index] = self::requireType($generic);
            $index = $index + 1;
        }

        if (!\array_key_exists($refName, self::$registry)) {
            throw new Exceptions\InvalidTypeException(
                'Unknown type declaration "' . $refName . '".',
            );
        }

        ?self $cached = self::findCached($refName, $resolved);
        if ($cached !== null) {
            return $cached;
        }

        self $placeholder = new self('ref', $refName, declaredName: $refName);
        $placeholder->placeholder = true;
        self::storeCache($refName, $resolved, $placeholder);

        \Closure $factory = self::$registry[$refName];
        mixed $raw = $factory(...$resolved);
        if (!$raw instanceof self) {
            throw new Exceptions\InvalidTypeException(
                'Type declaration "' . $refName . '" did not return a Type.',
            );
        }

        self $result = $raw->name($refName);
        $result = $result->immutable();
        $placeholder->linkForward($result);
        self::replaceCache($refName, $resolved, $result);

        return $result;
    }

    public static function listOf(TypeLike|string $value): self
    {
        if (!$value instanceof self) {
            return self::listOf(self::requireType($value));
        }

        return self::generic('array', new NamedType('TValue', $value));
    }

    public static function mapOf(TypeLike|string $key, TypeLike|string $value): self
    {
        if (!$key instanceof self || !$value instanceof self) {
            return self::mapOf(self::requireType($key), self::requireType($value));
        }

        return self::generic('array', new NamedType('TKey', $key), new NamedType('TValue', $value));
    }

    public static function list(TypeLike|string $value): self
    {
        return self::listOf($value);
    }

    public static function map(TypeLike|string $key, TypeLike|string $value): self
    {
        return self::mapOf($key, $value);
    }

    public static function shape(?string $name = null): self
    {
        return new self('objectShape', $name);
    }

    public static function closure(): self
    {
        return self::generic(
            \Closure::class,
            new NamedType('TCallableShape', self::callableShape('callable')),
        );
    }

    /**
     * Mark this instance immutable and return it. The flag cannot be cleared.
     * Later fluent changes copy this instance; the copy is not immutable.
     */
    public function immutable(): self
    {
        $this->immutable = true;

        return $this;
    }

    public fn isImmutable(): bool => $this->immutable;

    public function toType(): self
    {
        return $this;
    }

    /**
     * The union of this type and `$others`. A member that is the same type as an earlier one
     * adds nothing, so `int` or `int` is `int`.
     */
    public function or(TypeLike|string ...$others): self
    {
        array<self> $members = [$this->ready()];
        foreach ($others as $other) {
            self $candidate = self::requireType($other);
            bool $seen = false;
            foreach ($members as $member) {
                if ($member->sameStructure($candidate)) {
                    $seen = true;
                    break;
                }
            }

            if (!$seen) {
                $members[] = $candidate;
            }
        }

        if (\count($members) === 1) {
            return $members[0];
        }

        return self::union(...$members);
    }

    /**
     * A new type whose declaration name is `$name`. Scalar, class, and generic
     * discriminants stay in place so `is()` still matches. An immutable receiver
     * is copied; the original is unchanged.
     */
    public function name(string $name): self
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return $this->follow()->name($name);
        }

        if ($this->placeholder) {
            self $wrapper = new self('lazy', $name, declaredName: $name);
            $wrapper->lazyInner = $this;
            $wrapper->lazyOp = 'name';
            $wrapper->lazyName = $name;

            return $wrapper;
        }

        self $target = $this->edited();
        $target->declaredName = $name;
        if (!$target->keepsDiscriminant()) {
            $target->name = $name;
        }

        return $target;
    }

    public function field(int|string $name, TypeLike|string $type): self
    {
        self $current = $this->ready();
        if ($current->kind !== 'struct') {
            throw new Exceptions\InvalidTypeException('field() requires a struct type.');
        }

        return $current->putStructField($name, self::requireType($type), true);
    }

    public function param(string $name, TypeLike|string $type, bool $optional = false, bool $variadic = false): self
    {
        self $resolved = self::requireType($type);
        self $current = $this->ready();
        if ($current->kind === 'objectShape') {
            return $current->putObjectShapeParam($name, $resolved, $optional, $variadic);
        }

        if ($optional || $variadic) {
            throw new Exceptions\InvalidTypeException(
                'param() optional and variadic flags require an object shape.',
            );
        }

        if ($current->kind !== 'generic') {
            throw new Exceptions\InvalidTypeException(
                'param() requires a generic type or an object shape.',
            );
        }

        self $target = $current->edited();
        array<self|NamedType> $args = $target->typeArgs;
        $args[] = new NamedType($name, $resolved);
        $target->typeArgs = $args;

        return $target;
    }

    public function class(string $className): self
    {
        self $current = $this->ready();
        if ($current->kind !== 'union' && $current->kind !== 'intersection') {
            throw new Exceptions\InvalidTypeException('class() requires a union or intersection type.');
        }

        self $target = $current->edited();
        $target->appendMember(self::fromClassName($className));

        return $target;
    }

    /**
     * Start a method on this object shape. Later {@see param()} and {@see returns()}
     * calls attach to it until the next method(). An immutable receiver is copied.
     */
    public function method(string $name): self
    {
        self $current = $this->ready();
        if ($current->kind !== 'objectShape') {
            throw new Exceptions\InvalidTypeException('method() requires an object shape.');
        }

        self $target = $current->edited();
        if (!\in_array($name, $target->objectShapeMethods, true)) {
            array<int, string> $methods = $target->objectShapeMethods;
            $methods[] = $name;
            $target->objectShapeMethods = $methods;
        }

        $target->objectShapeOpenMethod = $name;

        return $target;
    }

    /**
     * Record the return type of the method started by {@see method()}.
     * An immutable receiver is copied.
     */
    public function returns(TypeLike|string $type): self
    {
        self $resolved = self::requireType($type);
        self $current = $this->ready();
        if ($current->kind !== 'objectShape') {
            throw new Exceptions\InvalidTypeException('returns() requires an object shape.');
        }

        return $current->putObjectShapeReturn($resolved);
    }

    public function property(string $name): self
    {
        self $current = $this->ready();
        if ($current->kind !== 'objectShape') {
            throw new Exceptions\InvalidTypeException('property() requires an object shape.');
        }

        self $target = $current->edited();
        if (!\in_array($name, $target->objectShapeProperties, true)) {
            array<int, string> $properties = $target->objectShapeProperties;
            $properties[] = $name;
            $target->objectShapeProperties = $properties;
        }

        return $target;
    }

    public function __call(string $name, array<int, mixed> $arguments): self
    {
        if ($name === 'optional') {
            if (\count($arguments) !== 2) {
                throw new Exceptions\InvalidTypeException(
                    'optional() requires a field name and a type.',
                );
            }

            mixed $fieldName = $arguments[0];
            mixed $fieldType = $arguments[1];
            if (!\is_int($fieldName) && !\is_string($fieldName)) {
                throw new Exceptions\InvalidTypeException(
                    'optional() requires a field name and a type.',
                );
            }

            if (!$fieldType instanceof TypeLike && !\is_string($fieldType)) {
                throw new Exceptions\InvalidTypeException(
                    'optional() requires a field name and a type.',
                );
            }

            self $current = $this->ready();
            if ($current->kind !== 'struct') {
                throw new Exceptions\InvalidTypeException('optional() requires a struct type.');
            }

            return $current->putStructField($fieldName, self::requireType($fieldType), false);
        }

        if ($name === 'nullable') {
            if (\count($arguments) !== 0) {
                throw new Exceptions\InvalidTypeException(
                    'Type fluent method "nullable" does not take arguments.',
                );
            }

            return $this->asNullable();
        }

        if (\count($arguments) !== 0) {
            throw new Exceptions\InvalidTypeException(
                'Type fluent method "' . $name . '" does not take arguments.',
            );
        }

        ?self $member = match ($name) {
            'string', 'int', 'float', 'bool', 'null', 'void', 'mixed', 'never', 'array', 'object', 'callable', 'iterable', 'resource' => self::scalar($name),
            default => null,
        };
        if ($member === null) {
            throw new Exceptions\InvalidTypeException(
                'Unknown type fluent method "' . $name . '".',
            );
        }

        self $current = $this->ready();
        if ($current->kind !== 'union') {
            throw new Exceptions\InvalidTypeException(
                'Fluent ' . $name . '() requires a union type.',
            );
        }

        self $target = $current->edited();
        $target->appendMember($member);

        return $target;
    }

    /**
     * Build a Type from a callable's reflected return type, or null when the callable has no
     * return type (or cannot be reflected). Used by Mechanism D wrappers to infer a method
     * generic from a `callable(...): T` / `\Closure<callable(...): T>` value argument when the call site
     * omitted `<T>`.
     */
    public static function fromCallableReturn(callable $callable): ?self
    {
        ?\ReflectionFunctionAbstract $ref = null;
        try {
            if ($callable instanceof \Closure) {
                $ref = new \ReflectionFunction($callable);
            } elseif (
                \is_array($callable)
                && \array_key_exists(0, $callable)
                && \array_key_exists(1, $callable)
                && \is_string($callable[1])
            ) {
                mixed $rawTarget = $callable[0];
                string $methodName = $callable[1];
                if (\is_object($rawTarget)) {
                    $ref = new \ReflectionMethod($rawTarget, $methodName);
                } elseif (\is_string($rawTarget)) {
                    $ref = new \ReflectionMethod($rawTarget, $methodName);
                }
            } elseif (\is_string($callable)) {
                $ref = \str_contains($callable, '::')
                    ? new \ReflectionMethod($callable)
                    : (\function_exists($callable)
                        ? new \ReflectionFunction($callable)
                        : throw new \ReflectionException("Function \"{$callable}\" does not exist or is inaccessible.")
                    );
            } elseif (\is_object($callable)) {
                $ref = new \ReflectionMethod($callable, '__invoke');
            }
        } catch (\Throwable $e) {
            (void)$e;
            return null;
        }

        if ($ref === null) {
            return null;
        }

        ?\ReflectionType $returnType = $ref->getReturnType();
        if ($returnType === null) {
            return null;
        }

        ?string $relativeClassName = null;
        if ($ref instanceof \ReflectionMethod) {
            $relativeClassName = (string)$ref->getDeclaringClass()->getName();
        } else {
            ?\ReflectionClass<object> $scope = $ref->getClosureScopeClass();
            if ($scope !== null) {
                $relativeClassName = (string)$scope->getName();
            }
        }

        return self::fromReflectionType($returnType, $relativeClassName);
    }

    /**
     * Convert a PHP reflection type into a Tyhp Type. `$relativeClassName` resolves
     * `self` / `static` / `parent` relative to the callable's declaring class when known.
     */
    public static function fromReflectionType(
        \ReflectionType $type,
        ?string $relativeClassName = null,
    ): self {
        if ($type instanceof \ReflectionUnionType) {
            array<self> $members = [];
            bool $nullable = false;
            foreach ($type->getTypes() as $member) {
                if ($member instanceof \ReflectionNamedType) {
                    if ($member->getName() === 'null') {
                        $nullable = true;
                        continue;
                    }

                    $members[] = self::fromNamedReflectionType($member, $relativeClassName);
                } elseif ($member instanceof \ReflectionUnionType) {
                    $members[] = self::fromReflectionType($member, $relativeClassName);
                } elseif ($member instanceof \ReflectionIntersectionType) {
                    $members[] = self::fromReflectionType($member, $relativeClassName);
                }
            }

            self $combined = match (true) {
                \count($members) === 0 => self::scalar('mixed'),
                \count($members) === 1 => $members[0],
                default => self::union(...$members),
            };
            return $nullable ? $combined->asNullable() : $combined;
        }

        if ($type instanceof \ReflectionIntersectionType) {
            array<self> $members = [];
            foreach ($type->getTypes() as $member) {
                if ($member instanceof \ReflectionNamedType) {
                    $members[] = self::fromNamedReflectionType($member, $relativeClassName);
                } elseif ($member instanceof \ReflectionUnionType) {
                    $members[] = self::fromReflectionType($member, $relativeClassName);
                } elseif ($member instanceof \ReflectionIntersectionType) {
                    $members[] = self::fromReflectionType($member, $relativeClassName);
                }
            }

            return \count($members) >= 2
                ? self::intersection(...$members)
                : ($members[0] ?? self::scalar('mixed'));
        }

        if ($type instanceof \ReflectionNamedType) {
            return self::fromNamedReflectionType($type, $relativeClassName);
        }

        return self::scalar('mixed');
    }

    private static function fromNamedReflectionType(
        \ReflectionNamedType $type,
        ?string $relativeClassName,
    ): self {
        string $name = $type->getName();
        self $result = match ($name) {
            'string' => self::scalar('string'),
            'int' => self::scalar('int'),
            'float' => self::scalar('float'),
            'bool' => self::scalar('bool'),
            'array' => self::scalar('array'),
            'object' => self::scalar('object'),
            'callable' => self::scalar('callable'),
            'iterable' => self::scalar('iterable'),
            'void' => self::scalar('void'),
            'never' => self::scalar('never'),
            'mixed' => self::scalar('mixed'),
            'null' => self::scalar('null'),
            'false' => self::scalar('bool'),
            'true' => self::scalar('bool'),
            'self', 'static' => $relativeClassName !== null
                ? self::fromClassName($relativeClassName)
                : self::scalar('object'),
            'parent' => self::fromParentClassName($relativeClassName),
            default => self::fromClassName($name),
        };

        if ($type->allowsNull() && $name !== 'mixed' && $name !== 'null') {
            return $result->asNullable();
        }

        return $result;
    }

    private static function fromParentClassName(?string $relativeClassName): self
    {
        if ($relativeClassName === null) {
            return self::scalar('object');
        }

        string|false $parent = \get_parent_class($relativeClassName);
        if (!\is_string($parent)) {
            return self::fromClassName($relativeClassName);
        }

        return self::fromClassName($parent);
    }

    /**
     * Read a type spelling such as `array<App\Post>`, `?App\Table<App\Blog>`,
     * `array<string, int>|null`, or `struct App\Address`.
     *
     * - Builtins: `string`, `int`, `float`, `bool`, `true`/`false` (as `bool`), `null`, `void`,
     *   `mixed`, `never`, `object`, `callable`, `iterable`, `resource`, `array`.
     *   `decimal` is the `Tyhp\Decimal` class.
     * - `array<V>` is {@see listOf()}, `array<K, V>` is {@see mapOf()}, `iterable<…>` is the same
     *   shape on `iterable`.
     * - `?T`, `A|B`, `A&B`, and parentheses for grouping.
     * - `struct Name`, `object Name`, `callable Name` are the forms `__toString()` prints for
     *   struct, object-shape, and callable-shape types.
     * - Any other name is a class. A leading `\` is optional. A name registered with
     *   {@see register()} (a source type alias or struct) resolves through {@see ref()},
     *   with its type arguments.
     * - Class type arguments are positional: read them with {@see typeArguments()}.
     *
     * Invalid spellings throw {@see Exceptions\InvalidTypeException}.
     */
    public static function parse(string $spelling): self
    {
        if (ExtModule::available()) {
            ?\Tyhp\ExtParseNode $graph = \Tyhp\Ext::typeParse($spelling);
            if ($graph !== null) {
                try {
                    return self::typeFromExtGraph($graph);
                } catch (Exceptions\InvalidTypeException $e) {
                    if (self::$extRefFailure === $e) {
                        self::$extRefFailure = null;
                        throw $e;
                    }
                }
            }
        }

        array<int, string> $tokens = self::tokenizeSpelling($spelling);
        if (\count($tokens) === 0) {
            throw new Exceptions\InvalidTypeException('Type spelling is empty.');
        }

        int $position = 0;
        self $type = self::parseUnionSpelling($tokens, $position, $spelling);
        if ($position !== \count($tokens)) {
            throw new Exceptions\InvalidTypeException(
                'Unexpected "' . $tokens[$position] . '" in type spelling "' . $spelling . '".',
            );
        }

        return $type;
    }

    /**
     * Declared Tyhp type of `$property` on `$class`.
     *
     * Reads the compiler's `#[\Tyhp\PropertyType]` stamp, which keeps what the PHP hint loses
     * (`array<App\Post>`, `App\Table<App\Blog>`, `struct App\Address`). Without a stamp the
     * reflected PHP type is used, and an untyped property is `mixed`. For an object whose class
     * tracks generics, a property typed by a class type parameter returns the bound argument.
     * `$class` may be a class name, a generic spelling (`App\Table<App\Blog>`), or an object.
     * A missing property throws {@see Exceptions\PropertyNotFoundException}.
     */
    public static function fromProperty(string|object $class, string $property): self
    {
        string $className;
        if (\is_object($class)) {
            ?self $tracked = self::tryGetGenericPropertyType($class, $property);
            if ($tracked !== null) {
                return $tracked;
            }

            $className = $class::class;
        } else {
            $className = self::classNameFromSpelling($class);
        }

        string $key = \strtolower($className) . '::' . $property;
        if (\array_key_exists($key, self::$propertyTypes)) {
            return self::$propertyTypes[$key];
        }

        \ReflectionProperty $reflected;
        try {
            $reflected = new \ReflectionProperty($className, $property);
        } catch (\Throwable $e) {
            throw new Exceptions\PropertyNotFoundException($property, $className, $e);
        }

        self $type = self::fromReflectionProperty($reflected)->immutable();
        self::$propertyTypes[$key] = $type;

        return $type;
    }

    private static function fromReflectionProperty(\ReflectionProperty $property): self
    {
        foreach ($property->getAttributes(PropertyType::class) as $attribute) {
            array<int|string, mixed> $arguments = $attribute->getArguments();
            mixed $spelling = $arguments[0] ?? $arguments['type'] ?? null;
            if (!\is_string($spelling)) {
                continue;
            }

            try {
                return self::parse($spelling);
            } catch (Exceptions\InvalidTypeException $e) {
                (void)$e;
                break;
            }
        }

        ?\ReflectionType $native = $property->getType();
        if ($native === null) {
            return self::scalar('mixed');
        }

        return self::fromReflectionType($native, (string)$property->getDeclaringClass()->getName());
    }

    /// Class part of a spelling: `?\App\Table<App\Blog>` → `App\Table`.
    private static function classNameFromSpelling(string $spelling): string
    {
        string $name = \ltrim(\trim($spelling), '?\\');
        int|false $angle = \strpos($name, '<');
        if ($angle !== false) {
            $name = \substr($name, 0, $angle);
        }

        return \trim($name);
    }

    /// Type registered for `$property` in the object's generic bag, if any.
    /// Duck-typed like {@see tryGetGenericObjectType()}.
    private static function tryGetGenericPropertyType(object $value, string $property): ?self
    {
        if (!\property_exists($value, '__tyhpGeneric')) {
            return null;
        }

        mixed $bag = $value->__tyhpGeneric ?? null;
        if (!\is_object($bag) || !\method_exists($bag, 'propertyType')) {
            return null;
        }

        mixed $registered = $bag->propertyType($property);
        return $registered instanceof self ? $registered : null;
    }

    /**
     * @return array<int, string>
     */
    private static function tokenizeSpelling(string $spelling): array<int, string>
    {
        array<int, string> $tokens = [];
        int $length = \strlen($spelling);
        int $i = 0;
        while ($i < $length) {
            string $char = $spelling[$i];
            if ($char === ' ' || $char === "\t" || $char === "\n" || $char === "\r") {
                $i++;
                continue;
            }

            if (\str_contains('?|&<>,()', $char)) {
                $tokens[] = $char;
                $i++;
                continue;
            }

            int $start = $i;
            while ($i < $length && self::isSpellingNameByte($spelling[$i])) {
                $i++;
            }

            if ($i === $start) {
                throw new Exceptions\InvalidTypeException(
                    'Unexpected "' . $char . '" in type spelling "' . $spelling . '".',
                );
            }

            $tokens[] = \substr($spelling, $start, $i - $start);
        }

        return $tokens;
    }

    private static function isSpellingNameByte(string $char): bool
    {
        int $code = \ord($char);

        return ($code >= 0x61 && $code <= 0x7a)
            || ($code >= 0x41 && $code <= 0x5a)
            || ($code >= 0x30 && $code <= 0x39)
            || $code === 0x5f
            || $code === 0x5c
            || $code >= 0x80;
    }

    /**
     * @param array<int, string> $tokens
     */
    private static function parseUnionSpelling(array<int, string> $tokens, int &$position, string $spelling): self
    {
        array<int, self> $members = [self::parseIntersectionSpelling($tokens, $position, $spelling)];
        while (($tokens[$position] ?? null) === '|') {
            $position++;
            $members[] = self::parseIntersectionSpelling($tokens, $position, $spelling);
        }

        if (\count($members) === 1) {
            return $members[0];
        }

        bool $nullable = false;
        array<int, self> $nonNull = [];
        foreach ($members as $member) {
            if ($member->kind === 'scalar' && $member->name === 'null') {
                $nullable = true;
                continue;
            }

            if ($member->isNullable) {
                $nullable = true;
                $member = $member->asNonNullable();
            }

            $nonNull[] = $member;
        }

        self $combined = match (\count($nonNull)) {
            0 => self::scalar('null'),
            1 => $nonNull[0],
            default => self::union(...$nonNull),
        };

        return $nullable ? $combined->asNullable() : $combined;
    }

    /**
     * @param array<int, string> $tokens
     */
    private static function parseIntersectionSpelling(
        array<int, string> $tokens,
        int &$position,
        string $spelling,
    ): self {
        array<int, self> $members = [self::parsePrefixSpelling($tokens, $position, $spelling)];
        while (($tokens[$position] ?? null) === '&') {
            $position++;
            $members[] = self::parsePrefixSpelling($tokens, $position, $spelling);
        }

        return \count($members) === 1 ? $members[0] : self::intersection(...$members);
    }

    /**
     * @param array<int, string> $tokens
     */
    private static function parsePrefixSpelling(array<int, string> $tokens, int &$position, string $spelling): self
    {
        ?string $token = $tokens[$position] ?? null;
        if ($token === '?') {
            $position++;
            return self::parsePrefixSpelling($tokens, $position, $spelling)->asNullable();
        }

        if ($token === '(') {
            $position++;
            self $inner = self::parseUnionSpelling($tokens, $position, $spelling);
            self::expectSpellingToken($tokens, $position, ')', $spelling);
            return $inner;
        }

        return self::parseNamedSpelling($tokens, $position, $spelling);
    }

    /**
     * @param array<int, string> $tokens
     */
    private static function parseNamedSpelling(array<int, string> $tokens, int &$position, string $spelling): self
    {
        ?string $token = $tokens[$position] ?? null;
        if ($token === null || \str_contains('?|&<>,()', $token)) {
            throw new Exceptions\InvalidTypeException(
                'Expected a type name in type spelling "' . $spelling . '".',
            );
        }

        $position++;
        string $name = \ltrim($token, '\\');
        string $lower = \strtolower($name);

        ?string $next = $tokens[$position] ?? null;
        if (($lower === 'struct' || $lower === 'object' || $lower === 'callable')
            && $next !== null
            && !\str_contains('?|&<>,()', $next)) {
            $position++;
            string $shapeName = \ltrim($next, '\\');
            array<int, self> $shapeArgs = self::parseSpellingTypeArguments($tokens, $position, $spelling);
            if (\array_key_exists($shapeName, self::$registry)) {
                return self::ref($shapeName, ...$shapeArgs);
            }

            return match ($lower) {
                'struct' => self::struct($shapeName),
                'object' => self::shape($shapeName),
                default => self::callableShape($shapeName),
            };
        }

        array<int, self> $args = self::parseSpellingTypeArguments($tokens, $position, $spelling);

        if ($lower === 'array' || $lower === 'iterable') {
            return match (\count($args)) {
                0 => self::scalar($lower),
                1 => $lower === 'array'
                    ? self::listOf($args[0])
                    : self::generic('iterable', new NamedType('TValue', $args[0])),
                2 => $lower === 'array'
                    ? self::mapOf($args[0], $args[1])
                    : self::generic('iterable', new NamedType('TKey', $args[0]), new NamedType('TValue', $args[1])),
                default => throw new Exceptions\InvalidTypeException(
                    'Type "' . $name . '" takes at most two type arguments in "' . $spelling . '".',
                ),
            };
        }

        ?self $builtin = match ($lower) {
            'string', 'int', 'float', 'bool', 'null', 'void', 'mixed', 'never', 'object', 'callable', 'resource' => self::scalar($lower),
            'true', 'false' => self::scalar('bool'),
            'decimal' => self::fromClassName('Tyhp\\Decimal'),
            default => null,
        };
        if ($builtin !== null) {
            if (\count($args) !== 0) {
                throw new Exceptions\InvalidTypeException(
                    'Type "' . $name . '" does not take type arguments in "' . $spelling . '".',
                );
            }

            return $builtin;
        }

        if (\array_key_exists($name, self::$registry)) {
            return self::ref($name, ...$args);
        }

        if (\count($args) === 0) {
            return self::fromClassName($name);
        }

        array<int, NamedType> $named = [];
        foreach ($args as $index => $arg) {
            $named[] = new NamedType('T' . $index, $arg);
        }

        return self::generic($name, ...$named);
    }

    /**
     * @param array<int, string> $tokens
     * @return array<int, self>
     */
    private static function parseSpellingTypeArguments(
        array<int, string> $tokens,
        int &$position,
        string $spelling,
    ): array<int, self> {
        if (($tokens[$position] ?? null) !== '<') {
            return [];
        }

        $position++;
        array<int, self> $args = [self::parseUnionSpelling($tokens, $position, $spelling)];
        while (($tokens[$position] ?? null) === ',') {
            $position++;
            $args[] = self::parseUnionSpelling($tokens, $position, $spelling);
        }

        self::expectSpellingToken($tokens, $position, '>', $spelling);

        return $args;
    }

    /**
     * @param array<int, string> $tokens
     */
    private static function expectSpellingToken(
        array<int, string> $tokens,
        int &$position,
        string $expected,
        string $spelling,
    ): void {
        if (($tokens[$position] ?? null) !== $expected) {
            throw new Exceptions\InvalidTypeException(
                'Expected "' . $expected . '" in type spelling "' . $spelling . '".',
            );
        }

        $position++;
    }

    /**
     * Normalize a type argument. `null` stays `null`. A `Type` passes through.
     * A {@see BuiltIn} becomes its `Type`. A string naming a loaded class, interface,
     * or enum becomes {@see fromClassName()}. Any other string is a type spelling
     * and must go through {@see parse()}.
     *
     * @return (
     *     $type is null ? null :
     *     $type is BuiltIn::string ? Type<string> :
     *     $type is BuiltIn::int ? Type<int> :
     *     $type is BuiltIn::float ? Type<float> :
     *     $type is BuiltIn::bool ? Type<bool> :
     *     $type is BuiltIn::null ? Type<null> :
     *     $type is BuiltIn::void ? Type<void> :
     *     $type is BuiltIn::mixed ? Type<mixed> :
     *     $type is BuiltIn::never ? Type<never> :
     *     $type is BuiltIn::array ? Type<array> :
     *     $type is BuiltIn::object ? Type<object> :
     *     $type is BuiltIn::callable ? Type<callable> :
     *     $type is BuiltIn::iterable ? Type<iterable> :
     *     $type is BuiltIn::resource ? Type<resource> :
     *     Type|null
     * )
     *
     * @phpstan-return (
     *     $type is null ? null :
     *     $type is BuiltIn::string ? Type<string> :
     *     $type is BuiltIn::int ? Type<int> :
     *     $type is BuiltIn::float ? Type<float> :
     *     $type is BuiltIn::bool ? Type<bool> :
     *     $type is BuiltIn::null ? Type<null> :
     *     $type is BuiltIn::void ? Type<void> :
     *     $type is BuiltIn::mixed ? Type<mixed> :
     *     $type is BuiltIn::never ? Type<never> :
     *     $type is BuiltIn::array ? Type<array> :
     *     $type is BuiltIn::object ? Type<object> :
     *     $type is BuiltIn::callable ? Type<callable> :
     *     $type is BuiltIn::iterable ? Type<iterable> :
     *     $type is BuiltIn::resource ? Type<resource> :
     *     Type|null
     * )
     *
     * @psalm-return (
     *     $type is null ? null :
     *     $type is BuiltIn::string ? Type<string> :
     *     $type is BuiltIn::int ? Type<int> :
     *     $type is BuiltIn::float ? Type<float> :
     *     $type is BuiltIn::bool ? Type<bool> :
     *     $type is BuiltIn::null ? Type<null> :
     *     $type is BuiltIn::void ? Type<void> :
     *     $type is BuiltIn::mixed ? Type<mixed> :
     *     $type is BuiltIn::never ? Type<never> :
     *     $type is BuiltIn::array ? Type<array> :
     *     $type is BuiltIn::object ? Type<object> :
     *     $type is BuiltIn::callable ? Type<callable> :
     *     $type is BuiltIn::iterable ? Type<iterable> :
     *     $type is BuiltIn::resource ? Type<resource> :
     *     Type|null
     * )
     */
    public static function arg(TypeLike|string|null $type): ?self
    {
        if ($type === null) {
            return null;
        }

        if ($type instanceof self) {
            return $type;
        }

        if ($type instanceof BuiltIn) {
            return $type->toType();
        }

        if ($type instanceof TypeLike) {
            return $type->toType();
        }

        if (\class_exists($type) || \interface_exists($type) || \enum_exists($type)) {
            return self::fromClassName($type);
        }

        throw new Exceptions\InvalidTypeException(
            'String "' . $type . '" is not a class, interface, or enum name. Use Type::parse() for a type spelling.',
        );
    }

    public static function of(mixed $value): self
    {
        if ($value === null) {
            return self::scalar('null');
        }

        string $debugType = \get_debug_type($value);

        return match ($debugType) {
            'string' => self::scalar('string'),
            'int' => self::scalar('int'),
            'float' => self::scalar('float'),
            'bool' => self::scalar('bool'),
            'array' => self::scalar('array'),
            'resource', 'resource (closed)' => self::scalar('resource'),
            default => \is_object($value)
                ? self::resolveObjectType($value)
                : self::fromClassName($debugType),
        };
    }

    private static function resolveObjectType(object $value): self
    {
        return self::tryGetGenericObjectType($value) ?? self::fromClassName($value::class);
    }

    /// Runtime generic type recorded by {@see \Tyhp\Concerns\HasGenerics}, if any.
    /// Duck-typed so this file never names {@see \Tyhp\GenericObject} (circular with Type factories).
    private static function tryGetGenericObjectType(object $value): ?self
    {
        if (!\property_exists($value, '__tyhpGeneric')) {
            return null;
        }

        mixed $bag = $value->__tyhpGeneric ?? null;
        if (!\is_object($bag) || !\method_exists($bag, 'objectType')) {
            return null;
        }

        mixed $objectType = $bag->objectType();
        return $objectType instanceof self ? $objectType : null;
    }

    /// Whether `$value` is an instance of the class or interface named by `$className`.
    ///
    /// `\is_a` on an object does not autoload `$className` and returns false when the
    /// name is unknown or empty. A loaded class (or enum) name is a `__ClassName` and
    /// is passed to `\is_a`. A loaded interface is not a class name; `instanceof`
    /// matches `\is_a` for that name and also returns false when it is not loaded.
    private static function objectIsNamedType(object $value, string $className): bool
    {
        if (\class_exists($className, false)) {
            return \is_a($value, $className);
        }

        return \interface_exists($className, false) && $value instanceof $className;
    }

    /// Whether `$narrowName` is `$broadName` or a subtype of it.
    ///
    /// `\is_a` with a string subject autoloads only that subject, then looks the other
    /// name up among symbols that are already loaded. An unknown or empty name is
    /// false. A loaded class name is passed to `\is_a`. A loaded interface name is
    /// not a `__ClassName`: a class subject uses `\is_subclass_of`, and an interface
    /// subject uses reflection, which reports the same relation. A loaded trait is
    /// the same type only when both names resolve to that trait.
    private static function namedTypeIsA(string $narrowName, string $broadName): bool
    {
        if (\class_exists($narrowName)) {
            if (\class_exists($broadName, false)) {
                return \is_a($narrowName, $broadName, true);
            }

            return \interface_exists($broadName, false)
                && \is_subclass_of($narrowName, $broadName, true);
        }

        if (\interface_exists($narrowName, false)) {
            if (\class_exists($broadName, false)) {
                return \is_a($narrowName, $broadName, true);
            }

            if (!\interface_exists($broadName, false)) {
                return false;
            }

            \ReflectionClass $narrow = new \ReflectionClass($narrowName);
            \ReflectionClass $broad = new \ReflectionClass($broadName);

            return $narrow->getName() === $broad->getName()
                || $narrow->isSubclassOf($broadName);
        }

        if (!\trait_exists($narrowName, false)) {
            return false;
        }

        if (!\trait_exists($broadName, false)) {
            return false;
        }

        \ReflectionClass $narrowTrait = new \ReflectionClass($narrowName);
        \ReflectionClass $broadTrait = new \ReflectionClass($broadName);

        return $narrowTrait->getName() === $broadTrait->getName();
    }

    public static function isType<TTarget>(mixed $value): $value is TTarget
    {
        return self::is($value, typeof(TTarget));
    }

    public static function is(mixed $value, TypeLike|string $type): bool
    {
        if (!$type instanceof self) {
            return self::is($value, self::requireType($type));
        }

        if (ExtModule::available()) {
            ?bool $native = \Tyhp\Ext::typeIs($type, $value);
            if ($native !== null) {
                return $native;
            }
        }

        if ($type instanceof NamedType) {
            return self::is($value, $type->getUnderlyingType());
        }

        if ($type->forward !== null || $type->lazyInner !== null) {
            return self::is($value, $type->follow());
        }

        if ($type->isNullable && $value === null) {
            return true;
        }

        return match ($type->kind) {
            'scalar' => self::isScalar($value, $type),
            'class' => \is_object($value) && self::objectIsNamedType($value, $type->name ?? ''),
            'union' => self::isUnion($value, $type),
            'intersection' => self::isIntersection($value, $type),
            'generic' => self::isGeneric($value, $type),
            'struct' => self::isStruct($value, $type),
            'objectShape' => self::isObjectShape($value, $type),
            'callableShape' => self::isCallableShape($value, $type),
            default => false,
        };
    }

    public static function check(mixed $value, TypeLike|string $type): void
    {
        self $expected = self::requireType($type);
        if (!self::is($value, $expected)) {
            throw new \Tyhp\Exceptions\IncompatibleTypeException($expected, self::of($value));
        }
    }

    /**
     * The zero value for this type — what `default(T)` evaluates to once `T` is known at runtime.
     *
     * A nullable type defaults to `null` rather than to its inner type's zero value, matching
     * `default(?int)`. Types with no meaningful zero (`void`, `never`, `mixed`, `resource`,
     * unions, intersections) and object types without a declared default also yield `null`.
     * For `void`, that `null` is accepted by {@see is()} so `Type::is(null, Type::void())` is true.
     */
    public function defaultValue(): mixed
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return $this->follow()->defaultValue();
        }

        if ($this->isNullable) {
            return null;
        }

        return match ($this->kind) {
            'scalar' => match ($this->name) {
                'string' => '',
                'int' => 0,
                'float' => 0.0,
                'bool' => false,
                'array', 'iterable' => [],
                default => null,
            },
            'struct' => [],
            default => null,
        };
    }

    private static function isScalar(mixed $value, self $type): bool
    {
        return match ($type->name) {
            'string' => \is_string($value),
            'int' => \is_int($value),
            'float' => \is_float($value) || \is_int($value),
            'bool' => \is_bool($value),
            'null' => $value === null,
            // `null` is the runtime stand-in for void (what `default(void)` produces).
            // Void is not nullable: only null matches, not every other value.
            'void' => $value === null,
            'mixed' => true,
            'never' => false,
            'array' => \is_array($value),
            'object' => \is_object($value),
            'callable' => \is_callable($value),
            'iterable' => \is_iterable($value),
            'resource' => \is_resource($value) || \get_debug_type($value) === 'resource (closed)',
            default => false,
        };
    }

    private static function isUnion(mixed $value, self $type): bool
    {
        foreach ($type->typeArgs as $memberType) {
            if (self::is($value, $memberType)) {
                return true;
            }
        }

        return false;
    }

    private static function isIntersection(mixed $value, self $type): bool
    {
        foreach ($type->typeArgs as $memberType) {
            if (!self::is($value, $memberType)) {
                return false;
            }
        }

        return true;
    }

    private static function isGeneric(mixed $value, self $type): bool
    {
        if ($type->name === 'array' || $type->name === 'iterable') {
            return self::isArrayOf($value, $type);
        }

        if (!\is_object($value)) {
            return false;
        }

        if (!self::objectIsNamedType($value, $type->name ?? '')) {
            return false;
        }

        ?self $objectType = self::tryGetGenericObjectType($value);
        if ($objectType !== null) {
            return self::compatible($type, $objectType);
        }

        return true;
    }

    private static function isArrayOf(mixed $value, self $type): bool
    {
        if ($type->name === 'array') {
            if (!\is_array($value)) {
                return false;
            }
        } elseif (!\is_iterable($value)) {
            return false;
        }

        int $argc = \count($type->typeArgs);
        if ($argc === 0) {
            return true;
        }

        ?self $keyType = null;
        self $valueType;
        if ($argc === 1) {
            $valueType = self::unwrapNamed($type->typeArgs[0]);
        } else {
            $keyType = self::unwrapNamed($type->typeArgs[0]);
            $valueType = self::unwrapNamed($type->typeArgs[1]);
        }

        foreach ($value as $k => $v) {
            if ($keyType !== null && !self::is($k, $keyType)) {
                return false;
            }

            if (!self::is($v, $valueType)) {
                return false;
            }
        }

        return true;
    }

    private static function isStruct(mixed $value, self $type): bool
    {
        if (!\is_array($value)) {
            return false;
        }

        foreach ($type->structRequiredKeys as $key) {
            if (!\array_key_exists($key, $value)) {
                return false;
            }
        }

        foreach ($type->structFields as $key => $fieldType) {
            if (!\array_key_exists($key, $value)) {
                continue;
            }

            mixed $fieldValue = null;
            foreach ($value as $k => $v) {
                if ($k === $key) {
                    $fieldValue = $v;
                    break;
                }
            }

            if (!self::is($fieldValue, $fieldType)) {
                return false;
            }
        }

        return true;
    }

    /**
     * The value is an object that declares each listed public method and property.
     * Constructors are ignored. Extra members are ignored.
     * A method with a recorded signature also compares parameter count, parameter
     * types, optional and variadic flags, and the return type when one was recorded.
     */
    private static function isObjectShape(mixed $value, self $type): bool
    {
        if (!\is_object($value)) {
            return false;
        }

        try {
            \ReflectionObject $ref = new \ReflectionObject($value);
        } catch (\Throwable $e) {
            (void)$e;
            return false;
        }

        foreach ($type->objectShapeMethods as $methodName) {
            if (!self::objectShapeMethodMatches($ref, $methodName, $type)) {
                return false;
            }
        }

        foreach ($type->objectShapeProperties as $propertyName) {
            if (!self::objectHasPublicProperty($ref, $propertyName)) {
                return false;
            }
        }

        return true;
    }

    /**
     * Existence-only v1: the value is invokable. Signatures are not compared.
     */
    private static function isCallableShape(mixed $value, self $type): bool
    {
        (void)$type;
        return \is_callable($value);
    }

    private static function objectHasPublicMethod(\ReflectionObject $ref, string $name): bool
    {
        try {
            \ReflectionMethod $method = $ref->getMethod($name);
        } catch (\Throwable $e) {
            (void)$e;
            return false;
        }

        return $method->isPublic() && !$method->isConstructor();
    }

    private static function objectShapeMethodMatches(\ReflectionObject $ref, string $name, self $type): bool
    {
        if (!self::objectHasPublicMethod($ref, $name)) {
            return false;
        }

        if (!($type->objectShapeMethodSigned[$name] ?? false)) {
            return true;
        }

        try {
            \ReflectionMethod $method = $ref->getMethod($name);
        } catch (\Throwable $e) {
            (void)$e;
            return false;
        }

        if (!self::objectShapeParametersMatch($method, $type, $name)) {
            return false;
        }

        if (!($type->objectShapeHasReturn[$name] ?? false)) {
            return true;
        }

        ?self $expected = $type->objectShapeReturns[$name] ?? null;
        if ($expected === null) {
            return false;
        }

        return self::signatureTypeAccepts($expected, self::reflectionMethodReturnType($method));
    }

    private static function objectShapeParametersMatch(\ReflectionMethod $method, self $type, string $name): bool
    {
        array<int, string> $names = $type->objectShapeParamNames[$name] ?? [];
        array<int, self> $types = $type->objectShapeParamTypes[$name] ?? [];
        array<int, bool> $optional = $type->objectShapeParamOptional[$name] ?? [];
        array<int, bool> $variadic = $type->objectShapeParamVariadic[$name] ?? [];
        if (\count($names) !== \count($types)
            || \count($names) !== \count($optional)
            || \count($names) !== \count($variadic)) {
            return false;
        }

        array<int, \ReflectionParameter> $parameters = [];
        foreach ($method->getParameters() as $parameter) {
            $parameters[] = $parameter;
        }

        while (\count($parameters) > \count($names)) {
            \ReflectionParameter $last = $parameters[\count($parameters) - 1];
            if (!$last->isOptional()) {
                break;
            }

            (void)\array_pop($parameters);
        }

        if (\count($parameters) !== \count($names)) {
            return false;
        }

        foreach ($names as $index => $paramName) {
            (void)$paramName;
            \ReflectionParameter $parameter = $parameters[$index];
            bool $shapeVariadic = $variadic[$index] ?? false;
            bool $shapeOptional = $optional[$index] ?? false;
            if ($shapeVariadic && !$parameter->isVariadic()) {
                return false;
            }

            if ($shapeOptional && !$parameter->isOptional()) {
                return false;
            }

            self $shapeType = $types[$index] ?? self::scalar('mixed');
            self $methodType = self::reflectionParameterType($parameter, $method);
            if (!self::signatureTypeAccepts($methodType, $shapeType)) {
                return false;
            }
        }

        return true;
    }

    private static function reflectionMethodReturnType(\ReflectionMethod $method): self
    {
        ?\ReflectionType $returnType = $method->getReturnType();
        if ($returnType === null) {
            return self::scalar('mixed');
        }

        return self::fromReflectionType($returnType, $method->getDeclaringClass()->getName());
    }

    private static function reflectionParameterType(\ReflectionParameter $parameter, \ReflectionMethod $method): self
    {
        ?\ReflectionType $parameterType = $parameter->getType();
        if ($parameterType === null) {
            return self::scalar('mixed');
        }

        return self::fromReflectionType($parameterType, $method->getDeclaringClass()->getName());
    }

    /**
     * `$narrow` is acceptable where `$broad` is expected.
     * {@see compatible()} covers inheritance, nullable, and union types.
     * `int` satisfies `float`, and `object` satisfies class types, matching callable assignability.
     */
    private static function signatureTypeAccepts(self $broad, self $narrow): bool
    {
        self $broadType = self::unwrapNamed($broad)->ready();
        self $narrowType = self::unwrapNamed($narrow)->ready();
        if (self::compatible($broadType, $narrowType)) {
            return true;
        }

        if ($narrowType->isNullable && !$broadType->isNullable) {
            return false;
        }

        if ($broadType->kind === 'scalar' && $broadType->name === 'object') {
            return $narrowType->kind === 'class'
                || $narrowType->kind === 'generic'
                || $narrowType->kind === 'objectShape'
                || $narrowType->kind === 'intersection'
                || ($narrowType->kind === 'scalar' && $narrowType->name === 'object');
        }

        return $broadType->kind === 'scalar'
            && $broadType->name === 'float'
            && $narrowType->kind === 'scalar'
            && $narrowType->name === 'int';
    }

    private static function objectHasPublicProperty(\ReflectionObject $ref, string $name): bool
    {
        try {
            \ReflectionProperty $property = $ref->getProperty($name);
        } catch (\Throwable $e) {
            (void)$e;
            return false;
        }

        return $property->isPublic();
    }

    private static function unwrapNamed(self|NamedType $type): self
    {
        return $type instanceof NamedType ? $type->getUnderlyingType() : $type;
    }

    public static function compatible(TypeLike|string $broad, TypeLike|string $narrow): bool
    {
        if (!$broad instanceof self || !$narrow instanceof self) {
            self $resolvedBroad = $broad instanceof self ? $broad : self::requireType($broad);
            self $resolvedNarrow = $narrow instanceof self ? $narrow : self::requireType($narrow);

            return self::compatible($resolvedBroad, $resolvedNarrow);
        }

        if ($broad instanceof NamedType) {
            $broad = $broad->getUnderlyingType();
        }

        if ($narrow instanceof NamedType) {
            $narrow = $narrow->getUnderlyingType();
        }

        if ($broad->forward !== null || $broad->lazyInner !== null) {
            $broad = $broad->follow();
        }

        if ($narrow->forward !== null || $narrow->lazyInner !== null) {
            $narrow = $narrow->follow();
        }

        if ($broad->kind === 'scalar' && $broad->name === 'mixed') {
            return true;
        }

        if ($narrow->kind === 'scalar' && $narrow->name === 'never') {
            return true;
        }

        if ($narrow->isNullable && !$broad->isNullable) {
            return false;
        }

        if ($broad->kind === 'union') {
            return self::isCompatibleWithUnion($broad, $narrow);
        }

        if ($broad->kind === 'intersection') {
            return self::areIntersectionArgsCompatible($broad, $narrow);
        }

        if ($broad->kind === $narrow->kind && $broad->name === $narrow->name) {
            if ($broad->kind === 'generic') {
                return self::areGenericArgsCompatible($broad, $narrow);
            }

            return true;
        }

        if ($broad->kind === 'class' && $narrow->kind === 'class') {
            return self::namedTypeIsA($narrow->name ?? '', $broad->name ?? '');
        }

        return false;
    }

    private static function isCompatibleWithUnion(self $broad, self $narrow): bool
    {
        if ($narrow->kind === 'union') {
            foreach ($narrow->typeArgs as $narrowMember) {
                bool $found = false;

                foreach ($broad->typeArgs as $broadMember) {
                    if (self::compatible($broadMember, $narrowMember)) {
                        $found = true;
                        break;
                    }
                }

                if (!$found) {
                    return false;
                }
            }

            return true;
        }

        foreach ($broad->typeArgs as $broadMember) {
            if (self::compatible($broadMember, $narrow)) {
                return true;
            }
        }

        return false;
    }

    private static function areGenericArgsCompatible(self $broad, self $narrow): bool
    {
        if (\count($broad->typeArgs) !== \count($narrow->typeArgs)) {
            return false;
        }

        foreach ($broad->typeArgs as $i => $broadArg) {
            ?self $narrowArg = $narrow->typeArgs[$i] ?? null;

            if ($narrowArg === null) {
                return false;
            }

            self $broadType = $broadArg instanceof NamedType ? $broadArg->getUnderlyingType() : $broadArg;
            self $narrowType = $narrowArg instanceof NamedType ? $narrowArg->getUnderlyingType() : $narrowArg;

            if (!self::compatible($broadType, $narrowType)) {
                return false;
            }
        }

        return true;
    }

    private static function areIntersectionArgsCompatible(self $broad, self $narrow): bool
    {
        array<self|NamedType> $narrowMembers = $narrow->kind === 'intersection' ? $narrow->typeArgs : [$narrow];

        foreach ($broad->typeArgs as $broadMember) {
            bool $satisfied = false;

            foreach ($narrowMembers as $narrowMember) {
                if (self::compatible($broadMember, $narrowMember)) {
                    $satisfied = true;
                    break;
                }
            }

            if (!$satisfied) {
                return false;
            }
        }

        return true;
    }

    public function asReadOnly(): self
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return $this->follow()->asReadOnly();
        }

        if ($this->placeholder) {
            self $wrapper = new self('lazy', $this->name, declaredName: $this->declaredName);
            $wrapper->lazyInner = $this;
            $wrapper->lazyOp = 'readonly';

            return $wrapper;
        }

        if ($this->isReadOnly) {
            return $this;
        }

        self $target = $this->edited();
        $target->isReadOnly = true;

        return $target;
    }

    public function asNullable(): self
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return $this->follow()->asNullable();
        }

        if ($this->placeholder) {
            self $wrapper = new self('lazy', $this->name, declaredName: $this->declaredName);
            $wrapper->lazyInner = $this;
            $wrapper->lazyOp = 'nullable';

            return $wrapper;
        }

        if ($this->isNullable) {
            return $this;
        }

        if ($this->kind === 'scalar' && ($this->name === 'null' || $this->name === 'mixed')) {
            return $this;
        }

        self $target = $this->edited();
        $target->isNullable = true;

        return $target;
    }

    public function asNonNullable(): self
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return $this->follow()->asNonNullable();
        }

        if ($this->placeholder) {
            self $wrapper = new self('lazy', $this->name, declaredName: $this->declaredName);
            $wrapper->lazyInner = $this;
            $wrapper->lazyOp = 'nonNullable';

            return $wrapper;
        }

        if (!$this->isNullable) {
            return $this;
        }

        self $target = $this->edited();
        $target->isNullable = false;

        return $target;
    }

    public function genericParameter(string $name): ?NamedType
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return $this->follow()->genericParameter($name);
        }

        foreach ($this->typeArgs as $arg) {
            if ($arg instanceof NamedType && $arg->getParameterName() === $name) {
                return $arg;
            }
        }

        return null;
    }

    /**
     * Type arguments of a generic type, in order (`App\Table<App\Blog>` → `[App\Blog]`,
     * `array<string, int>` → `[string, int]`). Empty for every other kind.
     *
     * @return array<int, self>
     */
    public function typeArguments(): array<int, self>
    {
        self $current = $this->ready();
        if ($current->kind !== 'generic') {
            return [];
        }

        array<int, self> $arguments = [];
        foreach ($current->typeArgs as $arg) {
            $arguments[] = $arg instanceof NamedType ? $arg->getUnderlyingType() : $arg;
        }

        return $arguments;
    }

    /**
     * One type argument, by position or by parameter name (`TValue`, or the declared name
     * when the type was built with it). Null when there is no such argument.
     */
    public function typeArgument(int|string $position): ?self
    {
        if ($position is int) {
            return $this->typeArguments()[$position] ?? null;
        }

        return $this->genericParameter($position)?->getUnderlyingType();
    }

    /**
     * Value type of an `array` / `iterable` type: `V` for `array<V>` and `array<K, V>`,
     * `mixed` for a bare `array` / `iterable`. Null for every other kind.
     */
    public function elementType(): ?self
    {
        self $current = $this->ready();
        if (!$current->isArrayFamily()) {
            return null;
        }

        array<int, self> $arguments = $current->typeArguments();
        int $count = \count($arguments);

        return $count === 0 ? self::scalar('mixed') : $arguments[$count - 1];
    }

    /**
     * Key type of an `array` / `iterable` type: `K` for `array<K, V>`, `int|string` otherwise.
     * Null for every other kind.
     */
    public function keyType(): ?self
    {
        self $current = $this->ready();
        if (!$current->isArrayFamily()) {
            return null;
        }

        array<int, self> $arguments = $current->typeArguments();

        return \count($arguments) === 2
            ? $arguments[0]
            : self::union(self::scalar('int'), self::scalar('string'));
    }

    /**
     * Declared type of field `$name` on a struct type. Null for a missing field or another kind.
     */
    public function fieldType(int|string $name): ?self
    {
        self $current = $this->ready();
        if ($current->kind !== 'struct') {
            return null;
        }

        return $current->structFields[$name] ?? null;
    }

    /**
     * The type PHP can declare for this type: type arguments are dropped (`array<App\Post>` →
     * `array`, `App\Table<App\Blog>` → `App\Table`), structs are `array`, object shapes are
     * `object`, callable shapes are `callable`. Nullability is kept.
     */
    public function erased(): self
    {
        self $current = $this->ready();
        if ($current instanceof NamedType) {
            return $current->getUnderlyingType()->erased();
        }

        self $result = match ($current->kind) {
            'generic' => $current->isArrayFamily()
                ? self::scalar($current->name ?? 'array')
                : self::fromClassName($current->name ?? 'object'),
            'struct' => self::scalar('array'),
            'objectShape' => self::scalar('object'),
            'callableShape' => self::scalar('callable'),
            'union', 'intersection' => self::erasedComposite($current),
            default => $current,
        };

        if ($current->isNullable && !$result->isNullable()) {
            return $result->asNullable();
        }

        return $result;
    }

    private static function erasedComposite(self $type): self
    {
        array<int, self> $members = [];
        foreach ($type->typeArgs as $member) {
            self $erasedMember = ($member instanceof NamedType ? $member->getUnderlyingType() : $member)
                ->erased();
            foreach ($members as $existing) {
                if ((string)$existing === (string)$erasedMember) {
                    continue 2;
                }
            }

            $members[] = $erasedMember;
        }

        if (\count($members) === 1) {
            return $members[0];
        }

        return $type->kind === 'intersection'
            ? self::intersection(...$members)
            : self::union(...$members);
    }

    private function isArrayFamily(): bool
    {
        if ($this->kind === 'scalar' || $this->kind === 'generic') {
            return $this->name === 'array' || $this->name === 'iterable';
        }

        return false;
    }

    public function getKind(): string
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return $this->follow()->getKind();
        }

        return $this->kind;
    }

    public function getName(): ?string
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return $this->follow()->getName();
        }

        return $this->declaredName ?? $this->name;
    }

    public function isNullable(): bool
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return $this->follow()->isNullable();
        }

        return $this->isNullable;
    }

    public function isReadOnly(): bool
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return $this->follow()->isReadOnly();
        }

        return $this->isReadOnly;
    }

    public function __toString(): string
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return (string) $this->follow();
        }

        string $str = match ($this->kind) {
            'scalar' => $this->name ?? 'unknown',
            'class' => $this->name ?? 'object',
            'generic' => ($this->name ?? 'object')
                . '<' . \implode(', ', \array_map(\strval(...), $this->typeArgs)) . '>',
            'union' => \implode('|', \array_map(\strval(...), $this->typeArgs)),
            'intersection' => \implode('&', \array_map(\strval(...), $this->typeArgs)),
            'struct' => 'struct ' . ($this->name ?? 'anonymous'),
            'objectShape' => 'object ' . ($this->name ?? '{…}'),
            'callableShape' => 'callable ' . ($this->name ?? '{…}'),
            default => 'unknown',
        };

        if ($this->isNullable) {
            if ($this->kind === 'union') {
                $str .= '|null';
            } elseif ($this->kind !== 'scalar' || $this->name !== 'null') {
                $str = '?' . $str;
            }
        }

        return $str;
    }

    private function ready(): self
    {
        if ($this->forward !== null || $this->lazyInner !== null) {
            return $this->follow();
        }

        return $this;
    }

    private function edited(): self
    {
        if ($this->immutable) {
            return $this->duplicate();
        }

        $this->modifyInPlace();

        return $this;
    }

    private function duplicate(): self
    {
        return new self(
            $this->kind,
            $this->name,
            $this->typeArgs,
            $this->isReadOnly,
            $this->isNullable,
            $this->structFields,
            $this->structRequiredKeys,
            $this->objectShapeMethods,
            $this->objectShapeProperties,
            $this->declaredName,
            $this->objectShapeMethodSigned,
            $this->objectShapeParamNames,
            $this->objectShapeParamTypes,
            $this->objectShapeParamOptional,
            $this->objectShapeParamVariadic,
            $this->objectShapeReturns,
            $this->objectShapeHasReturn,
            $this->objectShapeOpenMethod,
        );
    }

    private function keepsDiscriminant(): bool
    {
        return $this->kind === 'scalar'
            || $this->kind === 'class'
            || $this->kind === 'generic';
    }

    /**
     * In-place change that does not return a replacement. Immutable instances throw.
     */
    private function modifyInPlace(): void
    {
        if ($this->immutable) {
            throw new Exceptions\InvalidTypeException('Cannot modify an immutable type.');
        }
    }

    private function linkForward(self $resolved): void
    {
        $this->modifyInPlace();
        $this->forward = $resolved;
    }

    private function follow(): self
    {
        if ($this->resolving) {
            return $this;
        }

        if ($this->forward !== null) {
            $this->resolving = true;
            self $next = $this->forward;
            $this->resolving = false;
            if ($next === $this) {
                return $this;
            }

            return $next->follow();
        }

        if ($this->lazyInner !== null) {
            $this->resolving = true;
            self $inner = $this->lazyInner->follow();
            self $applied = match ($this->lazyOp) {
                'nullable' => $inner->asNullable(),
                'readonly' => $inner->asReadOnly(),
                'nonNullable' => $inner->asNonNullable(),
                'name' => $inner->name($this->lazyName ?? ''),
                default => $inner,
            };
            $this->forward = $applied;
            $this->resolving = false;

            return $applied;
        }

        return $this;
    }

    private function putStructField(int|string $name, self $type, bool $required): self
    {
        self $target = $this->edited();
        array<int|string, self> $fields = $target->structFields;
        $fields[$name] = $type;
        $target->structFields = $fields;

        array<int, int|string> $keys = [];
        foreach ($target->structRequiredKeys as $key) {
            if ($key !== $name) {
                $keys[] = $key;
            }
        }
        if ($required) {
            $keys[] = $name;
        }
        $target->structRequiredKeys = $keys;

        return $target;
    }

    private function appendMember(self $member): void
    {
        $this->modifyInPlace();
        foreach ($this->typeArgs as $existing) {
            if ($existing === $member) {
                return;
            }
        }

        array<self|NamedType> $args = $this->typeArgs;
        $args[] = $member;
        $this->typeArgs = $args;
    }

    private static function findCached(string $name, array<int, self> $generics): ?self
    {
        if (!\array_key_exists($name, self::$cachedTypes)) {
            return null;
        }

        foreach (self::$cachedTypes[$name] as $index => $type) {
            array<int, self> $cachedArgs = self::$cachedGenerics[$name][$index] ?? [];
            if (self::sameGenericList($cachedArgs, $generics)) {
                return $type;
            }
        }

        return null;
    }

    private static function storeCache(string $name, array<int, self> $generics, self $type): void
    {
        if (!\array_key_exists($name, self::$cachedTypes)) {
            self::$cachedTypes[$name] = [];
            self::$cachedGenerics[$name] = [];
        }

        self::$cachedTypes[$name][] = $type;
        self::$cachedGenerics[$name][] = $generics;
    }

    private static function replaceCache(string $name, array<int, self> $generics, self $type): void
    {
        if (!\array_key_exists($name, self::$cachedTypes)) {
            self::storeCache($name, $generics, $type);

            return;
        }

        foreach (self::$cachedTypes[$name] as $index => $cached) {
            (void) $cached;
            array<int, self> $cachedArgs = self::$cachedGenerics[$name][$index] ?? [];
            if (self::sameGenericList($cachedArgs, $generics)) {
                self::$cachedTypes[$name][$index] = $type;

                return;
            }
        }

        self::storeCache($name, $generics, $type);
    }

    private static function sameGenericList(array<int, self> $left, array<int, self> $right): bool
    {
        if (\count($left) !== \count($right)) {
            return false;
        }

        foreach ($left as $index => $type) {
            ?self $other = $right[$index] ?? null;
            if ($other === null || !$type->sameStructure($other)) {
                return false;
            }
        }

        return true;
    }

    private function sameStructure(self $other, int $depth = 0): bool
    {
        if ($depth > 32) {
            return $this->ready() === $other->ready();
        }

        self $left = $this->ready();
        self $right = $other->ready();
        if ($left === $right) {
            return true;
        }

        if ($left instanceof NamedType || $right instanceof NamedType) {
            self $leftType = $left instanceof NamedType ? $left->getUnderlyingType() : $left;
            self $rightType = $right instanceof NamedType ? $right->getUnderlyingType() : $right;

            return $leftType->sameStructure($rightType, $depth + 1);
        }

        if ($left->kind !== $right->kind || $left->name !== $right->name) {
            return false;
        }

        if ($left->isNullable !== $right->isNullable || $left->isReadOnly !== $right->isReadOnly) {
            return false;
        }

        if ($left->declaredName !== $right->declaredName) {
            return false;
        }

        if (\count($left->typeArgs) !== \count($right->typeArgs)) {
            return false;
        }

        foreach ($left->typeArgs as $index => $arg) {
            ?self $otherArg = $right->typeArgs[$index] ?? null;
            if (!$arg instanceof self || $otherArg === null || !$arg->sameStructure($otherArg, $depth + 1)) {
                return false;
            }
        }

        if (\count($left->structFields) !== \count($right->structFields)) {
            return false;
        }

        foreach ($left->structFields as $key => $fieldType) {
            if (!\array_key_exists($key, $right->structFields)) {
                return false;
            }

            if (!$fieldType->sameStructure($right->structFields[$key], $depth + 1)) {
                return false;
            }
        }

        if (\count($left->structRequiredKeys) !== \count($right->structRequiredKeys)) {
            return false;
        }

        foreach ($left->structRequiredKeys as $key) {
            if (!\in_array($key, $right->structRequiredKeys, true)) {
                return false;
            }
        }

        return $left->objectShapeMethods === $right->objectShapeMethods
            && $left->objectShapeProperties === $right->objectShapeProperties
            && $left->sameMethodSignatures($right, $depth);
    }

    private function sameMethodSignatures(self $other, int $depth): bool
    {
        if (\count($this->objectShapeMethodSigned) !== \count($other->objectShapeMethodSigned)) {
            return false;
        }

        foreach ($this->objectShapeMethodSigned as $name => $signed) {
            if (!\array_key_exists($name, $other->objectShapeMethodSigned)
                || $other->objectShapeMethodSigned[$name] !== $signed) {
                return false;
            }

            array<int, string> $leftNames = $this->objectShapeParamNames[$name] ?? [];
            array<int, string> $rightNames = $other->objectShapeParamNames[$name] ?? [];
            if ($leftNames !== $rightNames) {
                return false;
            }

            array<int, bool> $leftOptional = $this->objectShapeParamOptional[$name] ?? [];
            array<int, bool> $rightOptional = $other->objectShapeParamOptional[$name] ?? [];
            if ($leftOptional !== $rightOptional) {
                return false;
            }

            array<int, bool> $leftVariadic = $this->objectShapeParamVariadic[$name] ?? [];
            array<int, bool> $rightVariadic = $other->objectShapeParamVariadic[$name] ?? [];
            if ($leftVariadic !== $rightVariadic) {
                return false;
            }

            bool $leftHasReturn = $this->objectShapeHasReturn[$name] ?? false;
            bool $rightHasReturn = $other->objectShapeHasReturn[$name] ?? false;
            if ($leftHasReturn !== $rightHasReturn) {
                return false;
            }

            if ($leftHasReturn) {
                ?self $leftReturn = $this->objectShapeReturns[$name] ?? null;
                ?self $rightReturn = $other->objectShapeReturns[$name] ?? null;
                if ($leftReturn === null || $rightReturn === null
                    || !$leftReturn->sameStructure($rightReturn, $depth + 1)) {
                    return false;
                }
            }

            array<int, self> $leftTypes = $this->objectShapeParamTypes[$name] ?? [];
            array<int, self> $rightTypes = $other->objectShapeParamTypes[$name] ?? [];
            if (\count($leftTypes) !== \count($rightTypes)) {
                return false;
            }

            foreach ($leftTypes as $index => $leftType) {
                ?self $rightType = $rightTypes[$index] ?? null;
                if ($rightType === null || !$leftType->sameStructure($rightType, $depth + 1)) {
                    return false;
                }
            }
        }

        return true;
    }

    private function putObjectShapeParam(string $name, self $type, bool $optional, bool $variadic): self
    {
        self $target = $this->edited();
        string $method = $target->openShapeMethodName();

        array<string, array<int, string>> $names = $target->objectShapeParamNames;
        array<int, string> $methodNames = $names[$method] ?? [];
        $methodNames[] = $name;
        $names[$method] = $methodNames;
        $target->objectShapeParamNames = $names;

        array<string, array<int, self>> $types = $target->objectShapeParamTypes;
        array<int, self> $methodTypes = $types[$method] ?? [];
        $methodTypes[] = $type;
        $types[$method] = $methodTypes;
        $target->objectShapeParamTypes = $types;

        array<string, array<int, bool>> $optionalFlags = $target->objectShapeParamOptional;
        array<int, bool> $methodOptional = $optionalFlags[$method] ?? [];
        $methodOptional[] = $optional;
        $optionalFlags[$method] = $methodOptional;
        $target->objectShapeParamOptional = $optionalFlags;

        array<string, array<int, bool>> $variadicFlags = $target->objectShapeParamVariadic;
        array<int, bool> $methodVariadic = $variadicFlags[$method] ?? [];
        $methodVariadic[] = $variadic;
        $variadicFlags[$method] = $methodVariadic;
        $target->objectShapeParamVariadic = $variadicFlags;

        return $target;
    }

    private function putObjectShapeReturn(self $type): self
    {
        self $target = $this->edited();
        string $method = $target->openShapeMethodName();

        array<string, self> $returns = $target->objectShapeReturns;
        $returns[$method] = $type;
        $target->objectShapeReturns = $returns;

        array<string, bool> $hasReturn = $target->objectShapeHasReturn;
        $hasReturn[$method] = true;
        $target->objectShapeHasReturn = $hasReturn;

        return $target;
    }

    private function openShapeMethodName(): string
    {
        ?string $name = $this->objectShapeOpenMethod;
        if ($name === null || $name === '') {
            throw new Exceptions\InvalidTypeException(
                'param() and returns() require method() on this object shape.',
            );
        }

        if (!($this->objectShapeMethodSigned[$name] ?? false)) {
            array<string, bool> $signed = $this->objectShapeMethodSigned;
            $signed[$name] = true;
            $this->objectShapeMethodSigned = $signed;
        }

        return $name;
    }

    private static function requireType(TypeLike|string $type): self
    {
        ?self $resolved = self::arg($type);
        if ($resolved === null) {
            throw new Exceptions\InvalidTypeException('A type argument is required.');
        }

        return $resolved;
    }

    private static function optionalType(self $inner): self
    {
        if ($inner->getKind() === 'optional') {
            return $inner;
        }

        return new self('optional', null, [$inner]);
    }

    /**
     * @param array<int|string, TypeLike|string> $fields
     * @param array<int, int|string>|null $requiredKeys
     */
    private static function structFromFields(
        ?string $name,
        array<int|string, TypeLike|string> $fields,
        ?array<int, int|string> $requiredKeys,
    ): self {
        array<int|string, self> $normalized = [];
        array<int, int|string> $optionalKeys = [];
        foreach ($fields as $key => $field) {
            bool $optional = false;
            self $fieldType = self::structFieldType($field, $optional);
            $normalized[$key] = $fieldType;
            if ($optional) {
                $optionalKeys[] = $key;
            }
        }

        array<int, int|string> $required = [];
        if ($requiredKeys !== null) {
            $required = $requiredKeys;
        } else {
            foreach ($normalized as $key => $fieldType) {
                (void) $fieldType;
                if (!\in_array($key, $optionalKeys, true)) {
                    $required[] = $key;
                }
            }
        }

        return new self('struct', $name, [], false, false, $normalized, $required);
    }

    private static function structFieldType(TypeLike|string $field, bool &$optional): self
    {
        if ($field instanceof self && $field->getKind() === 'optional') {
            $optional = true;
            self|NamedType|null $inner = $field->typeArgs[0] ?? null;
            if ($inner instanceof NamedType) {
                return $inner->getUnderlyingType();
            }

            if ($inner instanceof self) {
                return $inner;
            }

            return self::scalar('mixed');
        }

        $optional = false;

        return self::requireType($field);
    }

    private static function asNamedArgument(TypeLike|string $param, string $declaredName): NamedType
    {
        if ($param instanceof NamedType) {
            return $param;
        }

        return new NamedType($declaredName, self::requireType($param));
    }

    /**
     * Declared type-parameter names, in order. Null when the class has no schema
     * (a plain PHP class, or a name that is not loaded): callers are positional only.
     *
     * @return array<int, string>|null
     */
    private static function declaredGenericNames(string $className, int $supplied): ?array<int, string>
    {
        string $lower = \strtolower($className);
        if ($lower === 'array' || $lower === 'iterable') {
            if ($supplied === 1) {
                return ['TValue'];
            }

            return ['TKey', 'TValue'];
        }

        if (!\class_exists($className) && !\interface_exists($className) && !\enum_exists($className)) {
            return null;
        }

        ?array<int, string> $layout2 = self::layout2ParameterNames($className);
        if ($layout2 !== null) {
            return $layout2;
        }

        return self::layout1ParameterNames($className);
    }

    /**
     * Parameter names of a layout-2 `new` binder, when that method is stamped.
     *
     * @return array<int, string>|null
     */
    private static function layout2ParameterNames(string $className): ?array<int, string>
    {
        if (!\method_exists($className, 'new')) {
            return null;
        }

        \ReflectionMethod $method = new \ReflectionMethod($className, 'new');
        if (!$method->isStatic()) {
            return null;
        }

        ?GenericRuntime $info = self::genericRuntimeAttribute($method->getAttributes(GenericRuntime::class));
        if ($info === null || !\in_array(2, $info->layouts, true)) {
            return null;
        }

        array<int, string> $names = [];
        foreach ($method->getParameters() as $parameter) {
            // A trailing variadic only lets a child with fewer type parameters override the
            // parent's method; it is not a type parameter.
            if ($parameter->isVariadic()) {
                break;
            }

            $names[] = $parameter->getName();
        }

        return $names;
    }

    /**
     * Names from a layout-1 factory's `$__generic_*` parameters.
     *
     * @return array<int, string>|null
     */
    private static function layout1ParameterNames(string $className): ?array<int, string>
    {
        \ReflectionClass<object> $class = new \ReflectionClass($className);
        ?GenericRuntime $info = self::genericRuntimeAttribute($class->getAttributes(GenericRuntime::class));
        if ($info === null) {
            return null;
        }

        ?string $factory = $info->factory;
        if ($factory === null || $factory === '' || !\method_exists($className, $factory)) {
            return null;
        }

        \ReflectionMethod $method = new \ReflectionMethod($className, $factory);
        array<int, string> $names = [];
        foreach ($method->getParameters() as $parameter) {
            string $parameterName = $parameter->getName();
            if (\str_starts_with($parameterName, '__generic_')) {
                $names[] = \substr($parameterName, \strlen('__generic_'));
            }
        }

        if ($names === []) {
            return null;
        }

        return $names;
    }

    /**
     * @param array<int, \ReflectionAttribute<GenericRuntime>> $attributes
     */
    private static function genericRuntimeAttribute(array<int, \ReflectionAttribute<GenericRuntime>> $attributes): ?GenericRuntime
    {
        foreach ($attributes as $attribute) {
            object $instance = $attribute->newInstance();
            if ($instance instanceof GenericRuntime) {
                return $instance;
            }
        }

        return null;
    }

    /// Build the `Type` `typeParse` would have described. `$node` is one graph object.
    private static function typeFromExtGraph(\Tyhp\ExtParseNode $node): self
    {
        bool $nullable = $node->nullable;
        self $type;
        if ($node->kind === 'scalar') {
            $type = self::scalar($node->name);
        } elseif ($node->kind === 'class') {
            $type = self::fromClassName($node->name);
        } elseif ($node->kind === 'generic') {
            $type = self::genericFromExtArgs($node->name, $node->args);
        } elseif ($node->kind === 'unresolved') {
            if ($node->form === 'name') {
                array<int, self> $args = [];
                foreach ($node->args as $arg) {
                    $args[] = self::typeFromExtGraph($arg->type);
                }
                $type = self::unresolvedFromExtArgs($node->name, $node->form, $args);
            } else {
                array<int, self> $args = [];
                foreach ($node->args as $arg) {
                    $args[] = self::typeFromExtGraph($arg);
                }
                $type = self::unresolvedFromExtArgs($node->name, $node->form, $args);
            }
        } elseif ($node->kind === 'union' || $node->kind === 'intersection') {
            $type = self::comboFromExtMembers($node->kind, $node->members);
        } else {
            throw new Exceptions\InvalidTypeException(
                'Unknown type node "' . $node->kind . '".',
            );
        }

        return $nullable ? $type->asNullable() : $type;
    }

    /**
     * @param array<int, \Tyhp\ExtParseArg> $arguments
     */
    private static function genericFromExtArgs(string $name, array<int, \Tyhp\ExtParseArg> $arguments): self
    {
        array<int, self> $args = [];
        foreach ($arguments as $arg) {
            $args[] = self::typeFromExtGraph($arg->type);
        }

        int $count = \count($args);
        if ($name === 'array') {
            if ($count === 1) {
                return self::listOf($args[0]);
            }

            if ($count === 2) {
                return self::mapOf($args[0], $args[1]);
            }
        }

        if ($name === 'iterable' && ($count === 1 || $count === 2)) {
            if ($count === 1) {
                return self::generic('iterable', new NamedType('TValue', $args[0]));
            }

            return self::generic(
                'iterable',
                new NamedType('TKey', $args[0]),
                new NamedType('TValue', $args[1]),
            );
        }

        throw new Exceptions\InvalidTypeException(
            'Type "' . $name . '" takes at most two type arguments.',
        );
    }

    /**
     * @param array<int, self> $args
     */
    private static function unresolvedFromExtArgs(string $name, string $form, array<int, self> $args): self
    {
        if (\array_key_exists($name, self::$registry)) {
            try {
                return self::ref($name, ...$args);
            } catch (\Throwable $e) {
                if ($e instanceof Exceptions\InvalidTypeException) {
                    self::$extRefFailure = $e;
                }

                throw $e;
            }
        }

        if ($form === 'struct') {
            return self::struct($name);
        }

        if ($form === 'object') {
            return self::shape($name);
        }

        if ($form === 'callable') {
            return self::callableShape($name);
        }

        if (\count($args) === 0) {
            return self::fromClassName($name);
        }

        array<int, NamedType> $named = [];
        foreach ($args as $index => $arg) {
            $named[] = new NamedType('T' . (string) $index, $arg);
        }

        return self::generic($name, ...$named);
    }

    /**
     * @param array<int, \Tyhp\ExtParseNode> $members
     */
    private static function comboFromExtMembers(string $kind, array<int, \Tyhp\ExtParseNode> $members): self
    {
        array<int, self> $types = [];
        foreach ($members as $member) {
            $types[] = self::typeFromExtGraph($member);
        }

        if ($kind === 'intersection') {
            return self::intersection(...$types);
        }

        return self::union(...$types);
    }
}
