<?tyhp

namespace Tyhp;

/**
 * On a generic function or method, every type parameter is inferred from the
 * arguments. The declared name keeps the value signature. A call that passes
 * type arguments, and `Generic::bind`, uses the companion.
 */
#[\Attribute(\Attribute::TARGET_METHOD | \Attribute::TARGET_FUNCTION)]
final class InferGeneric
{
    public function __construct(): void {}
}
