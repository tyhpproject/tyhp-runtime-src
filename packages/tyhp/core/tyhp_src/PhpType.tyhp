<?tyhp

namespace Tyhp;

/**
 * Compile-time PHP signature hint. The constructor argument is a PHP type-hint spelling
 * (for example `"mixed"`, `"int"`, `"string|int"`). Checker types are unchanged.
 *
 * Replaces the emitted PHP type of the declaration it sits on:
 * parameter, function/method **return**, property, or typed constant.
 *
 * Usages of this attribute and this class declaration are omitted from emitted PHP
 * (`#[\Tyhp\NoEmit]`).
 */
#[\Attribute(\Attribute::TARGET_ALL & ~\Attribute::TARGET_CLASS)]
#[\Tyhp\NoEmit()]
final class PhpType
{
    public function __construct(
        public readonly string $type,
    ): void {}
}
