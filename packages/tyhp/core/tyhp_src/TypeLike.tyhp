<?tyhp

namespace Tyhp;

/**
 * A type a runtime API can accept without first calling {@see Type::parse()}.
 *
 * `Type` and {@see BuiltIn} implement this. A class, interface, or enum name is a
 * separate `string` argument on those APIs. A type spelling such as `array<int>`
 * is {@see Type::parse()}.
 */
interface TypeLike {
    public function toType(): Type;

    public function or(TypeLike|string ...$others): Type;
}
