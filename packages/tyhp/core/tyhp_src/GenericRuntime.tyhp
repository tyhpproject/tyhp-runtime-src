<?tyhp

namespace Tyhp;

/**
 * Runtime-visible stamp on a compiled-library generic class, method, or function.
 *
 * Present on every emitted generic declaration (erased or tracked). `factory`,
 * `binder`, and `aliasFactory` are set when the declaration is tracked
 * (`erased: false`). PHP builtin and overlay tyhpdefs that omit this attribute
 * keep erase / inline emit.
 *
 * A non-erased method or function without `#[\Tyhp\InferGeneric]` is emitted
 * under its declared name. `layouts` is `[2]` and `binder` is that name
 * (`decode`). PHP calls `Json::decode($type)($json)`. `#[\Tyhp\InferGeneric]`
 * keeps the plain method and a `name__tyhpGeneric` companion stamped
 * `layouts: [1]` (`proxy__tyhpGeneric`). An erased generic stays a plain
 * method, `layouts: [1]`, with no companion. Class factories stay layout 1
 * (`new_Ns_Box__tyhpGeneric`). Supported callable layouts are `[1, 2]`.
 * `\Tyhp\Generic::bind` accepts layouts 1 and 2.
 *
 * Named arguments:
 * - `erased:` no factory / binder was emitted
 * - `binder:` declared name (`decode`) or a `name__tyhpGeneric` companion
 * - `factory:` class factory (`new_Ns_Box__tyhpGeneric`), layout 1
 * - `aliasFactory:` source type-alias `\Tyhp\Type` factory (`DecimalCoercible` or `UserService::NameType`)
 * - `layouts:` `[1]` or `[2]`
 * - `compiler:` optional compiler version for diagnostics only (not dispatch)
 *
 * Sit this attribute on the declaration, not on `<T>`. Authors do not write this
 * attribute; the compiler restamps it. `\Tyhp\Generic::bind` reads it at runtime.
 */
#[\Attribute(\Attribute::TARGET_ALL)]
final class GenericRuntime
{
    public function __construct(
        public readonly bool $erased = false,
        public readonly ?string $binder = null,
        public readonly ?string $factory = null,
        public readonly ?string $aliasFactory = null,
        public readonly array<int> $layouts = [1],
        public readonly ?string $compiler = null,
    ): void {}
}
