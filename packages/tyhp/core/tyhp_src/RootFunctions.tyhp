<?tyhp

/**
 * Binds type arguments to a generic class or callable.
 *
 * Root-function spelling of {@see \Tyhp\Generic::bind()}. Same signature: a class-string
 * returns a binder whose `new()` / call runs the constructor, and a callable returns
 * the closure with those type arguments applied. Does not construct. Each type argument
 * is a `\Tyhp\Type`, a `\Tyhp\TypeLike` (such as the `\Tyhp\Type::int` constant), a
 * class-string, or `null`. `\Tyhp\Type::arg()` normalizes it.
 *
 *     $box = _gnrc(Box::class, \Tyhp\Type::int)->new(42);
 *
 * Skipped when a global `_gnrc` already exists.
 */
fallback function _gnrc(mixed $target, \Tyhp\TypeLike|string|null ...$typeArguments): mixed
{
    return \Tyhp\Generic::bind($target, ...$typeArguments);
}
