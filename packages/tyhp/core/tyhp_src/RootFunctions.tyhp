<?tyhp

/**
 * Binds type arguments to a generic class or callable.
 *
 * Root-function spelling of {@see \Tyhp\Generic::bind()}. Same signature: a class-string
 * returns a binder whose `new()` / call runs the constructor, and a callable returns
 * the closure with those type arguments applied. Does not construct.
 *
 *     $box = gnrc(Box::class, \Tyhp\Type::int())->new(42);
 *
 * Skipped when a global `gnrc` already exists.
 */
fallback function _gnrc(mixed $target, ?\Tyhp\Type ...$typeArguments): mixed
{
    return \Tyhp\Generic::bind($target, ...$typeArguments);
}
