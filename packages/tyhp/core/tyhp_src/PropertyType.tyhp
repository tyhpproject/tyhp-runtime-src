<?tyhp

namespace Tyhp;

/**
 * Runtime-visible declared Tyhp type of a property or promoted constructor parameter.
 *
 * The compiler stamps it only when the PHP type hint loses information: generic type
 * arguments (`array<App\Post>`, `App\Table<App\Blog>`), struct types (`struct App\Address`),
 * and source type aliases (`App\UserId`). `$type` uses the spelling {@see Type::parse()}
 * reads. Read it with {@see Type::fromProperty()}, which falls back to the reflected PHP
 * type when the stamp is absent.
 *
 * The compiler writes this attribute. One written in source is replaced by the compiler's stamp,
 * or dropped when the PHP hint already carries the full type.
 */
#[\Attribute(\Attribute::TARGET_PROPERTY | \Attribute::TARGET_PARAMETER)]
final class PropertyType
{
    public function __construct(
        public readonly string $type,
    ): void {}
}
