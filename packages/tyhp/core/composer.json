{
  "name": "tyhp/core",
  "description": "Tyhp runtime core — type system, generics, typed variables, property accessors, scalar extension methods",
  "type": "composer-plugin",
  "license": "Apache-2.0",
  "version": "0.4",
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "require": {
        "tyhpdef/php": "@dev"
      },
      "package": {
        "include": [
          "./package.tyhpdef"
        ],
        "exclude": [],
        "overlay": [],
        "source": {
          "tagless": false
        }
      }
    },
    "class": "Tyhp\\Composer\\Plugin"
  },
  "require": {
    "php": ">=8.2",
    "composer-plugin-api": "^2.3"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/php-ext-mbstring": "@dev",
    "tyhpdef/php-ext-tyhp": "@dev",
    "tyhp/compiler": "@dev"
  },
  "suggest": {
    "ext-mbstring": "Unicode-aware string methods (length, substring, toUpper, \u2026); byte APIs are used when missing",
    "ext-tyhp": "Faster Type::is, Type::parse, and Generic::bind. Install with: pie install tyhp/ext-tyhp"
  },
  "autoload": {
    "psr-4": {
      "Tyhp\\": "src/Tyhp/",
      "Tyhp\\Composer\\": "plugin/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tyhp\\Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../tyhpdef/php"
    },
    {
      "type": "path",
      "url": "../compiler"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-mbstring"
    },
    {
      "type": "path",
      "url": "../../tyhpdef/php-ext-tyhp"
    }
  ],
  "config": {
    "allow-plugins": {
      "tyhp/core": true
    }
  }
}
