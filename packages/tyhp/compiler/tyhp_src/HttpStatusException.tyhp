<?tyhp

namespace Tyhp\Compiler;

/**
 * Thrown by {@see HttpClient} implementations for a response outside 200–299.
 * The code is the HTTP status.
 */
final class HttpStatusException extends \RuntimeException
{
    public function __construct(
        public readonly int $status,
        public readonly string $url,
        public readonly string $body = '',
    ) : parent(
        "HTTP {$status} from {$url}" . ($body !== '' ? ': ' . \substr($body, 0, 200) : '.'),
        $status,
    ) {}
}
