<?tyhp

namespace Tyhp\Compiler;

/**
 * Host OS/arch and GitHub Release asset names from scripts/release.sh EXPECTED_ASSETS
 * (same matrix as scripts/install.sh / scripts/install.ps1).
 */
final class Platform
{
    public function __construct(
        public readonly string $os,
        public readonly string $arch,
    ) {
        if (!\in_array($os, ['osx', 'linux', 'win'], true)) {
            throw new \InvalidArgumentException("Unsupported OS id: {$os}");
        }
        if (!\in_array($arch, ['x64', 'arm64'], true)) {
            throw new \InvalidArgumentException("Unsupported architecture id: {$arch}");
        }
        if ($os === 'win' && $arch === 'arm64') {
            throw new \RuntimeException(
                'Tyhp CLI has no GitHub Release asset for win/arm64. ' .
                'Supported assets: tyhp-osx-arm64, tyhp-osx-x64, tyhp-linux-x64, tyhp-linux-arm64, tyhp-win-x64.exe ' .
                '(and matching -fxdependent variants).'
            );
        }
    }

    public static function detect(?string $osFamily = null, ?string $machine = null): self
    {
        $osFamily ??= \PHP_OS_FAMILY;
        $machine ??= \php_uname('m');

        $os = match ($osFamily) {
            'Darwin' => 'osx',
            'Linux' => 'linux',
            'Windows' => 'win',
            default => throw new \RuntimeException(
                "Tyhp CLI has no GitHub Release asset for {$osFamily}/{$machine}. " .
                'Supported assets: tyhp-osx-arm64, tyhp-osx-x64, tyhp-linux-x64, tyhp-linux-arm64, tyhp-win-x64.exe ' .
                '(and matching -fxdependent variants).'
            ),
        };

        $normalized = \strtolower($machine);
        $arch = match (true) {
            $normalized === 'x86_64', $normalized === 'amd64' => 'x64',
            $normalized === 'arm64', $normalized === 'aarch64' => 'arm64',
            default => throw new \RuntimeException(
                "Tyhp CLI has no GitHub Release asset for {$osFamily}/{$machine}. " .
                'Supported assets: tyhp-osx-arm64, tyhp-osx-x64, tyhp-linux-x64, tyhp-linux-arm64, tyhp-win-x64.exe ' .
                '(and matching -fxdependent variants).'
            ),
        };

        return new self($os, $arch);
    }

    /**
     * Self-contained: `tyhp-{os}-{arch}` (Windows adds `.exe`).
     * Framework-dependent: same with `-fxdependent` before the optional `.exe`.
     */
    public function releaseAssetName(string $variant): string
    {
        $id = $this->os . '-' . $this->arch;
        $suffix = $variant === 'framework-dependent' ? '-fxdependent' : '';
        if ($this->os === 'win') {
            return "tyhp-{$id}{$suffix}.exe";
        }

        return "tyhp-{$id}{$suffix}";
    }

    public function binaryFileName(): string
    {
        return $this->os === 'win' ? 'tyhp.exe' : 'tyhp';
    }
}
