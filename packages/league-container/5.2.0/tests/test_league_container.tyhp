<?tyhp

function test_league_container_new(): \Psr\Container\ContainerInterface
{
    return new \League\Container\Container();
}

function test_league_container_add(\League\Container\Container $c): \League\Container\Definition\DefinitionInterface
{
    return $c->add(\stdClass::class, static fn (): \stdClass => new \stdClass());
}

function test_league_container_get(\League\Container\Container $c): \stdClass
{
    return $c->get(\stdClass::class);
}

function test_league_container_has(\League\Container\Container $c): bool
{
    return $c->has(\stdClass::class);
}
