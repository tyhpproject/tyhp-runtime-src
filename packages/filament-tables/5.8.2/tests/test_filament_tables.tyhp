<?tyhp

function test_tables_icon_alias_filter(): string
{
    return \Filament\Tables\View\TablesIconAlias::ACTIONS_FILTER;
}

function test_column_make(): \Filament\Tables\Columns\Column
{
    return \Filament\Tables\Columns\Column::make('name');
}

function test_text_column_make(): \Filament\Tables\Columns\TextColumn
{
    return \Filament\Tables\Columns\TextColumn::make('name');
}

function test_icon_column_make(): \Filament\Tables\Columns\IconColumn
{
    return \Filament\Tables\Columns\IconColumn::make('icon');
}

function test_select_filter_make(): \Filament\Tables\Filters\SelectFilter
{
    return \Filament\Tables\Filters\SelectFilter::make('status');
}

function test_column_group_make(): \Filament\Tables\Columns\ColumnGroup
{
    return \Filament\Tables\Columns\ColumnGroup::make('Group', [
        \Filament\Tables\Columns\TextColumn::make('name'),
    ]);
}
