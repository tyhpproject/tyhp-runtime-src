/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Options maps on resolve/setDefaults. Harvest left bare `array`.
 */

namespace Symfony\Component\OptionsResolver {
    /**
     * Stored by `setDeprecated()`: package, version, and a string or closure message.
     */
    type OptionDeprecation = struct {
        string $package;
        string $version;
        string|\Closure<callable(\Symfony\Component\OptionsResolver\Options, mixed): string> $message;
    };

    /**
     * Option name => value. Values are caller-defined.
     */
    type OptionMap = array<string, mixed>;

    /**
     * `setNormalizer()` / `addNormalizer()` closure: `(Options $options, mixed $value): mixed`.
     */
    type OptionNormalizer = \Closure<callable(\Symfony\Component\OptionsResolver\Options, mixed): mixed>;

    /**
     * `setOptions()` closure: `(OptionsResolver $resolver, Options $parent): void`.
     */
    type NestedOptionsClosure = \Closure<callable(\Symfony\Component\OptionsResolver\OptionsResolver, \Symfony\Component\OptionsResolver\Options): void>;

    /**
     * Deprecation message: literal string, or `(Options $options, mixed $value): string`.
     */
    type DeprecationMessage = string|\Closure<callable(\Symfony\Component\OptionsResolver\Options, mixed): string>;

    /**
     * Overlay: `deprecated()` message is a string or a closure returning the message.
     */
    // @overlay-against: class OptionConfigurator
    partial class OptionConfigurator {
        /**
         * @param \Symfony\Component\OptionsResolver\DeprecationMessage $message
         */
        // @overlay-against: function deprecated(string $package, string $version, string|\Closure $message): static
        public function deprecated(string $package, string $version, \Symfony\Component\OptionsResolver\DeprecationMessage $message = 'The option "%name%" is deprecated.'): static;

        /**
         * @param \Symfony\Component\OptionsResolver\OptionNormalizer $normalizer
         */
        // @overlay-against: function normalize(\Closure $normalizer): static
        public function normalize(\Symfony\Component\OptionsResolver\OptionNormalizer $normalizer): static;
    }

    /**
     * Overlay: option maps, normalizer/nested closures, and deprecation messages.
     */
    // @overlay-against: class OptionsResolver implements \Symfony\Component\OptionsResolver\Options
    partial class OptionsResolver {
        /**
         * @param \Symfony\Component\OptionsResolver\OptionMap $options
         * @return \Symfony\Component\OptionsResolver\OptionMap
         */
        // @overlay-against: function resolve(array $options): array
        public function resolve(\Symfony\Component\OptionsResolver\OptionMap $options = []): \Symfony\Component\OptionsResolver\OptionMap;

        /**
         * @param \Symfony\Component\OptionsResolver\OptionMap $defaults
         */
        // @overlay-against: function setDefaults(array $defaults): static
        public function setDefaults(\Symfony\Component\OptionsResolver\OptionMap $defaults): static;
    

        /**
         * @param string|array<string> $allowedTypes
         */
        // @overlay-against: function addAllowedTypes(string $option, string|array $allowedTypes): static
        public function addAllowedTypes(string $option, string|array<string> $allowedTypes): static;

        /**
         * @param string|array<string> $optionNames
         */
        // @overlay-against: function remove(string|array $optionNames): static
        public function remove(string|array<string> $optionNames): static;

        /**
         * @param string|array<string> $allowedTypes
         */
        // @overlay-against: function setAllowedTypes(string $option, string|array $allowedTypes): static
        public function setAllowedTypes(string $option, string|array<string> $allowedTypes): static;

        /**
         * @param string|array<string> $optionNames
         */
        // @overlay-against: function setDefined(string|array $optionNames): static
        public function setDefined(string|array<string> $optionNames): static;

        /**
         * @param string|array<string> $optionNames
         */
        // @overlay-against: function setRequired(string|array $optionNames): static
        public function setRequired(string|array<string> $optionNames): static;

        /**
         * @param \Symfony\Component\OptionsResolver\OptionNormalizer $normalizer
         */
        // @overlay-against: function addNormalizer(string $option, \Closure $normalizer, bool $forcePrepend): static
        public function addNormalizer(string $option, \Symfony\Component\OptionsResolver\OptionNormalizer $normalizer, bool $forcePrepend = false): static;

        /**
         * @param \Symfony\Component\OptionsResolver\DeprecationMessage $message
         */
        // @overlay-against: function setDeprecated(string $option, string $package, string $version, string|\Closure $message): static
        public function setDeprecated(string $option, string $package, string $version, \Symfony\Component\OptionsResolver\DeprecationMessage $message = 'The option "%name%" is deprecated.'): static;

        /**
         * @param \Symfony\Component\OptionsResolver\OptionNormalizer $normalizer
         */
        // @overlay-against: function setNormalizer(string $option, \Closure $normalizer): static
        public function setNormalizer(string $option, \Symfony\Component\OptionsResolver\OptionNormalizer $normalizer): static;

        /**
         * @param \Symfony\Component\OptionsResolver\NestedOptionsClosure $nested
         */
        // @overlay-against: function setOptions(string $option, \Closure $nested): static
        public function setOptions(string $option, \Symfony\Component\OptionsResolver\NestedOptionsClosure $nested): static;

        /**
         * @return array<string>
         */
        // @overlay-against: function getDefinedOptions(): array
        public function getDefinedOptions(): array<string>;

        /**
         * @return array<string>
         */
        // @overlay-against: function getMissingOptions(): array
        public function getMissingOptions(): array<string>;

        /**
         * @return array<string>
         */
        // @overlay-against: function getRequiredOptions(): array
        public function getRequiredOptions(): array<string>;
    }
}

namespace Symfony\Component\OptionsResolver\Debug {
    /**
