        public function getLazyClosures(string $option): array<\Closure>;

        /**
         * @return array<\Closure>
         */
        // @overlay-against: function getNestedOptions(string $option): array
        public function getNestedOptions(string $option): array<\Symfony\Component\OptionsResolver\NestedOptionsClosure>;

        /**
         * @return \Symfony\Component\OptionsResolver\OptionDeprecation
         */
        // @overlay-against: function getDeprecation(string $option): array
        public function getDeprecation(string $option): \Symfony\Component\OptionsResolver\OptionDeprecation;

        /**
         * @return array<int|string, \Symfony\Component\OptionsResolver\OptionNormalizer>
         */
        // @overlay-against: function getNormalizers(string $option): array
        public function getNormalizers(string $option): array<int|string, \Symfony\Component\OptionsResolver\OptionNormalizer>;
    }
}
