<?tyhp

function test_image_manager_using_driver(): \Intervention\Image\Interfaces\ImageManagerInterface
{
    return \Intervention\Image\ImageManager::usingDriver('gd');
}

function test_image_create(\Intervention\Image\ImageManager $manager): \Intervention\Image\Interfaces\ImageInterface
{
    return $manager->createImage(10, 10);
}

function test_image_decode_path(\Intervention\Image\ImageManager $manager): \Intervention\Image\Interfaces\ImageInterface
{
    return $manager->decodePath('photo.png');
}
