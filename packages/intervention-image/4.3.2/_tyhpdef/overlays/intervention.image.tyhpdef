namespace Intervention\Image {
    /**
     * Overlay: the animation callback receives this factory.
     */
    // @overlay-against: class AnimationFactory implements \Intervention\Image\Interfaces\AnimationFactoryInterface
    partial class AnimationFactory {
        /**
         * @param (callable(\Intervention\Image\AnimationFactory): mixed) $animation
         */
        // @overlay-against: function build(int $width, int $height, callable $animation, \Intervention\Image\Interfaces\DriverInterface $driver): \Intervention\Image\Interfaces\ImageInterface
        public static function build(int $width, int $height, (callable(\Intervention\Image\AnimationFactory): mixed) $animation, \Intervention\Image\Interfaces\DriverInterface $driver): \Intervention\Image\Interfaces\ImageInterface;
        /**
         * @param null|(callable(\Intervention\Image\AnimationFactory): mixed) $animation
         */
        // @overlay-against: function __construct(int $width, int $height, null|callable $animation): void
        public function __construct(int $width, int $height, null|(callable(\Intervention\Image\AnimationFactory): mixed) $animation = null): void;
    }

    /**
     * Overlay: collection items and iteration match CollectionInterface.
     */
    // @overlay-against: class Collection implements \Intervention\Image\Interfaces\CollectionInterface, \IteratorAggregate, \Countable
    partial class Collection {
        /**
         * @return \Traversable<int|string, mixed>
         */
        // @overlay-against: function getIterator(): \Traversable
        public function getIterator(): \Traversable<int|string, mixed>;
        /**
         * @return array<int|string, mixed>
         */
        // @overlay-against: function toArray(): array
        public function toArray(): array<int|string, mixed>;
    }

    /**
     * Overlay: data-uri parameters are string maps.
     */
    // @overlay-against: class DataUri implements \Intervention\Image\Interfaces\DataUriInterface, \JsonSerializable
    partial class DataUri {
        /**
         * @param array<string, string> $parameters
         */
        // @overlay-against: function create(string $data, null|string|\Intervention\Image\MediaType $mediaType, array $parameters, bool $base64): self
        public static function create(string $data, null|string|\Intervention\Image\MediaType $mediaType = null, array<string, string> $parameters = [], bool $base64 = true): self;
        /**
         * @return array<string, string|int|null>
         */
        // @overlay-against: function __debugInfo(): array
        public function __debugInfo(): array<string, string|int|null>;
        /**
         * @param array<string, string> $parameters
         */
        // @overlay-against: function appendParameters(array $parameters): self
        public function appendParameters(array<string, string> $parameters): self;
        /**
         * @return string
         */
        // @overlay-against: function jsonSerialize(): mixed
        public function jsonSerialize(): string;
        /**
         * @return array<string, string>
         */
        // @overlay-against: function parameters(): array
        public function parameters(): array<string, string>;
        /**
         * @param array<string, string> $parameters
         */
        // @overlay-against: function setParameters(array $parameters): self
        public function setParameters(array<string, string> $parameters): self;
    }

