        public function createImage(int $width, int $height, null|(callable(\Intervention\Image\AnimationFactory): mixed)|\Intervention\Image\Interfaces\AnimationFactoryInterface $animation = null): \Intervention\Image\Interfaces\ImageInterface;
        /**
