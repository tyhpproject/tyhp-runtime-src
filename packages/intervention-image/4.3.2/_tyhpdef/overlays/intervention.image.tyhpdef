         */
        // @overlay-against: function decode(mixed $source, null|string|array|\Intervention\Image\Interfaces\DecoderInterface $decoders): \Intervention\Image\Interfaces\ImageInterface
        public function decode(mixed $source, null|string|array<int, string|\Intervention\Image\Interfaces\DecoderInterface>|\Intervention\Image\Interfaces\DecoderInterface $decoders = null): \Intervention\Image\Interfaces\ImageInterface;
    }

    /**
     * Overlay: iteration is the x/y resolution, and JSON is the string form.
