        // @overlay-against: function drawLine(callable|\Intervention\Image\Geometry\Line $line): \Intervention\Image\Interfaces\ImageInterface
        public function drawLine((callable(\Intervention\Image\Geometry\Factories\LineFactory): mixed)|\Intervention\Image\Geometry\Line $line): \Intervention\Image\Interfaces\ImageInterface;
        /**
         * @param (callable(\Intervention\Image\Geometry\Factories\PolygonFactory): mixed)|\Intervention\Image\Geometry\Polygon $polygon
         */
        // @overlay-against: function drawPolygon(callable|\Intervention\Image\Geometry\Polygon $polygon): \Intervention\Image\Interfaces\ImageInterface
        public function drawPolygon((callable(\Intervention\Image\Geometry\Factories\PolygonFactory): mixed)|\Intervention\Image\Geometry\Polygon $polygon): \Intervention\Image\Interfaces\ImageInterface;
        /**
         * @param (callable(\Intervention\Image\Geometry\Factories\RectangleFactory): mixed)|\Intervention\Image\Geometry\Rectangle $rectangle
         */
        // @overlay-against: function drawRectangle(callable|\Intervention\Image\Geometry\Rectangle $rectangle): \Intervention\Image\Interfaces\ImageInterface
        public function drawRectangle((callable(\Intervention\Image\Geometry\Factories\RectangleFactory): mixed)|\Intervention\Image\Geometry\Rectangle $rectangle): \Intervention\Image\Interfaces\ImageInterface;
        /**
         * @param (callable(\Intervention\Image\Typography\FontFactory): mixed)|\Intervention\Image\Interfaces\FontInterface $font
         */
        // @overlay-against: function text(string $text, int $x, int $y, callable|\Intervention\Image\Interfaces\FontInterface $font): \Intervention\Image\Interfaces\ImageInterface
        public function text(string $text, int $x, int $y, (callable(\Intervention\Image\Typography\FontFactory): mixed)|\Intervention\Image\Interfaces\FontInterface $font): \Intervention\Image\Interfaces\ImageInterface;
    }

    /**
     * Overlay: decode() accepts a decoder list.
     */
    // @overlay-against: class ImageManager implements \Intervention\Image\Interfaces\ImageManagerInterface, \Intervention\Image\Traits\CanResolveDriver
    partial class ImageManager {
        /**
