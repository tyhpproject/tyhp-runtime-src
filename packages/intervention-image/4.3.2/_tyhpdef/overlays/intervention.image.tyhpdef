        /**
         * @param callable(\Intervention\Image\Interfaces\ColorInterface): \Intervention\Image\Interfaces\ColorInterface $callback
         */
        // @overlay-against: function map(callable $callback): \Intervention\Image\Interfaces\PaletteInterface
        public function map(callable(\Intervention\Image\Interfaces\ColorInterface): \Intervention\Image\Interfaces\ColorInterface $callback): \Intervention\Image\Interfaces\PaletteInterface;
        /**
