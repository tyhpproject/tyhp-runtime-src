<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Optional PDFLib backend is unowned — extern. HTML5 parsing is path-linked.
 */

extern class \PDFLib;

namespace Dompdf {
    type CellBorderEdge = struct {
        string $color;
        string $style;
        int|float $width;
    };

    type CellBorderProperties = struct {
        CellBorderEdge $bottom;
        CellBorderEdge $left;
        CellBorderEdge $right;
        CellBorderEdge $top;
    };

    type FrameBox = struct {
        float 0 as $at0;
        float 1 as $at1;
        float 2 as $at2;
        float 3 as $at3;
        float $h;
        float $w;
        float $x;
        float $y;
    };

    type FramePosition = struct {
        float 0 as $at0;
        float 1 as $at1;
        float $x;
        float $y;
    };

    /**
     * Overlay: HTML load/render are void; options accept a string map.
     */
    // @overlay-against: class Dompdf
    partial class Dompdf {
        /**
         * @param \Dompdf\Options|array<string, mixed>|null $options
         */
        // @overlay-against: function __construct(\Dompdf\Options|array|null $options): void
        public function __construct(\Dompdf\Options|array<string, mixed>|null $options = null): void;

        // @overlay-against: function loadHtml(string $str, string|null $encoding): mixed
        public function loadHtml(string $str, ?string $encoding = null): void;

        // @overlay-against: function render(): mixed
        public function render(): void;

        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function output(array $options): string
        public function output(array<string, mixed> $options = []): string;
    }

    /**
     * Overlay: option bags are string-keyed.
     */
    // @overlay-against: class Options
    partial class Options {
        /**
         * @param array<string, mixed>|null $attributes
         */
        // @overlay-against: function __construct(array $attributes): void
        public function __construct(?array<string, mixed> $attributes = null): void;
    }

    // @overlay-against: class Cellmap
    partial class Cellmap {
        // @overlay-against: function get_border_properties(int $i, int $j): array
        public function get_border_properties(int $i, int $j): CellBorderProperties;

        // @overlay-against: function get_frame_position(\Dompdf\Frame $frame): array
        public function get_frame_position(\Dompdf\Frame $frame): FramePosition;
    }
}

namespace Dompdf\Css {
    type CssBorderEdge = struct {
        mixed $color;
        mixed $style;
        mixed $width;
    };

    type CssBorderProperties = struct {
        CssBorderEdge $bottom;
        CssBorderEdge $left;
        CssBorderEdge $right;
        CssBorderEdge $top;
    };

    // @overlay-against: class Style
    partial class Style {
        // @overlay-against: function get_border_properties(): array
        public function get_border_properties(): CssBorderProperties;
    }
}

namespace Dompdf\FrameDecorator {
    // @overlay-against: class AbstractFrameDecorator extends \Dompdf\Frame
    partial class AbstractFrameDecorator {
        // @overlay-against: function get_border_box(): array
        public function get_border_box(): \Dompdf\FrameBox;

        // @overlay-against: function get_content_box(): array
        public function get_content_box(): \Dompdf\FrameBox;

        // @overlay-against: function get_min_max_width(): array
        public final function get_min_max_width(): \Dompdf\FrameReflower\MinMaxWidth;

        // @overlay-against: function get_padding_box(): array
        public function get_padding_box(): \Dompdf\FrameBox;
    }

    // @overlay-against: class Image extends \Dompdf\FrameDecorator\AbstractFrameDecorator
    partial class Image {
        // @overlay-against: function get_intrinsic_dimensions(): array
        public function get_intrinsic_dimensions(): array<int, int|float>;
    }
}

namespace Dompdf\FrameReflower {
    type MinMaxWidth = struct {
        float 0 as $at0;
        float 1 as $at1;
        float $max;
        float $min;
    };

    // @overlay-against: class AbstractFrameReflower
    partial class AbstractFrameReflower {
        // @overlay-against: function get_min_max_child_width(): array
        public function get_min_max_child_width(): array<int, int|float>;

        // @overlay-against: function get_min_max_content_width(): array
        public function get_min_max_content_width(): array<int, int|float>;

        // @overlay-against: function get_min_max_width(): array
        public function get_min_max_width(): MinMaxWidth;
    }

    // @overlay-against: class Block extends \Dompdf\FrameReflower\AbstractFrameReflower
    partial class Block {
        // @overlay-against: function get_min_max_content_width(): array
        public function get_min_max_content_width(): array<int, int|float>;
    }

    // @overlay-against: class Image extends \Dompdf\FrameReflower\AbstractFrameReflower
    partial class Image {
        // @overlay-against: function get_min_max_content_width(): array
        public function get_min_max_content_width(): array<int, int|float>;
    }

    // @overlay-against: class Table extends \Dompdf\FrameReflower\AbstractFrameReflower
    partial class Table {
        // @overlay-against: function get_min_max_width(): array
        public function get_min_max_width(): MinMaxWidth;
    }

    // @overlay-against: class TableCell extends \Dompdf\FrameReflower\Block
    partial class TableCell {
        // @overlay-against: function get_min_max_content_width(): array
        public function get_min_max_content_width(): array<int, int|float>;
    }

    // @overlay-against: class Text extends \Dompdf\FrameReflower\AbstractFrameReflower
    partial class Text {
        // @overlay-against: function get_min_max_width(): array
        public function get_min_max_width(): MinMaxWidth;
    }
}
