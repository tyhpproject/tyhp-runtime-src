        * @generated
        */
        public const float UNDERLINE_OFFSET ?? 0.0;
        /**
        * Relative to top of text
        *
        * @generated
        */
        public const float OVERLINE_OFFSET ?? 0.0;
        /**
        * Relative to centre of text.
        *
        * @generated
        */
        public const float LINETHROUGH_OFFSET ?? 0.0;
        /**
        * How far to extend lines past either end, in pt
        *
        * @generated
        */
        public const float DECO_EXTENSION ?? 0.0;
        /**
        * @param \Dompdf\Frame $frame
        * @generated
        */
        public function render(\Dompdf\Frame $frame): mixed;
    }
}
