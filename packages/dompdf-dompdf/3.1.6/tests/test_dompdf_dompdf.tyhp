<?tyhp

function test_dompdf_create(): \Dompdf\Dompdf
{
    return new \Dompdf\Dompdf();
}

function test_dompdf_load(\Dompdf\Dompdf $pdf): void
{
    $pdf->loadHtml('<p>hello</p>');
}

function test_dompdf_options(): \Dompdf\Options
{
    return new \Dompdf\Options(['isRemoteEnabled' => false]);
}
