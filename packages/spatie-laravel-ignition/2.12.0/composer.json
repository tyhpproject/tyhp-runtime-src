{
    "name": "tyhpdef/spatie-laravel-ignition",
    "description": "Tyhp type definitions for the Composer package spatie/laravel-ignition (2.12.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.12.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": "8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/spatie-ignition": "@dev",
                "tyhpdef/spatie-flare-client-php": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "spatie/laravel-ignition": "2.12.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/spatie-ignition": "@dev",
        "tyhpdef/spatie-flare-client-php": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../laravel-framework/13.32.0"
        },
        {
            "type": "path",
            "url": "../../spatie-ignition/1.16.0"
        },
        {
            "type": "path",
            "url": "../../spatie-flare-client-php/1.11.1"
        }
    ]
}
