<?tyhp

function test_api_resource(): \ApiPlatform\Metadata\ApiResource
{
    return new \ApiPlatform\Metadata\ApiResource();
}

function test_get_collection(): \ApiPlatform\Metadata\GetCollection
{
    return new \ApiPlatform\Metadata\GetCollection();
}

function test_documentation(): \ApiPlatform\Documentation\Documentation
{
    $names = new \ApiPlatform\Metadata\Resource\ResourceNameCollection();
    return new \ApiPlatform\Documentation\Documentation($names, 'Books', 'Book API', '1.0');
}

function test_iri_from_resource(\ApiPlatform\Metadata\IriConverterInterface $converter): ?string
{
    return $converter->getIriFromResource('App\\Book');
}

function test_orm_options(): \ApiPlatform\Doctrine\Orm\State\Options
{
    return new \ApiPlatform\Doctrine\Orm\State\Options();
}
