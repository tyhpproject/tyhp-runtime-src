{
    "name": "tyhpdef/api-platform-core",
    "description": "Tyhp type definitions for the Composer package api-platform/core (4.4.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "4.4.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/composer-semver": "@dev",
                "tyhpdef/doctrine-inflector": "@dev",
                "tyhpdef/psr-cache": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/symfony-http-foundation": "@dev",
                "tyhpdef/symfony-http-kernel": "@dev",
                "tyhpdef/symfony-property-access": "@dev",
                "tyhpdef/symfony-property-info": "@dev",
                "tyhpdef/symfony-serializer": "@dev",
                "tyhpdef/symfony-translation-contracts": "@dev",
                "tyhpdef/symfony-type-info": "@dev",
                "tyhpdef/symfony-validator": "@dev",
                "tyhpdef/willdurand-negotiation": "@dev",
                "tyhpdef/doctrine-orm": "@dev",
                "tyhpdef/doctrine-persistence": "@dev",
                "tyhpdef/doctrine-dbal": "@dev",
                "tyhpdef/doctrine-collections": "@dev",
                "tyhpdef/psr-http-message": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "api-platform/core": "4.4.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/composer-semver": "@dev",
        "tyhpdef/doctrine-inflector": "@dev",
        "tyhpdef/psr-cache": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/symfony-http-foundation": "@dev",
        "tyhpdef/symfony-http-kernel": "@dev",
        "tyhpdef/symfony-property-access": "@dev",
        "tyhpdef/symfony-property-info": "@dev",
        "tyhpdef/symfony-serializer": "@dev",
        "tyhpdef/symfony-translation-contracts": "@dev",
        "tyhpdef/symfony-type-info": "@dev",
        "tyhpdef/symfony-validator": "@dev",
        "tyhpdef/willdurand-negotiation": "@dev",
        "tyhpdef/doctrine-orm": "@dev",
        "tyhpdef/doctrine-persistence": "@dev",
        "tyhpdef/doctrine-dbal": "@dev",
        "tyhpdef/doctrine-collections": "@dev",
        "tyhpdef/psr-http-message": "@dev"
    },
