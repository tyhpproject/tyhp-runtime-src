{
  "name": "tyhpdef/php-http-httplug",
  "description": "Tyhp type definitions for the Composer package php-http/httplug (2.4.1).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "2.4.1.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-http-client": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/php-http-promise": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "php-http/httplug": "2.4.1"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/psr-http-client": "@dev",
    "tyhpdef/psr-http-message": "@dev",
    "tyhpdef/php-http-promise": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../psr-http-message/2.0"
    },
    {
      "type": "path",
      "url": "../../psr-http-client/1.0.3"
    },
    {
      "type": "path",
      "url": "../../php-http-promise/1.3.1"
    }
  ]
}
