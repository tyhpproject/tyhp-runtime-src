<?tyhp

function test_php_http_httplug_async(\Http\Client\HttpAsyncClient $client, \Psr\Http\Message\RequestInterface $request): \Http\Promise\Promise
{
    return $client->sendAsyncRequest($request);
}

function test_php_http_httplug_exception(\Http\Client\Exception $e): \Psr\Http\Client\ClientExceptionInterface
{
    return $e;
}

function test_php_http_httplug_http_exception(\Http\Client\Exception\HttpException $e): \Psr\Http\Message\ResponseInterface
{
    return $e->getResponse();
}

function test_php_http_httplug_create(\Psr\Http\Message\RequestInterface $request, \Psr\Http\Message\ResponseInterface $response): \Http\Client\Exception\HttpException
{
    return \Http\Client\Exception\HttpException::create($request, $response);
}

function test_php_http_httplug_fulfilled(\Psr\Http\Message\ResponseInterface $response): \Http\Promise\Promise
{
    return new \Http\Client\Promise\HttpFulfilledPromise($response);
}

function test_php_http_httplug_wait_unwrap(\Http\Client\Promise\HttpFulfilledPromise $promise): \Psr\Http\Message\ResponseInterface
{
    return $promise->wait(true);
}

function test_php_http_httplug_wait_no_unwrap(\Http\Client\Promise\HttpFulfilledPromise $promise): null
{
    return $promise->wait(false);
}
