        public function handle(\Illuminate\Http\Request $request, \Closure<callable(\Illuminate\Http\Request): \Illuminate\Http\Response> $next, string ...$abilities): \Illuminate\Http\Response;
    }

    // @overlay-against: class CheckForAnyAbility
    partial class CheckForAnyAbility {
        // @overlay-against: function handle(\Illuminate\Http\Request $request, \Closure $next, mixed $abilities): \Illuminate\Http\Response
        public function handle(\Illuminate\Http\Request $request, \Closure<callable(\Illuminate\Http\Request): \Illuminate\Http\Response> $next, string ...$abilities): \Illuminate\Http\Response;
    }

    // @overlay-against: class CheckForAnyScope
