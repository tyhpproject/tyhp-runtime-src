namespace Laravel\Sanctum {
    /**
     * Guard casts the return with `(bool)` after `($callback)($accessToken, $isValid)`.
     */
    type AccessTokenAuthenticationCallback = callable(mixed, bool): mixed;

    /**
     * Guard casts the return with `(string)` after `($callback)($request)`.
     */
    type AccessTokenRetrievalCallback = callable(\Illuminate\Http\Request): mixed;

    // @overlay-against: class Guard
    partial class Guard {
        // @overlay-against: function __invoke(\Illuminate\Http\Request $request): mixed
        public function __invoke(\Illuminate\Http\Request $request): \Illuminate\Contracts\Auth\Authenticatable|\Laravel\Sanctum\HasApiTokens|null;
    }

    // @overlay-against: trait HasApiTokens
    partial trait HasApiTokens {
        // @overlay-against: function createToken(string $name, array $abilities, ?\DateTimeInterface $expiresAt): \Laravel\Sanctum\NewAccessToken
        public function createToken(string $name, array<int, string> $abilities = [], ?\DateTimeInterface $expiresAt = null): \Laravel\Sanctum\NewAccessToken;
    }

    // @overlay-against: class Sanctum
    partial class Sanctum<TToken extends \Laravel\Sanctum\Contracts\HasAbilities = \Laravel\Sanctum\PersonalAccessToken>;

    // @overlay-against: class Sanctum
    partial class Sanctum {
        // @overlay-against: callable|null $accessTokenAuthenticationCallback
        public static ?AccessTokenAuthenticationCallback $accessTokenAuthenticationCallback;

        // @overlay-against: callable|null $accessTokenRetrievalCallback
        public static ?AccessTokenRetrievalCallback $accessTokenRetrievalCallback;

        /**
         * Overlay: `Sanctum::$personalAccessTokenModel` uses the documented type.
         */
        // @overlay-against: string $personalAccessTokenModel
        public static __ClassName<TToken> $personalAccessTokenModel ?? 'Laravel\\Sanctum\\PersonalAccessToken';

        // @overlay-against: function actingAs(\Illuminate\Contracts\Auth\Authenticatable|\Laravel\Sanctum\HasApiTokens $user, array $abilities, string $guard): \Illuminate\Contracts\Auth\Authenticatable
        public static function actingAs(\Illuminate\Contracts\Auth\Authenticatable|\Laravel\Sanctum\HasApiTokens $user, array<int, string> $abilities = [], string $guard = 'sanctum'): \Illuminate\Contracts\Auth\Authenticatable;

        // @overlay-against: function authenticateAccessTokensUsing(callable $callback): void
        public static function authenticateAccessTokensUsing(AccessTokenAuthenticationCallback $callback): void;

        // @overlay-against: function getAccessTokenFromRequestUsing(callable|null $callback): void
        public static function getAccessTokenFromRequestUsing(?AccessTokenRetrievalCallback $callback): void;

        /**
         * Overlay: `Sanctum::personalAccessTokenModel()` uses the documented types.
         */
        // @overlay-against: function personalAccessTokenModel(): string
        public static function personalAccessTokenModel(): __ClassName<TToken>;

        /**
         * Overlay: `Sanctum::usePersonalAccessTokenModel()` uses the documented types.
         */
        // @overlay-against: function usePersonalAccessTokenModel(string $model): void
        public static function usePersonalAccessTokenModel(__ClassName<TToken> $model): void;
    }
}

namespace Laravel\Sanctum\Contracts {
    // @overlay-against: interface HasApiTokens
    partial interface HasApiTokens {
        // @overlay-against: function createToken(string $name, array $abilities, ?\DateTimeInterface $expiresAt): \Laravel\Sanctum\NewAccessToken
        public function createToken(string $name, array<int, string> $abilities = [], ?\DateTimeInterface $expiresAt = null): \Laravel\Sanctum\NewAccessToken;
    }
}

namespace Laravel\Sanctum\Http\Middleware {
    // @overlay-against: class AuthenticateSession
    partial class AuthenticateSession {
        /**
