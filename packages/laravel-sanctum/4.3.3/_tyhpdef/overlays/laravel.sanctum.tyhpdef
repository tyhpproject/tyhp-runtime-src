        public function handle(\Illuminate\Http\Request $request, \Closure<callable(\Illuminate\Http\Request): \Symfony\Component\HttpFoundation\Response> $next): \Symfony\Component\HttpFoundation\Response;
    }

    // @overlay-against: class CheckAbilities
    partial class CheckAbilities {
