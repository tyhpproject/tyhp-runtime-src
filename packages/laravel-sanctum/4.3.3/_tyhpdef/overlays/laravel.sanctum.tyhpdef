        // @overlay-against: function handle(\Illuminate\Http\Request $request, \Closure $next, mixed $scopes): \Illuminate\Http\Response
        public function handle(\Illuminate\Http\Request $request, \Closure<callable(\Illuminate\Http\Request): \Illuminate\Http\Response> $next, string ...$scopes): \Illuminate\Http\Response;
    }

    // @overlay-against: class EnsureFrontendRequestsAreStateful
    partial class EnsureFrontendRequestsAreStateful {
        // @overlay-against: function handle(\Illuminate\Http\Request $request, callable $next): \Illuminate\Http\Response
        public function handle(\Illuminate\Http\Request $request, callable(\Illuminate\Http\Request): \Illuminate\Http\Response $next): \Illuminate\Http\Response;
    }

