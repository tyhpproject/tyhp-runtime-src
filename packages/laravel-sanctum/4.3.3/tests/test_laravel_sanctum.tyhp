<?tyhp

function test_sanctum_guard(\Illuminate\Contracts\Auth\Factory $auth): \Laravel\Sanctum\Guard
{
    return new \Laravel\Sanctum\Guard($auth);
}

function test_personal_access_token(): \Laravel\Sanctum\PersonalAccessToken
{
    return new \Laravel\Sanctum\PersonalAccessToken();
}

function test_personal_access_token_find(): \Laravel\Sanctum\PersonalAccessToken|null
{
    return \Laravel\Sanctum\PersonalAccessToken::findToken('secret');
}

function test_personal_access_token_can(\Laravel\Sanctum\PersonalAccessToken $token): bool
{
    return $token->can('*');
}

function test_has_api_tokens_create(\Laravel\Sanctum\Contracts\HasApiTokens $user): \Laravel\Sanctum\NewAccessToken
{
    return $user->createToken('api');
}

function test_new_access_token(\Laravel\Sanctum\PersonalAccessToken $token): \Laravel\Sanctum\NewAccessToken
{
    return new \Laravel\Sanctum\NewAccessToken($token, 'plain-text-token');
}

function test_transient_token_can(): bool
{
    return (new \Laravel\Sanctum\TransientToken())->can('*');
}

function test_sanctum_current_request_host(): string
{
    return \Laravel\Sanctum\Sanctum::currentRequestHost();
}

function test_sanctum_personal_access_token_model(): string
{
    \Laravel\Sanctum\Sanctum::usePersonalAccessTokenModel(\Laravel\Sanctum\PersonalAccessToken::class);
    return \Laravel\Sanctum\Sanctum::personalAccessTokenModel();
}
