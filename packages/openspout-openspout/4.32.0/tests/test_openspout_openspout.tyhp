<?tyhp

function test_openspout_openspout_package_loads(): bool
{
    return true;
}

function test_csv_writer(): \OpenSpout\Writer\CSV\Writer
{
    return new \OpenSpout\Writer\CSV\Writer(new \OpenSpout\Writer\CSV\Options());
}

function test_csv_open_to_file(\OpenSpout\Writer\CSV\Writer $writer): void
{
    $writer->openToFile('/tmp/tyhp-openspout.csv');
}
