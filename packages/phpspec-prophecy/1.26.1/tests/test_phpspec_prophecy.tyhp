<?tyhp

function test_prophecy_exact_token(): \Prophecy\Argument\Token\ExactValueToken
{
    return \Prophecy\Argument::exact('value');
}

function test_prophecy_any_token(): \Prophecy\Argument\Token\AnyValueToken
{
    return \Prophecy\Argument::any();
}

function test_prophecy_prophet(): \Prophecy\Prophet
{
    return new \Prophecy\Prophet();
}
