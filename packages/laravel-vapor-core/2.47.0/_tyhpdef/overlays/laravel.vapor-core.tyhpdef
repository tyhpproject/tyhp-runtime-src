        // @overlay-against: function handle(\Illuminate\Http\Request $request, callable $next): mixed
        public function handle(\Illuminate\Http\Request $request, callable(\Illuminate\Http\Request): \Symfony\Component\HttpFoundation\Response $next): \Symfony\Component\HttpFoundation\Response;
    }

    // @overlay-against: class RedirectStaticAssets
    partial class RedirectStaticAssets {
        /**
         * Overlay: `RedirectStaticAssets::handle()` calls `$next` with the request and returns that result.
         */
        // @overlay-against: function handle(\Illuminate\Http\Request $request, callable $next): mixed
        public function handle(\Illuminate\Http\Request $request, callable(\Illuminate\Http\Request): mixed $next): mixed;
    }
}

namespace Laravel\Vapor\Runtime\Octane {
    /**
     * Overlay: `OctaneRequestContextFactory::fromEvent()` reads the HTTP event plus `cookies`.
     */
    type OctaneRequestContextFactoryFromEventEvent = struct extends \Laravel\Vapor\Runtime\RequestFromLambdaEventEvent {
        array<int, string>|null $cookies;
    };

    // @overlay-against: class OctaneHttpHandlerFactory
    partial class OctaneHttpHandlerFactory {
        /**
         * Overlay: `OctaneHttpHandlerFactory::make()` branches on the same discriminator keys as the FPM factory.
         */
        // @overlay-against: function make(array $event): \Laravel\Vapor\Contracts\LambdaEventHandler
        public static function make(\Laravel\Vapor\Runtime\HttpHandlerFactoryMakeEvent $event): \Laravel\Vapor\Contracts\LambdaEventHandler;
    }

    // @overlay-against: class OctaneRequestContextFactory
    partial class OctaneRequestContextFactory {
        /**
         * Overlay: `OctaneRequestContextFactory::fromEvent()` reads cookies and forwards the event to `Request::fromLambdaEvent()`.
         */
        // @overlay-against: function fromEvent(array $event, array $serverVariables): \Laravel\Octane\RequestContext
        public static function fromEvent(OctaneRequestContextFactoryFromEventEvent $event, array $serverVariables): \Laravel\Octane\RequestContext;
    }
}
extern class \Aws\Lambda\LambdaClient;
extern class \Riverline\MultipartParser\Part;
