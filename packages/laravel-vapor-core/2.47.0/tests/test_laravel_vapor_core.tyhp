<?tyhp

function test_vapor_active(): bool
{
    return \Laravel\Vapor\Vapor::active();
}

function test_vapor_arr_set_multipart(): array
{
    return \Laravel\Vapor\Arr::setMultipartArrayValue([], 'file', 'body');
}

function test_vapor_job_timed_out(): \Laravel\Vapor\VaporJobTimedOutException
{
    return new \Laravel\Vapor\VaporJobTimedOutException('job');
}

function test_vapor_lambda_event(): \Laravel\Vapor\Events\LambdaEvent
{
    return new \Laravel\Vapor\Events\LambdaEvent(['requestId' => '1']);
}

function test_vapor_runtime_response(): \Laravel\Vapor\Runtime\Response
{
    return new \Laravel\Vapor\Runtime\Response('ok', ['Content-Type' => 'text/plain'], 200);
}
