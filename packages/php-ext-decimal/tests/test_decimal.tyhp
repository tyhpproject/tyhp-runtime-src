<?tyhp

function test_decimal_construct_signature(): \Decimal\Decimal
{
    return new \Decimal\Decimal('1.23');
}

function test_decimal_add_operator(): \Decimal\Decimal
{
    \Decimal\Decimal $left = new \Decimal\Decimal('1');
    \Decimal\Decimal $right = new \Decimal\Decimal('2');
    return $left + $right;
}
