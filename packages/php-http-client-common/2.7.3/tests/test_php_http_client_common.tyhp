<?tyhp

function test_php_http_plugin_client(\Psr\Http\Client\ClientInterface $client): \Http\Client\HttpClient
{
    return new \Http\Client\Common\PluginClient($client);
}

function test_php_http_plugin_client_send(\Http\Client\Common\PluginClient $client, \Psr\Http\Message\RequestInterface $request): \Psr\Http\Message\ResponseInterface
{
    return $client->sendRequest($request);
}

function test_php_http_plugin_client_async(\Http\Client\Common\PluginClient $client, \Psr\Http\Message\RequestInterface $request): \Http\Promise\Promise
{
    return $client->sendAsyncRequest($request);
}

function test_php_http_batch(\Http\Client\Common\BatchClientInterface $batch, \Psr\Http\Message\RequestInterface $a, \Psr\Http\Message\RequestInterface $b): \Http\Client\Common\BatchResult
{
    return $batch->sendRequests([$a, $b]);
}

function test_php_http_plugin_handle(\Http\Client\Common\Plugin $plugin, \Psr\Http\Message\RequestInterface $request, \Http\Client\Common\PluginNext $next, \Http\Client\Common\PluginNext $first): \Http\Promise\Promise
{
    return $plugin->handleRequest($request, $next, $first);
}
