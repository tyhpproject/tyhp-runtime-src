<?tyhp

function test_assertable_json_string(): \Illuminate\Testing\AssertableJsonString
{
    return new \Illuminate\Testing\AssertableJsonString('{"ok":true}');
}

function test_test_response(): \Illuminate\Testing\TestResponse<\Symfony\Component\HttpFoundation\Response>
{
    return new \Illuminate\Testing\TestResponse<\Symfony\Component\HttpFoundation\Response>(
        new \Symfony\Component\HttpFoundation\Response()
    );
}

function test_assertable_json_from_string(): \Illuminate\Testing\Fluent\AssertableJson
{
    return \Illuminate\Testing\Fluent\AssertableJson::fromAssertableJsonString(
        new \Illuminate\Testing\AssertableJsonString('{"ok":true}')
    );
}
