<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Rule results, @covers pairs, data-provider tuples, and PharIo version bounds.
 */

namespace PHPStan\Rules\PHPUnit {
    /**
     * `@covers` tags and `@coversDefaultClass` tags.
     */
    type CoverAnnotations = struct {
        array<int|string, \PHPStan\PhpDocParser\Ast\PhpDoc\PhpDocTagNode> 0 as $_1;
        array<int|string, \PHPStan\PhpDocParser\Ast\PhpDoc\PhpDocTagNode> 1 as $_2;
    };

    /**
     * One data provider: optional class, method name, line.
     */
    type DataProviderMethod = struct {
        \PHPStan\Reflection\ClassReflection|null 0 as $_1;
        string 1 as $_2;
        int 2 as $_3;
    };

    /**
     * Lower and upper PharIo versions for this PHPUnit release, or none.
     */
    type PharIoVersionBounds = struct {
        \PharIo\Version\Version 0 as $_1;
        \PharIo\Version\Version 1 as $_2;
    };

    /**
     * Overlay: `@covers` annotations are a pair of tag lists.
     */
    // @overlay-against: class CoversHelper
    partial class CoversHelper {
        // @overlay-against: function getCoverAnnotations(?\PHPStan\PhpDoc\ResolvedPhpDocBlock $phpDoc): array
        public function getCoverAnnotations(?\PHPStan\PhpDoc\ResolvedPhpDocBlock $phpDoc): \PHPStan\Rules\PHPUnit\CoverAnnotations;
    }

    /**
     * Overlay: data providers are `{class|null, method, line}` tuples.
     */
    // @overlay-against: class DataProviderHelper
    partial class DataProviderHelper {
        /**
         * @return iterable<int|string, \PHPStan\Rules\PHPUnit\DataProviderMethod>
         */
        // @overlay-against: function getDataProviderMethods(\PHPStan\Analyser\Scope $scope, \PHPStan\BetterReflection\Reflection\ReflectionMethod|\PhpParser\Node\Stmt\ClassMethod $testMethod, \PHPStan\Reflection\ClassReflection $classReflection): iterable
        public function getDataProviderMethods(\PHPStan\Analyser\Scope $scope, \PHPStan\BetterReflection\Reflection\ReflectionMethod|\PhpParser\Node\Stmt\ClassMethod $testMethod, \PHPStan\Reflection\ClassReflection $classReflection): iterable<int|string, \PHPStan\Rules\PHPUnit\DataProviderMethod>;
    }

    /**
     * Overlay: empty when the PHPUnit version is unknown, otherwise a lower/upper pair.
     */
    // @overlay-against: class PHPUnitVersion
    partial class PHPUnitVersion {
        // @overlay-against: function getPharIoVersions(): array
        public function getPharIoVersions(): array<never, never>|\PHPStan\Rules\PHPUnit\PharIoVersionBounds;
    }

    /**
     * Overlay: rule errors are a list of identifier errors. `getNodeType()` is a node class name.
     */
    // @overlay-against: class AssertEqualsIsDiscouragedRule implements \PHPStan\Rules\Rule
    partial class AssertEqualsIsDiscouragedRule {
        // @overlay-against: function getNodeType(): string
        public function getNodeType(): \__CompatibleTypeName<\PhpParser\Node>;

        /**
         * @return array<int|string, \PHPStan\Rules\IdentifierRuleError>
         */
        // @overlay-against: function processNode(\PhpParser\Node $node, \PHPStan\Analyser\Scope $scope): array
        public function processNode(\PhpParser\Node $node, \PHPStan\Analyser\Scope $scope): array<int|string, \PHPStan\Rules\IdentifierRuleError>;
    }

