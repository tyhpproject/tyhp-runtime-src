{
    "name": "tyhpdef/phpstan-phpstan-phpunit",
    "description": "Tyhp type definitions for the Composer package phpstan/phpstan-phpunit (2.0.18).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.0.18.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/phpstan-phpstan": "@dev",
                "tyhpdef/phpunit-phpunit": "@dev",
                "tyhpdef/nikic-php-parser": "@dev",
                "tyhpdef/phpstan-phpdoc-parser": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "phpstan/phpstan-phpunit": "2.0.18"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/phpstan-phpstan": "@dev",
        "tyhpdef/phpunit-phpunit": "@dev",
        "tyhpdef/nikic-php-parser": "@dev",
        "tyhpdef/phpstan-phpdoc-parser": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../phpstan-phpstan/2.2.14"
        },
        {
            "type": "path",
            "url": "../../phpunit-phpunit/12.5.35"
        },
        {
            "type": "path",
            "url": "../../nikic-php-parser/5.9.0"
        },
        {
            "type": "path",
            "url": "../../phpstan-phpdoc-parser/2.3.5"
        }
    ]
}
