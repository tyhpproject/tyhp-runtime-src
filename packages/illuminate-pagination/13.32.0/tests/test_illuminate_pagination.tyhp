<?tyhp

function test_cursor(): \Illuminate\Pagination\Cursor
{
    return new \Illuminate\Pagination\Cursor(['id' => '1']);
}

function test_cursor_encode(\Illuminate\Pagination\Cursor $cursor): string
{
    return $cursor->encode();
}

function test_paginator(): \Illuminate\Pagination\Paginator<int|string, string>
{
    array<int|string, string> $items = ['a', 'b'];
    return new \Illuminate\Pagination\Paginator(collect($items), 15);
}
