<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Bags, header maps, request methods, cookie SameSite, and getContent overloads from PHPDoc / runtime.
 */

namespace Symfony\Component\HttpFoundation {
    /**
     * Tyhp encoding of header ctor maps (L1 is bare `array`).
     */
    type HeaderMap = array<string, string|array<int, string>>;

    /**
     * Tyhp encoding of HeaderBag::set PHPDoc `@param string|string[]|null $values`.
     */
    type HeaderValue = string|array<int|string, string|null>|null;

    /**
     * Tyhp encoding of `Request::METHOD_*` plus `string` (vendor allows other tokens).
     */
    type HttpMethod = 'GET'|'POST'|'PUT'|'PATCH'|'DELETE'|'HEAD'|'OPTIONS'|'TRACE'|'CONNECT'|'PURGE'|'QUERY'|string;

    /**
     * Tyhp encoding of query / cookie / request / attributes / server maps (L1 is bare `array`).
     */
    type ParameterMap = array<string, mixed>;

    /**
     * One input value. Nested arrays use the same value union (`InputBag::set`).
     */
    type InputValue = string|int|float|bool|array<string, InputValue>|null;

    /**
     * Tyhp encoding of PHPDoc `@param self::SAMESITE_*|''|null` (L1 is `?string`).
     */
    type SameSite = 'none'|'lax'|'strict'|''|null;

    /**
     * Tyhp encoding of PHPDoc `@param self::SAMESITE_*|''|null`.
     */
    // @overlay-against: class Cookie
    partial class Cookie {
        /**
         * @param \Symfony\Component\HttpFoundation\SameSite $sameSite
         */
        // @overlay-against: function create(string $name, ?string $value, int|string|\DateTimeInterface $expire, ?string $path, ?string $domain, ?bool $secure, bool $httpOnly, bool $raw, ?string $sameSite, bool $partitioned): self
        public static function create(string $name, ?string $value = null, int|string|\DateTimeInterface $expire = 0, ?string $path = '/', ?string $domain = null, ?bool $secure = null, bool $httpOnly = true, bool $raw = false, \Symfony\Component\HttpFoundation\SameSite $sameSite = self::SAMESITE_LAX, bool $partitioned = false): self;

        /**
         * @param \Symfony\Component\HttpFoundation\SameSite $sameSite
         */
        // @overlay-against: function __construct(string $name, ?string $value, int|string|\DateTimeInterface $expire, ?string $path, ?string $domain, ?bool $secure, bool $httpOnly, bool $raw, ?string $sameSite, bool $partitioned): void
        public function __construct(string $name, ?string $value = null, int|string|\DateTimeInterface $expire = 0, ?string $path = '/', ?string $domain = null, ?bool $secure = null, bool $httpOnly = true, bool $raw = false, \Symfony\Component\HttpFoundation\SameSite $sameSite = self::SAMESITE_LAX, bool $partitioned = false): void;

        /**
         * @return \Symfony\Component\HttpFoundation\SameSite
         */
        // @overlay-against: function getSameSite(): ?string
        public function getSameSite(): \Symfony\Component\HttpFoundation\SameSite;
    }

    /**
     * Tyhp encoding: header maps and `set()` values match PHP `@param` / `@return`.
     */
    // @overlay-against: class HeaderBag implements \IteratorAggregate, \Countable, \Stringable
    partial class HeaderBag {
        /**
         * @param \Symfony\Component\HttpFoundation\HeaderMap $headers
         */
        // @overlay-against: function __construct(array $headers): void
        public function __construct(\Symfony\Component\HttpFoundation\HeaderMap $headers = []): void;

        /**
         * @param \Symfony\Component\HttpFoundation\HeaderMap $headers
         */
        // @overlay-against: function add(array $headers): void
        public function add(\Symfony\Component\HttpFoundation\HeaderMap $headers): void;

        /**
         * @return array<string, array<int, string|null>>
         */
        // @overlay-against: function all(?string $key): array
        public function all(null $key = null): array<string, array<int, string|null>>;

        /**
         * @return array<int, string|null>
         */
        // @overlay-against: function all(?string $key): array
        public function all(string $key): array<int, string|null>;

        /**
         * @return \ArrayIterator<string, array<int, string|null>>
         */
        // @overlay-against: function getIterator(): \ArrayIterator
        public function getIterator(): \ArrayIterator<string, array<int, string|null>>;

        /**
         * @param \Symfony\Component\HttpFoundation\HeaderMap $headers
         */
        // @overlay-against: function replace(array $headers): void
        public function replace(\Symfony\Component\HttpFoundation\HeaderMap $headers = []): void;

        /**
         * @param \Symfony\Component\HttpFoundation\HeaderValue $values
         */
        // @overlay-against: function set(string $key, string|array|null $values, bool $replace): void
        public function set(string $key, \Symfony\Component\HttpFoundation\HeaderValue $values, bool $replace = true): void;
    

        /**
         * @return array<string>
         */
        // @overlay-against: function keys(): array
        public function keys(): array<string>;
    }

    /**
     * Tyhp encoding of vendor `@template TInput of string|int|float|bool|null` with a default so unparameterized `InputBag` is usable.
     */
    // @overlay-against: class InputBag extends \Symfony\Component\HttpFoundation\ParameterBag
    partial class InputBag<TInput extends string|int|float|bool|null = string|int|float|bool|null>;

    /**
     * Tyhp encoding: `get()` is `TDefault|TInput`; maps match `set()` value union; `getEnum` uses class-string.
     */
    // @overlay-against: class InputBag extends \Symfony\Component\HttpFoundation\ParameterBag
    partial class InputBag {
        /**
         * @param array<string, \Symfony\Component\HttpFoundation\InputValue> $inputs
         */
        // @overlay-against: function add(array $inputs): void
        public function add(array<string, \Symfony\Component\HttpFoundation\InputValue> $inputs = []): void;

        /**
         * Overlay: restore `$filter = \FILTER_DEFAULT` (L1 dropped the default).
         */
        // @overlay-against: function filter(string $key, mixed $default, int $filter, mixed $options): mixed
        public function filter(string $key, mixed $default = null, int $filter = \FILTER_DEFAULT, mixed $options = []): mixed;

        /**
         * @param TDefault $default
         * @return TDefault|TInput
         */
        // @overlay-against: function get(string $key, TDefault $default): string|int|float|bool|null
        public function get<TDefault extends string|int|float|bool|null = null>(string $key, TDefault $default = null): TDefault|TInput;

        /**
         * @param \__ClassName<T> $class
         * @param ?T $default
         * @return ?T
         */
        // @overlay-against: function getEnum(string $key, string $class, ?\BackedEnum $default): ?\BackedEnum
        public function getEnum<T extends \BackedEnum>(string $key, \__ClassName<T> $class, ?T $default = null): ?T;

        /**
         * @param array<string, \Symfony\Component\HttpFoundation\InputValue> $inputs
         */
        // @overlay-against: function replace(array $inputs): void
        public function replace(array<string, \Symfony\Component\HttpFoundation\InputValue> $inputs = []): void;

        /**
         * @param string|int|float|bool|array<int|string, mixed>|null $value
         */
        // @overlay-against: function set(string $key, string|int|float|bool|array|null $value): void
        public function set(string $key, string|int|float|bool|array<int|string, mixed>|null $value): void;
    }

    /**
     * Tyhp encoding of `$ips` as a string or list of CIDR/IP strings (L1 is `string|array`).
     */
    // @overlay-against: class IpUtils
    partial class IpUtils {
        /**
         * @param string|array<int|string, string> $ips
         */
        // @overlay-against: function checkIp(string $requestIp, string|array $ips): bool
        public static function checkIp(string $requestIp, string|array<int|string, string> $ips): bool;
    }

    /**
     * Tyhp encoding: JSON constructor headers use `HeaderMap`.
     */
    // @overlay-against: class JsonResponse extends \Symfony\Component\HttpFoundation\Response
    partial class JsonResponse {
        /**
         * @param \Symfony\Component\HttpFoundation\HeaderMap $headers
         */
        // @overlay-against: function fromJsonString(string $data, int $status, array $headers): static
        public static function fromJsonString(string $data, int $status = 200, \Symfony\Component\HttpFoundation\HeaderMap $headers = []): static;

        /**
         * @param \Symfony\Component\HttpFoundation\HeaderMap $headers
         */
        // @overlay-against: function __construct(mixed $data, int $status, array $headers, bool $json): void
        public function __construct(mixed $data = null, int $status = 200, \Symfony\Component\HttpFoundation\HeaderMap $headers = [], bool $json = false): void;
    }

    /**
     * Tyhp encoding: `all()` overloads the PHPDoc conditional; `getEnum` uses class-string; restore FILTER_DEFAULT.
     */
    // @overlay-against: class ParameterBag implements \IteratorAggregate, \Countable
    partial class ParameterBag {
        /**
         * @return array<string, mixed> All parameters.
         */
        // @overlay-against: function all(?string $key): array
        public function all(null $key = null): array<string, mixed>;

        /**
         * @param string $key Nested parameter name.
         * @return array<int|string, mixed>
         */
        // @overlay-against: function all(?string $key): array
        public function all(string $key): array<int|string, mixed>;

        /**
         * Overlay: restore `$filter = \FILTER_DEFAULT` (L1 dropped the default).
         */
        // @overlay-against: function filter(string $key, mixed $default, int $filter, int|array $options): mixed
        public function filter(string $key, mixed $default = null, int $filter = \FILTER_DEFAULT, int|array $options = []): mixed;

        /**
         * Tyhp encoding of mixed-default identity: result matches the provided default's type when the key is missing.
         *
         * @param T $default
         * @return T
         */
        // @overlay-against: function get(string $key, mixed $default): mixed
        public function get<T = mixed>(string $key, T $default = null): T;

        /**
         * @param \__ClassName<T> $class
         * @param ?T $default
         * @return ?T
         */
        // @overlay-against: function getEnum(string $key, string $class, ?\BackedEnum $default): ?\BackedEnum
        public function getEnum<T extends \BackedEnum>(string $key, \__ClassName<T> $class, ?T $default = null): ?T;

        /**
         * @return \ArrayIterator<string, mixed>
         */
        // @overlay-against: function getIterator(): \ArrayIterator
        public function getIterator(): \ArrayIterator<string, mixed>;
    

        /**
         * @return array<string>
         */
        // @overlay-against: function keys(): array
        public function keys(): array<string>;
    }

    /**
     * Tyhp encoding: redirect headers use `HeaderMap`.
     */
    // @overlay-against: class RedirectResponse extends \Symfony\Component\HttpFoundation\Response
    partial class RedirectResponse {
        /**
         * @param \Symfony\Component\HttpFoundation\HeaderMap $headers
         */
        // @overlay-against: function __construct(string $url, int $status, array $headers): void
        public function __construct(string $url, int $status = 302, \Symfony\Component\HttpFoundation\HeaderMap $headers = []): void;
    }

    /**
     * Tyhp encoding: query/cookies are `InputBag<string>`; methods use `HttpMethod`; `getContent` overloads.
     */
    // @overlay-against: class Request
    partial class Request {
        /**
         * Cookies (`$_COOKIE`).
         */
        // @overlay-against: \Symfony\Component\HttpFoundation\InputBag $cookies
        public \Symfony\Component\HttpFoundation\InputBag<string> $cookies;

        /**
         * Query string parameters (`$_GET`).
         */
        // @overlay-against: \Symfony\Component\HttpFoundation\InputBag $query
        public \Symfony\Component\HttpFoundation\InputBag<string> $query;

        /**
         * @param \Symfony\Component\HttpFoundation\HttpMethod $method
         * @param \Symfony\Component\HttpFoundation\ParameterMap $parameters
         * @param \Symfony\Component\HttpFoundation\ParameterMap $cookies
         * @param array<string, mixed> $files
         * @param \Symfony\Component\HttpFoundation\ParameterMap $server
         */
        // @overlay-against: function create(string $uri, string $method, array $parameters, array $cookies, array $files, array $server, string|resource|null $content): static
        public static function create(
            string $uri,
            \Symfony\Component\HttpFoundation\HttpMethod $method = 'GET',
            \Symfony\Component\HttpFoundation\ParameterMap $parameters = [],
            \Symfony\Component\HttpFoundation\ParameterMap $cookies = [],
            array<string, mixed> $files = [],
            \Symfony\Component\HttpFoundation\ParameterMap $server = [],
            string|resource|null $content = null
        ): static;

        /**
         * @param array<int|string, string> $proxies
         */
        // @overlay-against: function setTrustedProxies(array $proxies, int $trustedHeaderSet): void
        public static function setTrustedProxies(array<int|string, string> $proxies, int $trustedHeaderSet): void;

        /**
         * @param \Symfony\Component\HttpFoundation\ParameterMap $query
         * @param \Symfony\Component\HttpFoundation\ParameterMap $request
         * @param \Symfony\Component\HttpFoundation\ParameterMap $attributes
         * @param \Symfony\Component\HttpFoundation\ParameterMap $cookies
         * @param array<string, mixed> $files
         * @param \Symfony\Component\HttpFoundation\ParameterMap $server
         */
        // @overlay-against: function __construct(array $query, array $request, array $attributes, array $cookies, array $files, array $server, string|resource|null $content): void
        public function __construct(
            \Symfony\Component\HttpFoundation\ParameterMap $query = [],
            \Symfony\Component\HttpFoundation\ParameterMap $request = [],
            \Symfony\Component\HttpFoundation\ParameterMap $attributes = [],
            \Symfony\Component\HttpFoundation\ParameterMap $cookies = [],
            array<string, mixed> $files = [],
            \Symfony\Component\HttpFoundation\ParameterMap $server = [],
            string|resource|null $content = null
        ): void;

        /**
         * @return array<int, string>
         */
        // @overlay-against: function getClientIps(): array
        public function getClientIps(): array<int, string>;

        /**
         * Tyhp encoding of psalm `$asResource is true ? resource : string`. Omitted/`false` returns the body string.
         *
         * @return string|false
         */
        // @overlay-against: function getContent(bool $asResource): mixed
        public function getContent(false $asResource = false): string|false;

        /**
         * Tyhp encoding: `$asResource = true` returns a stream resource (not array).
         *
         * @return resource
         */
        // @overlay-against: function getContent(bool $asResource): mixed
        public function getContent(true $asResource): resource;

        /**
         * @return array<int, string>
         */
        // @overlay-against: function getETags(): array
        public function getETags(): array<int, string>;

        /**
         * @return \Symfony\Component\HttpFoundation\HttpMethod
         */
        // @overlay-against: function getMethod(): string
        public function getMethod(): \Symfony\Component\HttpFoundation\HttpMethod;

        /**
         * @return \Symfony\Component\HttpFoundation\HttpMethod
         */
        // @overlay-against: function getRealMethod(): string
        public function getRealMethod(): \Symfony\Component\HttpFoundation\HttpMethod;

        /**
         * @param \Symfony\Component\HttpFoundation\ParameterMap $query
         * @param \Symfony\Component\HttpFoundation\ParameterMap $request
         * @param \Symfony\Component\HttpFoundation\ParameterMap $attributes
         * @param \Symfony\Component\HttpFoundation\ParameterMap $cookies
         * @param array<string, mixed> $files
         * @param \Symfony\Component\HttpFoundation\ParameterMap $server
         */
        // @overlay-against: function initialize(array $query, array $request, array $attributes, array $cookies, array $files, array $server, string|resource|null $content): void
        public function initialize(
            \Symfony\Component\HttpFoundation\ParameterMap $query = [],
            \Symfony\Component\HttpFoundation\ParameterMap $request = [],
            \Symfony\Component\HttpFoundation\ParameterMap $attributes = [],
            \Symfony\Component\HttpFoundation\ParameterMap $cookies = [],
            array<string, mixed> $files = [],
            \Symfony\Component\HttpFoundation\ParameterMap $server = [],
            string|resource|null $content = null
        ): void;

        /**
         * @param \Symfony\Component\HttpFoundation\HttpMethod $method
         */
        // @overlay-against: function isMethod(string $method): bool
        public function isMethod(\Symfony\Component\HttpFoundation\HttpMethod $method): bool;

        /**
         * @param \Symfony\Component\HttpFoundation\HttpMethod $method
         */
        // @overlay-against: function setMethod(string $method): void
        public function setMethod(\Symfony\Component\HttpFoundation\HttpMethod $method): void;

        /**
         * @return array<int|string, mixed>
         */
        // @overlay-against: function toArray(): array
        public function toArray(): array<int|string, mixed>;
    

        /**
         * @return array<string>
         */
        // @overlay-against: function getMimeTypes(string $format): array
        public static function getMimeTypes(string $format): array<string>;

        /**
         * @return array<string>
         */
        // @overlay-against: function getTrustedHosts(): array
        public static function getTrustedHosts(): array<string>;

        /**
         * @return array<string>
         */
        // @overlay-against: function getTrustedProxies(): array
        public static function getTrustedProxies(): array<string>;

        /**
         * @return array<string>
         */
        // @overlay-against: function getAcceptableContentTypes(): array
        public function getAcceptableContentTypes(): array<string>;

        /**
         * @return array<string>
         */
        // @overlay-against: function getCharsets(): array
        public function getCharsets(): array<string>;

        /**
         * @return array<string>
         */
        // @overlay-against: function getEncodings(): array
        public function getEncodings(): array<string>;

        /**
         * @return array<string>
         */
        // @overlay-against: function getLanguages(): array
        public function getLanguages(): array<string>;

        /**
         * @param array<string> $locales
         */
        // @overlay-against: function getPreferredLanguage(array $locales): ?string
        public function getPreferredLanguage(array<string> $locales = null): ?string;

        /**
         * @param string|array<string> $mimeTypes
         */
        // @overlay-against: function setFormat(?string $format, string|array $mimeTypes): void
        public function setFormat(?string $format, string|array<string> $mimeTypes): void;
    }

