<?tyhp

function test_csv_reader_from_string(): \League\Csv\Reader
{
    return \League\Csv\Reader::fromString("name,age\nAda,36");
}

function test_csv_writer_insert_one(): int
{
    return \League\Csv\Writer::fromString('')->insertOne(['Ada', '36']);
}

function test_csv_writer_insert_all(): int
{
    return \League\Csv\Writer::fromString('')->insertAll([
        ['name', 'age'],
        ['Ada', '36'],
    ]);
}

function test_csv_statement(\League\Csv\Reader $reader): \League\Csv\TabularDataReader
{
    return (new \League\Csv\Statement())->process($reader);
}

function test_csv_header(\League\Csv\Reader $reader): array<int|string, string>
{
    return $reader->setHeaderOffset(0)->getHeader();
}
