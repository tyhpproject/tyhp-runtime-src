    }

    /**
     * Overlay: `from()` takes a path, SPL file, or stream resource like `AbstractCsv`.
     */
    // @overlay-against: class Reader extends \League\Csv\AbstractCsv implements \League\Csv\TabularDataReader, \JsonSerializable
    partial class Reader {
        /**
         * @param \SplFileInfo|\SplFileObject|resource|string $filename
         * @param resource|null $context
         */
        // @overlay-against: function from(mixed $filename, string $mode, mixed $context): static
        public static function from(\SplFileInfo|\SplFileObject|resource|string $filename, string $mode = 'r', resource|null $context = null): static;

        // @overlay-against: function firstAsObject(string $className, array $header): ?object
        public function firstAsObject(\__ClassName<object> $className, array $header = []): object|null;

        /**
         * @return array<int|string, string>
         */
        // @overlay-against: function getHeader(): array
        public function getHeader(): array<int|string, string>;

        // @overlay-against: function getIterator(): \Iterator
        public function getIterator(): \Iterator<int|string, TValue>;

        // @overlay-against: function getRecords(array $header): \Iterator
        public function getRecords(array<int, string> $header = []): \Iterator<int|string, \League\Csv\TabularRecord>;

        // @overlay-against: function getRecordsAsObject(string $className, array $header): \Iterator
        public function getRecordsAsObject<T extends object>(\__ClassName<T> $className, array<string> $header = []): \Iterator<int|string, T>;

        // @overlay-against: function lastAsObject(string $className, array $header): ?object
        public function lastAsObject(\__ClassName<object> $className, array $header = []): object|null;

        // @overlay-against: function nthAsObject(int $nth, string $className, array $header): ?object
        public function nthAsObject(int $nth, \__ClassName<object> $className, array $header = []): object|null;
    }

