namespace League\Csv\Query\Constraint {
    /**
     * Overlay: predicates are called as `$predicate($value, $key)`.
     * The value and key are `mixed` and `int|string` in the body.
     * The result is only tested for truthiness, so the callback return stays `mixed`.
     */
    // @overlay-against: class Criteria implements \League\Csv\Query\PredicateCombinator
    partial class Criteria {
        // @overlay-against: function all(\League\Csv\Query\Predicate|\Closure|callable $predicates): self
        public static function all((\League\Csv\Query\Predicate|\Closure<callable(mixed, int|string): mixed>|(callable(mixed, int|string): mixed)) ...$predicates): self;

        // @overlay-against: function any(\League\Csv\Query\Predicate|\Closure|callable $predicates): self
        public static function any((\League\Csv\Query\Predicate|\Closure<callable(mixed, int|string): mixed>|(callable(mixed, int|string): mixed)) ...$predicates): self;

        // @overlay-against: function none(\League\Csv\Query\Predicate|\Closure|callable $predicates): self
        public static function none((\League\Csv\Query\Predicate|\Closure<callable(mixed, int|string): mixed>|(callable(mixed, int|string): mixed)) ...$predicates): self;

        // @overlay-against: function xany(\League\Csv\Query\Predicate|\Closure|callable $predicates): self
        public static function xany((\League\Csv\Query\Predicate|\Closure<callable(mixed, int|string): mixed>|(callable(mixed, int|string): mixed)) ...$predicates): self;
    }
