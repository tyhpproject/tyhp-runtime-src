<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Record maps and `Reader::from()` filename union from the PHP source.
 */

namespace League\Csv {
    /**
     * One CSV record: scalars, null, or stringable objects, keyed by offset or header name.
     */
    type CsvRecord = array<int|string, null|int|float|string|\Stringable>;

    /**
     * One tabular record: header fields are strings or null (`TabularData::getRecords`).
     */
    type TabularRecord = array<int|string, string|null>;

    /**
     * Overlay: records match `TabularData`; class-name parameters are `__ClassName`.
     */
    // @overlay-against: class Buffer implements \League\Csv\TabularData
    partial class Buffer {
        // @overlay-against: function firstAsObject(string $className, array $header): ?object
        public function firstAsObject(\__ClassName<object> $className, array<string> $header = []): object|null;

        // @overlay-against: function getRecords(array $header): \Iterator
        public function getRecords(array<int, string> $header = []): \Iterator<int|string, \League\Csv\TabularRecord>;

        // @overlay-against: function getRecordsAsObject(string $className, array $header): \Iterator
        public function getRecordsAsObject<T extends object>(\__ClassName<T> $className, array<string> $header = []): \Iterator<int|string, T>;

        // @overlay-against: function lastAsObject(string $className, array $header): ?object
        public function lastAsObject(\__ClassName<object> $className, array<string> $header = []): object|null;

        // @overlay-against: function nthAsObject(int $nth, string $className, array $header): ?object
        public function nthAsObject<T extends object>(int $nth, \__ClassName<T> $className, array<string> $header = []): ?T;
    }

    /**
     * Overlay: `__invoke` feeds each field to `encodeField`.
     */
    // @overlay-against: class CharsetConverter extends \php_user_filter
    partial class CharsetConverter {
        // @overlay-against: function __invoke(array $record): array
        public function __invoke(array<int|string, int|float|string|null> $record): array<int|string, int|float|string|null>;
    }

