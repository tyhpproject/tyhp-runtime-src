     */
    // @overlay-against: interface TabularData
    partial interface TabularData {
        // @overlay-against: function firstAsObject(string $className, array $header): object|null
        public function firstAsObject(\__ClassName<object> $className, array $header): object|null;

        // @overlay-against: function getRecords(array $header): \Iterator
        public function getRecords(array<int, string> $header = []): \Iterator<int|string, \League\Csv\TabularRecord>;

        // @overlay-against: function getRecordsAsObject(string $className, array $header): \Iterator
        public function getRecordsAsObject(\__ClassName<object> $className, array $header): \Iterator<int|string, object>;

        // @overlay-against: function lastAsObject(string $className, array $header): object|null
        public function lastAsObject(\__ClassName<object> $className, array $header): object|null;

        // @overlay-against: function nthAsObject(int $nth, string $className, array $header): object|null
        public function nthAsObject(int $nth, \__ClassName<object> $className, array $header): object|null;
    }

    /**
     * Overlay: rows are `Iterator<array-key, TValue>` (`array-key` is `int|string`).
     */
    // @overlay-against: interface TabularDataReader
    partial interface TabularDataReader {
        // @overlay-against: function each(\Closure $callback): bool
        public function each(\Closure<callable(TValue, int|string): mixed> $callback): bool;

        // @overlay-against: function exists(\Closure $callback): bool
        public function exists(\Closure<callable(TValue, int|string): mixed> $callback): bool;

        // @overlay-against: function getIterator(): \Iterator
        public function getIterator(): \Iterator<int|string, TValue>;

        // @overlay-against: function reduce(\Closure $callback, mixed $initial): mixed
        public function reduce(\Closure<callable(mixed, TValue, int|string): mixed> $callback, mixed $initial): mixed;
    }

    /**
     * Overlay: insert records are `CsvRecord` maps (Tyhp list literals included).
     */
    // @overlay-against: interface TabularDataWriter
    partial interface TabularDataWriter {
        /**
         * @param iterable<\League\Csv\CsvRecord> $records
         */
        // @overlay-against: function insertAll(iterable $records): int
        public function insertAll(iterable<\League\Csv\CsvRecord> $records): int;

        /**
         * @param \League\Csv\CsvRecord $record
         */
        // @overlay-against: function insertOne(array $record): int
        public function insertOne(\League\Csv\CsvRecord $record): int;
    }

    /**
     * Overlay: Writer insert methods accept the same record map as the interface.
     */
    // @overlay-against: class Writer extends \League\Csv\AbstractCsv implements \League\Csv\TabularDataWriter
    partial class Writer {
        // @overlay-against: function formatRecord(array $record, callable $formatter): array
        deprecated protected function formatRecord(array $record, callable(array): array $formatter): array;

        /**
         * @param \League\Csv\TabularDataProvider|\League\Csv\TabularData|iterable<\League\Csv\CsvRecord> $records
         */
        // @overlay-against: function insertAll(\League\Csv\TabularDataProvider|\League\Csv\TabularData|iterable $records): int
        public function insertAll(\League\Csv\TabularDataProvider|\League\Csv\TabularData|iterable<\League\Csv\CsvRecord> $records): int;

        /**
         * @param \League\Csv\CsvRecord $record
         */
        // @overlay-against: function insertOne(array $record): int
        public function insertOne(\League\Csv\CsvRecord $record): int;
    }

    /**
     * Overlay: `when()` calls the condition and the success/fail callbacks with this converter.
     */
    // @overlay-against: class XMLConverter
    partial class XMLConverter {
