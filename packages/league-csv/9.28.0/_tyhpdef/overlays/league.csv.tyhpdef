    }
}

namespace League\Csv {
    // @overlay-against: class ResultSet implements \League\Csv\TabularDataReader, \JsonSerializable
    partial class ResultSet {
        // @overlay-against: function __construct(\Iterator|array $records, array $header): void
        public function __construct(\Iterator|array<int|string, array<int|string, mixed>> $records = [], array<string> $header = []): void;

        // @overlay-against: function each(callable $callback): bool
        public function each(callable(TValue, int|string): mixed $callback): bool;

        // @overlay-against: function exists(callable $callback): bool
