<?tyhp

function test_console_application_find(): \Symfony\Component\Console\Command\Command
{
    $app = new \Symfony\Component\Console\Application('demo', '1.0.0');
    $app->addCommand(new \Symfony\Component\Console\Command\Command('hello'));
    return $app->find('hello');
}

function test_console_array_input(): mixed
{
    $input = new \Symfony\Component\Console\Input\ArrayInput(['command' => 'hello', 'name' => 'tyhp']);
    return $input->getArgument('name');
}

function test_console_null_output(\Symfony\Component\Console\Output\OutputInterface $output): void
{
    $output->writeln(['ok', 'done']);
}

function test_console_command_status(): int
{
    return \Symfony\Component\Console\Command\Command::SUCCESS;
}
