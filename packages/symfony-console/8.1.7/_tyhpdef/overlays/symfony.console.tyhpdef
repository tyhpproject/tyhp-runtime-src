namespace Symfony\Component\Console\Descriptor {
    /**
     * Harvest miss: `@internal` base omitted from Layer 1. `ReStructuredTextDescriptor` extends it.
     */
    abstract class Descriptor implements \Symfony\Component\Console\Descriptor\DescriptorInterface {
        protected \Symfony\Component\Console\Output\OutputInterface $output;

        abstract protected function describeApplication(\Symfony\Component\Console\Application $application, array<string, mixed> $options = []): void;

        abstract protected function describeCommand(\Symfony\Component\Console\Command\Command $command, array<string, mixed> $options = []): void;

        abstract protected function describeInputArgument(\Symfony\Component\Console\Input\InputArgument $argument, array<string, mixed> $options = []): void;

        abstract protected function describeInputDefinition(\Symfony\Component\Console\Input\InputDefinition $definition, array<string, mixed> $options = []): void;

        abstract protected function describeInputOption(\Symfony\Component\Console\Input\InputOption $option, array<string, mixed> $options = []): void;

        public function describe(\Symfony\Component\Console\Output\OutputInterface $output, object $object, array<string, mixed> $options = []): void;

        protected function write(string $content, bool $decorated = false): void;
    }
}

