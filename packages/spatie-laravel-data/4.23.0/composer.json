{
    "name": "tyhpdef/spatie-laravel-data",
    "description": "Tyhp type definitions for the Composer package spatie/laravel-data (4.23.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "4.23.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": "8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/spatie-laravel-package-tools": "@dev",
                "tyhpdef/phpdocumentor-reflection-common": "@dev",
                "tyhpdef/phpdocumentor-reflection-docblock": "@dev",
                "tyhpdef/phpdocumentor-type-resolver": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "spatie/laravel-data": "4.23.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/spatie-laravel-package-tools": "@dev",
        "tyhpdef/phpdocumentor-reflection-common": "@dev",
        "tyhpdef/phpdocumentor-reflection-docblock": "@dev",
        "tyhpdef/phpdocumentor-type-resolver": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../laravel-framework/13.32.0"
        },
        {
            "type": "path",
            "url": "../../spatie-laravel-package-tools/1.93.2"
        },
        {
            "type": "path",
            "url": "../../phpdocumentor-reflection-common/2.2.0"
        },
        {
            "type": "path",
            "url": "../../phpdocumentor-reflection-docblock/6.0.3"
        },
        {
            "type": "path",
            "url": "../../phpdocumentor-type-resolver/2.0.0"
        }
    ]
}
