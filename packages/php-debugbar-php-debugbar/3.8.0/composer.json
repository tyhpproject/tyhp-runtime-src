{
    "name": "tyhpdef/php-debugbar-php-debugbar",
    "description": "Tyhp type definitions for the Composer package php-debugbar/php-debugbar (3.8.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "3.8.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/symfony-var-dumper": "@dev",
                "tyhpdef/php-ext-pdo": "@dev",
                "tyhpdef/php-ext-memcached": "@dev",
                "tyhpdef/php-ext-redis": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "php-debugbar/php-debugbar": "3.8.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/symfony-var-dumper": "@dev",
        "tyhpdef/php-ext-pdo": "@dev",
        "tyhpdef/php-ext-memcached": "@dev",
        "tyhpdef/php-ext-redis": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../psr-log/3.0.2"
        },
        {
            "type": "path",
            "url": "../../symfony-var-dumper/7.4.18"
        },
        {
            "type": "path",
            "url": "../../php-ext-pdo"
        },
        {
            "type": "path",
            "url": "../../php-ext-memcached"
        },
        {
            "type": "path",
            "url": "../../php-ext-redis"
        }
    ]
}
