{
    "name": "tyhpdef/phpspec-prophecy-phpunit",
    "description": "Tyhp type definitions for the Composer package phpspec/prophecy-phpunit (2.5.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.5.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.3",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/phpspec-prophecy": "@dev",
                "tyhpdef/phpunit-phpunit": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "phpspec/prophecy-phpunit": "2.5.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/phpspec-prophecy": "@dev",
        "tyhpdef/phpunit-phpunit": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../phpspec-prophecy/1.26.1"
        },
        {
            "type": "path",
            "url": "../../phpunit-phpunit/12.5.35"
        }
    ]
}
