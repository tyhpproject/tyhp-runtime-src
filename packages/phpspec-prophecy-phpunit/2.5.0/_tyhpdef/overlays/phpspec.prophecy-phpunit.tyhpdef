namespace Prophecy\PhpUnit {
    /**
     * Overlay: prophesize() returns ObjectProphecy<T>; PHPUnit TestCase is path-linked.
     */
    // @overlay-against: trait ProphecyTrait
    partial trait ProphecyTrait {
        /**
         * @param \__ClassName<T>|\__InterfaceName<T> $classOrInterface
         * @return \Prophecy\Prophecy\ObjectProphecy<T>
         */
        // @overlay-against: function prophesize(?string $classOrInterface): \Prophecy\Prophecy\ObjectProphecy
        protected function prophesize<T extends object>(\__ClassName<T>|\__InterfaceName<T> $classOrInterface): \Prophecy\Prophecy\ObjectProphecy<T>;

        /**
         * @return \Prophecy\Prophecy\ObjectProphecy<object>
         */
        // @overlay-against: function prophesize(?string $classOrInterface): \Prophecy\Prophecy\ObjectProphecy
        protected function prophesize(?string $classOrInterface = null): \Prophecy\Prophecy\ObjectProphecy<object>;
    }
}
