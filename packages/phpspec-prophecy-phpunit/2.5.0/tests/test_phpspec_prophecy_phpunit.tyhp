<?tyhp

function test_prophecy_phpunit_trait(): string
{
    return \Prophecy\PhpUnit\ProphecyTrait::class;
}

final class ProphecyPhpunitHarness
{
    use \Prophecy\PhpUnit\ProphecyTrait;

    public function exposeProphesize(): \Prophecy\Prophecy\ObjectProphecy<\stdClass>
    {
        return $this->prophesize<\stdClass>(\stdClass::class);
    }
}

function test_prophecy_phpunit_harness_prophesize(): \Prophecy\Prophecy\ObjectProphecy<\stdClass>
{
    $harness = new ProphecyPhpunitHarness();
    return $harness->exposeProphesize();
}
