{
  "name": "tyhp/lambda",
  "description": "Tyhp parsable lambdas: PropertyPath and Expression tree runtime classes",
  "type": "library",
  "license": "Apache-2.0",
  "version": "0.1",
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "require": {
        "tyhpdef/php": "@dev"
      },
      "package": {
        "include": [
          "./package.tyhpdef"
        ],
        "exclude": [],
        "overlay": [],
        "source": {
          "tagless": false
        }
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "tyhp/core": "@dev"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhp/compiler": "@dev"
  },
  "autoload": {
    "psr-4": {
      "Tyhp\\": "src/Tyhp/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tyhp\\Tests\\Lambda\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../php"
    },
    {
      "type": "path",
      "url": "../dist/tyhp-core/802.latest"
    },
    {
      "type": "path",
      "url": "../compiler"
    }
  ],
  "config": {
    "allow-plugins": {
      "tyhp/core": true
    }
  }
}
