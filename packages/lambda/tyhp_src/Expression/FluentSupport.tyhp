<?tyhp

namespace Tyhp\Expression;

use Tyhp\Expression;

/**
 * Shared helpers for {@see \Tyhp\PropertyPathBuilder} and {@see \Tyhp\ExpressionBuilder}.
 *
 * @internal
 */
final class FluentSupport {
    /**
     * Normalize `of()` segment arguments into a flat list of property names.
     *
     * Supports `of($class, 'a', 'b')` and `of($class, ['a', 'b'])` — not dotted strings.
     *
     * @param string|array<string> ...$segments
     * @return array<string>
     */
    public static function resolveSegments(string|array ...$segments): array<string> {
        if ($segments === []) {
            return [];
        }

        if (\count($segments) === 1 && \is_array($segments[0])) {
            array<string> $fromArray = [];
            foreach ($segments[0] as $segment) {
                if (!($segment is string)) {
                    throw new \InvalidArgumentException(
                        'Property path segments array must contain only strings.',
                    );
                }
                $fromArray[] = $segment;
            }
            return $fromArray;
        }

        array<string> $path = [];
        foreach ($segments as $segment) {
            if (!($segment is string)) {
                throw new \InvalidArgumentException(
                    'Property path segments must be strings, or a single array of strings.',
                );
            }
            $path[] = $segment;
        }
        return $path;
    }

    /**
     * Build a getter closure for a property / assoc-key chain, honoring per-segment null-safe flags.
     *
     * The source stays {@see mixed}: {@see \Tyhp\PropertyPath::getValue} and comparison
     * closures pass mixed, and nested hops are untyped even when the builder root is an object.
     * Each hop narrows to array (including Tyhp structs, which emit as arrays),
     * {@see \ArrayAccess}, or object before reading.
     *
     * @param array<string> $path
     * @param array<bool> $nullSafeFlags
     */
    public static function synthesizePathCallable(array<string> $path, array<bool> $nullSafeFlags): \Closure {
        return static function (mixed $source) use ($path, $nullSafeFlags): mixed {
            mixed $value = $source;
            int $count = \count($path);
            for (int $i = 0; $i < $count; $i++) {
                $value = self::readPathSegment($value, $path[$i], $nullSafeFlags[$i] ?? false);
            }
            return $value;
        };
    }

    /**
     * Read one path segment from an object property, array/struct key, or ArrayAccess offset.
     *
     * Null-safe hops return null when the receiver is null, the key/offset is missing, or the
     * value is not object-like. Strict hops throw {@see \TypeError} in those cases.
     */
    private static function readPathSegment(mixed $value, string $segment, bool $nullSafe): mixed {
        if ($value === null) {
            if ($nullSafe) {
                return null;
            }
            throw new \TypeError('Cannot read path segment "' . $segment . '" on null.');
        }

        // Structs compile to associative arrays; `\is_array` is the runtime (and Tyhp) guard
        // for both `array<…>` and struct values.
        if (\is_array($value)) {
            if (!\array_key_exists($segment, $value)) {
                if ($nullSafe) {
                    return null;
                }
                throw new \TypeError(
                    'Cannot read path segment "' . $segment . '" on array: key does not exist.',
                );
            }
            return $value[$segment];
        }

        if ($value is \ArrayAccess) {
            if (!$value->offsetExists($segment)) {
                if ($nullSafe) {
                    return null;
                }
                throw new \TypeError(
                    'Cannot read path segment "' . $segment . '" on ArrayAccess: offset does not exist.',
                );
            }
            return $value->offsetGet($segment);
        }

        if (\is_object($value)) {
            return $value->{$segment};
        }

        if ($nullSafe) {
            return null;
        }

        throw new \TypeError(
            'Cannot read path segment "' . $segment . '" on ' . \get_debug_type($value)
            . '; expected object, array, or ArrayAccess.',
        );
    }

    /**
     * Build the expression-tree body for a property chain (null-safe aware).
     *
     * @param array<string> $path
     * @param array<bool> $nullSafeFlags
     * @return \Tyhp\Expression\Structs\PathNode
     */
    public static function buildPathNodes(
        string $sourceType,
        array<string> $path,
        array<bool> $nullSafeFlags,
    ): \Tyhp\Expression\Structs\PathNode {
        ParameterExpression $paramExpr = new ParameterExpression('source', $sourceType, 0);
        ExpressionNode $body = $paramExpr;

        int $count = \count($path);
        for (int $i = 0; $i < $count; $i++) {
            string $segment = $path[$i];
            bool $nullSafe = $nullSafeFlags[$i] ?? false;
            if ($nullSafe) {
                $body = new NullSafeAccessExpression($body, $segment, 'mixed');
            } else {
                $body = new PropertyAccessExpression($body, $segment, 'mixed');
            }
        }

        return new \Tyhp\Expression\Structs\PathNode() with [
            parameterExpression => $paramExpr,
            body => $body
        ];
    }

    public static function evaluateBinary(mixed $left, string $operator, mixed $right): bool {
        return match ($operator) {
            '>' => $left > $right,
            '>=' => $left >= $right,
            '<' => $left < $right,
            '<=' => $left <= $right,
            '==' => $left == $right,
            '!=' => $left != $right,
            '===' => $left === $right,
            '!==' => $left !== $right,
            default => throw new \InvalidArgumentException("Unsupported binary operator: {$operator}"),
        };
    }

    /**
     * Combine two expressions with `&&` or `||` into a boolean expression.
     */
    public static function combine(
        Expression $left,
        Expression $right,
        string $operator,
    ): Expression<callable(mixed): bool> {
        if ($operator !== '&&' && $operator !== '||') {
            throw new \InvalidArgumentException("Unsupported combinator: {$operator}");
        }

        ExpressionNode $body = new BinaryExpression($left->body, $operator, $right->body, 'bool');
        \Closure $leftCallable = $left->callable;
        \Closure $rightCallable = $right->callable;
        \Closure $callable = static function (mixed ...$args) use ($leftCallable, $rightCallable, $operator): bool {
            if ($operator === '&&') {
                return (bool) $leftCallable(...$args) && (bool) $rightCallable(...$args);
            }
            return (bool) $leftCallable(...$args) || (bool) $rightCallable(...$args);
        };

        return new Expression<callable(mixed): bool>($body, $left->parameters, $callable, 'bool');
    }

    /**
     * @param array<Expression<callable(mixed): bool>> $expressions
     */
    public static function combineAll(
        array<Expression<callable(mixed): bool>> $expressions,
        string $operator,
    ): Expression<callable(mixed): bool> {
        if ($expressions === []) {
            throw new \InvalidArgumentException('At least one expression is required.');
        }

        Expression<callable(mixed): bool> $result = $expressions[0];
        int $count = \count($expressions);
        for (int $i = 1; $i < $count; $i++) {
            $result = self::combine($result, $expressions[$i], $operator);
        }
        return $result;
    }
}
