namespace Illuminate\Contracts\Container {
    /**
     * Overlay: `get(Foo::class)` returns `Foo`; other string ids stay generic.
     */
    // @overlay-against: interface Container
    partial interface Container {
        /**
         * @param \__ClassName<T> $id
         * @return T
         */
        // @overlay-against: function get(string $id): mixed
        public function get<T extends object>(\__ClassName<T> $id): T;

        /**
         * @param string $id
         * @return T
         */
        // @overlay-against: function get(string $id): mixed
        public function get<T = mixed>(string $id): T;
    }
}

