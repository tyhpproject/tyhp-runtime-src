{
  "name": "tyhpdef/illuminate-contracts",
  "description": "Tyhp type definitions for the Composer package illuminate/contracts (13.32.0).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "13.32.0.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-simple-cache": "@dev",
        "tyhpdef/psr-container": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "illuminate/contracts": "13.32.0"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/psr-simple-cache": "@dev",
    "tyhpdef/psr-container": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../psr-container/2.0.2"
    },
    {
      "type": "path",
      "url": "../../psr-simple-cache/3.0.0"
    }
  ]
}
