<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `lazy()` / `proxy()` are `fallback function` because the PHP declaration in
 * helpers.php is gated by `function_exists`. Attribute lookups take class-string ids.
 */

/**
 * Overlay: `lazy($class)` returns an instance of that class.
 *
 * @param \__ClassName<TValue>|\Closure $class
 * @return TValue
 */
fallback function lazy<TValue extends object>(\__ClassName<TValue>|\Closure $class, \Closure|int $callback = 0, int $options = 0, array<string, mixed> $eager = []): TValue;

/**
 * Overlay: `proxy($class)` returns a lazy proxy of that class.
 *
 * @param \__ClassName<TValue>|\Closure $class
 * @return TValue
 */
fallback function proxy<TValue extends object>(\__ClassName<TValue>|\Closure $class, \Closure|int $callback = 0, int $options = 0, array<string, mixed> $eager = []): TValue;

namespace Illuminate\Support {
    /**
     * Overlay: attribute class-strings yield that attribute type.
     */
    // @overlay-against: class Reflector
    partial class Reflector {
        /**
         * @param object|\__ClassName<object> $objectOrClass
         * @param \__ClassName<TAttribute> $attribute
         */
        // @overlay-against: function getClassAttribute(object|string $objectOrClass, string $attribute, bool $ascend): TAttribute|null
        public static function getClassAttribute<TAttribute extends object>(object|\__ClassName<object> $objectOrClass, \__ClassName<TAttribute> $attribute, bool $ascend = false): TAttribute|null;

        /**
         * @param TTarget|\__ClassName<TTarget> $objectOrClass
         * @param \__ClassName<TAttribute> $attribute
         * @return \Illuminate\Support\Collection<int, TAttribute>
         */
        // @overlay-against: function getClassAttributes(TTarget|string $objectOrClass, string $attribute, bool $includeParents): mixed
        public static function getClassAttributes<TTarget extends object, TAttribute extends object>(TTarget|\__ClassName<TTarget> $objectOrClass, \__ClassName<TAttribute> $attribute, false $includeParents = false): \Illuminate\Support\Collection<int, TAttribute>;
        // @overlay-against: function getClassAttributes(TTarget|string $objectOrClass, string $attribute, bool $includeParents): mixed
        public static function getClassAttributes<TTarget extends object, TAttribute extends object>(TTarget|\__ClassName<TTarget> $objectOrClass, \__ClassName<TAttribute> $attribute, true $includeParents): \Illuminate\Support\Collection<__ClassName<TTarget>, \Illuminate\Support\Collection<int, TAttribute>>;
        // @overlay-against: function getClassAttributes(TTarget|string $objectOrClass, string $attribute, bool $includeParents): mixed
        public static function getClassAttributes<TTarget extends object, TAttribute extends object>(TTarget|\__ClassName<TTarget> $objectOrClass, \__ClassName<TAttribute> $attribute, bool $includeParents): \Illuminate\Support\Collection<int, TAttribute>|\Illuminate\Support\Collection<__ClassName<TTarget>, \Illuminate\Support\Collection<int, TAttribute>>;

        /**
         * @return array<int, \__ClassName>
         */
        // @overlay-against: function getParameterClassNames(\ReflectionParameter $parameter): array
        public static function getParameterClassNames(\ReflectionParameter $parameter): array<int, __ClassName>;
    }
}

namespace Illuminate\Support\Traits {
    /**
     * Overlay: closure parameter type maps are string lists.
     */
    // @overlay-against: trait ReflectsClosures
    partial trait ReflectsClosures {
        /**
         * @return array<int, string>
         */
        // @overlay-against: function firstClosureParameterTypes(\Closure $closure): array
        protected function firstClosureParameterTypes(\Closure $closure): array<int, __ClassName>;

        /**
         * @return array<string, string>
         */
        // @overlay-against: function closureParameterTypes(\Closure $closure): array
        protected function closureParameterTypes(\Closure $closure): array<string, __ClassName>;
    }
}
