<?tyhp

function test_reflector_is_callable(): bool
{
    return \Illuminate\Support\Reflector::isCallable('strlen');
}

function test_reflector_parameter_class(\ReflectionParameter $parameter): string|null
{
    return \Illuminate\Support\Reflector::getParameterClassName($parameter);
}

function test_reflector_parameter_class_names(\ReflectionParameter $parameter): array<int, string>
{
    return \Illuminate\Support\Reflector::getParameterClassNames($parameter);
}

function test_lazy_stdclass(): \stdClass
{
    return lazy(\stdClass::class);
}
