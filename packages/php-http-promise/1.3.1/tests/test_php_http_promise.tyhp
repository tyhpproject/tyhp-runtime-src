<?tyhp

function test_php_http_promise_then(\Http\Promise\Promise $promise, callable(mixed): mixed $onFulfilled): \Http\Promise\Promise
{
    return $promise->then($onFulfilled);
}

function test_php_http_promise_get_state(\Http\Promise\Promise $promise): \Http\Promise\PromiseState
{
    return $promise->getState();
}

function test_php_http_promise_wait_unwrap(\Http\Promise\Promise $promise): mixed
{
    return $promise->wait(true);
}

function test_php_http_promise_wait_no_unwrap(\Http\Promise\Promise $promise): null
{
    return $promise->wait(false);
}

function test_php_http_fulfilled_construct(mixed $result): \Http\Promise\FulfilledPromise
{
    return new \Http\Promise\FulfilledPromise($result);
}

function test_php_http_rejected_construct(\Throwable $e): \Http\Promise\RejectedPromise
{
    return new \Http\Promise\RejectedPromise($e);
}
