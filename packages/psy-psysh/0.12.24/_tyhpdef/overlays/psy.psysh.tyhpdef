<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Same-namespace names harvested as globals, and conditional VarDumper shims.
 * Configuration and shell setters that return nothing are `void`. Mode strings
 * are the closed sets `Configuration` actually accepts. Array shapes, token
 * lists, and callbacks follow the PHP contract.
 */

namespace Psy {
    type ColorMode = 'auto'|'forced'|'disabled';

    /**
     * `implicitUse` filters. Each namespace list may be omitted.
     */
    type ImplicitUseConfig = struct {
        ?array<int, string> $includeNamespaces;
        ?array<int, string> $excludeNamespaces;
    };

    type InteractiveMode = 'auto'|'forced'|'disabled';

    /**
     * `setLogging()` array form. `level` is one level for every event, or a per-event map.
     */
    type LoggingConfig = struct {
        \Psr\Log\LoggerInterface|\Psy\Logger\CallbackLogger|(callable(string, string): void) $logger;
        ?(string|\Psy\LogLevelMap) $level;
    };

    /**
     * Per-event log level. `false` disables that event.
     */
    type LogLevelMap = struct {
        string|false $input;
        string|false $command;
        string|false $execute;
    };

    /**
     * One `token_get_all()` token. Single-character tokens remain `string`.
     */
    type PhpToken = struct {
        int '0' as $id;
        string '1' as $text;
        int '2' as $line;
    };

    type ProjectTrustMode = 'prompt'|'always'|'never';

    /**
     * `setSemicolonsSuppressReturn()`: a bool, or `'double'` for the double-semicolon mode.
     */
    type SemicolonsSuppressReturn = bool|'double';

    type UpdateInterval = 'always'|'daily'|'weekly'|'monthly'|'never';

    type VerbosityLevel = 'quiet'|'normal'|'verbose'|'very_verbose'|'debug';

    /**
     * `setWarmAutoload()` array form. Every key is optional; an empty struct disables warming.
     */
    type WarmAutoloadConfig = struct {
        ?bool $includeVendor;
        ?bool $includeTests;
        ?array<int, string> $includeNamespaces;
        ?array<int, string> $excludeNamespaces;
        ?array<int, string> $includeVendorNamespaces;
        ?array<int, string> $excludeVendorNamespaces;
        ?array<int, \Psy\TabCompletion\AutoloadWarmer\AutoloadWarmerInterface> $warmers;
    };

    /**
     * Overlay: namespace parts and use-alias maps. `clean()` takes source lines.
     */
    // @overlay-against: class CodeCleaner
    partial class CodeCleaner {
        // @overlay-against: function __construct(?\PhpParser\Parser $parser, ?\PhpParser\PrettyPrinter\Standard $printer, ?\PhpParser\NodeTraverser $traverser, bool $yolo, bool $strictTypes, false|array $implicitUse): void
        public function __construct(?\PhpParser\Parser $parser = null, ?\PhpParser\PrettyPrinter\Standard $printer = null, ?\PhpParser\NodeTraverser $traverser = null, bool $yolo = false, bool $strictTypes = false, false|\Psy\ImplicitUseConfig $implicitUse = false): void;

        // @overlay-against: function clean(array $codeLines, bool $requireSemicolons): string|false
        public function clean(array<int, string> $codeLines, bool $requireSemicolons = false): string|false;

        // @overlay-against: function getAliasesByTypeForNamespace(\PhpParser\Node\Name|string|null $namespace): array
        public function getAliasesByTypeForNamespace(\PhpParser\Node\Name|string|null $namespace): array<int, array<string, \PhpParser\Node\Name>>;

        // @overlay-against: function getAliasesForNamespace(\PhpParser\Node\Name|string|null $namespace): array
        public function getAliasesForNamespace(\PhpParser\Node\Name|string|null $namespace): array<string, \PhpParser\Node\Name>;

        // @overlay-against: function getNamespace(): array|null
        public function getNamespace(): array<int, string>|null;

        // @overlay-against: function parse(string $code, bool $requireSemicolons): array|false
        protected function parse(string $code, bool $requireSemicolons = false): array<int, \PhpParser\Node>|false;

        // @overlay-against: function setAliasesByTypeForNamespace(?\PhpParser\Node\Name $namespace, array $aliasesByType): void
        public function setAliasesByTypeForNamespace(?\PhpParser\Node\Name $namespace, array<int, array<string, \PhpParser\Node\Name>> $aliasesByType): void;

        // @overlay-against: function setAliasesForNamespace(?\PhpParser\Node\Name $namespace, array $aliases): mixed
        public function setAliasesForNamespace(?\PhpParser\Node\Name $namespace, array<string, \PhpParser\Node\Name> $aliases): void;

        // @overlay-against: function setNamespace(\PhpParser\Node\Name|array|null $namespace): mixed
        public function setNamespace(\PhpParser\Node\Name|array<int, string>|null $namespace = null): void;
    }

    /**
     * Overlay: config setters return void. Color, trust, verbosity, and update intervals are closed strings.
     */
    // @overlay-against: class Configuration
    partial class Configuration {
        // @overlay-against: function __construct(array $config): void
        public function __construct(array<string, mixed> $config = []): void;

        // @overlay-against: function addCasters(array $casters): mixed
        public function addCasters(array<string, callable(mixed): mixed> $casters): void;

        // @overlay-against: function addCommands(array $commands): mixed
        public function addCommands(array<int, \Psy\Command\Command> $commands): void;

        // @overlay-against: function addMatchers(array $matchers): mixed
        public function addMatchers(array<int, \Psy\TabCompletion\Matcher\AbstractMatcher> $matchers): void;

        // @overlay-against: function addTabCompletionMatchers(array $matchers): mixed
        deprecated public function addTabCompletionMatchers(array<int, \Psy\TabCompletion\Matcher\AbstractMatcher> $matchers): void;

        // @overlay-against: function colorMode(): string
        public function colorMode(): ColorMode;

        // @overlay-against: function getImplicitUse(): bool|array
        public function getImplicitUse(): false|\Psy\ImplicitUseConfig;

        // @overlay-against: function getProjectTrustMode(): string
        public function getProjectTrustMode(): ProjectTrustMode;

        // @overlay-against: function init(): mixed
        public function init(): void;

        // @overlay-against: function interactiveMode(): string
        public function interactiveMode(): InteractiveMode;

        // @overlay-against: function loadConfig(array $options): mixed
        public function loadConfig(array<string, mixed> $options): void;

        // @overlay-against: function loadConfigFile(string $file): mixed
        public function loadConfigFile(string $file): void;

        // @overlay-against: function setAutoCompleter(\Psy\TabCompletion\AutoCompleter $autoCompleter): mixed
        public function setAutoCompleter(\Psy\TabCompletion\AutoCompleter $autoCompleter): void;

        // @overlay-against: function setChecker(\Psy\VersionUpdater\Checker $checker): mixed
        public function setChecker(\Psy\VersionUpdater\Checker $checker): void;

        // @overlay-against: function setClipboard(\Psy\Clipboard\ClipboardMethod $clipboard): mixed
        public function setClipboard(\Psy\Clipboard\ClipboardMethod $clipboard): void;

        // @overlay-against: function setClipboardCommand(?string $clipboardCommand): mixed
        public function setClipboardCommand(?string $clipboardCommand): void;

        // @overlay-against: function setCodeCleaner(\Psy\CodeCleaner $cleaner): mixed
        public function setCodeCleaner(\Psy\CodeCleaner $cleaner): void;

        // @overlay-against: function setColorMode(string $colorMode): mixed
        public function setColorMode(ColorMode $colorMode): void;

        // @overlay-against: function setConfigDir(string $dir): mixed
        public function setConfigDir(string $dir): void;

        // @overlay-against: function setDataDir(string $dir): mixed
        public function setDataDir(string $dir): void;

        // @overlay-against: function setDefaultIncludes(array $includes): mixed
        public function setDefaultIncludes(array<int, string> $includes = []): void;

        // @overlay-against: function setEraseDuplicates(bool $value): mixed
        public function setEraseDuplicates(bool $value): void;

        // @overlay-against: function setErrorLoggingLevel(int $errorLoggingLevel): mixed
        public function setErrorLoggingLevel(int $errorLoggingLevel): void;

        // @overlay-against: function setExceptionDetails(callable $exceptionDetails): void
        public function setExceptionDetails(callable(\Throwable): mixed $exceptionDetails): void;

        // @overlay-against: function setForceArrayIndexes(bool $forceArrayIndexes): mixed
        public function setForceArrayIndexes(bool $forceArrayIndexes): void;

        // @overlay-against: function setFormatterStyles(array $formatterStyles): mixed
        deprecated public function setFormatterStyles(array<string, mixed> $formatterStyles): void;

        // @overlay-against: function setHistoryFile(string $file): mixed
        public function setHistoryFile(string $file): void;

        // @overlay-against: function setHistorySize(int $value): mixed
        public function setHistorySize(int $value): void;

        // @overlay-against: function setImplicitUse(false|array $config): void
        public function setImplicitUse(false|\Psy\ImplicitUseConfig $config): void;

        // @overlay-against: function setInteractiveMode(string $interactiveMode): mixed
        public function setInteractiveMode(InteractiveMode $interactiveMode): void;

        // @overlay-against: function setLogging(\Psr\Log\LoggerInterface|callable|array $logging): void
        public function setLogging((\Psr\Log\LoggerInterface|\Psy\Logger\CallbackLogger|(callable(string, string): void)|\Psy\LoggingConfig) $logging): void;

        // @overlay-against: function setManualDbFile(string $filename): mixed
        public function setManualDbFile(string $filename): void;

        // @overlay-against: function setOutput(\Psy\Output\ShellOutput $output): mixed
        public function setOutput(\Psy\Output\ShellOutput $output): void;

        // @overlay-against: function setPager(string|\Psy\Output\OutputPager|bool|null $pager): mixed
        public function setPager(string|\Psy\Output\OutputPager|bool|null $pager): void;

        // @overlay-against: function setPrompt(string $prompt): mixed
        deprecated public function setPrompt(string $prompt): void;

        // @overlay-against: function setRawOutput(bool $rawOutput): mixed
        public function setRawOutput(bool $rawOutput): void;

        // @overlay-against: function setReadline(\Psy\Readline\Readline $readline): mixed
        public function setReadline(\Psy\Readline\Readline $readline): void;

        // @overlay-against: function setRequireSemicolons(bool $requireSemicolons): mixed
        public function setRequireSemicolons(bool $requireSemicolons): void;

        // @overlay-against: function setRuntimeDir(string $dir): mixed
        public function setRuntimeDir(string $dir): void;

        // @overlay-against: function setSemicolonsSuppressReturn(mixed $semicolonsSuppressReturn): mixed
        public function setSemicolonsSuppressReturn(SemicolonsSuppressReturn $semicolonsSuppressReturn): void;

        // @overlay-against: function setShell(\Psy\Shell $shell): mixed
        public function setShell(\Psy\Shell $shell): void;

        // @overlay-against: function setStartupMessage(string $message): mixed
        public function setStartupMessage(string $message): void;

        // @overlay-against: function setStrictTypes(mixed $strictTypes): mixed
        public function setStrictTypes(bool $strictTypes): void;

        // @overlay-against: function setTabCompletion(bool $useTabCompletion): mixed
        deprecated public function setTabCompletion(bool $useTabCompletion): void;

        // @overlay-against: function setTheme(\Psy\Output\Theme|string|array $theme): mixed
        public function setTheme(\Psy\Output\Theme|string|array<string, mixed> $theme): void;

        // @overlay-against: function setUpdateCheck(string $interval): mixed
        public function setUpdateCheck(UpdateInterval $interval): void;

        // @overlay-against: function setUpdateManualCheck(string $interval): mixed
        public function setUpdateManualCheck(UpdateInterval $interval): void;

        // @overlay-against: function setUseBracketedPaste(bool $useBracketedPaste): mixed
        public function setUseBracketedPaste(bool $useBracketedPaste): void;

        // @overlay-against: function setUseOsc52Clipboard(bool $useOsc52Clipboard): mixed
        public function setUseOsc52Clipboard(bool $useOsc52Clipboard): void;

        // @overlay-against: function setUsePcntl(bool $usePcntl): mixed
        public function setUsePcntl(bool $usePcntl): void;

        // @overlay-against: function setUseReadline(bool $useReadline): mixed
        public function setUseReadline(bool $useReadline): void;

        // @overlay-against: function setUseTabCompletion(bool $useTabCompletion): mixed
        public function setUseTabCompletion(bool $useTabCompletion): void;

        // @overlay-against: function setUseUnicode(bool $useUnicode): mixed
        public function setUseUnicode(bool $useUnicode): void;

        // @overlay-against: function setVerbosity(string $verbosity): mixed
        public function setVerbosity(VerbosityLevel $verbosity): void;

        // @overlay-against: function setWarmAutoload(bool|array $config): void
        public function setWarmAutoload(bool|\Psy\WarmAutoloadConfig $config): void;

        // @overlay-against: function setWarnOnMultipleConfigs(bool $warnOnMultipleConfigs): mixed
        public function setWarnOnMultipleConfigs(bool $warnOnMultipleConfigs): void;

        // @overlay-against: function setYolo(mixed $yolo): mixed
        public function setYolo(bool $yolo): void;

        // @overlay-against: function verbosity(): string
        public function verbosity(): VerbosityLevel;
    }

    /**
     * Overlay: scope maps are string-keyed. Writers return void. Variable values stay `mixed`.
     */
    // @overlay-against: class Context
    partial class Context {
        // @overlay-against: function getAll(): array
        public function getAll(): array<string, mixed>;

        // @overlay-against: function getCommandScopeVariables(): array
        public function getCommandScopeVariables(): array<string, mixed>;

        // @overlay-against: function getSpecialVariables(): array
        public function getSpecialVariables(): array<string, mixed>;

        // @overlay-against: function getUnusedCommandScopeVariableNames(): array
        public function getUnusedCommandScopeVariableNames(): array<int, string>;

        // @overlay-against: function setAll(array $vars): mixed
        public function setAll(array<string, mixed> $vars): void;

        // @overlay-against: function setBoundClass(string|null $boundClass): mixed
        public function setBoundClass(string|null $boundClass): void;

        // @overlay-against: function setBoundObject(object|null $boundObject): mixed
        public function setBoundObject(object|null $boundObject): void;

        // @overlay-against: function setCommandScopeVariables(array $commandScopeVariables): mixed
        public function setCommandScopeVariables(array<string, mixed> $commandScopeVariables): void;

        // @overlay-against: function setLastException(\Throwable $e): mixed
        public function setLastException(\Throwable $e): void;

        // @overlay-against: function setLastStdout(string $lastStdout): mixed
        public function setLastStdout(string $lastStdout): void;

        // @overlay-against: function setReturnValue(mixed $value): mixed
        public function setReturnValue(mixed $value): void;
    }

    /**
     * Harvest miss: unqualified `Context` is `\Psy\Context`.
     */
    // @overlay-against: interface ContextAware
    partial interface ContextAware {
        // @overlay-against: function setContext(\Context $context): mixed
        public function setContext(\Psy\Context $context): void;
    }

    /**
     * Overlay: scope variables are a string map. Buffer and output writers return void.
     */
    // @overlay-against: class Shell extends \Symfony\Component\Console\Application
    partial class Shell {
        // @overlay-against: function debug(array $vars, object|string $bindTo): array
        deprecated public static function debug(array<string, mixed> $vars = [], object|string $bindTo = null): array<string, mixed>;

        // @overlay-against: function addCode(string $code, bool $silent): mixed
        public function addCode(string $code, bool $silent = false): void;

        // @overlay-against: function addInput(string|array $input, bool $silent): mixed
        public function addInput(string|array<int, string> $input, bool $silent = false): void;

        // @overlay-against: function addMatchers(array $matchers): mixed
        public function addMatchers(array<int, \Psy\TabCompletion\Matcher\AbstractMatcher> $matchers): void;

        // @overlay-against: function addTabCompletionMatchers(array $matchers): mixed
        deprecated public function addTabCompletionMatchers(array<int, \Psy\TabCompletion\Matcher\AbstractMatcher> $matchers): void;

        // @overlay-against: function getDefaultCommands(): array
        protected function getDefaultCommands(): array<int, \Psy\Command\Command>;

        // @overlay-against: function getDefaultLoopListeners(): array
        protected function getDefaultLoopListeners(): array<int, \Psy\ExecutionLoop\Listener>;

        // @overlay-against: function getScopeVariableNames(): array
        public function getScopeVariableNames(): array<int, string>;

        // @overlay-against: function getScopeVariables(bool $includeBoundObject): array
        public function getScopeVariables(bool $includeBoundObject = true): array<string, mixed>;

        // @overlay-against: function getScopeVariablesDiff(array $currentVars): array
        public function getScopeVariablesDiff(array<string, mixed> $currentVars): array<string, mixed>;

        // @overlay-against: function getSpecialScopeVariables(bool $includeBoundObject): array
        public function getSpecialScopeVariables(bool $includeBoundObject = true): array<string, mixed>;

        // @overlay-against: function getUnusedCommandScopeVariableNames(): array
        public function getUnusedCommandScopeVariableNames(): array<int, string>;

        // @overlay-against: function setBoundClass(string|null $boundClass): mixed
        public function setBoundClass(string|null $boundClass): void;

        // @overlay-against: function setBoundObject(object|null $boundObject): mixed
        public function setBoundObject(object|null $boundObject): void;

        // @overlay-against: function setIncludes(array $includes): mixed
        public function setIncludes(array<int, string> $includes = []): void;

        // @overlay-against: function setScopeVariables(array $vars): mixed
        public function setScopeVariables(array<string, mixed> $vars): void;

        // @overlay-against: function writeException(\Throwable $e): mixed
        public function writeException(\Throwable $e): void;

        // @overlay-against: function writeReturnValue(mixed $ret, bool $rawOutput): mixed
        public function writeReturnValue(mixed $ret, bool $rawOutput = false): void;
    }

    // @overlay-against: class ShellLogger
    partial class ShellLogger {
        // @overlay-against: function __construct(\Psr\Log\LoggerInterface|\Psy\Logger\CallbackLogger $logger, array $levels): void
        public function __construct(\Psr\Log\LoggerInterface|\Psy\Logger\CallbackLogger $logger, \Psy\LogLevelMap $levels): void;
    }
}

namespace Psy\CodeAnalysis {
    /**
     * Start and end code-point offsets for one token.
     */
    type TokenSpan = struct {
        int $start;
        int $end;
    };

    // @overlay-against: class BufferAnalysis
    partial class BufferAnalysis {
        // @overlay-against: function __construct(string $code, array $tokens, array $tokenPositions, array|null $ast, ?\PhpParser\Error $lastError): void
        public function __construct(string $code, array<int, array|string> $tokens, array<int, \Psy\CodeAnalysis\TokenSpan> $tokenPositions, array<int, mixed>|null $ast, ?\PhpParser\Error $lastError): void;

        // @overlay-against: function getTokenPositions(): array
        public function getTokenPositions(): array<int, \Psy\CodeAnalysis\TokenSpan>;
    }

    // @overlay-against: class BufferAnalyzer
    partial class BufferAnalyzer {
        // @overlay-against: function createAnalysis(string $code, array $tokens, array $tokenPositions, array|null $ast, ?\PhpParser\Error $lastError): \Psy\CodeAnalysis\BufferAnalysis
        protected function createAnalysis(string $code, array<int, array|string> $tokens, array<int, \Psy\CodeAnalysis\TokenSpan> $tokenPositions, array<int, mixed>|null $ast, ?\PhpParser\Error $lastError): \Psy\CodeAnalysis\BufferAnalysis;
    }
}

