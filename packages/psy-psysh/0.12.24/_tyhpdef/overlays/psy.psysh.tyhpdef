namespace Psy\Command {
    /**
     * `ReflectingCommand::getTarget()`: class or instance, optional member, mirror kind bits.
     */
    type ReflectionTarget = struct {
        string|object '0' as $name;
        string|null '1' as $member;
        int '2' as $kind;
    };

    /**
     * `ReflectingCommand::getTargetAndReflector()`: resolved value and its reflector.
     */
    type ReflectionTargetPair = struct {
        string|object '0' as $value;
        \Reflector '1' as $reflector;
    };

    /**
     * Harvest miss: unqualified `Command` is `\Psy\Command\Command`.
     */
    // @overlay-against: class BufferCommand extends \Command implements \Psy\Readline\ReadlineAware
    partial class BufferCommand extends \Psy\Command\Command;

    // @overlay-against: class BufferCommand extends \Command implements \Psy\Readline\ReadlineAware
    partial class BufferCommand {
        // @overlay-against: function formatLines(array $lines, string $type): array
        protected function formatLines(array<int, string> $lines, string $type = 'return'): array<int, string>;
    }

    // @overlay-against: class ClearCommand extends \Command
    partial class ClearCommand extends \Psy\Command\Command;

    // @overlay-against: class CodeArgumentParser
    partial class CodeArgumentParser {
        // @overlay-against: function parse(string $code): array
        public function parse(string $code): array<int, \PhpParser\Node>;
    }

    // @overlay-against: class ConfigCommand extends \Psy\Command\Config\AbstractConfigCommand implements \Psy\CommandArgumentCompletionAware
    partial class ConfigCommand {
        // @overlay-against: function getArgumentCompletions(\Psy\Completion\AnalysisResult $analysis): array
        public function getArgumentCompletions(\Psy\Completion\AnalysisResult $analysis): array<int, string>;
    }

    // @overlay-against: class DocCommand extends \Psy\Command\ReflectingCommand implements \Psy\CommandArgumentCompletionAware
    partial class DocCommand {
        // @overlay-against: function getArgumentCompletions(\Psy\Completion\AnalysisResult $analysis): array
        public function getArgumentCompletions(\Psy\Completion\AnalysisResult $analysis): array<int, string>;
    }

    // @overlay-against: class EditCommand extends \Command implements \Psy\ContextAware
    partial class EditCommand extends \Psy\Command\Command;

    // @overlay-against: class ExitCommand extends \Command
    partial class ExitCommand extends \Psy\Command\Command;

    // @overlay-against: class HelpCommand extends \Command
    partial class HelpCommand extends \Psy\Command\Command;

    // @overlay-against: class HelpCommand extends \Command
    partial class HelpCommand {
        // @overlay-against: function setCommand(\Command $command): mixed
        public function setCommand(\Psy\Command\Command $command): mixed;
