namespace Psy\Util {
    /**
     * Foreground and background colors queried from the terminal, each an RGB triple or null.
     */
    type TerminalColors = struct {
        array<int, int>|null $bg;
        array<int, int>|null $fg;
    };

    // @overlay-against: class TerminalColor
    partial class TerminalColor {
        // @overlay-against: function queryTerminalColors(): array
        public static function queryTerminalColors(): \Psy\Util\TerminalColors;
    }
}

namespace Psy\VarDumper {
    /**
     * Conditional traits in Dumper.php. Symfony VarDumper 7.4 takes the typed, return-typed branch.
     */
    trait DumperDumpKeyShim {
        protected function dumpKey(\Symfony\Component\VarDumper\Cloner\Cursor $cursor): void;
    }

    trait DumperDumpLineShim {
        protected function dumpLine(int $depth, bool $endOfValue = false): void;
    }

    trait DumperDumpStringShim {
        public function dumpString(\Symfony\Component\VarDumper\Cloner\Cursor $cursor, string $str, bool $bin, int $cut): void;
    }

    trait DumperEnterHashShim {
        public function enterHash(\Symfony\Component\VarDumper\Cloner\Cursor $cursor, int $type, mixed $class, bool $hasChild): void;
    }

    trait DumperStyleShim {
        protected function style(string $style, string $value, array<string, mixed> $attr = []): string;
    }
}
