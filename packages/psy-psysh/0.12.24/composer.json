{
  "name": "tyhpdef/psy-psysh",
  "description": "Tyhp type definitions for the Composer package psy/psysh (0.12.24).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "0.12.24.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/nikic-php-parser": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/symfony-var-dumper": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "psy/psysh": "0.12.24"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/nikic-php-parser": "@dev",
    "tyhpdef/symfony-console": "@dev",
    "tyhpdef/symfony-var-dumper": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../nikic-php-parser/5.9.0"
    },
    {
      "type": "path",
      "url": "../../symfony-console/7.4.19"
    },
    {
      "type": "path",
      "url": "../../symfony-var-dumper/7.4.18"
    }
  ]
}
