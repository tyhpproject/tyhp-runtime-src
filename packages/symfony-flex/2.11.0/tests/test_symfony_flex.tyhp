<?tyhp

function test_options_expand_target_dir(): string
{
    return (new \Symfony\Flex\Options(['root-dir' => '/app']))->expandTargetDir('%ROOT_DIR%/config');
}

function test_lock_missing_name(): bool
{
    return (new \Symfony\Flex\Lock('/tmp/flex.lock'))->has('symfony/flex');
}

function test_recipe_name(\Composer\Package\PackageInterface $package): string
{
    return (new \Symfony\Flex\Recipe($package, 'symfony/flex', 'install', []))->getName();
}

function test_flex_plugin(\Symfony\Flex\Flex $flex): \Composer\Plugin\PluginInterface
{
    return $flex;
}
