<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Flex implements Composer plugin interfaces omitted from L1 (composer/composer is require-dev).
 * `getenv` in the Dotenv namespace is a test polyfill, not this package's API.
 */

namespace Symfony\Component\Dotenv {
    /**
     * Overlay: harvest emitted a `getenv` polyfill from DumpEnvCommand; drop it.
     */
    // @overlay-against: function getenv(?string $name, bool $local_only): string|array|false
    omit function getenv();
}

namespace Symfony\Flex {
    /**
     * One recipe file after download: decoded contents and the executable bit.
     */
    type RecipeFile = struct {
        string $contents;
        bool $executable;
    };

    /**
     * Overlay: harvest skipped `Flex` because it implements Composer plugin interfaces (require-dev).
     */
    class Flex implements \Composer\Plugin\PluginInterface, \Composer\EventDispatcher\EventSubscriberInterface {
        public static mixed $storedOperations ?? [];

        public static function getSubscribedEvents(): array<string, string|array|array<array>>;

        public function activate(\Composer\Composer $composer, \Composer\IO\IOInterface $io): void;

        public function deactivate(\Composer\Composer $composer, \Composer\IO\IOInterface $io): void;

        public function finish(string $rootDir, ?string $originalComposerJsonHash = null): void;

        public function getComposerJsonHash(): string;

        public function getLock(): \Symfony\Flex\Lock;

        public function uninstall(\Composer\Composer $composer, \Composer\IO\IOInterface $io): void;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `Downloader`.
     */
    // @overlay-against: class Downloader
    partial class Downloader {
        /**
         * @param array<\Composer\DependencyResolver\Operation\OperationInterface> $operations
         */
        // @overlay-against: function getRecipes(array $operations): array
        public function getRecipes(array<\Composer\DependencyResolver\Operation\OperationInterface> $operations): array;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `PackageFilter`.
     */
    // @overlay-against: class PackageFilter
    partial class PackageFilter {
        /**
         * @param array<\Composer\Package\PackageInterface> $data
         * @param array<\Composer\Package\PackageInterface> $lockedPackages
         * @return array<\Composer\Package\PackageInterface>
         */
        // @overlay-against: function removeLegacyPackages(array $data, \Composer\Package\RootPackageInterface $rootPackage, array $lockedPackages): array
        public function removeLegacyPackages(array<\Composer\Package\PackageInterface> $data, \Composer\Package\RootPackageInterface $rootPackage, array<\Composer\Package\PackageInterface> $lockedPackages): array<\Composer\Package\PackageInterface>;
    }

    /**
     * Overlay: manifest sections are string-keyed; file entries are `RecipeFile`.
     */
    // @overlay-against: class Recipe
    partial class Recipe {
        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function getManifest(): array
        public function getManifest(): array<string, mixed>;

        /**
         * @return array<string, \Symfony\Flex\RecipeFile>
         */
        // @overlay-against: function getFiles(): array
        public function getFiles(): array<string, \Symfony\Flex\RecipeFile>;
    }
}

namespace Symfony\Flex\Unpack {
