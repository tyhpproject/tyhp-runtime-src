{
    "name": "tyhpdef/filament-infolists",
    "description": "Tyhp type definitions for the Composer package filament/infolists (5.8.2).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "5.8.2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/filament-support": "@dev",
