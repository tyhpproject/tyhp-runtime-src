<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Public parse/setters are strings and bools (Layer 1 used `mixed`).
 */

// @overlay-against: class Parsedown
partial class Parsedown {
    /**
     * Overlay: `text()` parses markdown to HTML.
     */
    // @overlay-against: function text(mixed $text): mixed
    public function text(string $text): string;

    /**
     * Overlay: break/safe/strict flags are bool; setters return `$this`.
     */
    // @overlay-against: function setBreaksEnabled(mixed $breaksEnabled): mixed
    public function setBreaksEnabled(bool $breaksEnabled): self;

    /**
     * Overlay: markup-escape flag is bool.
     */
    // @overlay-against: function setMarkupEscaped(mixed $markupEscaped): mixed
    public function setMarkupEscaped(bool $markupEscaped): self;

    /**
     * Overlay: URL autolink flag is bool.
     */
    // @overlay-against: function setUrlsLinked(mixed $urlsLinked): mixed
    public function setUrlsLinked(bool $urlsLinked): self;

    /**
     * Overlay: safe-mode flag is bool.
     */
    // @overlay-against: function setSafeMode(mixed $safeMode): mixed
    public function setSafeMode(bool $safeMode): self;

    /**
     * Overlay: strict-mode flag is bool.
     */
    // @overlay-against: function setStrictMode(mixed $strictMode): mixed
    public function setStrictMode(bool $strictMode): self;

    /**
     * Overlay: `line()` parses inline markdown.
     */
    // @overlay-against: function line(mixed $text, mixed $nonNestables): mixed
    public function line(string $text, array<int|string, mixed> $nonNestables = []): string;

    /**
     * Overlay: named instances are `static`, keyed by a string name.
     */
    // @overlay-against: function instance(mixed $name): mixed
    public static function instance(string $name = 'default'): static;
}
