/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Path lists on Filesystem I/O. Harvest left `string|iterable`; PHPDoc is `string|string[]` on some members.
 */

namespace Symfony\Component\Filesystem {
    /**
     * One filesystem path or a list of paths.
     * Tyhp encoding of `string|iterable` / PHPDoc `string|string[]`.
     */
    type PathList = string|iterable<int|string, string>;

    /**
     * Overlay: mkdir/exists/touch/remove/chmod/chown/chgrp/hardlink take `PathList`.
     */
    // @overlay-against: class Filesystem
    partial class Filesystem {
        /**
         * @param \Symfony\Component\Filesystem\PathList $files
         */
        // @overlay-against: function chgrp(string|iterable $files, string|int $group, bool $recursive): void
        public function chgrp(\Symfony\Component\Filesystem\PathList $files, string|int $group, bool $recursive = false): void;

        /**
         * @param \Symfony\Component\Filesystem\PathList $files
         */
        // @overlay-against: function chmod(string|iterable $files, int $mode, int $umask, bool $recursive): void
        public function chmod(\Symfony\Component\Filesystem\PathList $files, int $mode, int $umask = 0, bool $recursive = false): void;

        /**
         * @param \Symfony\Component\Filesystem\PathList $files
         */
        // @overlay-against: function chown(string|iterable $files, string|int $user, bool $recursive): void
        public function chown(\Symfony\Component\Filesystem\PathList $files, string|int $user, bool $recursive = false): void;

        /**
         * @param \Symfony\Component\Filesystem\PathList $files
         */
        // @overlay-against: function exists(string|iterable $files): bool
        public function exists(\Symfony\Component\Filesystem\PathList $files): bool;

        /**
         * @param ?\Traversable<string, \SplFileInfo> $iterator
         * @param array<string, bool> $options Keys: `override`, `copy_on_windows`, `delete`.
         */
        // @overlay-against: function mirror(string $originDir, string $targetDir, ?\Traversable $iterator, array $options): void
        public function mirror(string $originDir, string $targetDir, ?\Traversable<string, \SplFileInfo> $iterator = null, array<string, bool> $options = []): void;

        /**
         * @param \Symfony\Component\Filesystem\PathList $targetFiles
         */
        // @overlay-against: function hardlink(string $originFile, string|iterable $targetFiles): void
        public function hardlink(string $originFile, \Symfony\Component\Filesystem\PathList $targetFiles): void;

        /**
         * @param \Symfony\Component\Filesystem\PathList $dirs
         */
        // @overlay-against: function mkdir(string|iterable $dirs, int $mode): void
        public function mkdir(\Symfony\Component\Filesystem\PathList $dirs, int $mode = 511): void;

        /**
         * @param \Symfony\Component\Filesystem\PathList $files
         */
        // @overlay-against: function remove(string|iterable $files): void
        public function remove(\Symfony\Component\Filesystem\PathList $files): void;

        /**
         * @param \Symfony\Component\Filesystem\PathList $files
         */
        // @overlay-against: function touch(string|iterable $files, ?int $time, ?int $atime): void
        public function touch(\Symfony\Component\Filesystem\PathList $files, ?int $time = null, ?int $atime = null): void;
    }

    /**
     * Overlay: Tyhp list-literal encoding of PHPDoc `string|string[]|null`.
     * Harvest used `array<int, string>`; list literals are `array<int|string, string>`.
     */
    // @overlay-against: class Path
    partial class Path {
        /**
         * @param string|array<int|string, string>|null $extensions
         */
        // @overlay-against: function hasExtension(string $path, string|array|null $extensions, bool $ignoreCase): bool
        public static function hasExtension(string $path, string|array<int|string, string>|null $extensions = null, bool $ignoreCase = false): bool;
    }
}
