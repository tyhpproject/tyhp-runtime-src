<?tyhp

function test_filesystem_exists_path_list(\Symfony\Component\Filesystem\Filesystem $fs): bool
{
    return $fs->exists(['/tmp/a', '/tmp/b']);
}

function test_filesystem_mkdir(\Symfony\Component\Filesystem\Filesystem $fs): void
{
    $fs->mkdir('/tmp/tyhp-fs', 0755);
}

function test_filesystem_path_canonicalize(): string
{
    return \Symfony\Component\Filesystem\Path::canonicalize('../css/./style.css');
}

function test_filesystem_path_has_extension(): bool
{
    return \Symfony\Component\Filesystem\Path::hasExtension('style.css', ['css', 'scss']);
}

function test_filesystem_path_join(): string
{
    return \Symfony\Component\Filesystem\Path::join('/var', 'www', 'index.html');
}
