{
  "name": "tyhp/decimal",
  "description": "Tyhp runtime decimal — arbitrary-precision decimal arithmetic",
  "type": "library",
  "license": "Apache-2.0",
  "version": "0.1",
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "require": {
        "tyhpdef/php": "@dev"
      },
      "package": {
        "include": [
          "./package.tyhpdef"
        ],
        "exclude": [],
        "overlay": [],
        "source": {
          "tagless": false
        }
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "tyhp/core": "@dev"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/php-ext-bcmath": "@dev",
    "tyhpdef/php-ext-gmp": "@dev",
    "tyhpdef/php-ext-decimal": "@dev",
    "tyhp/compiler": "@dev"
  },
  "suggest": {
    "ext-decimal": "Preferred backend (php-decimal / mpdecimal) for arbitrary-precision decimal arithmetic",
    "ext-bcmath": "Alternative backend for arbitrary-precision decimal arithmetic",
    "ext-gmp": "Alternative backend for arbitrary-precision decimal arithmetic"
  },
  "autoload": {
    "psr-4": {
      "Tyhp\\": "src/Tyhp/"
    },
    "files": [
      "src/Tyhp/_functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tyhp\\Tests\\Decimal\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../php"
    },
    {
      "type": "path",
      "url": "../php-ext-bcmath"
    },
    {
      "type": "path",
      "url": "../php-ext-gmp"
    },
    {
      "type": "path",
      "url": "../php-ext-decimal"
    },
    {
      "type": "path",
      "url": "../dist/tyhp-core/802.latest"
    },
    {
      "type": "path",
      "url": "../compiler"
    }
  ],
  "provide": {
    "ext-decimal": "1.3.0"
  },
  "config": {
    "allow-plugins": {
      "tyhp/core": true
    }
  }
}
