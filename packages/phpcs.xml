<?xml version="1.0"?>
<ruleset name="Tyhp Runtime Packages">
    <description>
        PHPCS is not the PER-CS 3.0 gate. PHP_CodeSniffer has no complete PER-CS 3.0
        standard (PSR-12 ≡ PER-CS 1.0). Runtime dist style is enforced by PHP-CS-Fixer
        @PER-CS3x0 via runtime/packages/.php-cs-fixer.php (see base-build-all.sh).

        This file remains only so `phpcs` from this directory still skips vendor/tests
        and documents Tyhp exclusions that are not style-standard issues.
    </description>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <!-- Emitted PHP under dist/tyhp-<pkg>/<version>/src plus copied plugin PHP -->
    <file>dist</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tyhp_src/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/tyhp-build-state\.json</exclude-pattern>

    <!--
      Target coding standard for emitted PHP: PER-CS 3.0 (enforced by PHP-CS-Fixer).

      Do not re-enable PSR-12 here — PER-CS 3.0 forbids spaces in unions (`int|string`)
      which PSR-12 required. Running PSR-12 sniffs would fight the emit contract.

      Exclusions below cover intentional Tyhp compiler conventions that conflict with
      PSR-1/PSR-2 naming, and PHPCS property-hook tokenizer bugs. Keep them if this
      file is used for naming-only checks:
      - Generic factories / init hooks: new_*__tyhpGeneric, *__tyhpGeneric, __initGenerics__tyhpGeneric
      - Internal runtime fields: $__tyhp*, $__reflectedClass__tyhpGeneric
      - Async primitives: Promise::_async / ::_await

      Property hooks (PHP 8.4+) are still incomplete in PHPCS tokenizer/sniffs (see
      PHPCSStandards/PHP_CodeSniffer#731). Valid PER-CS 3.0 emit such as multiline hooks,
      `parent::$prop::get()`, `&get`, and hooks on promoted ctor params currently trip:
      - PropertyDeclaration.SpacingAfterType / Multiple / ScopeMissing / Underscore
      - ScopeIndent (control flow inside hooks)
      - OperatorSpacing on `&get` (PHP requires no space)
      - ReturnTypeDeclaration (crashes / false positives on ctor params with hooks)
      - MultiLineFunctionDeclaration.Indent (hook bodies inside promoted params nest deeper)
      Exclude those until PHPCS understands property hooks; keep emitting PER-CS 3.0-shaped hooks.
    -->
</ruleset>
