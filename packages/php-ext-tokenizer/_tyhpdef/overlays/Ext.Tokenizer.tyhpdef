<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef`  (not under `overlays/stubs/`)
 * Follows TYHPDEF_ORDERING.md.
 * `token_get_all` token entries and `PhpToken::is` kind union.
 */

/**
 * Overlay: three-element `token_get_all()` array token
 * (`id`, source text, 1-based line). Single-character tokens stay `string`.
 */
type TokenArrayEntry = struct {
    int 0 as $id;
    string 1 as $text;
    int 2 as $line;
};

// @overlay-against: function token_get_all(string $code, int $flags): array
function token_get_all(string $code, int $flags = 0): array<int, string|TokenArrayEntry>;

// @overlay-against: class PhpToken implements \Stringable
partial class PhpToken {
    /**
     * Overlay: `$kind` is a token id, a single-char token string, or a list of those.
     */
    // @overlay-against: function is(mixed $kind): bool
    public function is(int|string|array<int, int|string> $kind): bool;
}
