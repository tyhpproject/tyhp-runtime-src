/**
 * Locale => translation file path.
 */
type TranslationFileMap = array<string, string>;

/**
 * Status row written by calculateTranslationStatus.
 */
type TranslationLocaleStatus = struct {
    int $total;
    int $translated;
    array<string, string> $missingKeys;
    array<string, \TranslationMismatch> $mismatches;
    bool $is_completed;
};

/**
 * One trans-unit id whose source text differs from the base file.
 */
type TranslationMismatch = struct {
    string $found;
    string $expected;
};

// @overlay-against: function calculateTranslationStatus(mixed $originalFilePath, mixed $translationFilePaths): array
function calculateTranslationStatus(string $originalFilePath, \TranslationFileMap $translationFilePaths): array<string, \TranslationLocaleStatus>;

// @overlay-against: function extractLocaleFromFilePath(mixed $filePath): mixed
function extractLocaleFromFilePath(string $filePath): string;

// @overlay-against: function extractTranslationKeys(mixed $filePath): array
function extractTranslationKeys(string $filePath): array<string, string>;

// @overlay-against: function findTransUnitMismatches(array $baseTranslationKeys, array $translatedKeys): array
function findTransUnitMismatches(array<string, string> $baseTranslationKeys, array<string, string> $translatedKeys): array<string, \TranslationMismatch>;

// @overlay-against: function findTranslationFiles(mixed $originalFilePath, mixed $localeToAnalyze): array
function findTranslationFiles(string $originalFilePath, ?string $localeToAnalyze): \TranslationFileMap;

// @overlay-against: function isTranslationCompleted(array $translationStatus): bool
function isTranslationCompleted(\TranslationLocaleStatus $translationStatus): bool;

// @overlay-against: function printTable(mixed $translations, mixed $verboseOutput, bool $includeCompletedLanguages): void
function printTable(array<string, \TranslationLocaleStatus> $translations, bool $verboseOutput, bool $includeCompletedLanguages): void;

// @overlay-against: function printTitle(mixed $title): void
function printTitle(string $title): void;

// @overlay-against: function printTranslationStatus(mixed $originalFilePath, mixed $translationStatus, mixed $verboseOutput, mixed $includeCompletedLanguages): void
function printTranslationStatus(string $originalFilePath, array<string, \TranslationLocaleStatus> $translationStatus, bool $verboseOutput, bool $includeCompletedLanguages): void;
