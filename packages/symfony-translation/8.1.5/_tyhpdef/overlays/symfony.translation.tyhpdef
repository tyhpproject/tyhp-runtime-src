<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Catalogue message maps, `trans()` parameters, omit http-kernel / DI peers.
 * Print helpers already return void; their parameters are tightened. LocaleFallbackProvider lists stay array<int, string>. Test peers stay omitted.
 */

namespace Symfony\Component\Translation {
    /**
     * Tyhp encoding of catalogue messages: domain => (id => translation). L1 is bare `array`.
     */
    type CatalogueMessages = array<string, array<string, string>>;

    /**
     * Partial option bag for PseudoLocalizationTranslator. Missing keys keep PHP defaults.
     */
    type PseudoLocalizationOptions = array<string, bool|int|float|array<int, string>>;


