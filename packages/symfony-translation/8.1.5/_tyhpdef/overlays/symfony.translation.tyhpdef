        public function getCatalogueMetadata("" $key, string $domain = 'messages'): array<string, mixed>|null;

        // @overlay-against: function getCatalogueMetadata(string $key, string $domain): mixed
        public function getCatalogueMetadata(string $key = '', string $domain = 'messages'): mixed;
    }

