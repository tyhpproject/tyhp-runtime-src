<?tyhp

function test_translation_catalogue(): string
{
    $catalogue = new \Symfony\Component\Translation\MessageCatalogue('en', ['messages' => ['hello' => 'Hello']]);
    $catalogue->add(['bye' => 'Goodbye'], 'messages');
    return $catalogue->get('hello');
}

function test_translation_translator(): string
{
    $translator = new \Symfony\Component\Translation\Translator('en');
    $translator->addLoader('array', new \Symfony\Component\Translation\Loader\ArrayLoader());
    $translator->addResource('array', ['hello' => 'Hello %name%'], 'en');
    return $translator->trans('hello', ['%name%' => 'Tyhp']);
}

function test_translation_translatable(): string
{
    $msg = new \Symfony\Component\Translation\TranslatableMessage('hello', ['%name%' => 'Tyhp']);
    $translator = new \Symfony\Component\Translation\IdentityTranslator();
    return $msg->trans($translator);
}
