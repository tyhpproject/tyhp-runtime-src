<?tyhp

function test_key_create(): \Defuse\Crypto\Key
{
    return \Defuse\Crypto\Key::createNewRandomKey();
}

function test_crypto_encrypt(\Defuse\Crypto\Key $key): string
{
    return \Defuse\Crypto\Crypto::encrypt('secret', $key);
}

function test_crypto_decrypt(\Defuse\Crypto\Key $key, string $cipher): string
{
    return \Defuse\Crypto\Crypto::decrypt($cipher, $key);
}
