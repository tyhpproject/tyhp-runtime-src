<?tyhp

function test_rector_node_types(\Rector\Contract\Rector\RectorInterface $rector): array<int, \__ClassName<\PhpParser\Node>>
{
    return $rector->getNodeTypes();
}

function test_rector_refactor(\Rector\Contract\Rector\RectorInterface $rector, \PhpParser\Node $node): \PhpParser\Node|array<int, \PhpParser\Node>|int|null
{
    return $rector->refactor($node);
}
