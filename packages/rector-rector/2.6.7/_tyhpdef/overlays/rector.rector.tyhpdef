    /**
     * Overlay: `PolyfillPackage::*` package names.
     */
    type PolyfillPackageName = 'symfony/polyfill-php73'|'symfony/polyfill-php80'|'symfony/polyfill-php81'|'symfony/polyfill-php82'|'symfony/polyfill-php83'|'symfony/polyfill-php84'|'symfony/polyfill-php85';

