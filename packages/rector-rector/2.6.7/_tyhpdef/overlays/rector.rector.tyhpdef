    }
}

namespace Rector\ValueObject\Error {
    /**
     * Overlay: `SystemError` JSON object.
     */
    type SystemErrorJson = struct {
        string $message;
        ?string $relative_file_path;
        ?string $absolute_file_path;
        ?int $line;
        ?string $rector_class;
    };

    // @overlay-against: class SystemError implements \Rector\Parallel\Contract\SerializableInterface
    final partial class SystemError {
        /**
         * @param SystemErrorJson $json
         */
        // @overlay-against: function decode(array $json): self
        public static function decode(SystemErrorJson $json): self;

        // @overlay-against: function jsonSerialize(): array
        public function jsonSerialize(): SystemErrorJson;
    }
}

namespace Rector\ValueObject\Reporting {
    /**
     * Overlay: decoded `FileDiff` JSON. Nested line changes are already arrays.
     */
    type FileDiffDecodedJson = struct {
        string $relative_file_path;
        string $diff;
        string $diff_console_formatted;
        array<int, \Rector\ChangesReporting\ValueObject\RectorWithLineChangeJson> $rectors_with_line_changes;
    };

    /**
     * Overlay: `FileDiff::jsonSerialize()` before nested objects are encoded.
     */
    type FileDiffJson = struct {
        string $relative_file_path;
        string $diff;
        string $diff_console_formatted;
        array<int, \Rector\ChangesReporting\ValueObject\RectorWithLineChange> $rectors_with_line_changes;
    };

    // @overlay-against: class FileDiff implements \Rector\Parallel\Contract\SerializableInterface
    final partial class FileDiff {
        /**
         * @param FileDiffDecodedJson $json
         */
        // @overlay-against: function decode(array $json): self
        public static function decode(FileDiffDecodedJson $json): self;

        /**
         * @return array<int, \__ClassName<\Rector\Contract\Rector\RectorInterface>>
         */
        // @overlay-against: function getRectorClasses(): array
        public function getRectorClasses(): array<int, \__ClassName<\Rector\Contract\Rector\RectorInterface>>;

        // @overlay-against: function jsonSerialize(): array
        public function jsonSerialize(): FileDiffJson;
    }
}
