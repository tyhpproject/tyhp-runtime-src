namespace Rector\Rector {
    // @overlay-against: class AbstractRector extends \PhpParser\NodeVisitorAbstract implements \Rector\Contract\Rector\RectorInterface
    abstract partial class AbstractRector {
        /**
         * @return \PhpParser\Node|array<int, \PhpParser\Node>|int|null
         */
        // @overlay-against: function enterNode(\PhpParser\Node $node): mixed
        public final function enterNode(\PhpParser\Node $node): \PhpParser\Node|array<int, \PhpParser\Node>|int|null;

        /**
         * Name is present for param, class method, property, property item, trait, interface, const, and name nodes.
         */
        // @overlay-against: function getName(\PhpParser\Node $node): ?string
        protected function getName(\PhpParser\Node\Stmt\ClassMethod $node): string;

        // @overlay-against: function getName(\PhpParser\Node $node): ?string
        protected function getName(\PhpParser\Node\Const_ $node): string;

        // @overlay-against: function getName(\PhpParser\Node $node): ?string
        protected function getName(\PhpParser\Node\Stmt\Const_ $node): string;

        // @overlay-against: function getName(\PhpParser\Node $node): ?string
        protected function getName(\PhpParser\Node\Stmt\Interface_ $node): string;

        // @overlay-against: function getName(\PhpParser\Node $node): ?string
        protected function getName(\PhpParser\Node\Name $node): string;

        // @overlay-against: function getName(\PhpParser\Node $node): ?string
        protected function getName(\PhpParser\Node\Param $node): string;

        // @overlay-against: function getName(\PhpParser\Node $node): ?string
        protected function getName(\PhpParser\Node\Stmt\Property $node): string;

        // @overlay-against: function getName(\PhpParser\Node $node): ?string
        protected function getName(\PhpParser\Node\PropertyItem $node): string;

        // @overlay-against: function getName(\PhpParser\Node $node): ?string
        protected function getName(\PhpParser\Node\Stmt\Trait_ $node): string;

        // @overlay-against: function getName(\PhpParser\Node $node): ?string
        protected function getName(\PhpParser\Node $node): ?string;

        /**
         * @param callable(\PhpParser\Node): (int|\PhpParser\Node|null|array<int, \PhpParser\Node>) $callable
         */
        // @overlay-against: function traverseNodesWithCallable(\PhpParser\Node|array $nodes, callable $callable): void
        protected function traverseNodesWithCallable(\PhpParser\Node|array<int, \PhpParser\Node> $nodes, callable(\PhpParser\Node): (int|\PhpParser\Node|null|array<int, \PhpParser\Node>) $callable): void;
    }
}

