                "type": "metapackage",
                "license": "Apache-2.0",
                "version": "0.459.0",
                "keywords": [
                    "dev",
                    "static analysis"
                ],
                "require": {
                    "tyhpdef/google-apiclient-services-common-impl": "~0.459.0.0"
                },
                "extra": {
