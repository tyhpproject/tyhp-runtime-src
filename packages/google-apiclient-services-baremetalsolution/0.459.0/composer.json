    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "0.459.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "public": "tyhpdef/google-apiclient-services-baremetalsolution",
            "interopContractVersion": 1,
            "php-version": ">=8.2",
