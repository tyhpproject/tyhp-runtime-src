<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Class-string renderers/listeners, Query predicates, `@internal` same-package types, and the optional Embed peer.
 */

namespace League\CommonMark\Environment {
    /**
     * Overlay: `addRenderer()` / `addEventListener()` take class-strings; listings match the interface PHPDoc.
     */
    // @overlay-against: class Environment implements \League\CommonMark\Environment\EnvironmentInterface, \League\CommonMark\Environment\EnvironmentBuilderInterface, \Psr\EventDispatcher\ListenerProviderInterface
    partial class Environment {
        /**
         * @param \__ClassName<T> $eventClass
         * @param callable(T): void $listener
         */
        // @overlay-against: function addEventListener(string $eventClass, callable $listener, int $priority): \League\CommonMark\Environment\EnvironmentBuilderInterface
        public function addEventListener<T extends object>(\__ClassName<T> $eventClass, callable(T): void $listener, int $priority = 0): \League\CommonMark\Environment\EnvironmentBuilderInterface;

        /**
         * @param \__ClassName<TNode> $nodeClass
         */
        // @overlay-against: function addRenderer(string $nodeClass, \League\CommonMark\Renderer\NodeRendererInterface $renderer, int $priority): \League\CommonMark\Environment\EnvironmentBuilderInterface
        public function addRenderer<TNode extends \League\CommonMark\Node\Node>(\__ClassName<TNode> $nodeClass, \League\CommonMark\Renderer\NodeRendererInterface $renderer, int $priority = 0): \League\CommonMark\Environment\EnvironmentBuilderInterface;

        /**
         * @param T $event
         * @return T
         */
        // @overlay-against: function dispatch(object $event): object
        public function dispatch<T extends object>(T $event): T;

        /**
         * @return iterable<\League\CommonMark\Parser\Block\BlockStartParserInterface>
         */
        // @overlay-against: function getBlockStartParsers(): iterable
        public function getBlockStartParsers(): iterable<\League\CommonMark\Parser\Block\BlockStartParserInterface>;

        /**
         * @return array<int, \League\CommonMark\Extension\ExtensionInterface>
         */
        // @overlay-against: function getExtensions(): iterable
        public function getExtensions(): array<int, \League\CommonMark\Extension\ExtensionInterface>;

        /**
         * @param \__ClassName<TNode> $nodeClass
         * @return iterable<\League\CommonMark\Renderer\NodeRendererInterface>
         */
        // @overlay-against: function getRenderersForClass(string $nodeClass): iterable
        public function getRenderersForClass<TNode extends \League\CommonMark\Node\Node>(\__ClassName<TNode> $nodeClass): iterable<\League\CommonMark\Renderer\NodeRendererInterface>;
    }

    /**
     * Overlay: builder class-strings match `Environment`.
     */
    // @overlay-against: interface EnvironmentBuilderInterface
    partial interface EnvironmentBuilderInterface {
        /**
         * @param \__ClassName<T> $eventClass
         * @param callable(T): void $listener
         */
        // @overlay-against: function addEventListener(string $eventClass, callable $listener, int $priority): \League\CommonMark\Environment\EnvironmentBuilderInterface
        public function addEventListener<T extends object>(\__ClassName<T> $eventClass, callable(T): void $listener, int $priority = 0): \League\CommonMark\Environment\EnvironmentBuilderInterface;

        /**
         * @param \__ClassName<TNode> $nodeClass
         */
        // @overlay-against: function addRenderer(string $nodeClass, \League\CommonMark\Renderer\NodeRendererInterface $renderer, int $priority): \League\CommonMark\Environment\EnvironmentBuilderInterface
        public function addRenderer<TNode extends \League\CommonMark\Node\Node>(\__ClassName<TNode> $nodeClass, \League\CommonMark\Renderer\NodeRendererInterface $renderer, int $priority = 0): \League\CommonMark\Environment\EnvironmentBuilderInterface;
    }
}

