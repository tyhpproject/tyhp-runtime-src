namespace League\CommonMark\Node {
    /**
     * Overlay: Query predicates are node→bool; `type()` takes a node class-string; `findAll()` limit defaults to null.
     */
    // @overlay-against: class Query
    partial class Query {
        /**
         * @param callable(\League\CommonMark\Node\Node): bool ...$conditions
         */
        // @overlay-against: function andWhere(callable $conditions): self
        public function andWhere(callable(\League\CommonMark\Node\Node): bool ...$conditions): self;

        /**
         * @return iterable<\League\CommonMark\Node\Node>
         */
        // @overlay-against: function findAll(\League\CommonMark\Node\Node $node, ?int $limit): iterable
        public function findAll(\League\CommonMark\Node\Node $node, ?int $limit = null): iterable<\League\CommonMark\Node\Node>;

        /**
         * @param ?callable(\League\CommonMark\Node\Node): bool $condition
         * @return callable(\League\CommonMark\Node\Node): bool
         */
        // @overlay-against: function hasChild(?callable $condition): callable
        public static function hasChild(?callable(\League\CommonMark\Node\Node): bool $condition = null): callable(\League\CommonMark\Node\Node): bool;

        /**
         * @param ?callable(\League\CommonMark\Node\Node): bool $condition
         * @return callable(\League\CommonMark\Node\Node): bool
         */
        // @overlay-against: function hasParent(?callable $condition): callable
        public static function hasParent(?callable(\League\CommonMark\Node\Node): bool $condition = null): callable(\League\CommonMark\Node\Node): bool;

        /**
         * @param callable(\League\CommonMark\Node\Node): bool ...$conditions
         */
        // @overlay-against: function orWhere(callable $conditions): self
        public function orWhere(callable(\League\CommonMark\Node\Node): bool ...$conditions): self;

        /**
         * @param \__ClassName<TNode> $class
         * @return callable(\League\CommonMark\Node\Node): bool
         */
        // @overlay-against: function type(string $class): callable
        public static function type<TNode extends \League\CommonMark\Node\Node>(\__ClassName<TNode> $class): callable(\League\CommonMark\Node\Node): bool;

        /**
         * @param callable(\League\CommonMark\Node\Node): bool ...$conditions
         */
        // @overlay-against: function where(callable $conditions): self
        public function where(callable(\League\CommonMark\Node\Node): bool ...$conditions): self;
    }
}

