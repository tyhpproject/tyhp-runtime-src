         */
        // @overlay-against: function booted(callable $callback): void
        public function booted((callable(\Illuminate\Foundation\Application): mixed)&(callable(): mixed) $callback): void;

        /**
         * Overlay: `Application::booting()` invokes the callback with the application. Zero-argument closures are valid.
         */
        // @overlay-against: function booting(callable $callback): void
        public function booting((callable(\Illuminate\Foundation\Application): mixed)&(callable(): mixed) $callback): void;

        /**
         * Overlay: `Application::detectEnvironment()` invokes the callback with no arguments and stores the string it returns.
         */
        // @overlay-against: function detectEnvironment(\Closure $callback): string
        public function detectEnvironment(\Closure<callable(): string> $callback): string;

        /**
         * Overlay: `Application::environment()` uses the documented types.
         */
        // @overlay-against: function environment(mixed $environments): string|bool
        public function environment(string|array ...$environments): string|bool;

        /**
         * Overlay: `Application::getDeferredServices()` is the service => provider class-name map.
         */
        // @overlay-against: function getDeferredServices(): array
        public function getDeferredServices(): array<string, __ClassName<\Illuminate\Support\ServiceProvider>>;

        /**
         * Overlay: `Application::getProviders()` filters registered provider instances by class name.
         */
        // @overlay-against: function getProviders(\Illuminate\Support\ServiceProvider|string $provider): array
        public function getProviders(\Illuminate\Support\ServiceProvider|string $provider): array<string, \Illuminate\Support\ServiceProvider>;

        /**
         * Overlay: `Application::make()` returns `TClass` when `$abstract` is a class name.
         */
        // @overlay-against: function make(string $abstract, array $parameters): mixed
        public function make<TClass extends object>(__ClassName<TClass> $abstract, array $parameters = []): TClass;

        /**
         * Overlay: `Application::make()` returns `mixed` for other container ids.
         */
        // @overlay-against: function make(string $abstract, array $parameters): mixed
        public function make(string $abstract, array $parameters = []): mixed;

        /**
         * Overlay: `Application::registered()` invokes the callback with the application. Zero-argument closures are valid.
         */
        // @overlay-against: function registered(callable $callback): void
        public function registered((callable(\Illuminate\Foundation\Application): mixed)&(callable(): mixed) $callback): void;

        /**
         * Overlay: `Application::removeDeferredServices()` unsets service names from the deferred map.
         */
        // @overlay-against: function removeDeferredServices(array $services): void
        public function removeDeferredServices(array<int, string> $services): void;

        /**
         * Overlay: `Application::runningConsoleCommand()` uses the documented types.
         */
        // @overlay-against: function runningConsoleCommand(mixed $commands): bool
        public function runningConsoleCommand(string|array ...$commands): bool;

        /**
         * Overlay: `Application::setDeferredServices()` replaces the service => provider class-name map.
         */
        // @overlay-against: function setDeferredServices(array $services): void
        public function setDeferredServices(array<string, __ClassName<\Illuminate\Support\ServiceProvider>> $services): void;
    }

    // @overlay-against: class DevCommand
    partial class DevCommand {
