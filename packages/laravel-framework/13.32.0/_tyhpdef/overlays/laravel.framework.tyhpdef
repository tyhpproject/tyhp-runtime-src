<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under `overlays/stubs/`).
 *
 * `TestCase` is kept. It extends `\PHPUnit\Framework\TestCase`, which
 * laravel/framework only suggests; that name is an extern in
 * `laravel.framework.peers.tyhpdef` rather than a path-linked PHPUnit wrapper.
 */

namespace Illuminate\Concurrency {
    /**
     * Overlay: concurrency tasks are invoked with no arguments.
     */
    type ConcurrencyTask = \Closure<callable(): mixed>;

    // @overlay-against: class ConcurrencyServiceProvider extends \Illuminate\Support\ServiceProvider implements \Illuminate\Contracts\Support\DeferrableProvider
    partial class ConcurrencyServiceProvider {
        /**
         * Overlay: `ConcurrencyServiceProvider::provides()` returns the concurrency manager class name.
         */
        // @overlay-against: function provides(): array
        public function provides(): array<int, __ClassName<\Illuminate\Concurrency\ConcurrencyManager>>;
    }

    // @overlay-against: class ForkDriver implements \Illuminate\Contracts\Concurrency\Driver
    partial class ForkDriver {
        /**
         * Overlay: `ForkDriver::defer()` invokes each task with no arguments.
         */
        // @overlay-against: function defer(\Closure|array $tasks): \Illuminate\Support\Defer\DeferredCallback
        public function defer(ConcurrencyTask|array<int|string, ConcurrencyTask> $tasks): \Illuminate\Support\Defer\DeferredCallback;

        /**
         * Overlay: `ForkDriver::run()` invokes each task with no arguments and keeps the input keys.
         */
        // @overlay-against: function run(\Closure|array $tasks, \Carbon\CarbonInterval|int|null $timeout): array
        public function run(ConcurrencyTask|array<int|string, ConcurrencyTask> $tasks, \Carbon\CarbonInterval|int|null $timeout = null): array<int|string, mixed>;
    }

    // @overlay-against: class ProcessDriver implements \Illuminate\Contracts\Concurrency\Driver
    partial class ProcessDriver {
        /**
         * Overlay: `ProcessDriver::defer()` serializes each task and invokes it with no arguments.
         */
        // @overlay-against: function defer(\Closure|array $tasks): \Illuminate\Support\Defer\DeferredCallback
        public function defer(ConcurrencyTask|array<int|string, ConcurrencyTask> $tasks): \Illuminate\Support\Defer\DeferredCallback;

        /**
         * Overlay: `ProcessDriver::run()` invokes each task with no arguments and keeps the input keys.
         */
        // @overlay-against: function run(\Closure|array $tasks, \Carbon\CarbonInterval|int|null $timeout): array
        public function run(ConcurrencyTask|array<int|string, ConcurrencyTask> $tasks, \Carbon\CarbonInterval|int|null $timeout = null): array<int|string, mixed>;
    }

    // @overlay-against: class SyncDriver implements \Illuminate\Contracts\Concurrency\Driver
    partial class SyncDriver {
        /**
         * Overlay: `SyncDriver::defer()` invokes each task with no arguments.
         */
        // @overlay-against: function defer(\Closure|array $tasks): \Illuminate\Support\Defer\DeferredCallback
        public function defer(ConcurrencyTask|array<int|string, ConcurrencyTask> $tasks): \Illuminate\Support\Defer\DeferredCallback;

        /**
         * Overlay: `SyncDriver::run()` invokes each task with no arguments and keeps the input keys.
         */
        // @overlay-against: function run(\Closure|array $tasks, \Carbon\CarbonInterval|int|null $timeout): array
        public function run(ConcurrencyTask|array<int|string, ConcurrencyTask> $tasks, \Carbon\CarbonInterval|int|null $timeout = null): array<int|string, mixed>;
    }
}

namespace Illuminate\Foundation {
    /**
     * Overlay: documented array shape.
     */
    type DevCommand__constructSource = struct {
        ?string $class;
        string $file;
        ?string $function;
        int $line;
    };

    /**
     * Overlay: documented array shape.
     */
    type DevCommandToArrayResult = struct {
        ?string $class;
        string $file;
        ?string $function;
        int $line;
    };

    /**
     * Overlay: documented array shape.
     */
    type DevCommandToArrayResult2 = struct {
        string|null $color;
        string $command;
        string $name;
        int $priority;
        DevCommandToArrayResult $source;
    };

    /**
     * Overlay: service manifest written by `ProviderRepository::compileManifest()`.
     */
    type ProviderRepositoryManifest = struct {
        array<string, __ClassName<\Illuminate\Support\ServiceProvider>> $deferred;
        array<int, __ClassName<\Illuminate\Support\ServiceProvider>> $eager;
        array<int|string, __ClassName<\Illuminate\Support\ServiceProvider>> $providers;
        array<string, array<int|string, mixed>> $when;
    };

    // @overlay-against: class AliasLoader
    partial class AliasLoader {
        /**
         * Overlay: `AliasLoader::getInstance()` merges alias => class-name maps.
         */
        // @overlay-against: function getInstance(array $aliases): \Illuminate\Foundation\AliasLoader
        public static function getInstance(array<string, string> $aliases = []): \Illuminate\Foundation\AliasLoader;

        /**
         * Overlay: `AliasLoader::getAliases()` is the alias => class-name map passed to `class_alias`.
         */
        // @overlay-against: function getAliases(): array
        public function getAliases(): array<string, string>;

        /**
         * Overlay: `AliasLoader::setAliases()` stores the alias => class-name map.
         */
        // @overlay-against: function setAliases(array $aliases): void
        public function setAliases(array<string, string> $aliases): void;
    }

