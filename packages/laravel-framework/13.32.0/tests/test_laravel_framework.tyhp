<?tyhp

function test_application_version(): string
{
    return (new \Illuminate\Foundation\Application())->version();
}

function test_application_set_base_path(): \Illuminate\Foundation\Application
{
    return (new \Illuminate\Foundation\Application())->setBasePath('/tmp/app');
}

function test_concurrency_sync_driver(): \Illuminate\Concurrency\SyncDriver
{
    return new \Illuminate\Concurrency\SyncDriver();
}
