<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Illuminate and other peer types come from path-linked wrappers; do not inline them.
 * Request maps, credential maps, and time-travel callbacks.
 */

namespace Pest\Laravel {
    /**
     * PSR-style header map used by the HTTP helpers.
     */
    type HeaderMap = array<string, string|array<int|string, string>>;

    /**
     * Column/value pairs for database assertions.
     */
    type RowData = array<string, mixed>;

    // @overlay-against: function artisan(string $command, array $parameters): \Illuminate\Testing\PendingCommand|int
    function artisan(string $command, array<string, mixed> $parameters = []): \Illuminate\Testing\PendingCommand|int;

    // @overlay-against: function assertCredentials(array $credentials, ?string $guard): \Illuminate\Foundation\Testing\TestCase
    function assertCredentials(\Pest\Laravel\RowData $credentials, ?string $guard = null): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function assertDatabaseHas(mixed $table, array $data, ?string $connection): \Illuminate\Foundation\Testing\TestCase
    function assertDatabaseHas(mixed $table, \Pest\Laravel\RowData $data = [], ?string $connection = null): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function assertDatabaseMissing(mixed $table, array $data, ?string $connection): \Illuminate\Foundation\Testing\TestCase
    function assertDatabaseMissing(mixed $table, \Pest\Laravel\RowData $data = [], ?string $connection = null): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function assertInvalidCredentials(array $credentials, ?string $guard): \Illuminate\Foundation\Testing\TestCase
    function assertInvalidCredentials(\Pest\Laravel\RowData $credentials, ?string $guard = null): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function assertNotSoftDeleted(\Illuminate\Database\Eloquent\Model|string $table, array $data, ?string $connection, string $deletedAtColumn): \Illuminate\Foundation\Testing\TestCase
    function assertNotSoftDeleted(\Illuminate\Database\Eloquent\Model|string $table, \Pest\Laravel\RowData $data = [], ?string $connection = null, string $deletedAtColumn = 'deleted_at'): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function assertSoftDeleted(\Illuminate\Database\Eloquent\Model|string $table, array $data, ?string $connection, string $deletedAtColumn): \Illuminate\Foundation\Testing\TestCase
    function assertSoftDeleted(\Illuminate\Database\Eloquent\Model|string $table, \Pest\Laravel\RowData $data = [], ?string $connection = null, string $deletedAtColumn = 'deleted_at'): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function call(string $method, string $uri, array $parameters, array $cookies, array $files, array $server, ?string $content): \Illuminate\Testing\TestResponse
    function call(string $method, string $uri, array<string, mixed> $parameters = [], array<string, string> $cookies = [], array<string, mixed> $files = [], array<string, mixed> $server = [], ?string $content = null): \Illuminate\Testing\TestResponse;

    // @overlay-against: function castAsJson(array|object|string $value): \Illuminate\Foundation\Testing\TestCase
    function castAsJson(array<int|string, mixed>|object|string $value): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function delete(string $uri, array $data, array $headers): \Illuminate\Testing\TestResponse
    function delete(string $uri, array<string, mixed> $data = [], \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function deleteJson(string $uri, array $data, array $headers): \Illuminate\Testing\TestResponse
    function deleteJson(string $uri, array<string, mixed> $data = [], \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    /**
     * @param (callable(): mixed)|null $callback
     */
    // @overlay-against: function freezeSecond(callable|null $callback): mixed
    function freezeSecond(?callable(): mixed $callback = null): mixed;

    /**
     * @param (callable(): mixed)|null $callback
     */
    // @overlay-against: function freezeTime(callable|null $callback): mixed
    function freezeTime(?callable(): mixed $callback = null): mixed;

    // @overlay-against: function get(string $uri, array $headers): \Illuminate\Testing\TestResponse
    function get(string $uri, \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function getJson(string $uri, array $headers): \Illuminate\Testing\TestResponse
    function getJson(string $uri, \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function handleExceptions(array $exceptions): \Illuminate\Foundation\Testing\TestCase
    function handleExceptions(array<int|string, string> $exceptions): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function hasCredentials(array $credentials, ?string $guard): bool
    function hasCredentials(\Pest\Laravel\RowData $credentials, ?string $guard = null): bool;

    // @overlay-against: function head(string $uri, array $headers): \Illuminate\Testing\TestResponse
    function head(string $uri, \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function json(string $method, string $uri, array $data, array $headers): \Illuminate\Testing\TestResponse
    function json(string $method, string $uri, array<string, mixed> $data = [], \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function options(string $uri, array $data, array $headers): \Illuminate\Testing\TestResponse
    function options(string $uri, array<string, mixed> $data = [], \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function optionsJson(string $uri, array $data, array $headers): \Illuminate\Testing\TestResponse
    function optionsJson(string $uri, array<string, mixed> $data = [], \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function patch(string $uri, array $data, array $headers): \Illuminate\Testing\TestResponse
    function patch(string $uri, array<string, mixed> $data = [], \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function patchJson(string $uri, array $data, array $headers): \Illuminate\Testing\TestResponse
    function patchJson(string $uri, array<string, mixed> $data = [], \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function post(string $uri, array $data, array $headers): \Illuminate\Testing\TestResponse
    function post(string $uri, array<string, mixed> $data = [], \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function postJson(string $uri, array $data, array $headers): \Illuminate\Testing\TestResponse
    function postJson(string $uri, array<string, mixed> $data = [], \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function put(string $uri, array $data, array $headers): \Illuminate\Testing\TestResponse
    function put(string $uri, array<string, mixed> $data = [], \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function putJson(string $uri, array $data, array $headers): \Illuminate\Testing\TestResponse
    function putJson(string $uri, array<string, mixed> $data = [], \Pest\Laravel\HeaderMap $headers = []): \Illuminate\Testing\TestResponse;

    // @overlay-against: function seed(array|string $class): \Illuminate\Foundation\Testing\TestCase
    function seed(array<int|string, string>|string $class = 'Database\\Seeders\\DatabaseSeeder'): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function session(array $data): \Illuminate\Foundation\Testing\TestCase
    function session(array<string, mixed> $data): \Illuminate\Foundation\Testing\TestCase;

    /**
     * @param (callable(): mixed)|null $callback
     */
    // @overlay-against: function travelTo(\DateTimeInterface|\Closure|\Illuminate\Support\Carbon|string|bool|null $date, callable|null $callback): mixed
    function travelTo(\DateTimeInterface|\Closure|\Illuminate\Support\Carbon|string|bool|null $date, ?callable(): mixed $callback = null): mixed;

    // @overlay-against: function withCookies(array $cookies): \Illuminate\Foundation\Testing\TestCase
    function withCookies(array<string, string> $cookies): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function withHeaders(array $headers): \Illuminate\Foundation\Testing\TestCase
    function withHeaders(\Pest\Laravel\HeaderMap $headers): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function withMiddleware(string|array|null $middleware): \Illuminate\Foundation\Testing\TestCase
    function withMiddleware(string|array<int|string, string>|null $middleware = null): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function withServerVariables(array $server): \Illuminate\Foundation\Testing\TestCase
    function withServerVariables(array<string, mixed> $server): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function withSession(array $data): \Illuminate\Foundation\Testing\TestCase
    function withSession(array<string, mixed> $data): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function withUnencryptedCookies(array $cookies): \Illuminate\Foundation\Testing\TestCase
    function withUnencryptedCookies(array<string, string> $cookies): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function withoutExceptionHandling(array $except): \Illuminate\Foundation\Testing\TestCase
    function withoutExceptionHandling(array<int|string, string> $except = []): \Illuminate\Foundation\Testing\TestCase;

    // @overlay-against: function withoutMiddleware(string|array|null $middleware): \Illuminate\Foundation\Testing\TestCase
    function withoutMiddleware(string|array<int|string, string>|null $middleware = null): \Illuminate\Foundation\Testing\TestCase;
}
