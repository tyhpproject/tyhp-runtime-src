<?tyhp

function test_css_selector_to_xpath(): string
{
    return (new \Symfony\Component\CssSelector\CssSelectorConverter())->toXPath('div.item > a');
}

function test_css_selector_xml(): string
{
    return (new \Symfony\Component\CssSelector\CssSelectorConverter(false))->toXPath('ns|item', 'descendant::');
}
