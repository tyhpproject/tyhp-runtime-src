<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `@internal` Token omitted from Layer 1; `SyntaxErrorException::unexpectedToken` names it.
 */

namespace Symfony\Component\CssSelector\Parser {
    /**
     * Overlay: harvest skipped `@internal` Token; SyntaxErrorException takes this type.
     */
    class Token {
        public const string TYPE_DELIMITER ?? 'delimiter';
        public const string TYPE_FILE_END ?? 'eof';
        public const string TYPE_HASH ?? 'hash';
        public const string TYPE_IDENTIFIER ?? 'identifier';
        public const string TYPE_NUMBER ?? 'number';
        public const string TYPE_STRING ?? 'string';
        public const string TYPE_WHITESPACE ?? 'whitespace';

        public function __construct(?string $type, ?string $value, ?int $position): void;

        public function __toString(): string;

        public function getPosition(): ?int;

        public function getType(): ?string;

        public function getValue(): ?string;

        public function isDelimiter(array<int|string, string> $values = []): bool;

        public function isFileEnd(): bool;

        public function isHash(): bool;

        public function isIdentifier(): bool;

        public function isNumber(): bool;

        public function isString(): bool;

        public function isWhitespace(): bool;
    }
}
