    #[\Tyhp\Php("<8.5")]
    // @overlay-against: function createInstance(mixed $timezone, ?string $locale): ?\IntlCalendar
    static public function createInstance(\IntlTimeZone|\DateTimeZone|string|null $timezone = null, ?string $locale = null): ?\IntlCalendar;
    // @overlay-against: function getAvailableLocales(): array
    static public function getAvailableLocales(): array<int, string>;
    #[\Tyhp\Php("<8.5")]
    // @overlay-against: function setTimeZone(mixed $timezone): bool
    public function setTimeZone(\IntlTimeZone|\DateTimeZone|string|null $timezone): bool;
}

// @overlay-against: class IntlChar
partial class IntlChar {
    // @overlay-against: function charAge(string|int $codepoint): ?array
    static public function charAge(string|int $codepoint): ?UnicodeVersion;
    #[\Tyhp\Php("<8.3")]
    // @overlay-against: function enumCharNames(string|int $start, string|int $end, callable $callback, int $type): ?bool
    static public function enumCharNames(string|int $start, string|int $end, callable(int, int, string): bool $callback, int $type = IntlChar::UNICODE_CHAR_NAME): ?bool;
    #[\Tyhp\Php(">=8.3")]
    // @overlay-against: function enumCharNames(string|int $start, string|int $end, callable $callback, int $type): bool
    static public function enumCharNames(string|int $start, string|int $end, callable(int, int, string): bool $callback, int $type = IntlChar::UNICODE_CHAR_NAME): bool;
    // @overlay-against: function enumCharTypes(callable $callback): void
    static public function enumCharTypes(callable(int, int, int): bool $callback): void;
    // @overlay-against: function getUnicodeVersion(): array
    static public function getUnicodeVersion(): UnicodeVersion;
}

// @overlay-against: class IntlDateFormatter
partial class IntlDateFormatter {
    // @overlay-against: function formatObject(mixed $datetime, mixed $format, ?string $locale): string|false
    static public function formatObject(\IntlCalendar|\DateTimeInterface $datetime, array<int, int>|int|string|null $format = null, ?string $locale = null): string|false;

    #[\Tyhp\Php("<8.5")]
    // @overlay-against: function __construct(?string $locale, int $dateType, int $timeType, mixed $timezone, mixed $calendar, ?string $pattern)
    public function __construct(?string $locale, int $dateType = IntlDateFormatter::FULL, int $timeType = IntlDateFormatter::FULL, \IntlTimeZone|\DateTimeZone|string|null $timezone = null, \IntlCalendar|int|null $calendar = null, ?string $pattern = null);

    // @overlay-against: function format(mixed $datetime): string|false
    public function format(\IntlCalendar|\DateTimeInterface|LocalTimeParts|int|float $datetime): string|false;

    // @overlay-against: function localtime(string $string, mixed $offset): array|false
