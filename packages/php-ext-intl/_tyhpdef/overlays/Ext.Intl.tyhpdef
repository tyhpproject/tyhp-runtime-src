<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef`  (not under `overlays/stubs/`)
 * Follows TYHPDEF_ORDERING.md.
 * Generics for IntlIterator / ResourceBundle, NumberFormatter::parse TYPE_*
 * overloads, locale / IDNA array-shapes, and Collator compare literals.
 */

/**
 * Overlay: `$idna_info` filled by `idn_to_ascii` / `idn_to_utf8` with
 * `INTL_IDNA_VARIANT_UTS46`.
 */
type IdnaInfo = struct {
    string $result;
    bool $isTransitionalDifferent;
    int $errors;
};

/**
 * Overlay: `IntlChar::charAge()` / `IntlChar::getUnicodeVersion()` four-int version.
 */
type UnicodeVersion = struct {
    int 0 as $major;
    int 1 as $minor;
    int 2 as $micro;
    int 3 as $patch;
};

// @overlay-against: function collator_compare(\Collator $object, string $string1, string $string2): int|false
function collator_compare(\Collator $object, string $string1, string $string2): -1|0|1|false;

// @overlay-against: function datefmt_format(\IntlDateFormatter $formatter, mixed $datetime): string|false
function datefmt_format(\IntlDateFormatter $formatter, \IntlCalendar|\DateTimeInterface|LocalTimeParts|int|float $datetime): string|false;

// @overlay-against: function datefmt_format_object(mixed $datetime, mixed $format, ?string $locale): string|false
function datefmt_format_object(\IntlCalendar|\DateTimeInterface $datetime, array<int, int>|int|string|null $format = null, ?string $locale = null): string|false;

// @overlay-against: function datefmt_localtime(\IntlDateFormatter $formatter, string $string, mixed $offset): array|false
function datefmt_localtime(\IntlDateFormatter $formatter, string $string, mixed &$offset = null): LocalTimeParts|false;

// @overlay-against: function idn_to_ascii(string $domain, int $flags, int $variant, mixed $idna_info): string|false
function idn_to_ascii(string $domain, int $flags = IDNA_DEFAULT, int $variant = INTL_IDNA_VARIANT_UTS46, mixed &$idna_info = null): string|false;
// @overlay-against: function idn_to_ascii(string $domain, int $flags, int $variant, mixed $idna_info): string|false
function idn_to_ascii(string $domain, int $flags, int $variant, IdnaInfo &$idna_info): string|false;

// @overlay-against: function idn_to_utf8(string $domain, int $flags, int $variant, mixed $idna_info): string|false
function idn_to_utf8(string $domain, int $flags = IDNA_DEFAULT, int $variant = INTL_IDNA_VARIANT_UTS46, mixed &$idna_info = null): string|false;
// @overlay-against: function idn_to_utf8(string $domain, int $flags, int $variant, mixed $idna_info): string|false
function idn_to_utf8(string $domain, int $flags, int $variant, IdnaInfo &$idna_info): string|false;

// @overlay-against: function intlcal_get_available_locales(): array
function intlcal_get_available_locales(): array<int, string>;

// @overlay-against: function locale_compose(array $subtags): string|false
function locale_compose(array<string, string> $subtags): string|false;

// @overlay-against: function locale_get_all_variants(string $locale): ?array
function locale_get_all_variants(string $locale): ?array<int, string>;

// @overlay-against: function locale_get_keywords(string $locale): array|false|null
function locale_get_keywords(string $locale): array<string, string>|false|null;

// @overlay-against: function locale_lookup(array $languageTag, string $locale, bool $canonicalize, ?string $defaultLocale): ?string
function locale_lookup(array<int, string> $languageTag, string $locale, bool $canonicalize = false, ?string $defaultLocale = null): ?string;

// @overlay-against: function locale_parse(string $locale): ?array
function locale_parse(string $locale): ?array<string, string>;

// @overlay-against: function msgfmt_format(\MessageFormatter $formatter, array $values): string|false
function msgfmt_format(\MessageFormatter $formatter, array<int|string, mixed> $values): string|false;

// @overlay-against: function msgfmt_format_message(string $locale, string $pattern, array $values): string|false
function msgfmt_format_message(string $locale, string $pattern, array<int|string, mixed> $values): string|false;

// @overlay-against: function msgfmt_parse(\MessageFormatter $formatter, string $string): array|false
function msgfmt_parse(\MessageFormatter $formatter, string $string): array<int|string, mixed>|false;

// @overlay-against: function msgfmt_parse_message(string $locale, string $pattern, string $message): array|false
function msgfmt_parse_message(string $locale, string $pattern, string $message): array<int|string, mixed>|false;

// @overlay-against: function numfmt_parse(\NumberFormatter $formatter, string $string, int $type, mixed $offset): int|float|false
function numfmt_parse(\NumberFormatter $formatter, string $string, 1 $type, mixed &$offset = null): int|false;
// @overlay-against: function numfmt_parse(\NumberFormatter $formatter, string $string, int $type, mixed $offset): int|float|false
function numfmt_parse(\NumberFormatter $formatter, string $string, 2 $type, mixed &$offset = null): int|false;
// @overlay-against: function numfmt_parse(\NumberFormatter $formatter, string $string, int $type, mixed $offset): int|float|false
function numfmt_parse(\NumberFormatter $formatter, string $string, 3 $type, mixed &$offset = null): float|false;
// @overlay-against: function numfmt_parse(\NumberFormatter $formatter, string $string, int $type, mixed $offset): int|float|false
function numfmt_parse(\NumberFormatter $formatter, string $string, int $type = NumberFormatter::TYPE_DOUBLE, mixed &$offset = null): int|float|false;

// @overlay-against: function resourcebundle_locales(string $bundle): array|false
function resourcebundle_locales(string $bundle): array<int, string>|false;

// @overlay-against: function transliterator_list_ids(): array|false
function transliterator_list_ids(): array<int, string>|false;

declare(php="<8.3") {
    // @overlay-against: function datefmt_set_timezone(\IntlDateFormatter $formatter, mixed $timezone): ?bool
    function datefmt_set_timezone(\IntlDateFormatter $formatter, \IntlTimeZone|\DateTimeZone|string|null $timezone): ?bool;
}

declare(php="<8.5") {
    // @overlay-against: function datefmt_create(?string $locale, int $dateType, int $timeType, mixed $timezone, \IntlCalendar|int|null $calendar, ?string $pattern): ?\IntlDateFormatter
    function datefmt_create(?string $locale, int $dateType = IntlDateFormatter::FULL, int $timeType = IntlDateFormatter::FULL, \IntlTimeZone|\DateTimeZone|string|null $timezone = null, \IntlCalendar|int|null $calendar = null, ?string $pattern = null): ?\IntlDateFormatter;
    // @overlay-against: function intlcal_create_instance(mixed $timezone, ?string $locale): ?\IntlCalendar
    function intlcal_create_instance(\IntlTimeZone|\DateTimeZone|string|null $timezone = null, ?string $locale = null): ?\IntlCalendar;
    // @overlay-against: function intlcal_set_time_zone(\IntlCalendar $calendar, mixed $timezone): bool
    function intlcal_set_time_zone(\IntlCalendar $calendar, \IntlTimeZone|\DateTimeZone|string|null $timezone): bool;
    // @overlay-against: function intltz_create_enumeration(mixed $countryOrRawOffset): \IntlIterator|false
    function intltz_create_enumeration(string|int|null $countryOrRawOffset = null): \IntlIterator|false;
}

declare(php=">=8.3 <8.5") {
    // @overlay-against: function datefmt_set_timezone(\IntlDateFormatter $formatter, mixed $timezone): bool
    function datefmt_set_timezone(\IntlDateFormatter $formatter, \IntlTimeZone|\DateTimeZone|string|null $timezone): bool;
}

declare(php=">=8.4") {
    // @overlay-against: function grapheme_str_split(string $string, int $length): array|false
    function grapheme_str_split(string $string, int $length = 1): array<int, string>|false;
}

