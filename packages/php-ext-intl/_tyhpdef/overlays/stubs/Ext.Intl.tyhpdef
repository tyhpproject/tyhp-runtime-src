    public function asort(array &$array, int $flags = Collator::SORT_REGULAR): bool;
    /**
    * Sort array using specified collator
    *
    * Procedural style
    *
    * @param $object Collator object.
    * @param $array Array of strings to sort.
    * @param $flags Optional sorting type, one of the following: **`Collator::SORT_REGULAR`** - compare items normally (don't change types) **`Collator::SORT_NUMERIC`** - compare items numerically **`Collator::SORT_STRING`** - compare items as strings Default sorting type is **`Collator::SORT_REGULAR`**. It is also used if an invalid `$flags` value has been specified.
    * @return Returns **`true`** on success or **`false`** on failure.
    * @link https://www.php.net/manual/en/collator.sort.php
    * @generated from PHP v8.5.8, EXT: intl v8.5.8
