<?tyhpdef

namespace Tyhp;

extension IntlStringExtensions extends string {
    #[\Tyhp\Optimize\Pure]
    fn transliterate(string $id, ?string $rules = null, bool $reverse = false): string|false
        => \transliterator_transliterate($id, $this);

    #[\Tyhp\Optimize\Pure]
    fn normalizeUnicode(int $form = \Normalizer::FORM_C): string|false
        => \Normalizer::normalize($this, $form);

    #[\Tyhp\Optimize\Pure]
    fn isNormalized(int $form = \Normalizer::FORM_C): bool
        => \Normalizer::isNormalized($this, $form);
}

global use extension \Tyhp\IntlStringExtensions;
