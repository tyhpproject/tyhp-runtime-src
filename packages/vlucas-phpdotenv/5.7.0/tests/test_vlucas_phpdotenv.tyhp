<?tyhp

function test_dotenv_create_immutable(): \Dotenv\Dotenv
{
    return \Dotenv\Dotenv::createImmutable('/app');
}

function test_dotenv_create_paths(): \Dotenv\Dotenv
{
    return \Dotenv\Dotenv::createMutable(['/app', '/app/config']);
}

function test_dotenv_required(\Dotenv\Dotenv $dotenv): \Dotenv\Validator
{
    return $dotenv->required(['APP_KEY', 'APP_ENV']);
}

function test_dotenv_parse(): array<string, string|null>
{
    return \Dotenv\Dotenv::parse("FOO=bar\n");
}
