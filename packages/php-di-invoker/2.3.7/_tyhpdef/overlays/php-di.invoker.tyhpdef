namespace Invoker {
    /**
     * Overlay: `call()` accepts a PHP callable, a class-method array, or a container id.
     */
    // @overlay-against: interface InvokerInterface
    partial interface InvokerInterface {
        /**
         * @param callable|array<int|string, mixed>|string $callable
         * @param array<int|string, mixed> $parameters
         */
        // @overlay-against: function call(callable|array|string $callable, array $parameters): mixed
        public function call(callable|array<int|string, mixed>|string $callable, array<int|string, mixed> $parameters = []): mixed;
    }

    /**
     * Overlay: same `call()` contract on the default invoker.
     */
    // @overlay-against: class Invoker implements \Invoker\InvokerInterface
    partial class Invoker {
        /**
         * @param callable|array<int|string, mixed>|string $callable
         * @param array<int|string, mixed> $parameters
         */
        // @overlay-against: function call(mixed $callable, array $parameters): mixed
        public function call(callable|array<int|string, mixed>|string $callable, array<int|string, mixed> $parameters = []): mixed;
    }

    /**
     * Overlay: resolve() accepts the same callable shapes.
     */
    // @overlay-against: class CallableResolver
    partial class CallableResolver {
        /**
         * @param callable|string|array<int|string, mixed> $callable
         */
        // @overlay-against: function resolve(callable|string|array $callable): callable
        public function resolve(callable|string|array<int|string, mixed> $callable): callable;
    }
}

