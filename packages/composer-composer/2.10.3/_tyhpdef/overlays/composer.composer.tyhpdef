<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * PHPStan plugin types are omitted from Layer 1 (they name unowned PHPStan interfaces).
 * Json-schema peers are STOP skeletons — do not invent those APIs.
 */

namespace Composer {
    /**
     * Overlay: one `vendor/composer/installed.php` dataset.
     */
    type InstalledData = struct {
        InstalledRootPackage $root;
        array<string, InstalledVersion> $versions;
    };

    /**
     * Overlay: `InstalledVersions::getRootPackage()` root record.
     */
    type InstalledRootPackage = struct {
        string $name;
        string $pretty_version;
        string $version;
        ?string $reference;
        string $type;
        string $install_path;
        array<int, string> $aliases;
        bool $dev;
    };

    /**
     * Overlay: one package entry inside `installed.php` `versions`.
     */
    type InstalledVersion = struct {
        ?string $pretty_version;
        ?string $version;
        ?string $reference;
        ?string $type;
        ?string $install_path;
        ?array<int, string> $aliases;
        bool $dev_requirement;
        ?array<int, string> $replaced;
        ?array<int, string> $provided;
    };

    /**
     * Overlay: PHPDoc `@return Archiver\ArchiveManager` is relative; the type is Package\Archiver.
     */
    // @overlay-against: class Factory
    partial class Factory {
        /**
         * @param \Composer\Config $config The configuration
         * @param \Composer\Downloader\DownloadManager $dm Manager use to download sources
         */
        // @overlay-against: function createArchiveManager(\Composer\Config $config, \Composer\Downloader\DownloadManager $dm, \Composer\Util\Loop $loop): \Archiver\ArchiveManager
        public function createArchiveManager(\Composer\Config $config, \Composer\Downloader\DownloadManager $dm, \Composer\Util\Loop $loop): \Composer\Package\Archiver\ArchiveManager;
    }
}

namespace Composer\MetadataMinifier {
    /**
     * Layer 1 omits this Composer sibling; Util\MetadataMinifier extends it.
     */
    class MetadataMinifier {
    }
}

namespace Composer\EventDispatcher {
