        protected function extractDevPackages(\Composer\DependencyResolver\LockTransaction $lockTransaction, \Composer\Repository\PlatformRepository $platformRepo, array<int, array<string, string>> $aliases, \Composer\DependencyResolver\PolicyInterface $policy, ?\Composer\Repository\LockArrayRepository $lockedRepository = null): int;
