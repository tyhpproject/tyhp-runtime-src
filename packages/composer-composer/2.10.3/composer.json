{
    "name": "tyhpdef/composer-composer",
    "description": "Tyhp type definitions for the Composer package composer/composer (2.10.3).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.10.3.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-finder": "@dev",
                "tyhpdef/symfony-console": "@dev",
                "tyhpdef/composer-semver": "@dev",
                "tyhpdef/composer-class-map-generator": "@dev",
                "tyhpdef/react-promise": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/symfony-process": "@dev",
                "tyhpdef/seld-jsonlint": "@dev",
                "tyhpdef/nikic-php-parser": "@dev",
                "tyhpdef/php-ext-phar": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
                "tyhpdef/psr-event-dispatcher": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "composer/composer": "2.10.3"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-finder": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/composer-semver": "@dev",
        "tyhpdef/composer-class-map-generator": "@dev",
        "tyhpdef/react-promise": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/symfony-process": "@dev",
        "tyhpdef/seld-jsonlint": "@dev",
        "tyhpdef/nikic-php-parser": "@dev",
        "tyhpdef/php-ext-phar": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
        "tyhpdef/psr-event-dispatcher": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../symfony-finder/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-console/7.4.19"
        },
        {
            "type": "path",
            "url": "../../composer-semver/3.4.4"
        },
        {
            "type": "path",
            "url": "../../composer-class-map-generator/1.7.3"
        },
        {
            "type": "path",
            "url": "../../react-promise/3.3.0"
        },
        {
            "type": "path",
            "url": "../../psr-log/3.0.2"
        },
        {
            "type": "path",
            "url": "../../symfony-process/7.4.19"
        },
        {
            "type": "path",
            "url": "../../seld-jsonlint/1.12.1"
        },
        {
            "type": "path",
            "url": "../../nikic-php-parser/5.9.0"
        },
        {
            "type": "path",
            "url": "../../php-ext-phar"
        },
        {
            "type": "path",
            "url": "../../psr-container/2.0.2"
        },
        {
            "type": "path",
            "url": "../../symfony-service-contracts/3.7.3"
        },
        {
            "type": "path",
            "url": "../../symfony-event-dispatcher-contracts/3.7.1"
        },
        {
            "type": "path",
            "url": "../../psr-event-dispatcher/1.0.0"
        },
        {
            "type": "path",
            "url": "../../psr-log/2.0.0"
        }
    ]
}
