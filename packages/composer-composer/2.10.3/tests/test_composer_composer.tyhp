<?tyhp

function test_composer_plugin_api_version(): string
{
    return \Composer\Plugin\PluginInterface::PLUGIN_API_VERSION;
}

function test_composer_event(): \Composer\EventDispatcher\Event
{
    return new \Composer\EventDispatcher\Event('scripts');
}

function test_composer_event_name(\Composer\EventDispatcher\Event $event): string
{
    return $event->getName();
}
