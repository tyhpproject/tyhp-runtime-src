<?tyhp

function test_whoops_register(): \Whoops\Run
{
    $run = new \Whoops\Run();
    return $run->register();
}

function test_whoops_push_handler(\Whoops\Run $run): \Whoops\Run
{
    return $run->pushHandler(new \Whoops\Handler\PlainTextHandler());
}

function test_whoops_frame_is_application(\Whoops\Exception\Frame $frame): bool
{
    $frame->setApplication(true);
    return $frame->isApplication();
}
