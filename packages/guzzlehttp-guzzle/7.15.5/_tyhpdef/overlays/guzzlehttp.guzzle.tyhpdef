<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Tightens Client and ClientInterface transfer options and async results to PromiseInterface<ResponseInterface>.
 */

namespace GuzzleHttp {
    /**
     * Client constructor / request transfer options (`RequestOptions` keys plus `base_uri` / `handler`).
     */
    type GuzzleTransferOptions = array<string, mixed>;

    /**
     * Overlay: options maps and async results are `PromiseInterface<ResponseInterface>`.
     */
    // @overlay-against: class Client implements \GuzzleHttp\ClientInterface, \Psr\Http\Client\ClientInterface, \GuzzleHttp\ClientTrait
    partial class Client {
        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $config
         */
        // @overlay-against: function __construct(array $config): void
        public function __construct(\GuzzleHttp\GuzzleTransferOptions $config = []): void;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         */
        // @overlay-against: function send(\Psr\Http\Message\RequestInterface $request, array $options): \Psr\Http\Message\ResponseInterface
        public function send(\Psr\Http\Message\RequestInterface $request, \GuzzleHttp\GuzzleTransferOptions $options = []): \Psr\Http\Message\ResponseInterface;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         * @return \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>
         */
        // @overlay-against: function sendAsync(\Psr\Http\Message\RequestInterface $request, array $options): \GuzzleHttp\Promise\PromiseInterface
        public function sendAsync(\Psr\Http\Message\RequestInterface $request, \GuzzleHttp\GuzzleTransferOptions $options = []): \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         */
        // @overlay-against: function request(string $method, string|\Psr\Http\Message\UriInterface $uri, array $options): \Psr\Http\Message\ResponseInterface
        public function request(string $method, string|\Psr\Http\Message\UriInterface $uri = '', \GuzzleHttp\GuzzleTransferOptions $options = []): \Psr\Http\Message\ResponseInterface;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         * @return \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>
         */
        // @overlay-against: function requestAsync(string $method, string|\Psr\Http\Message\UriInterface $uri, array $options): \GuzzleHttp\Promise\PromiseInterface
        public function requestAsync(string $method, string|\Psr\Http\Message\UriInterface $uri = '', \GuzzleHttp\GuzzleTransferOptions $options = []): \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>;
    }

    /**
     * Overlay: same options maps on the public client interface.
     */
    // @overlay-against: interface ClientInterface
    partial interface ClientInterface {
        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         */
        // @overlay-against: function send(\Psr\Http\Message\RequestInterface $request, array $options): \Psr\Http\Message\ResponseInterface
        public function send(\Psr\Http\Message\RequestInterface $request, \GuzzleHttp\GuzzleTransferOptions $options = []): \Psr\Http\Message\ResponseInterface;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         * @return \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>
         */
        // @overlay-against: function sendAsync(\Psr\Http\Message\RequestInterface $request, array $options): \GuzzleHttp\Promise\PromiseInterface
        public function sendAsync(\Psr\Http\Message\RequestInterface $request, \GuzzleHttp\GuzzleTransferOptions $options = []): \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         */
        // @overlay-against: function request(string $method, string|\Psr\Http\Message\UriInterface $uri, array $options): \Psr\Http\Message\ResponseInterface
        public function request(string $method, string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \Psr\Http\Message\ResponseInterface;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         * @return \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>
         */
        // @overlay-against: function requestAsync(string $method, string|\Psr\Http\Message\UriInterface $uri, array $options): \GuzzleHttp\Promise\PromiseInterface
        public function requestAsync(string $method, string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>;
    }

    /**
     * Verb helpers use the same transfer options and async result as `request`.
     */
    // @overlay-against: trait ClientTrait
    partial trait ClientTrait {
        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         */
        // @overlay-against: function request(string $method, string|\Psr\Http\Message\UriInterface $uri, array $options): \Psr\Http\Message\ResponseInterface
        public abstract function request(string $method, string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \Psr\Http\Message\ResponseInterface;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         */
        // @overlay-against: function delete(string|\Psr\Http\Message\UriInterface $uri, array $options): \Psr\Http\Message\ResponseInterface
        public function delete(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \Psr\Http\Message\ResponseInterface;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         * @return \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>
         */
        // @overlay-against: function deleteAsync(string|\Psr\Http\Message\UriInterface $uri, array $options): \GuzzleHttp\Promise\PromiseInterface
        public function deleteAsync(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         */
        // @overlay-against: function get(string|\Psr\Http\Message\UriInterface $uri, array $options): \Psr\Http\Message\ResponseInterface
        public function get(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \Psr\Http\Message\ResponseInterface;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         * @return \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>
         */
        // @overlay-against: function getAsync(string|\Psr\Http\Message\UriInterface $uri, array $options): \GuzzleHttp\Promise\PromiseInterface
        public function getAsync(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         */
        // @overlay-against: function head(string|\Psr\Http\Message\UriInterface $uri, array $options): \Psr\Http\Message\ResponseInterface
        public function head(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \Psr\Http\Message\ResponseInterface;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         * @return \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>
         */
        // @overlay-against: function headAsync(string|\Psr\Http\Message\UriInterface $uri, array $options): \GuzzleHttp\Promise\PromiseInterface
        public function headAsync(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         */
        // @overlay-against: function patch(string|\Psr\Http\Message\UriInterface $uri, array $options): \Psr\Http\Message\ResponseInterface
        public function patch(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \Psr\Http\Message\ResponseInterface;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         * @return \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>
         */
        // @overlay-against: function patchAsync(string|\Psr\Http\Message\UriInterface $uri, array $options): \GuzzleHttp\Promise\PromiseInterface
        public function patchAsync(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         */
        // @overlay-against: function post(string|\Psr\Http\Message\UriInterface $uri, array $options): \Psr\Http\Message\ResponseInterface
        public function post(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \Psr\Http\Message\ResponseInterface;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         * @return \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>
         */
        // @overlay-against: function postAsync(string|\Psr\Http\Message\UriInterface $uri, array $options): \GuzzleHttp\Promise\PromiseInterface
        public function postAsync(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         */
        // @overlay-against: function put(string|\Psr\Http\Message\UriInterface $uri, array $options): \Psr\Http\Message\ResponseInterface
        public function put(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \Psr\Http\Message\ResponseInterface;

        /**
         * @param \GuzzleHttp\GuzzleTransferOptions $options
         * @return \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>
         */
        // @overlay-against: function putAsync(string|\Psr\Http\Message\UriInterface $uri, array $options): \GuzzleHttp\Promise\PromiseInterface
        public function putAsync(string|\Psr\Http\Message\UriInterface $uri, \GuzzleHttp\GuzzleTransferOptions $options = []): \GuzzleHttp\Promise\PromiseInterface<\Psr\Http\Message\ResponseInterface>;
    }
}
