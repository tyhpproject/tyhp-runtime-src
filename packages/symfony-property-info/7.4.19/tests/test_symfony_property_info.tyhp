<?tyhp

function test_property_info_list(): array<int, string>|null
{
    $extractor = new \Symfony\Component\PropertyInfo\PropertyInfoExtractor();
    return $extractor->getProperties(\stdClass::class);
}

function test_property_info_type(): ?\Symfony\Component\TypeInfo\Type
{
    $extractor = new \Symfony\Component\PropertyInfo\PropertyInfoExtractor();
    return $extractor->getType(\stdClass::class, 'name');
}
