<?tyhp

function test_symfony_event_dispatcher_dispatch(\Symfony\Contracts\EventDispatcher\EventDispatcherInterface $dispatcher, \stdClass $event): \stdClass
{
    return $dispatcher->dispatch($event);
}

function test_symfony_event_dispatcher_dispatch_named(\Symfony\Contracts\EventDispatcher\EventDispatcherInterface $dispatcher, \stdClass $event): \stdClass
{
    return $dispatcher->dispatch($event, 'app.event');
}

function test_symfony_event_stoppable(\Symfony\Contracts\EventDispatcher\Event $event): \Psr\EventDispatcher\StoppableEventInterface
{
    $event->stopPropagation();
    return $event;
}
