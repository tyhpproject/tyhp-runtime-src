<?tyhp

function test_symfony_service_container(\Symfony\Contracts\Service\ContainerProviderInterface $provider): \Psr\Container\ContainerInterface
{
    return $provider->getContainer();
}

function test_symfony_service_reset(\Symfony\Contracts\Service\ResetInterface $reset): void
{
    $reset->reset();
}

function test_symfony_service_provider_get(\Symfony\Contracts\Service\ServiceProviderInterface $provider): \stdClass
{
    return $provider->get(\stdClass::class);
}

function test_symfony_service_provider_has(\Symfony\Contracts\Service\ServiceProviderInterface $provider, string $id): bool
{
    return $provider->has($id);
}

function test_symfony_service_provided(\Symfony\Contracts\Service\ServiceProviderInterface $provider): array<string, string>
{
    return $provider->getProvidedServices();
}

function test_symfony_subscribed_services(): array<int|string, string>|array<int|string, \Symfony\Contracts\Service\Attribute\SubscribedService>
{
    return ['logger' => 'Psr\\Log\\LoggerInterface'];
}

function test_symfony_required_attribute(): \Symfony\Contracts\Service\Attribute\Required
{
    return new \Symfony\Contracts\Service\Attribute\Required(10);
}

function test_symfony_subscribed_service_attribute(): \Symfony\Contracts\Service\Attribute\SubscribedService
{
    return new \Symfony\Contracts\Service\Attribute\SubscribedService('logger', 'Psr\\Log\\LoggerInterface');
}
