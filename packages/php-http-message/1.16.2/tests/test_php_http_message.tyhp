<?tyhp

function test_php_http_auth_basic(\Psr\Http\Message\RequestInterface $request): \Psr\Http\Message\RequestInterface
{
    return (new \Http\Message\Authentication\BasicAuth('user', 'pass'))->authenticate($request);
}

function test_php_http_auth_bearer(\Psr\Http\Message\RequestInterface $request): \Psr\Http\Message\RequestInterface
{
    return (new \Http\Message\Authentication\Bearer('token'))->authenticate($request);
}

function test_php_http_auth_chain(\Http\Message\Authentication $first, \Http\Message\Authentication $second): \Http\Message\Authentication
{
    return new \Http\Message\Authentication\Chain([$first, $second]);
}

function test_php_http_cookie(): \Http\Message\Cookie
{
    return new \Http\Message\Cookie('sid', 'abc', 3600, 'example.com', '/', true, true);
}

function test_php_http_cookie_unvalidated(): \Http\Message\Cookie
{
    return \Http\Message\Cookie::createWithoutValidation('sid', 'abc');
}

function test_php_http_cookie_jar(\Http\Message\Cookie $cookie): int
{
    $jar = new \Http\Message\CookieJar();
    $jar->addCookie($cookie);
    return $jar->count();
}

function test_php_http_formatter(\Http\Message\Formatter $formatter, \Psr\Http\Message\RequestInterface $request): string
{
    return $formatter->formatRequest($request);
}

function test_php_http_request_matcher(\Http\Message\RequestMatcher $matcher, \Psr\Http\Message\RequestInterface $request): bool
{
    return $matcher->matches($request);
}

function test_php_http_message_factory(\Http\Message\MessageFactory $factory): \Psr\Http\Message\RequestInterface
{
    return $factory->createRequest('GET', 'https://example.com');
}
