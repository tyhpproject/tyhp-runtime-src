<?tyhp

function test_container_make_class(\Illuminate\Container\Container $c): \stdClass
{
    return $c->make(\stdClass::class);
}

function test_container_get_class(\Illuminate\Container\Container $c): \stdClass
{
    return $c->get(\stdClass::class);
}

function test_container_bound(\Illuminate\Container\Container $c): bool
{
    return $c->bound(\stdClass::class);
}

function test_container_has(\Illuminate\Container\Container $c): bool
{
    return $c->has(\stdClass::class);
}
