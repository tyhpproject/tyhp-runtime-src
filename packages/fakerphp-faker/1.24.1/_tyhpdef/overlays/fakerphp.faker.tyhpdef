<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Factory::create and proxy constructors return/take Faker\Generator
 * (Layer 1 harvested PHP's `\Generator`). numberBetween args are integers.
 */

namespace Faker {
    type CreditCardDetails = struct {
        string $expirationDate;
        string $name;
        string $number;
        string $type;
    };

    type LocalCoordinates = struct {
        float $latitude;
        float $longitude;
    };

    /**
     * Overlay: PHPDoc `Extension|Generator` is Faker\Generator, not PHP's `\Generator`.
     */
    // @overlay-against: class ChanceGenerator
    partial class ChanceGenerator {
        // @overlay-against: function __construct(\Faker\Extension\Extension|\Generator $generator, float $weight, mixed $default): void
        public function __construct(\Faker\Extension\Extension|\Faker\Generator $generator, float $weight, mixed $default = null);
    }

    /**
     * Overlay: constructor generator is Faker\Generator.
     */
    // @overlay-against: class Documentor
    partial class Documentor {
        // @overlay-against: function __construct(\Generator $generator): void
        public function __construct(\Faker\Generator $generator);

        // @overlay-against: function getFormatters(): array
        public function getFormatters(): array<string, array<string, string>>;
    }

    /**
     * Overlay: @return Generator is Faker\Generator.
     */
    // @overlay-against: class Factory
    partial class Factory {
        /**
         * @return \Generator
         */
        // @overlay-against: function create(string $locale): \Generator
        public static function create(string $locale = self::DEFAULT_LOCALE): \Faker\Generator;
    }

    /**
     * Overlay: numberBetween args are integers.
     */
    // @overlay-against: class Generator
    partial class Generator {
        // @overlay-against: function creditCardDetails(mixed $valid): array
        public function creditCardDetails(mixed $valid): CreditCardDetails;

        // @overlay-against: function hslColorAsArray(): array
        public function hslColorAsArray(): array<int, int>;

        // @overlay-against: function localCoordinates(): array
        public function localCoordinates(): LocalCoordinates;

        /**
         * Returns a random number between $int1 and $int2 (any order)
         */
        // @overlay-against: function numberBetween(mixed $int1, mixed $int2): int
        public function numberBetween(int $int1 = 0, int $int2 = 2147483647): int;

        // @overlay-against: function paragraphs(mixed $nb, mixed $asText): array|string
        public function paragraphs(mixed $nb, mixed $asText): array<int, string>|string;

        // @overlay-against: function randomElements(mixed $array, mixed $count, mixed $allowDuplicates): array
        public function randomElements(mixed $array, mixed $count, mixed $allowDuplicates): array<int, mixed>;

        // @overlay-against: function rgbColorAsArray(): array
        public function rgbColorAsArray(): array<int, int>;

        // @overlay-against: function sentences(mixed $nb, mixed $asText): array|string
        public function sentences(mixed $nb, mixed $asText): array<int, string>|string;

        // @overlay-against: function shuffle(mixed $arg): array|string
        public function shuffle(mixed $arg): array<int, mixed>|string;

        // @overlay-against: function shuffleArray(mixed $array): array
        public function shuffleArray(mixed $array): array<int, mixed>;

        // @overlay-against: function words(mixed $nb, mixed $asText): array|string
        public function words(mixed $nb, mixed $asText): array<int, string>|string;
    }

    /**
     * Overlay: unique() proxy wraps Faker\Generator.
     */
    // @overlay-against: class UniqueGenerator
    partial class UniqueGenerator {
        // @overlay-against: function __construct(\Faker\Extension\Extension|\Generator $generator, int $maxRetries, array $uniques): void
        public function __construct(\Faker\Extension\Extension|\Faker\Generator $generator, int $maxRetries = 10000, array<string, array<string, null>> &$uniques = []);
    }

    /**
     * Overlay: valid() proxy wraps Faker\Generator.
     */
    // @overlay-against: class ValidGenerator
    partial class ValidGenerator {
        // @overlay-against: function __construct(\Faker\Extension\Extension|\Generator $generator, callable|null $validator, int $maxRetries): void
        public function __construct(\Faker\Extension\Extension|\Faker\Generator $generator, callable|null $validator = null, int $maxRetries = 10000);
    }
}

namespace Faker\Core {
    // @overlay-against: class Coordinates implements \Faker\Extension\Extension
    partial class Coordinates {
        // @overlay-against: function localCoordinates(): array
        public function localCoordinates(): \Faker\LocalCoordinates;
    }
}

