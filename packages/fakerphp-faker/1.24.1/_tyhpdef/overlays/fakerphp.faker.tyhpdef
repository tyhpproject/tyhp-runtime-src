namespace Faker\Provider {
    // @overlay-against: class Address extends \Faker\Provider\Base
    partial class Address {
        // @overlay-against: function localCoordinates(): array
        public static function localCoordinates(): \Faker\LocalCoordinates;
    }

    // @overlay-against: class Color extends \Faker\Provider\Base
    partial class Color {
        // @overlay-against: function hslColorAsArray(): array
        public static function hslColorAsArray(): array<int, int>;

        // @overlay-against: function rgbColorAsArray(): array
        public static function rgbColorAsArray(): array<int, int>;
    }

    // @overlay-against: class Lorem extends \Faker\Provider\Base
    partial class Lorem {
        // @overlay-against: function paragraphs(int $nb, bool $asText): array|string
        public static function paragraphs(int $nb = 3, bool $asText = false): array<int, string>|string;

        // @overlay-against: function sentences(int $nb, bool $asText): array|string
        public static function sentences(int $nb = 3, bool $asText = false): array<int, string>|string;

        // @overlay-against: function words(int $nb, bool $asText): array|string
        public static function words(int $nb = 3, bool $asText = false): array<int, string>|string;
    }

    // @overlay-against: class Payment extends \Faker\Provider\Base
    partial class Payment {
        // @overlay-against: function creditCardDetails(bool $valid): array
        public function creditCardDetails(bool $valid = true): \Faker\CreditCardDetails;
    }
}

