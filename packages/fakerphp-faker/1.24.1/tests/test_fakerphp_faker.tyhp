<?tyhp

function test_fakerphp_faker_luhn_valid(): bool
{
    return \Faker\Calculator\Luhn::isValid('79927398713');
}

function test_fakerphp_faker_luhn_check_digit(): string
{
    return \Faker\Calculator\Luhn::computeCheckDigit('7992739871');
}

function test_fakerphp_factory_create(): \Faker\Generator
{
    return \Faker\Factory::create();
}

function test_fakerphp_number_between(\Faker\Generator $faker): int
{
    return $faker->numberBetween(1, 10);
}
