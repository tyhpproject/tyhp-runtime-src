    // @overlay-against: mixed $PageLinks
    protected array<int, array<int, FpdfAnnotation>> $PageLinks;
    // @overlay-against: mixed $pages
    protected array<int, string> $pages;
    // @overlay-against: mixed $PDFVersion
    protected string $PDFVersion;
    // @overlay-against: mixed $rMargin
    protected FpdfNumber $rMargin;
    // @overlay-against: mixed $state
    protected int $state;
    // @overlay-against: mixed $StdPageSizes
    protected array<string, FpdfPageSize> $StdPageSizes;
    // @overlay-against: mixed $TextColor
    protected string $TextColor;
    // @overlay-against: mixed $tMargin
    protected FpdfNumber $tMargin;
    // @overlay-against: mixed $underline
    protected bool $underline;
    // @overlay-against: mixed $w
    protected FpdfNumber $w;
