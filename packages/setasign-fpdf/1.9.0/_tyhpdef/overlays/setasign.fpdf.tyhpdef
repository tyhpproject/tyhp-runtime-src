    // @overlay-against: function __construct(mixed $orientation, mixed $unit, mixed $size): void
    public function __construct(string $orientation = 'P', string $unit = 'mm', string|FpdfPageSize $size = 'A4'): void;

    // @overlay-against: function AcceptPageBreak(): mixed
    public function AcceptPageBreak(): bool;
    // @overlay-against: function AddFont(mixed $family, mixed $style, mixed $file, mixed $dir): mixed
    public function AddFont(string $family, string $style = '', string $file = '', string $dir = ''): void;
    // @overlay-against: function AddLink(): mixed
    public function AddLink(): int;
    // @overlay-against: function AddPage(mixed $orientation, mixed $size, mixed $rotation): mixed
    public function AddPage(string $orientation = '', string|FpdfPageSize $size = '', int $rotation = 0): void;
    // @overlay-against: function AliasNbPages(mixed $alias): mixed
    public function AliasNbPages(string $alias = '{nb}'): void;
    // @overlay-against: function Cell(mixed $w, mixed $h, mixed $txt, mixed $border, mixed $ln, mixed $align, mixed $fill, mixed $link): mixed
    public function Cell(FpdfNumber $w, FpdfNumber $h = 0, string $txt = '', int|string $border = 0, int $ln = 0, string $align = '', bool $fill = false, string|int $link = ''): void;
    // @overlay-against: function Close(): mixed
    public function Close(): void;
