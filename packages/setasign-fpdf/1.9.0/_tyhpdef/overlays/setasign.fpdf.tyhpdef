    protected string $DefOrientation;
    // @overlay-against: mixed $DefPageSize
    protected FpdfPageSize $DefPageSize;
    // @overlay-against: mixed $DrawColor
    protected string $DrawColor;
    // @overlay-against: mixed $encodings
    protected array<string, int> $encodings;
    // @overlay-against: mixed $FillColor
    protected string $FillColor;
    // @overlay-against: mixed $FontFamily
    protected string $FontFamily;
    // @overlay-against: mixed $FontFiles
    protected array<string, FpdfFontFile> $FontFiles;
    // @overlay-against: mixed $fontpath
    protected string $fontpath;
    // @overlay-against: mixed $fonts
    protected array<string, array<string, mixed>> $fonts;
    // @overlay-against: mixed $FontSize
    protected FpdfNumber $FontSize;
    // @overlay-against: mixed $FontSizePt
    protected FpdfNumber $FontSizePt;
    // @overlay-against: mixed $FontStyle
    protected string $FontStyle;
    // @overlay-against: mixed $h
    protected FpdfNumber $h;
    // @overlay-against: mixed $hPt
    protected FpdfNumber $hPt;
    // @overlay-against: mixed $iconv
    protected bool $iconv;
    // @overlay-against: mixed $images
    protected array<string, array<string, mixed>> $images;
    // @overlay-against: mixed $InFooter
    protected bool $InFooter;
    // @overlay-against: mixed $InHeader
    protected bool $InHeader;
    // @overlay-against: mixed $k
    protected FpdfNumber $k;
    // @overlay-against: mixed $lasth
    protected FpdfNumber $lasth;
    // @overlay-against: mixed $LayoutMode
