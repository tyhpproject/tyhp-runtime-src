    // @overlay-against: function Link(mixed $x, mixed $y, mixed $w, mixed $h, mixed $link): mixed
    public function Link(FpdfNumber $x, FpdfNumber $y, FpdfNumber $w, FpdfNumber $h, string|int $link): void;
    // @overlay-against: function Ln(mixed $h): mixed
    public function Ln(?FpdfNumber $h = null): void;
    // @overlay-against: function MultiCell(mixed $w, mixed $h, mixed $txt, mixed $border, mixed $align, mixed $fill): mixed
    public function MultiCell(FpdfNumber $w, FpdfNumber $h, string $txt, int|string $border = 0, string $align = 'J', bool $fill = false): void;
    // @overlay-against: function Output(mixed $dest, mixed $name, mixed $isUTF8): mixed
    public function Output(string $dest = '', string $name = '', bool $isUTF8 = false): string;
    // @overlay-against: function PageNo(): mixed
    public function PageNo(): int;
    // @overlay-against: function Rect(mixed $x, mixed $y, mixed $w, mixed $h, mixed $style): mixed
    public function Rect(FpdfNumber $x, FpdfNumber $y, FpdfNumber $w, FpdfNumber $h, string $style = ''): void;
    // @overlay-against: function SetAuthor(mixed $author, mixed $isUTF8): mixed
    public function SetAuthor(string $author, bool $isUTF8 = false): void;
    // @overlay-against: function SetAutoPageBreak(mixed $auto, mixed $margin): mixed
    public function SetAutoPageBreak(bool $auto, FpdfNumber $margin = 0): void;
    // @overlay-against: function SetCompression(mixed $compress): mixed
    public function SetCompression(bool $compress): void;
    // @overlay-against: function SetCreator(mixed $creator, mixed $isUTF8): mixed
    public function SetCreator(string $creator, bool $isUTF8 = false): void;
    // @overlay-against: function SetDisplayMode(mixed $zoom, mixed $layout): mixed
    public function SetDisplayMode(string|FpdfNumber $zoom, string $layout = 'default'): void;
    // @overlay-against: function SetDrawColor(mixed $r, mixed $g, mixed $b): mixed
    public function SetDrawColor(FpdfNumber $r, ?FpdfNumber $g = null, ?FpdfNumber $b = null): void;
    // @overlay-against: function SetFillColor(mixed $r, mixed $g, mixed $b): mixed
    public function SetFillColor(FpdfNumber $r, ?FpdfNumber $g = null, ?FpdfNumber $b = null): void;
    // @overlay-against: function SetFont(mixed $family, mixed $style, mixed $size): mixed
    public function SetFont(string $family, string $style = '', FpdfNumber $size = 0): void;
    // @overlay-against: function SetFontSize(mixed $size): mixed
    public function SetFontSize(FpdfNumber $size): void;
    // @overlay-against: function SetKeywords(mixed $keywords, mixed $isUTF8): mixed
    public function SetKeywords(string $keywords, bool $isUTF8 = false): void;
    // @overlay-against: function SetLeftMargin(mixed $margin): mixed
    public function SetLeftMargin(FpdfNumber $margin): void;
    // @overlay-against: function SetLineWidth(mixed $width): mixed
