<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * User-unit lengths are int|float (`FpdfNumber`). A page size is a two-number
 * list or a standard name.
 */

type FpdfAnnotation = struct {
    FpdfNumber 0 as $x;
    FpdfNumber 1 as $y;
    FpdfNumber 2 as $width;
    FpdfNumber 3 as $height;
    string|int 4 as $link;
};

type FpdfFontFile = struct {
    int $length1;
    ?int $length2;
    ?int $n;
};

type FpdfInternalLink = struct {
    int 0 as $page;
    FpdfNumber 1 as $y;
};

type FpdfNumber = int|float;

type FpdfPageInfo = struct {
    ?FpdfPageSize $size;
    ?int $rotation;
    ?int $n;
};

type FpdfPageSize = struct {
    FpdfNumber 0 as $width;
    FpdfNumber 1 as $height;
};

// @overlay-against: class FPDF
partial class FPDF {
    // @overlay-against: mixed $AliasNbPages
    protected ?string $AliasNbPages;
    // @overlay-against: mixed $AutoPageBreak
    protected bool $AutoPageBreak;
    // @overlay-against: mixed $bMargin
    protected FpdfNumber $bMargin;
    // @overlay-against: mixed $buffer
    protected string $buffer;
    // @overlay-against: mixed $cMargin
    protected FpdfNumber $cMargin;
    // @overlay-against: mixed $cmaps
    protected array<string, int> $cmaps;
    // @overlay-against: mixed $ColorFlag
    protected bool $ColorFlag;
