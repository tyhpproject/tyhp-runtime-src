<?tyhp

function test_invoker_new(): \Invoker\InvokerInterface
{
    return new \Invoker\Invoker();
}

function test_invoker_call(\Invoker\Invoker $invoker): mixed
{
    return $invoker->call(static fn (): int => 1);
}

function test_invoker_call_named(\Invoker\InvokerInterface $invoker): mixed
{
    return $invoker->call(static fn (string $name): string => $name, ['name' => 'tyhp']);
}

function test_invoker_resolver_chain(\Invoker\ParameterResolver\ParameterResolver $a, \Invoker\ParameterResolver\ParameterResolver $b): \Invoker\ParameterResolver\ParameterResolver
{
    return new \Invoker\ParameterResolver\ResolverChain([$a, $b]);
}

function test_invoker_callable_resolver(\Psr\Container\ContainerInterface $c): \Invoker\CallableResolver
{
    return new \Invoker\CallableResolver($c);
}
