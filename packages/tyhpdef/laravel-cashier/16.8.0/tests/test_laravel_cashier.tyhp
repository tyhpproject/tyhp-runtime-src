<?tyhp

function test_cashier_version(): string
{
    return \Laravel\Cashier\Cashier::VERSION;
}

function test_cashier_format_amount(): string
{
    return \Laravel\Cashier\Cashier::formatAmount(100, 'usd');
}

function test_cashier_subscription(): \Laravel\Cashier\Subscription
{
    return new \Laravel\Cashier\Subscription();
}

function test_cashier_billable_type(): ?\Laravel\Cashier\Billable
{
    return \Laravel\Cashier\Cashier::findBillable(null);
}
