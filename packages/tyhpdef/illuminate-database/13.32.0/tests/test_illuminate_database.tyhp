<?tyhp

function test_illuminate_database_dynamic_connection_name(): string
{
    return \Illuminate\Database\DatabaseManager::calculateDynamicConnectionName(['driver' => 'sqlite']);
}

function test_illuminate_database_class_morph_model_name(\Illuminate\Database\ClassMorphViolationException $e): string|null
{
    return $e->model;
}

function test_illuminate_database_pending_has_through(
    \Illuminate\Database\Eloquent\PendingHasThroughRelationship<
        \Illuminate\Database\Eloquent\Model,
        \Illuminate\Database\Eloquent\Model,
        \Illuminate\Database\Eloquent\Relations\HasMany<\Illuminate\Database\Eloquent\Model, \Illuminate\Database\Eloquent\Model>
    > $pending,
): void {
    $pending->has<\Illuminate\Database\Eloquent\Model>('posts');
}
