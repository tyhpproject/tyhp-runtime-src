<?tyhp

function test_guzzlehttp_psr7_uri(string $uri): \GuzzleHttp\Psr7\Uri
{
    return new \GuzzleHttp\Psr7\Uri($uri);
}

function test_guzzlehttp_psr7_request(\Psr\Http\Message\UriInterface $uri): \Psr\Http\Message\RequestInterface
{
    return new \GuzzleHttp\Psr7\Request('GET', $uri);
}

function test_guzzlehttp_psr7_response(): \Psr\Http\Message\ResponseInterface
{
    return new \GuzzleHttp\Psr7\Response(200);
}

function test_guzzlehttp_psr7_stream(): \Psr\Http\Message\StreamInterface
{
    return \GuzzleHttp\Psr7\Utils::streamFor('hello');
}
