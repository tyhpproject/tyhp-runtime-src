<?tyhp

function test_guzzlehttp_psr7_package_loads(): bool
{
    return true;
}

function test_guzzlehttp_psr7_uri(string $uri): \GuzzleHttp\Psr7\Uri
{
    return new \GuzzleHttp\Psr7\Uri($uri);
}

function test_guzzlehttp_psr7_request(\Psr\Http\Message\UriInterface $uri): \Psr\Http\Message\RequestInterface
{
    return new \GuzzleHttp\Psr7\Request('GET', $uri);
}

function test_guzzlehttp_psr7_response(): \Psr\Http\Message\ResponseInterface
{
    return new \GuzzleHttp\Psr7\Response(200);
}

function test_guzzlehttp_psr7_stream(): \Psr\Http\Message\StreamInterface
{
    return \GuzzleHttp\Psr7\Utils::streamFor('hello');
}

function test_guzzlehttp_psr7_stream_options(): \Psr\Http\Message\StreamInterface
{
    return \GuzzleHttp\Psr7\Utils::streamFor('hello', ['size' => 5]);
}

function test_guzzlehttp_psr7_query_parse(): array<string, mixed>
{
    return \GuzzleHttp\Psr7\Query::parse('a=1&b=2');
}

function test_guzzlehttp_psr7_query_build(): string
{
    return \GuzzleHttp\Psr7\Query::build(['a' => '1', 'n' => 2]);
}

function test_guzzlehttp_psr7_header_parse(): array<int, array<string, mixed>>
{
    return \GuzzleHttp\Psr7\Header::parse('text/html; charset=utf-8');
}

function test_guzzlehttp_psr7_parse_message(): array<string, mixed>
{
    return \GuzzleHttp\Psr7\Message::parseMessage("GET / HTTP/1.1\r\n\r\n");
}

function test_guzzlehttp_psr7_parse_request_uri(): string
{
    return \GuzzleHttp\Psr7\Message::parseRequestUri('/', ['host' => ['example.com']]);
}
