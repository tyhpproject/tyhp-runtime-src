<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Tightens Header, Message, and Query results and streamFor options that Layer 1 leaves as bare array.
 */

namespace GuzzleHttp\Psr7 {
    /**
     * Overlay: parsed header parameters are a list of string-or-int keyed maps.
     */
    // @overlay-against: class Header
    partial class Header {
        /**
         * @param string|array<int, string> $header
         * @return array<int, array<string, mixed>>
         */
        // @overlay-against: function parse(string|array $header): array
        public static function parse(string|array<int, string> $header): array<int, array<string, mixed>>;
    }

    /**
     * Overlay: parsed messages and header maps are string-keyed arrays.
     */
    // @overlay-against: class Message
    partial class Message {
        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function parseMessage(string $message): array
        public static function parseMessage(string $message): array<string, mixed>;

        /**
         * @param array<string, array<int|string, string>> $headers Array of headers (each value an array).
         */
        // @overlay-against: function parseRequestUri(string $path, array $headers): string
        public static function parseRequestUri(string $path, array<string, array<int|string, string>> $headers): string;
    }

    /**
     * Overlay: query maps are string-keyed. Duplicate keys make a value an array, and scalars other than string are accepted, so values stay mixed.
     */
    // @overlay-against: class Query
    partial class Query {
        /**
         * @param array<string, mixed> $params
         */
        // @overlay-against: function build(array $params, int|false $encoding, bool $treatBoolsAsInts): string
        public static function build(array<string, mixed> $params, int|false $encoding = null, bool $treatBoolsAsInts = true): string;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function parse(string $str, int|bool $urlEncoding): array
        public static function parse(string $str, int|bool $urlEncoding = true): array<string, mixed>;
    }

    /**
     * Overlay: `streamFor` options are a string-keyed map (`metadata`, `size`).
     */
    // @overlay-against: class Utils
    partial class Utils {
        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function streamFor(resource|string|int|float|bool|\Psr\Http\Message\StreamInterface|callable|\Iterator|null $resource, array $options): \Psr\Http\Message\StreamInterface
        public static function streamFor(resource|string|int|float|bool|\Psr\Http\Message\StreamInterface|callable|\Iterator|null $resource = '', array<string, mixed> $options = []): \Psr\Http\Message\StreamInterface;
    }

    /**
     * Header maps are original-name to a list of string values.
     * `withHeader` accepts a string or a list of strings.
     */
    // @overlay-against: trait MessageTrait
    partial trait MessageTrait {
        // @overlay-against: function getHeader(mixed $header): array
        public function getHeader(string $header): array<int, string>;

        // @overlay-against: function getHeaderLine(mixed $header): string
        public function getHeaderLine(string $header): string;

        // @overlay-against: function getHeaders(): array
        public function getHeaders(): array<string, array<int, string>>;

        // @overlay-against: function hasHeader(mixed $header): bool
        public function hasHeader(string $header): bool;

        // @overlay-against: function withAddedHeader(mixed $header, mixed $value): \Psr\Http\Message\MessageInterface
        public function withAddedHeader(string $header, string|array<int, string> $value): \Psr\Http\Message\MessageInterface;

        // @overlay-against: function withHeader(mixed $header, mixed $value): \Psr\Http\Message\MessageInterface
        public function withHeader(string $header, string|array<int, string> $value): \Psr\Http\Message\MessageInterface;

        // @overlay-against: function withoutHeader(mixed $header): \Psr\Http\Message\MessageInterface
        public function withoutHeader(string $header): \Psr\Http\Message\MessageInterface;
    }
}
