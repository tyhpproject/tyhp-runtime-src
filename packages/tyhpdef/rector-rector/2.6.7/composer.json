{
  "name": "tyhpdef/rector-rector",
  "description": "Tyhp type definitions for the Composer package rector/rector (2.6.7).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "2.6.7.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/nikic-php-parser": "@dev",
        "tyhpdef/phpstan-phpdoc-parser": "@dev",
        "tyhpdef/phpstan-phpstan": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "rector/rector": "^2.0",
    "tyhpdef/nikic-php-parser": "^5.0"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/nikic-php-parser": "@dev",
    "tyhpdef/phpstan-phpdoc-parser": "@dev",
    "tyhpdef/phpstan-phpstan": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../nikic-php-parser/5.9.0"
    },
    {
      "type": "path",
      "url": "../../phpstan-phpdoc-parser/2.3.5"
    },
    {
      "type": "path",
      "url": "../../phpstan-phpstan/2.2.14"
    }
  ]
}
