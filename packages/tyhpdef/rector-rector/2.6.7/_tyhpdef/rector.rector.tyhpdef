        * @generated
        */
        deprecated public function addFunctionUseImport(\Rector\StaticTypeMapper\ValueObject\Type\FullyQualifiedObjectType $fullyQualifiedObjectType): void;
        /**
        * @api
        * @return array<\Rector\StaticTypeMapper\ValueObject\Type\AliasedObjectType|\Rector\StaticTypeMapper\ValueObject\Type\FullyQualifiedObjectType>
        * @deprecated Use $file->getFileNode()->resolveUsedImportTypes() instead.
        * @generated
        */
        deprecated public function getUseImportTypesByNode(\Rector\ValueObject\Application\File $file): array<\Rector\StaticTypeMapper\ValueObject\Type\AliasedObjectType|\Rector\StaticTypeMapper\ValueObject\Type\FullyQualifiedObjectType>;
