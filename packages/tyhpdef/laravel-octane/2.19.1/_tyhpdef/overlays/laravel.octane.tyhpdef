namespace Laravel\Octane {
    type MarshaledRequest = struct {
        \Illuminate\Http\Request 0 as $request;
        \Laravel\Octane\RequestContext 1 as $context;
    };

    // @overlay-against: class Exec
    partial class Exec {
        // @overlay-against: function run(string $command): array
        public function run(string $command): array<int, string>;
    }

    // @overlay-against: class RequestContext implements \ArrayAccess
    partial class RequestContext {
        // @overlay-against: function __set(mixed $key, mixed $value): mixed
        public function __set(mixed $key, mixed $value): void;
        // @overlay-against: function offsetExists(mixed $offset): mixed
        public function offsetExists(mixed $offset): bool;
        // @overlay-against: function offsetSet(mixed $offset, mixed $value): mixed
        public function offsetSet(mixed $offset, mixed $value): void;
        // @overlay-against: function offsetUnset(mixed $offset): mixed
        public function offsetUnset(mixed $offset): void;
    }

    // @overlay-against: class SequentialCoroutineDispatcher implements \Laravel\Octane\Contracts\DispatchesCoroutines
    partial class SequentialCoroutineDispatcher {
        // @overlay-against: function resolve(array $coroutines, int $waitSeconds): array
        public function resolve(array<int|string, callable(): mixed> $coroutines, int $waitSeconds = -1): array<int|string, mixed>;
    }

    // @overlay-against: class SequentialTaskDispatcher implements \Laravel\Octane\Contracts\DispatchesTasks
    partial class SequentialTaskDispatcher {
        // @overlay-against: function dispatch(array $tasks): void
        public function dispatch(array<int|string, callable(): mixed> $tasks): void;
        // @overlay-against: function resolve(array $tasks, int $waitMilliseconds): array
        public function resolve(array<int|string, callable(): mixed> $tasks, int $waitMilliseconds = 1): array<int|string, mixed>;
    }

    // @overlay-against: class Worker implements \Laravel\Octane\Contracts\Worker, \Laravel\Octane\DispatchesEvents
    partial class Worker {
        // @overlay-against: function handleTask(mixed $data): mixed
        public function handleTask(callable(): mixed $data): \Laravel\Octane\Swoole\TaskResult|\Laravel\Octane\Exceptions\TaskExceptionResult;
        // @overlay-against: function onRequestHandled(\Closure $callback): static
        public function onRequestHandled(\Closure<callable(\Illuminate\Http\Request, \Symfony\Component\HttpFoundation\Response, \Illuminate\Foundation\Application): mixed> $callback): static;
    }
}

namespace Laravel\Octane\Cache {
    // @overlay-against: class OctaneArrayStore extends \Illuminate\Cache\ArrayStore
    partial class OctaneArrayStore {
        // @overlay-against: function interval(string $key, \Closure $resolver, int $seconds): mixed
        public function interval(string $key, \Closure<callable(): mixed> $resolver, int $seconds): mixed;
    }

    // @overlay-against: class OctaneStore implements \Illuminate\Contracts\Cache\Store
    partial class OctaneStore {
        // @overlay-against: function interval(string $key, \Closure $resolver, int $seconds): void
        public function interval(string $key, \Closure<callable(): mixed> $resolver, int $seconds): void;
        // @overlay-against: function many(array $keys): array
        public function many(array<int|string, string> $keys): array<int|string, mixed>;
        // @overlay-against: function putMany(array $values, int $seconds): bool
        public function putMany(array<string, mixed> $values, int $seconds): bool;
    }
}

namespace Laravel\Octane\Commands\Concerns {
    type DdInfo = struct {
        ?string $class;
        int|string|null $code;
        ?string $file;
        ?int $line;
        string $message;
        ?array<int, array<string, mixed>> $trace;
        ?string $type;
    };

    type RequestInfo = struct {
        string $method;
        string $url;
        int $statusCode;
        int|float $duration;
        ?int $memory;
        ?string $type;
    };

    type ThrowableInfo = struct {
        string $class;
        int|string $code;
        string $file;
        int $line;
        string $message;
        array<int, array<string, mixed>> $trace;
        ?string $type;
    };

    // @overlay-against: trait InteractsWithIO implements \Laravel\Octane\Commands\Concerns\InteractsWithTerminal
    partial trait InteractsWithIO {
        // @overlay-against: function ddInfo(array $throwable, int|string|null $verbosity): void
        public function ddInfo(DdInfo $throwable, int|string|null $verbosity = null): void;
        // @overlay-against: function requestInfo(array $request, int|string|null $verbosity): void
        public function requestInfo(RequestInfo $request, int|string|null $verbosity = null): void;
        // @overlay-against: function shutdownInfo(array $throwable, int|string|null $verbosity): void
        public function shutdownInfo(ThrowableInfo $throwable, int|string|null $verbosity = null): void;
        // @overlay-against: function throwableInfo(array $throwable, int|string|null $verbosity): void
        public function throwableInfo(ThrowableInfo $throwable, int|string|null $verbosity = null): void;
    }

    // @overlay-against: trait InteractsWithServers
    partial trait InteractsWithServers {
        // @overlay-against: function getSubscribedSignals(): array
        public function getSubscribedSignals(): array<int, int>;
    }
}

