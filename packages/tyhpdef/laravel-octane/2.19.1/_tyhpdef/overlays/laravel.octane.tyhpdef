<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * php-ext-swoole is not wrapped: omit types that extend Swoole, and
 * name-only externs for remaining Swoole type hints.
