        public function getRoutes(): array<string, \Closure<callable(\Illuminate\Http\Request): \Symfony\Component\HttpFoundation\Response>>;
        // @overlay-against: function route(string $method, string $uri, \Closure $callback): void
        public function route(string $method, string $uri, \Closure<callable(\Illuminate\Http\Request): \Symfony\Component\HttpFoundation\Response> $callback): void;
