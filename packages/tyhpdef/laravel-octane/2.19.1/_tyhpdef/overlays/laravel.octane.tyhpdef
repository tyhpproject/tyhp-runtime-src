namespace Laravel\Octane\Testing\Fakes {
    type FakeClientMarshaledRequest = struct {
        mixed 0 as $request;
        \Laravel\Octane\RequestContext 1 as $context;
    };

    // @overlay-against: class FakeClient implements \Laravel\Octane\Contracts\Client
    partial class FakeClient {
        // @overlay-against: mixed $errors
        public array<int, string> $errors ?? [];
        // @overlay-against: mixed $index
        public int $index ?? 0;
        // @overlay-against: mixed $responses
        public array<int, \Symfony\Component\HttpFoundation\Response> $responses ?? [];
        // @overlay-against: function marshalRequest(\Laravel\Octane\RequestContext $context): array
        public function marshalRequest(\Laravel\Octane\RequestContext $context): FakeClientMarshaledRequest;
    }

    // @overlay-against: class FakeWorker extends \Laravel\Octane\Worker
    partial class FakeWorker {
        // @overlay-against: function run(): mixed
        public function run(): void;
        // @overlay-against: function runTasks(): mixed
        public function runTasks(): array<int|string, \Laravel\Octane\Swoole\TaskResult|\Laravel\Octane\Exceptions\TaskExceptionResult>;
        // @overlay-against: function runTicks(): mixed
        public function runTicks(): array<int|string, null>;
    }
}

