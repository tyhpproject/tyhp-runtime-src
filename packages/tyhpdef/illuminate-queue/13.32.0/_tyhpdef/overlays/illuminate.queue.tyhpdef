namespace Illuminate\Queue {
    /**
     * Optional SQS send options. Absent keys are left unset.
     */
    type SqsQueueableOptions = struct {
        ?int $DelaySeconds;
        ?string $MessageGroupId;
        ?string $MessageDeduplicationId;
    };

    // @overlay-against: class CallQueuedClosure implements \Illuminate\Contracts\Queue\ShouldQueue, \Illuminate\Bus\Batchable, \Illuminate\Foundation\Bus\Dispatchable, \Illuminate\Queue\InteractsWithQueue, \Illuminate\Bus\Queueable, \Illuminate\Queue\SerializesModels
    omit class CallQueuedClosure {};

    /**
     * Overlay: route keys are job class-strings.
     */
    // @overlay-against: class QueueRoutes implements \Illuminate\Support\Traits\ReadsClassAttributes
    partial class QueueRoutes {
        // @overlay-against: function all(): array
        public function all(): array<__ClassName, array|string>;
    }

    /**
     * Overlay: SQS send options are the three optional message fields.
     */
    // @overlay-against: class SqsQueue extends \Illuminate\Queue\Queue implements \Illuminate\Contracts\Queue\Queue, \Illuminate\Contracts\Queue\ClearableQueue
    partial class SqsQueue {
        // @overlay-against: function getQueueableOptions(mixed $job, string|null $queue, string $payload, \DateTimeInterface|\DateInterval|int|null $delay): array
        public function getQueueableOptions(mixed $job, string|null $queue, string $payload, \DateTimeInterface|\DateInterval|int|null $delay = null): SqsQueueableOptions;
    }

    // @overlay-against: class Worker implements \Illuminate\Database\DetectsLostConnections
    omit class Worker {};
}

