<?tyhp

function test_webmozart_assert_string(): string
{
    return \Webmozart\Assert\Assert::string('ok');
}

function test_webmozart_assert_integer(): int
{
    return \Webmozart\Assert\Assert::integer(3);
}

function test_webmozart_assert_instance_of(): \stdClass
{
    return \Webmozart\Assert\Assert::isInstanceOf(new \stdClass(), \stdClass::class);
}
