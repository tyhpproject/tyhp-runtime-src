<?tyhp

function test_dotenv_construct(): \Symfony\Component\Dotenv\Dotenv
{
    return (new \Symfony\Component\Dotenv\Dotenv('APP_ENV', 'APP_DEBUG'))->usePutenv(false);
}

function test_dotenv_parse(\Symfony\Component\Dotenv\Dotenv $dotenv): array<string, string>
{
    return $dotenv->parse("FOO=bar\n", '.env');
}
