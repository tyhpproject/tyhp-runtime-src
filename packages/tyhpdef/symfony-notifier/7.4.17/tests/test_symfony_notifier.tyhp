<?tyhp

function test_notifier_send(\Symfony\Component\Notifier\NotifierInterface $notifier): void
{
    $notifier->send(new \Symfony\Component\Notifier\Notification\Notification('Hello'));
}

function test_notification_subject(): string
{
    return (new \Symfony\Component\Notifier\Notification\Notification('Hello'))->getSubject();
}
