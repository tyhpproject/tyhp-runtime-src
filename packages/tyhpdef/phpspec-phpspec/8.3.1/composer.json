{
    "name": "tyhpdef/phpspec-phpspec",
    "description": "Tyhp type definitions for the Composer package phpspec/phpspec (8.3.1).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "8.3.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/phpspec-prophecy": "@dev",
                "tyhpdef/nikic-php-parser": "@dev",
                "tyhpdef/symfony-event-dispatcher": "@dev",
                "tyhpdef/symfony-console": "@dev",
                "tyhpdef/symfony-finder": "@dev",
                "tyhpdef/symfony-process": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "phpspec/phpspec": "8.3.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/phpspec-prophecy": "@dev",
        "tyhpdef/nikic-php-parser": "@dev",
        "tyhpdef/symfony-event-dispatcher": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/symfony-finder": "@dev",
        "tyhpdef/symfony-process": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../phpspec-prophecy/1.26.1"
        },
        {
            "type": "path",
            "url": "../../nikic-php-parser/5.9.0"
        },
        {
            "type": "path",
            "url": "../../symfony-event-dispatcher/7.4.17"
        },
        {
            "type": "path",
            "url": "../../symfony-console/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-finder/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-process/7.4.19"
        }
    ]
}
