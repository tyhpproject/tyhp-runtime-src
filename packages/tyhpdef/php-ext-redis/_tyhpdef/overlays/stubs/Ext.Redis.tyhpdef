    */
    // @overlay-against: function zrevrangebylex(string $key, string $min, string $max, ?array $options): \RedisCluster|array|bool
    public function zrevrangebylex(string $key, string $min, string $max, ?array $options = null): \RedisCluster|array|bool;
    /**
    * @param $key
    * @param $start
    * @param $end
    * @param $options
