<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Config maps and tidyNode attribute/child collections. Not Pure.
 */

/**
 * Overlay: tidy configuration map (`tidy_*` `$config` and `tidy::getConfig()`).
 */
type TidyConfig = array<string, string|int|bool>;

// @overlay-against: function tidy_get_config(\tidy $tidy): array
function tidy_get_config(\tidy $tidy): TidyConfig;

// @overlay-against: function tidy_parse_file(string $filename, array|string|null $config, ?string $encoding, bool $useIncludePath): \tidy|false
function tidy_parse_file(string $filename, TidyConfig|string|null $config = null, ?string $encoding = null, bool $useIncludePath = false): \tidy|false;

// @overlay-against: function tidy_parse_string(string $string, array|string|null $config, ?string $encoding): \tidy|false
function tidy_parse_string(string $string, TidyConfig|string|null $config = null, ?string $encoding = null): \tidy|false;

// @overlay-against: function tidy_repair_file(string $filename, array|string|null $config, ?string $encoding, bool $useIncludePath): string|false
function tidy_repair_file(string $filename, TidyConfig|string|null $config = null, ?string $encoding = null, bool $useIncludePath = false): string|false;

// @overlay-against: function tidy_repair_string(string $string, array|string|null $config, ?string $encoding): string|false
function tidy_repair_string(string $string, TidyConfig|string|null $config = null, ?string $encoding = null): string|false;

// @overlay-against: class tidy
partial class tidy {
    // @overlay-against: function __construct(?string $filename, array|string|null $config, ?string $encoding, bool $useIncludePath)
    public function __construct(?string $filename = null, TidyConfig|string|null $config = null, ?string $encoding = null, bool $useIncludePath = false);

    // @overlay-against: function getConfig(): array
    public function getConfig(): TidyConfig;

    // @overlay-against: function parseFile(string $filename, array|string|null $config, ?string $encoding, bool $useIncludePath): bool
    public function parseFile(string $filename, TidyConfig|string|null $config = null, ?string $encoding = null, bool $useIncludePath = false): bool;

    // @overlay-against: function parseString(string $string, array|string|null $config, ?string $encoding): bool
    public function parseString(string $string, TidyConfig|string|null $config = null, ?string $encoding = null): bool;

    // @overlay-against: function repairFile(string $filename, array|string|null $config, ?string $encoding, bool $useIncludePath): string|false
    public function repairFile(string $filename, TidyConfig|string|null $config = null, ?string $encoding = null, bool $useIncludePath = false): string|false;

    // @overlay-against: function repairString(string $string, array|string|null $config, ?string $encoding): string|false
    public function repairString(string $string, TidyConfig|string|null $config = null, ?string $encoding = null): string|false;
}

// @overlay-against: class tidyNode
partial class tidyNode {
    // @overlay-against: ?array $attribute
    public readonly ?array<string, string> $attribute;
    // @overlay-against: ?array $child
    public readonly ?array<int, \tidyNode> $child;
}
