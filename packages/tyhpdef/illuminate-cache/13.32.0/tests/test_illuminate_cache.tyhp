<?tyhp

function test_cache_array_store(): \Illuminate\Cache\ArrayStore
{
    return new \Illuminate\Cache\ArrayStore();
}

function test_cache_array_get(\Illuminate\Cache\ArrayStore $store): mixed
{
    return $store->get('key');
}

function test_cache_array_put(\Illuminate\Cache\ArrayStore $store): bool
{
    return $store->put('key', 'value', 60);
}
