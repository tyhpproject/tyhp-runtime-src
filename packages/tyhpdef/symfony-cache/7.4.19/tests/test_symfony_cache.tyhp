<?tyhp

function test_cache_array_adapter_item(): mixed
{
    $pool = new \Symfony\Component\Cache\Adapter\ArrayAdapter();
    $item = $pool->getItem('greeting');
    $item->set('hello');
    $pool->save($item);
    return $pool->getItem('greeting')->get();
}

function test_cache_array_adapter_get(): mixed
{
    $pool = new \Symfony\Component\Cache\Adapter\ArrayAdapter();
    return $pool->get('answer', function (\Psr\Cache\CacheItemInterface $item): string {
        $item->expiresAfter(60);
        return '42';
    });
}

function test_cache_item_key(): string
{
    $pool = new \Symfony\Component\Cache\Adapter\ArrayAdapter();
    return $pool->getItem('k')->getKey();
}
