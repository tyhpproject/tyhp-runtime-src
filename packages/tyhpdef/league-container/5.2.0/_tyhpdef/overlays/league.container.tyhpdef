<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Constructor new-in-default aggregates and class-string `get()` like PSR-11.
 */

namespace League\Container {
    /**
     * Overlay: PHP 8.1 `new` defaults for the three aggregates; class-string `get()`.
     */
    // @overlay-against: class Container implements \League\Container\DefinitionContainerInterface, \League\Container\Event\EventAwareTrait
    partial class Container {
        /**
         * @param \League\Container\Definition\DefinitionAggregateInterface $definitions
         * @param \League\Container\ServiceProvider\ServiceProviderAggregateInterface $providers
         * @param \League\Container\Inflector\InflectorAggregateInterface $inflectors
         */
        // @overlay-against: function __construct(\League\Container\Definition\DefinitionAggregateInterface $definitions, \League\Container\ServiceProvider\ServiceProviderAggregateInterface $providers, \League\Container\Inflector\InflectorAggregateInterface $inflectors, bool $defaultToShared, bool $defaultToOverwrite): void
        public function __construct(
            \League\Container\Definition\DefinitionAggregateInterface $definitions = new \League\Container\Definition\DefinitionAggregate(),
            \League\Container\ServiceProvider\ServiceProviderAggregateInterface $providers = new \League\Container\ServiceProvider\ServiceProviderAggregate(),
            \League\Container\Inflector\InflectorAggregateInterface $inflectors = new \League\Container\Inflector\InflectorAggregate(),
            bool $defaultToShared = false,
            bool $defaultToOverwrite = false
        ): void;

        /**
         * @param \__ClassName<T> $id
         * @return T
         */
        // @overlay-against: function get(string $id): mixed
        public function get<T extends object>(\__ClassName<T> $id): T;

        /**
         * @param string $id
         * @return T
         */
        // @overlay-against: function get(string $id): mixed
        public function get<T = mixed>(string $id): T;

        /**
         * @param \__ClassName<T>|string $id
         */
        // @overlay-against: function add(string $id, mixed $concrete, bool $overwrite): \League\Container\Definition\DefinitionInterface
        public function add(\__ClassName|string $id, mixed $concrete = null, bool $overwrite = false): \League\Container\Definition\DefinitionInterface;
    }
}

namespace League\Container\Argument {
    // @overlay-against: interface ArgumentReflectorInterface
    partial interface ArgumentReflectorInterface {
        /**
         * Overlay: argument names are parameter names; resolved values stay open.
         */
        // @overlay-against: function reflectArguments(\ReflectionFunctionAbstract $method, array $args): array
        public function reflectArguments(\ReflectionFunctionAbstract $method, array<string, mixed> $args = []): array<int, mixed>;
    }

    // @overlay-against: trait ArgumentReflectorTrait
    partial trait ArgumentReflectorTrait {
        /**
         * Overlay: `reflectArguments()` keys the input by parameter name and returns a resolved list.
         */
        // @overlay-against: function reflectArguments(\ReflectionFunctionAbstract $method, array $args): array
        public function reflectArguments(\ReflectionFunctionAbstract $method, array<string, mixed> $args = []): array<int, mixed>;
    }

    // @overlay-against: class LiteralArgument implements \League\Container\Argument\LiteralArgumentInterface
    partial class LiteralArgument {
        /**
         * Overlay: `TYPE_BOOL` aliases `TYPE_BOOLEAN`.
         */
        // @overlay-against: const mixed TYPE_BOOL
        public const string TYPE_BOOL ?? self::TYPE_BOOLEAN;

        /**
         * Overlay: `TYPE_FLOAT` aliases `TYPE_DOUBLE`.
         */
        // @overlay-against: const mixed TYPE_FLOAT
        public const string TYPE_FLOAT ?? self::TYPE_DOUBLE;

        /**
         * Overlay: `TYPE_INT` aliases `TYPE_INTEGER`.
         */
        // @overlay-against: const mixed TYPE_INT
        public const string TYPE_INT ?? self::TYPE_INTEGER;
    }
}

namespace League\Container\Definition {
    // @overlay-against: class Definition implements \League\Container\Argument\ArgumentResolverInterface, \League\Container\Definition\DefinitionInterface, \League\Container\Argument\ArgumentResolverTrait, \League\Container\ContainerAwareTrait
    partial class Definition {
        /**
         * Overlay: `addMethodCalls()` maps a method name to its argument list.
         */
        // @overlay-against: function addMethodCalls(array $methods): \League\Container\Definition\DefinitionInterface
        public function addMethodCalls(array<string, array<int|string, mixed>> $methods = []): \League\Container\Definition\DefinitionInterface;

        /**
         * Overlay: `getTags()` returns `array_keys()` of the string tag map.
         */
        // @overlay-against: function getTags(): array
        public function getTags(): array<int, string>;
    }

    // @overlay-against: class DefinitionAggregate implements \League\Container\Definition\DefinitionAggregateInterface, \League\Container\ContainerAwareTrait
    partial class DefinitionAggregate {
        /**
         * Overlay: `getIterator()` yields the stored definitions.
         */
        // @overlay-against: function getIterator(): \Generator
        public function getIterator(): \Generator<int, \League\Container\Definition\DefinitionInterface>;

        /**
         * Overlay: `resolveTagged()` appends each `resolve()` result.
         */
        // @overlay-against: function resolveTagged(string $tag): array
        public function resolveTagged(string $tag): array<int, mixed>;

        /**
         * Overlay: `resolveTaggedNew()` appends each `resolveNew()` result.
         */
        // @overlay-against: function resolveTaggedNew(string $tag): array
        public function resolveTaggedNew(string $tag): array<int, mixed>;
    }

    // @overlay-against: interface DefinitionAggregateInterface
    partial interface DefinitionAggregateInterface {
        /**
         * Overlay: tagged resolution is a list of resolved values.
         */
        // @overlay-against: function resolveTagged(string $tag): array
        public function resolveTagged(string $tag): array<int, mixed>;

        /**
         * Overlay: tagged resolution is a list of resolved values.
         */
        // @overlay-against: function resolveTaggedNew(string $tag): array
        public function resolveTaggedNew(string $tag): array<int, mixed>;
    }

    // @overlay-against: interface DefinitionInterface
    partial interface DefinitionInterface {
        /**
         * Overlay: method calls map a method name to its argument list.
         */
        // @overlay-against: function addMethodCalls(array $methods): \League\Container\Definition\DefinitionInterface
        public function addMethodCalls(array<string, array<int|string, mixed>> $methods = []): \League\Container\Definition\DefinitionInterface;

        /**
         * Overlay: tags are the string keys stored by `addTag()`.
         */
        // @overlay-against: function getTags(): array
        public function getTags(): array<int, string>;
    }
}

namespace League\Container\Event {
    // @overlay-against: class EventDispatcher implements \Psr\EventDispatcher\EventDispatcherInterface, \Psr\EventDispatcher\ListenerProviderInterface
    partial class EventDispatcher {
        /**
         * Overlay: `getFilters()` stores `EventFilter` lists under the event type.
         */
        // @overlay-against: function getFilters(): array
        public function getFilters(): array<string, array<int, \League\Container\Event\EventFilter>>;

        /**
         * Overlay: `getListeners()` stores callable lists under the event type.
         */
        // @overlay-against: function getListeners(): array
        public function getListeners(): array<string, array<int, callable>>;
    }

    // @overlay-against: class EventFilter
    partial class EventFilter {
        /**
         * Overlay: `where()` keeps the filter when the closure returns true for the event.
         */
        // @overlay-against: function where(\Closure $filter): self
        public function where(\Closure<callable(\League\Container\Event\ContainerEvent): bool> $filter): self;
    }
}

