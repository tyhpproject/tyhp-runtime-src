<?tyhp

function test_clock_mock_toggle(): ?bool
{
    return \Symfony\Bridge\PhpUnit\ClockMock::withClockMock(true);
}

function test_clock_mock_time(): int
{
    return \Symfony\Bridge\PhpUnit\ClockMock::time();
}

function test_clock_mock_date(): string
{
    return \Symfony\Bridge\PhpUnit\ClockMock::date('c');
}

function test_dns_mock_hosts(): void
{
    \Symfony\Bridge\PhpUnit\DnsMock::withMockedHosts([]);
}

function test_class_exists_mock(): bool
{
    \Symfony\Bridge\PhpUnit\ClassExistsMock::withMockedClasses(['Foo' => true]);
    return \Symfony\Bridge\PhpUnit\ClassExistsMock::class_exists('Foo');
}

function test_time_sensitive_attribute(): \Symfony\Bridge\PhpUnit\Attribute\TimeSensitive
{
    return new \Symfony\Bridge\PhpUnit\Attribute\TimeSensitive(\Symfony\Bridge\PhpUnit\ClockMock::class);
}

function test_deprecation_handler_mode(): string
{
    return \Symfony\Bridge\PhpUnit\DeprecationErrorHandler::MODE_STRICT;
}

class BridgeDeprecationProbe
{
    use \Symfony\Bridge\PhpUnit\ExpectDeprecationTrait;
}

function test_expect_deprecation(): void
{
    (new BridgeDeprecationProbe())->expectDeprecation('since symfony/phpunit-bridge 7.4: test');
}

function test_symfony_extension_type(\Symfony\Bridge\PhpUnit\SymfonyExtension $extension): \Symfony\Bridge\PhpUnit\SymfonyExtension
{
    return $extension;
}
