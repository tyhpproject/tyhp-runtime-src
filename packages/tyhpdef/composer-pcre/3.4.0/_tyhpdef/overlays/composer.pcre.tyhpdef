        // @overlay-against: function matchAllWithOffsets(string $pattern, string $subject, array $matches, int $flags, int $offset): int
        public static function matchAllWithOffsets(string $pattern, string $subject, array<int|string, array<int, \PregOffsetCaptureNullable>> &$matches, int $flags = 0, int $offset = 0): int;

        /**
         * @param array<int|string, string> $matches
         * @return int
         */
        // @overlay-against: function matchStrictGroups(string $pattern, string $subject, array $matches, int $flags, int $offset): int
        public static function matchStrictGroups(string $pattern, string $subject, array<int|string, string> &$matches = null, int $flags = 0, int $offset = 0): int;

        // @overlay-against: function matchWithOffsets(string $pattern, string $subject, array $matches, int $flags, int $offset): int
        public static function matchWithOffsets(string $pattern, string $subject, array<int|string, \PregOffsetCaptureNullable> &$matches, int $flags = 0, int $offset = 0): int;

        /**
         * @param string|array<int|string, string> $pattern
         * @param string|array<int|string, string> $replacement
         */
        // @overlay-against: function replace(string|array $pattern, string|array $replacement, string $subject, int $limit, ?int $count): string
        public static function replace(string|array<int|string, string> $pattern, string|array<int|string, string> $replacement, string $subject, int $limit = -1, ?int &$count = null): string;

        // @overlay-against: function replaceCallback(string|array $pattern, callable $replacement, string $subject, int $limit, ?int $count, int $flags): string
        public static function replaceCallback(string|array<int, string> $pattern, callable(\PregMatchSetNullable): string $replacement, string $subject, int $limit = -1, ?int &$count = null, 0 $flags = 0): string;

        // @overlay-against: function replaceCallback(string|array $pattern, callable $replacement, string $subject, int $limit, ?int $count, int $flags): string
        public static function replaceCallback(string|array<int, string> $pattern, callable(\PregMatchSetOffsetNullable): string $replacement, string $subject, int $limit = -1, ?int &$count = null, 256 $flags): string;

        // @overlay-against: function replaceCallback(string|array $pattern, callable $replacement, string $subject, int $limit, ?int $count, int $flags): string
