        public static function replaceCallbackArray(array<string, callable(\PregMatchSetOffsetNullable): string> $pattern, string $subject, int $limit = -1, ?int &$count = null, 256 $flags): string;

        // @overlay-against: function replaceCallbackArray(array $pattern, string $subject, int $limit, ?int $count, int $flags): string
        public static function replaceCallbackArray(array<string, callable(\PregMatchSetNullable|\PregMatchSetOffsetNullable): string> $pattern, string $subject, int $limit = -1, ?int &$count = null, int $flags = 0): string;

        // @overlay-against: function replaceCallbackStrictGroups(string $pattern, callable $replacement, string $subject, int $limit, ?int $count, int $flags): string
        public static function replaceCallbackStrictGroups(string $pattern, callable(\PregMatchSet): string $replacement, string $subject, int $limit = -1, ?int &$count = null, 0 $flags = 0): string;

        // @overlay-against: function replaceCallbackStrictGroups(string $pattern, callable $replacement, string $subject, int $limit, ?int $count, int $flags): string
        public static function replaceCallbackStrictGroups(string $pattern, callable(\PregMatchSetOffset): string $replacement, string $subject, int $limit = -1, ?int &$count = null, 256 $flags): string;

        // @overlay-against: function replaceCallbackStrictGroups(string $pattern, callable $replacement, string $subject, int $limit, ?int $count, int $flags): string
        public static function replaceCallbackStrictGroups(string $pattern, callable(\PregMatchSet|\PregMatchSetOffset): string $replacement, string $subject, int $limit = -1, ?int &$count = null, int $flags = 0): string;

        // @overlay-against: function splitWithOffsets(string $pattern, string $subject, int $limit, int $flags): array
        public static function splitWithOffsets(string $pattern, string $subject, int $limit = -1, int $flags = 0): array<int, \PregOffsetCapture>;
    }

