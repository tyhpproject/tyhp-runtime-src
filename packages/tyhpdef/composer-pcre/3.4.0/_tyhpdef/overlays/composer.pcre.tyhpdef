<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Match maps and replacement lists accept Tyhp list/map literals.
 * Offset pairs and replace callbacks use the php package PCRE shapes.
 * Preg always sets PREG_UNMATCHED_AS_NULL; PREG_OFFSET_CAPTURE is opt-in.
 */

namespace Composer\Pcre {
    // @overlay-against: class MatchAllResult
    partial class MatchAllResult {
        // @overlay-against: mixed $count
        public int $count;
    }

    // @overlay-against: class MatchAllStrictGroupsResult
    partial class MatchAllStrictGroupsResult {
        // @overlay-against: mixed $count
        public int $count;

        // @overlay-against: function __construct(int $count, array $matches): void
        public function __construct(int $count, array<int|string, array<int, string>> $matches): void;
    }

    // @overlay-against: class MatchAllWithOffsetsResult
    partial class MatchAllWithOffsetsResult {
        // @overlay-against: mixed $count
        public int $count;

        // @overlay-against: array $matches
        public array<int|string, array<int, \PregOffsetCaptureNullable>> $matches;

        // @overlay-against: function __construct(int $count, array $matches): void
        public function __construct(int $count, array<int|string, array<int, \PregOffsetCaptureNullable>> $matches): void;
    }

    // @overlay-against: class MatchWithOffsetsResult
    partial class MatchWithOffsetsResult {
        // @overlay-against: array $matches
        public array<int|string, \PregOffsetCaptureNullable> $matches;

        // @overlay-against: function __construct(int $count, array $matches): void
        public function __construct(int $count, array<int|string, \PregOffsetCaptureNullable> $matches): void;
    }

    /**
     * Overlay: match maps and replace callbacks.
     * `PREG_UNMATCHED_AS_NULL` is always applied by Preg. Flag `256` is
