namespace Composer\Pcre\PHPStan {
    // PHPStan plugin types implement PHPStan interfaces this wrapper does not own.
    // @overlay-against: class InvalidRegexPatternRule implements \PHPStan\Rules\Rule
    omit class InvalidRegexPatternRule {
    }

    // @overlay-against: class PregMatchFlags
