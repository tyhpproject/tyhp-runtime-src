<?tyhp

function test_laravel_set_list(): string
{
    return \RectorLaravel\Set\LaravelSetList::LARAVEL_CODE_QUALITY;
}

function test_is_lumen_routing(
    \RectorLaravel\NodeAnalyzer\LumenRouteRegisteringMethodAnalyzer $analyzer,
    \PhpParser\Node\Expr\MethodCall $methodCall,
): bool {
    return $analyzer->isLumenRoutingClass($methodCall);
}
