<?tyhp

function test_authenticator_supports(
    \Symfony\Component\Security\Http\Authenticator\AuthenticatorInterface $authenticator,
    \Symfony\Component\HttpFoundation\Request $request,
): ?bool {
    return $authenticator->supports($request);
}

function test_authenticator_authenticate(
    \Symfony\Component\Security\Http\Authenticator\AuthenticatorInterface $authenticator,
    \Symfony\Component\HttpFoundation\Request $request,
): \Symfony\Component\Security\Http\Authenticator\Passport\Passport {
    return $authenticator->authenticate($request);
}
