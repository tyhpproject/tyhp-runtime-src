<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Actor / Module / TestInterface from the PHP source. Scenario groups match Metadata.
 */

namespace Codeception {
    abstract class Actor {
        public function __construct(\Codeception\Scenario $scenario);

        public function execute(\Closure<callable(): mixed> $callable): self;

        public function wantTo(string $text): void;

        public function wantToTest(string $text): void;
    }

    abstract class Module {
        public function _getConfig(null $key = null): array<string, mixed>;

        public function _getConfig(string $key): mixed;

        public function _getConfig(?string $key = null): mixed;

        public function _getName(): string;

        public function _hasRequiredFields(): bool;
    }

    // @overlay-against: class Scenario
    partial class Scenario {
        // @overlay-against: function getGroups(): array
        public function getGroups(): array<int, string>;
    }

    class Step {
    }

    interface TestInterface {
        public function getMetadata(): \Codeception\Test\Metadata;
    }
}

namespace Codeception\Step {
    class Meta {
    }
}

namespace Codeception\Test {
    class Metadata {
        /**
         * @return array<int, string>
         */
        public function getFeature(): string;

        public function getGroups(): array<int, string>;

        public function setFeature(string $feature): void;
    }
}
