    partial class DumpServer {
        /**
         * @param callable(\Symfony\Component\VarDumper\Cloner\Data, array<string, mixed>, int): void $callback
         */
        // @overlay-against: function listen(callable $callback): void
        public function listen(callable(\Symfony\Component\VarDumper\Cloner\Data, array<string, mixed>, int): void $callback): void;
    }
}

namespace Symfony\Component\VarDumper\Dumper {
    /**
     * Line dumper invoked with the rendered line, depth, and indent pad.
     */
    type LineDumper = callable(string, int, string): void;

    /**
     * Overlay: output destination is a line dumper, stream, or path.
     */
    // @overlay-against: class AbstractDumper implements \Symfony\Component\VarDumper\Dumper\DataDumperInterface, \Symfony\Component\VarDumper\Cloner\DumperInterface
    partial class AbstractDumper {
        /**
         * @var (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null
         */
        // @overlay-against: callable|resource|string|null $defaultOutput
        public static (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null $defaultOutput ?? 'php://output';

        /**
         * @param (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null $output
         */
        // @overlay-against: function __construct(callable|resource|string|null $output, ?string $charset, int $flags): void
        public function __construct((\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null $output = null, ?string $charset = null, int $flags = 0): void;

        /**
         * @param (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null $output
         * @return (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null
         */
        // @overlay-against: function setOutput(callable|resource|string|null $output): callable|resource|string|null
        public function setOutput((\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null $output): (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null;

        /**
         * @param (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|true|null $output
         */
        // @overlay-against: function dump(\Symfony\Component\VarDumper\Cloner\Data $data, callable|resource|string|true|null $output): ?string
        public function dump(\Symfony\Component\VarDumper\Cloner\Data $data, (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|true|null $output = null): ?string;
    }

    /**
     * Overlay: CLI styles and display options.
     */
    // @overlay-against: class CliDumper extends \Symfony\Component\VarDumper\Dumper\AbstractDumper
    partial class CliDumper {
        /**
         * @var (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null
         */
        // @overlay-against: callable|resource|string|null $defaultOutput
        public static (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null $defaultOutput ?? 'php://stdout';

        /**
         * @param array<string, mixed> $displayOptions
         */
        // @overlay-against: function setDisplayOptions(array $displayOptions): void
        public function setDisplayOptions(array<string, mixed> $displayOptions): void;

        /**
         * @param array<string, string> $styles
         */
        // @overlay-against: function setStyles(array $styles): void
        public function setStyles(array<string, string> $styles): void;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `ContextualizedDumper`.
     */
    // @overlay-against: class ContextualizedDumper implements \Symfony\Component\VarDumper\Dumper\DataDumperInterface
    partial class ContextualizedDumper {
        /**
         * @param array<int, \Symfony\Component\VarDumper\Dumper\ContextProvider\ContextProviderInterface> $contextProviders
         */
        // @overlay-against: function __construct(\Symfony\Component\VarDumper\Dumper\DataDumperInterface $wrappedDumper, array $contextProviders): void
        public function __construct(\Symfony\Component\VarDumper\Dumper\DataDumperInterface $wrappedDumper, array<int, \Symfony\Component\VarDumper\Dumper\ContextProvider\ContextProviderInterface> $contextProviders): void;
    }

    /**
     * Overlay: HTML styles, display options, and per-dump options.
     */
    // @overlay-against: class HtmlDumper extends \Symfony\Component\VarDumper\Dumper\CliDumper
    partial class HtmlDumper {
        /**
         * @var (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null
         */
        // @overlay-against: callable|resource|string|null $defaultOutput
        public static (\Symfony\Component\VarDumper\Dumper\LineDumper)|resource|string|null $defaultOutput ?? 'php://output';

        /**
         * @param array<string, mixed> $extraDisplayOptions
         */
        // @overlay-against: function dump(\Symfony\Component\VarDumper\Cloner\Data $data, mixed $output, array $extraDisplayOptions): ?string
        public function dump(\Symfony\Component\VarDumper\Cloner\Data $data, mixed $output = null, array<string, mixed> $extraDisplayOptions = []): ?string;

        /**
         * @param array<string, mixed> $displayOptions
         */
        // @overlay-against: function setDisplayOptions(array $displayOptions): void
        public function setDisplayOptions(array<string, mixed> $displayOptions): void;

        /**
         * @param array<string, string> $styles
         */
        // @overlay-against: function setStyles(array $styles): void
        public function setStyles(array<string, string> $styles): void;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `ServerDumper`.
     */
    // @overlay-against: class ServerDumper implements \Symfony\Component\VarDumper\Dumper\DataDumperInterface
    partial class ServerDumper {
        /**
         * @param array<string, \Symfony\Component\VarDumper\Dumper\ContextProvider\ContextProviderInterface> $contextProviders
         */
        // @overlay-against: function __construct(string $host, ?\Symfony\Component\VarDumper\Dumper\DataDumperInterface $wrappedDumper, array $contextProviders): void
        public function __construct(string $host, ?\Symfony\Component\VarDumper\Dumper\DataDumperInterface $wrappedDumper = null, array<string, \Symfony\Component\VarDumper\Dumper\ContextProvider\ContextProviderInterface> $contextProviders = []): void;

        /**
         * @return array<string, \Symfony\Component\VarDumper\Dumper\ContextProvider\ContextProviderInterface>
         */
        // @overlay-against: function getContextProviders(): array
        public function getContextProviders(): array<string, \Symfony\Component\VarDumper\Dumper\ContextProvider\ContextProviderInterface>;
    }
}

