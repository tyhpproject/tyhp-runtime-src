<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 *
 * Omit console command / descriptors: they extend unwrapped `symfony/console`.
 * Ds/FFI casters keep ext peers as extern in a sibling include.
 */

namespace Symfony\Component\VarDumper {
    /**
     * Handler installed by `VarDumper::setHandler`. `$label` is optional.
     */
    type DumpHandler = (callable(mixed): mixed)&(callable(mixed, ?string): mixed);

    /**
     * Overlay: dump handler callable shape.
     */
    // @overlay-against: class VarDumper
    partial class VarDumper {
        /**
         * @param \Symfony\Component\VarDumper\DumpHandler|null $callable
         * @return \Symfony\Component\VarDumper\DumpHandler|null
         */
        // @overlay-against: function setHandler(?callable $callable): ?callable
        public static function setHandler(?\Symfony\Component\VarDumper\DumpHandler $callable): ?\Symfony\Component\VarDumper\DumpHandler;
    }
}

namespace Symfony\Component\VarDumper\Command {
    /**
     * Extends unwrapped `\Symfony\Component\Console\Command\Command`.
     */
    // @overlay-against: class ServerDumpCommand extends \Symfony\Component\Console\Command\Command
    omit class ServerDumpCommand {
    }
}

namespace Symfony\Component\VarDumper\Command\Descriptor {
    /**
     * Names unwrapped `\Symfony\Component\Console\Output\OutputInterface` on `describe`.
     */
    // @overlay-against: class CliDescriptor implements \Symfony\Component\VarDumper\Command\Descriptor\DumpDescriptorInterface
    omit class CliDescriptor {
    }

    /**
     * Names unwrapped `\Symfony\Component\Console\Output\OutputInterface` on `describe`.
     */
    // @overlay-against: interface DumpDescriptorInterface
    omit interface DumpDescriptorInterface {
    }

    /**
     * Names unwrapped `\Symfony\Component\Console\Output\OutputInterface` on `describe`.
     */
    // @overlay-against: class HtmlDescriptor implements \Symfony\Component\VarDumper\Command\Descriptor\DumpDescriptorInterface
    omit class HtmlDescriptor {
    }
}

namespace Symfony\Component\VarDumper\Cloner {
    /**
     * Overlay: PHPDoc shapes harvest left loose on `AbstractCloner`.
     */
    // @overlay-against: class AbstractCloner implements \Symfony\Component\VarDumper\Cloner\ClonerInterface
    partial class AbstractCloner {
        /**
         * @var array<string, \Symfony\Component\VarDumper\Caster\ObjectCaster|\Symfony\Component\VarDumper\Caster\ResourceCaster>
         */
        // @overlay-against: array $defaultCasters
        public static array<string, \Symfony\Component\VarDumper\Caster\ObjectCaster|\Symfony\Component\VarDumper\Caster\ResourceCaster> $defaultCasters ?? [];

        /**
         * @param array<string, \Symfony\Component\VarDumper\Caster\ObjectCaster|\Symfony\Component\VarDumper\Caster\ResourceCaster> $casters
         */
        // @overlay-against: function addDefaultCasters(array $casters): void
        public static function addDefaultCasters(array<string, \Symfony\Component\VarDumper\Caster\ObjectCaster|\Symfony\Component\VarDumper\Caster\ResourceCaster> $casters): void;

        /**
         * @param array<string, callable>|null $casters
         */
        // @overlay-against: function __construct(array|null $casters): void
        public function __construct(array<string, callable>|null $casters = null): void;

        /**
         * @param array<string, \Symfony\Component\VarDumper\Caster\ObjectCaster|\Symfony\Component\VarDumper\Caster\ResourceCaster> $casters
         */
        // @overlay-against: function addCasters(array $casters): void
        public function addCasters(array<string, \Symfony\Component\VarDumper\Caster\ObjectCaster|\Symfony\Component\VarDumper\Caster\ResourceCaster> $casters): void;
    }

    /**
     * Overlay: cursor attributes are a string-keyed map.
     */
    // @overlay-against: class Cursor
    partial class Cursor {
        /**
         * @var array<string, mixed>
         */
        // @overlay-against: array $attr
        public array<string, mixed> $attr ?? [];
    }

    /**
     * Overlay: cloned data, native value, and dump context.
     */
    // @overlay-against: class Data implements \ArrayAccess, \Countable, \IteratorAggregate, \Stringable
    partial class Data {
        /**
         * @param array<int|string, mixed> $data
         */
        // @overlay-against: function __construct(array $data): void
        public function __construct(array<int|string, mixed> $data): void;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function getContext(): array
        public function getContext(): array<string, mixed>;

        /**
         * @return \Traversable<int|string, mixed>
         */
        // @overlay-against: function getIterator(): \Traversable
        public function getIterator(): \Traversable<int|string, mixed>;

        /**
         * @param array<string, bool>|bool $recursive
         * @return string|int|float|bool|array<int|string, mixed>|null
         */
        // @overlay-against: function getValue(array|bool $recursive): string|int|float|bool|array|null
        public function getValue(array<string, bool>|bool $recursive = false): string|int|float|bool|array<int|string, mixed>|null;

        /**
         * @param array<string, mixed> $context
         */
        // @overlay-against: function withContext(array $context): static
        public function withContext(array<string, mixed> $context): static;
    }

    /**
     * Overlay: stub attributes and serialization payload.
     */
    // @overlay-against: class Stub
    partial class Stub {
        /**
         * @var array<string, mixed>
         */
        // @overlay-against: array $attr
        public array<string, mixed> $attr ?? [];

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function __serialize(): array
        public function __serialize(): array<string, mixed>;
    }
}

namespace Symfony\Component\VarDumper\Caster {
    /**
     * Object-cast property bag (string keys, including caster prefixes).
     */
    type CastArray = array<string, mixed>;

    /**
     * Object caster. The `$filter` argument is optional.
     */
    type ObjectCaster = (callable(object, \Symfony\Component\VarDumper\Caster\CastArray, \Symfony\Component\VarDumper\Cloner\Stub, bool): \Symfony\Component\VarDumper\Caster\CastArray)&(callable(object, \Symfony\Component\VarDumper\Caster\CastArray, \Symfony\Component\VarDumper\Cloner\Stub, bool, int): \Symfony\Component\VarDumper\Caster\CastArray);

    /**
     * Resource caster (`Stub` plus the cast array).
     */
    type ResourceCaster = callable(\Symfony\Component\VarDumper\Cloner\Stub, \Symfony\Component\VarDumper\Caster\CastArray): \Symfony\Component\VarDumper\Caster\CastArray;

    /**
     * One `debug_backtrace` / `Exception::getTrace` frame.
     */
    type DumpFrame = struct {
        string $function;
        ?string $file;
        ?int $line;
        ?string $class;
        ?object $object;
        ?string $type;
        ?array<int|string, mixed> $args;
    };

    /**
     * Overlay: argument list passed to a call.
     */
    // @overlay-against: class ArgsStub extends \Symfony\Component\VarDumper\Caster\EnumStub
    partial class ArgsStub {
        /**
         * @param array<int|string, mixed> $args
         * @param __ClassName|null $class
         */
        // @overlay-against: function __construct(array $args, string $function, ?string $class): void
        public function __construct(array<int|string, mixed> $args, string $function, ?__ClassName $class): void;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `Caster`.
     */
    // @overlay-against: class Caster
    partial class Caster {
        /**
         * @param array<int, string> $listedProperties
         */
        // @overlay-against: function filter(array $a, int $filter, array $listedProperties, ?int $count): array
        public static function filter(array $a, int $filter, array<int, string> $listedProperties = [], ?int &$count = 0): array;
    }

    /**
     * Overlay: ambiguous callable may be a `[class|object, method]` pair.
     */
    // @overlay-against: class ClassStub extends \Symfony\Component\VarDumper\Caster\ConstStub
    partial class ClassStub {
        /**
         * @param (callable)|(array<int, object|string>)|string|null $callable
         */
        // @overlay-against: function __construct(string $identifier, callable|array|string|null $callable): void
        public function __construct(string $identifier, (callable)|(array<int, object|string>)|string|null $callable = null): void;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `ConstStub`.
     */
    // @overlay-against: class ConstStub extends \Symfony\Component\VarDumper\Cloner\Stub
    partial class ConstStub {
        /**
         * @param array<int, string> $values
         */
        // @overlay-against: function fromBitfield(int $value, array $values): self
        public static function fromBitfield(int $value, array<int, string> $values): self;
    }

    /**
     * Overlay: cut array keeps a subset of keys.
     */
    // @overlay-against: class CutArrayStub extends \Symfony\Component\VarDumper\Caster\CutStub
    partial class CutArrayStub {
        /**
         * @var array<int|string, mixed>
         */
        // @overlay-against: array $preservedSubset
        public array<int|string, mixed> $preservedSubset;

        /**
         * @param array<int|string, mixed> $value
         * @param array<int|string, int|string> $preservedKeys
         */
        // @overlay-against: function __construct(array $value, array $preservedKeys): void
        public function __construct(array<int|string, mixed> $value, array<int|string, int|string> $preservedKeys): void;
    }

    /**
     * Overlay: Ds casters exchange a string-keyed property bag.
     */
    // @overlay-against: class DsCaster
    partial class DsCaster {
        /**
         * @param \Symfony\Component\VarDumper\Caster\CastArray $a
         * @return \Symfony\Component\VarDumper\Caster\CastArray
         */
        // @overlay-against: function castCollection(\Ds\Collection $c, array $a, \Symfony\Component\VarDumper\Cloner\Stub $stub, bool $isNested): array
        public static function castCollection(\Ds\Collection $c, \Symfony\Component\VarDumper\Caster\CastArray $a, \Symfony\Component\VarDumper\Cloner\Stub $stub, bool $isNested): \Symfony\Component\VarDumper\Caster\CastArray;

        /**
         * @param \Symfony\Component\VarDumper\Caster\CastArray $a
         * @return \Symfony\Component\VarDumper\Caster\CastArray
         */
        // @overlay-against: function castMap(\Ds\Map $c, array $a, \Symfony\Component\VarDumper\Cloner\Stub $stub, bool $isNested): array
        public static function castMap(\Ds\Map $c, \Symfony\Component\VarDumper\Caster\CastArray $a, \Symfony\Component\VarDumper\Cloner\Stub $stub, bool $isNested): \Symfony\Component\VarDumper\Caster\CastArray;

        /**
         * @param \Symfony\Component\VarDumper\Caster\CastArray $a
         * @return \Symfony\Component\VarDumper\Caster\CastArray
         */
        // @overlay-against: function castPair(\Ds\Pair $c, array $a, \Symfony\Component\VarDumper\Cloner\Stub $stub, bool $isNested): array
        public static function castPair(\Ds\Pair $c, \Symfony\Component\VarDumper\Caster\CastArray $a, \Symfony\Component\VarDumper\Cloner\Stub $stub, bool $isNested): \Symfony\Component\VarDumper\Caster\CastArray;

        /**
         * @param \Symfony\Component\VarDumper\Caster\CastArray $a
         * @return \Symfony\Component\VarDumper\Caster\CastArray
         */
        // @overlay-against: function castPairStub(\Symfony\Component\VarDumper\Caster\DsPairStub $c, array $a, \Symfony\Component\VarDumper\Cloner\Stub $stub, bool $isNested): array
        public static function castPairStub(\Symfony\Component\VarDumper\Caster\DsPairStub $c, \Symfony\Component\VarDumper\Caster\CastArray $a, \Symfony\Component\VarDumper\Cloner\Stub $stub, bool $isNested): \Symfony\Component\VarDumper\Caster\CastArray;
    }

    /**
     * Overlay: enumerated values are a map or list.
     */
    // @overlay-against: class EnumStub extends \Symfony\Component\VarDumper\Cloner\Stub
    partial class EnumStub {
        /**
         * @param array<int|string, mixed> $values
         */
        // @overlay-against: function __construct(array $values, bool $dumpKeys): void
        public function __construct(array<int|string, mixed> $values, bool $dumpKeys = true): void;
    }

    /**
     * Overlay: FFI caster exchanges a string-keyed property bag.
     */
    // @overlay-against: class FFICaster
    partial class FFICaster {
        /**
         * @param \Symfony\Component\VarDumper\Caster\CastArray $args
         * @return \Symfony\Component\VarDumper\Caster\CastArray
         */
        // @overlay-against: function castCTypeOrCData(\FFI\CData|\FFI\CType $data, array $args, \Symfony\Component\VarDumper\Cloner\Stub $stub): array
        public static function castCTypeOrCData(\FFI\CData|\FFI\CType $data, \Symfony\Component\VarDumper\Caster\CastArray $args, \Symfony\Component\VarDumper\Cloner\Stub $stub): \Symfony\Component\VarDumper\Caster\CastArray;
    }

    /**
     * Overlay: Fiber caster exchanges a string-keyed property bag.
     */
    // @overlay-against: class FiberCaster
    partial class FiberCaster {
        /**
         * @param \Symfony\Component\VarDumper\Caster\CastArray $a
         * @return \Symfony\Component\VarDumper\Caster\CastArray
         */
        // @overlay-against: function castFiber(\Fiber $fiber, array $a, \Symfony\Component\VarDumper\Cloner\Stub $stub, bool $isNested, int $filter): array
        public static function castFiber(\Fiber $fiber, \Symfony\Component\VarDumper\Caster\CastArray $a, \Symfony\Component\VarDumper\Cloner\Stub $stub, bool $isNested, int $filter = 0): \Symfony\Component\VarDumper\Caster\CastArray;
    }

    /**
     * Overlay: one backtrace frame.
     */
    // @overlay-against: class FrameStub extends \Symfony\Component\VarDumper\Caster\EnumStub
    partial class FrameStub {
        /**
         * @param \Symfony\Component\VarDumper\Caster\DumpFrame $frame
         */
        // @overlay-against: function __construct(array $frame, bool $keepArgs, bool $inTraceStub): void
        public function __construct(\Symfony\Component\VarDumper\Caster\DumpFrame $frame, bool $keepArgs = true, bool $inTraceStub = false): void;
    }

    /**
     * Overlay: backtrace is a list of frames.
     */
    // @overlay-against: class TraceStub extends \Symfony\Component\VarDumper\Cloner\Stub
    partial class TraceStub {
        /**
         * @param array<int|string, \Symfony\Component\VarDumper\Caster\DumpFrame> $trace
         */
        // @overlay-against: function __construct(array $trace, bool $keepArgs, int $sliceOffset, ?int $sliceLength, int $numberingOffset): void
        public function __construct(array<int|string, \Symfony\Component\VarDumper\Caster\DumpFrame> $trace, bool $keepArgs = true, int $sliceOffset = 0, ?int $sliceLength = null, int $numberingOffset = 0): void;
    }
}

namespace Symfony\Component\VarDumper\Server {
    /**
     * Overlay: PHPDoc shapes harvest left loose on `Connection`.
     */
    // @overlay-against: class Connection
    partial class Connection {
        /**
         * @param array<string, \Symfony\Component\VarDumper\Dumper\ContextProvider\ContextProviderInterface> $contextProviders
