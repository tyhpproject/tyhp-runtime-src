<?tyhp

function test_var_dumper_dump(): mixed
{
    return \Symfony\Component\VarDumper\VarDumper::dump(['ok' => true], 'label');
}

function test_var_dumper_clone(): \Symfony\Component\VarDumper\Cloner\Data
{
    return (new \Symfony\Component\VarDumper\Cloner\VarCloner())->cloneVar('hello');
}

function test_var_dumper_cli(\Symfony\Component\VarDumper\Dumper\CliDumper $dumper, \Symfony\Component\VarDumper\Cloner\Data $data): ?string
{
    return $dumper->dump($data, true);
}
