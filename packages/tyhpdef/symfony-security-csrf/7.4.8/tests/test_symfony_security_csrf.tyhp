<?tyhp

function test_csrf_get_token(\Symfony\Component\Security\Csrf\CsrfTokenManagerInterface $manager): \Symfony\Component\Security\Csrf\CsrfToken
{
    return $manager->getToken('login');
}

function test_csrf_token_id(): string
{
    return (new \Symfony\Component\Security\Csrf\CsrfToken('login', 'abc'))->getId();
}
