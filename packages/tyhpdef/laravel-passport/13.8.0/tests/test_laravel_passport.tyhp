<?tyhp

class PassportUser
{
    use \Laravel\Passport\HasApiTokens;
}

function test_passport_client(): \Laravel\Passport\Client
{
    return new \Laravel\Passport\Client();
}

function test_passport_token(): \Laravel\Passport\Token
{
    return new \Laravel\Passport\Token();
}

function test_has_api_tokens_scope(): bool
{
    return (new PassportUser())->tokenCan('scope');
}

function test_passport_cookie(): string
{
    return \Laravel\Passport\Passport::cookie('laravel_token');
}

function test_passport_has_scope(): bool
{
    return \Laravel\Passport\Passport::hasScope('read');
}
