{
  "name": "tyhpdef/league-oauth2-server",
  "description": "Tyhp type definitions for the Composer package league/oauth2-server (9.4.1).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "9.4.1.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/defuse-php-encryption": "@dev",
        "tyhpdef/lcobucci-jwt": "@dev",
        "tyhpdef/psr-event-dispatcher": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "league/oauth2-server": "9.4.1"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/psr-http-message": "@dev",
    "tyhpdef/defuse-php-encryption": "@dev",
    "tyhpdef/lcobucci-jwt": "@dev",
    "tyhpdef/psr-event-dispatcher": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../psr-http-message/2.0"
    },
    {
      "type": "path",
      "url": "../../defuse-php-encryption/2.4.0"
    },
    {
      "type": "path",
      "url": "../../lcobucci-jwt/5.6.0"
    },
    {
      "type": "path",
      "url": "../../psr-event-dispatcher/1.0.0"
    }
  ]
}
