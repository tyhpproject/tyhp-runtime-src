namespace League\OAuth2\Server\EventEmitting {
    /**
     * Overlay: drop `HasEventName` — league/event is STOP (no invented APIs).
     */
    // @overlay-against: class AbstractEvent implements \Psr\EventDispatcher\StoppableEventInterface, \League\Event\HasEventName
    partial class AbstractEvent implements \Psr\EventDispatcher\StoppableEventInterface;

    /**
     * Overlay: drop `extends EventDispatcher` — league/event is STOP (no invented APIs).
     */
    // @overlay-against: class EventEmitter extends \League\Event\EventDispatcher
    final class EventEmitter {
        // @overlay-against: function addListener(string $event, callable $listener, int $priority): self
        public function addListener(string $event, callable $listener, int $priority = 0): self;

        // @overlay-against: function emit(object $event): object
        public function emit(object $event): object;
    }
}

namespace League\OAuth2\Server\Grant {
    /**
     * Overlay: client credentials are a two-slot username/password tuple.
     */
    // @overlay-against: class AbstractGrant implements \League\OAuth2\Server\Grant\GrantTypeInterface, \League\OAuth2\Server\EventEmitting\EmitterAwarePolyfill, \League\OAuth2\Server\CryptTrait
    partial class AbstractGrant {
        /**
         * @return array{0: string|null, 1: string|null}
         */
        // @overlay-against: function getBasicAuthCredentials(\Psr\Http\Message\ServerRequestInterface $request): array
        protected function getBasicAuthCredentials(\Psr\Http\Message\ServerRequestInterface $request): array<int, string|null>;

        /**
         * @return array{0: string|null, 1: string|null}
         */
        // @overlay-against: function getClientCredentials(\Psr\Http\Message\ServerRequestInterface $request): array
        protected function getClientCredentials(\Psr\Http\Message\ServerRequestInterface $request): array<int, string|null>;

        /**
         * @param string|array<int|string, string>|null $scopes
         */
        // @overlay-against: function validateScopes(string|array|null $scopes, ?string $redirectUri): array
        public function validateScopes(string|array<int|string, string>|null $scopes, ?string $redirectUri = null): array<int, \League\OAuth2\Server\Entities\ScopeEntityInterface>;
    }
}

