{
    "name": "tyhpdef/guzzlehttp-guzzle",
    "description": "Tyhp type definitions for the Composer package guzzlehttp/guzzle (7.15.5).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.15.5.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/guzzlehttp-promises": "@dev",
                "tyhpdef/psr-http-client": "@dev",
                "tyhpdef/psr-http-message": "@dev",
                "tyhpdef/psr-http-factory": "@dev",
                "tyhpdef/guzzlehttp-psr7": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "7.15.5"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/guzzlehttp-promises": "@dev",
        "tyhpdef/psr-http-client": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/psr-http-factory": "@dev",
        "tyhpdef/guzzlehttp-psr7": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../psr-http-message/2.0"
        },
        {
            "type": "path",
            "url": "../../psr-http-client/1.0.3"
        },
        {
            "type": "path",
            "url": "../../psr-http-factory/1.1.0"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-promises/2.5.3"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-psr7/2.13.1"
        }
    ]
}
