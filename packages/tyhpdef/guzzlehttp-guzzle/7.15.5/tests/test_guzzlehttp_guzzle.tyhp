<?tyhp

function test_guzzlehttp_guzzle_package_loads(): bool
{
    return true;
}

function test_guzzle_client(): \GuzzleHttp\ClientInterface
{
    return new \GuzzleHttp\Client(['base_uri' => 'https://example.com', 'timeout' => 1.5]);
}

function test_guzzle_request(\GuzzleHttp\Client $client): \Psr\Http\Message\ResponseInterface
{
    return $client->request('GET', '/status');
}

function test_guzzle_send(\GuzzleHttp\Client $client, \Psr\Http\Message\RequestInterface $request): \Psr\Http\Message\ResponseInterface
{
    return $client->send($request);
}

function test_guzzle_psr18(\Psr\Http\Client\ClientInterface $client, \Psr\Http\Message\RequestInterface $request): \Psr\Http\Message\ResponseInterface
{
    return $client->sendRequest($request);
}

function test_guzzle_request_async(\GuzzleHttp\Client $client): \GuzzleHttp\Promise\PromiseInterface
{
    return $client->requestAsync('GET', 'https://example.com');
}

function test_guzzle_handler_stack(): \GuzzleHttp\HandlerStack
{
    return \GuzzleHttp\HandlerStack::create();
}
