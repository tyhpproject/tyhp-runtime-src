{
    "name": "tyhpdef/dompdf-dompdf",
    "description": "Tyhp type definitions for the Composer package dompdf/dompdf (3.1.6).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "3.1.6.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/php-ext-dom": "@dev",
                "tyhpdef/php-ext-gd": "@dev",
                "tyhpdef/masterminds-html5": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "dompdf/dompdf": "3.1.6"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/php-ext-dom": "@dev",
        "tyhpdef/php-ext-gd": "@dev",
        "tyhpdef/masterminds-html5": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../php-ext-dom"
        },
        {
            "type": "path",
            "url": "../../php-ext-gd"
        },
        {
            "type": "path",
            "url": "../../masterminds-html5/2.11.0"
        }
    ]
}
