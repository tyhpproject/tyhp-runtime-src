<?tyhpdef
/**
 * Foreign Composer types named by doctrine/migrations.
 * `doctrine/orm`, `doctrine/persistence`, and Symfony Console/Stopwatch
 * are other packages (persistence generate failed; console is another worker).
 * Declare the names without inlining those APIs.
 */
extern interface \Doctrine\ORM\EntityManagerInterface;
extern interface \Doctrine\Persistence\ConnectionRegistry;
extern interface \Doctrine\Persistence\ManagerRegistry;
extern class \Symfony\Component\Stopwatch\Stopwatch;
extern interface \Symfony\Component\Console\Input\InputInterface;
extern interface \Symfony\Component\Console\Output\OutputInterface;
extern interface \Symfony\Component\Console\Style\StyleInterface;
extern class \Symfony\Component\Console\Command\Command;
extern class \Symfony\Component\Console\Application;
