<?tyhp

function test_tinker_command(): \Laravel\Tinker\Console\TinkerCommand
{
    return new \Laravel\Tinker\Console\TinkerCommand();
}

function test_tinker_provider(): \Laravel\Tinker\TinkerServiceProvider
{
    return new \Laravel\Tinker\TinkerServiceProvider(new \Illuminate\Foundation\Application());
}

function test_tinker_provider_provides(): array
{
    return (new \Laravel\Tinker\TinkerServiceProvider(new \Illuminate\Foundation\Application()))->provides();
}

function test_tinker_cast_html_string(): array
{
    return \Laravel\Tinker\TinkerCaster::castHtmlString(new \Illuminate\Support\HtmlString('hello'));
}

function test_tinker_cast_stringable(): array
{
    return \Laravel\Tinker\TinkerCaster::castStringable(new \Illuminate\Support\Stringable('hello'));
}

function test_tinker_cast_collection(): array
{
    return \Laravel\Tinker\TinkerCaster::castCollection(new \Illuminate\Support\Collection());
}
