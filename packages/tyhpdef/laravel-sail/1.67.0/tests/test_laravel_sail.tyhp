function test_sail_add_command(): \Laravel\Sail\Console\AddCommand
{
    return new \Laravel\Sail\Console\AddCommand();
}

function test_sail_install_command(): \Laravel\Sail\Console\InstallCommand
{
    return new \Laravel\Sail\Console\InstallCommand();
}

function test_sail_publish_command(): \Laravel\Sail\Console\PublishCommand
{
    return new \Laravel\Sail\Console\PublishCommand();
}

function test_sail_provider(): \Laravel\Sail\SailServiceProvider
{
    return new \Laravel\Sail\SailServiceProvider(new \Illuminate\Foundation\Application());
}

function test_sail_provider_provides(): array
{
    return (new \Laravel\Sail\SailServiceProvider(new \Illuminate\Foundation\Application()))->provides();
}
