<?tyhp

function test_http_message_factory_request(\Http\Message\MessageFactory $factory): \Psr\Http\Message\RequestInterface
{
    return $factory->createRequest('GET', 'https://example.com');
}

function test_http_message_factory_response(\Http\Message\ResponseFactory $factory): \Psr\Http\Message\ResponseInterface
{
    return $factory->createResponse(204);
}

function test_http_stream_factory(\Http\Message\StreamFactory $factory): \Psr\Http\Message\StreamInterface
{
    return $factory->createStream('body');
}

function test_http_uri_factory(\Http\Message\UriFactory $factory): \Psr\Http\Message\UriInterface
{
    return $factory->createUri('https://example.com/path');
}
