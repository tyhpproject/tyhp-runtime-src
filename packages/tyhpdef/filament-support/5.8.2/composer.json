{
    "name": "tyhpdef/filament-support",
    "description": "Tyhp type definitions for the Composer package filament/support (5.8.2).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "5.8.2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": "8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/livewire-livewire": "@dev",
                "tyhpdef/spatie-laravel-package-tools": "@dev",
                "tyhpdef/staudenmeir-belongs-to-through": "@dev",
                "tyhpdef/nette-php-generator": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "filament/support": "5.8.2"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/livewire-livewire": "@dev",
        "tyhpdef/spatie-laravel-package-tools": "@dev",
        "tyhpdef/staudenmeir-belongs-to-through": "@dev",
        "tyhpdef/nette-php-generator": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../laravel-framework/13.32.0"
        },
        {
            "type": "path",
            "url": "../../livewire-livewire/4.4.5"
        },
        {
            "type": "path",
            "url": "../../spatie-laravel-package-tools/1.93.2"
        },
        {
            "type": "path",
            "url": "../../staudenmeir-belongs-to-through/2.18"
        },
        {
            "type": "path",
            "url": "../../nette-php-generator/4.2.2"
        }
    ]
}
