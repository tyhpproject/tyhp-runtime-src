<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * PHP array keys are `int|string`. Collection callbacks and `map()` results
 * keep their template arguments. Map keys are `int|string`.
 */

namespace Ramsey\Collection {
    /**
     * Overlay: iterator keys and stored maps use `int|string`, not `mixed`.
     */
    // @overlay-against: class AbstractArray implements \Ramsey\Collection\ArrayInterface
    partial class AbstractArray {
        /**
         * @var array<int|string, T>
         */
        // @overlay-against: array $data
        protected array<int|string, T> $data;

        // @overlay-against: function __construct(array $data): void
        public function __construct(array<int|string, T> $data = []): void;

        // @overlay-against: function __serialize(): array
        public function __serialize(): array<int|string, T>;

        // @overlay-against: function __unserialize(array $data): void
        public function __unserialize(array<int|string, T> $data): void;

        // @overlay-against: function getIterator(): \Traversable
        public function getIterator(): \Traversable<int|string, T>;

        // @overlay-against: function offsetExists(mixed $offset): bool
        public function offsetExists(int|string $offset): bool;

        // @overlay-against: function offsetGet(mixed $offset): T
        public function offsetGet(int|string $offset): T;

        // @overlay-against: function offsetSet(mixed $offset, T $value): void
        public function offsetSet(int|string|null $offset, T $value): void;

        // @overlay-against: function offsetUnset(mixed $offset): void
        public function offsetUnset(int|string $offset): void;

        /**
         * @return array<int|string, T>
         */
        // @overlay-against: function toArray(): array
        public function toArray(): array<int|string, T>;
    }

    /**
     * Overlay: callbacks are typed; `map()` returns a collection of the callback result.
     */
    // @overlay-against: class AbstractCollection extends \Ramsey\Collection\AbstractArray implements \Ramsey\Collection\CollectionInterface, \Ramsey\Collection\Tool\TypeTrait, \Ramsey\Collection\Tool\ValueToStringTrait, \Ramsey\Collection\Tool\ValueExtractorTrait
    partial class AbstractCollection {
        // @overlay-against: function column(string $propertyOrMethod): array
        public function column(string $propertyOrMethod): array<int, mixed>;

        // @overlay-against: function diff(\Ramsey\Collection\CollectionInterface $other): \Ramsey\Collection\CollectionInterface
        public function diff(\Ramsey\Collection\CollectionInterface<T> $other): \Ramsey\Collection\CollectionInterface<T>;

        // @overlay-against: function filter(callable $callback): \Ramsey\Collection\CollectionInterface
        public function filter(callable(T): bool $callback): \Ramsey\Collection\CollectionInterface<T>;

        // @overlay-against: function intersect(\Ramsey\Collection\CollectionInterface $other): \Ramsey\Collection\CollectionInterface
        public function intersect(\Ramsey\Collection\CollectionInterface<T> $other): \Ramsey\Collection\CollectionInterface<T>;

        // @overlay-against: function map(callable $callback): \Ramsey\Collection\CollectionInterface
        public function map<TCallbackReturn>(callable(T): TCallbackReturn $callback): \Ramsey\Collection\CollectionInterface<TCallbackReturn>;

        // @overlay-against: function merge(\Ramsey\Collection\CollectionInterface $collections): \Ramsey\Collection\CollectionInterface
        public function merge(\Ramsey\Collection\CollectionInterface<T> ...$collections): \Ramsey\Collection\CollectionInterface<T>;

        // @overlay-against: function reduce(callable $callback, TCarry $initial): TCarry
        public function reduce<TCarry>(callable(TCarry, T): TCarry $callback, TCarry $initial): TCarry;

        // @overlay-against: function sort(?string $propertyOrMethod, \Ramsey\Collection\Sort $order): \Ramsey\Collection\CollectionInterface
        public function sort(?string $propertyOrMethod = null, \Ramsey\Collection\Sort $order = \Ramsey\Collection\Sort::Ascending): \Ramsey\Collection\CollectionInterface<T>;

        // @overlay-against: function where(?string $propertyOrMethod, mixed $value): \Ramsey\Collection\CollectionInterface
        public function where(?string $propertyOrMethod, mixed $value): \Ramsey\Collection\CollectionInterface<T>;
    }

    /**
     * Overlay: `toArray()` is keyed by `int|string`.
     */
    // @overlay-against: interface ArrayInterface
    partial interface ArrayInterface {
        // @overlay-against: function toArray(): array
        public function toArray(): array<int|string, T>;
    }

    /**
     * Tyhp encoding: L1 constructor is `array<mixed, T>`; PHP array keys are
     * `int|string`, and `mixed` does not satisfy KeyIntOrString once toArray is keyed.
     */
    // @overlay-against: class Collection extends \Ramsey\Collection\AbstractCollection
    partial class Collection {
        /**
         * @param array<int|string, T> $data
         */
        // @overlay-against: function __construct(string $collectionType, array $data): void
        public function __construct(string $collectionType, array<int|string, T> $data = []): void;
    }

    /**
     * Overlay: same callback and result types as `AbstractCollection`.
     */
    // @overlay-against: interface CollectionInterface
    partial interface CollectionInterface {
        // @overlay-against: function diff(\Ramsey\Collection\CollectionInterface $other): self
        public function diff(\Ramsey\Collection\CollectionInterface<T> $other): self;

        // @overlay-against: function filter(callable $callback): self
        public function filter(callable(T): bool $callback): self;

        // @overlay-against: function intersect(\Ramsey\Collection\CollectionInterface $other): self
        public function intersect(\Ramsey\Collection\CollectionInterface<T> $other): self;

        // @overlay-against: function map(callable $callback): self
        public function map<TCallbackReturn>(callable(T): TCallbackReturn $callback): \Ramsey\Collection\CollectionInterface<TCallbackReturn>;

        // @overlay-against: function merge(\Ramsey\Collection\CollectionInterface $collections): self
        public function merge(\Ramsey\Collection\CollectionInterface<T> ...$collections): self;

        // @overlay-against: function reduce(callable $callback, TCarry $initial): TCarry
        public function reduce<TCarry>(callable(TCarry, T): TCarry $callback, TCarry $initial): TCarry;
    }

    // @overlay-against: class DoubleEndedQueue extends \Ramsey\Collection\Queue implements \Ramsey\Collection\DoubleEndedQueueInterface
    partial class DoubleEndedQueue {
        // @overlay-against: function __construct(string $queueType, array $data): void
        public function __construct(string $queueType, array<int|string, T> $data = []): void;
    }

    // @overlay-against: class Queue extends \Ramsey\Collection\AbstractArray implements \Ramsey\Collection\QueueInterface, \Ramsey\Collection\Tool\TypeTrait, \Ramsey\Collection\Tool\ValueToStringTrait
    partial class Queue {
        // @overlay-against: function __construct(string $queueType, array $data): void
        public function __construct(string $queueType, array<int|string, T> $data = []): void;
    }

    // @overlay-against: class Set extends \Ramsey\Collection\AbstractSet
    partial class Set {
        // @overlay-against: function __construct(string $setType, array $data): void
        public function __construct(string $setType, array<int|string, T> $data = []): void;
    }
}

namespace Ramsey\Collection\Map {
    /**
     * Overlay: map keys are PHP array keys.
     */
    // @overlay-against: class AbstractMap extends \Ramsey\Collection\AbstractArray implements \Ramsey\Collection\Map\MapInterface
    partial class AbstractMap<K extends int|string, T>;

    // @overlay-against: class AbstractMap extends \Ramsey\Collection\AbstractArray implements \Ramsey\Collection\Map\MapInterface
    partial class AbstractMap {
        // @overlay-against: function containsValue(mixed $value): bool
        public function containsValue(T $value): bool;

        // @overlay-against: function getIterator(): \Traversable
        public function getIterator(): \Traversable<K, T>;

        // @overlay-against: function keys(): array
        public function keys(): array<int, K>;
    }

    /**
     * Overlay: `K` is an array key.
     */
    // @overlay-against: interface MapInterface
    partial interface MapInterface<K extends int|string, T>;
}
