<?tyhp

function test_psr_http_client_send(\Psr\Http\Client\ClientInterface $client, \Psr\Http\Message\RequestInterface $request): \Psr\Http\Message\ResponseInterface
{
    return $client->sendRequest($request);
}

function test_psr_http_client_network_exception(\Psr\Http\Client\NetworkExceptionInterface $e): \Psr\Http\Message\RequestInterface
{
    return $e->getRequest();
}

function test_psr_http_client_request_exception(\Psr\Http\Client\RequestExceptionInterface $e): \Psr\Http\Client\ClientExceptionInterface
{
    $e->getRequest();
    return $e;
}
