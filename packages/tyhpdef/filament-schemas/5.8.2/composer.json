{
    "name": "tyhpdef/filament-schemas",
    "description": "Tyhp type definitions for the Composer package filament/schemas (5.8.2).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "5.8.2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": "8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/livewire-livewire": "@dev",
                "tyhpdef/filament-support": "@dev",
                "tyhpdef/filament-forms": "@dev",
                "tyhpdef/filament-actions": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "filament/schemas": "5.8.2"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/livewire-livewire": "@dev",
        "tyhpdef/filament-support": "@dev",
        "tyhpdef/filament-forms": "@dev",
        "tyhpdef/filament-actions": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../laravel-framework/13.32.0"
        },
        {
            "type": "path",
            "url": "../../livewire-livewire/4.4.5"
        },
        {
            "type": "path",
            "url": "../../filament-support/5.8.2"
        },
        {
            "type": "path",
            "url": "../../filament-forms/5.8.2"
        },
        {
            "type": "path",
            "url": "../../filament-actions/5.8.2"
        }
    ]
}
