<?tyhp

function test_dbal_query_builder(\Doctrine\DBAL\Connection $connection): \Doctrine\DBAL\Query\QueryBuilder
{
    return $connection->createQueryBuilder();
}

function test_dbal_select(\Doctrine\DBAL\Query\QueryBuilder $qb): \Doctrine\DBAL\Query\QueryBuilder
{
    return $qb->select('u.id', 'u.name')->from('users', 'u');
}

function test_dbal_distinct(\Doctrine\DBAL\Query\QueryBuilder $qb): \Doctrine\DBAL\Query\QueryBuilder
{
    return $qb->select('u.id')->distinct()->from('users', 'u');
}

function test_dbal_config(): \Doctrine\DBAL\Configuration
{
    return new \Doctrine\DBAL\Configuration();
}
