{
    "name": "tyhpdef/filament-filament",
    "description": "Tyhp type definitions for the Composer package filament/filament (5.8.2).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "5.8.2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": "8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/livewire-livewire": "@dev",
                "tyhpdef/spatie-laravel-package-tools": "@dev",
                "tyhpdef/filament-support": "@dev",
                "tyhpdef/filament-schemas": "@dev",
                "tyhpdef/filament-forms": "@dev",
                "tyhpdef/filament-tables": "@dev",
                "tyhpdef/pragmarx-google2fa-qrcode": "@dev",
                "tyhpdef/chillerlan-php-qrcode": "@dev",
                "tyhpdef/nette-php-generator": "@dev",
                "tyhpdef/danharrin-livewire-rate-limiting": "@dev",
                "tyhpdef/pragmarx-google2fa": "@dev",
                "tyhpdef/filament-actions": "@dev",
                "tyhpdef/filament-notifications": "@dev",
                "tyhpdef/filament-infolists": "@dev",
                "tyhpdef/filament-widgets": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "filament/filament": "5.8.2"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/livewire-livewire": "@dev",
        "tyhpdef/spatie-laravel-package-tools": "@dev",
        "tyhpdef/filament-support": "@dev",
        "tyhpdef/filament-schemas": "@dev",
        "tyhpdef/filament-forms": "@dev",
        "tyhpdef/filament-tables": "@dev",
        "tyhpdef/pragmarx-google2fa-qrcode": "@dev",
        "tyhpdef/chillerlan-php-qrcode": "@dev",
        "tyhpdef/nette-php-generator": "@dev",
        "tyhpdef/danharrin-livewire-rate-limiting": "@dev",
