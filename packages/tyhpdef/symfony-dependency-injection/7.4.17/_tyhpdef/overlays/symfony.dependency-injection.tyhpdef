        public function all(): array<string, \Symfony\Component\DependencyInjection\ParameterBag\ParameterValue>;

        // @overlay-against: function allDeprecated(): array
        public function allDeprecated(): array<string, \Symfony\Component\DependencyInjection\ParameterBag\DeprecatedParameter>;

        // @overlay-against: function allNonEmpty(): array
        public function allNonEmpty(): array<string, string>;

        // @overlay-against: function set(string $name, array|bool|string|int|float|\UnitEnum|null $value): void
        public function set(string $name, \Symfony\Component\DependencyInjection\ParameterBag\ParameterValue $value): void;
    }
}
