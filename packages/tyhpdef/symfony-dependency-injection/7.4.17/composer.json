{
    "name": "tyhpdef/symfony-dependency-injection",
    "description": "Tyhp type definitions for the Composer package symfony/dependency-injection (7.4.17).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.4.17.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/symfony-var-exporter": "@dev",
                "tyhpdef/symfony-config": "@dev",
                "tyhpdef/symfony-expression-language": "@dev",
                "tyhpdef/php-ext-dom": "@dev",
                "tyhpdef/psr-cache": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/dependency-injection": "7.4.17"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/symfony-var-exporter": "@dev",
        "tyhpdef/symfony-config": "@dev",
        "tyhpdef/symfony-expression-language": "@dev",
        "tyhpdef/php-ext-dom": "@dev",
        "tyhpdef/psr-cache": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../symfony-service-contracts/3.7.3"
        },
        {
            "type": "path",
            "url": "../../psr-container/2.0.2"
        },
        {
            "type": "path",
            "url": "../../symfony-var-exporter/7.4.18"
        },
        {
            "type": "path",
            "url": "../../symfony-config/7.4.17"
        },
        {
            "type": "path",
            "url": "../../symfony-expression-language/7.4.18"
        },
        {
            "type": "path",
            "url": "../../php-ext-dom"
        },
        {
            "type": "path",
            "url": "../../psr-cache/3.0.0"
        }
    ]
}
