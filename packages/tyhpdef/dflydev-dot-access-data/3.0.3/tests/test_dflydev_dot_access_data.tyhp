<?tyhp

function test_dot_access_new(): \Dflydev\DotAccessData\Data
{
    return new \Dflydev\DotAccessData\Data(['a' => ['b' => 1]]);
}

function test_dot_access_get(\Dflydev\DotAccessData\Data $d): mixed
{
    return $d->get('a.b');
}

function test_dot_access_has(\Dflydev\DotAccessData\Data $d): bool
{
    return $d->has('a.b');
}

function test_dot_access_set(\Dflydev\DotAccessData\Data $d): void
{
    $d->set('a.c', 'x');
}

function test_dot_access_import(\Dflydev\DotAccessData\Data $d): void
{
    $d->import(['z' => 2]);
}
