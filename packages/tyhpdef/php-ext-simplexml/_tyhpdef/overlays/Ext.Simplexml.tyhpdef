// @overlay-against: function simplexml_load_file(string $filename, ?string $class_name, int $options, string $namespace_or_prefix, bool $is_prefix): \SimpleXMLElement|false
function simplexml_load_file(
    string $filename,
    'SimpleXMLElement' $class_name = 'SimpleXMLElement',
    int $options = 0,
    string $namespace_or_prefix = '',
    bool $is_prefix = false
): \SimpleXMLElement|false;
// @overlay-against: function simplexml_load_file(string $filename, ?string $class_name, int $options, string $namespace_or_prefix, bool $is_prefix): \SimpleXMLElement|false
function simplexml_load_file<T extends \SimpleXMLElement>(
    string $filename,
    __ClassName<T> $class_name,
    int $options = 0,
    string $namespace_or_prefix = '',
    bool $is_prefix = false
): T|false;

// @overlay-against: function simplexml_load_string(string $data, ?string $class_name, int $options, string $namespace_or_prefix, bool $is_prefix): \SimpleXMLElement|false
