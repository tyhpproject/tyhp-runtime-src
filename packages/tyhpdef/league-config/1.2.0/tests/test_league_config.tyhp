<?tyhp

function test_league_config_new(): \League\Config\Configuration
{
    return new \League\Config\Configuration([
        'app' => \Nette\Schema\Expect::structure([
            'name' => \Nette\Schema\Expect::string(),
        ]),
    ]);
}

function test_league_config_merge(\League\Config\Configuration $config): void
{
    $config->merge([
        'app' => ['name' => 'tyhp'],
    ]);
}

function test_league_config_get(\League\Config\ConfigurationInterface $config): mixed
{
    return $config->get('app.name');
}

function test_league_config_exists(\League\Config\ConfigurationInterface $config): bool
{
    return $config->exists('app.name');
}
