{
  "name": "tyhpdef/doctrine-collections",
  "description": "Tyhp type definitions for the Composer package doctrine/collections (3.1.0).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "3.1.0.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "doctrine/collections": "^3.0"
  },
  "require-dev": {
    "tyhpdef/php": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    }
  ]
}
