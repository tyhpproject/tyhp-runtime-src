<?tyhp

function test_debugbar_add_collector(): \DebugBar\DebugBar
{
    $bar = new \DebugBar\DebugBar();
    $bar->addCollector(new \DebugBar\DataCollector\MessagesCollector());
    return $bar;
}

function test_debugbar_get_collector(\DebugBar\DebugBar $bar): \DebugBar\DataCollector\DataCollectorInterface
{
    return $bar->getCollector('messages');
}

function test_debugbar_get_data(\DebugBar\DebugBar $bar): array<string, mixed>
{
    return $bar->getData();
}
