<?tyhp

function test_image(): \Illuminate\Image\Image
{
    return new \Illuminate\Image\Image('');
}

function test_image_resize(\Illuminate\Image\Image $image): \Illuminate\Image\Image
{
    return $image->resize(64, 64);
}

function test_image_output_options(): \Illuminate\Image\ImageOutputOptions
{
    return new \Illuminate\Image\ImageOutputOptions();
}

function test_image_pipeline(): \Illuminate\Image\ImagePipeline
{
    return new \Illuminate\Image\ImagePipeline(new \Illuminate\Image\ImageOutputOptions());
}

function test_blur(): \Illuminate\Image\Transformations\Blur
{
    return new \Illuminate\Image\Transformations\Blur(5);
}
