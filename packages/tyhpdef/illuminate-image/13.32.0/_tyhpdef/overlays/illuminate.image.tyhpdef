<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `dimensions()` is width, then height.
 */

namespace Illuminate\Image {
    /**
     * Width and height, in that order.
     */
    type ImageDimensions = struct {
        int 0 as $width;
        int 1 as $height;
    };

    /**
     * Overlay: pixel size is a width/height pair.
     */
    // @overlay-against: class Image implements \Illuminate\Contracts\Support\Responsable, \Stringable, \Illuminate\Support\Traits\Conditionable, \Illuminate\Support\Traits\Macroable
    partial class Image {
        // @overlay-against: function dimensions(): array
        public function dimensions(): ImageDimensions;
    }
}

namespace Illuminate\Image\Drivers {
    /**
     * Overlay: decoded contents report the same width/height pair.
     */
    // @overlay-against: class InterventionDriver implements \Illuminate\Contracts\Image\Driver
    partial class InterventionDriver {
        // @overlay-against: function dimensions(string $contents): array
        public function dimensions(string $contents): \Illuminate\Image\ImageDimensions;
    }
}
