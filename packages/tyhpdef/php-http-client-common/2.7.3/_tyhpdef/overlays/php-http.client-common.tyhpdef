        // @overlay-against: function wait(mixed $unwrap): mixed
        public function wait(true $unwrap = true): \Psr\Http\Message\ResponseInterface;

        // @overlay-against: function wait(mixed $unwrap): mixed
        public function wait(false $unwrap): null;

        // @overlay-against: function wait(mixed $unwrap): mixed
        public function wait(bool $unwrap = true): \Psr\Http\Message\ResponseInterface|null;
    }

