    /**
     * Overlay: `wait(false)` is null; a fulfilled wait is the PSR-7 response.
     */
    // @overlay-against: class Deferred implements \Http\Promise\Promise
    partial class Deferred {
        /**
         * @param callable(): void $waitCallback Invoked once while the promise is still pending.
