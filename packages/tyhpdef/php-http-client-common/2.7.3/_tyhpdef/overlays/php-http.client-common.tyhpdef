namespace Http\Client\Common {
    /**
     * PSR-7 header map: one string or a list of strings per header name.
     */
    type HeaderMap = array<string, string|array<int|string, string>>;

    /**
     * `PluginChain` / `PluginClient` options. Only `max_restarts` is read.
     */
    type PluginChainOptions = struct {
        ?int $max_restarts;
    };

    /**
     * `PluginClientFactory::createClient()` options. `client_name` is removed before the client is built.
     */
    type PluginClientFactoryOptions = struct {
        ?string $client_name;
        ?int $max_restarts;
    };

    /**
     * Next or first plugin in a chain. Both receive the request and return a promise.
     */
    type PluginNext = callable(\Psr\Http\Message\RequestInterface): \Http\Promise\Promise;

    /**
     * Query-string map. Values are encoded by `QueryDefaultsPlugin`.
     */
    type QueryMap = array<string, string|int|float|bool|array<int|string, string|int|float|bool>>;

    /**
     * Overlay: batch lists accept Tyhp list literals.
     */
    // @overlay-against: interface BatchClientInterface
    partial interface BatchClientInterface {
        /**
