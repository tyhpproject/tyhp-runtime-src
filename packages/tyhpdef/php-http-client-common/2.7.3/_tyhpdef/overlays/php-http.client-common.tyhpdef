}

namespace Http\Client\Common\Plugin {
    /**
     * Buffer settings for `SeekableBodyPlugin`.
     */
    type SeekableBodyPluginConfig = struct {
        ?int $memory_buffer_size;
        ?bool $use_file_buffer;
    };

    /**
     * Internal plugin base omitted from Layer 1 (`@internal`).
     */
    abstract class SeekableBodyPlugin implements \Http\Client\Common\Plugin {
        /**
         * @param \Http\Client\Common\Plugin\SeekableBodyPluginConfig $config
         */
        public function __construct(\Http\Client\Common\Plugin\SeekableBodyPluginConfig $config = []): void;
    }

    /**
     * Overlay: replace the request host when it is missing, or always when `replace` is true.
     */
    type AddHostPluginConfig = struct {
        ?bool $replace;
    };

    /**
     * Overlay: skip content-type detection above `size_limit`.
     */
    type ContentTypePluginConfig = struct {
        ?bool $skip_detection;
        ?int $size_limit;
    };

    /**
     * Overlay: when false, only Transfer-Encoding is decoded.
     */
    type DecoderPluginConfig = struct {
        ?bool $use_content_encoding;
    };

    /**
     * Overlay: when true, only 5xx responses throw.
     */
    type ErrorPluginConfig = struct {
        ?bool $only_server_exception;
    };

    /**
     * Overlay: redirect plugin options from the PHP source.
     */
    type RedirectPluginConfig = struct {
        bool|array<int|string, string>|null $preserve_header;
        ?bool $use_default_for_multiple;
        ?bool $strict;
        ?\Psr\Http\Message\StreamFactoryInterface $stream_factory;
    };

    /**
     * Overlay: retry deciders and delays. Delays are microseconds.
     */
    type RetryErrorResponseDecider = callable(\Psr\Http\Message\RequestInterface, \Psr\Http\Message\ResponseInterface): bool;

    type RetryExceptionDecider = callable(\Psr\Http\Message\RequestInterface, \Psr\Http\Client\ClientExceptionInterface): bool;

    type RetryErrorResponseDelay = callable(\Psr\Http\Message\RequestInterface, \Psr\Http\Message\ResponseInterface, int): int;

    type RetryExceptionDelay = callable(\Psr\Http\Message\RequestInterface, \Psr\Http\Client\ClientExceptionInterface, int): int;

    type RetryPluginConfig = struct {
        ?int $retries;
        ?\Http\Client\Common\Plugin\RetryErrorResponseDecider $error_response_decider;
        ?\Http\Client\Common\Plugin\RetryExceptionDecider $exception_decider;
        ?\Http\Client\Common\Plugin\RetryErrorResponseDelay $error_response_delay;
        ?\Http\Client\Common\Plugin\RetryExceptionDelay $exception_delay;
    };

