{
  "name": "tyhpdef/spatie-flare-client-php",
  "description": "Tyhp type definitions for the Composer package spatie/flare-client-php (1.11.1).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "1.11.1.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/spatie-backtrace": "@dev",
        "tyhpdef/symfony-http-foundation": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "spatie/flare-client-php": "1.11.1"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/spatie-backtrace": "@dev",
    "tyhpdef/symfony-http-foundation": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../spatie-backtrace/1.8.2"
    },
    {
      "type": "path",
      "url": "../../symfony-http-foundation/7.4.19"
    }
  ]
}
