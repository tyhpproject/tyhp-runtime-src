<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Version lists accept Tyhp list literals. Interval maps and constraint
 * operators follow the PHP phpdoc.
 */

namespace Composer\Semver {
    /**
     * Overlay: `Intervals::get()` numeric intervals plus branch metadata.
     */
    type ConstraintIntervals = struct {
        array<int, \Composer\Semver\Interval> $numeric;
        DevBranches $branches;
    };

    /**
     * Overlay: `Interval::anyDev()` / `noDev()` branch selector.
     * `exclude` true means every branch name; false means none.
     */
    type DevBranches = struct {
        array<int, string> $names;
        bool $exclude;
    };

    // @overlay-against: class Interval
    partial class Interval {
        // @overlay-against: function anyDev(): array
        public static function anyDev(): DevBranches;

        // @overlay-against: function noDev(): array
        public static function noDev(): DevBranches;
    }

    /**
     * Overlay: `get()` returns numeric intervals plus branch metadata.
     */
    // @overlay-against: class Intervals
    partial class Intervals {
        /**
         * @return ConstraintIntervals
         */
        // @overlay-against: function get(\Composer\Semver\Constraint\ConstraintInterface $constraint): array
        public static function get(\Composer\Semver\Constraint\ConstraintInterface $constraint): ConstraintIntervals;
    }

    /**
     * Overlay: version lists accept Tyhp list literals.
     */
    // @overlay-against: class Semver
    partial class Semver {
        /**
         * @param array<int|string, string> $versions
         * @return array<int|string, string>
         */
        // @overlay-against: function rsort(array $versions): array
        public static function rsort(array<int|string, string> $versions): array<int|string, string>;

        /**
         * @param array<int|string, string> $versions
         * @return array<int|string, string>
         */
        // @overlay-against: function satisfiedBy(array $versions, string $constraints): array
        public static function satisfiedBy(array<int|string, string> $versions, string $constraints): array<int|string, string>;

        /**
         * @param array<int|string, string> $versions
         * @return array<int|string, string>
         */
        // @overlay-against: function sort(array $versions): array
        public static function sort(array<int|string, string> $versions): array<int|string, string>;
    }
}

namespace Composer\Semver\Constraint {
    // @overlay-against: class Bound
    partial class Bound {
        // @overlay-against: function __toString(): mixed
        public function __toString(): string;
    }

    // @overlay-against: class Constraint implements \Composer\Semver\Constraint\ConstraintInterface
    partial class Constraint {
        // @overlay-against: mixed $operator
        protected int $operator;

        // @overlay-against: function getOperatorConstant(string $operator): mixed
        public static function getOperatorConstant(string $operator): int;

        // @overlay-against: function getSupportedOperators(): mixed
        public static function getSupportedOperators(): array<int, string>;

        // @overlay-against: function compile(mixed $otherOperator): mixed
        public function compile(int $otherOperator): string;

        // @overlay-against: function getLowerBound(): mixed
        public function getLowerBound(): \Composer\Semver\Constraint\Bound;

        // @overlay-against: function getOperator(): mixed
        public function getOperator(): string;

        // @overlay-against: function getPrettyString(): mixed
        public function getPrettyString(): string;

        // @overlay-against: function getUpperBound(): mixed
        public function getUpperBound(): \Composer\Semver\Constraint\Bound;

        // @overlay-against: function setPrettyString(mixed $prettyString): mixed
        public function setPrettyString(?string $prettyString): void;
    }

    // @overlay-against: class MatchAllConstraint implements \Composer\Semver\Constraint\ConstraintInterface
    partial class MatchAllConstraint {
        // @overlay-against: function __toString(): mixed
        public function __toString(): string;

        // @overlay-against: function compile(mixed $otherOperator): mixed
        public function compile(int $otherOperator): string;

        // @overlay-against: function getLowerBound(): mixed
        public function getLowerBound(): \Composer\Semver\Constraint\Bound;

        // @overlay-against: function getPrettyString(): mixed
        public function getPrettyString(): string;

        // @overlay-against: function getUpperBound(): mixed
        public function getUpperBound(): \Composer\Semver\Constraint\Bound;

        // @overlay-against: function setPrettyString(mixed $prettyString): mixed
        public function setPrettyString(?string $prettyString): void;
    }

    // @overlay-against: class MatchNoneConstraint implements \Composer\Semver\Constraint\ConstraintInterface
    partial class MatchNoneConstraint {
        // @overlay-against: function __toString(): mixed
        public function __toString(): string;

        // @overlay-against: function compile(mixed $otherOperator): mixed
        public function compile(int $otherOperator): string;

        // @overlay-against: function getLowerBound(): mixed
        public function getLowerBound(): \Composer\Semver\Constraint\Bound;

        // @overlay-against: function getPrettyString(): mixed
        public function getPrettyString(): string;

        // @overlay-against: function getUpperBound(): mixed
        public function getUpperBound(): \Composer\Semver\Constraint\Bound;

        // @overlay-against: function setPrettyString(mixed $prettyString): mixed
        public function setPrettyString(?string $prettyString): void;
    }

    // @overlay-against: class MultiConstraint implements \Composer\Semver\Constraint\ConstraintInterface
    partial class MultiConstraint {
        // @overlay-against: mixed $constraints
        protected array<int, \Composer\Semver\Constraint\ConstraintInterface> $constraints;

        // @overlay-against: function __toString(): mixed
        public function __toString(): string;

        // @overlay-against: function compile(mixed $otherOperator): mixed
        public function compile(int $otherOperator): string;

        // @overlay-against: function getLowerBound(): mixed
        public function getLowerBound(): \Composer\Semver\Constraint\Bound;

        // @overlay-against: function getPrettyString(): mixed
        public function getPrettyString(): string;

        // @overlay-against: function getUpperBound(): mixed
        public function getUpperBound(): \Composer\Semver\Constraint\Bound;

        // @overlay-against: function setPrettyString(mixed $prettyString): mixed
        public function setPrettyString(?string $prettyString): void;
    }
}
