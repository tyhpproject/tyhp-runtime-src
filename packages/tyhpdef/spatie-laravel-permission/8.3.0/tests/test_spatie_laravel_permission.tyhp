<?tyhp

class OverlayHasRolesUser
{
    use \Spatie\Permission\Traits\HasRoles;
}

function test_permission_find_by_name(): \Spatie\Permission\Contracts\Permission
{
    return \Spatie\Permission\Models\Permission::findByName('edit-articles');
}

function test_has_roles_get_role_class(OverlayHasRolesUser $user): string
{
    return $user->getRoleClass();
}

function test_has_roles_has_role(OverlayHasRolesUser $user): bool
{
    return $user->hasRole('admin');
}
