{
  "name": "tyhpdef/behat-behat",
  "description": "Tyhp type definitions for the Composer package behat/behat (3.33.0).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "3.33.0.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/symfony-translation": "@dev",
        "tyhpdef/symfony-config": "@dev",
        "tyhpdef/symfony-dependency-injection": "@dev",
        "tyhpdef/behat-gherkin": "@dev",
        "tyhpdef/symfony-event-dispatcher": "@dev",
        "tyhpdef/nikic-php-parser": "@dev",
        "tyhpdef/psr-event-dispatcher": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "behat/behat": "3.33.0"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/symfony-console": "@dev",
    "tyhpdef/psr-container": "@dev",
    "tyhpdef/symfony-translation": "@dev",
    "tyhpdef/symfony-config": "@dev",
    "tyhpdef/symfony-dependency-injection": "@dev",
    "tyhpdef/behat-gherkin": "@dev",
    "tyhpdef/symfony-event-dispatcher": "@dev",
    "tyhpdef/nikic-php-parser": "@dev",
    "tyhpdef/psr-event-dispatcher": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../psr-container/2.0.2"
    },
    {
      "type": "path",
      "url": "../../behat-gherkin/4.17.0"
    },
    {
      "type": "path",
      "url": "../../nikic-php-parser/5.9.0"
    },
    {
      "type": "path",
      "url": "../../symfony-console/7.4.19"
    },
    {
      "type": "path",
      "url": "../../symfony-translation/7.4.17"
    },
    {
      "type": "path",
      "url": "../../symfony-config/7.4.17"
    },
    {
      "type": "path",
      "url": "../../symfony-dependency-injection/7.4.17"
    },
    {
      "type": "path",
      "url": "../../symfony-event-dispatcher/7.4.17"
    },
    {
      "type": "path",
      "url": "../../psr-event-dispatcher/1.0.0"
    }
  ]
}
