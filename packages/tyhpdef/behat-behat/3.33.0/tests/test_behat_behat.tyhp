<?tyhp

class FeatureContext implements \Behat\Behat\Context\Context
{
}

function test_behat_given_pattern(): ?string
{
    $given = new \Behat\Step\Given('I have a thing');
    return $given->getPattern();
}

function test_behat_when(): \Behat\Step\When
{
    return new \Behat\Step\When('I do a thing');
}

function test_behat_then(): \Behat\Step\Then
{
    return new \Behat\Step\Then('I see a thing');
}

function test_behat_before_scenario_filter(): ?string
{
    $hook = new \Behat\Hook\BeforeScenario('@wip');
    return $hook->getFilterString();
}

function test_behat_transform_pattern(): string
{
    $transform = new \Behat\Transformation\Transform('/user/');
    return $transform->pattern;
}

function test_behat_docstring_content(\Behat\Step\DocString $docString): string
{
    return $docString->getContent();
}
