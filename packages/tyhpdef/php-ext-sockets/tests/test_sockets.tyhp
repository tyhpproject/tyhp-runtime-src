<?tyhp

function test_socket_create_signature(): Socket|false
{
    return socket_create(AF_INET, SOCK_STREAM, SOL_TCP);
}

// `socket_atmark()` is new in PHP 8.3 and is only in scope when compiling for
// `output.phpVersion` >= 8.3 — see tyhp-php8.5.json.
declare(php=">=8.3") {
    function test_socket_atmark(\Socket $socket): bool
    {
        return socket_atmark($socket);
    }
}
