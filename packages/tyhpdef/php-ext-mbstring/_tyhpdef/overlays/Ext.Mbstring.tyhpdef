<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef`  (not under `overlays/stubs/`)
 * Follows TYHPDEF_ORDERING.md.
 * Encoding overloads and array-shape returns. Not Pure (see Pure.Mbstring.tyhpdef).
 * `mb_ereg_*` search APIs are stateful; they are typed here but not marked Pure.
 */

/**
 * Overlay: `mb_ereg_search_pos()` two-element list (byte offset, byte length).
 */
type MbEregSearchPos = struct {
    int 0 as $offset;
    int 1 as $length;
};

/**
 * Overlay: `mb_get_info('all')` settings.
 */
type MbStringInfo = struct {
    string $internal_encoding;
    ?string $http_input;
    string $http_output;
    string $http_output_conv_mimetypes;
    string $mail_charset;
    string $mail_header_encoding;
    string $mail_body_encoding;
    int $illegal_chars;
    string $encoding_translation;
    string $language;
    array<int, string> $detect_order;
    int|string $substitute_character;
    string $strict_detection;
};

// @overlay-against: function mb_convert_encoding(array|string $string, string $to_encoding, array|string|null $from_encoding): array|string|false
function mb_convert_encoding(string $string, string $to_encoding, array<int, string>|string|null $from_encoding = null): string|false;
// @overlay-against: function mb_convert_encoding(array|string $string, string $to_encoding, array|string|null $from_encoding): array|string|false
function mb_convert_encoding<TKey extends int|string>(array<TKey, string> $string, string $to_encoding, array<int, string>|string|null $from_encoding = null): array<TKey, string>|false;

// @overlay-against: function mb_detect_order(array|string|null $encoding): array|bool
function mb_detect_order(null $encoding = null): array<int, string>;
// @overlay-against: function mb_detect_order(array|string|null $encoding): array|bool
function mb_detect_order(array<int, string>|string $encoding): bool;
// @overlay-against: function mb_detect_order(array|string|null $encoding): array|bool
function mb_detect_order(array<int, string>|string|null $encoding = null): array<int, string>|bool;

// @overlay-against: function mb_encoding_aliases(string $encoding): array
function mb_encoding_aliases(string $encoding): array<int, string>;

// @overlay-against: function mb_ereg(string $pattern, string $string, mixed $matches): bool
function mb_ereg(string $pattern, string $string, mixed &$matches = null): bool;
// @overlay-against: function mb_ereg(string $pattern, string $string, mixed $matches): bool
function mb_ereg(string $pattern, string $string, array<int, string> &$matches): bool;

// @overlay-against: function mb_ereg_replace_callback(string $pattern, callable $callback, string $string, ?string $options): string|false|null
function mb_ereg_replace_callback(string $pattern, callable(array<int, string>): string $callback, string $string, ?string $options = null): string|false|null;

// @overlay-against: function mb_ereg_search_getregs(): array|false
function mb_ereg_search_getregs(): array<int, string>|false;

// @overlay-against: function mb_ereg_search_pos(?string $pattern, ?string $options): array|false
function mb_ereg_search_pos(?string $pattern = null, ?string $options = null): MbEregSearchPos|false;

// @overlay-against: function mb_ereg_search_regs(?string $pattern, ?string $options): array|false
function mb_ereg_search_regs(?string $pattern = null, ?string $options = null): array<int, string>|false;

// @overlay-against: function mb_eregi(string $pattern, string $string, mixed $matches): bool
function mb_eregi(string $pattern, string $string, mixed &$matches = null): bool;
// @overlay-against: function mb_eregi(string $pattern, string $string, mixed $matches): bool
function mb_eregi(string $pattern, string $string, array<int, string> &$matches): bool;

// @overlay-against: function mb_get_info(string $type): array|string|int|false|null
function mb_get_info('all' $type = 'all'): MbStringInfo;
// @overlay-against: function mb_get_info(string $type): array|string|int|false|null
function mb_get_info('illegal_chars' $type): int|false;
// @overlay-against: function mb_get_info(string $type): array|string|int|false|null
function mb_get_info('detect_order' $type): array<int, string>|false;
// @overlay-against: function mb_get_info(string $type): array|string|int|false|null
function mb_get_info('http_input' $type): string|null;
// @overlay-against: function mb_get_info(string $type): array|string|int|false|null
function mb_get_info('substitute_character' $type): int|string|false;
// @overlay-against: function mb_get_info(string $type): array|string|int|false|null
function mb_get_info(string $type): array|string|int|false|null;

// @overlay-against: function mb_http_input(?string $type): array|string|false
function mb_http_input(null $type = null): string|false;
// @overlay-against: function mb_http_input(?string $type): array|string|false
function mb_http_input('I' $type): array<int, string>|false;
// @overlay-against: function mb_http_input(?string $type): array|string|false
function mb_http_input('G'|'P'|'C'|'S'|'L' $type): string|false;
// @overlay-against: function mb_http_input(?string $type): array|string|false
function mb_http_input(?string $type = null): array<int, string>|string|false;

// @overlay-against: function mb_send_mail(string $to, string $subject, string $message, array|string $additional_headers, ?string $additional_params): bool
function mb_send_mail(string $to, string $subject, string $message, array<string, string>|string $additional_headers = [], ?string $additional_params = null): bool;

// @overlay-against: function mb_split(string $pattern, string $string, int $limit): array|false
function mb_split(string $pattern, string $string, int $limit = -1): array<int, string>|false;
