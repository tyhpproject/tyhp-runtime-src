<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Follows TYHPDEF_ORDERING.md.
 * Pure mb_* functions. Do not mark impure I/O or stateful regex
 * (mb_send_mail, mb_parse_str, mb_ereg_search, mb_detect_order, …).
 */
// Phase 2.4 minimum set, plus mb_stripos. Additional Pure names use
// `partial function` so Layer 1 / Layer 2 signatures stay.

// @overlay-against: function mb_strlen(string $string, ?string $encoding = null): int
#[\Tyhp\Optimize\Pure]
// @overlay-against: function mb_strlen(string $string, ?string $encoding): int
function mb_strlen(string $string, ?string $encoding = null): int;

// @overlay-against: function mb_strpos(string $haystack, string $needle, int $offset = 0, ?string $encoding = null): int|false
#[\Tyhp\Optimize\Pure]
// @overlay-against: function mb_strpos(string $haystack, string $needle, int $offset, ?string $encoding): int|false
function mb_strpos(string $haystack, string $needle, int $offset = 0, ?string $encoding = null): int|false;

// @overlay-against: function mb_strrpos(string $haystack, string $needle, int $offset = 0, ?string $encoding = null): int|false
#[\Tyhp\Optimize\Pure]
// @overlay-against: function mb_strrpos(string $haystack, string $needle, int $offset, ?string $encoding): int|false
function mb_strrpos(string $haystack, string $needle, int $offset = 0, ?string $encoding = null): int|false;

// @overlay-against: function mb_stripos(string $haystack, string $needle, int $offset = 0, ?string $encoding = null): int|false
#[\Tyhp\Optimize\Pure]
// @overlay-against: function mb_stripos(string $haystack, string $needle, int $offset, ?string $encoding): int|false
function mb_stripos(string $haystack, string $needle, int $offset = 0, ?string $encoding = null): int|false;

// @overlay-against: function mb_substr(string $string, int $start, ?int $length = null, ?string $encoding = null): string
#[\Tyhp\Optimize\Pure]
// @overlay-against: function mb_substr(string $string, int $start, ?int $length, ?string $encoding): string
function mb_substr(string $string, int $start, ?int $length = null, ?string $encoding = null): string;

// @overlay-against: function mb_strtolower(string $string, ?string $encoding = null): string
#[\Tyhp\Optimize\Pure]
// @overlay-against: function mb_strtolower(string $string, ?string $encoding): string
