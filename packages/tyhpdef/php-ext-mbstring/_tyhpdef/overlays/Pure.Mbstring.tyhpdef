function mb_strtoupper(string $string, ?string $encoding = null): string;

// @overlay-against: function mb_str_split(string $string, int $length = 1, ?string $encoding = null): array
#[\Tyhp\Optimize\Pure]
// @overlay-against: function mb_str_split(string $string, int $length, ?string $encoding): array
function mb_str_split(string $string, int $length = 1, ?string $encoding = null): array<int, string>;

// @overlay-against: function mb_convert_case(string $string, int $mode, ?string $encoding = null): string
#[\Tyhp\Optimize\Pure]
// @overlay-against: function mb_convert_case(string $string, int $mode, ?string $encoding): string
function mb_convert_case(string $string, int $mode, ?string $encoding = null): string;

// @overlay-against: function mb_convert_encoding(array|string $string, string $to_encoding, array|string|null $from_encoding = null): array|string|false
#[\Tyhp\Optimize\Pure]
// @overlay-against: function mb_convert_encoding
partial function mb_convert_encoding;

// @overlay-against: function mb_detect_encoding(string $string, array|string|null $encodings = null, bool $strict = false): string|false
#[\Tyhp\Optimize\Pure]
// @overlay-against: function mb_detect_encoding(string $string, array|string|null $encodings, bool $strict): string|false
function mb_detect_encoding(string $string, array<int, string>|string|null $encodings = null, bool $strict = false): string|false;

// @overlay-against: function mb_ord(string $string, ?string $encoding = null): int|false
