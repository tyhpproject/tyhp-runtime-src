{
    "name": "tyhpdef/pestphp-pest-plugin-arch",
    "description": "Tyhp type definitions for the Composer package pestphp/pest-plugin-arch (4.0.2).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "4.0.2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.3",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/pestphp-pest": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "pestphp/pest-plugin-arch": "4.0.2"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/pestphp-pest": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../pestphp-pest/4.7.8"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
