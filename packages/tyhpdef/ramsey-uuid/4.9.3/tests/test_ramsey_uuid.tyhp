<?tyhp

function test_uuid4(): \Ramsey\Uuid\UuidInterface
{
    return \Ramsey\Uuid\Uuid::uuid4();
}

function test_uuid_from_string(): \Ramsey\Uuid\UuidInterface
{
    return \Ramsey\Uuid\Uuid::fromString('6ba7b810-9dad-11d1-80b4-00c04fd430c8');
}

function test_uuid_is_valid(): bool
{
    return \Ramsey\Uuid\Uuid::isValid('6ba7b810-9dad-11d1-80b4-00c04fd430c8');
}

function test_uuid_v4_function(): string
{
    return \Ramsey\Uuid\v4();
}

function test_uuid_to_string(\Ramsey\Uuid\UuidInterface $uuid): string
{
    return $uuid->toString();
}
