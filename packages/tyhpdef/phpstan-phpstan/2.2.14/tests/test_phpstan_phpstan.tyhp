<?tyhp

function test_trinary_yes(): \PHPStan\TrinaryLogic
{
    return \PHPStan\TrinaryLogic::createYes();
}

function test_trinary_from_bool(): bool
{
    return \PHPStan\TrinaryLogic::createFromBoolean(true)->yes();
}

function test_rule_error_builder(): \PHPStan\Rules\RuleError
{
    return \PHPStan\Rules\RuleErrorBuilder::message('not assignable')->identifier('tyhp.test')->build();
}

function test_rule_node_type(\PHPStan\Rules\Rule $rule): string
{
    return $rule->getNodeType();
}

function test_scope_file(\PHPStan\Analyser\Scope $scope): string
{
    return $scope->getFile();
}

function test_type_is_string(\PHPStan\Type\Type $type): \PHPStan\TrinaryLogic
{
    return $type->isString();
}
