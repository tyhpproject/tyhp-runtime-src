<?tyhp

function test_type_info_builtins(): bool
{
    $string = \Symfony\Component\TypeInfo\Type::string();
    return $string->accepts('hello') && $string->isIdentifiedBy(\Symfony\Component\TypeInfo\TypeIdentifier::STRING);
}

function test_type_info_object(): \Symfony\Component\TypeInfo\Type
{
    return \Symfony\Component\TypeInfo\Type::object(\stdClass::class);
}

function test_type_info_from_value(): \Symfony\Component\TypeInfo\Type
{
    return \Symfony\Component\TypeInfo\Type::fromValue(1);
}
