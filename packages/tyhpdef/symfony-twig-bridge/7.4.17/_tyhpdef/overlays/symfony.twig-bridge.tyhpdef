<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 *
 * Omit types whose immediate extends/implements (or constructor) names an
 * unwrapped Twig or AssetMapper peer. App flash bags and enabled-locale lists.
 */

namespace Symfony\Bridge\Twig {
    /**
     * Overlay: enabled locales are a list of locale codes; flash bags narrow on `$types`.
     */
    // @overlay-against: class AppVariable
    partial class AppVariable {
        /**
         * @param array<int|string, string> $enabledLocales
         */
        // @overlay-against: function setEnabledLocales(array $enabledLocales): void
        public function setEnabledLocales(array<int|string, string> $enabledLocales): void;

        /**
         * @return array<int, string>
         */
        // @overlay-against: function getEnabled_locales(): array
        public function getEnabled_locales(): array<int, string>;

        /**
         * Every flash type. `getFlashes()` and an explicit null use this overload.
         *
         * @return array<string, array<int, string>>
         */
        // @overlay-against: function getFlashes(string|array|null $types): array
        public function getFlashes(null $types = null): array<string, array<int, string>>;

        /**
         * Messages for one flash type.
         *
         * @return array<int, string>
         */
        // @overlay-against: function getFlashes(string|array|null $types): array
        public function getFlashes(string $types): array<int, string>;

        /**
         * Messages for each requested flash type.
         *
         * @param array<int|string, string> $types
         * @return array<string, array<int, string>>
         */
        // @overlay-against: function getFlashes(string|array|null $types): array
        public function getFlashes(array<int|string, string> $types): array<string, array<int, string>>;

        /**
         * @param string|array<int|string, string>|null $types
         * @return array<string, array<int, string>>|array<int, string>
         */
        // @overlay-against: function getFlashes(string|array|null $types): array
        public function getFlashes(string|array<int|string, string>|null $types = null): array<string, array<int, string>>|array<int, string>;
    }
}

