namespace Symfony\Bridge\Twig\Attribute {

    /**
     * Overlay: PHPDoc shapes harvest left loose on `Template`.
     */
    // @overlay-against: class Template
    partial class Template {
        /**
         * @param array<string>|null $vars
         */
        // @overlay-against: function __construct(string $template, array|null $vars, bool $stream, ?string $block): void
        public function __construct(string $template, array<string>|null $vars = null, bool $stream = false, ?string $block = null): void;
    }

}


namespace Symfony\Bridge\Twig\Extension {
    /**
     * Overlay: options, context, and config maps are `array<string, mixed>`. Harvest left bare `array`.
     */
    // @overlay-against: class HttpKernelRuntime
    partial class HttpKernelRuntime {
        // @overlay-against: function renderFragment(string|\Symfony\Component\HttpKernel\Controller\ControllerReference $uri, array $options): string
        public function renderFragment(string|\Symfony\Component\HttpKernel\Controller\ControllerReference $uri, array<string, mixed> $options = []): string;
        // @overlay-against: function renderFragmentStrategy(string $strategy, string|\Symfony\Component\HttpKernel\Controller\ControllerReference $uri, array $options): string
        public function renderFragmentStrategy(string $strategy, string|\Symfony\Component\HttpKernel\Controller\ControllerReference $uri, array<string, mixed> $options = []): string;
    }
}
