<?tyhp

function test_locale_language(): string
{
    return \Giggsey\Locale\Locale::getPrimaryLanguage('en-GB');
}

function test_locale_region(): string
{
    return \Giggsey\Locale\Locale::getRegion('de-CH');
}

function test_locale_supported(): array<int|string, string>
{
    return \Giggsey\Locale\Locale::getSupportedLocales();
}
