<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Generic cache item values, keyed item maps, and save helpers.
 */

namespace Psr\Cache {
    /**
     * Overlay: items carry a stored value type (`mixed` when unparameterized).
     */
    // @overlay-against: interface CacheItemInterface
    partial interface CacheItemInterface<TValue = mixed>;

    /**
     * Overlay: `get()` is the stored value or null on miss; `set()` takes `TValue`.
     */
    // @overlay-against: interface CacheItemInterface
    partial interface CacheItemInterface {
        /**
         * @return TValue|null The stored value, or null when `isHit()` is false.
         */
        // @overlay-against: function get(): mixed
        public function get(): TValue|null;

        /**
         * @param TValue $value The serializable value to be stored.
         */
        // @overlay-against: function set(mixed $value): static
        public function set(TValue $value): static;
    }

    /**
     * Overlay: pools produce items of `TValue`.
     */
    // @overlay-against: interface CacheItemPoolInterface
    partial interface CacheItemPoolInterface<TValue = mixed>;

    /**
     * Overlay: `getItems()` is keyed by cache key; save helpers keep `TValue`.
     */
    // @overlay-against: interface CacheItemPoolInterface
    partial interface CacheItemPoolInterface {
        /**
         * @return \Psr\Cache\CacheItemInterface<TValue>
         */
        // @overlay-against: function getItem(string $key): \Psr\Cache\CacheItemInterface
        public function getItem(string $key): \Psr\Cache\CacheItemInterface<TValue>;

        /**
         * @param array<int|string, string> $keys An indexed array of keys of items to retrieve.
         * @return iterable<string, \Psr\Cache\CacheItemInterface<TValue>>
         */
        // @overlay-against: function getItems(array $keys): iterable
        public function getItems(array<int|string, string> $keys = []): iterable<string, \Psr\Cache\CacheItemInterface<TValue>>;

        /**
         * @param array<int|string, string> $keys An array of keys that should be removed from the pool.
         */
        // @overlay-against: function deleteItems(array $keys): bool
        public function deleteItems(array<int|string, string> $keys): bool;

        /**
         * @param \Psr\Cache\CacheItemInterface<TValue> $item The cache item to save.
         */
        // @overlay-against: function save(\Psr\Cache\CacheItemInterface $item): bool
        public function save(\Psr\Cache\CacheItemInterface<TValue> $item): bool;

        /**
         * @param \Psr\Cache\CacheItemInterface<TValue> $item The cache item to save.
         */
        // @overlay-against: function saveDeferred(\Psr\Cache\CacheItemInterface $item): bool
        public function saveDeferred(\Psr\Cache\CacheItemInterface<TValue> $item): bool;
    }
}
