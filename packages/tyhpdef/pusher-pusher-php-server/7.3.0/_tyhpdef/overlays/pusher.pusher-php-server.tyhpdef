<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Constructor options and settings, channel lists, batch events, and
 * `get()` overloads on the `$associative` flag.
 */
namespace Pusher {
    /**
     * Map returned by `getSettings()` after construction.
     */
    type PusherSettings = struct {
        string $app_id;
        string $auth_key;
        string $base_path;
        string $host;
        string $path;
        int $port;
        string $scheme;
        string $secret;
        int $timeout;
    };

    /**
     * Query string passed to `array_implode()`: scalars or lists of strings.
     */
    type PusherQueryValue = string|array<int, string>;

    // @overlay-against: class Pusher implements \Psr\Log\LoggerAwareInterface, \Pusher\PusherInterface, \Psr\Log\LoggerAwareTrait
    partial class Pusher {
        // @overlay-against: function array_implode(string $glue, string $separator, array|string $array): string
        public static function array_implode(string $glue, string $separator, array<int|string, \Pusher\PusherQueryValue>|string $array): string;

        // @overlay-against: function __construct(string $auth_key, string $secret, string $app_id, array $options, ?\GuzzleHttp\ClientInterface $client): void
        public function __construct(string $auth_key, string $secret, string $app_id, array<string, mixed> $options = [], ?\GuzzleHttp\ClientInterface $client = null);

        /**
         * Overlay: `$associative = true` decodes the body as an array.
         */
        // @overlay-against: function get(string $path, array $params, bool $associative): mixed
        public function get(string $path, array<string, mixed> $params, true $associative): array<int|string, mixed>;

        /**
         * Overlay: `$associative = false` (the default) decodes the body as an object.
         */
        // @overlay-against: function get(string $path, array $params, bool $associative): mixed
        public function get(string $path, array<string, mixed> $params = [], false $associative = false): object;

        /**
         * Overlay: runtime `bool $associative` is either decode.
         */
        // @overlay-against: function get(string $path, array $params, bool $associative): mixed
        public function get(string $path, array<string, mixed> $params = [], bool $associative = false): array<int|string, mixed>|object;

        // @overlay-against: function getSettings(): array
        public function getSettings(): \Pusher\PusherSettings;

        // @overlay-against: function post(string $path, mixed $body, array $params): mixed
        public function post(string $path, string $body, array<string, mixed> $params = []): mixed;

        // @overlay-against: function trigger(array|string $channels, string $event, mixed $data, array $params, bool $already_encoded): object
        public function trigger(array<int, string>|string $channels, string $event, mixed $data, array<string, mixed> $params = [], bool $already_encoded = false): object;

        // @overlay-against: function triggerAsync(array|string $channels, string $event, mixed $data, array $params, bool $already_encoded): \GuzzleHttp\Promise\PromiseInterface
        public function triggerAsync(array<int, string>|string $channels, string $event, mixed $data, array<string, mixed> $params = [], bool $already_encoded = false): \GuzzleHttp\Promise\PromiseInterface;

        // @overlay-against: function triggerBatch(array $batch, bool $already_encoded): object
        public function triggerBatch(array<int, array<string, mixed>> $batch = [], bool $already_encoded = false): object;

        // @overlay-against: function triggerBatchAsync(array $batch, bool $already_encoded): \GuzzleHttp\Promise\PromiseInterface
        public function triggerBatchAsync(array<int, array<string, mixed>> $batch = [], bool $already_encoded = false): \GuzzleHttp\Promise\PromiseInterface;

        // @overlay-against: function webhook(array $headers, string $body): \Pusher\Webhook
        public function webhook(array<string, string> $headers, string $body): \Pusher\Webhook;
    }

    // @overlay-against: class PusherCrypto
    partial class PusherCrypto {
        // @overlay-against: function has_mixed_channels(array $channels): bool
        public static function has_mixed_channels(array<int, string> $channels): bool;
    }

    // @overlay-against: interface PusherInterface
    partial interface PusherInterface {
        // @overlay-against: function get(string $path, array $params, bool $associative): mixed
        public function get(string $path, array<string, mixed> $params, true $associative): array<int|string, mixed>;

        // @overlay-against: function get(string $path, array $params, bool $associative): mixed
        public function get(string $path, array<string, mixed> $params = [], false $associative = false): object;

        // @overlay-against: function get(string $path, array $params, bool $associative): mixed
        public function get(string $path, array<string, mixed> $params = [], bool $associative = false): array<int|string, mixed>|object;

        // @overlay-against: function getSettings(): array
        public function getSettings(): \Pusher\PusherSettings;

        // @overlay-against: function trigger(array|string $channels, string $event, mixed $data, array $params, bool $already_encoded): object
        public function trigger(array<int, string>|string $channels, string $event, mixed $data, array<string, mixed> $params = [], bool $already_encoded = false): object;

        // @overlay-against: function triggerAsync(array|string $channels, string $event, mixed $data, array $params, bool $already_encoded): \GuzzleHttp\Promise\PromiseInterface
        public function triggerAsync(array<int, string>|string $channels, string $event, mixed $data, array<string, mixed> $params = [], bool $already_encoded = false): \GuzzleHttp\Promise\PromiseInterface;

        // @overlay-against: function triggerBatch(array $batch, bool $already_encoded): object
        public function triggerBatch(array<int, array<string, mixed>> $batch = [], bool $already_encoded = false): object;

        // @overlay-against: function triggerBatchAsync(array $batch, bool $already_encoded): \GuzzleHttp\Promise\PromiseInterface
        public function triggerBatchAsync(array<int, array<string, mixed>> $batch = [], bool $already_encoded = false): \GuzzleHttp\Promise\PromiseInterface;

        // @overlay-against: function webhook(array $headers, string $body): \Pusher\Webhook
        public function webhook(array<string, string> $headers, string $body): \Pusher\Webhook;
    }

    // @overlay-against: class Webhook
    partial class Webhook {
        // @overlay-against: function __construct(mixed $time_ms, mixed $events): void
        public function __construct(int $time_ms, array<int, object> $events): void;

        // @overlay-against: function get_events(): array
        public function get_events(): array<int, object>;
    }
}
