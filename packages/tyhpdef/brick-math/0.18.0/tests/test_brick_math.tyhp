<?tyhp

function test_brick_018_big_integer(): \Brick\Math\BigInteger
{
    return \Brick\Math\BigInteger::of(10)->plus(2);
}

function test_brick_018_big_decimal(): \Brick\Math\BigDecimal
{
    return \Brick\Math\BigDecimal::of('1.50')->plus(\Brick\Math\BigDecimal::one());
}

function test_brick_018_to_int(\Brick\Math\BigInteger $n): int
{
    return $n->toInt();
}

function test_brick_018_rounding_mode(): \Brick\Math\RoundingMode
{
    return \Brick\Math\RoundingMode::HalfUp;
}
