<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under `overlays/stubs/`).
 *
 * PHPUnit constraint subclasses and `Assert` were omitted at harvest because
 * they extend suggest-peer PHPUnit types. `RunsInParallel` names ParaTest
 * Options types the paratest wrapper does not declare. `InvalidArgumentException`
 * extends `\PHPUnit\Framework\Exception`, which the PHPUnit wrapper does not
 * declare.
 */

namespace Illuminate\Testing {
    /**
     * A decoded JSON document.
     */
    type JsonDocument = array<int|string, mixed>;

    /**
     * Validation keys, or a map of key to expected message text.
     */
    type ValidationErrors = array<int, string>|array<string, string|array<int, string>|bool>;

    /**
     * Overlay: JSON assertion payloads are decoded documents.
     */
    // @overlay-against: class AssertableJsonString implements \ArrayAccess, \Countable
    partial class AssertableJsonString {
        // @overlay-against: function assertExact(array $data): static
        public function assertExact(array<int|string, mixed> $data): static;
        // @overlay-against: function assertFragment(array $data): static
        public function assertFragment(array<int|string, mixed> $data): static;
        // @overlay-against: function assertMissing(array $data, bool $exact): static
        public function assertMissing(array<int|string, mixed> $data, bool $exact = false): static;
        // @overlay-against: function assertMissingExact(array $data): static
        public function assertMissingExact(array<int|string, mixed> $data): static;
        // @overlay-against: function assertSimilar(array $data): static
        public function assertSimilar(array<int|string, mixed> $data): static;
        // @overlay-against: function assertStructure(array|null $structure, array|null $responseData, bool $exact): static
        public function assertStructure(array<int|string, mixed>|null $structure = null, JsonDocument|null $responseData = null, bool $exact = false): static;
        // @overlay-against: function assertSubset(array $data, bool $strict): static
        public function assertSubset(array<int|string, mixed> $data, bool $strict = false): static;
        // @overlay-against: function json(string|null $key): mixed
        public function json(null $key = null): array<int|string, mixed>;
        // @overlay-against: function json(string|null $key): mixed
        public function json(string $key): mixed;
    }

    /**
     * Overlay: parallel callbacks receive the process token. Test case callbacks also receive the case.
     */
    // @overlay-against: class ParallelTesting
    partial class ParallelTesting {
        // @overlay-against: function resolveOptionsUsing(\Closure|null $resolver): void
        public function resolveOptionsUsing((\Closure<callable(string $option): mixed>)|null $resolver): void;
        // @overlay-against: function resolveTokenUsing(\Closure|null $resolver): void
        public function resolveTokenUsing((\Closure<callable(): string|false>)|null $resolver): void;
        // @overlay-against: function setUpProcess(callable $callback): void
        public function setUpProcess(callable(string|false $token): mixed $callback): void;
        // @overlay-against: function setUpTestCase(callable $callback): void
        public function setUpTestCase(callable(mixed $testCase, string|false $token): mixed $callback): void;
        // @overlay-against: function setUpTestDatabase(callable $callback): void
        public function setUpTestDatabase(callable(string $database, string|false $token): mixed $callback): void;
        // @overlay-against: function setUpTestDatabaseBeforeMigrating(callable $callback): void
        public function setUpTestDatabaseBeforeMigrating(callable(string $database, string|false $token): mixed $callback): void;
        // @overlay-against: function tearDownProcess(callable $callback): void
        public function tearDownProcess(callable(string|false $token): mixed $callback): void;
        // @overlay-against: function tearDownTestCase(callable $callback): void
        public function tearDownTestCase(callable(mixed $testCase, string|false $token): mixed $callback): void;
    }

    /**
     * Overlay: ordered text search is a list of strings.
     */
    // @overlay-against: class TestComponent implements \Stringable, \Illuminate\Support\Traits\Macroable
    partial class TestComponent {
        // @overlay-against: function assertSeeInOrder(array $values, bool $escape): static
        public function assertSeeInOrder(array<int, string> $values, bool $escape = true): static;
    }

    // @overlay-against: class TestResponse implements \ArrayAccess, \Illuminate\Testing\Concerns\AssertsStatusCodes, \Illuminate\Support\Traits\Conditionable, \Illuminate\Support\Traits\Dumpable, \Illuminate\Support\Traits\Tappable, \Illuminate\Support\Traits\Macroable
    partial class TestResponse<TResponse extends \Symfony\Component\HttpFoundation\Response = \Symfony\Component\HttpFoundation\Response> implements \ArrayAccess;
    // @overlay-against: class TestResponse implements \ArrayAccess, \Illuminate\Testing\Concerns\AssertsStatusCodes, \Illuminate\Support\Traits\Conditionable, \Illuminate\Support\Traits\Dumpable, \Illuminate\Support\Traits\Tappable, \Illuminate\Support\Traits\Macroable
    partial class TestResponse {
        // Harvest rewrote the method template bound as the missing name
        // `\Illuminate\Testing\TResponse` instead of the class type parameter.
        // @overlay-against: function fromBaseResponse(R $response, \Illuminate\Http\Request|null $request): static
        public static function fromBaseResponse<R extends TResponse>(R $response, \Illuminate\Http\Request|null $request = null): static<R>;
        // @overlay-against: function assertExactJson(array $data): static
        public function assertExactJson(JsonDocument $data): static;
        // @overlay-against: function assertExactJsonStructure(array|null $structure, array|null $responseData): static
        public function assertExactJsonStructure(array<int|string, mixed>|null $structure = null, JsonDocument|null $responseData = null): static;
        // @overlay-against: function assertInvalid(string|array|null $errors, string $errorBag, string $responseKey): static
        public function assertInvalid(string|ValidationErrors|null $errors = null, string $errorBag = 'default', string $responseKey = 'errors'): static;
        // @overlay-against: function assertJson(array|callable $value, bool $strict): static
        public function assertJson(JsonDocument|(callable(\Illuminate\Testing\Fluent\AssertableJson): mixed) $value, bool $strict = false): static;
        // @overlay-against: function assertJsonFragment(array $data): static
        public function assertJsonFragment(JsonDocument $data): static;
        // @overlay-against: function assertJsonFragments(array $data): static
        public function assertJsonFragments(array<int, JsonDocument> $data): static;
        // @overlay-against: function assertJsonMissing(array $data, bool $exact): static
        public function assertJsonMissing(JsonDocument $data, bool $exact = false): static;
        // @overlay-against: function assertJsonMissingExact(array $data): static
        public function assertJsonMissingExact(JsonDocument $data): static;
        // @overlay-against: function assertJsonMissingPaths(array $paths): static
        public function assertJsonMissingPaths(array<int, string> $paths): static;
        // @overlay-against: function assertJsonMissingValidationErrors(string|array|null $keys, string $responseKey): static
        public function assertJsonMissingValidationErrors(string|array<int, string>|null $keys = null, string $responseKey = 'errors'): static;
        // @overlay-against: function assertJsonPathCanonicalizing(string $path, array $expect): static
        public function assertJsonPathCanonicalizing(string $path, JsonDocument $expect): static;
        // @overlay-against: function assertJsonPaths(array $paths): static
        public function assertJsonPaths(array<string, mixed> $paths): static;
        // @overlay-against: function assertJsonPathsCanonicalizing(array $paths): static
        public function assertJsonPathsCanonicalizing(array<string, JsonDocument> $paths): static;
        // @overlay-against: function assertJsonStructure(array|null $structure, array|null $responseData): static
        public function assertJsonStructure(array<int|string, mixed>|null $structure = null, JsonDocument|null $responseData = null): static;
        // @overlay-against: function assertJsonValidationErrors(string|array $errors, string $responseKey): static
        public function assertJsonValidationErrors(string|ValidationErrors $errors, string $responseKey = 'errors'): static;
        // @overlay-against: function assertOnlyInvalid(string|array|null $errors, string $errorBag, string $responseKey): static
        public function assertOnlyInvalid(string|ValidationErrors|null $errors = null, string $errorBag = 'default', string $responseKey = 'errors'): static;
        // @overlay-against: function assertOnlyJsonValidationErrors(string|array $errors, string $responseKey): static
        public function assertOnlyJsonValidationErrors(string|ValidationErrors $errors, string $responseKey = 'errors'): static;
        // @overlay-against: function assertRedirectBackWithErrors(string|array $keys, mixed $format, string $errorBag): static
        public function assertRedirectBackWithErrors(string|ValidationErrors $keys = [], mixed $format = null, string $errorBag = 'default'): static;
        // @overlay-against: function assertRedirectToAction(string|array $name, array $parameters): static
        public function assertRedirectToAction(string|(struct { __ClassName 0 as $controller; string 1 as $method; }) $name, array<int|string, mixed> $parameters = []): static;
        // @overlay-against: function assertSessionDoesntHaveErrors(string|array $keys, string|null $format, string $errorBag): static
        public function assertSessionDoesntHaveErrors(string|ValidationErrors $keys = [], string|null $format = null, string $errorBag = 'default'): static;
        // @overlay-against: function assertSessionHasAll(array $bindings): static
        public function assertSessionHasAll(array<int, string>|array<string, mixed> $bindings): static;
        // @overlay-against: function assertSessionHasErrors(string|array $keys, mixed $format, string $errorBag): static
        public function assertSessionHasErrors(string|ValidationErrors $keys = [], mixed $format = null, string $errorBag = 'default'): static;
        // @overlay-against: function assertSessionHasErrorsIn(string $errorBag, string|array $keys, mixed $format): static
        public function assertSessionHasErrorsIn(string $errorBag, string|ValidationErrors $keys = [], mixed $format = null): static;
        // @overlay-against: function assertSimilarJson(array $data): static
        public function assertSimilarJson(JsonDocument $data): static;
        // @overlay-against: function assertStreamedJsonContent(array $value): static
        public function assertStreamedJsonContent(JsonDocument $value): static;
        // @overlay-against: function assertValid(string|array|null $keys, string $errorBag, string $responseKey): static
        public function assertValid(string|array<int, string>|null $keys = null, string $errorBag = 'default', string $responseKey = 'errors'): static;
        // @overlay-against: function assertViewHasAll(array $bindings): static
        public function assertViewHasAll(array<int, string>|array<string, mixed> $bindings): static;
    }

    /**
     * Overlay: view bindings are a list of names or a name-to-value map.
     */
    // @overlay-against: class TestView implements \Stringable, \Illuminate\Support\Traits\Macroable
    partial class TestView {
        // @overlay-against: function assertViewHasAll(array $bindings): static
        public function assertViewHasAll(array<int, string>|array<string, mixed> $bindings): static;
    }
}

namespace Illuminate\Testing\Concerns {
    // @overlay-against: trait RunsInParallel
    omit trait RunsInParallel {
    }
}

namespace Illuminate\Testing\Exceptions {
    // @overlay-against: class InvalidArgumentException extends \PHPUnit\Framework\Exception
    omit class InvalidArgumentException {
    }
}

namespace Illuminate\Testing {
    /**
     * Overlay: PHPDoc shapes, class-strings, and conditionals harvest left loose.
     */
    // @overlay-against: class PendingCommand implements \Illuminate\Support\Traits\Conditionable, \Illuminate\Support\Traits\Macroable, \Illuminate\Support\Traits\Tappable
    partial class PendingCommand {
        // @overlay-against: function expectsPromptsTable(array|\Illuminate\Support\Collection $headers, array|\Illuminate\Support\Collection|null $rows): static
        public function expectsPromptsTable(array<int, string|array<int, string>>|Collection<int, string|array<int, string>> $headers, array<int, array<int, string>>|Collection<int, array<int, string>>|null $rows): static;
    }
}
