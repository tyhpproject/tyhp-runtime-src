<?tyhp

function test_promise_resolve(): \React\Promise\PromiseInterface<int>
{
    int $n = 1;
    return \React\Promise\resolve($n);
}

function test_promise_reject(): \React\Promise\PromiseInterface<never>
{
    return \React\Promise\reject(new \RuntimeException('no'));
}

function test_promise_then(\React\Promise\PromiseInterface<int> $p): \React\Promise\PromiseInterface<string>
{
    return $p->then(static fn (int $n): string => (string) $n);
}
