<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Combinators keep `T`. `then()` overloads follow which handlers are passed.
 * Callbacks may return a value or a promise of that value.
 */

namespace React\Promise {
    /**
     * Previous unhandled-rejection callback. `null` is the default handler.
     */
    type RejectionHandler = callable(\Throwable): void;

    /**
     * Resolver or canceller invoked with `resolve` and `reject`.
     */
    type PromiseSettler<T> = callable(callable(T): void, callable(\Throwable): void): void;

    /**
     * Overlay: `all()` resolves to the item map, keys preserved.
     */
    // @overlay-against: function all(iterable $promisesOrValues): \React\Promise\PromiseInterface
    function all<T>(iterable<\React\Promise\PromiseInterface<T>|T> $promisesOrValues): \React\Promise\PromiseInterface<array<int|string, T>>;

    /**
     * Overlay: `any()` fulfills with the first resolved item.
     */
    // @overlay-against: function any(iterable $promisesOrValues): \React\Promise\PromiseInterface
    function any<T>(iterable<\React\Promise\PromiseInterface<T>|T> $promisesOrValues): \React\Promise\PromiseInterface<T>;

    /**
     * Overlay: `race()` settles like the first settled item.
     */
    // @overlay-against: function race(iterable $promisesOrValues): \React\Promise\PromiseInterface
    function race<T>(iterable<\React\Promise\PromiseInterface<T>|T> $promisesOrValues): \React\Promise\PromiseInterface<T>;

    /**
     * Overlay: `resolve()` returns `PromiseInterface<T>`.
     */
    // @overlay-against: function resolve(\React\Promise\PromiseInterface|T $promiseOrValue): \React\Promise\PromiseInterface
    function resolve<T>(\React\Promise\PromiseInterface<T>|T $promiseOrValue): \React\Promise\PromiseInterface<T>;

    /**
     * Overlay: `reject()` never fulfills, so the fulfillment type is `never`.
     */
    // @overlay-against: function reject(\Throwable $reason): \React\Promise\PromiseInterface
    function reject(\Throwable $reason): \React\Promise\PromiseInterface<never>;

    /**
     * Overlay: rejection handler is `callable(\Throwable): void`, or null for the default.
     */
    // @overlay-against: function set_rejection_handler(callable $callback): callable
    function set_rejection_handler(?\React\Promise\RejectionHandler $callback): ?\React\Promise\RejectionHandler;

    /**
     * Overlay: `promise()` is `PromiseInterface<T>`; canceller is a settler.
     */
    // @overlay-against: class Deferred
    partial class Deferred {
        // @overlay-against: function __construct(callable|null $canceller): void
        public function __construct(?\React\Promise\PromiseSettler<T> $canceller = null): void;

        // @overlay-against: function promise(): \React\Promise\PromiseInterface
        public function promise(): \React\Promise\PromiseInterface<T>;
    }

    /**
     * Overlay: constructor settler, and the same callback shapes as `PromiseInterface`.
     */
    // @overlay-against: class Promise implements \React\Promise\PromiseInterface
    partial class Promise {
        // @overlay-against: function __construct(callable $resolver, callable|null $canceller): void
        public function __construct(\React\Promise\PromiseSettler<T> $resolver, ?\React\Promise\PromiseSettler<T> $canceller = null): void;

        /**
         * @deprecated 3.0.0 Use `finally()` instead
         */
        // @overlay-against: function always(callable $onFulfilledOrRejected): \React\Promise\PromiseInterface
        deprecated public function always(callable(): (void|\React\Promise\PromiseInterface<void>) $onFulfilledOrRejected): \React\Promise\PromiseInterface<T>;

        // @overlay-against: function catch(callable $onRejected): \React\Promise\PromiseInterface
        public function catch<TThrowable extends \Throwable, TRejected>(callable(TThrowable): (\React\Promise\PromiseInterface<TRejected>|TRejected) $onRejected): \React\Promise\PromiseInterface<T|TRejected>;

        // @overlay-against: function finally(callable $onFulfilledOrRejected): \React\Promise\PromiseInterface
        public function finally(callable(): (void|\React\Promise\PromiseInterface<void>) $onFulfilledOrRejected): \React\Promise\PromiseInterface<T>;

        /**
         * @deprecated 3.0.0 Use `catch()` instead
         */
        // @overlay-against: function otherwise(callable $onRejected): \React\Promise\PromiseInterface
        deprecated public function otherwise<TThrowable extends \Throwable, TRejected>(callable(TThrowable): (\React\Promise\PromiseInterface<TRejected>|TRejected) $onRejected): \React\Promise\PromiseInterface<T|TRejected>;

        /**
         * No handlers: the promise keeps `T`.
         */
        // @overlay-against: function then(?callable $onFulfilled, ?callable $onRejected): \React\Promise\PromiseInterface
        public function then(null $onFulfilled = null, null $onRejected = null): \React\Promise\PromiseInterface<T>;

        /**
         * `$onFulfilled` only. The callback may return `TFulfilled` or a promise of it.
         */
        // @overlay-against: function then(?callable $onFulfilled, ?callable $onRejected): \React\Promise\PromiseInterface
        public function then<TFulfilled>(?(callable(T): (\React\Promise\PromiseInterface<TFulfilled>|TFulfilled)) $onFulfilled, null $onRejected = null): \React\Promise\PromiseInterface<TFulfilled>;

        /**
         * `$onRejected` only. The result is the original value or `TRejected`.
         */
        // @overlay-against: function then(?callable $onFulfilled, ?callable $onRejected): \React\Promise\PromiseInterface
        public function then<TRejected>(null $onFulfilled, callable(\Throwable): (\React\Promise\PromiseInterface<TRejected>|TRejected) $onRejected): \React\Promise\PromiseInterface<T|TRejected>;

        /**
         * Both handlers. Either callback may return a promise.
         */
        // @overlay-against: function then(?callable $onFulfilled, ?callable $onRejected): \React\Promise\PromiseInterface
        public function then<TFulfilled, TRejected>(callable(T): (\React\Promise\PromiseInterface<TFulfilled>|TFulfilled) $onFulfilled, callable(\Throwable): (\React\Promise\PromiseInterface<TRejected>|TRejected) $onRejected): \React\Promise\PromiseInterface<TFulfilled|TRejected>;
    }

    /**
     * Overlay: `then()` / `catch()` / `finally()` callback shapes and result types.
     */
    // @overlay-against: interface PromiseInterface
    partial interface PromiseInterface {
        /**
         * @deprecated 3.0.0 Use `finally()` instead
         */
        // @overlay-against: function always(callable $onFulfilledOrRejected): \React\Promise\PromiseInterface
        deprecated public function always(callable(): (void|\React\Promise\PromiseInterface<void>) $onFulfilledOrRejected): \React\Promise\PromiseInterface<T>;

        // @overlay-against: function catch(callable $onRejected): \React\Promise\PromiseInterface
        public function catch<TThrowable extends \Throwable, TRejected>(callable(TThrowable): (\React\Promise\PromiseInterface<TRejected>|TRejected) $onRejected): \React\Promise\PromiseInterface<T|TRejected>;

        // @overlay-against: function finally(callable $onFulfilledOrRejected): \React\Promise\PromiseInterface
        public function finally(callable(): (void|\React\Promise\PromiseInterface<void>) $onFulfilledOrRejected): \React\Promise\PromiseInterface<T>;

        /**
         * @deprecated 3.0.0 Use `catch()` instead
         */
        // @overlay-against: function otherwise(callable $onRejected): \React\Promise\PromiseInterface
        deprecated public function otherwise<TThrowable extends \Throwable, TRejected>(callable(TThrowable): (\React\Promise\PromiseInterface<TRejected>|TRejected) $onRejected): \React\Promise\PromiseInterface<T|TRejected>;

        /**
         * No handlers: the promise keeps `T`.
         */
        // @overlay-against: function then(?callable $onFulfilled, ?callable $onRejected): \React\Promise\PromiseInterface
        public function then(null $onFulfilled = null, null $onRejected = null): \React\Promise\PromiseInterface<T>;

        /**
         * `$onFulfilled` only. The callback may return `TFulfilled` or a promise of it.
         */
        // @overlay-against: function then(?callable $onFulfilled, ?callable $onRejected): \React\Promise\PromiseInterface
        public function then<TFulfilled>(?(callable(T): (\React\Promise\PromiseInterface<TFulfilled>|TFulfilled)) $onFulfilled, null $onRejected = null): \React\Promise\PromiseInterface<TFulfilled>;

        /**
         * `$onRejected` only. The result is the original value or `TRejected`.
         */
        // @overlay-against: function then(?callable $onFulfilled, ?callable $onRejected): \React\Promise\PromiseInterface
        public function then<TRejected>(null $onFulfilled, callable(\Throwable): (\React\Promise\PromiseInterface<TRejected>|TRejected) $onRejected): \React\Promise\PromiseInterface<T|TRejected>;

        /**
         * Both handlers. Either callback may return a promise.
         */
        // @overlay-against: function then(?callable $onFulfilled, ?callable $onRejected): \React\Promise\PromiseInterface
        public function then<TFulfilled, TRejected>(callable(T): (\React\Promise\PromiseInterface<TFulfilled>|TFulfilled) $onFulfilled, callable(\Throwable): (\React\Promise\PromiseInterface<TRejected>|TRejected) $onRejected): \React\Promise\PromiseInterface<TFulfilled|TRejected>;
    }
}
