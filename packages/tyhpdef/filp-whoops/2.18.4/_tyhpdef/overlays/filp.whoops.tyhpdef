namespace Whoops\Exception {
    type FrameComment = struct {
        string $comment;
        string $context;
    };

    /**
     * Overlay: application-frame flags are bool.
     */
    // @overlay-against: class Frame implements \Serializable
    partial class Frame {
        /**
         * @return bool
         */
        // @overlay-against: function isApplication(): boolean
        public function isApplication(): bool;

        /**
         * @param bool $application
         */
        // @overlay-against: function setApplication(boolean $application): mixed
        public function setApplication(bool $application): mixed;

        // @overlay-against: function __construct(array $frame): void
        public function __construct(array<string, mixed> $frame): void;

        // @overlay-against: function getArgs(): array
        public function getArgs(): array<int|string, mixed>;

        // @overlay-against: function getComments(string $filter): array
        public function getComments(?string $filter = null): array<int, FrameComment>;

        // @overlay-against: function getRawFrame(): array
        public function getRawFrame(): array<string, mixed>;
    }

    // @overlay-against: class FrameCollection implements \ArrayAccess, \IteratorAggregate, \Serializable, \Countable
    partial class FrameCollection {
        // @overlay-against: function __construct(array $frames): void
        public function __construct(array<int|string, array<string, mixed>> $frames): void;

        // @overlay-against: function __unserialize(array $serializedFrames): mixed
        public function __unserialize(array<int|string, \Whoops\Exception\Frame> $serializedFrames): mixed;

        // @overlay-against: function filter(callable $callable): \Whoops\Exception\FrameCollection
        public function filter(callable(\Whoops\Exception\Frame): bool $callable): \Whoops\Exception\FrameCollection;

        // @overlay-against: function getArray(): array
        public function getArray(): array<int|string, \Whoops\Exception\Frame>;

        // @overlay-against: function map(callable $callable): \Whoops\Exception\FrameCollection
        public function map(callable(\Whoops\Exception\Frame): \Whoops\Exception\Frame $callable): \Whoops\Exception\FrameCollection;
    }
}

namespace Whoops\Handler {
    /**
     * Overlay: trace-arg limits are int, not PHPDoc `integer`.
     */
    // @overlay-against: class PlainTextHandler extends \Whoops\Handler\Handler
    partial class PlainTextHandler {
        /**
         * @param bool|int|null $addTraceFunctionArgsToOutput
         */
        // @overlay-against: function addTraceFunctionArgsToOutput(bool|integer|null $addTraceFunctionArgsToOutput): static|bool|integer
        public function addTraceFunctionArgsToOutput(bool|int|null $addTraceFunctionArgsToOutput = null): static|bool|int;

        /**
         * @return int
         */
        // @overlay-against: function getTraceFunctionArgsOutputLimit(): integer
        public function getTraceFunctionArgsOutputLimit(): int;
    }

    // @overlay-against: class PrettyPageHandler extends \Whoops\Handler\Handler
    partial class PrettyPageHandler {
        // @overlay-against: function addDataTable(string $label, array $data): static
        public function addDataTable(string $label, array<string, mixed> $data): static;

        // @overlay-against: function getApplicationPaths(): array
        public function getApplicationPaths(): array<int, string>;

        // @overlay-against: function getResourcePaths(): array
        public function getResourcePaths(): array<int, string>;

        // @overlay-against: function setApplicationPaths(array $applicationPaths): void
        public function setApplicationPaths(array<int, string> $applicationPaths): void;
    }
}

namespace Whoops {
    type SilencedPath = struct {
        int $levels;
        string $pattern;
    };

    /**
     * Overlay: handlers is a list of handler instances.
     */
    // @overlay-against: class Run implements \Whoops\RunInterface
    partial class Run {
        /**
         * @return array<int, \Whoops\Handler\HandlerInterface>
         */
        // @overlay-against: function getHandlers(): array
        public function getHandlers(): array<int, \Whoops\Handler\HandlerInterface>;

        // @overlay-against: function addFrameFilter(mixed $filterCallback): mixed
        public function addFrameFilter(callable(\Whoops\Exception\Frame): bool $filterCallback): \Whoops\Run;

        // @overlay-against: function clearFrameFilters(): mixed
        public function clearFrameFilters(): \Whoops\Run;

        // @overlay-against: function getFrameFilters(): mixed
        public function getFrameFilters(): array<int, callable(\Whoops\Exception\Frame): bool>;

        // @overlay-against: function getSilenceErrorsInPaths(): array
        public function getSilenceErrorsInPaths(): array<int, SilencedPath>;

        // @overlay-against: function silenceErrorsInPaths(array|string $patterns, int $levels): \Whoops\Run
        public function silenceErrorsInPaths(array<int, string>|string $patterns, int $levels = 10240): \Whoops\Run;
    }

    /**
     * The interface stores the same handler list as `Run`.
     */
    // @overlay-against: interface RunInterface
    partial interface RunInterface {
        // @overlay-against: function getHandlers(): array
        public function getHandlers(): array<int, \Whoops\Handler\HandlerInterface>;

        // @overlay-against: function getFrameFilters(): array
        public function getFrameFilters(): array<int, callable(\Whoops\Exception\Frame): bool>;
    }
}

