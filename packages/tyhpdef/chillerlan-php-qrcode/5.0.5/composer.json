{
  "name": "tyhpdef/chillerlan-php-qrcode",
  "description": "Tyhp type definitions for the Composer package chillerlan/php-qrcode (5.0.5).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "5.0.5.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/php-ext-gd": "@dev",
        "tyhpdef/php-ext-imagick": "@dev",
        "tyhpdef/chillerlan-php-settings-container": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "chillerlan/php-qrcode": "5.0.5"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/php-ext-gd": "@dev",
    "tyhpdef/php-ext-imagick": "@dev",
    "tyhpdef/chillerlan-php-settings-container": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../php-ext-gd"
    },
    {
      "type": "path",
      "url": "../../php-ext-imagick"
    },
    {
      "type": "path",
      "url": "../../chillerlan-php-settings-container/3.3.0"
    }
  ]
}
