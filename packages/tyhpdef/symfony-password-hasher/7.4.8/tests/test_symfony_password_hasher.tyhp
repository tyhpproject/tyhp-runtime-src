<?tyhp

function test_password_hasher_hash(): string
{
    $hasher = new \Symfony\Component\PasswordHasher\Hasher\NativePasswordHasher();
    return $hasher->hash('secret');
}

function test_password_hasher_verify(\Symfony\Component\PasswordHasher\PasswordHasherInterface $hasher): bool
{
    $hash = $hasher->hash('secret');
    return $hasher->verify($hash, 'secret');
}

function test_password_hasher_factory(): \Symfony\Component\PasswordHasher\PasswordHasherInterface
{
    $factory = new \Symfony\Component\PasswordHasher\Hasher\PasswordHasherFactory([
        'auto' => ['algorithm' => 'auto'],
    ]);
    return $factory->getPasswordHasher('auto');
}
