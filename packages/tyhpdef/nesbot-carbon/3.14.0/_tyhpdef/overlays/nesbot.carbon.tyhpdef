<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Internal Carbon bases are named by Layer 1 but not harvested. The optional
 * PHPStan peer is declared here. `\Illuminate\Support\ServiceProvider` comes
 * from tyhpdef/illuminate-support.
 */

namespace Carbon {
    /**
     * `CarbonInterface::toArray()` / `Traits\Converter::toArray()`.
     */
    type CarbonArray = struct {
        int $year;
        int $month;
        int $day;
        int $dayOfWeek;
        int $dayOfYear;
        int $hour;
        int $minute;
        int $second;
        int $micro;
        int|float|string $timestamp;
        string $formatted;
        \Carbon\CarbonTimeZone $timezone;
    };

    /**
     * `getCalendarFormats()` locale patterns.
     */
    type CarbonCalendarFormats = struct {
        string $sameDay;
        string $nextDay;
        string $nextWeek;
        string $lastDay;
        string $lastWeek;
        string $sameElse;
    };

    /**
     * `getIsoFormats()` locale patterns.
     */
    type CarbonIsoFormats = struct {
        string 'LT' as $time;
        string 'LTS' as $timeWithSeconds;
        string 'L' as $date;
        string 'LL' as $dateMedium;
        string 'LLL' as $dateTime;
        string 'LLLL' as $dateTimeFull;
        string 'l' as $dateShort;
        string 'll' as $dateShortMedium;
        string 'lll' as $dateTimeShort;
        string 'llll' as $dateTimeFullShort;
    };

    /**
     * Overlay: locale file lists are string lists.
     */
    // @overlay-against: class AbstractTranslator extends \Symfony\Component\Translation\Translator
    partial class AbstractTranslator {
        // @overlay-against: function getAvailableLocales(string $prefix): array
        public function getAvailableLocales(string $prefix = ''): array<int, string>;

        // @overlay-against: function getDirectories(): array
        public function getDirectories(): array<int, string>;

        // @overlay-against: function getLocalesFiles(string $prefix): array
        public function getLocalesFiles(string $prefix = ''): array<int, string>;
    }

    // @overlay-against: class Carbon extends \DateTime implements \Carbon\CarbonInterface, \Carbon\Traits\Date
    partial class Carbon {
        // @overlay-against: function minus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): mixed
        public static function minus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): static;

        // @overlay-against: function plus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): mixed
        public static function plus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): static;
    }

    // @overlay-against: class CarbonImmutable extends \DateTimeImmutable implements \Carbon\CarbonInterface, \Carbon\Traits\Date
    partial class CarbonImmutable {
        // @overlay-against: function minus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): mixed
        public static function minus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): static;

        // @overlay-against: function plus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): mixed
        public static function plus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): static;
    }

    /**
     * Overlay: date-part array, locale format maps, and day lists.
     */
    // @overlay-against: interface CarbonInterface
    partial interface CarbonInterface {
        /**
         * @param callable(): T $func
         * @return T
         */
        // @overlay-against: function executeWithLocale(string $locale, callable $func): mixed
        public static function executeWithLocale<T>(string $locale, callable(): T $func): T;

        // @overlay-against: function getAvailableLocales(): array
        public static function getAvailableLocales(): array<int, string>;

        // @overlay-against: function getDays(): array
        public static function getDays(): array<int, string>;

        /**
         * @return array<string, bool|string|(callable(\Carbon\CarbonInterface): string)>
         */
        // @overlay-against: function getFormatsToIsoReplacements(): array
        public static function getFormatsToIsoReplacements(): array<string, bool|string|(callable(\Carbon\CarbonInterface): string)>;

        /**
         * @return array<string, string|array<int, string|array<int, string>>>
         */
        // @overlay-against: function getIsoUnits(): array
        public static function getIsoUnits(): array<string, string|array<int, string|array<int, string>>>;

        // @overlay-against: function getWeekendDays(): array
        public static function getWeekendDays(): array<int, int>;

        // @overlay-against: function minus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): mixed
        public static function minus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): static;

        // @overlay-against: function plus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): mixed
        public static function plus(int $years, int $months, int|float $weeks, int|float $days, int|float $hours, int|float $minutes, int|float $seconds, int|float $microseconds, \Carbon\OverflowMode|bool|null $overflow, ?int $anchorDay): static;

        // @overlay-against: function getCalendarFormats(?string $locale): array
        public function getCalendarFormats(?string $locale = null): \Carbon\CarbonCalendarFormats;

        // @overlay-against: function getIsoFormats(?string $locale): array
        public function getIsoFormats(?string $locale = null): \Carbon\CarbonIsoFormats;

        // @overlay-against: function nthOfMonth(int $nth, int $dayOfWeek): mixed
        public function nthOfMonth(int $nth, int $dayOfWeek): static|false;

        // @overlay-against: function nthOfQuarter(int $nth, int $dayOfWeek): mixed
        public function nthOfQuarter(int $nth, int $dayOfWeek): static|false;

        // @overlay-against: function nthOfYear(int $nth, int $dayOfWeek): mixed
        public function nthOfYear(int $nth, int $dayOfWeek): static|false;

        // @overlay-against: function toArray(): array
        public function toArray(): \Carbon\CarbonArray;
    }

    /**
     * Overlay: iteration yields Carbon dates; `map` yields the callback result.
     */
    // @overlay-against: class CarbonPeriod extends \Carbon\DatePeriodBase implements \Countable, \JsonSerializable, \Carbon\Constants\UnitValue, \Carbon\Traits\LocalFactory, \Carbon\Traits\IntervalRounding, \Carbon\Traits\Mixin, \Carbon\Traits\Options, \Carbon\Traits\ToStringFormat
    partial class CarbonPeriod {
        // @overlay-against: function getIterator(): \Generator
        public function getIterator(): \Generator<int, \Carbon\CarbonInterface>;

        /**
         * @param callable(\Carbon\CarbonInterface): TReturn $callback
         */
        // @overlay-against: function map(callable $callback): \Generator
        public function map<TReturn>(callable(\Carbon\CarbonInterface): TReturn $callback): \Generator<int, TReturn>;
    }

    // @overlay-against: class CarbonTimeZone extends \DateTimeZone implements \Carbon\Traits\LocalFactory
    partial class CarbonTimeZone {
        /**
         * @param \__ClassName<T> $className
         */
        // @overlay-against: function cast(string $className): mixed
        public function cast<T>(\__ClassName<T> $className): T;
    }

    class DatePeriodBase {
    }

    /**
     * Overlay: factory forwards the same maps as `CarbonInterface`.
     */
    // @overlay-against: class Factory
    partial class Factory {
        // @overlay-against: function getAvailableLocales(): array
        public function getAvailableLocales(): array<int, string>;

        // @overlay-against: function getAvailableLocalesInfo(): array
        public function getAvailableLocalesInfo(): array<int, \Carbon\Language>;

        // @overlay-against: function getDays(): array
        public function getDays(): array<int, string>;

        /**
         * @return array<string, bool|string|(callable(\Carbon\CarbonInterface): string)>
         */
        // @overlay-against: function getFormatsToIsoReplacements(): array
        public function getFormatsToIsoReplacements(): array<string, bool|string|(callable(\Carbon\CarbonInterface): string)>;

        // @overlay-against: function getIsoUnits(): array
        public function getIsoUnits(): array<string, string|array<int, string|array<int, string>>>;

        // @overlay-against: function getLastErrors(): array|false
        public function getLastErrors(): \DateLastErrors|false;

        // @overlay-against: function getWeekendDays(): array
        public function getWeekendDays(): array<int, int>;
    }

    /**
     * Overlay: immutable factory forwards the same maps as `Factory`.
     */
    // @overlay-against: class FactoryImmutable extends \Carbon\Factory implements \Symfony\Component\Clock\ClockInterface
    partial class FactoryImmutable {
        // @overlay-against: function getAvailableLocales(): array
        public function getAvailableLocales(): array<int, string>;

        // @overlay-against: function getAvailableLocalesInfo(): array
        public function getAvailableLocalesInfo(): array<int, \Carbon\Language>;

        // @overlay-against: function getDays(): array
        public function getDays(): array<int, string>;

        // @overlay-against: function getFormatsToIsoReplacements(): array
        public function getFormatsToIsoReplacements(): array<string, bool|string|(callable(\Carbon\CarbonInterface): string)>;

        // @overlay-against: function getIsoUnits(): array
        public function getIsoUnits(): array<string, string|array<int, string|array<int, string>>>;

        // @overlay-against: function getLastErrors(): array|false
        public function getLastErrors(): \DateLastErrors|false;
    }

    class LazyTranslator {
    }
}

namespace Carbon\MessageFormatter {
    class LazyMessageFormatter {
    }
