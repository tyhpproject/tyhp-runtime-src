<?tyhp

function test_validator_create_and_validate(): \Symfony\Component\Validator\ConstraintViolationListInterface
{
    $validator = \Symfony\Component\Validator\Validation::createValidator();
    return $validator->validate('not-an-email', new \Symfony\Component\Validator\Constraints\Email());
}

function test_validator_not_blank(): \Symfony\Component\Validator\ConstraintViolationListInterface
{
    $validator = \Symfony\Component\Validator\Validation::createValidator();
    return $validator->validate('', new \Symfony\Component\Validator\Constraints\NotBlank());
}
