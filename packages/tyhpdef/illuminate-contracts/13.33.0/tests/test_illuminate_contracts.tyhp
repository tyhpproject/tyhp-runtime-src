<?tyhp

function test_contracts_container_class(\Illuminate\Contracts\Container\Container $c): \stdClass
{
    return $c->get(\stdClass::class);
}

function test_contracts_container_bound(\Illuminate\Contracts\Container\Container $c): bool
{
    return $c->bound(\stdClass::class);
}

function test_contracts_cache(\Illuminate\Contracts\Cache\Repository $cache): mixed
{
    return $cache->get('key');
}
