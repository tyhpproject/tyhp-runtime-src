<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Refinements Layer 2 harvest does not cover (generic defaults, a few member types).
 */

type DebugStackFrame = struct {
    string $function;
    int $line;
    string $file;
    ?string $class;
    ?object $object;
    ?string $type;
    ?array<int, mixed> $args;
};

// PHP <8.3 gc_status() keys. PHP ≥8.3 adds running/protected/full/buffer_size and timing floats.
declare(php="<8.3") {
    type GcStatus = struct {
        int $runs;
        int $collected;
        int $threshold;
        int $roots;
    };
}

declare(php=">=8.3") {
    type GcStatus = struct {
        int $runs;
        int $collected;
        int $threshold;
        int $roots;
        bool $running;
        bool $protected;
        bool $full;
        int $buffer_size;
        float $application_time;
        float $collector_time;
        float $destructor_time;
        float $free_time;
    };
}

// Stored visibility scope: TThis or a parent as an object (__SuperType) or class-name
// string (__SuperTypeName). When TThis is null or object, those utilities widen to
// object / __ClassName. Do not put the bindTo sentinel 'static' in this union — that
// token means "keep the old scope" on bind/bindTo, it is not a stored TScope.
type __ClosureScope<TThis extends __ClosureThis> = __SuperType<TThis>|__SuperTypeName<TThis>|null;

// Bound $this of a Closure, or null for static / function-backed closures.
type __ClosureThis = object|null;

// still cannot be used in places of normal __PropertyName. You will need to strip the prefix
type __PrivatePropertyName<T> = "${__ClassName<T>}${__PropertyName<T>}";

// still cannot be used in places of normal __PropertyName. You will need to strip the prefix
type __ProtectedPropertyName<T> = "*${__PropertyName<T>}";

// this is how to define a callable with optional params
type ErrorHandlerCallback = (callable(int, string, string, int): bool)&(callable(int, string, string): bool)&(callable(int, string): bool);

// @overlay-against: function class_alias(string $class, string $alias, bool $autoload): bool
function class_alias<T extends object = object>(__ClassName<T> $class, string $alias, bool $autoload = true): $alias is __ClassName<T>;

// @overlay-against: function class_exists(string $class, bool $autoload): bool
function class_exists<T extends object = object>(string $class, bool $autoload = true): $class is \__ClassName<T>;
// @overlay-against: function class_exists(string $class, bool $autoload): bool
function class_exists<T extends object = object> as class_exists_alt(string $class, bool $autoload = true): $class is \__ClassName<T>;

// @overlay-against: function debug_backtrace(int $options, int $limit): array
function debug_backtrace(int $options = DEBUG_BACKTRACE_PROVIDE_OBJECT, int $limit = 0): array<DebugStackFrame>;

// @overlay-against: function define(string $constant_name, mixed $value, bool $case_insensitive): bool
function define(string $constant_name, mixed $value, bool $case_insensitive = false): $constant_name is __ConstName;

// @overlay-against: function defined(string $constant_name): bool
function defined(string $constant_name): $constant_name is __ConstName;

// @overlay-against: function enum_exists(string $enum, bool $autoload): bool
function enum_exists(string $enum, bool $autoload = true): $enum is \__EnumName;

// @overlay-against: function func_get_args(): array
function func_get_args(): array<int, mixed>;

// @overlay-against: function function_exists(string $function): bool
function function_exists(string $function): $function is \__FunctionName;

// One ungated function: gc_status()'s own signature does not change by PHP
// version — only the returned GcStatus struct's fields do, and that struct
// already carries its own version-gated definitions above.
// @overlay-against: function gc_status(): array
function gc_status(): GcStatus;

// @overlay-against: function get_called_class(): string
function get_called_class(): __ClassName;

// @overlay-against: function get_class(object $object): string
function get_class<T extends object>(T $object): __ClassName<T>;

// @overlay-against: function get_class_methods(object|string $object_or_class): array
function get_class_methods<T extends object = object>(T|__ClassName<T> $object_or_class): array<int, __MethodName<T>>;

// @overlay-against: function get_class_vars(string $class): array
function get_class_vars<T extends object = object>(__ClassName<T> $class): array<__PropertyName<T>, mixed|null>;

// @overlay-against: function get_declared_classes(): array
function get_declared_classes(): array<int, __ClassName>;

// @overlay-against: function get_declared_interfaces(): array
function get_declared_interfaces(): array<__InterfaceName>;

// @overlay-against: function get_declared_traits(): array
function get_declared_traits(): array<__TraitName>;

// @overlay-against: function get_defined_constants(bool $categorize): array
function get_defined_constants(false $categorize = false): array<__ConstName, mixed>;
// @overlay-against: function get_defined_constants(bool $categorize): array
function get_defined_constants(true $categorize): array<string, array<__ConstName, mixed>>;

// @overlay-against: function get_defined_vars(): array
function get_defined_vars(): array<__VarName, mixed>;

// @overlay-against: function get_extension_funcs(string $extension): array|false
function get_extension_funcs(string $extension): array<int, __FunctionName>|false;

// @overlay-against: function get_mangled_object_vars(object $object): array
function get_mangled_object_vars<T extends object>(T $object): array<__PropertyName<T>|__ProtectedPropertyName<T>|__PrivatePropertyName<T>, mixed>;

// @overlay-against: function get_object_vars(object $object): array
function get_object_vars<T extends object>(T $object): array<__PropertyName<T>, mixed>;

// @overlay-against: function get_parent_class(object|string $object_or_class): string|false
function get_parent_class<T extends object>(T|__ClassName<T> $object_or_class): __ClassName<__SuperType<T>>|false;

// @overlay-against: function interface_exists(string $interface, bool $autoload): bool
function interface_exists(string $interface, bool $autoload = true): $interface is \__InterfaceName;

// @overlay-against: function is_a(mixed $object_or_class, string $class, bool $allow_string): bool
function is_a<T1 extends object, T2 extends object>(T1 $object_or_class, __ClassName<T2> $class, bool $allow_string = false): $object_or_class is T2;
// @overlay-against: function is_a(mixed $object_or_class, string $class, bool $allow_string): bool
function is_a<T2 extends object>(string $object_or_class, __ClassName<T2> $class, true $allow_string): $object_or_class is __CompatibleTypeName<T2>;

// @overlay-against: function is_subclass_of(mixed $object_or_class, string $class, bool $allow_string): bool
function is_subclass_of<T1 extends object>(T1|__ClassName<T1> $object_or_class, string $class, true $allow_string = true): $class is __SuperTypeName<T1>;
// @overlay-against: function is_subclass_of(mixed $object_or_class, string $class, bool $allow_string): bool
function is_subclass_of<T1 extends object>(T1 $object_or_class, string $class, false $allow_string): $class is __SuperTypeName<T1>;

// @overlay-against: function method_exists(mixed $object_or_class, string $method): bool
function method_exists<T extends object>(T|__ClassName<T> $object_or_class, string $method): $method is __MethodName<T>;

// @overlay-against: function property_exists(mixed $object_or_class, string $property): bool
function property_exists<T extends object>(T|__ClassName<T> $object_or_class, string $property): $property is __PropertyName<T>;

// @overlay-against: function set_error_handler(?callable $callback, int $error_levels): mixed
function set_error_handler(?ErrorHandlerCallback $callback, int $error_levels = \E_ALL): ?ErrorHandlerCallback;

// @overlay-against: function set_exception_handler(?callable $callback): mixed
function set_exception_handler(?callable(\Throwable): void $callback): ?callable(\Throwable): void;

// @overlay-against: function trait_exists(string $trait, bool $autoload): bool
function trait_exists(string $trait, bool $autoload = true): $trait is \__TraitName;

declare(php="<8.5") {
    // @overlay-against: function get_defined_functions(bool $exclude_disabled): array
    function get_defined_functions(bool $exclude_disabled = true): array<'internal'|'user', array<int, __FunctionName>>;
}

declare(php=">=8.5") {
    // @overlay-against: function clone(object $object, array $withProperties): object
    function clone<T extends object>(T $object, __Properties<T> $withProperties = []): T;

    // @overlay-against: function get_defined_functions(bool $exclude_disabled): array
    function get_defined_functions(): array<'internal'|'user', array<int, __FunctionName>>;
    // @overlay-against: function get_defined_functions(bool $exclude_disabled): array
    deprecated function get_defined_functions(bool $exclude_disabled): array<'internal'|'user', array<int, __FunctionName>>;

    // @overlay-against: function get_error_handler(): ?callable
    function get_error_handler(): ?ErrorHandlerCallback;

    // @overlay-against: function get_exception_handler(): ?callable
    function get_exception_handler(): ?callable(\Throwable): void;
}

// We do not allow dynamic properties in Tyhp. If you want dynamic properties you need to use the magic `__get`/`__set`.
// @overlay-against: class AllowDynamicProperties
omit final class AllowDynamicProperties {};

// Homogeneous `$obj[$k]` → TValue. Per-key struct maps are not this interface's
// one-arg form (that is TKey + default TValue). Layer 2 already has offset* with TKey/TValue
// and offsetSet(null|TKey, …) for `$obj[] =`. Harvest types offsetGet as null|TValue; drop
// the extra null so reads are TValue (same as WeakMap.offsetGet / Iterator.current).
// @overlay-against: interface ArrayAccess
partial interface ArrayAccess<TKey = mixed, TValue = mixed>;
// @overlay-against: interface ArrayAccess
partial interface ArrayAccess {
    // @overlay-against: function offsetGet(mixed $offset): mixed
    public function offsetGet(TKey $offset): TValue;
}

// Engine methods return \BackedEnum; remap to static so a concrete backed enum keeps its type.
// @overlay-against: interface BackedEnum
partial interface BackedEnum {
    // @overlay-against: function from(string|int $value): \BackedEnum
    static public function from(string|int $value): static;
    // @overlay-against: function tryFrom(string|int $value): ?\BackedEnum
    static public function tryFrom(string|int $value): ?static;
}

// Closure is a class, not a second return-last `callable`. Do not restore compiler
// special-case `\Closure<TArgs…, TReturn>` (last arg = return). Spell signatures as
// `\Closure<callable(int $i): string>`. There is no `\Closure(int): string` and no
// `new Closure<…>()`; instances come from `function`/`fn`, first-class callables, or
// fromCallable — generics are inferred. TCallableShape has no default so a bare
// `\Closure` stays gradual. TThis/TScope default to the wide aliases so
// `\Closure<callable(int $i): int>` still accepts static closures.
// Callable-ness is `__invoke`, not `extends TCallableShape` (a Closure is never a
// subtype of an invokable class). TThis/TScope are invariant.
// @overlay-against: class Closure
final partial class Closure<
    TCallableShape extends callable,
    TThis extends __ClosureThis = __ClosureThis,
    TScope extends __ClosureScope<TThis> = __ClosureScope<TThis>
>;
// @overlay-against: class Closure
final partial class Closure {
    // Explicit new scope → result TScope is TNewScope. Checker still requires
    // TNewThis compatible with that scope ($newThis instanceof scope class).
    // @overlay-against: function bind(\Closure $closure, ?object $newThis, object|string|null $newScope): ?\Closure
    static public function bind<
        TCallableShape extends callable,
        TNewThis extends __ClosureThis,
        TNewScope extends __ClosureScope<TNewThis>,
        TOldThis extends __ClosureThis,
        TOldScope extends __ClosureScope<TOldThis>
    >(
        \Closure<TCallableShape, TOldThis, TOldScope> $closure,
        TNewThis $newThis,
        TNewScope $newScope
    ): ?\Closure<TCallableShape, TNewThis, TNewScope>;
    // Omitted $newScope or the literal 'static' keeps TOldScope. Do not type the
    // result as TScope='static'. Checker: TNewThis must still match leftover TOldScope.
    // Second same-name signature is a tyhpdef overload (overlay replace already
    // dropped the harvested bind on the first declaration).
    // @overlay-against: function bind(\Closure $closure, ?object $newThis, object|string|null $newScope): ?\Closure
    static public function bind<
        TCallableShape extends callable,
        TNewThis extends __ClosureThis,
        TNewScope extends 'static',
        TOldThis extends __ClosureThis,
        TOldScope extends __ClosureScope<TOldThis>
    >(
        \Closure<TCallableShape, TOldThis, TOldScope> $closure,
        TNewThis $newThis,
        TNewScope $newScope = 'static'
    ): ?\Closure<TCallableShape, TNewThis, TOldScope>;
    // Result TThis/TScope come from $callback (__CallableThis / __CallableScope), not
    // from the caller's $this. PHP "current scope" is an access check (private/protected
    // visible here), not a rebind of the new Closure's $this. Invokable objects: store
    // the __invoke arity intersection, drop the class type.
    // @overlay-against: function fromCallable(callable $callback): \Closure
    static public function fromCallable<TCallableShape extends callable>(
        TCallableShape $callback
    ): \Closure<TCallableShape, __CallableThis<TCallableShape>, __CallableScope<TCallableShape>>;
    // Currently executing closure is not always unique at a call site (shared helpers).
    // Return the widest Closure; callers use `as` if they need a tighter shape.
    #[\Tyhp\Php(">=8.5")]
    // @overlay-against: function getCurrent(): \Closure
    static public function getCurrent(): \Closure<callable, __ClosureThis, __ClosureScope<__ClosureThis>>;

    // Supplies the callable facet (arity intersection when parameters have defaults).
    // @overlay-against: function __invoke(): mixed
    public function __invoke(__CallableParametersRest<TCallableShape> ...$args): __CallableReturnType<TCallableShape>;
    // Same split as bind().
    // @overlay-against: function bindTo(?object $newThis, object|string|null $newScope): ?\Closure
    public function bindTo<
        TNewThis extends __ClosureThis,
        TNewScope extends __ClosureScope<TNewThis>
    >(
        TNewThis $newThis,
        TNewScope $newScope
    ): ?\Closure<TCallableShape, TNewThis, TNewScope>;
    // @overlay-against: function bindTo(?object $newThis, object|string|null $newScope): ?\Closure
    public function bindTo<
        TNewThis extends __ClosureThis,
        TNewScope extends 'static'
    >(
        TNewThis $newThis,
        TNewScope $newScope = 'static'
    ): ?\Closure<TCallableShape, TNewThis, TScope>;
    // PHP $newThis is non-null. Temporary $this for the invoke; does not return a Closure.
    // @overlay-against: function call(object $newThis, mixed $args): mixed
    public function call<TNewThis extends object>(
        TNewThis $newThis,
        __CallableParametersRest<TCallableShape> ...$args
    ): __CallableReturnType<TCallableShape>;
}

// Covariant vs Throwable::getCode(): mixed. Leave Throwable mixed.
// @overlay-against: class Error implements \Stringable, \Throwable
partial class Error {
    // @overlay-against: array $trace
    private array<int, DebugStackFrame> $trace;

    // @overlay-against: function getCode(): mixed
    final public function getCode(): int;
    // @overlay-against: function getTrace(): array
    final public function getTrace(): array<int, DebugStackFrame>;
}

// @overlay-against: class Exception implements \Stringable, \Throwable
partial class Exception {
    // @overlay-against: array $trace
    private array<int, DebugStackFrame> $trace;

    // @overlay-against: function getCode(): mixed
    final public function getCode(): int;
    // @overlay-against: function getTrace(): array
    final public function getTrace(): array<int, DebugStackFrame>;
}

// Fiber: TResume types $fiber->resume($value) only (this instance's resume protocol).
// Do not add TSuspend / TStart. Fiber::suspend() is static — it suspends whichever fiber
// is running, including helpers shared by many fibers. Typing start()/resume()/throw()
// returns or suspend()'s argument as TSuspend would not be enforceable without tracing
// the runtime call stack. Stub harvest often uses @template TStart/TResume/TReturn/TSuspend;
// keep those out of Layer 3. start()/throw()/suspend() returns stay mixed|null (null when
// the fiber has terminated). getReturn() is the callback's return, not a suspend value.
// getCurrent() is the widest Fiber (TResume=mixed, TCallableShape=callable), not the
// default callable(): void. Callers narrow with `as`, not `is Fiber<…>` (no runtime generics).
// @overlay-against: class Fiber
partial class Fiber<TResume = mixed, TCallableShape extends callable = callable>;
// @overlay-against: class Fiber
partial class Fiber {
    // @overlay-against: function getCurrent(): ?\Fiber
    static public function getCurrent(): ?\Fiber<mixed, callable>;
    // Static: cannot be tied to this Fiber's TResume. Argument and return are mixed.
    // @overlay-against: function suspend(mixed $value): mixed
    static public function suspend(null|mixed $value = null): null|mixed;

    // @overlay-against: function __construct(callable $callback): void
    public function __construct(TCallableShape $callback): void;

    // @overlay-against: function getReturn(): mixed
    public function getReturn(): __CallableReturnType<TCallableShape>;
    // $value becomes the return of the current Fiber::suspend() inside this fiber.
    // Return is mixed for the same reason as start() (see class comment).
    // @overlay-against: function resume(mixed $value): mixed
    public function resume(null|TResume $value = null): null|mixed;
    // Value passed to the next Fiber::suspend(), or null if the fiber returned.
    // @overlay-against: function start(mixed $args): mixed
    public function start(__CallableParametersRest<TCallableShape> ...$args): null|mixed;
    // @overlay-against: function throw(\Throwable $exception): mixed
    public function throw(\Throwable $exception): null|mixed;
}

// Generator functions declare `\Generator`, `\Generator<TKey, TValue>`, or the full
// four-arg form — never the body's `return` type (that is TReturn / getReturn()).
// The checker infers omitted args from yield / send / return.
// TSend is the value of a `yield` expression (`$x = yield`), not the yielded TValue.
// Overlay remaps Iterator/Traversable so foreach binds TKey/TValue (not TSend/TReturn).
// Direct `$g->current()` is TValue (harvest types it as null|TValue).
// @overlay-against: class Generator implements \Iterator, \Traversable
partial class Generator<TKey = mixed, TValue = mixed, TSend = mixed, TReturn = mixed> implements \Iterator<TKey, TValue>, \Traversable<TKey, TValue>;
// @overlay-against: class Generator implements \Iterator, \Traversable
partial class Generator {
    // cannot do `new Generator();`
    private function __construct();
    #[\Tyhp\Php(">=8.4")]
    // @overlay-against: function __debugInfo(): array
    public function __debugInfo(): array<string, mixed>;
    // @overlay-against: function current(): mixed
    public function current(): TValue;
    // @overlay-against: function send(mixed $value): mixed
    public function send(TSend $value): TValue;
    // @overlay-against: function throw(\Throwable $exception): mixed
    public function throw(\Throwable $exception): TValue;
}

// @overlay-against: class InternalIterator implements \Iterator, \Traversable
partial class InternalIterator<TKey = mixed, TValue = mixed> implements \Iterator<TKey, TValue>, \Traversable<TKey, TValue>;
// @overlay-against: class InternalIterator implements \Iterator, \Traversable
partial class InternalIterator {
    // @overlay-against: function current(): mixed
    public function current(): TValue;
    // @overlay-against: function key(): mixed
    public function key(): TKey;
}

// @overlay-against: interface Iterator
partial interface Iterator<TKey = mixed, TValue = mixed>;
// @overlay-against: interface Iterator
partial interface Iterator {
    // @overlay-against: function current(): mixed
    public function current(): TValue;
    // @overlay-against: function key(): mixed
    public function key(): TKey;
}

// @overlay-against: interface IteratorAggregate
partial interface IteratorAggregate<TKey = mixed, TValue = mixed>;
// @overlay-against: interface IteratorAggregate
partial interface IteratorAggregate {
    // @overlay-against: function getIterator(): \Traversable
    public function getIterator(): \Traversable<TKey, TValue>;
}

// We will not allow this in Tyhp.
// @overlay-against: class ReturnTypeWillChange
omit final class ReturnTypeWillChange {};

// Layer 2 has getValue(): TValue without a generic default or a typed constructor.
// @overlay-against: class SensitiveParameterValue
partial class SensitiveParameterValue<TValue = mixed>;
// @overlay-against: class SensitiveParameterValue
partial class SensitiveParameterValue {
    // @overlay-against: function __construct(mixed $value): void
    public function __construct(TValue $value): void;
}

// Same format as debug_backtrace().
// @overlay-against: interface Throwable
partial interface Throwable {
    // @overlay-against: function getTrace(): array
    public function getTrace(): array<int, DebugStackFrame>;
}

// Engine interface. Only Iterator and IteratorAggregate may `extends Traversable`.
// User classes must not `implements Traversable` (PHP fatal).
// @overlay-against: interface Traversable
partial interface Traversable<TKey = mixed, TValue = mixed>;

// @overlay-against: class WeakMap implements \ArrayAccess, \Countable, \IteratorAggregate, \Traversable
partial class WeakMap {
    // @overlay-against: function getIterator(): \Iterator
    public function getIterator(): \Iterator<TKey, TValue>;
    // @overlay-against: function offsetGet(mixed $object): mixed
    public function offsetGet(TKey $object): TValue;
}

// @overlay-against: class WeakReference
partial class WeakReference {
    // @overlay-against: function create(object $object): \WeakReference
    public static function create<TIn extends object = object>(TIn $object): \WeakReference<TIn>;
    // @overlay-against: function get(): ?object
    public function get(): ?T;
}
