<?tyhp

namespace OverlayTests\Reflection;

function reflectionMethod_invokeArgs_acceptsMixedArgs(\ReflectionMethod $m, object $o, array<int, mixed> $args): mixed {
    return $m->invokeArgs($o, $args);
}

function reflectionFunction_invokeArgs_acceptsMixedArgs(\ReflectionFunction $f, array<int, mixed> $args): mixed {
    return $f->invokeArgs($args);
}

function reflectionClass_newInstanceArgs_acceptsMixedArgs(\ReflectionClass<\stdClass> $c, array<int, mixed> $args): \stdClass {
    return $c->newInstanceArgs($args);
}

function reflectionFiber_getTrace_isDebugStackFrames(\ReflectionFiber $f): array<int, \DebugStackFrame> {
    return $f->getTrace();
}

function reflectionGenerator_getTrace_isDebugStackFrames(\ReflectionGenerator $g): array<int, \DebugStackFrame> {
    return $g->getTrace();
}

function reflectionReference_fromArrayElement_followsKeys(array<string, int> $arr): void {
    ?\ReflectionReference $ref = \ReflectionReference::fromArrayElement($arr, "k");
}

declare(php=">=8.4") {
    function ignoreLazyObject(\stdClass $object): void {
    }

    function newLazyGhost_acceptsVoidInitializer(\ReflectionClass<\stdClass> $class): \stdClass {
        return $class->newLazyGhost(fn (\stdClass $object): void => ignoreLazyObject($object));
    }

    function newLazyProxy_acceptsFactoryReturningSame(\ReflectionClass<\stdClass> $class): \stdClass {
        return $class->newLazyProxy(fn (\stdClass $object): \stdClass => $object);
    }

    function resetAsLazyGhost_acceptsVoidInitializer(\ReflectionClass<\stdClass> $class, \stdClass $object): void {
        $class->resetAsLazyGhost($object, fn (\stdClass $ghost): void => ignoreLazyObject($ghost));
    }

    function resetAsLazyProxy_acceptsFactoryReturningSame(\ReflectionClass<\stdClass> $class, \stdClass $object): void {
        $class->resetAsLazyProxy($object, fn (\stdClass $proxy): \stdClass => $proxy);
    }
}
