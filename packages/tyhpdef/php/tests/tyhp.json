{
    "quiet": true,
    "locale": "en-US",
    "type": "application",
    "suppressWarnings": [
        "TYHP8027",
        "TYHP4200"
    ],
    "include": [
        "./**/*.tyhp"
    ],
    "tyhpdefInclude": [
        "../composer.json",
        "../../core/composer.json",
        "./fixtures/overlay_enums.tyhpdef"
    ],
    "exclude": [
        "./fail/**"
    ],
    "output": {
        "path": "./build",
        "phpVersion": "8.2"
    }
}
