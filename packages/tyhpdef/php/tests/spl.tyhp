<?tyhp

namespace OverlayTests\Spl;

class User {
}

function foreach_splQueueStackHeaps_keyIsInt_valueIsUser(
    \SplQueue<User> $q,
    \SplStack<User> $s,
    \SplMinHeap<User> $min,
    \SplMaxHeap<User> $max
): void {
    foreach ($q as $key => $value) {
        int $checkKey = $key;
        User $checkValue = $value;
    }
    foreach ($s as $key => $value) {
        int $checkKey = $key;
        User $checkValue = $value;
    }
    foreach ($min as $key => $value) {
        int $checkKey = $key;
        User $checkValue = $value;
    }
    foreach ($max as $key => $value) {
        int $checkKey = $key;
        User $checkValue = $value;
    }
}

function splFixedArray_indexAndFromArray_areTValue(\SplFixedArray<string> $a): void {
    string $s = $a[0];
}

function splFixedArray_fromArrayIsTyped(): void {
    \SplFixedArray<string> $a = \SplFixedArray::fromArray(["a"]);
    string $s = $a[0];
}

function splObjectStorage_currentAndAttach_useTObjectAndTData(\SplObjectStorage<User, string> $store, User $user): void {
    User $current = $store->current();
    $store->attach($user, "meta");
}

function arrayObject_getIterator_isIteratorNotArrayIterator(\ArrayObject<string, User> $ao): void {
    \Iterator<string, User> $it = $ao->getIterator();
}

function foreach_wrapperIterators_useTKeyAndTValue(
    \FilterIterator<int, User> $filter,
    \LimitIterator<int, User> $limit,
    \IteratorIterator<int, User> $inner
): void {
    foreach ($filter as $key => $value) {
        int $checkKey = $key;
        User $checkValue = $value;
    }
    foreach ($limit as $key => $value) {
        int $checkKey = $key;
        User $checkValue = $value;
    }
    foreach ($inner as $key => $value) {
        int $checkKey = $key;
        User $checkValue = $value;
    }
}

function foreach_recursiveIteratorIterator_usesDeclaredTKeyTValue(\RecursiveIteratorIterator<string, User> $it): void {
    foreach ($it as $key => $value) {
        string $checkKey = $key;
        User $checkValue = $value;
    }
}

function iteratorToArray_trueKeepsTKey_falseReindexesToInt(\Iterator<string, User> $it): void {
    array<string, User> $keep = \iterator_to_array($it, true);
    array<int, User> $reindexed = \iterator_to_array($it, false);
}

function regexIterator_matchConstant_isInt(): int {
    return \RegexIterator::MATCH;
}

function recursiveRegexIterator_matchConstant_isInt(): int {
    return \RecursiveRegexIterator::MATCH;
}

function splFileObject_fstat_isStatInfo(\SplFileObject $f): void {
