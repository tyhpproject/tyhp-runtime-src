<?tyhp

namespace OverlayTests\Hash;

function hashAlgos_isListOfString(): array<int, string> {
    return \hash_algos();
}

function hash_withSeedOptionsBag_isString(): string {
    return \hash('murmur3f', 'php', false, ['seed' => 42]);
}

function hashOptions_seedIsOptionalInt(\HashOptions $opts): ?int {
    return $opts->seed;
}

function hashInit_defaultFlags_isHashContext(): \HashContext {
    return \hash_init('sha256');
}

function hashInit_hmacConst_withKey_isHashContext(): \HashContext {
    return \hash_init('sha256', \HASH_HMAC, 'secret');
}

function hashUpdateFile_nullContext_isBool(\HashContext $ctx): bool {
    return \hash_update_file($ctx, 'file.bin', null);
}

function hashContext_serialize_isIntKeyedArray(\HashContext $ctx): array<int, mixed> {
    return $ctx->__serialize();
}

declare(php=">=8.4") {
    function hashContext_debugInfo_isAlgoStruct(\HashContext $ctx): \HashContextDebugInfo {
        return $ctx->__debugInfo();
    }
}
