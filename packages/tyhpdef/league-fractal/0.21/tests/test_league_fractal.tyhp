<?tyhp

function test_fractal_item(): \League\Fractal\Resource\Item
{
    return new \League\Fractal\Resource\Item(['id' => 1, 'name' => 'Ada'], null, 'people');
}

function test_fractal_collection(): \League\Fractal\Resource\Collection
{
    return new \League\Fractal\Resource\Collection([
        ['id' => 1],
        ['id' => 2],
    ]);
}

function test_fractal_manager_includes(): \League\Fractal\Manager
{
    $manager = new \League\Fractal\Manager();
    $manager->parseIncludes(['author', 'comments']);
    $manager->parseExcludes('meta');
    return $manager;
}

function test_fractal_create_data(\League\Fractal\Manager $manager, \League\Fractal\Resource\Item $item): array<int|string, mixed>|null
{
    return $manager->createData($item)->toArray();
}
