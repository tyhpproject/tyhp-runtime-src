<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Validator::validate schema is a json_decode result (object or array).
 * Schema storage, URI resolve/retrieve, and JSON pointer paths follow the
 * interfaces and sibling signatures in this package.
 */

namespace JsonSchema {
    /**
     * Overlay: storage methods match `SchemaStorageInterface`.
     * `resolveRef` / `resolveRefSchema` keep the extra `$resolveStack` parameter.
     */
    // @overlay-against: class SchemaStorage implements \JsonSchema\SchemaStorageInterface
    partial class SchemaStorage {
        // @overlay-against: function addSchema(string $id, mixed $schema): void
        public function addSchema(string $id, object|bool $schema = null): void;
        // @overlay-against: function getSchema(string $id): mixed
        public function getSchema(string $id): object|bool;
        // @overlay-against: function resolveRef(string $ref, mixed $resolveStack): mixed
        public function resolveRef(string $ref, mixed $resolveStack = []): object|bool;
        // @overlay-against: function resolveRefSchema(mixed $refSchema, mixed $resolveStack): mixed
        public function resolveRefSchema(mixed $refSchema, array<int, object> $resolveStack = []): object|bool;
    }

    /**
     * Overlay: schema is a json_decode object or array.
     */
    // @overlay-against: class Validator extends \JsonSchema\Constraints\BaseConstraint
    partial class Validator {
        /**
         * @param mixed $value
         * @param mixed $schema
         */
        // @overlay-against: function validate(mixed $value, mixed $schema, ?int $checkMode): int
        public function validate(mixed &$value, \stdClass|array<int|string, mixed>|null $schema = null, ?int $checkMode = null): int;
    }

    /**
     * marc-mabe/php-enum is not a tyhpdef companion; keep Enum as a local abstract type.
     */
    // @overlay-against: class Enum extends \MabeEnum\Enum
    abstract class Enum {
    }
}

namespace JsonSchema\Entity {
    /**
     * Overlay: property paths match `getPropertyPaths()`.
     */
    // @overlay-against: class JsonPointer
    partial class JsonPointer {
        // @overlay-against: function withPropertyPaths(array $propertyPaths): \JsonSchema\Entity\JsonPointer
        public function withPropertyPaths(array<int, string> $propertyPaths): \JsonSchema\Entity\JsonPointer;
    }
}

namespace JsonSchema\Iterator {
    /**
     * Overlay: `key()` is `int` and `current()` is `mixed`.
     */
    // @overlay-against: class ObjectIterator implements \Iterator, \Countable
    partial class ObjectIterator implements \Iterator<int, mixed>, \Countable;
}

namespace JsonSchema\Uri {
    /**
     * Overlay: `resolve()` matches `UriResolverInterface`.
     */
    // @overlay-against: class UriResolver implements \JsonSchema\UriResolverInterface
    partial class UriResolver {
        // @overlay-against: function resolve(mixed $uri, mixed $baseUri): mixed
        public function resolve(string $uri, null|string $baseUri = null): string;
    }

    /**
     * Overlay: `retrieve()` matches `UriRetrieverInterface` and keeps `$translate`.
     */
    // @overlay-against: class UriRetriever implements \JsonSchema\UriRetrieverInterface
    partial class UriRetriever {
        // @overlay-against: function retrieve(mixed $uri, mixed $baseUri, mixed $translate): mixed
        public function retrieve(string $uri, null|string $baseUri = null, mixed $translate = true): object;
    }
}

namespace JsonSchema\Uri\Retrievers {
    /**
     * Overlay: `getContentType()` matches `UriRetrieverInterface`.
     */
    // @overlay-against: class AbstractRetriever implements \JsonSchema\Uri\Retrievers\UriRetrieverInterface
    partial class AbstractRetriever {
        // @overlay-against: function getContentType(): mixed
        public function getContentType(): string;
    }

    /**
     * Overlay: `retrieve()` matches `UriRetrieverInterface` (`string|null`).
     */
    // @overlay-against: class Curl extends \JsonSchema\Uri\Retrievers\AbstractRetriever
    partial class Curl {
        // @overlay-against: function retrieve(mixed $uri): mixed
        public function retrieve(string $uri): string|null;
    }

    // @overlay-against: class FileGetContents extends \JsonSchema\Uri\Retrievers\AbstractRetriever
    partial class FileGetContents {
        // @overlay-against: function retrieve(mixed $uri): mixed
        public function retrieve(string $uri): string|null;
    }

    // @overlay-against: class PredefinedArray extends \JsonSchema\Uri\Retrievers\AbstractRetriever
    partial class PredefinedArray {
        // @overlay-against: function retrieve(mixed $uri): mixed
        public function retrieve(string $uri): string|null;
    }

    /**
     * Overlay: documented return is `string|null`.
     */
    // @overlay-against: interface UriRetrieverInterface
    partial interface UriRetrieverInterface {
        // @overlay-against: function retrieve(string $uri): mixed
        public function retrieve(string $uri): string|null;
    }
}
