namespace Doctrine\Common\Annotations\Annotation {
    /**
     * `@Enum` constructor values. `literal` is the optional raw target list.
     */
    type EnumValues = struct {
        array<int|string, scalar> $value;
        ?array<int|string, mixed> $literal;
    };

    /**
     * `@IgnoreAnnotation` constructor values. The attribute name is `value`.
     */
    type IgnoreAnnotationValues = struct {
        string|array<int|string, string> $value;
    };

    /**
     * `@Target` constructor values. A single target or a list of targets.
     */
    type TargetValues = struct {
        string|int|array<int|string, string|int> $value;
    };

    /**
     * Named `@Enum` arguments.
     */
    // @overlay-against: class Enum
    partial class Enum {
        // @overlay-against: function __construct(array $values): void
        public function __construct(\Doctrine\Common\Annotations\Annotation\EnumValues $values): void;
    }

    /**
     * Named `@IgnoreAnnotation` arguments.
     */
    // @overlay-against: class IgnoreAnnotation
    partial class IgnoreAnnotation {
        // @overlay-against: function __construct(array $values): void
        public function __construct(\Doctrine\Common\Annotations\Annotation\IgnoreAnnotationValues $values): void;
    }

    /**
     * Named `@Target` arguments.
     */
    // @overlay-against: class Target
    partial class Target {
        // @overlay-against: function __construct(array $values): void
        public function __construct(\Doctrine\Common\Annotations\Annotation\TargetValues $values): void;
    }
}
