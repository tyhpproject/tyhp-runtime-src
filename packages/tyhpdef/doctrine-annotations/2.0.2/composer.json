{
  "name": "tyhpdef/doctrine-annotations",
  "description": "Tyhp type definitions for the Composer package doctrine/annotations (2.0.2).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "2.0.2.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/doctrine-lexer": "@dev",
        "tyhpdef/psr-cache": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "doctrine/annotations": "2.0.2"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/doctrine-lexer": "@dev",
    "tyhpdef/psr-cache": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../doctrine-lexer/3.0.1"
    },
    {
      "type": "path",
      "url": "../../psr-cache/3.0.0"
    }
  ]
}
