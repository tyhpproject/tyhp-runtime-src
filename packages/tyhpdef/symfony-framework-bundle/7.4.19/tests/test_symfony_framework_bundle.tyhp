<?tyhp

class OverlayTestsFrameworkController extends \Symfony\Bundle\FrameworkBundle\Controller\AbstractController
{
    public function jsonPublic(mixed $data): \Symfony\Component\HttpFoundation\JsonResponse
    {
        return $this->json($data);
    }

    public function redirectPublic(string $route): \Symfony\Component\HttpFoundation\RedirectResponse
    {
        return $this->redirectToRoute($route);
    }
}

function test_abstract_controller_json(OverlayTestsFrameworkController $controller): \Symfony\Component\HttpFoundation\JsonResponse
{
    return $controller->jsonPublic(['ok' => true]);
}

function test_abstract_controller_redirect(OverlayTestsFrameworkController $controller): \Symfony\Component\HttpFoundation\RedirectResponse
{
    return $controller->redirectPublic('home');
}
