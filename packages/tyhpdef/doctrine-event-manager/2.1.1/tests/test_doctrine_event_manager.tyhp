<?tyhp

function test_event_manager_new(): \Doctrine\Common\EventManager
{
    return new \Doctrine\Common\EventManager();
}

function test_event_manager_dispatch(\Doctrine\Common\EventManager $em): void
{
    $em->dispatchEvent('onFlush', \Doctrine\Common\EventArgs::getEmptyInstance());
}

function test_event_manager_add(\Doctrine\Common\EventManager $em, object $listener): void
{
    $em->addEventListener(['onFlush', 'onClear'], $listener);
}

function test_event_manager_has(\Doctrine\Common\EventManager $em): bool
{
    return $em->hasListeners('onFlush');
}

function test_event_manager_listeners(\Doctrine\Common\EventManager $em): array<int|string, object>
{
    return $em->getListeners('onFlush');
}
