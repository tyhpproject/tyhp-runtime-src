namespace Illuminate\Support {
    /**
    * Overlay: proxied call args are Tyhp list literals.
    */
    // @overlay-against: class HigherOrderWhenProxy
    partial class HigherOrderWhenProxy {
        /**
         * @param array<int|string, mixed> $parameters
         */
        // @overlay-against: function __call(string $method, array $parameters): mixed
        public function __call(string $method, array<int|string, mixed> $parameters): mixed;
    }
}

namespace Illuminate\Support\Traits {
    /**
     * Overlay: `when` / `unless` callbacks receive the instance and the resolved value.
     */
    // @overlay-against: trait Conditionable
    partial trait Conditionable {
        // @overlay-against: function unless(callable|TUnlessParameter|null $value, callable|null $callback, callable|null $default): static|TUnlessReturnType
        public function unless<TUnlessParameter, TUnlessReturnType>((callable(static): TUnlessParameter)|TUnlessParameter|null $value = null, (callable(static, TUnlessParameter): TUnlessReturnType)|null $callback = null, (callable(static, TUnlessParameter): TUnlessReturnType)|null $default = null): static|TUnlessReturnType;
        // @overlay-against: function when(callable|TWhenParameter|null $value, callable|null $callback, callable|null $default): static|TWhenReturnType
        public function when<TWhenParameter, TWhenReturnType>((callable(static): TWhenParameter)|TWhenParameter|null $value = null, (callable(static, TWhenParameter): TWhenReturnType)|null $callback = null, (callable(static, TWhenParameter): TWhenReturnType)|null $default = null): static|TWhenReturnType;
    }
