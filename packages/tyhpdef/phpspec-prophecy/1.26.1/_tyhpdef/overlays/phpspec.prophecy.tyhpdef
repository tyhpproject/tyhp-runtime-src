<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * PHPDoc token returns are relative (`Token\…`); `integer` is not a Tyhp type.
 * Sebastian comparator types are QA-owned — hollow parents so Prophecy can extend them.
 */

namespace SebastianBergmann\Comparator {
    class Comparator {
    }

    class Factory {
    }
}

namespace SebastianBergmann\RecursionContext {
    class Context {
    }
}

namespace Prophecy {
    /**
     * Overlay: Argument::* factories return Prophecy argument tokens; size() is int.
     */
    // @overlay-against: class Argument
    partial class Argument {
        // @overlay-against: function exact(mixed $value): \Token\ExactValueToken
        public static function exact(mixed $value): \Prophecy\Argument\Token\ExactValueToken;

        // @overlay-against: function type(string $type): \Token\TypeToken
        public static function type(string $type): \Prophecy\Argument\Token\TypeToken;

        // @overlay-against: function which(string $methodName, mixed $value): \Token\ObjectStateToken
        public static function which(string $methodName, mixed $value): \Prophecy\Argument\Token\ObjectStateToken;

        // @overlay-against: function any(): \Token\AnyValueToken
        public static function any(): \Prophecy\Argument\Token\AnyValueToken;

        // @overlay-against: function cetera(): \Token\AnyValuesToken
        public static function cetera(): \Prophecy\Argument\Token\AnyValuesToken;

        // @overlay-against: function allOf(mixed $tokens): \Token\LogicalAndToken
        public static function allOf(mixed ...$tokens): \Prophecy\Argument\Token\LogicalAndToken;

        /**
         * @param int $value array elements count
         */
        // @overlay-against: function size(integer $value): \Token\ArrayCountToken
        public static function size(int $value): \Prophecy\Argument\Token\ArrayCountToken;

        // @overlay-against: function withEntry(mixed $key, mixed $value): \Token\ArrayEntryToken
        public static function withEntry(mixed $key, mixed $value): \Prophecy\Argument\Token\ArrayEntryToken;

        // @overlay-against: function withEveryEntry(mixed $value): \Token\ArrayEveryEntryToken
        public static function withEveryEntry(mixed $value): \Prophecy\Argument\Token\ArrayEveryEntryToken;

        // @overlay-against: function containing(mixed $value): \Token\ArrayEntryToken
        public static function containing(mixed $value): \Prophecy\Argument\Token\ArrayEntryToken;

        // @overlay-against: function withKey(mixed $key): \Token\ArrayEntryToken
        public static function withKey(mixed $key): \Prophecy\Argument\Token\ArrayEntryToken;

        // @overlay-against: function not(mixed $value): \Token\LogicalNotToken
        public static function not(mixed $value): \Prophecy\Argument\Token\LogicalNotToken;

        // @overlay-against: function containingString(string $value): \Token\StringContainsToken
        public static function containingString(string $value): \Prophecy\Argument\Token\StringContainsToken;

        // @overlay-against: function is(mixed $value): \Token\IdenticalValueToken
        public static function is(mixed $value): \Prophecy\Argument\Token\IdenticalValueToken;

        // @overlay-against: function approximate(float $value, int $precision): \Token\ApproximateValueToken
        public static function approximate(float $value, int $precision = 0): \Prophecy\Argument\Token\ApproximateValueToken;

        // @overlay-against: function in(array $value): \Token\InArrayToken
        public static function in(array<mixed> $value): \Prophecy\Argument\Token\InArrayToken;

        /**
         * @param callable(mixed): bool $callback
         */
        // @overlay-against: function that(callable $callback, ?string $customStringRepresentation): \Token\CallbackToken
        public static function that(callable(mixed): bool $callback, ?string $customStringRepresentation = null): \Prophecy\Argument\Token\CallbackToken;

        // @overlay-against: function notIn(array $value): \Token\NotInArrayToken
        public static function notIn(array<mixed> $value): \Prophecy\Argument\Token\NotInArrayToken;
    }

    /**
     * Overlay: prophesize() returns a typed ObjectProphecy.
     */
    // @overlay-against: class Prophet
    partial class Prophet {
        /**
         * @param \__ClassName<T>|\__InterfaceName<T> $classOrInterface
         */
        // @overlay-against: function prophesize(string|null $classOrInterface): mixed
        public function prophesize<T extends object>(\__ClassName<T>|\__InterfaceName<T> $classOrInterface): \Prophecy\Prophecy\ObjectProphecy<T>;

        // @overlay-against: function prophesize(string|null $classOrInterface): mixed
        public function prophesize(?string $classOrInterface = null): \Prophecy\Prophecy\ObjectProphecy<object>;
    }
}

namespace Prophecy\Argument {
    /**
     * Overlay: wildcard tokens are Prophecy token objects.
     */
    // @overlay-against: class ArgumentsWildcard
    partial class ArgumentsWildcard {
        /**
         * @return array<int, \Prophecy\Argument\Token\TokenInterface>
         */
        // @overlay-against: function getTokens(): array
        public function getTokens(): array<int, \Prophecy\Argument\Token\TokenInterface>;
    }
}

namespace Prophecy\Argument\Token {
    /**
     * Overlay: the callback scores the argument and returns bool.
     */
    // @overlay-against: class CallbackToken implements \Prophecy\Argument\Token\TokenInterface
    partial class CallbackToken {
        /**
         * @param callable(mixed): bool $callback
         */
        // @overlay-against: function __construct(callable $callback, ?string $customStringRepresentation): void
        public function __construct(callable(mixed): bool $callback, ?string $customStringRepresentation = null): void;
    }


    /**
     * Overlay: array-count token size is int (PHPDoc said `integer`).
     */
    // @overlay-against: class ArrayCountToken implements \Prophecy\Argument\Token\TokenInterface
    partial class ArrayCountToken {
        /**
         * @param int $value
         */
        // @overlay-against: function __construct(integer $value): void
        public function __construct(int $value): void;

        // @overlay-against: function isLast(): boolean
        public function isLast(): bool;
    }

    // @overlay-against: class ArrayEntryToken implements \Prophecy\Argument\Token\TokenInterface
    partial class ArrayEntryToken {
        // @overlay-against: function isLast(): boolean
        public function isLast(): bool;
    }

    // @overlay-against: class InArrayToken implements \Prophecy\Argument\Token\TokenInterface
    partial class InArrayToken {
        // @overlay-against: function isLast(): boolean
        public function isLast(): bool;
    }

    // @overlay-against: class LogicalAndToken implements \Prophecy\Argument\Token\TokenInterface
    partial class LogicalAndToken {
        // @overlay-against: function isLast(): boolean
        public function isLast(): bool;
    }

    // @overlay-against: class NotInArrayToken implements \Prophecy\Argument\Token\TokenInterface
    partial class NotInArrayToken {
        // @overlay-against: function isLast(): boolean
        public function isLast(): bool;
    }
}

namespace Prophecy\Doubler\ClassPatch {
    /**
     * Overlay: PHPDoc `boolean` / `integer` are not Tyhp types.
     */
    // @overlay-against: class KeywordPatch implements \Prophecy\Doubler\ClassPatch\ClassPatchInterface
    partial class KeywordPatch {
        // @overlay-against: function supports(\Prophecy\Doubler\Generator\Node\ClassNode $node): boolean
        public function supports(\Prophecy\Doubler\Generator\Node\ClassNode $node): bool;
    }

    // @overlay-against: class MagicCallPatch implements \Prophecy\Doubler\ClassPatch\ClassPatchInterface
    partial class MagicCallPatch {
        // @overlay-against: function supports(\Prophecy\Doubler\Generator\Node\ClassNode $node): boolean
        public function supports(\Prophecy\Doubler\Generator\Node\ClassNode $node): bool;

        // @overlay-against: function getPriority(): integer
        public function getPriority(): int;
    }
}

namespace Prophecy\Doubler\Generator {
    /**
     * Overlay: reflect() returns this package's ClassNode.
     */
    // @overlay-against: class ClassMirror
    partial class ClassMirror {
        // @overlay-against: function reflect(?\ReflectionClass $class, array $interfaces): \Node\ClassNode
        public function reflect(?\ReflectionClass $class, array<int, \ReflectionClass<object>> $interfaces): \Prophecy\Doubler\Generator\Node\ClassNode;
    }
}

namespace Prophecy\PhpDocumentor {
    interface MethodTagRetrieverInterface {
    }
}

namespace Prophecy\Prediction {
    /**
     * Overlay: concrete predictions return void. Calls are a list.
     * The interface already returns void.
     */
    // @overlay-against: class CallbackPrediction implements \Prophecy\Prediction\PredictionInterface
    partial class CallbackPrediction {
        // @overlay-against: function check(array $calls, \Prophecy\Prophecy\ObjectProphecy $object, \Prophecy\Prophecy\MethodProphecy $method): mixed
        public function check(array<int|string, \Prophecy\Call\Call> $calls, \Prophecy\Prophecy\ObjectProphecy $object, \Prophecy\Prophecy\MethodProphecy $method): void;
    }

    // @overlay-against: class CallPrediction implements \Prophecy\Prediction\PredictionInterface
    partial class CallPrediction {
        // @overlay-against: function check(array $calls, \Prophecy\Prophecy\ObjectProphecy $object, \Prophecy\Prophecy\MethodProphecy $method): mixed
        public function check(array<int|string, \Prophecy\Call\Call> $calls, \Prophecy\Prophecy\ObjectProphecy $object, \Prophecy\Prophecy\MethodProphecy $method): void;
    }

    // @overlay-against: class CallTimesPrediction implements \Prophecy\Prediction\PredictionInterface
    partial class CallTimesPrediction {
        // @overlay-against: function check(array $calls, \Prophecy\Prophecy\ObjectProphecy $object, \Prophecy\Prophecy\MethodProphecy $method): mixed
        public function check(array<int|string, \Prophecy\Call\Call> $calls, \Prophecy\Prophecy\ObjectProphecy $object, \Prophecy\Prophecy\MethodProphecy $method): void;
    }

    // @overlay-against: class NoCallsPrediction implements \Prophecy\Prediction\PredictionInterface
    partial class NoCallsPrediction {
        // @overlay-against: function check(array $calls, \Prophecy\Prophecy\ObjectProphecy $object, \Prophecy\Prophecy\MethodProphecy $method): mixed
        public function check(array<int|string, \Prophecy\Call\Call> $calls, \Prophecy\Prophecy\ObjectProphecy $object, \Prophecy\Prophecy\MethodProphecy $method): void;
    }
}

namespace Prophecy\Prophecy {
    /**
     * Overlay: wildcard / prediction types live in this package.
     */
    // @overlay-against: class MethodProphecy
    partial class MethodProphecy {
        // @overlay-against: function getArgumentsWildcard(): \Argument\ArgumentsWildcard
        public function getArgumentsWildcard(): \Prophecy\Argument\ArgumentsWildcard;

        // @overlay-against: function getPrediction(): null|\Prediction\PredictionInterface
        public function getPrediction(): null|\Prophecy\Prediction\PredictionInterface;

        /**
         * @return array<int, \Prophecy\Prediction\PredictionInterface>
         */
        // @overlay-against: function getCheckedPredictions(): array
        public function getCheckedPredictions(): array<int, \Prophecy\Prediction\PredictionInterface>;
    }
}

namespace Prophecy\Util {
    /**
     * Overlay: stringify() export flag is bool.
     */
    // @overlay-against: class StringUtil
    partial class StringUtil {
        // @overlay-against: function stringify(mixed $value, boolean $exportObject): string
        public function stringify(mixed $value, bool $exportObject = true): string;
    }
}
