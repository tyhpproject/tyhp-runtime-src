{
    "name": "tyhpdef/spatie-error-solutions",
    "description": "Tyhp type definitions for the Composer package spatie/error-solutions (2.0.5).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.0.5.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/spatie-backtrace": "@dev",
                "tyhpdef/spatie-laravel-flare": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "spatie/error-solutions": "2.0.5"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/spatie-backtrace": "@dev",
        "tyhpdef/spatie-laravel-flare": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../spatie-backtrace/1.8.2"
        },
        {
            "type": "path",
            "url": "../../spatie-laravel-flare/2.8.0"
        }
    ]
}
