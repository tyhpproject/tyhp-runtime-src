<?tyhp

function test_classmap_create(): array<string, string>
{
    return \Composer\ClassMapGenerator\ClassMapGenerator::createMap('/tmp');
}

function test_classmap_scan(): \Composer\ClassMapGenerator\ClassMap
{
    $gen = new \Composer\ClassMapGenerator\ClassMapGenerator();
    $gen->scanPaths('/tmp');
    return $gen->getClassMap();
}
