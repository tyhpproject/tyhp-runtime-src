{
    "name": "tyhpdef/composer-class-map-generator",
    "description": "Tyhp type definitions for the Composer package composer/class-map-generator (1.7.3).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.7.3.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/composer-pcre": "@dev",
                "tyhpdef/symfony-finder": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "composer/class-map-generator": "^1.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/composer-pcre": "@dev",
        "tyhpdef/symfony-finder": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../composer-pcre/3.4.0"
        },
        {
            "type": "path",
            "url": "../../symfony-finder/7.4.19"
        }
    ]
}
