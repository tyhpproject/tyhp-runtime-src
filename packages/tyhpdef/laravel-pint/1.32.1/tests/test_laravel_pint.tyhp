<?tyhp

function test_pint_project_path(): mixed
{
    return \App\Project::path();
}

function test_pint_node_package_manager_detect(): \App\Enums\NodePackageManager
{
    return \App\Enums\NodePackageManager::detect('/');
}

function test_pint_prettier(): \App\Support\Prettier
{
    return new \App\Support\Prettier('.');
}

function test_pint_blade_formatter(): \App\BladeFormatter
{
    return new \App\BladeFormatter(new \App\Support\Prettier('.'));
}

function test_pint_collapse_short_slots(): \App\PrettierFormatters\CollapseShortSlots
{
    return new \App\PrettierFormatters\CollapseShortSlots();
}

function test_pint_prettier_exception(): \App\Exceptions\PrettierException
{
    return new \App\Exceptions\PrettierException('prettier failed');
}
