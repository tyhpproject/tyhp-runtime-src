<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `@internal` traits omitted from Layer 1. `HttplugFactory` implements
 * tyhpdef/php-http-message-factory interfaces.
 */

namespace Nyholm\Psr7 {
    /**
     * Internal trait used by Request and Response. Members already appear on those types in Layer 1.
     */
    trait MessageTrait {
    }

    /**
     * Overlay: constructor header map matches `MessageInterface::getHeaders()`.
     */
    // @overlay-against: class Request implements \Psr\Http\Message\RequestInterface, \Nyholm\Psr7\MessageTrait, \Nyholm\Psr7\RequestTrait
    partial class Request {
        /**
         * @param \Psr\Http\Message\HttpMethod $method
         * @param \Psr\Http\Message\HeaderMap $headers
         */
        // @overlay-against: function __construct(string $method, string|\Psr\Http\Message\UriInterface $uri, array $headers, string|resource|\Psr\Http\Message\StreamInterface|null $body, string $version): void
        public function __construct(\Psr\Http\Message\HttpMethod $method, string|\Psr\Http\Message\UriInterface $uri, \Psr\Http\Message\HeaderMap $headers = [], string|resource|\Psr\Http\Message\StreamInterface|null $body = null, string $version = '1.1'): void;
    }

    /**
     * Internal trait used by Request and ServerRequest.
     */
    trait RequestTrait {
    }

    /**
     * Overlay: status code is an int; reason phrase is a string; headers are a header map.
     */
    // @overlay-against: class Response implements \Psr\Http\Message\ResponseInterface, \Nyholm\Psr7\MessageTrait
    partial class Response {
        /**
         * @param \Psr\Http\Message\HeaderMap $headers
         */
        // @overlay-against: function __construct(int $status, array $headers, string|resource|\Psr\Http\Message\StreamInterface|null $body, string $version, ?string $reason): void
        public function __construct(int $status = 200, \Psr\Http\Message\HeaderMap $headers = [], string|resource|\Psr\Http\Message\StreamInterface|null $body = null, string $version = '1.1', ?string $reason = null): void;

        // @overlay-against: function withStatus(mixed $code, mixed $reasonPhrase): \Psr\Http\Message\ResponseInterface
        public function withStatus(int $code, string $reasonPhrase = ''): \Psr\Http\Message\ResponseInterface;
    }

    /**
     * Overlay: server, cookie, query, upload, and attribute maps match PSR-7.
     */
    // @overlay-against: class ServerRequest implements \Psr\Http\Message\ServerRequestInterface, \Nyholm\Psr7\MessageTrait, \Nyholm\Psr7\RequestTrait
    partial class ServerRequest {
        /**
         * @param \Psr\Http\Message\HttpMethod $method
         * @param \Psr\Http\Message\HeaderMap $headers
         * @param \Psr\Http\Message\ServerParams $serverParams
         */
        // @overlay-against: function __construct(string $method, string|\Psr\Http\Message\UriInterface $uri, array $headers, string|resource|\Psr\Http\Message\StreamInterface|null $body, string $version, array $serverParams): void
        public function __construct(\Psr\Http\Message\HttpMethod $method, string|\Psr\Http\Message\UriInterface $uri, \Psr\Http\Message\HeaderMap $headers = [], string|resource|\Psr\Http\Message\StreamInterface|null $body = null, string $version = '1.1', \Psr\Http\Message\ServerParams $serverParams = []): void;

        /**
         * @param T $default
         * @return T
         */
        // @overlay-against: function getAttribute(mixed $attribute, mixed $default): mixed
        public function getAttribute<T = mixed>(string $attribute, T $default = null): T;

        // @overlay-against: function getAttributes(): array
        public function getAttributes(): \Psr\Http\Message\RequestAttributes;

        // @overlay-against: function getCookieParams(): array
        public function getCookieParams(): \Psr\Http\Message\CookieParams;

        // @overlay-against: function getParsedBody(): array|object|null
        public function getParsedBody(): \Psr\Http\Message\ParsedBody;

        // @overlay-against: function getQueryParams(): array
        public function getQueryParams(): \Psr\Http\Message\QueryParams;

        // @overlay-against: function getServerParams(): array
        public function getServerParams(): \Psr\Http\Message\ServerParams;

        // @overlay-against: function getUploadedFiles(): array
        public function getUploadedFiles(): \Psr\Http\Message\UploadedFileTree;

        // @overlay-against: function withAttribute(mixed $attribute, mixed $value): \Psr\Http\Message\ServerRequestInterface
        public function withAttribute(string $attribute, mixed $value): \Psr\Http\Message\ServerRequestInterface;

        // @overlay-against: function withCookieParams(array $cookies): \Psr\Http\Message\ServerRequestInterface
        public function withCookieParams(\Psr\Http\Message\CookieParams $cookies): \Psr\Http\Message\ServerRequestInterface;

        // @overlay-against: function withParsedBody(mixed $data): \Psr\Http\Message\ServerRequestInterface
        public function withParsedBody(\Psr\Http\Message\ParsedBody $data): \Psr\Http\Message\ServerRequestInterface;

        // @overlay-against: function withQueryParams(array $query): \Psr\Http\Message\ServerRequestInterface
        public function withQueryParams(\Psr\Http\Message\QueryParams $query): \Psr\Http\Message\ServerRequestInterface;

        // @overlay-against: function withUploadedFiles(array $uploadedFiles): \Psr\Http\Message\ServerRequestInterface
        public function withUploadedFiles(\Psr\Http\Message\UploadedFileTree $uploadedFiles): \Psr\Http\Message\ServerRequestInterface;

        // @overlay-against: function withoutAttribute(mixed $attribute): \Psr\Http\Message\ServerRequestInterface
        public function withoutAttribute(string $attribute): \Psr\Http\Message\ServerRequestInterface;
    }

    /**
     * Overlay: stream primitives and `stream_get_meta_data()` shape.
     */
    // @overlay-against: class Stream implements \Psr\Http\Message\StreamInterface, \Nyholm\Psr7\StreamTrait
    partial class Stream {
        // @overlay-against: function detach(): mixed
        public function detach(): resource|null;

        /**
         * @return \StreamMetadata Metadata when `$key` is omitted.
         */
        // @overlay-against: function getMetadata(mixed $key): mixed
        public function getMetadata(null $key = null): \StreamMetadata;

        /**
         * @return mixed Value for `$key`, or null when the key is absent.
         */
        // @overlay-against: function getMetadata(mixed $key): mixed
        public function getMetadata(string $key): mixed;

        // @overlay-against: function read(mixed $length): string
        public function read(int $length): string;

        // @overlay-against: function seek(mixed $offset, mixed $whence): void
        public function seek(int $offset, int $whence = \SEEK_SET): void;

        // @overlay-against: function write(mixed $string): int
        public function write(string $string): int;
    }

    /**
     * Internal trait used by Stream.
     */
    trait StreamTrait {
    }

    /**
     * Overlay: `moveTo` target is a filesystem path.
     */
    // @overlay-against: class UploadedFile implements \Psr\Http\Message\UploadedFileInterface
    partial class UploadedFile {
        // @overlay-against: function moveTo(mixed $targetPath): void
        public function moveTo(string $targetPath): void;
    }

    /**
     * Overlay: URI mutators take strings; port is `?int`.
     */
    // @overlay-against: class Uri implements \Psr\Http\Message\UriInterface
    partial class Uri {
        // @overlay-against: function withFragment(mixed $fragment): \Psr\Http\Message\UriInterface
        public function withFragment(string $fragment): \Psr\Http\Message\UriInterface;

        // @overlay-against: function withHost(mixed $host): \Psr\Http\Message\UriInterface
        public function withHost(string $host): \Psr\Http\Message\UriInterface;

        // @overlay-against: function withPath(mixed $path): \Psr\Http\Message\UriInterface
        public function withPath(string $path): \Psr\Http\Message\UriInterface;

        // @overlay-against: function withPort(mixed $port): \Psr\Http\Message\UriInterface
        public function withPort(?int $port): \Psr\Http\Message\UriInterface;

        // @overlay-against: function withQuery(mixed $query): \Psr\Http\Message\UriInterface
        public function withQuery(string $query): \Psr\Http\Message\UriInterface;

        // @overlay-against: function withScheme(mixed $scheme): \Psr\Http\Message\UriInterface
        public function withScheme(string $scheme): \Psr\Http\Message\UriInterface;

        // @overlay-against: function withUserInfo(mixed $user, mixed $password): \Psr\Http\Message\UriInterface
        public function withUserInfo(string $user, ?string $password = null): \Psr\Http\Message\UriInterface;
    }
}

namespace Nyholm\Psr7\Factory {
    /**
     * Overlay: httplug factory arguments match the PSR-17 shapes.
     */
    // @overlay-against: class HttplugFactory implements \Http\Message\MessageFactory, \Http\Message\StreamFactory, \Http\Message\UriFactory
    partial class HttplugFactory {
        /**
         * @param \Psr\Http\Message\HeaderMap $headers
         */
        // @overlay-against: function createRequest(mixed $method, mixed $uri, array $headers, mixed $body, mixed $protocolVersion): \Psr\Http\Message\RequestInterface
        public function createRequest(\Psr\Http\Message\HttpMethod $method, string|\Psr\Http\Message\UriInterface $uri, \Psr\Http\Message\HeaderMap $headers = [], \Psr\Http\Message\StreamInterface|resource|string|null $body = null, string $protocolVersion = '1.1'): \Psr\Http\Message\RequestInterface;

        /**
         * @param \Psr\Http\Message\HeaderMap $headers
         */
        // @overlay-against: function createResponse(mixed $statusCode, mixed $reasonPhrase, array $headers, mixed $body, mixed $version): \Psr\Http\Message\ResponseInterface
        public function createResponse(int $statusCode = 200, ?string $reasonPhrase = null, \Psr\Http\Message\HeaderMap $headers = [], \Psr\Http\Message\StreamInterface|resource|string|null $body = null, string $version = '1.1'): \Psr\Http\Message\ResponseInterface;

        // @overlay-against: function createStream(mixed $body): \Psr\Http\Message\StreamInterface
        public function createStream(\Psr\Http\Message\StreamInterface|resource|string|null $body = null): \Psr\Http\Message\StreamInterface;

        // @overlay-against: function createUri(mixed $uri): \Psr\Http\Message\UriInterface
        public function createUri(string $uri = ''): \Psr\Http\Message\UriInterface;
    }

    /**
     * Overlay: URI and server-param arguments match PSR-17.
     */
    // @overlay-against: class Psr17Factory implements \Psr\Http\Message\RequestFactoryInterface, \Psr\Http\Message\ResponseFactoryInterface, \Psr\Http\Message\ServerRequestFactoryInterface, \Psr\Http\Message\StreamFactoryInterface, \Psr\Http\Message\UploadedFileFactoryInterface, \Psr\Http\Message\UriFactoryInterface
    partial class Psr17Factory {
        // @overlay-against: function createRequest(string $method, mixed $uri): \Psr\Http\Message\RequestInterface
        public function createRequest(\Psr\Http\Message\HttpMethod $method, string|\Psr\Http\Message\UriInterface $uri): \Psr\Http\Message\RequestInterface;

        // @overlay-against: function createServerRequest(string $method, mixed $uri, array $serverParams): \Psr\Http\Message\ServerRequestInterface
        public function createServerRequest(\Psr\Http\Message\HttpMethod $method, string|\Psr\Http\Message\UriInterface $uri, \Psr\Http\Message\ServerParams $serverParams = []): \Psr\Http\Message\ServerRequestInterface;

        // @overlay-against: function createStreamFromResource(mixed $resource): \Psr\Http\Message\StreamInterface
        public function createStreamFromResource(resource $resource): \Psr\Http\Message\StreamInterface;
    }
}
