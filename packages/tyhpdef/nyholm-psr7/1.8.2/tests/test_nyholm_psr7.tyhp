<?tyhp

function test_nyholm_request(\Psr\Http\Message\UriInterface $uri): \Psr\Http\Message\RequestInterface
{
    return new \Nyholm\Psr7\Request('GET', $uri);
}

function test_nyholm_response(): \Psr\Http\Message\ResponseInterface
{
    return new \Nyholm\Psr7\Response(204);
}

function test_nyholm_uri(string $uri): \Psr\Http\Message\UriInterface
{
    return new \Nyholm\Psr7\Uri($uri);
}
