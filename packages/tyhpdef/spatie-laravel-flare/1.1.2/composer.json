{
    "name": "tyhpdef/spatie-laravel-flare",
    "description": "Tyhp type definitions for the Composer package spatie/laravel-flare (1.1.2).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.1.2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/php-ext-curl": "@dev",
                "tyhpdef/php-ext-mbstring": "@dev",
                "tyhpdef/illuminate-support": "@dev",
                "tyhpdef/illuminate-contracts": "@dev",
                "tyhpdef/illuminate-console": "@dev",
                "tyhpdef/illuminate-http": "@dev",
                "tyhpdef/illuminate-config": "@dev",
                "tyhpdef/illuminate-queue": "@dev",
                "tyhpdef/illuminate-log": "@dev",
                "tyhpdef/illuminate-database": "@dev",
                "tyhpdef/illuminate-view": "@dev",
                "tyhpdef/spatie-backtrace": "@dev",
                "tyhpdef/spatie-flare-client-php": "@dev",
                "tyhpdef/spatie-error-solutions": "@dev",
                "tyhpdef/symfony-console": "@dev",
                "tyhpdef/symfony-var-dumper": "@dev",
                "tyhpdef/monolog-monolog": "@dev",
                "tyhpdef/livewire-livewire": "@dev",
                "tyhpdef/spatie-laravel-error-share": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "spatie/laravel-flare": "1.1.2"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/php-ext-curl": "@dev",
        "tyhpdef/php-ext-mbstring": "@dev",
        "tyhpdef/spatie-backtrace": "@dev",
        "tyhpdef/spatie-flare-client-php": "@dev",
        "tyhpdef/spatie-error-solutions": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/symfony-var-dumper": "@dev",
        "tyhpdef/monolog-monolog": "@dev",
        "tyhpdef/livewire-livewire": "@dev",
        "tyhpdef/spatie-laravel-error-share": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../php-ext-curl"
        },
        {
            "type": "path",
            "url": "../../php-ext-mbstring"
        },
        {
            "type": "path",
            "url": "../../spatie-backtrace/1.8.2"
        },
        {
            "type": "path",
            "url": "../../spatie-flare-client-php/1.11.1"
        },
        {
            "type": "path",
            "url": "../../spatie-error-solutions/1.1.3"
        },
        {
            "type": "path",
            "url": "../../symfony-console/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-var-dumper/7.4.18"
        },
        {
            "type": "path",
            "url": "../../monolog-monolog/3.12.0"
        },
        {
            "type": "path",
            "url": "../../livewire-livewire/4.4.5"
        },
        {
            "type": "path",
            "url": "../../spatie-laravel-error-share/1.0.10"
        }
    ]
}
