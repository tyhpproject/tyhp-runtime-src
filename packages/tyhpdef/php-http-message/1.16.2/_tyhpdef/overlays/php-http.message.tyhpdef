        /**
         * @param array<int|string, \Http\Message\Cookie> $cookies
         */
        // @overlay-against: function removeCookies(array $cookies): mixed
        public function removeCookies(array<int|string, \Http\Message\Cookie> $cookies): void;

        // @overlay-against: function addCookie(\Http\Message\Cookie $cookie): mixed
        public function addCookie(\Http\Message\Cookie $cookie): void;

        // @overlay-against: function removeCookie(\Http\Message\Cookie $cookie): mixed
        public function removeCookie(\Http\Message\Cookie $cookie): void;

        // @overlay-against: function clear(): mixed
