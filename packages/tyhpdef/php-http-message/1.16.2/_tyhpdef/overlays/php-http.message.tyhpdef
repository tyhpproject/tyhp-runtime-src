    }

    /**
     * Overlay: jar lists use `array<int|string, Cookie>`; `count()` is int.
     */
    // @overlay-against: class CookieJar implements \Countable, \IteratorAggregate
    partial class CookieJar {
        /**
         * @param array<int|string, \Http\Message\Cookie> $cookies
