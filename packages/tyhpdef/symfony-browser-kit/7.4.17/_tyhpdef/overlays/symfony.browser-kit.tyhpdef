<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * AbstractBrowser request/click parameter maps. Harvest left bare `array`.
 */

namespace Symfony\Component\BrowserKit {
    /**
     * Header map: one string, or a list of strings when the header is repeated.
     */
    type ResponseHeaders = array<string, string|array<int|string, string>>;

    /**
     * JSON object/array tree from `Response::toArray()` (`json_decode` associative, known to be an array).
     */
    type ResponseJson = array<int|string, string|int|float|bool|null|\Symfony\Component\BrowserKit\ResponseJson>;

    /**
     * Overlay: harvest typed `$parameters` / `$files` / `$server` as `array`.
     * Server values are strings (`setServerParameter`).
     */
    // @overlay-against: class AbstractBrowser
    partial class AbstractBrowser {
        /**
         * @param array<string, string> $server
         */
        // @overlay-against: function __construct(array $server, ?\Symfony\Component\BrowserKit\History $history, ?\Symfony\Component\BrowserKit\CookieJar $cookieJar): void
        public function __construct(array<string, string> $server = [], ?\Symfony\Component\BrowserKit\History $history = null, ?\Symfony\Component\BrowserKit\CookieJar $cookieJar = null): void;

        /**
         * @param array<string, string> $serverParameters
         */
        // @overlay-against: function click(\Symfony\Component\DomCrawler\Link $link, array $serverParameters): \Symfony\Component\DomCrawler\Crawler
        public function click(\Symfony\Component\DomCrawler\Link $link, array<string, string> $serverParameters = []): \Symfony\Component\DomCrawler\Crawler;

        /**
         * @param array<string, string> $serverParameters
         */
        // @overlay-against: function clickLink(string $linkText, array $serverParameters): \Symfony\Component\DomCrawler\Crawler
        public function clickLink(string $linkText, array<string, string> $serverParameters = []): \Symfony\Component\DomCrawler\Crawler;

        /**
         * @param array<int|string, mixed> $parameters JSON payload encoded as the request body.
         * @param array<string, string> $server
         */
        // @overlay-against: function jsonRequest(string $method, string $uri, array $parameters, array $server, bool $changeHistory): \Symfony\Component\DomCrawler\Crawler
        public function jsonRequest(string $method, string $uri, array<int|string, mixed> $parameters = [], array<string, string> $server = [], bool $changeHistory = true): \Symfony\Component\DomCrawler\Crawler;

        /**
         * @param array<string, mixed> $parameters
         * @param array<string, mixed> $files
         * @param array<string, string> $server
         */
        // @overlay-against: function request(string $method, string $uri, array $parameters, array $files, array $server, ?string $content, bool $changeHistory): \Symfony\Component\DomCrawler\Crawler
        public function request(string $method, string $uri, array<string, mixed> $parameters = [], array<string, mixed> $files = [], array<string, string> $server = [], ?string $content = null, bool $changeHistory = true): \Symfony\Component\DomCrawler\Crawler;

        /**
         * @param array<string, string> $server
         */
        // @overlay-against: function setServerParameters(array $server): void
        public function setServerParameters(array<string, string> $server): void;

        /**
         * @param array<string, mixed> $values
         * @param array<string, string> $serverParameters
         */
        // @overlay-against: function submit(\Symfony\Component\DomCrawler\Form $form, array $values, array $serverParameters): \Symfony\Component\DomCrawler\Crawler
        public function submit(\Symfony\Component\DomCrawler\Form $form, array<string, mixed> $values = [], array<string, string> $serverParameters = []): \Symfony\Component\DomCrawler\Crawler;

        /**
         * @param array<string, mixed> $fieldValues
         * @param array<string, string> $serverParameters
         */
        // @overlay-against: function submitForm(string $button, array $fieldValues, string $method, array $serverParameters): \Symfony\Component\DomCrawler\Crawler
        public function submitForm(string $button, array<string, mixed> $fieldValues = [], string $method = 'POST', array<string, string> $serverParameters = []): \Symfony\Component\DomCrawler\Crawler;

        /**
         * @param array<string, mixed> $parameters
         * @param array<string, mixed> $files
         * @param array<string, string> $server
         */
        // @overlay-against: function xmlHttpRequest(string $method, string $uri, array $parameters, array $files, array $server, ?string $content, bool $changeHistory): \Symfony\Component\DomCrawler\Crawler
        public function xmlHttpRequest(string $method, string $uri, array<string, mixed> $parameters = [], array<string, mixed> $files = [], array<string, string> $server = [], ?string $content = null, bool $changeHistory = true): \Symfony\Component\DomCrawler\Crawler;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `CookieJar`.
     */
    // @overlay-against: class CookieJar
    partial class CookieJar {
        /**
         * @return array<\Symfony\Component\BrowserKit\Cookie>
         */
        // @overlay-against: function all(): array
        public function all(): array<\Symfony\Component\BrowserKit\Cookie>;

        /**
         * @return array<string, string>
         */
        // @overlay-against: function allRawValues(string $uri): array
        public function allRawValues(string $uri): array<string, string>;

        /**
         * @return array<string, string>
         */
        // @overlay-against: function allValues(string $uri, bool $returnsRawValue): array
        public function allValues(string $uri, bool $returnsRawValue = false): array<string, string>;

        /**
         * @param array<string> $setCookies
         */
        // @overlay-against: function updateFromSetCookie(array $setCookies, ?string $uri): void
        public function updateFromSetCookie(array<string> $setCookies, ?string $uri = null): void;
    }

    /**
     * Vendor `@template-extends AbstractBrowser<Request, Response>`.
     */
    // @overlay-against: class HttpBrowser extends \Symfony\Component\BrowserKit\AbstractBrowser
    partial class HttpBrowser extends \Symfony\Component\BrowserKit\AbstractBrowser<\Symfony\Component\BrowserKit\Request, \Symfony\Component\BrowserKit\Response>;

    /**
     * Overlay: headers copied from the server bag are name => value.
     */
    // @overlay-against: class HttpBrowser extends \Symfony\Component\BrowserKit\AbstractBrowser
    partial class HttpBrowser {
        /**
         * @return array<string, string>
         */
        // @overlay-against: function getHeaders(\Symfony\Component\BrowserKit\Request $request): array
        protected function getHeaders(\Symfony\Component\BrowserKit\Request $request): array<string, string>;
    }

    /**
     * Overlay: request bags harvest left as bare `array`.
     */
    // @overlay-against: class Request
    partial class Request {
        /**
         * @param array<string, mixed> $parameters
         * @param array<string, mixed> $files
         * @param array<string, string> $cookies
         * @param array<string, string> $server
         */
        // @overlay-against: function __construct(string $uri, string $method, array $parameters, array $files, array $cookies, array $server, ?string $content): void
        public function __construct(string $uri, string $method, array<string, mixed> $parameters = [], array<string, mixed> $files = [], array<string, string> $cookies = [], array<string, string> $server = [], ?string $content = null): void;

        /**
         * @return array<string, string>
         */
        // @overlay-against: function getCookies(): array
        public function getCookies(): array<string, string>;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function getFiles(): array
        public function getFiles(): array<string, mixed>;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function getParameters(): array
        public function getParameters(): array<string, mixed>;

        /**
         * @return array<string, string>
         */
        // @overlay-against: function getServer(): array
        public function getServer(): array<string, string>;
    }

    /**
     * Overlay: header map and JSON body harvest left as bare `array`.
     */
    // @overlay-against: class Response
    partial class Response {
        /**
         * @param \Symfony\Component\BrowserKit\ResponseHeaders $headers
         */
        // @overlay-against: function __construct(string $content, int $status, array $headers): void
        public function __construct(string $content = '', int $status = 200, \Symfony\Component\BrowserKit\ResponseHeaders $headers = []): void;

        /**
         * @return array<int|string, string>
         */
        // @overlay-against: function getHeader(string $header, bool $first): string|array|null
        public function getHeader(string $header, true $first = true): ?string;

        /**
         * @return array<int|string, string>
         */
        // @overlay-against: function getHeader(string $header, bool $first): string|array|null
        public function getHeader(string $header, false $first): array<int|string, string>;

        /**
         * @return string|array<int|string, string>|null
         */
        // @overlay-against: function getHeader(string $header, bool $first): string|array|null
        public function getHeader(string $header, bool $first = true): string|array<int|string, string>|null;

        /**
         * @return \Symfony\Component\BrowserKit\ResponseHeaders
         */
        // @overlay-against: function getHeaders(): array
        public function getHeaders(): \Symfony\Component\BrowserKit\ResponseHeaders;

        /**
         * @return \Symfony\Component\BrowserKit\ResponseJson
         */
        // @overlay-against: function toArray(): array
        public function toArray(): \Symfony\Component\BrowserKit\ResponseJson;
    }
}
