<?tyhp

function test_backtrace_create(): \Spatie\Backtrace\Backtrace
{
    return \Spatie\Backtrace\Backtrace::create();
}

function test_backtrace_frames(): array<int, \Spatie\Backtrace\Frame>
{
    return \Spatie\Backtrace\Backtrace::create()->frames();
}

function test_backtrace_offset(\Spatie\Backtrace\Backtrace $backtrace): \Spatie\Backtrace\Backtrace
{
    return $backtrace->offset(0);
}
