<?tyhp

class User {}

function test_orm_configuration(): \Doctrine\ORM\Configuration
{
    return new \Doctrine\ORM\Configuration();
}

function test_orm_query_builder(\Doctrine\ORM\EntityManagerInterface $em): \Doctrine\ORM\QueryBuilder
{
    return $em->createQueryBuilder()->select('u.id', 'u.name')->from('User', 'u');
}

function test_orm_entity_repository(\Doctrine\ORM\EntityManagerInterface $em): \Doctrine\ORM\EntityRepository<User>
{
    return $em->getRepository(User::class);
}

function test_orm_unit_of_work(\Doctrine\ORM\EntityManagerInterface $em): \Doctrine\ORM\UnitOfWork
{
    return $em->getUnitOfWork();
}
