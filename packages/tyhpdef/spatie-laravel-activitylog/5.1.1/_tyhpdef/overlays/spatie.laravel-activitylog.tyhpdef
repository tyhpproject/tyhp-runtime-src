namespace Spatie\Activitylog\Actions {
    // @overlay-against: class LogActivityAction
    partial class LogActivityAction {
        /**
         * Overlay: `LogActivityAction::beforeLogging()` uses the documented types.
         */
        // @overlay-against: function beforeLogging(\Closure $callback): void
        public static function beforeLogging(\Closure<callable(\Spatie\Activitylog\Contracts\Activity): void> $callback): void;
    }
}

namespace Spatie\Activitylog\Facades {
    // @overlay-against: class Activity extends \Illuminate\Support\Facades\Facade
    partial class Activity {
        /**
         * Overlay: `Activity::defaultCauser()` with no callback returns the pending log.
         */
        // @overlay-against: function defaultCauser(\Illuminate\Database\Eloquent\Model|null $causer, \Closure|null $callback): mixed
        public static function defaultCauser(?\Illuminate\Database\Eloquent\Model $causer, null $callback = null): \Spatie\Activitylog\Support\PendingActivityLog;

        /**
         * Overlay: `Activity::defaultCauser()` returns the callback result when a callback is passed.
         */
        // @overlay-against: function defaultCauser(\Illuminate\Database\Eloquent\Model|null $causer, \Closure|null $callback): mixed
        public static function defaultCauser<TReturn>(?\Illuminate\Database\Eloquent\Model $causer, \Closure<callable(): TReturn> $callback): TReturn;

        /**
         * Overlay: `Activity::tap()` receives the activity and an optional event name.
         */
        // @overlay-against: function tap(callable $callback, string|null $eventName): \Spatie\Activitylog\Support\ActivityLogger
        public static function tap(callable(\Spatie\Activitylog\Contracts\Activity, ?string): mixed $callback, string|null $eventName): \Spatie\Activitylog\Support\ActivityLogger;

        /**
         * Overlay: `Activity::withoutLogging()` returns the callback result.
         */
        // @overlay-against: function withoutLogging(\Closure $callback): mixed
        public static function withoutLogging<TReturn>(\Closure<callable(): TReturn> $callback): TReturn;
    }
}

namespace Spatie\Activitylog\Models {
    // @overlay-against: class Activity extends \Illuminate\Database\Eloquent\Model implements \Spatie\Activitylog\Contracts\Activity
    partial class Activity {
        /**
         * Overlay: `Activity::scopeInLog()` accepts log names or one list of them.
         */
        // @overlay-against: function scopeInLog(\Illuminate\Database\Eloquent\Builder $query, \BackedEnum|string|array $logNames): \Illuminate\Database\Eloquent\Builder
        public function scopeInLog(\Illuminate\Database\Eloquent\Builder $query, \BackedEnum|string|array<int, \BackedEnum|string> ...$logNames): \Illuminate\Database\Eloquent\Builder;
    }
}

namespace Spatie\Activitylog\Models\Concerns {
    // @overlay-against: trait LogsActivity
