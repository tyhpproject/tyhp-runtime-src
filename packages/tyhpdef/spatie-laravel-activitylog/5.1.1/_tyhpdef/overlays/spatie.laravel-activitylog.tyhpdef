        public static function extractChanges(\Illuminate\Database\Eloquent\Model $model): array<string, mixed>;
    }
}

namespace Spatie\Activitylog\Support {
    /**
     * Overlay: `ChangeDetector::filterDirty()` returns the changed attributes and their previous values.
     */
    type ChangeDetectorDirty = struct {
        array<string, mixed> $attributes;
        array<string, mixed> $old;
    };

    // @overlay-against: class ActivityLogger implements \Illuminate\Support\Traits\Conditionable, \Illuminate\Support\Traits\Macroable
    partial class ActivityLogger {
        /**
         * Overlay: `ActivityLogger::tap()` receives the activity and an optional event name.
         */
        // @overlay-against: function tap(callable $callback, ?string $eventName): static
        public function tap(callable(\Spatie\Activitylog\Contracts\Activity, ?string): mixed $callback, ?string $eventName = null): static;

        /**
         * Overlay: `ActivityLogger::withChanges()` stores attribute changes.
         */
        // @overlay-against: function withChanges(array|\Illuminate\Support\Collection $changes): static
        public function withChanges(array<string, mixed>|\Illuminate\Support\Collection<string, mixed> $changes): static;

        /**
         * Overlay: `ActivityLogger::withProperties()` stores activity properties.
         */
        // @overlay-against: function withProperties(array|\Illuminate\Support\Collection $properties): static
        public function withProperties(array<string, mixed>|\Illuminate\Support\Collection<string, mixed> $properties): static;

        /**
         * Overlay: `ActivityLogger::withoutLogging()` returns the callback result.
         */
        // @overlay-against: function withoutLogging(\Closure $callback): mixed
        public function withoutLogging<TReturn>(\Closure<callable(): TReturn> $callback): TReturn;
    }

    // @overlay-against: class CauserResolver
    partial class CauserResolver {
        /**
         * Overlay: `CauserResolver::resolveUsing()` receives the subject and returns a model or null.
         */
        // @overlay-against: function resolveUsing(\Closure $callback): static
        public function resolveUsing(\Closure<callable(\Illuminate\Database\Eloquent\Model|int|string|null): \Illuminate\Database\Eloquent\Model|null> $callback): static;

        /**
         * Overlay: `CauserResolver::withCauser()` returns the callback result.
         */
        // @overlay-against: function withCauser(?\Illuminate\Database\Eloquent\Model $causer, \Closure $callback): mixed
        public function withCauser<TReturn>(?\Illuminate\Database\Eloquent\Model $causer, \Closure<callable(): TReturn> $callback): TReturn;
    }

    // @overlay-against: class ChangeDetector
    partial class ChangeDetector {
        /**
         * Overlay: `ChangeDetector::filterDirty()` returns changed attributes and previous values.
         */
        // @overlay-against: function filterDirty(array $newAttributes, array $oldAttributes): array
        public static function filterDirty(array<string, mixed> $newAttributes, array<string, mixed> $oldAttributes): ChangeDetectorDirty;

        /**
         * Overlay: `ChangeDetector::resolveRelatedAttribute()` maps one path to a value.
         */
        // @overlay-against: function resolveRelatedAttribute(\Illuminate\Database\Eloquent\Model $model, string $attribute): array
        public static function resolveRelatedAttribute(\Illuminate\Database\Eloquent\Model $model, string $attribute): array<string, mixed>;
    }

    // @overlay-against: class LogOptions
    partial class LogOptions {
        /**
         * Overlay: `LogOptions::$attributeRawValues` is a list of attribute names.
         */
        // @overlay-against: array $attributeRawValues
        public array<int, string> $attributeRawValues ?? [];

        /**
         * Overlay: `LogOptions::$descriptionForEvent` receives the event name and returns the description.
         */
        // @overlay-against: ?\Closure $descriptionForEvent
        public ?\Closure<callable(string): string> $descriptionForEvent ?? null;

        /**
         * Overlay: `LogOptions::$dontLogIfAttributesChangedOnly` is a list of attribute names.
         */
        // @overlay-against: array $dontLogIfAttributesChangedOnly
        public array<int, string> $dontLogIfAttributesChangedOnly ?? [];

        /**
         * Overlay: `LogOptions::$logAttributes` is a list of attribute names.
         */
        // @overlay-against: array $logAttributes
        public array<int, string> $logAttributes ?? [];

        /**
         * Overlay: `LogOptions::$logExceptAttributes` is a list of attribute names.
         */
        // @overlay-against: array $logExceptAttributes
        public array<int, string> $logExceptAttributes ?? [];

        /**
         * Overlay: `LogOptions::__serialize()` returns the public option bag.
         */
        // @overlay-against: function __serialize(): array
        public function __serialize(): array<string, mixed>;

        /**
         * Overlay: `LogOptions::__unserialize()` restores the public option bag.
         */
        // @overlay-against: function __unserialize(array $data): void
        public function __unserialize(array<string, mixed> $data): void;

        /**
         * Overlay: `LogOptions::setDescriptionForEvent()` stores a closure of the event name.
         */
        // @overlay-against: function setDescriptionForEvent(\Closure $callback): self
        public function setDescriptionForEvent(\Closure<callable(string): string> $callback): self;
    }

    // @overlay-against: class PendingActivityLog implements \Illuminate\Support\Traits\ForwardsCalls
    partial class PendingActivityLog {
        /**
         * Overlay: `PendingActivityLog::beforeLogging()` uses the documented types.
         */
        // @overlay-against: function beforeLogging(\Closure $callback): void
        public static function beforeLogging(\Closure<callable(\Spatie\Activitylog\Contracts\Activity): void> $callback): void;

        /**
         * Overlay: `PendingActivityLog::__call()` forwards argument lists to `ActivityLogger`.
         */
        // @overlay-against: function __call(string $method, array $parameters): mixed
        public function __call(string $method, array<int, mixed> $parameters): mixed;

        /**
         * Overlay: `PendingActivityLog::defaultCauser()` with no callback returns this log.
         */
        // @overlay-against: function defaultCauser(?\Illuminate\Database\Eloquent\Model $causer, ?\Closure $callback): mixed
        public function defaultCauser(?\Illuminate\Database\Eloquent\Model $causer, null $callback = null): self;

        /**
         * Overlay: `PendingActivityLog::defaultCauser()` returns the callback result when a callback is passed.
         */
        // @overlay-against: function defaultCauser(?\Illuminate\Database\Eloquent\Model $causer, ?\Closure $callback): mixed
        public function defaultCauser<TReturn>(?\Illuminate\Database\Eloquent\Model $causer, \Closure<callable(): TReturn> $callback): TReturn;
    }
