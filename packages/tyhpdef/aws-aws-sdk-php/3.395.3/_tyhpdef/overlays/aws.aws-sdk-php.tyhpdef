<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Core SDK + S3 client surface used by Flysystem and Laravel Vapor.
 */

namespace Aws {
    /**
     * HTTP response holder used by AwsException. Layer 1 omitted this interface.
     */
    interface ResponseContainerInterface {
        public function getResponse(): ?\Psr\Http\Message\ResponseInterface;
    }

    /**
     * Iterator over paginated operation results.
     */
    class ResultPaginator implements \Iterator {
        /**
         * @param array<string, mixed> $args
         * @param array<string, mixed> $config
         */
        public function __construct(\Aws\AwsClientInterface $client, string $operation, array<string, mixed> $args, array<string, mixed> $config);

        public function current(): mixed;
        public function next(): void;
        public function key(): mixed;
        public function valid(): bool;
        public function rewind(): void;
    }

    /**
     * Polls a resource until a terminal state.
     */
    class Waiter {
        public function promise(): \GuzzleHttp\Promise\PromiseInterface;
    }

    /**
     * Internal request-metrics accumulator. Layer 1 omitted this `@internal` type.
     */
    final class MetricsBuilder {
    }

    /**
     * Builds named service clients. Layer 1 skipped Sdk.php because of hundreds of @method clients.
     */
    class Sdk {
        /**
         * @param array<string, mixed> $args
         */
        public function __construct(array<string, mixed> $args = []);

        /**
         * @param array<string, mixed> $args
         */
        public function createClient(string $name, array<string, mixed> $args = []): \Aws\AwsClientInterface;

        /**
         * @param array<string, mixed> $args
         */
        public function createS3(array<string, mixed> $args = []): \Aws\S3\S3Client;

        /**
         * @param array<string, mixed> $args
         */
        public function copy(array<string, mixed> $args = []): self;
    }

    /**
     * Overlay: constructor args and result keys are string-keyed.
     */
    // @overlay-against: class AwsClient implements \Aws\AwsClientInterface, \Aws\AwsClientTrait
    partial class AwsClient {
        // @overlay-against: function factory(array $config): static
        public static function factory(array<string, mixed> $config = []): static;

        // @overlay-against: function getArguments(): array
        public static function getArguments(): array<string, mixed>;

        /**
         * @param array<string, mixed> $args
         */
        // @overlay-against: function __construct(array $args): void
        public function __construct(array<string, mixed> $args);

        // @overlay-against: function __sleep(): mixed
        public function __sleep(): never;

        // @overlay-against: function getApi(): mixed
        public function getApi(): \Aws\Api\Service;

        // @overlay-against: function getClientBuiltIns(): array
        public function getClientBuiltIns(): array<string, mixed>;

        // @overlay-against: function getClientContextParams(): array
        public function getClientContextParams(): array<string, mixed>;

        // @overlay-against: function getCommand(mixed $name, array $args): mixed
        public function getCommand(string $name, array<string, mixed> $args = []): \Aws\Command;

        // @overlay-against: function getConfig(mixed $option): mixed
        public function getConfig(null $option = null): array<string, mixed>;

        // @overlay-against: function getConfig(mixed $option): mixed
        public function getConfig(string $option): mixed;

        // @overlay-against: function getCredentials(): mixed
        public function getCredentials(): \GuzzleHttp\Promise\PromiseInterface;

        // @overlay-against: function getEndpoint(): mixed
        public function getEndpoint(): \Psr\Http\Message\UriInterface;

        // @overlay-against: function getEndpointProvider(): mixed
        public function getEndpointProvider(): \Aws\EndpointV2\EndpointProviderV2|callable;

        // @overlay-against: function getEndpointProviderArgs(): array
        public function getEndpointProviderArgs(): array<string, mixed>;

        // @overlay-against: function getHandlerList(): mixed
        public function getHandlerList(): \Aws\HandlerList;

        // @overlay-against: function getRegion(): mixed
        public function getRegion(): string;

        // @overlay-against: function getSignatureProvider(): callable
        public final function getSignatureProvider(): (callable(string, string, string): mixed);
    }

    /**
     * Overlay: result maps are string-keyed; search() takes a JMESPath string.
     */
    // @overlay-against: class Result implements \Aws\ResultInterface, \Aws\MonitoringEventsInterface, \Aws\HasDataTrait, \Aws\HasMonitoringEventsTrait
    partial class Result {
        /**
         * @param array<string, mixed> $data
         */
        // @overlay-against: function __construct(array $data): void
        public function __construct(array<string, mixed> $data = []);

        // @overlay-against: function __toString(): mixed
        public function __toString(): string;

        // @overlay-against: function get(mixed $key): mixed
        public function get(string $key): mixed;

        // @overlay-against: function hasKey(mixed $name): mixed
        public function hasKey(string $name): bool;

        // @overlay-against: function search(mixed $expression): mixed
        public function search(string $expression): mixed;

        /**
         * @return array<string, mixed>
         */
        public function toArray(): array<string, mixed>;
    }

    /**
     * Overlay: command name, handler list, and parameter map.
     */
    // @overlay-against: class Command implements \Aws\CommandInterface, \Aws\HasDataTrait
    partial class Command {
        // @overlay-against: function getAuthSchemes(): mixed
        public function getAuthSchemes(): array<int|string, mixed>;

        // @overlay-against: function getHandlerList(): mixed
        public function getHandlerList(): \Aws\HandlerList;

        // @overlay-against: function getName(): mixed
        public function getName(): string;

        // @overlay-against: function hasParam(mixed $name): mixed
        public function hasParam(string $name): bool;
    }

    /**
     * Overlay: trait methods match the client interface where the body is monomorphic.
     */
    // @overlay-against: trait AwsClientTrait
    partial trait AwsClientTrait {
        // @overlay-against: function __call(mixed $name, array $args): mixed
        public function __call(string $name, array<int, mixed> $args): \Aws\ResultInterface|\GuzzleHttp\Promise\PromiseInterface;

        // @overlay-against: function execute(\Aws\CommandInterface $command): mixed
        public function execute(\Aws\CommandInterface $command): \Aws\ResultInterface;

        // @overlay-against: function executeAsync(\Aws\CommandInterface $command): mixed
        public function executeAsync(\Aws\CommandInterface $command): \GuzzleHttp\Promise\PromiseInterface;

        // @overlay-against: function getPaginator(mixed $name, array $args): mixed
        public function getPaginator(string $name, array<string, mixed> $args = []): \Aws\ResultPaginator;

        // @overlay-against: function getWaiter(mixed $name, array $args): mixed
        public function getWaiter(string|callable $name, array<string, mixed> $args = []): \Aws\Waiter;
    }
}

namespace Aws\S3 {
