{
    "name": "tyhpdef/aws-aws-sdk-php",
    "description": "Tyhp type definitions for the Composer package aws/aws-sdk-php (3.395.3).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "3.395.3.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/guzzlehttp-promises": "@dev",
                "tyhpdef/psr-http-message": "@dev",
                "tyhpdef/guzzlehttp-guzzle": "@dev",
                "tyhpdef/guzzlehttp-psr7": "@dev",
                "tyhpdef/mtdowling-jmespath.php": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "aws/aws-sdk-php": "3.395.3"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/guzzlehttp-promises": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/guzzlehttp-guzzle": "@dev",
        "tyhpdef/guzzlehttp-psr7": "@dev",
        "tyhpdef/mtdowling-jmespath.php": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-guzzle/8.2.0"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-promises/3.0.2"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-psr7/3.1.0"
        },
        {
            "type": "path",
            "url": "../../mtdowling-jmespath.php/2.9.2"
        },
        {
            "type": "path",
            "url": "../../psr-http-message/2.0"
        }
    ]
}
