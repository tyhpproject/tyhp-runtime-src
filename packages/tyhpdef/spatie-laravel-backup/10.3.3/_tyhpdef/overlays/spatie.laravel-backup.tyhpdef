}

namespace Spatie\Backup\Notifications {
    // @overlay-against: class EventHandler
    partial class EventHandler {
        // @overlay-against: function determineNotifiable(): \Spatie\Backup\Notifications\Notifiable
        omit function determineNotifiable();
    }

    // @overlay-against: class Notifiable implements \Illuminate\Notifications\Notifiable
    omit class Notifiable {
    }
}

namespace Spatie\Backup\Notifications\Channels\Discord {
    /**
     * Overlay: one Discord embed.
     */
    type DiscordMessageEmbed = struct {
        string $title;
        ?string $url;
        string $type;
        string $description;
        array<int, DiscordMessageField> $fields;
        int $color;
        DiscordMessageFooter $footer;
        string|\DateTimeInterface $timestamp;
    };

    /**
     * Overlay: one Discord embed field.
     */
    type DiscordMessageField = struct {
        string $name;
        string $value;
        bool $inline;
    };

    /**
     * Overlay: Discord embed footer.
     */
    type DiscordMessageFooter = struct {
        string $text;
    };

    /**
     * Overlay: `DiscordMessage::toArray()` payload. `username` is omitted when empty.
     */
    type DiscordMessagePayload = struct {
        ?string $avatar_url;
        array<int, DiscordMessageEmbed> $embeds;
        ?string $username;
    };

    // @overlay-against: class DiscordChannel
    omit class DiscordChannel {
    }

    // @overlay-against: class DiscordMessage
    partial class DiscordMessage {
        /**
         * Overlay: `DiscordMessage::toArray()` returns the webhook payload.
         */
        // @overlay-against: function toArray(): array
        public function toArray(): DiscordMessagePayload;
    }
}

namespace Spatie\Backup\Notifications\Channels\Webhook {
    // @overlay-against: class WebhookChannel
    omit class WebhookChannel {
    }
}

namespace Spatie\Backup\Support {
    // @overlay-against: class BackupLogger
