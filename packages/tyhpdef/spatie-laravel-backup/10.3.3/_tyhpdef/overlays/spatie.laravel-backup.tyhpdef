        public static function create(array<int, string>|string $includeFilesAndDirectories = []): static;

        /**
         * Overlay: `FileSelection::__construct()` takes paths or one path.
         */
        // @overlay-against: function __construct(array|string $includeFilesAndDirectories): void
        public function __construct(array<int, string>|string $includeFilesAndDirectories = []): void;

        /**
         * Overlay: `FileSelection::excludeFilesFrom()` takes paths or one path.
         */
        // @overlay-against: function excludeFilesFrom(array|string $excludeFilesAndDirectories): self
        public function excludeFilesFrom(array<int, string>|string $excludeFilesAndDirectories): self;

        /**
         * Overlay: `FileSelection::selectedFiles()` yields pathnames, or an empty list when nothing is included.
         */
        // @overlay-against: function selectedFiles(): \Generator|array
        public function selectedFiles(): \Generator<int, string>|array<int, string>;
    }

    // @overlay-against: class Manifest implements \Countable
    partial class Manifest {
        /**
         * Overlay: `Manifest::addFiles()` accepts pathnames.
         */
        // @overlay-against: function addFiles(array|string|\Generator $filePaths): self
        public function addFiles(array<int, string>|string|\Generator<int, string> $filePaths): self;

        /**
         * Overlay: `Manifest::files()` yields pathnames.
         */
        // @overlay-against: function files(): \Generator|array
        public function files(): \Generator<int, string>|array<int, string>;
    }

    // @overlay-against: class Zip
    partial class Zip {
        /**
         * Overlay: `Zip::add()` accepts pathnames.
         */
        // @overlay-against: function add(string|iterable $files, ?string $nameInZip): self
        public function add(string|iterable<int|string, string> $files, ?string $nameInZip = null): self;
    }
}

