<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * spatie/db-dumper, spatie/temporary-directory, spatie/laravel-signal-aware-command,
 * php-ext-zip ZipArchive, and illuminate-notifications' omitted Notifiable trait
 * are not on this include graph. Do not inline those namespaces.
 */

namespace Spatie\Backup\Commands {
    // @overlay-against: class BaseCommand extends \Spatie\SignalAwareCommand\SignalAwareCommand
    omit abstract class BaseCommand {
    }

    // @overlay-against: class BackupCommand extends \Spatie\Backup\Commands\BaseCommand implements \Illuminate\Contracts\Console\Isolatable, \Spatie\Backup\Traits\Retryable
    omit class BackupCommand {
    }

    // @overlay-against: class CleanupCommand extends \Spatie\Backup\Commands\BaseCommand implements \Illuminate\Contracts\Console\Isolatable, \Spatie\Backup\Traits\Retryable
    omit class CleanupCommand {
    }

    // @overlay-against: class ListCommand extends \Spatie\Backup\Commands\BaseCommand
    omit class ListCommand {
    }

    // @overlay-against: class MonitorCommand extends \Spatie\Backup\Commands\BaseCommand implements \Illuminate\Contracts\Console\Isolatable
    omit class MonitorCommand {
    }
}

namespace Spatie\Backup\Events {
    // @overlay-against: class DumpingDatabase
    omit class DumpingDatabase {
    }

    /**
     * Overlay: documented array shape.
     */
