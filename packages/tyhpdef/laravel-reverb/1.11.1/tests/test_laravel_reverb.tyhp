function test_reverb_application(): \Laravel\Reverb\Application
{
    return new \Laravel\Reverb\Application('id', 'key', 'secret', 60, 120, ['*'], 10000);
}

function test_reverb_application_id(): string
{
    return (new \Laravel\Reverb\Application('id', 'key', 'secret', 60, 120, ['*'], 10000))->id();
}

function test_reverb_channel(): \Laravel\Reverb\Protocols\Pusher\Channels\Channel
{
    return new \Laravel\Reverb\Protocols\Pusher\Channels\Channel('orders');
}

function test_reverb_null_logger(): \Laravel\Reverb\Loggers\NullLogger
{
    return new \Laravel\Reverb\Loggers\NullLogger();
}

function test_reverb_certificate_exists(): bool
{
    return \Laravel\Reverb\Certificate::exists('https://example.test');
}

function test_reverb_register_dev_commands(): void
{
    \Laravel\Reverb\Reverb::registerDevCommands();
}

