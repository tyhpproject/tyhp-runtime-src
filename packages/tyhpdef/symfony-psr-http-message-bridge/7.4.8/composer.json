{
    "name": "tyhpdef/symfony-psr-http-message-bridge",
    "description": "Tyhp type definitions for the Composer package symfony/psr-http-message-bridge (7.4.8).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.4.8.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-http-message": "@dev",
                "tyhpdef/symfony-http-foundation": "@dev",
                "tyhpdef/psr-http-factory": "@dev",
                "tyhpdef/php-ext-session": "@dev",
                "tyhpdef/php-ext-pdo": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/psr-http-message-bridge": "7.4.8"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/symfony-http-foundation": "@dev",
        "tyhpdef/psr-http-factory": "@dev",
        "tyhpdef/php-ext-session": "@dev",
        "tyhpdef/php-ext-pdo": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../psr-http-message/2.0"
        },
        {
            "type": "path",
            "url": "../../symfony-http-foundation/7.4.19"
        },
        {
            "type": "path",
            "url": "../../psr-http-factory/1.1.0"
        },
        {
            "type": "path",
            "url": "../../php-ext-session"
        },
        {
            "type": "path",
            "url": "../../php-ext-pdo"
        }
    ]
}
