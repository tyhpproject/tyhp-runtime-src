<?tyhp

function test_chronos_now(): \Cake\Chronos\Chronos
{
    return \Cake\Chronos\Chronos::now();
}

function test_chronos_format(\Cake\Chronos\Chronos $c): string
{
    return $c->toDateTimeString();
}

function test_chronos_date(): \Cake\Chronos\ChronosDate
{
    return \Cake\Chronos\ChronosDate::today();
}
