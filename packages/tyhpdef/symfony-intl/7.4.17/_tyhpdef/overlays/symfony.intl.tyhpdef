/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `@internal` ResourceBundle omitted from Layer 1; Countries / Locales extend it.
 */

/* WAVE-LINT-INTERNALS */
namespace Symfony\Component\Intl {
    /**
     * Overlay: harvest skipped `@internal` ResourceBundle; public Intl helpers extend it.
     */
    abstract class ResourceBundle {
        abstract protected static function getPath(): string;

        /**
         * @param iterable<mixed> $list
         * @return array<int|string, mixed>
         */
        final protected static function asort(iterable $list, ?string $locale = null): array<int|string, mixed>;

        /**
         * @param array<int, string> $indices
         */
        final protected static function readEntry(array<int, string> $indices, ?string $locale = null, bool $fallback = true): mixed;

        private function __construct(): void;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `Countries`.
     */
    // @overlay-against: class Countries extends \Symfony\Component\Intl\ResourceBundle
    partial class Countries {
        /**
         * @return array<string>
         */
        // @overlay-against: function getAlpha3Codes(): array
        public static function getAlpha3Codes(): array<string>;

        /**
         * @return array<string>
         */
        // @overlay-against: function getCountryCodes(): array
        public static function getCountryCodes(): array<int, string>;
    }

    /**
