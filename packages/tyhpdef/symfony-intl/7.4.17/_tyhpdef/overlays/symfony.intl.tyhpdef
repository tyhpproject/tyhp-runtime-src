        public static function forCountry(string $country, ?bool $legalTender = true, ?bool $active = true, \DateTimeInterface $date, bool $includeUndated = true): array<string>;

        /**
         * @return array<string>
         */
        // @overlay-against: function getCurrencyCodes(): array
        public static function getCurrencyCodes(): array<string>;

        /**
         * @return array<string, string> Alpha-3 code => display name.
         */
        // @overlay-against: function getNames(?string $displayLocale): array
        public static function getNames(?string $displayLocale = null): array<string, string>;

        /**
         * @return array<int|string, string> Alpha-3 codes that share this numeric code.
         */
        // @overlay-against: function forNumericCode(int $numericCode): array
        public static function forNumericCode(int $numericCode): array<int|string, string>;
    }

