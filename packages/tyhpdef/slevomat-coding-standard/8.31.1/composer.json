{
    "name": "tyhpdef/slevomat-coding-standard",
    "description": "Tyhp type definitions for the Composer package slevomat/coding-standard (8.31.1).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "8.31.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/squizlabs-php_codesniffer": "@dev",
                "tyhpdef/phpstan-phpdoc-parser": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "slevomat/coding-standard": "8.31.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/squizlabs-php_codesniffer": "@dev",
        "tyhpdef/phpstan-phpdoc-parser": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../squizlabs-php_codesniffer/4.0.4"
        },
        {
            "type": "path",
            "url": "../../phpstan-phpdoc-parser/2.3.5"
        }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
