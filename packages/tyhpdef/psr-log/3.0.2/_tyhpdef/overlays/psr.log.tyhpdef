<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Narrow PSR-3 `log()` `$level` from Layer 1 `mixed` to `LogLevelString`.
 * Context maps are string-keyed (PSR-3 `{foo}` placeholders).
 */

namespace Psr\Log {
    /**
     * PSR-3 context map — string keys; values are mixed (exception under `exception`).
     */
    type LogContext = array<string, mixed>;

    /**
     * PSR-3 log level strings — the eight `LogLevel::*` values.
     */
    type LogLevelString = 'emergency'|'alert'|'critical'|'error'|'warning'|'notice'|'info'|'debug';

    /**
     * Overlay: `$level` is narrowed from Layer 1 `mixed` to `LogLevelString`;
     * `$context` is a string-keyed map.
     */
    // @overlay-against: interface LoggerInterface
    partial interface LoggerInterface {
        // @overlay-against: function alert(string|\Stringable $message, array $context): void
        public function alert(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function critical(string|\Stringable $message, array $context): void
        public function critical(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function debug(string|\Stringable $message, array $context): void
        public function debug(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function emergency(string|\Stringable $message, array $context): void
        public function emergency(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function error(string|\Stringable $message, array $context): void
        public function error(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function info(string|\Stringable $message, array $context): void
        public function info(string|\Stringable $message, LogContext $context = []): void;

        /**
         * @param LogLevelString $level PSR-3 level string (`emergency`…`debug`); narrowed from Layer 1 `mixed`.
         * @param LogContext $context
         * @throws \Psr\Log\InvalidArgumentException
         */
        // @overlay-against: function log(mixed $level, string|\Stringable $message, array $context): void
        public function log(LogLevelString $level, string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function notice(string|\Stringable $message, array $context): void
        public function notice(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function warning(string|\Stringable $message, array $context): void
        public function warning(string|\Stringable $message, LogContext $context = []): void;
    }

    /**
     * Overlay: same level / context narrowing as LoggerInterface.
     */
    // @overlay-against: trait LoggerTrait
    partial trait LoggerTrait {
        // @overlay-against: function alert(string|\Stringable $message, array $context): void
        public function alert(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function critical(string|\Stringable $message, array $context): void
        public function critical(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function debug(string|\Stringable $message, array $context): void
        public function debug(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function emergency(string|\Stringable $message, array $context): void
        public function emergency(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function error(string|\Stringable $message, array $context): void
        public function error(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function info(string|\Stringable $message, array $context): void
        public function info(string|\Stringable $message, LogContext $context = []): void;

        /**
         * @param LogLevelString $level PSR-3 level string (`emergency`…`debug`); narrowed from Layer 1 `mixed`.
         * @throws \Psr\Log\InvalidArgumentException
         */
        // @overlay-against: function log(mixed $level, string|\Stringable $message, array $context): void
        public abstract function log(LogLevelString $level, string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function notice(string|\Stringable $message, array $context): void
        public function notice(string|\Stringable $message, LogContext $context = []): void;

        // @overlay-against: function warning(string|\Stringable $message, array $context): void
        public function warning(string|\Stringable $message, LogContext $context = []): void;
    }

    /**
     * Overlay: `$level` is narrowed from Layer 1 `mixed` to `LogLevelString`.
     */
    // @overlay-against: class NullLogger extends \Psr\Log\AbstractLogger
    partial class NullLogger {
        /**
         * @param LogLevelString $level PSR-3 level string (`emergency`…`debug`); narrowed from Layer 1 `mixed`.
         * @param LogContext $context
         * @throws \Psr\Log\InvalidArgumentException
         */
        // @overlay-against: function log(mixed $level, string|\Stringable $message, array $context): void
        public function log(LogLevelString $level, string|\Stringable $message, LogContext $context = []): void;
    }
}
