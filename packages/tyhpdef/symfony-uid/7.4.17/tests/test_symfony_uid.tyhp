<?tyhp

function test_uid_v4(): \Symfony\Component\Uid\UuidV4
{
    return \Symfony\Component\Uid\Uuid::v4();
}

function test_uid_from_string(): \Symfony\Component\Uid\Uuid
{
    return \Symfony\Component\Uid\Uuid::fromString('00000000-0000-4000-8000-000000000000');
}

function test_uid_to_string(\Symfony\Component\Uid\Uuid $uuid): string
{
    return (string) $uuid;
}
