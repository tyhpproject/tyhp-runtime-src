<?tyhp

function test_options_resolver_resolve(): array<string, mixed>
{
    $resolver = new \Symfony\Component\OptionsResolver\OptionsResolver();
    $resolver->setDefaults(['timeout' => 30]);
    return $resolver->resolve(['timeout' => 10]);
}

function test_options_resolver_has(): bool
{
    $resolver = new \Symfony\Component\OptionsResolver\OptionsResolver();
    $resolver->setDefined('name');
    return $resolver->isDefined('name');
}
