<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Types the client, service base, collections, HTTP client, webhooks, and util surfaces.
 * Generated resource classes and per-endpoint service methods stay on Layer 1.
 */

namespace HttpClient {
    /**
     * Layer 1 emitted Stripe HTTP clients without the `Stripe\` prefix.
     */
    interface ClientInterface {
    }

    interface StreamingClientInterface {
    }
}

namespace Stripe {
    type ApiRequestResult = struct {
        \Stripe\ApiResponse 0 as $response;
        string 1 as $apiKey;
    };

    type AppInfo = struct {
        string $name;
        ?string $version;
        ?string $url;
        ?string $partner_id;
    };

    type ClientConfig = struct {
        ?string $api_key;
        AppInfo|null $app_info;
        ?string $client_id;
        ?string $stripe_account;
        string|\Stripe\StripeContext|null $stripe_context;
        ?string $stripe_version;
        ?int $max_network_retries;
        ?string $api_base;
        ?string $connect_base;
        ?string $files_base;
        ?string $meter_events_base;
    };

    type NotificationFallback = callable(\Stripe\V2\Core\EventNotification, \Stripe\StripeClient, \Stripe\UnhandledNotificationDetails): void;

    type PreHandleCallback = callable(\Stripe\V2\Core\EventNotification, \Stripe\StripeClient): bool;

    /**
     * Event-notification base omitted by Layer 1.
     */
    class AbstractEventNotificationHandler {
        protected \Stripe\StripeClient $client;
        protected ClientConfig $clientConfig;
        protected NotificationFallback $fallbackCallback;
        protected bool $hasHandledEvents;
        protected PreHandleCallback|null $preHandleCallback;
        protected array<string, callable> $registeredHandlers;

        public function __construct(\Stripe\StripeClient $client, NotificationFallback $fallbackCallback): void;

        protected function createClientWithContext(string|null $context): \Stripe\StripeClient;

        protected function dispatch(\Stripe\V2\Core\EventNotification $notif): void;

        public function getRegisteredHandlers(): array<int, string>;

        public function onV1BillingMeterErrorReportTriggered(callable(\Stripe\Events\V1BillingMeterErrorReportTriggeredEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV1BillingMeterNoMeterFound(callable(\Stripe\Events\V1BillingMeterNoMeterFoundEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CommerceProductCatalogImportsFailed(callable(\Stripe\Events\V2CommerceProductCatalogImportsFailedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CommerceProductCatalogImportsProcessing(callable(\Stripe\Events\V2CommerceProductCatalogImportsProcessingEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CommerceProductCatalogImportsSucceeded(callable(\Stripe\Events\V2CommerceProductCatalogImportsSucceededEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CommerceProductCatalogImportsSucceededWithErrors(callable(\Stripe\Events\V2CommerceProductCatalogImportsSucceededWithErrorsEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountClosed(callable(\Stripe\Events\V2CoreAccountClosedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountCreated(callable(\Stripe\Events\V2CoreAccountCreatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountIncludingConfigurationCustomerCapabilityStatusUpdated(callable(\Stripe\Events\V2CoreAccountIncludingConfigurationCustomerCapabilityStatusUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountIncludingConfigurationCustomerUpdated(callable(\Stripe\Events\V2CoreAccountIncludingConfigurationCustomerUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountIncludingConfigurationMerchantCapabilityStatusUpdated(callable(\Stripe\Events\V2CoreAccountIncludingConfigurationMerchantCapabilityStatusUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountIncludingConfigurationMerchantUpdated(callable(\Stripe\Events\V2CoreAccountIncludingConfigurationMerchantUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountIncludingConfigurationRecipientCapabilityStatusUpdated(callable(\Stripe\Events\V2CoreAccountIncludingConfigurationRecipientCapabilityStatusUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountIncludingConfigurationRecipientUpdated(callable(\Stripe\Events\V2CoreAccountIncludingConfigurationRecipientUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountIncludingDefaultsUpdated(callable(\Stripe\Events\V2CoreAccountIncludingDefaultsUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountIncludingFutureRequirementsUpdated(callable(\Stripe\Events\V2CoreAccountIncludingFutureRequirementsUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountIncludingIdentityUpdated(callable(\Stripe\Events\V2CoreAccountIncludingIdentityUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountIncludingRequirementsUpdated(callable(\Stripe\Events\V2CoreAccountIncludingRequirementsUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountLinkReturned(callable(\Stripe\Events\V2CoreAccountLinkReturnedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountPersonCreated(callable(\Stripe\Events\V2CoreAccountPersonCreatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountPersonDeleted(callable(\Stripe\Events\V2CoreAccountPersonDeletedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountPersonUpdated(callable(\Stripe\Events\V2CoreAccountPersonUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreAccountUpdated(callable(\Stripe\Events\V2CoreAccountUpdatedEventNotification, \Stripe\StripeClient): void $handler): void;

        public function onV2CoreEventDestinationPing(callable(\Stripe\Events\V2CoreEventDestinationPingEventNotification, \Stripe\StripeClient): void $handler): void;

        public function preHandle(PreHandleCallback $handler): void;

        protected function register(string $eventType, callable $handler): void;
    }

