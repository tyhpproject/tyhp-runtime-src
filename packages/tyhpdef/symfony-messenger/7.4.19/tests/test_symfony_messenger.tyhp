<?tyhp

function test_messenger_dispatch(\Symfony\Component\Messenger\MessageBusInterface $bus): \Symfony\Component\Messenger\Envelope
{
    return $bus->dispatch(new \stdClass());
}

function test_messenger_envelope_message(): object
{
    $envelope = new \Symfony\Component\Messenger\Envelope(new \stdClass());
    return $envelope->getMessage();
}
