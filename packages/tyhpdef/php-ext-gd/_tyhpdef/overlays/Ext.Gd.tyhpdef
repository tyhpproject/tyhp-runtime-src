<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Bounding-box / clip / color / crop array shapes. GdImage stays an object.
 * Declaration order: TYHPDEF_ORDERING.md.
 */

/**
 * Overlay: affine matrix keys `0`–`5` (`a`, `b`, `c`, `d`, `tx`, `ty`).
 */
type GdAffineMatrix = struct {
    float 0 as $a;
    float 1 as $b;
    float 2 as $c;
    float 3 as $d;
    float 4 as $tx;
    float 5 as $ty;
};

/**
 * Overlay: `IMG_AFFINE_TRANSLATE` / `IMG_AFFINE_SCALE` options (`x`, `y`).
 */
type GdAffineVector = struct {
    float $x;
    float $y;
};

/**
 * Overlay: `imagecolorsforindex()` color components.
 */
type GdColor = struct {
    int $red;
    int $green;
    int $blue;
    int $alpha;
};

/**
 * Overlay: `imagecrop()` rectangle (`x`, `y`, `width`, `height`).
 */
type GdCropRect = struct {
    int $x;
    int $y;
    int $width;
    int $height;
};

/**
 * Overlay: `gd_info()` capability map. Keys match PHP's associative return.
 */
type GdInfo = struct {
    string 'GD Version' as $gdVersion;
    bool 'FreeType Support' as $freeTypeSupport;
    string 'FreeType Linkage' as $freeTypeLinkage;
    bool 'GIF Read Support' as $gifReadSupport;
    bool 'GIF Create Support' as $gifCreateSupport;
    bool 'JPEG Support' as $jpegSupport;
    bool 'PNG Support' as $pngSupport;
    bool 'WBMP Support' as $wbmpSupport;
    bool 'XPM Support' as $xpmSupport;
    bool 'XBM Support' as $xbmSupport;
    bool 'WebP Support' as $webpSupport;
    bool 'BMP Support' as $bmpSupport;
    bool 'AVIF Support' as $avifSupport;
    bool 'TGA Read Support' as $tgaReadSupport;
    bool 'JIS-mapped Japanese Font Support' as $jisMappedJapaneseFontSupport;
};

/**
 * Overlay: `imagegetclip()` `[x1, y1, x2, y2]`.
 */
type ImageClipRect = struct {
    int 0 as $x1;
    int 1 as $y1;
    int 2 as $x2;
    int 3 as $y2;
};

/**
 * Overlay: `imagettfbbox()` / `imageftbbox()` / `imagettftext()` / `imagefttext()`
 * eight-point bounding box, lower-left then counter-clockwise.
 */
type ImageFtBbox = struct {
    int 0 as $lowerLeftX;
    int 1 as $lowerLeftY;
    int 2 as $lowerRightX;
    int 3 as $lowerRightY;
    int 4 as $upperRightX;
    int 5 as $upperRightY;
    int 6 as $upperLeftX;
    int 7 as $upperLeftY;
};

/**
 * Overlay: `imagefttext()` / `imagettftext()` `$options` (`linespacing`).
 */
type ImageFtOptions = struct {
    ?float $linespacing;
};

/**
 * Overlay: `imageresolution()` getter `[horizontal, vertical]` DPI.
 */
type ImageResolution = struct {
    int 0 as $x;
    int 1 as $y;
};

// @overlay-against: function gd_info(): array
function gd_info(): GdInfo;

// @overlay-against: function imageaffine(\GdImage $image, array $affine, ?array $clip): \GdImage|false
function imageaffine(\GdImage $image, GdAffineMatrix $affine, ?GdCropRect $clip = null): \GdImage|false;

// @overlay-against: function imageaffinematrixconcat(array $matrix1, array $matrix2): array|false
function imageaffinematrixconcat(GdAffineMatrix $matrix1, GdAffineMatrix $matrix2): GdAffineMatrix|false;

// @overlay-against: function imageaffinematrixget(int $type, mixed $options): array|false
function imageaffinematrixget(0 $type, GdAffineVector $options): GdAffineMatrix|false;
// @overlay-against: function imageaffinematrixget(int $type, mixed $options): array|false
function imageaffinematrixget(1 $type, GdAffineVector $options): GdAffineMatrix|false;
// @overlay-against: function imageaffinematrixget(int $type, mixed $options): array|false
function imageaffinematrixget(2|3|4 $type, float $options): GdAffineMatrix|false;
// @overlay-against: function imageaffinematrixget(int $type, mixed $options): array|false
function imageaffinematrixget(int $type, GdAffineVector|float $options): GdAffineMatrix|false;

// @overlay-against: function imagebmp(\GdImage $image, mixed $file, bool $compressed): bool
function imagebmp(\GdImage $image, null|resource|string $file = null, bool $compressed = true): bool;

// @overlay-against: function imagecolorsforindex(\GdImage $image, int $color): array
function imagecolorsforindex(\GdImage $image, int $color): GdColor;

// @overlay-against: function imageconvolution(\GdImage $image, array $matrix, float $divisor, float $offset): bool
function imageconvolution(\GdImage $image, array<int, array<int, float>> $matrix, float $divisor, float $offset): bool;

// @overlay-against: function imagecrop(\GdImage $image, array $rectangle): \GdImage|false
function imagecrop(\GdImage $image, GdCropRect $rectangle): \GdImage|false;

// @overlay-against: function imageftbbox(float $size, float $angle, string $font_filename, string $string, array $options): array|false
function imageftbbox(float $size, float $angle, string $font_filename, string $string, ImageFtOptions $options = []): ImageFtBbox|false;

// @overlay-against: function imagefttext(\GdImage $image, float $size, float $angle, int $x, int $y, int $color, string $font_filename, string $text, array $options): array|false
function imagefttext(\GdImage $image, float $size, float $angle, int $x, int $y, int $color, string $font_filename, string $text, ImageFtOptions $options = []): ImageFtBbox|false;

// @overlay-against: function imagegetclip(\GdImage $image): array
function imagegetclip(\GdImage $image): ImageClipRect;

// @overlay-against: function imagegif(\GdImage $image, mixed $file): bool
function imagegif(\GdImage $image, null|resource|string $file = null): bool;

// @overlay-against: function imagejpeg(\GdImage $image, mixed $file, int $quality): bool
function imagejpeg(\GdImage $image, null|resource|string $file = null, int $quality = -1): bool;

// @overlay-against: function imagepng(\GdImage $image, mixed $file, int $quality, int $filters): bool
function imagepng(\GdImage $image, null|resource|string $file = null, int $quality = -1, int $filters = -1): bool;

// @overlay-against: function imagettfbbox(float $size, float $angle, string $font_filename, string $string, array $options): array|false
function imagettfbbox(float $size, float $angle, string $font_filename, string $string, ImageFtOptions $options = []): ImageFtBbox|false;

// @overlay-against: function imagettftext(\GdImage $image, float $size, float $angle, int $x, int $y, int $color, string $font_filename, string $text, array $options): array|false
function imagettftext(\GdImage $image, float $size, float $angle, int $x, int $y, int $color, string $font_filename, string $text, ImageFtOptions $options = []): ImageFtBbox|false;

// @overlay-against: function imagewbmp(\GdImage $image, mixed $file, ?int $foreground_color): bool
function imagewbmp(\GdImage $image, null|resource|string $file = null, ?int $foreground_color = null): bool;

declare(php="<8.5") {
    // @overlay-against: function imageresolution(\GdImage $image, ?int $resolution_x, ?int $resolution_y): array|bool
    function imageresolution(\GdImage $image): ImageResolution;
    // @overlay-against: function imageresolution(\GdImage $image, ?int $resolution_x, ?int $resolution_y): array|bool
    function imageresolution(\GdImage $image, int $resolution_x, ?int $resolution_y = null): true;
}
declare(php=">=8.5") {
    // @overlay-against: function imageresolution(\GdImage $image, ?int $resolution_x, ?int $resolution_y): array|true
    function imageresolution(\GdImage $image): ImageResolution;
    // @overlay-against: function imageresolution(\GdImage $image, ?int $resolution_x, ?int $resolution_y): array|true
    function imageresolution(\GdImage $image, int $resolution_x, ?int $resolution_y = null): true;
}
