<?tyhp

function test_intl_normalize_and_transliterate_types(): bool
{
    string|false $normalized = \Normalizer::normalize('é', \Normalizer::FORM_C);
    bool $isNormalized = \Normalizer::isNormalized('é', \Normalizer::FORM_C);
    string|false $transliterated = \transliterator_transliterate('Any-Latin', 'é');
    return $isNormalized && $normalized !== false && $transliterated !== false;
}

function test_intl_string_extensions(): bool
{
    string $text = 'é';
    bool $ok = $text->isNormalized(\Normalizer::FORM_C);
    string|false $normalized = $text->normalizeUnicode(\Normalizer::FORM_C);
    string|false $transliterated = $text->transliterate('Any-Latin');
    return $ok && $normalized !== false && $transliterated !== false;
}

function test_intl_iterator_generic(IntlIterator $it): mixed
{
    return $it->current();
}
