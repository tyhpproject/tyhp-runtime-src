<?tyhp

function test_pdo_odbc_constants(): int
{
    return PDO::ODBC_ATTR_USE_CURSOR_LIBRARY;
}

// `Pdo\Odbc` (PHP 8.4+ named PDO driver subclass) is only in scope when
// compiling for `output.phpVersion` >= 8.4 — see tyhp-php8.4.json.
declare(php=">=8.4") {
    function test_pdo_odbc_driver_class(\Pdo\Odbc $conn): int
    {
        return \Pdo\Odbc::ATTR_USE_CURSOR_LIBRARY;
    }
}
