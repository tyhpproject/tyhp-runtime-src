{
    "name": "tyhpdef/google-cloud-storage",
    "description": "Tyhp type definitions for the Composer package google/cloud-storage (2.5.3).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.5.3.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/google-cloud-core": "@dev",
                "tyhpdef/google-auth": "@dev",
                "tyhpdef/psr-http-message": "@dev",
                "tyhpdef/psr-cache": "@dev",
                "tyhpdef/guzzlehttp-psr7": "@dev",
                "tyhpdef/guzzlehttp-promises": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "google/cloud-storage": "2.5.3"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/google-cloud-core": "@dev",
        "tyhpdef/google-auth": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/psr-cache": "@dev",
        "tyhpdef/guzzlehttp-psr7": "@dev",
        "tyhpdef/guzzlehttp-promises": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../google-cloud-core/1.73.3"
        },
        {
            "type": "path",
            "url": "../../google-auth/1.54.0"
        },
        {
            "type": "path",
            "url": "../../psr-http-message/2.0"
        },
        {
            "type": "path",
            "url": "../../psr-cache/3.0.0"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-psr7/3.1.0"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-promises/3.0.2"
        }
    ]
}
