<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Generic collection iteration (`IteratorAggregate` / `item()`) and
 * `getElementsByTagName*` element lists. C14N query lists, namespace maps,
 * child-node unions, and `registerPhpFunctions` allow-lists. Not Pure.
 */

/**
 * Overlay: one `C14N()` / `C14NFile()` `$xpath` entry.
 */
type DomC14nXpathQuery = struct {
    ?array<string, string> $namespaces;
    string $query;
};

/**
 * Overlay: `getRootNode()` `$options`. `composed` selects the shadow-including root.
 */
type DomRootNodeOptions = struct {
    ?bool $composed;
};

declare(php=">=8.4") {
namespace Dom {
    // @overlay-against: enum AdjacentPosition implements \BackedEnum, \UnitEnum
    partial enum AdjacentPosition {
        // @overlay-against: function cases(): array
        static public function cases(): array<int, AdjacentPosition>;
    }

    // @overlay-against: class DtdNamedNodeMap implements \IteratorAggregate, \Traversable, \Countable
    partial class DtdNamedNodeMap implements \IteratorAggregate<string, \Dom\Entity|\Dom\Notation>, \Traversable<string, \Dom\Entity|\Dom\Notation>, \Countable;
    // @overlay-against: class DtdNamedNodeMap implements \IteratorAggregate, \Traversable, \Countable
    partial class DtdNamedNodeMap {
        // @overlay-against: function getIterator(): \Iterator
        public function getIterator(): \Iterator<string, \Dom\Entity|\Dom\Notation>;
    }

    // @overlay-against: class Element extends \Dom\Node implements \Dom\ParentNode, \Dom\ChildNode
    partial class Element {
        // @overlay-against: function getAttributeNames(): array
        public function getAttributeNames(): array<int, string>;
        // @overlay-against: function getDescendantNamespaces(): array
        public function getDescendantNamespaces(): array<string, string>;
        // @overlay-against: function getInScopeNamespaces(): array
        public function getInScopeNamespaces(): array<string, string>;
    }

    // @overlay-against: class HTMLCollection implements \IteratorAggregate, \Traversable, \Countable
    partial class HTMLCollection implements \IteratorAggregate<int, \Dom\Element>, \Traversable<int, \Dom\Element>, \Countable;
    // @overlay-against: class HTMLCollection implements \IteratorAggregate, \Traversable, \Countable
    partial class HTMLCollection {
        // @overlay-against: function getIterator(): \Iterator
        public function getIterator(): \Iterator<int, \Dom\Element>;
    }

    // @overlay-against: class NamedNodeMap implements \IteratorAggregate, \Traversable, \Countable
    partial class NamedNodeMap implements \IteratorAggregate<string, \Dom\Attr>, \Traversable<string, \Dom\Attr>, \Countable;
    // @overlay-against: class NamedNodeMap implements \IteratorAggregate, \Traversable, \Countable
    partial class NamedNodeMap {
        // @overlay-against: function getIterator(): \Iterator
        public function getIterator(): \Iterator<string, \Dom\Attr>;
    }

    // @overlay-against: class Node
    partial class Node {
        // @overlay-against: function C14N(bool $exclusive, bool $withComments, ?array $xpath, ?array $nsPrefixes): string|false
        public function C14N(bool $exclusive = false, bool $withComments = false, ?array<int, DomC14nXpathQuery> $xpath = null, ?array<int, string> $nsPrefixes = null): string|false;
        // @overlay-against: function C14NFile(string $uri, bool $exclusive, bool $withComments, ?array $xpath, ?array $nsPrefixes): int|false
        public function C14NFile(string $uri, bool $exclusive = false, bool $withComments = false, ?array<int, DomC14nXpathQuery> $xpath = null, ?array<int, string> $nsPrefixes = null): int|false;
        // @overlay-against: function getRootNode(array $options): \Dom\Node
        public function getRootNode(DomRootNodeOptions $options = []): \Dom\Node;
    }

    // @overlay-against: class NodeList implements \IteratorAggregate, \Traversable, \Countable
    partial class NodeList<TValue = \Dom\Node> implements \IteratorAggregate<int, TValue>, \Traversable<int, TValue>, \Countable;
    // @overlay-against: class NodeList implements \IteratorAggregate, \Traversable, \Countable
    partial class NodeList {
        // @overlay-against: function getIterator(): \Iterator
        public function getIterator(): \Iterator<int, TValue>;
        // @overlay-against: function item(int $index): ?\Dom\Node
        public function item(int $index): ?TValue;
    }

    // @overlay-against: class TokenList implements \IteratorAggregate, \Traversable, \Countable
    partial class TokenList implements \IteratorAggregate<int, string>, \Traversable<int, string>, \Countable;
    // @overlay-against: class TokenList implements \IteratorAggregate, \Traversable, \Countable
    partial class TokenList {
        // @overlay-against: function getIterator(): \Iterator
        public function getIterator(): \Iterator<int, string>;
    }

    // @overlay-against: class XPath
    partial class XPath {
        // @overlay-against: function registerPhpFunctionNS(string $namespaceURI, string $name, callable $callable): void
        public function registerPhpFunctionNS(string $namespaceURI, string $name, callable(mixed...): mixed $callable): void;
        // @overlay-against: function registerPhpFunctions(array|string|null $restrict): void
        public function registerPhpFunctions(array<int, string>|array<string, callable>|string|null $restrict = null): void;
    }
}
}

// @overlay-against: class DOMCharacterData extends \DOMNode implements \DOMChildNode
partial class DOMCharacterData {
    // @overlay-against: function after(mixed $nodes): void
    public function after(\DOMNode|string ...$nodes): void;
    // @overlay-against: function before(mixed $nodes): void
    public function before(\DOMNode|string ...$nodes): void;
    // @overlay-against: function replaceWith(mixed $nodes): void
    public function replaceWith(\DOMNode|string ...$nodes): void;
}

// @overlay-against: interface DOMChildNode
partial interface DOMChildNode {
    // @overlay-against: function after(mixed $nodes): void
    public function after(\DOMNode|string ...$nodes): void;
    // @overlay-against: function before(mixed $nodes): void
    public function before(\DOMNode|string ...$nodes): void;
    // @overlay-against: function replaceWith(mixed $nodes): void
    public function replaceWith(\DOMNode|string ...$nodes): void;
}

// @overlay-against: class DOMDocument extends \DOMNode implements \DOMParentNode
partial class DOMDocument {
    // @overlay-against: function append(mixed $nodes): void
    public function append(\DOMNode|string ...$nodes): void;
    // @overlay-against: function getElementsByTagName(string $qualifiedName): \DOMNodeList
    public function getElementsByTagName(string $qualifiedName): \DOMNodeList<\DOMElement>;
    // @overlay-against: function getElementsByTagNameNS(?string $namespace, string $localName): \DOMNodeList
    public function getElementsByTagNameNS(?string $namespace, string $localName): \DOMNodeList<\DOMElement>;
    // @overlay-against: function prepend(mixed $nodes): void
    public function prepend(\DOMNode|string ...$nodes): void;
    #[\Tyhp\Php(">=8.3")]
    // @overlay-against: function replaceChildren(mixed $nodes): void
    public function replaceChildren(\DOMNode|string ...$nodes): void;
}

// @overlay-against: class DOMDocumentFragment extends \DOMNode implements \DOMParentNode
partial class DOMDocumentFragment {
    // @overlay-against: function append(mixed $nodes): void
    public function append(\DOMNode|string ...$nodes): void;
    // @overlay-against: function prepend(mixed $nodes): void
    public function prepend(\DOMNode|string ...$nodes): void;
    #[\Tyhp\Php(">=8.3")]
    // @overlay-against: function replaceChildren(mixed $nodes): void
    public function replaceChildren(\DOMNode|string ...$nodes): void;
}

// @overlay-against: class DOMDocumentType extends \DOMNode
partial class DOMDocumentType {
    // @overlay-against: \DOMNamedNodeMap $entities
    public \DOMNamedNodeMap<\DOMEntity> $entities;
    // @overlay-against: \DOMNamedNodeMap $notations
    public \DOMNamedNodeMap<\DOMNotation> $notations;
}

// @overlay-against: class DOMElement extends \DOMNode implements \DOMParentNode, \DOMChildNode
partial class DOMElement {
    // @overlay-against: function after(mixed $nodes): void
    public function after(\DOMNode|string ...$nodes): void;
    // @overlay-against: function append(mixed $nodes): void
    public function append(\DOMNode|string ...$nodes): void;
    // @overlay-against: function before(mixed $nodes): void
    public function before(\DOMNode|string ...$nodes): void;
    #[\Tyhp\Php(">=8.3")]
    // @overlay-against: function getAttributeNames(): array
    public function getAttributeNames(): array<int, string>;
    // @overlay-against: function getElementsByTagName(string $qualifiedName): \DOMNodeList
    public function getElementsByTagName(string $qualifiedName): \DOMNodeList<\DOMElement>;
    // @overlay-against: function getElementsByTagNameNS(?string $namespace, string $localName): \DOMNodeList
    public function getElementsByTagNameNS(?string $namespace, string $localName): \DOMNodeList<\DOMElement>;
    // @overlay-against: function prepend(mixed $nodes): void
    public function prepend(\DOMNode|string ...$nodes): void;
    #[\Tyhp\Php(">=8.3")]
    // @overlay-against: function replaceChildren(mixed $nodes): void
    public function replaceChildren(\DOMNode|string ...$nodes): void;
    // @overlay-against: function replaceWith(mixed $nodes): void
    public function replaceWith(\DOMNode|string ...$nodes): void;
}

// @overlay-against: class DOMNamedNodeMap implements \IteratorAggregate, \Traversable, \Countable
partial class DOMNamedNodeMap<TValue = \DOMNode> implements \IteratorAggregate<string, TValue>, \Traversable<string, TValue>, \Countable;
// @overlay-against: class DOMNamedNodeMap implements \IteratorAggregate, \Traversable, \Countable
partial class DOMNamedNodeMap {
    // @overlay-against: function getIterator(): \Iterator
    public function getIterator(): \Iterator<string, TValue>;
    // @overlay-against: function getNamedItem(string $qualifiedName): ?\DOMNode
    public function getNamedItem(string $qualifiedName): ?TValue;
    // @overlay-against: function getNamedItemNS(?string $namespace, string $localName): ?\DOMNode
    public function getNamedItemNS(?string $namespace, string $localName): ?TValue;
    // @overlay-against: function item(int $index): ?\DOMNode
    public function item(int $index): ?TValue;
}

// @overlay-against: class DOMNode
partial class DOMNode {
    // @overlay-against: ?\DOMNamedNodeMap $attributes
    public ?\DOMNamedNodeMap<\DOMAttr> $attributes;
    // @overlay-against: \DOMNodeList $childNodes
    public \DOMNodeList<\DOMNode> $childNodes;
    // @overlay-against: function C14N(bool $exclusive, bool $withComments, ?array $xpath, ?array $nsPrefixes): string|false
    public function C14N(bool $exclusive = false, bool $withComments = false, ?array<int, DomC14nXpathQuery> $xpath = null, ?array<int, string> $nsPrefixes = null): string|false;
    // @overlay-against: function C14NFile(string $uri, bool $exclusive, bool $withComments, ?array $xpath, ?array $nsPrefixes): int|false
    public function C14NFile(string $uri, bool $exclusive = false, bool $withComments = false, ?array<int, DomC14nXpathQuery> $xpath = null, ?array<int, string> $nsPrefixes = null): int|false;
    #[\Tyhp\Php(">=8.3")]
    // @overlay-against: function getRootNode(?array $options): \DOMNode
    public function getRootNode<TOptions extends array<string, ?bool> = DomRootNodeOptions>(?TOptions $options = null): \DOMNode;
}

// @overlay-against: class DOMNodeList implements \IteratorAggregate, \Traversable, \Countable
partial class DOMNodeList<TValue = \DOMNode> implements \IteratorAggregate<int, TValue>, \Traversable<int, TValue>, \Countable;
// @overlay-against: class DOMNodeList implements \IteratorAggregate, \Traversable, \Countable
partial class DOMNodeList {
    // @overlay-against: function getIterator(): \Iterator
    public function getIterator(): \Iterator<int, TValue>;
    // @overlay-against: function item(int $index)
    public function item(int $index): ?TValue;
}

// @overlay-against: interface DOMParentNode
partial interface DOMParentNode {
    // @overlay-against: function append(mixed $nodes): void
    public function append(\DOMNode|string ...$nodes): void;
    // @overlay-against: function prepend(mixed $nodes): void
    public function prepend(\DOMNode|string ...$nodes): void;
    #[\Tyhp\Php(">=8.3")]
    // @overlay-against: function replaceChildren(mixed $nodes): void
    public function replaceChildren(\DOMNode|string ...$nodes): void;
}

// @overlay-against: class DOMXPath
partial class DOMXPath {
    // @overlay-against: function registerPhpFunctions(array|string|null $restrict): void
    public function registerPhpFunctions(array<int, string>|array<string, callable>|string|null $restrict = null): void;
    #[\Tyhp\Php(">=8.4")]
    // @overlay-against: function registerPhpFunctionNS(string $namespaceURI, string $name, callable $callable): void
    public function registerPhpFunctionNS(string $namespaceURI, string $name, callable(mixed...): mixed $callable): void;
