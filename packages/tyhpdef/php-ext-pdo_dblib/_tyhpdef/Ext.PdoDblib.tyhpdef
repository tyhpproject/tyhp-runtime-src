<?tyhpdef
/**
 * Hand-written Layer 1 for pdo_dblib.
 * Managed PHP does not provision `pdo_dblib` (TYHP7511); signatures follow
 * PHP 8.2–8.5 docs. PHP 8.4+ `Pdo\Dblib` is gated. PDO driver constants live
 * in `_tyhpdef/overlays/Ext.PdoDblib.tyhpdef`.
 *
 * @link https://www.php.net/manual/en/ref.pdo-dblib.php
 */
namespace Pdo {
    /**
     * PDO subclass for the dblib driver (PHP 8.4+).
     *
     * @link https://www.php.net/manual/en/class.pdo-dblib.php
     */
    #[\Tyhp\Php(">=8.4")]
    class Dblib extends \PDO {
        public const int ATTR_CONNECTION_TIMEOUT;
        public const int ATTR_QUERY_TIMEOUT;
        public const bool ATTR_STRINGIFY_UNIQUEIDENTIFIER;
        public const int ATTR_VERSION;
        public const int ATTR_TDS_VERSION;
        public const int ATTR_SKIP_EMPTY_ROWSETS;
        public const bool ATTR_DATETIME_CONVERT;
    }
}
