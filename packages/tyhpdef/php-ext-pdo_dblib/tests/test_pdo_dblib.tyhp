<?tyhp

function test_pdo_dblib_constants(): int
{
    return PDO::DBLIB_ATTR_CONNECTION_TIMEOUT;
}

// `Pdo\Dblib` (PHP 8.4+ named PDO driver subclass) is only in scope when
// compiling for `output.phpVersion` >= 8.4 — see tyhp-php8.4.json.
declare(php=">=8.4") {
    function test_pdo_dblib_driver_class(\Pdo\Dblib $conn): int
    {
        return \Pdo\Dblib::ATTR_CONNECTION_TIMEOUT;
    }
}
