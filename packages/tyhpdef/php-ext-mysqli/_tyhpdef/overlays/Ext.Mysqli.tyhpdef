/**
 * One element of `mysqli::$error_list` / `mysqli_stmt::$error_list`
 * (and the matching procedural `mysqli_*_error_list()` returns).
 */
type MysqliErrorInfo = struct {
    string $error;
    int $errno;
    string $sqlstate;
};

// @overlay-against: function mysqli_error_list(\mysqli $mysql): array
function mysqli_error_list(\mysqli $mysql): array<int, MysqliErrorInfo>;
/**
 * MYSQLI_ASSOC (`1`).
 */
// @overlay-against: function mysqli_fetch_all(\mysqli_result $result, int $mode): array
function mysqli_fetch_all(\mysqli_result $result, 1 $mode): array<int, array<string, mixed>>;
/**
 * MYSQLI_NUM (`2`, default).
 */
// @overlay-against: function mysqli_fetch_all(\mysqli_result $result, int $mode): array
function mysqli_fetch_all(\mysqli_result $result, 2 $mode = MYSQLI_NUM): array<int, array<int, mixed>>;
/**
 * MYSQLI_BOTH (`3`).
 */
// @overlay-against: function mysqli_fetch_all(\mysqli_result $result, int $mode): array
function mysqli_fetch_all(\mysqli_result $result, 3 $mode): array<int, array<int|string, mixed>>;
