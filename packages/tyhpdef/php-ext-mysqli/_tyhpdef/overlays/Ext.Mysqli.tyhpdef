// @overlay-against: function mysqli_fetch_array(\mysqli_result $result, int $mode): array|false|null
function mysqli_fetch_array(\mysqli_result $result, 3 $mode = MYSQLI_BOTH): array<int|string, mixed>|false|null;
// @overlay-against: function mysqli_fetch_array(\mysqli_result $result, int $mode): array|false|null
function mysqli_fetch_array(\mysqli_result $result, int $mode): array<int|string, mixed>|false|null;
// @overlay-against: function mysqli_fetch_assoc(\mysqli_result $result): array|false|null
function mysqli_fetch_assoc(\mysqli_result $result): array<string, mixed>|false|null;
// @overlay-against: function mysqli_fetch_fields(\mysqli_result $result): array
function mysqli_fetch_fields(\mysqli_result $result): array<int, object>;
// @overlay-against: function mysqli_fetch_lengths(\mysqli_result $result): array|false
function mysqli_fetch_lengths(\mysqli_result $result): array<int, int>|false;
// @overlay-against: function mysqli_fetch_object(\mysqli_result $result, string $class, array $constructor_args): object|false|null
function mysqli_fetch_object<T extends object = \stdClass>(\mysqli_result $result, __ClassName<T> $class = 'stdClass', array<int, mixed> $constructor_args = []): T|false|null;
// @overlay-against: function mysqli_fetch_row(\mysqli_result $result): array|false|null
function mysqli_fetch_row(\mysqli_result $result): array<int, mixed>|false|null;
// @overlay-against: function mysqli_get_client_stats(): array
function mysqli_get_client_stats(): array<string, int>;
