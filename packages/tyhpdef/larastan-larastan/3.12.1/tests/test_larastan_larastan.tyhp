<?tyhp

function test_schema_column(): \Larastan\Larastan\Properties\SchemaColumn
{
    return new \Larastan\Larastan\Properties\SchemaColumn('email', 'string');
}

function test_schema_table_rename(): void
{
    $table = new \Larastan\Larastan\Properties\SchemaTable('users');
    $table->setColumn(new \Larastan\Larastan\Properties\SchemaColumn('email', 'string'));
    $table->renameColumn('email', 'email_address');
}

function test_sql_parser_failure(): \Larastan\Larastan\SQL\SqlParserFailure
{
    return \Larastan\Larastan\SQL\SqlParserFailure::create('parse failed');
}
