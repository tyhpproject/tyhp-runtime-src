<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under `overlays/stubs/`).
 *
 * `WorkCommand` extends illuminate-queue's omitted `\Illuminate\Queue\Console\WorkCommand`.
 * LongWaitDetected `toSlack` / `toNexmo` name notification channel types that are not
 * in the wrapped illuminate-notifications surface.
 */

namespace Laravel\Horizon {
    /**
     * Overlay: `Horizon::scriptVariables()` keys.
     */
    type HorizonScriptVariablesResult = struct {
        mixed $path;
        mixed $proxy_path;
    };

    /**
     * Overlay: `SupervisorOptions::toArray()` keys.
     */
    type SupervisorOptionsToArrayResult = struct {
        string|null $autoScalingStrategy;
        int|string $backoff;
        string $balance;
        int $balanceCooldown;
        int $balanceMaxShift;
        string $connection;
        bool $force;
        bool $json;
        int $maxJobs;
        int $maxProcesses;
        int $maxTime;
        int $maxTries;
        int $memory;
        int $minProcesses;
        string $name;
        int $nice;
        int|false $parentId;
        mixed $queue;
        int $rest;
        int $sleep;
        int $timeout;
        string $workersName;
    };

    // @overlay-against: trait EventMap
    partial trait EventMap {
        /**
         * Overlay: event class => list of listener classes.
         */
        // @overlay-against: array $events
        protected array<__ClassName, array<int, __ClassName>> $events ?? [];
    }

    // @overlay-against: class Horizon
    partial class Horizon {
        /**
         * Overlay: `check()` invokes this with the request and returns the result.
         */
        // @overlay-against: \Closure $authUsing
        public static \Closure<callable(\Illuminate\Http\Request): bool>|null $authUsing;

        /**
         * Overlay: database names stored on the property (`'Jobs'`, `'Supervisors'`, …).
         */
        // @overlay-against: array $databases
        public static array<int, string> $databases ?? [];

        /**
         * Overlay: `check()` invokes this with the request and returns the result.
         */
        // @overlay-against: function auth(\Closure $callback): static
        public static function auth(\Closure<callable(\Illuminate\Http\Request): bool> $callback): static;

        /**
         * Overlay: cluster config is indexed by node (`$config[0]`) and by `'options'`.
         */
        // @overlay-against: function configureClusterConnection(array $config): void
        protected static function configureClusterConnection(array<int|string, mixed> $config): void;

        /**
         * Overlay: standalone config is written at `$config['options']`.
         */
        // @overlay-against: function configureStandaloneConnection(array $config): void
        protected static function configureStandaloneConnection(array<string, mixed> $config): void;

        /**
         * Overlay: `scriptVariables()` returns `path` and `proxy_path` from config.
         */
        // @overlay-against: function scriptVariables(): array
        public static function scriptVariables(): HorizonScriptVariablesResult;
    }

