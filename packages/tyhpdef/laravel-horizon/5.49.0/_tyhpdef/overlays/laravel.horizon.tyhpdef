namespace Laravel\Horizon\Repositories {
    /**
     * Overlay: retry records written by `storeRetryReference()` and updated by `updateRetryStatus()`.
     */
    type RedisJobRepositoryRetryStatus = struct {
        string $id;
        int $retried_at;
        string $status;
    };

    /**
     * Overlay: `baseSnapshotData()` keys.
     */
    type RedisMetricsRepositoryBaseSnapshotData = struct {
        mixed $runtime;
        mixed $throughput;
    };

    /**
     * Overlay: documented array shape.
     */
    type RedisWorkloadRepositoryGetResult = struct {
        int $length;
        string $name;
        int $wait;
    };

    /**
     * Overlay: documented array shape.
     */
    type RedisWorkloadRepositoryGetResult2 = struct {
        int $length;
        string $name;
        int $processes;
        null|array<int, RedisWorkloadRepositoryGetResult> $split_queues;
        int $wait;
    };

