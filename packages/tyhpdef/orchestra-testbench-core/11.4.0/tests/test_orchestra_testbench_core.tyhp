<?tyhp

function test_application_make(): \Orchestra\Testbench\Foundation\Application
{
    return \Orchestra\Testbench\Foundation\Application::make('/tmp/app');
}

function test_laravel_version_compare(): int|bool
{
    return \Orchestra\Testbench\laravel_version_compare('11.0', '>=');
}

function test_join_paths(): string
{
    return \Orchestra\Testbench\join_paths('/tmp', 'app');
}
