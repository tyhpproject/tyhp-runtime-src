<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * `search()` is a `fallback function` because its PHP declaration is inside `function_exists`.
 */

namespace JmesPath {
    /**
     * One `Lexer::tokenize()` token: type name, lexeme, and source offset.
     */
    type JmesToken = struct {
        string $type;
        string $value;
        int $key;
    };

    fallback function search(string $expression, mixed $data): mixed;

    // @overlay-against: class Lexer
    partial class Lexer {
        // @overlay-against: function tokenize(string $input): array
        public function tokenize(string $input): array<int, \JmesPath\JmesToken>;
    }

    // @overlay-against: class Utils
    partial class Utils {
        /**
         * @param array<TKey, TValue> $value
         * @return array<int, TValue> Sliced list. Step may drop elements; keys are rebuilt.
         */
        // @overlay-against: function slice(array|string $value, int|null $start, int|null $stop, int $step): array|string
        public static function slice<TKey extends int|string, TValue>(array<TKey, TValue> $value, ?int $start = null, ?int $stop = null, int $step = 1): array<int, TValue>;

        // @overlay-against: function slice(array|string $value, int|null $start, int|null $stop, int $step): array|string
        public static function slice(string $value, ?int $start = null, ?int $stop = null, int $step = 1): string;
    }
}
