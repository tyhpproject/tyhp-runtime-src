{
  "name": "tyhpdef/league-commonmark",
  "description": "Tyhp type definitions for the Composer package league/commonmark (2.10.1).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "2.10.1.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-event-dispatcher": "@dev",
        "tyhpdef/league-config": "@dev",
        "tyhpdef/dflydev-dot-access-data": "@dev",
        "tyhpdef/nette-schema": "@dev",
        "tyhpdef/nette-utils": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "league/commonmark": "2.10.1"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/psr-event-dispatcher": "@dev",
    "tyhpdef/league-config": "@dev",
    "tyhpdef/dflydev-dot-access-data": "@dev",
    "tyhpdef/nette-schema": "@dev",
    "tyhpdef/nette-utils": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../psr-event-dispatcher/1.0.0"
    },
    {
      "type": "path",
      "url": "../../league-config/1.2.0"
    },
    {
      "type": "path",
      "url": "../../dflydev-dot-access-data/3.0.3"
    },
    {
      "type": "path",
      "url": "../../nette-schema/1.3.6"
    },
    {
      "type": "path",
      "url": "../../nette-utils/4.1.5"
    }
  ]
}
