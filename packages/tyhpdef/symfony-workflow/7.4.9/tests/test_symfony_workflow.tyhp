<?tyhp

function test_workflow_can(\Symfony\Component\Workflow\WorkflowInterface $workflow): bool
{
    return $workflow->can(new \stdClass(), 'publish');
}

function test_workflow_apply(\Symfony\Component\Workflow\WorkflowInterface $workflow): \Symfony\Component\Workflow\Marking
{
    return $workflow->apply(new \stdClass(), 'publish');
}
