<?tyhp

function test_hamcrest_matcher_assert_count(): int
{
    return \Hamcrest\MatcherAssert::getCount();
}

function test_hamcrest_array_with_size(): \Hamcrest\Arrays\IsArrayWithSize
{
    return \Hamcrest\Matchers::arrayWithSize(0);
}

function test_hamcrest_assert_that_bool(): void
{
    \Hamcrest\MatcherAssert::assertThat(true);
}

function test_hamcrest_assert_that_matcher(): void
{
    \Hamcrest\MatcherAssert::assertThat([], \Hamcrest\Matchers::arrayWithSize(0));
}

function test_hamcrest_assert_that_identified(): void
{
    \Hamcrest\MatcherAssert::assertThat('empty array', [], \Hamcrest\Matchers::arrayWithSize(0));
}
