<?tyhp

function test_router(\Illuminate\Events\Dispatcher $events): \Illuminate\Routing\Router
{
    return new \Illuminate\Routing\Router($events);
}

function test_route(): \Illuminate\Routing\Route
{
    return new \Illuminate\Routing\Route(['GET'], '/', function (): void {});
}

function test_route_collection(): \Illuminate\Routing\RouteCollection
{
    return new \Illuminate\Routing\RouteCollection();
}

function test_url_generator(\Illuminate\Http\Request $request): \Illuminate\Routing\UrlGenerator
{
    return new \Illuminate\Routing\UrlGenerator(new \Illuminate\Routing\RouteCollection(), $request);
}
