<?tyhp

function test_event_dispatcher_dispatch(): \Symfony\Contracts\EventDispatcher\Event
{
    $dispatcher = new \Symfony\Component\EventDispatcher\EventDispatcher();
    $event = new \Symfony\Contracts\EventDispatcher\Event();
    return $dispatcher->dispatch($event);
}

function test_event_dispatcher_has_listeners(\Symfony\Component\EventDispatcher\EventDispatcherInterface $dispatcher): bool
{
    $dispatcher->addListener('app.start', function (object $event): void {
    });
    return $dispatcher->hasListeners('app.start');
}
