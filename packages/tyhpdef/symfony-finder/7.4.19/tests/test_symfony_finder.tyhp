<?tyhp

function test_finder_files_in(): \Symfony\Component\Finder\Finder
{
    return \Symfony\Component\Finder\Finder::create()->files()->name('*.php')->in(['/tmp', '/var']);
}

function test_finder_iterator(\Symfony\Component\Finder\Finder $finder): \Iterator<int|string, \Symfony\Component\Finder\SplFileInfo>
{
    return $finder->getIterator();
}

function test_finder_directories(): int
{
    $finder = (new \Symfony\Component\Finder\Finder())->directories()->in('/tmp');
    return $finder->count();
}
