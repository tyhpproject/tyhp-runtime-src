<?tyhp

function test_http_worker(\Spiral\RoadRunner\WorkerInterface $worker): \Spiral\RoadRunner\Http\HttpWorker
{
    return new \Spiral\RoadRunner\Http\HttpWorker($worker);
}

function test_psr7_worker(
    \Spiral\RoadRunner\WorkerInterface $worker,
    \Psr\Http\Message\ServerRequestFactoryInterface $requestFactory,
    \Psr\Http\Message\StreamFactoryInterface $streamFactory,
    \Psr\Http\Message\UploadedFileFactoryInterface $uploadsFactory
): \Spiral\RoadRunner\Http\PSR7Worker {
    return new \Spiral\RoadRunner\Http\PSR7Worker($worker, $requestFactory, $streamFactory, $uploadsFactory);
}
