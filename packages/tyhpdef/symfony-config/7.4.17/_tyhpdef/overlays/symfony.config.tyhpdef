        string $resource;
    };
    type GlobResourceState = struct {
        string $prefix;
        string $pattern;
        bool $recursive;
        string $hash;
        bool $forExclusion;
        array<string, mixed> $excludedPrefixes;
    };
    type ReflectionClassResourceState = struct {
        array<string, null> $files;
        string $className;
        array<int|string, string> $excludedVendors;
        string $hash;
    };
