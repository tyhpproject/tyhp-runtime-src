<?tyhp

function test_config_file_locator_first(): string
{
    $locator = new \Symfony\Component\Config\FileLocator(['/etc', '/usr/local/etc']);
    return $locator->locate('app.yaml', null, true);
}

function test_config_file_locator_all(): array<int, string>
{
    $locator = new \Symfony\Component\Config\FileLocator('/etc');
    return $locator->locate('app.yaml', null, false);
}

function test_config_processor_normalize(): array<string, mixed>
{
    return \Symfony\Component\Config\Definition\Processor::normalizeConfig(['extensions' => ['a', 'b']], 'extension', 'extensions');
}

function test_config_cache_fresh(\Symfony\Component\Config\ConfigCacheInterface $cache): bool
{
    return $cache->isFresh();
}
