{
    "name": "tyhpdef/psalm-plugin-laravel",
    "description": "Tyhp type definitions for the Composer package psalm/plugin-laravel (4.16.1).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "4.16.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": "8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/vimeo-psalm": "@dev",
                "tyhpdef/orchestra-testbench-core": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "psalm/plugin-laravel": "4.16.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/vimeo-psalm": "@dev",
        "tyhpdef/orchestra-testbench-core": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../laravel-framework/13.32.0"
        },
        {
            "type": "path",
            "url": "../../vimeo-psalm/7.0.0-beta19"
        },
        {
            "type": "path",
            "url": "../../orchestra-testbench-core/11.4.0"
        }
    ]
}
