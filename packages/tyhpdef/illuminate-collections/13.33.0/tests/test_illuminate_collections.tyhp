<?tyhp

function test_collect_list(): \Illuminate\Support\Collection<int|string, string>
{
    array<int|string, string> $items = ['a', 'b'];
    return collect($items);
}

function test_collection_all(\Illuminate\Support\Collection<int|string, string> $c): array<int|string, string>
{
    return $c->all();
}

function test_arr_get(): mixed
{
    return \Illuminate\Support\Arr::get(['name' => 'tyhp'], 'name', null);
}

function test_arr_accessible_narrow(mixed $value): bool
{
    if (\Illuminate\Support\Arr::accessible($value)) {
        return \Illuminate\Support\Arr::exists($value, 'k');
    }

    return false;
}

function test_arr_arrayable_narrow(mixed $value): bool
{
    return \Illuminate\Support\Arr::arrayable($value);
}

function test_arr_is_list(): bool
{
    return \Illuminate\Support\Arr::isList([1, 2, 3]);
}

function test_arr_wrap_null(): array
{
    return \Illuminate\Support\Arr::wrap(null);
}

function test_value_int(): int
{
    return value(7);
}
