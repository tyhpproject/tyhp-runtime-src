<?tyhp

function test_session_status_signature(): int
{
    return session_status();
}

function test_session_set_save_handler_object_form(\SessionHandlerInterface $handler): bool
{
    return session_set_save_handler($handler);
}

function test_session_set_save_handler_callable_form(): bool
{
    return session_set_save_handler(
        function (string $path, string $name): bool { return true; },
        function (): bool { return true; },
        function (string $id): string { return ''; },
        function (string $id, string $data): bool { return true; },
        function (string $id): bool { return true; },
        function (int $maxLifetime): int { return 0; }
    );
}
