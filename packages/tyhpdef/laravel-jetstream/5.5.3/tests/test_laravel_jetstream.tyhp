<?tyhp

function test_jetstream_has_roles(): bool
{
    return \Laravel\Jetstream\Jetstream::hasRoles();
}

function test_jetstream_ignore_routes(): \Laravel\Jetstream\Jetstream
{
    return \Laravel\Jetstream\Jetstream::ignoreRoutes();
}

function test_jetstream_create_teams_using(): void
{
    \Laravel\Jetstream\Jetstream::createTeamsUsing(\Laravel\Jetstream\Contracts\CreatesTeams::class);
}

function test_features_has_teams(): bool
{
    return \Laravel\Jetstream\Features::hasTeamFeatures();
}

function test_features_enabled(): bool
{
    return \Laravel\Jetstream\Features::enabled(\Laravel\Jetstream\Features::api());
}

function test_creates_teams(\Laravel\Jetstream\Contracts\CreatesTeams $creator, \Illuminate\Foundation\Auth\User $user, array $input): \Illuminate\Database\Eloquent\Model
{
    return $creator->create($user, $input);
}

function test_adds_team_members(\Laravel\Jetstream\Contracts\AddsTeamMembers $action, \Illuminate\Foundation\Auth\User $user, \Illuminate\Database\Eloquent\Model $team): void
{
    $action->add($user, $team, 'member@example.com', 'editor');
}

function test_role(): \Laravel\Jetstream\Role
{
    return new \Laravel\Jetstream\Role('admin', 'Administrator', []);
}

function test_owner_role(): \Laravel\Jetstream\OwnerRole
{
    return new \Laravel\Jetstream\OwnerRole();
}

function test_update_team_member_role(): \Laravel\Jetstream\Actions\UpdateTeamMemberRole
{
    return new \Laravel\Jetstream\Actions\UpdateTeamMemberRole();
}
