<?tyhpdef
/**
 * Hand-written Layer 1 for PECL memcached.
 * Managed PHP does not provision `memcached` (TYHP7511); signatures follow
 * PHP 8.2+ / php-memcached 3.x docs.
 *
 * @link https://www.php.net/manual/en/book.memcached.php
 */
class MemcachedException extends \RuntimeException {
    public function __construct(string $errmsg = "", int $errcode = 0);
}

class Memcached {
    public const int OPT_COMPRESSION;
    public const int OPT_COMPRESSION_TYPE;
    public const int OPT_PREFIX_KEY;
    public const int OPT_SERIALIZER;
    public const bool HAVE_IGBINARY;
    public const bool HAVE_JSON;
    public const bool HAVE_MSGPACK;
    public const bool HAVE_ENCODING;
    public const bool HAVE_SESSION;
    public const bool HAVE_SASL;
    public const int OPT_HASH;
    public const int HASH_DEFAULT;
    public const int HASH_MD5;
    public const int HASH_CRC;
    public const int HASH_FNV1_64;
    public const int HASH_FNV1A_64;
    public const int HASH_FNV1_32;
    public const int HASH_FNV1A_32;
    public const int HASH_HSIEH;
    public const int HASH_MURMUR;
    public const int OPT_DISTRIBUTION;
    public const int DISTRIBUTION_MODULA;
    public const int DISTRIBUTION_CONSISTENT;
    public const int DISTRIBUTION_VIRTUAL_BUCKET;
    public const int OPT_LIBKETAMA_COMPATIBLE;
    public const int OPT_LIBKETAMA_HASH;
    public const int OPT_TCP_KEEPALIVE;
    public const int OPT_BUFFER_WRITES;
    public const int OPT_BINARY_PROTOCOL;
    public const int OPT_NO_BLOCK;
    public const int OPT_TCP_NODELAY;
    public const int OPT_SOCKET_SEND_SIZE;
    public const int OPT_SOCKET_RECV_SIZE;
    public const int OPT_CONNECT_TIMEOUT;
    public const int OPT_RETRY_TIMEOUT;
    public const int OPT_SEND_TIMEOUT;
    public const int OPT_RECV_TIMEOUT;
    public const int OPT_POLL_TIMEOUT;
    public const int OPT_CACHE_LOOKUPS;
    public const int OPT_SERVER_FAILURE_LIMIT;
    public const int OPT_AUTO_EJECT_HOSTS;
    public const int OPT_VERIFY_KEY;
    public const int OPT_USE_UDP;
    public const int OPT_NUMBER_OF_REPLICAS;
    public const int OPT_RANDOMIZE_REPLICA_READ;
    public const int OPT_REMOVE_FAILED_SERVERS;
    public const int OPT_DEAD_TIMEOUT;
    public const int OPT_SERVER_TIMEOUT_LIMIT;
    public const int SERIALIZER_PHP;
    public const int SERIALIZER_IGBINARY;
    public const int SERIALIZER_JSON;
    public const int SERIALIZER_MSGPACK;
    public const int COMPRESSION_FASTLZ;
    public const int COMPRESSION_ZLIB;
    public const int GET_PRESERVE_ORDER;
    public const int GET_EXTENDED;
    public const int RES_SUCCESS;
    public const int RES_FAILURE;
    public const int RES_HOST_LOOKUP_FAILURE;
    public const int RES_UNKNOWN_READ_FAILURE;
    public const int RES_PROTOCOL_ERROR;
    public const int RES_CLIENT_ERROR;
    public const int RES_SERVER_ERROR;
    public const int RES_WRITE_FAILURE;
    public const int RES_DATA_EXISTS;
    public const int RES_NOTSTORED;
    public const int RES_NOTFOUND;
    public const int RES_PARTIAL_READ;
    public const int RES_SOME_ERRORS;
    public const int RES_NO_SERVERS;
    public const int RES_END;
    public const int RES_ERRNO;
    public const int RES_BUFFERED;
    public const int RES_TIMEOUT;
    public const int RES_BAD_KEY_PROVIDED;
    public const int RES_STORED;
    public const int RES_DELETED;
    public const int RES_STAT;
    public const int RES_ITEM;
    public const int RES_AUTH_PROBLEM;
    public const int RES_AUTH_FAILURE;
    public const int RES_AUTH_CONTINUE;
    public const int RES_E2BIG;
    public const int RES_KEY_TOO_BIG;
    public const int RES_SERVER_TEMPORARILY_DISABLED;
    public const int RES_SERVER_MEMORY_ALLOCATION_FAILURE;
    public const int RES_CONNECTION_FAILURE;
    public const int RES_PAYLOAD_FAILURE;

    public function __construct(string $persistent_id = "", mixed $on_new_object_cb = null, string $connection_str = "");
    public function getResultCode(): int;
    public function getResultMessage(): string;
    public function get(string $key, ?callable $cache_cb = null, int $flags = 0): mixed;
    public function getByKey(string $server_key, string $key, ?callable $cache_cb = null, int $flags = 0): mixed;
    public function getMulti(array $keys, int $flags = 0): array|false;
    public function getMultiByKey(string $server_key, array $keys, int $flags = 0): array|false;
    public function getDelayed(array $keys, bool $with_cas = false, ?callable $value_cb = null): bool;
    public function getDelayedByKey(string $server_key, array $keys, bool $with_cas = false, ?callable $value_cb = null): bool;
    public function fetch(): array|false;
    public function fetchAll(): array|false;
    public function set(string $key, mixed $value, int $expiration = 0): bool;
    public function setByKey(string $server_key, string $key, mixed $value, int $expiration = 0): bool;
    public function touch(string $key, int $expiration = 0): bool;
    public function touchByKey(string $server_key, string $key, int $expiration = 0): bool;
    public function setMulti(array $items, int $expiration = 0): bool;
    public function setMultiByKey(string $server_key, array $items, int $expiration = 0): bool;
    public function cas(string|int|float $cas_token, string $key, mixed $value, int $expiration = 0): bool;
    public function casByKey(string|int|float $cas_token, string $server_key, string $key, mixed $value, int $expiration = 0): bool;
    public function add(string $key, mixed $value, int $expiration = 0): bool;
    public function addByKey(string $server_key, string $key, mixed $value, int $expiration = 0): bool;
    public function append(string $key, string $value): bool;
    public function appendByKey(string $server_key, string $key, string $value): bool;
    public function prepend(string $key, string $value): bool;
    public function prependByKey(string $server_key, string $key, string $value): bool;
    public function replace(string $key, mixed $value, int $expiration = 0): bool;
    public function replaceByKey(string $server_key, string $key, mixed $value, int $expiration = 0): bool;
    public function delete(string $key, int $time = 0): bool;
    public function deleteMulti(array $keys, int $time = 0): array;
    public function deleteByKey(string $server_key, string $key, int $time = 0): bool;
    public function deleteMultiByKey(string $server_key, array $keys, int $time = 0): array;
    public function increment(string $key, int $offset = 1, int $initial_value = 0, int $expiry = 0): int|false;
    public function decrement(string $key, int $offset = 1, int $initial_value = 0, int $expiry = 0): int|false;
    public function incrementByKey(string $server_key, string $key, int $offset = 1, int $initial_value = 0, int $expiry = 0): int|false;
    public function decrementByKey(string $server_key, string $key, int $offset = 1, int $initial_value = 0, int $expiry = 0): int|false;
    public function addServer(string $host, int $port, int $weight = 0): bool;
    public function addServers(array $servers): bool;
    public function getServerList(): array;
    public function getServerByKey(string $server_key): array|false;
    public function resetServerList(): bool;
    public function quit(): bool;
    public function getStats(?string $type = null): array|false;
    public function getVersion(): array|false;
    public function getAllKeys(): array|false;
    public function getLastDisconnectedServer(): array|false;
    public function getLastErrorCode(): int;
    public function getLastErrorErrno(): int;
    public function getLastErrorMessage(): string;
    public function flush(int $delay = 0): bool;
    public function getOption(int $option): mixed;
    public function setOption(int $option, mixed $value): bool;
    public function setOptions(array $options): bool;
    public function setSaslAuthData(string $username, string $password): bool;
    public function isPersistent(): bool;
    public function isPristine(): bool;
}
