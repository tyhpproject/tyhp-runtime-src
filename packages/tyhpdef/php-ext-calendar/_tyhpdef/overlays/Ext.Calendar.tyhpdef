<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef`  (not under `overlays/stubs/`)
 * Follows TYHPDEF_ORDERING.md.
 * Calendar array-shapes and `jddayofweek` mode overloads.
 * Not Pure (see Pure.Calendar.tyhpdef).
 */

/**
 * Overlay: `cal_from_jd()` array-shape return.
 */
type CalFromJd = struct {
    string $date;
    int $month;
    int $day;
    int $year;
    int $dow;
    string $abbrevdayname;
    string $dayname;
    string $abbrevmonth;
    string $monthname;
};

/**
 * Overlay: `cal_info($calendar)` array-shape for a single calendar.
 * `cal_info(-1)` is `array<int, CalInfo>` keyed by `CAL_*` calendar id.
 */
type CalInfo = struct {
    array<int, string> $months;
    array<int, string> $abbrevmonths;
    int $maxdaysinmonth;
    string $calname;
    string $calsymbol;
};

// @overlay-against: function cal_from_jd(int $julian_day, int $calendar): array
function cal_from_jd(int $julian_day, int $calendar): CalFromJd;

// @overlay-against: function cal_info(int $calendar): array
function cal_info(-1 $calendar = -1): array<int, CalInfo>;
// @overlay-against: function cal_info(int $calendar): array
function cal_info(int $calendar): CalInfo;
// @overlay-against: function cal_info(int $calendar): array
function cal_info(int $calendar = -1): CalInfo|array<int, CalInfo>;

// @overlay-against: function jddayofweek(int $julian_day, int $mode): string|int
function jddayofweek(int $julian_day, 0 $mode = CAL_DOW_DAYNO): int;
// @overlay-against: function jddayofweek(int $julian_day, int $mode): string|int
function jddayofweek(int $julian_day, 1 $mode): string;
// @overlay-against: function jddayofweek(int $julian_day, int $mode): string|int
function jddayofweek(int $julian_day, 2 $mode): string;
// @overlay-against: function jddayofweek(int $julian_day, int $mode): string|int
function jddayofweek(int $julian_day, int $mode = CAL_DOW_DAYNO): string|int;
