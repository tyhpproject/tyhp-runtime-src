namespace Laravel\Dusk\Http\Controllers {
    /**
     * Payload from `UserController::user()`. Both keys are absent when nobody is logged in.
     */
    type UserControllerUserResult = struct {
        ?mixed $id;
        ?string $className;
    };

    // @overlay-against: class UserController
    partial class UserController {
        // @overlay-against: function user(string|null $guard): array
        public function user(string|null $guard = null): UserControllerUserResult;
