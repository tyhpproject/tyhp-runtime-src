namespace Laravel\Dusk {
    /**
     * Browser scoped into a frame, component, or page.
     */
    type BrowserCallback = callable(\Laravel\Dusk\Browser): void;

    /**
     * Options for `Dusk::register()`. `environments` is one environment name or a list of names, and may be omitted.
     */
    type DuskRegisterOptions = struct {
        string|array|null $environments;
    };

    /**
     * Overlay: documented array shape.
     */
    type OperatingSystemPlatformsValue = struct {
        array<int, string> $commands;
        string $slug;
    };

    /**
     * Width and height passed to `Browser::resize()`.
     */
    type ResponsiveScreenSize = struct {
        int $width;
        int $height;
    };

    // @overlay-against: class Browser implements \Laravel\Dusk\Concerns\InteractsWithAuthentication, \Laravel\Dusk\Concerns\InteractsWithCookies, \Laravel\Dusk\Concerns\InteractsWithElements, \Laravel\Dusk\Concerns\InteractsWithJavascript, \Laravel\Dusk\Concerns\InteractsWithMouse, \Laravel\Dusk\Concerns\MakesAssertions, \Laravel\Dusk\Concerns\MakesUrlAssertions, \Laravel\Dusk\Concerns\WaitsForElements, \Illuminate\Support\Traits\Macroable
    partial class Browser {
        // @overlay-against: array $ignoreConsoleMessages
        public static array<int, string> $ignoreConsoleMessages ?? [];

        // @overlay-against: array $responsiveScreenSizes
        public static array<string, ResponsiveScreenSize> $responsiveScreenSizes ?? [];

        // @overlay-against: array $supportsRemoteLogs
        public static array<int, string> $supportsRemoteLogs ?? [];

        // @overlay-against: \Closure $userResolver
        public static callable(): mixed $userResolver;

        // @overlay-against: mixed $component
        public \Laravel\Dusk\Component|null $component;

        // @overlay-against: mixed $page
        public \Laravel\Dusk\Page|null $page;

        // @overlay-against: function elsewhere(string|\Laravel\Dusk\Component $selector, \Closure $callback): static
        public function elsewhere(string|\Laravel\Dusk\Component $selector, BrowserCallback $callback): static;

        // @overlay-against: function elsewhereWhenAvailable(string $selector, \Closure $callback, int|null $seconds): static
        public function elsewhereWhenAvailable(string $selector, BrowserCallback $callback, int|null $seconds = null): static;

        // @overlay-against: function on(mixed $page): static
        public function on(\Laravel\Dusk\Page $page): static;

        // @overlay-against: function onWithoutAssert(mixed $page): static
        public function onWithoutAssert(\Laravel\Dusk\Page $page): static;

        // @overlay-against: function tap(\Closure $callback): static
        public function tap(BrowserCallback $callback): static;

        // @overlay-against: function with(string|\Laravel\Dusk\Component $selector, \Closure $callback): static
        public function with(string|\Laravel\Dusk\Component $selector, BrowserCallback $callback): static;

        // @overlay-against: function within(string|\Laravel\Dusk\Component $selector, \Closure $callback): static
        public function within(string|\Laravel\Dusk\Component $selector, BrowserCallback $callback): static;

        // @overlay-against: function withinFrame(string $selector, \Closure $callback): static
        public function withinFrame(string $selector, BrowserCallback $callback): static;
    }

    // @overlay-against: class Dusk
    partial class Dusk {
        // @overlay-against: function register(array $options): void
        public static function register(DuskRegisterOptions $options = []): void;
    }

    // @overlay-against: class ElementResolver implements \Illuminate\Support\Traits\Macroable
    partial class ElementResolver {
        // @overlay-against: function firstOrFail(array $selectors): \Facebook\WebDriver\Remote\RemoteWebElement
        public function firstOrFail(array<int, string> $selectors): \Facebook\WebDriver\Remote\RemoteWebElement;

        // @overlay-against: function resolveSelectOptions(string $field, array $values): array
        public function resolveSelectOptions(string $field, array<int, string> $values): array<int, \Facebook\WebDriver\Remote\RemoteWebElement>;
    }

    // @overlay-against: class OperatingSystem
    partial class OperatingSystem {
        /**
         * Overlay: `OperatingSystem::$platforms` uses the documented type.
         */
        // @overlay-against: array $platforms
        protected static array<string, OperatingSystemPlatformsValue> $platforms ?? [];
    }
}
namespace Laravel\Dusk\Concerns {
    // @overlay-against: trait InteractsWithAuthentication
    partial trait InteractsWithAuthentication {
        // @overlay-against: function assertAuthenticatedAs(mixed $user, string|null $guard): static
        public function assertAuthenticatedAs(\Illuminate\Contracts\Auth\Authenticatable $user, string|null $guard = null): static;
    }

    // @overlay-against: trait InteractsWithJavascript
    partial trait InteractsWithJavascript {
        // @overlay-against: function script(string|array $scripts): array
        public function script(string|array $scripts): array<int, mixed>;
    }

    // @overlay-against: trait InteractsWithKeyboard
    partial trait InteractsWithKeyboard {
        /**
