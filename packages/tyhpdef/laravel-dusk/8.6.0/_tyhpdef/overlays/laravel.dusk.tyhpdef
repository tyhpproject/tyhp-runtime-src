    }

    // @overlay-against: trait ProvidesBrowser
    partial trait ProvidesBrowser {
        // @overlay-against: function afterClass(\Closure $callback): void
        public static function afterClass(callable(): void $callback): void;
    }

    // @overlay-against: trait WaitsForElements
    partial trait WaitsForElements {
        // @overlay-against: function waitForReload(\Closure|null $callback, int|null $seconds): static
        public function waitForReload(?\Laravel\Dusk\BrowserCallback $callback = null, int|null $seconds = null): static;

        // @overlay-against: function waitUsing(int|null $seconds, int $interval, \Closure $callback, string|null $message): static
        public function waitUsing(int|null $seconds, int $interval, callable(): mixed $callback, string|null $message = null): static;

        // @overlay-against: function whenAvailable(string $selector, \Closure $callback, int|null $seconds): static
        public function whenAvailable(string $selector, \Laravel\Dusk\BrowserCallback $callback, int|null $seconds = null): static;
    }
}
