<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Transport DSN lists, MessageEvent messenger-peer erasure, AbstractStream harvest miss, profiler omit.
 */

namespace Symfony\Component\Mailer {
    /**
     * Tyhp encoding of `$dsns` as a list of DSN strings (L1 is bare `array`).
     */
    // @overlay-against: class Transport
    partial class Transport {
        /**
         * @param array<int|string, string> $dsns
         */
        // @overlay-against: function fromDsns(array $dsns, ?\Psr\EventDispatcher\EventDispatcherInterface $dispatcher, ?\Symfony\Contracts\HttpClient\HttpClientInterface $client, ?\Psr\Log\LoggerInterface $logger): \Symfony\Component\Mailer\Transport\TransportInterface
        public static function fromDsns(array<int|string, string> $dsns, ?\Psr\EventDispatcher\EventDispatcherInterface $dispatcher = null, ?\Symfony\Contracts\HttpClient\HttpClientInterface $client = null, ?\Psr\Log\LoggerInterface $logger = null): \Symfony\Component\Mailer\Transport\TransportInterface;

        /**
         * @param array<int|string, string> $dsns Transport name => DSN.
         */
        // @overlay-against: function fromStrings(array $dsns): \Symfony\Component\Mailer\Transport\Transports
        public function fromStrings(array<int|string, string> $dsns): \Symfony\Component\Mailer\Transport\Transports;

        /**
         * @param array<\Symfony\Component\Mailer\Transport\TransportFactoryInterface> $factories
         */
        // @overlay-against: function __construct(array $factories): void
        public function __construct(array<\Symfony\Component\Mailer\Transport\TransportFactoryInterface> $factories): void;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `Envelope`.
     */
    // @overlay-against: class Envelope
    partial class Envelope {
        /**
         * @param array<\Symfony\Component\Mime\Address> $recipients
         */
        // @overlay-against: function __construct(\Symfony\Component\Mime\Address $sender, array $recipients): void
        public function __construct(\Symfony\Component\Mime\Address $sender, array<\Symfony\Component\Mime\Address> $recipients): void;

        /**
         * @return array<\Symfony\Component\Mime\Address>
         */
        // @overlay-against: function getRecipients(): array
        public function getRecipients(): array<\Symfony\Component\Mime\Address>;

        /**
         * @param array<\Symfony\Component\Mime\Address> $recipients
         */
        // @overlay-against: function setRecipients(array $recipients): void
        public function setRecipients(array<\Symfony\Component\Mime\Address> $recipients): void;
    }
}

