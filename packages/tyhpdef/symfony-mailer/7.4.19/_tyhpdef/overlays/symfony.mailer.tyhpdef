namespace Symfony\Component\Mailer\Event {
    /**
     * Optional-peer erasure: L1 types stamps as messenger `StampInterface`.
     * Overlay uses `mixed` so this package's public API does not depend on a real messenger type.
     */
    // @overlay-against: class MessageEvent extends \Symfony\Contracts\EventDispatcher\Event
    partial class MessageEvent {
        // @overlay-against: function addStamp(\Symfony\Component\Messenger\Stamp\StampInterface $stamp): void
        public function addStamp(mixed $stamp): void;

        /**
         * @return array<int, mixed>
         */
        // @overlay-against: function getStamps(): array
        public function getStamps(): array<int, mixed>;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `MessageEvents`.
     */
    // @overlay-against: class MessageEvents
    partial class MessageEvents {
        /**
         * @return array<\Symfony\Component\Mailer\Event\MessageEvent>
         */
        // @overlay-against: function getEvents(?string $name): array
        public function getEvents(?string $name = null): array<\Symfony\Component\Mailer\Event\MessageEvent>;

        /**
         * @return array<\Symfony\Component\Mime\RawMessage>
         */
        // @overlay-against: function getMessages(?string $name): array
        public function getMessages(?string $name = null): array<\Symfony\Component\Mime\RawMessage>;

        /**
         * @return array<int, string> Transport names seen on recorded events.
         */
        // @overlay-against: function getTransports(): array
        public function getTransports(): array<int, string>;
    }
}

namespace Symfony\Component\Mailer\Transport\Smtp\Stream {
    /**
     * Harvest miss: `@internal` SMTP stream omitted from Layer 1; SmtpTransport / EsmtpTransport mention it.
     */
    abstract class AbstractStream {
        public static function replace(string $from, string $to, iterable $chunks): \Generator;

        abstract protected function getReadConnectionDescription(): string;

        public abstract function initialize(): void;

        public function flush(): void;

        public function getDebug(): string;

        public function hasPendingData(): bool;

        public function readLine(): string;

        public function terminate(): void;

        public function write(string $bytes, bool $debug = true): void;
    }
}

