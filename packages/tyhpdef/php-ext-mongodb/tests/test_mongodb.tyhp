<?tyhp

function test_mongodb_manager_construct(): \MongoDB\Driver\Manager
{
    return new \MongoDB\Driver\Manager('mongodb://127.0.0.1');
}

function test_mongodb_manager_null_uri(): \MongoDB\Driver\Manager
{
    return new \MongoDB\Driver\Manager();
}

function test_mongodb_objectid(): \MongoDB\BSON\ObjectId
{
    return new \MongoDB\BSON\ObjectId();
}

function test_mongodb_int64(): \MongoDB\BSON\Int64
{
    return new \MongoDB\BSON\Int64(1);
}

function test_mongodb_read_concern(): \MongoDB\Driver\ReadConcern
{
    return new \MongoDB\Driver\ReadConcern(\MongoDB\Driver\ReadConcern::MAJORITY);
}

function test_mongodb_read_preference(): \MongoDB\Driver\ReadPreference
{
    return new \MongoDB\Driver\ReadPreference(\MongoDB\Driver\ReadPreference::PRIMARY);
}

function test_mongodb_write_concern(): \MongoDB\Driver\WriteConcern
{
    return new \MongoDB\Driver\WriteConcern(\MongoDB\Driver\WriteConcern::MAJORITY);
}

function test_mongodb_unexpected_value(): \MongoDB\Driver\Exception\UnexpectedValueException
{
    return new \MongoDB\Driver\Exception\UnexpectedValueException('bad bson');
}

function test_mongodb_cursor_interface(\MongoDB\Driver\CursorInterface $cursor): \MongoDB\BSON\Int64
{
    return $cursor->getId();
}

function test_mongodb_bulk_write_command(): \MongoDB\Driver\BulkWriteCommand
{
    return new \MongoDB\Driver\BulkWriteCommand();
}
