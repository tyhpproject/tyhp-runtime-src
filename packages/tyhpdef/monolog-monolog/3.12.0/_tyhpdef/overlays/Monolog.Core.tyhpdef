<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Narrow Layer 1 harvest for Logger, LogRecord, Level, Utils, and ErrorHandler:
 * level unions, context/extra shapes, processor callables, class-string helpers,
 * and 3.12 clock / stack-trace / Utils additions.
 */

namespace Monolog {
    /**
     * Overlay: error / exception / fatal maps use PSR-3 level strings and class-strings.
     */
    // @overlay-against: class ErrorHandler
    partial class ErrorHandler {
        /**
         * @param array<int, \Psr\Log\LogLevelString>|false $errorLevelMap
         * @param array<\__ClassName, \Psr\Log\LogLevelString>|false $exceptionLevelMap
         * @param \Psr\Log\LogLevelString|null|false $fatalLevel
         */
        // @overlay-against: function register(\Psr\Log\LoggerInterface $logger, mixed $errorLevelMap, mixed $exceptionLevelMap, mixed $fatalLevel): self
        public static function register(\Psr\Log\LoggerInterface $logger, array<int, \Psr\Log\LogLevelString>|false $errorLevelMap = [], array<\__ClassName, \Psr\Log\LogLevelString>|false $exceptionLevelMap = [], \Psr\Log\LogLevelString|null|false $fatalLevel = null): self;

        /**
         * @param array<\__ClassName, \Psr\Log\LogLevelString> $levelMap
         */
        // @overlay-against: function registerExceptionHandler(array $levelMap, bool $callPrevious): self
        public function registerExceptionHandler(array<\__ClassName, \Psr\Log\LogLevelString> $levelMap = [], bool $callPrevious = true): self;

        /**
         * @param array<int, \Psr\Log\LogLevelString> $levelMap
         */
        // @overlay-against: function registerErrorHandler(array $levelMap, bool $callPrevious, int $errorTypes, bool $handleOnlyReportedErrors): self
        public function registerErrorHandler(array<int, \Psr\Log\LogLevelString> $levelMap = [], bool $callPrevious = true, int $errorTypes = -1, bool $handleOnlyReportedErrors = true): self;

        /**
         * @param \Psr\Log\LogLevelString|null $level
         */
        // @overlay-against: function registerFatalHandler(mixed $level, int $reservedMemorySize): self
        public function registerFatalHandler(\Psr\Log\LogLevelString|null $level = null, int $reservedMemorySize = 20): self;

        /**
         * Overlay: restore the harvest-missing `$errorTypes = \E_ALL` default.
         */
        // @overlay-against: function captureStackTraces(bool $capture, int $errorTypes): self
        public function captureStackTraces(bool $capture = true, int $errorTypes = \E_ALL): self;

        /**
         * @return array<\__ClassName, \Psr\Log\LogLevelString>
         */
        // @overlay-against: function defaultExceptionLevelMap(): array
        protected function defaultExceptionLevelMap(): array<\__ClassName, \Psr\Log\LogLevelString>;

        /**
         * @return array<int, \Psr\Log\LogLevelString>
         */
        // @overlay-against: function defaultErrorLevelMap(): array
        protected function defaultErrorLevelMap(): array<int, \Psr\Log\LogLevelString>;
    }

    /**
     * Overlay: name / PSR-3 level strings.
     */
    // @overlay-against: enum Level
    partial enum Level {
        /**
         * @param \Monolog\LevelNameInput $name
         */
        // @overlay-against: function fromName(string $name): self
        public static function fromName(\Monolog\LevelNameInput $name): self;

        /**
         * @return \Monolog\LevelName
         */
        // @overlay-against: function getName(): string
        public function getName(): \Monolog\LevelName;

        /**
         * @return \Psr\Log\LogLevelString
         */
        // @overlay-against: function toPsrLogLevel(): string
        public function toPsrLogLevel(): \Psr\Log\LogLevelString;
    }

    /**
     * Overlay: processor callables, context maps, `log()` level, exception handler, clock ctor.
     */
    // @overlay-against: class Logger implements \Psr\Log\LoggerInterface, \Monolog\ResettableInterface
    partial class Logger {
        /**
         * @var array<\Monolog\ProcessorCallback|\Monolog\Processor\ProcessorInterface>
         */
        // @overlay-against: array $processors
        protected array<\Monolog\ProcessorCallback|\Monolog\Processor\ProcessorInterface> $processors;

        /**
         * @var \Monolog\ExceptionHandlerCallback|null
         */
        // @overlay-against: \Closure|null $exceptionHandler
        protected \Monolog\ExceptionHandlerCallback|null $exceptionHandler ?? null;

        /**
         * @param array<\Monolog\ProcessorCallback|\Monolog\Processor\ProcessorInterface> $processors
         * @param \Psr\Clock\ClockInterface|null $clock
         */
        // @overlay-against: function __construct(string $name, array $handlers, array $processors, \DateTimeZone|null $timezone, \Psr\Clock\ClockInterface|null $clock): void
        public function __construct(string $name, array<int, \Monolog\Handler\HandlerInterface> $handlers = [], array<\Monolog\ProcessorCallback|\Monolog\Processor\ProcessorInterface> $processors = [], \DateTimeZone|null $timezone = null, \Psr\Clock\ClockInterface|null $clock = null): void;

        // @overlay-against: function pushProcessor(\Monolog\Processor\ProcessorInterface|callable $callback): self
        public function pushProcessor(\Monolog\Processor\ProcessorInterface|\Monolog\ProcessorCallback $callback): self;

        // @overlay-against: function popProcessor(): \Monolog\Processor\ProcessorInterface|callable
        public function popProcessor(): \Monolog\Processor\ProcessorInterface|\Monolog\ProcessorCallback;

        /**
         * @return array<\Monolog\Processor\ProcessorInterface|\Monolog\ProcessorCallback>
         */
        // @overlay-against: function getProcessors(): array
        public function getProcessors(): array<\Monolog\Processor\ProcessorInterface|\Monolog\ProcessorCallback>;

        /**
         * @param \Monolog\LogContext $context
         */
        // @overlay-against: function addRecord(int|\Monolog\Level $level, string $message, array $context, \Monolog\JsonSerializableDateTimeImmutable|null $datetime): bool
        public function addRecord(int|\Monolog\Level $level, string $message, \Monolog\LogContext $context = [], \Monolog\JsonSerializableDateTimeImmutable|null $datetime = null): bool;

        // @overlay-against: function getLevelName(int|\Monolog\Level $level): string
        deprecated public static function getLevelName(int|\Monolog\Level $level): \Monolog\LevelName;

        /**
         * @param \Monolog\LevelInput $level
         */
        // @overlay-against: function toMonologLevel(string|int|\Monolog\Level $level): \Monolog\Level
        public static function toMonologLevel(\Monolog\LevelInput $level): \Monolog\Level;

        /**
         * @param \Monolog\LevelInput $level
         */
        // @overlay-against: function isHandling(int|string|\Monolog\Level $level): bool
        public function isHandling(\Monolog\LevelInput $level): bool;

        // @overlay-against: function setExceptionHandler(\Closure|null $callback): self
        public function setExceptionHandler(\Monolog\ExceptionHandlerCallback|null $callback): self;

        // @overlay-against: function getExceptionHandler(): \Closure|null
        public function getExceptionHandler(): \Monolog\ExceptionHandlerCallback|null;

        /**
         * @param \Monolog\LevelInput $level
         * @param \Monolog\LogContext $context
         */
        // @overlay-against: function log(mixed $level, string|\Stringable $message, array $context): void
        public function log(\Monolog\LevelInput $level, string|\Stringable $message, \Monolog\LogContext $context = []): void;

        // Level methods share names with deprecated Logger::DEBUG/INFO/… constants, so
        // `overlay stamp` / TYHP8021 may attribute these to the const. The overlay is the function.
        /**
         * @param \Monolog\LogContext $context
         */
        // @overlay-against: function debug(string|\Stringable $message, array $context): void
        public function debug(string|\Stringable $message, \Monolog\LogContext $context = []): void;

        /**
         * @param \Monolog\LogContext $context
         */
        // @overlay-against: function info(string|\Stringable $message, array $context): void
        public function info(string|\Stringable $message, \Monolog\LogContext $context = []): void;

        /**
         * @param \Monolog\LogContext $context
         */
        // @overlay-against: function notice(string|\Stringable $message, array $context): void
        public function notice(string|\Stringable $message, \Monolog\LogContext $context = []): void;

        /**
         * @param \Monolog\LogContext $context
         */
        // @overlay-against: function warning(string|\Stringable $message, array $context): void
        public function warning(string|\Stringable $message, \Monolog\LogContext $context = []): void;

        /**
         * @param \Monolog\LogContext $context
         */
        // @overlay-against: function error(string|\Stringable $message, array $context): void
        public function error(string|\Stringable $message, \Monolog\LogContext $context = []): void;

        /**
         * @param \Monolog\LogContext $context
         */
        // @overlay-against: function critical(string|\Stringable $message, array $context): void
        public function critical(string|\Stringable $message, \Monolog\LogContext $context = []): void;

        /**
         * @param \Monolog\LogContext $context
         */
        // @overlay-against: function alert(string|\Stringable $message, array $context): void
        public function alert(string|\Stringable $message, \Monolog\LogContext $context = []): void;

        /**
         * @param \Monolog\LogContext $context
         */
        // @overlay-against: function emergency(string|\Stringable $message, array $context): void
        public function emergency(string|\Stringable $message, \Monolog\LogContext $context = []): void;
    }

    /**
     * Overlay: context/extra maps, `toArray()` shape, and `ArrayAccess` offsets.
     */
    // @overlay-against: class LogRecord implements \ArrayAccess
    partial class LogRecord implements \ArrayAccess<\Monolog\LogRecordOffset, mixed>;

    /**
     * Overlay: context/extra maps, `toArray()` shape, and `ArrayAccess` offsets.
     */
    // @overlay-against: class LogRecord implements \ArrayAccess
    partial class LogRecord {
        /**
         * @var \Monolog\LogContext
         */
        // @overlay-against: array $context
        public readonly \Monolog\LogContext $context ?? [];

        /**
         * @var \Monolog\LogContext
         */
        // @overlay-against: array $extra
        public \Monolog\LogContext $extra ?? [];

        /**
         * @param \Monolog\LogContext $context
         * @param \Monolog\LogContext $extra
         */
        // @overlay-against: function __construct(\DateTimeImmutable $datetime, string $channel, \Monolog\Level $level, string $message, array $context, array $extra, mixed $formatted): void
        public function __construct(\DateTimeImmutable $datetime, string $channel, \Monolog\Level $level, string $message, \Monolog\LogContext $context = [], \Monolog\LogContext $extra = [], mixed $formatted = null): void;

        // @overlay-against: function offsetSet(mixed $offset, mixed $value): void
        public function offsetSet(\Monolog\LogRecordOffset $offset, mixed $value): void;

        // @overlay-against: function offsetExists(mixed $offset): bool
        public function offsetExists(\Monolog\LogRecordOffset $offset): bool;

        // @overlay-against: function offsetUnset(mixed $offset): void
        public function offsetUnset(\Monolog\LogRecordOffset $offset): void;

        // @overlay-against: function offsetGet(mixed $offset): mixed
        public function &offsetGet(\Monolog\LogRecordOffset $offset): mixed;

        // @overlay-against: function toArray(): array
        public function toArray(): \Monolog\LogRecordArray;
    }

    /**
     * Overlay: `DEFAULT_JSON_FLAGS` is an int bitmask; class-string helpers for 3.12 Utils.
     */
    // @overlay-against: class Utils
    partial class Utils {
        // @overlay-against: const mixed DEFAULT_JSON_FLAGS
        public const int DEFAULT_JSON_FLAGS;

        // @overlay-against: function getClass(object $object): string
        public static function getClass<T extends object>(T $object): \__ClassName;

        /**
         * @param \__ClassName<T> $class
         */
        // @overlay-against: function getClassName(string $class): string
        public static function getClassName<T extends object>(\__ClassName<T> $class): \__ClassName;

        /**
         * @param \__ClassName<T> $class
         */
        // @overlay-against: function getSensitiveParameterNames(string $class): array
        public static function getSensitiveParameterNames<T extends object>(\__ClassName<T> $class): array<string, true>;
    }
}

namespace Monolog\Handler {
    // @overlay-against: class FirePHPHandler extends \Monolog\Handler\AbstractProcessingHandler implements \Monolog\Handler\WebRequestRecognizerTrait
    partial class FirePHPHandler {
        // @overlay-against: function createHeader(array $meta, string $message): array
        protected function createHeader(array<int|string> $meta, string $message): array<string, string>;
        // @overlay-against: function createRecordHeader(\Monolog\LogRecord $record): array
        protected function createRecordHeader(\Monolog\LogRecord $record): array<string, string>;
    }

    // @overlay-against: class LogglyHandler extends \Monolog\Handler\AbstractProcessingHandler
    partial class LogglyHandler {
        // @overlay-against: function addTag(string|array $tag): self
        public function addTag(array<int|string, string>|string $tag): self;
        // @overlay-against: function setTag(string|array $tag): self
        public function setTag(array<int|string, string>|string $tag): self;
    }

    // @overlay-against: class NativeMailerHandler extends \Monolog\Handler\MailHandler
    partial class NativeMailerHandler {
        // @overlay-against: function __construct(string|array $to, string $subject, string $from, int|string|\Monolog\Level $level, bool $bubble, int $maxColumnWidth): void
        public function __construct(string|array<int|string, string> $to, string $subject, string $from, int|string|\Monolog\Level $level = \Monolog\Level::Error, bool $bubble = true, int $maxColumnWidth = 70): void;
    }

    // @overlay-against: class SendGridHandler extends \Monolog\Handler\MailHandler
    partial class SendGridHandler {
        // @overlay-against: function __construct(string|null $apiUser, string $apiKey, string $from, array|string $to, string $subject, int|string|\Monolog\Level $level, bool $bubble, string $apiHost): void
        public function __construct(string|null $apiUser, string $apiKey, string $from, array<int|string, string>|string $to, string $subject, int|string|\Monolog\Level $level = \Monolog\Level::Error, bool $bubble = true, string $apiHost = 'api.sendgrid.com'): void;
    }

    // @overlay-against: class SocketHandler extends \Monolog\Handler\AbstractProcessingHandler
    partial class SocketHandler {
        // @overlay-against: function streamGetMetadata(): array|bool
        protected function streamGetMetadata(): array<int, mixed>|bool;
    }
}

namespace Monolog\Processor {
    // @overlay-against: class WebProcessor implements \Monolog\Processor\ProcessorInterface
    partial class WebProcessor {
        // @overlay-against: function __construct(array|\ArrayAccess|null $serverData, array|null $extraFields): void
        public function __construct(array|\ArrayAccess|null $serverData = null, array<string, string>|array<int|string, string>|null $extraFields = null): void;
    }
}
