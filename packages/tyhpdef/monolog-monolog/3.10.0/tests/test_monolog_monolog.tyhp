<?tyhp

function test_monolog_monolog_package_loads(): bool
{
    return true;
}

function test_logger_log_level_and_context(): void
{
    $logger = new \Monolog\Logger('app');
    $logger->log(\Monolog\Level::Info, 'hi', ['user' => 1]);
    $name = \Monolog\Level::Debug->getName();
    $logger->debug($name, ['ok' => true]);
}
