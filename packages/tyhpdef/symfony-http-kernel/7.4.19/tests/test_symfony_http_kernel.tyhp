<?tyhp

function test_http_kernel_handle(\Symfony\Component\HttpKernel\HttpKernelInterface $kernel): \Symfony\Component\HttpFoundation\Response
{
    $request = \Symfony\Component\HttpFoundation\Request::create('/');
    return $kernel->handle($request, \Symfony\Component\HttpKernel\HttpKernelInterface::MAIN_REQUEST, true);
}

function test_http_kernel_construct(
    \Symfony\Contracts\EventDispatcher\EventDispatcherInterface $dispatcher,
    \Symfony\Component\HttpKernel\Controller\ControllerResolverInterface $resolver
): \Symfony\Component\HttpKernel\HttpKernel {
    return new \Symfony\Component\HttpKernel\HttpKernel($dispatcher, $resolver);
}

function test_http_kernel_terminate(\Symfony\Component\HttpKernel\TerminableInterface $kernel, \Symfony\Component\HttpFoundation\Request $request, \Symfony\Component\HttpFoundation\Response $response): void
{
    $kernel->terminate($request, $response);
}
