{
    "name": "tyhpdef/phpstan-phpstan-symfony",
    "description": "Tyhp type definitions for the Composer package phpstan/phpstan-symfony (2.0.20).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.0.20.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/phpstan-phpstan": "@dev",
                "tyhpdef/nikic-php-parser": "@dev",
                "tyhpdef/phpstan-phpdoc-parser": "@dev",
                "tyhpdef/symfony-framework-bundle": "@dev",
                "tyhpdef/symfony-console": "@dev",
                "tyhpdef/symfony-config": "@dev",
                "tyhpdef/symfony-dependency-injection": "@dev",
                "tyhpdef/symfony-form": "@dev",
                "tyhpdef/symfony-http-foundation": "@dev",
                "tyhpdef/symfony-messenger": "@dev",
                "tyhpdef/symfony-serializer": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "phpstan/phpstan-symfony": "2.0.20"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/phpstan-phpstan": "@dev",
        "tyhpdef/nikic-php-parser": "@dev",
        "tyhpdef/phpstan-phpdoc-parser": "@dev",
        "tyhpdef/symfony-framework-bundle": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/symfony-config": "@dev",
        "tyhpdef/symfony-dependency-injection": "@dev",
        "tyhpdef/symfony-form": "@dev",
        "tyhpdef/symfony-http-foundation": "@dev",
        "tyhpdef/symfony-messenger": "@dev",
        "tyhpdef/symfony-serializer": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../phpstan-phpstan/2.2.14"
        },
        {
            "type": "path",
            "url": "../../nikic-php-parser/5.9.0"
        },
        {
            "type": "path",
            "url": "../../phpstan-phpdoc-parser/2.3.5"
        },
        {
            "type": "path",
            "url": "../../symfony-framework-bundle/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-console/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-config/7.4.17"
        },
        {
            "type": "path",
            "url": "../../symfony-dependency-injection/7.4.17"
        },
        {
            "type": "path",
            "url": "../../symfony-form/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-http-foundation/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-messenger/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-serializer/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-service-contracts/3.7.3"
        }
    ]
}
