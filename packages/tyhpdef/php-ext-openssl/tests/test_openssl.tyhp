<?tyhp

function test_openssl_encrypt_signature(): string|false
{
    return openssl_encrypt('data', 'aes-256-cbc', 'passphrase', 0, '1234567890123456');
}

// `openssl_password_hash()` / `openssl_password_verify()` are new in PHP 8.4 and are only
// in scope when compiling for `output.phpVersion` >= 8.4 — see tyhp-php8.5.json.
declare(php=">=8.4") {
    function test_openssl_password_hash_and_verify(string $password): bool
    {
        string $hash = openssl_password_hash('argon2id', $password);
        return openssl_password_verify('argon2id', $password, $hash);
    }
}
