         */
        // @overlay-against: function execute(\Illuminate\Foundation\Exceptions\Renderer\Exception $exception): array
        public function execute(\Illuminate\Foundation\Exceptions\Renderer\Exception $exception): MapLaravelExceptionReport;
    }

    // @overlay-against: class MapLaravelStackTraceAction
    partial class MapLaravelStackTraceAction {
        /**
         * Overlay: `MapLaravelStackTraceAction::execute()` returns a list of frames.
         */
        // @overlay-against: function execute(\Illuminate\Foundation\Exceptions\Renderer\Exception $exception): array
        public function execute(\Illuminate\Foundation\Exceptions\Renderer\Exception $exception): array<int, MapLaravelStackFrame>;
    }

    // @overlay-against: class ResolveErrorSharePropertiesAction
    partial class ResolveErrorSharePropertiesAction {
