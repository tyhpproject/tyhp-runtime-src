<?tyhp

function test_schema_factory_create(
    \Infection\Configuration\Schema\SchemaConfigurationFactory $factory,
    \stdClass $raw
): \Infection\Configuration\Schema\SchemaConfiguration {
    return $factory->create('/tmp/infection.json', $raw);
}

function test_schema_loader_load(
    \Infection\Configuration\Schema\SchemaConfigurationFileLoader $loader
): \Infection\Configuration\Schema\SchemaConfiguration {
    return $loader->loadFile('/tmp/infection.json');
}

function test_mutation_logger_start(\Infection\Logger\MutationAnalysis\MutationAnalysisLogger $logger): void
{
    $logger->startAnalysis(1);
}
