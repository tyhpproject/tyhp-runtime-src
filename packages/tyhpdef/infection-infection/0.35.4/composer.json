{
    "name": "tyhpdef/infection-infection",
    "description": "Tyhp type definitions for the Composer package infection/infection (0.35.4).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "0.35.4.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.3",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/nikic-php-parser": "@dev",
                "tyhpdef/phpunit-phpunit": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "infection/infection": "0.35.4"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/nikic-php-parser": "@dev",
        "tyhpdef/phpunit-phpunit": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../nikic-php-parser/5.9.0"
        },
        {
            "type": "path",
            "url": "../../phpunit-phpunit/12.5.35"
        }
    ],
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
