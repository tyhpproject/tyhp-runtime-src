<?tyhp

function test_email_validator_rfc(): bool
{
    $v = new \Egulias\EmailValidator\EmailValidator();
    return $v->isValid('user@example.com', new \Egulias\EmailValidator\Validation\RFCValidation());
}

function test_email_validator_warnings(\Egulias\EmailValidator\EmailValidator $v): bool
{
    return $v->hasWarnings();
}

function test_email_validator_and(\Egulias\EmailValidator\Validation\EmailValidation $a, \Egulias\EmailValidator\Validation\EmailValidation $b): \Egulias\EmailValidator\Validation\EmailValidation
{
    return new \Egulias\EmailValidator\Validation\MultipleValidationWithAnd([$a, $b]);
}
