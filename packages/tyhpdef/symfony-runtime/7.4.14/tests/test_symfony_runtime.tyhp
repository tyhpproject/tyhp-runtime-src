<?tyhp

function test_runtime_get_runner(\Symfony\Component\Runtime\RuntimeInterface $runtime): \Symfony\Component\Runtime\RunnerInterface
{
    return $runtime->getRunner(new \stdClass());
}

function test_runtime_get_resolver(\Symfony\Component\Runtime\RuntimeInterface $runtime): \Symfony\Component\Runtime\ResolverInterface
{
    return $runtime->getResolver(function (): \stdClass {
        return new \stdClass();
    });
}
