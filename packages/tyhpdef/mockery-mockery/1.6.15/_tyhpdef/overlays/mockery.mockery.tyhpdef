<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * PHPUnit 12 has no TestListener; MockInterface allows/expects narrow from PHPDoc.
 */

namespace Mockery {
    /**
     * Overlay: allows/expects PHPDoc conditionals.
     */
    // @overlay-against: interface MockInterface
    partial interface MockInterface {
        /**
         * @return mixed ($something is string ? Expectation : ($something is list{} ? HigherOrderMessage : self))
         */
        // @overlay-against: function allows(mixed $something): mixed
        public function allows(string $something): \Mockery\Expectation;

        /**
         * @return mixed ($something is string ? Expectation : ($something is list{} ? HigherOrderMessage : self))
         */
        // @overlay-against: function allows(mixed $something): mixed
        public function allows(): \Mockery\HigherOrderMessage;

        /**
         * @return mixed ($something is string ? Expectation : ($something is list{} ? HigherOrderMessage : self))
         */
        // @overlay-against: function allows(mixed $something): mixed
        public function allows(array<string, mixed> $something): self;

        /**
         * @return mixed ($something is string ? Expectation : ExpectsHigherOrderMessage)
         */
        // @overlay-against: function expects(mixed $something): mixed
        public function expects(string $something): \Mockery\Expectation;

        /**
         * @return mixed ($something is string ? Expectation : ExpectsHigherOrderMessage)
         */
        // @overlay-against: function expects(mixed $something): mixed
        public function expects(): \Mockery\ExpectsHigherOrderMessage;
    }
}

namespace Mockery\Adapter\Phpunit {
    /**
     * PHPUnit 12 removed TestListener; this adapter is omitted rather than inventing those types.
     */
    // @overlay-against: class TestListener implements \PHPUnit\Framework\TestListener, \PHPUnit\Framework\TestListenerDefaultImplementation
    omit class TestListener {
    }

    // @overlay-against: class TestListenerTrait
    omit class TestListenerTrait {
    }
}

namespace Mockery {
    // @overlay-against: class Expectation implements \Mockery\ExpectationInterface
    partial class Expectation {
        // @overlay-against: function andSet(string $name, mixed $values): self
        public function andSet(string $name, array<int|string, mixed> ...$values): self;
    }

    // @overlay-against: interface LegacyMockInterface
    partial interface LegacyMockInterface {
        // @overlay-against: function shouldNotReceive(mixed $methodNames): mixed
        public function shouldNotReceive(): \Mockery\HigherOrderMessage;
        // @overlay-against: function shouldNotReceive(mixed $methodNames): mixed
        public function shouldNotReceive(string ...$methodNames): \Mockery\ExpectationInterface;
        // @overlay-against: function shouldNotReceive(mixed $methodNames): mixed
        public function shouldNotReceive(array<string, mixed> ...$methodNames): self;
        // @overlay-against: function shouldReceive(mixed $methodNames): mixed
        public function shouldReceive(): \Mockery\HigherOrderMessage;
        // @overlay-against: function shouldReceive(mixed $methodNames): mixed
        public function shouldReceive(string ...$methodNames): \Mockery\ExpectationInterface;
        // @overlay-against: function shouldReceive(mixed $methodNames): mixed
        public function shouldReceive(array<string, mixed> ...$methodNames): self;
    }

    // @overlay-against: class MethodCall
    partial class MethodCall {
        // @overlay-against: function __construct(string $method, array $args): void
        public function __construct(string $method, array<int, mixed> $args): void;

        // @overlay-against: function getArgs(): array
        public function getArgs(): array<int, mixed>;
    }

    // @overlay-against: class Mock implements \Mockery\MockInterface
    partial class Mock {
        // @overlay-against: function shouldNotReceive(mixed $methodNames): mixed
        public function shouldNotReceive(): \Mockery\HigherOrderMessage;
        // @overlay-against: function shouldNotReceive(mixed $methodNames): mixed
        public function shouldNotReceive(string ...$methodNames): \Mockery\ExpectationInterface;
        // @overlay-against: function shouldNotReceive(mixed $methodNames): mixed
        public function shouldNotReceive(array<string, mixed> ...$methodNames): self;
        // @overlay-against: function shouldReceive(mixed $methodNames): mixed
        public function shouldReceive(): \Mockery\HigherOrderMessage;
        // @overlay-against: function shouldReceive(mixed $methodNames): mixed
        public function shouldReceive(string ...$methodNames): \Mockery\ExpectationInterface;
        // @overlay-against: function shouldReceive(mixed $methodNames): mixed
        public function shouldReceive(array<string, mixed> ...$methodNames): self;
    }
}

namespace Mockery\Generator\StringManipulation\Pass {
    // @overlay-against: class InterfacePass implements \Mockery\Generator\StringManipulation\Pass\Pass
    partial class InterfacePass {
        // @overlay-against: function apply(mixed $code, \Mockery\Generator\MockConfiguration $config): mixed
        public function apply(string $code, \Mockery\Generator\MockConfiguration $config): string;
    }

    // @overlay-against: class MagicMethodTypeHintsPass implements \Mockery\Generator\StringManipulation\Pass\Pass
    partial class MagicMethodTypeHintsPass {
        // @overlay-against: function apply(mixed $code, \Mockery\Generator\MockConfiguration $config): mixed
        public function apply(string $code, \Mockery\Generator\MockConfiguration $config): string;
    }
}

/**
 * Overlay: deprecated builtin-type catalog is a list of type-name strings.
 */
// @overlay-against: class Mockery
partial class Mockery {
    // @overlay-against: function builtInTypes(): array
    deprecated public static function builtInTypes(): array<int, string>;
}
