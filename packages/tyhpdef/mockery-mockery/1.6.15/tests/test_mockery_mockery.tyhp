<?tyhp

function test_mockery_close(): void
{
    \Mockery::close();
}

function test_mockery_any(): \Mockery\Matcher\Any
{
    return \Mockery::any();
}

function test_mockery_mock_stdclass(): \Mockery\MockInterface
{
    return \Mockery::mock(\stdClass::class);
}

function test_mockery_allows_string(\Mockery\MockInterface $mock): \Mockery\Expectation
{
    return $mock->allows('foo');
}

function test_mockery_expects_named(\Mockery\MockInterface $mock): \Mockery\Expectation
{
    return $mock->expects('bar');
}
