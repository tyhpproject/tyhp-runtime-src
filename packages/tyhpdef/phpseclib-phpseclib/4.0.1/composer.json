{
    "name": "tyhpdef/phpseclib-phpseclib",
    "description": "Tyhp type definitions for the Composer package phpseclib/phpseclib (4.0.1).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "4.0.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/paragonie-constant_time_encoding": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "phpseclib/phpseclib": "^4.0",
        "tyhpdef/paragonie-constant_time_encoding": "^3.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/paragonie-constant_time_encoding": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../paragonie-constant_time_encoding/3.1.3"
        }
    ]
}
