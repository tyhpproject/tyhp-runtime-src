namespace Psr\Container {
    /**
     * Overlay: `get(Foo::class)` returns `Foo`; other string ids keep a generic result.
     */
    // @overlay-against: interface ContainerInterface
    partial interface ContainerInterface {
        /**
         * @param \__ClassName<T> $id Class name used as the container id.
         * @return T Entry of that class.
         * @throws \Psr\Container\NotFoundExceptionInterface
         * @throws \Psr\Container\ContainerExceptionInterface
         */
        // @overlay-against: function get(string $id): mixed
        public function get<T extends object>(\__ClassName<T> $id): T;

        /**
         * @param string $id Identifier of the entry to look for.
         * @return T Entry.
         * @throws \Psr\Container\NotFoundExceptionInterface
         * @throws \Psr\Container\ContainerExceptionInterface
         */
        // @overlay-against: function get(string $id): mixed
        public function get<T = mixed>(string $id): T;
    }
}
