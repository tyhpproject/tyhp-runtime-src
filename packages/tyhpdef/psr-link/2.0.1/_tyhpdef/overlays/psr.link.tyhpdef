<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Attribute value union from PSR-13 and string-keyed attribute maps.
 */

namespace Psr\Link {
    /**
     * Attribute value: PHP primitive or a list of strings (PSR-13 `getAttributes()`).
     */
    type LinkAttributeValue = string|int|float|bool|array<int, string>;

    /**
     * Attribute map from `LinkInterface::getAttributes()`.
     */
    type LinkAttributes = array<string, \Psr\Link\LinkAttributeValue>;

    /**
     * Overlay: `getAttributes()` is a string-keyed primitive/list map.
     */
    // @overlay-against: interface LinkInterface
    partial interface LinkInterface {
        /**
         * @return \Psr\Link\LinkAttributes Key-value attributes; empty array when none.
         */
        // @overlay-against: function getAttributes(): array
        public function getAttributes(): \Psr\Link\LinkAttributes;
    }

    /**
     * Overlay: `withAttribute()` value matches PSR-13 (primitives, `Stringable`, string lists).
     */
    // @overlay-against: interface EvolvableLinkInterface
    partial interface EvolvableLinkInterface {
        /**
         * @param string|\Stringable|int|float|bool|array<int, string> $value Attribute value.
         */
        // @overlay-against: function withAttribute(string $attribute, string|\Stringable|int|float|bool|array $value): static
        public function withAttribute(string $attribute, string|\Stringable|int|float|bool|array<int, string> $value): static;
    }
}
