<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Stable `__soapCall` option shape, class/function names, and list returns.
 * Constructor option bags stay `array` (keys vary by WSDL vs non-WSDL). Not Pure.
 */

/**
 * Overlay: `$options` passed to `SoapClient::__soapCall()`.
 * PHP documents these three keys; omit any that should use the client default.
 */
type SoapCallOptions = struct {
    ?string $location;
    ?string $uri;
    ?string $soapaction;
};

// @overlay-against: class SoapClient
partial class SoapClient {
    // @overlay-against: function __call(string $name, array $args): mixed
    public function __call(string $name, array<int, mixed> $args): mixed;
    // @overlay-against: function __getCookies(): array
    public function __getCookies(): array<string, array<int, string>>;
    // @overlay-against: function __getFunctions(): ?array
    public function __getFunctions(): ?array<int, string>;
    // @overlay-against: function __getTypes(): ?array
    public function __getTypes(): ?array<int, string>;
    // @overlay-against: function __soapCall(string $name, array $args, ?array $options, mixed $inputHeaders, mixed $outputHeaders): mixed
    public function __soapCall(string $name, array<int|string, mixed> $args, ?SoapCallOptions $options = null, \SoapHeader|array<int, \SoapHeader>|null $inputHeaders = null, mixed &$outputHeaders = null): mixed;
}

// @overlay-against: class SoapServer
partial class SoapServer {
    // @overlay-against: function addFunction(mixed $functions): void
    public function addFunction(__FunctionName|array<int, __FunctionName>|int $functions): void;
    // @overlay-against: function getFunctions(): array
    public function getFunctions(): array<int, string>;
    // @overlay-against: function setClass(string $class, mixed $args): void
    public function setClass(__ClassName $class, mixed ...$args): void;
}
