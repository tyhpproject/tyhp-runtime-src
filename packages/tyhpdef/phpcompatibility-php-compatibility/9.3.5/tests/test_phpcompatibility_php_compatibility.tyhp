<?tyhp

function test_phpcompatibility_helper_version(): string
{
    return \PHPCompatibility\PHPCSHelper::getVersion();
}

function test_phpcompatibility_forbidden_names_register(): array
{
    $sniff = new \PHPCompatibility\Sniffs\Keywords\ForbiddenNamesSniff();
    return $sniff->register();
}

function test_phpcompatibility_strip_quotes(): string
{
    $sniff = new \PHPCompatibility\Sniffs\Keywords\ForbiddenNamesSniff();
    return $sniff->stripQuotes("'name'");
}
