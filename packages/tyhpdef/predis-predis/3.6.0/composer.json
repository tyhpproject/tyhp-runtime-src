{
  "name": "tyhpdef/predis-predis",
  "description": "Tyhp type definitions for the Composer package predis/predis (3.6.0).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "3.6.0.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/psr-http-client": "@dev",
        "tyhpdef/psr-http-factory": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/php-ext-session": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "predis/predis": "3.6.0"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/psr-http-message": "@dev",
    "tyhpdef/psr-http-client": "@dev",
    "tyhpdef/psr-http-factory": "@dev",
    "tyhpdef/psr-container": "@dev",
    "tyhpdef/php-ext-session": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../psr-http-message/2.0"
    },
    {
      "type": "path",
      "url": "../../psr-http-client/1.0.3"
    },
    {
      "type": "path",
      "url": "../../psr-http-factory/1.1.0"
    },
    {
      "type": "path",
      "url": "../../psr-container/2.0.2"
    },
    {
      "type": "path",
      "url": "../../php-ext-session"
    }
  ]
}
