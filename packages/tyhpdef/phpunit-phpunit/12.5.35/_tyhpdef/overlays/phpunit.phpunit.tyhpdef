<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Layer 1 omitted `@internal` PHPUnit types still named by TestCase / Assert.
 * Sebastian / Phar-io peers are optional — extern, do not invent.
 */

extern class \SebastianBergmann\Comparator\ComparisonFailure;
extern class \SebastianBergmann\Comparator\Comparator;
extern interface \PharIo\Version\VersionConstraint;

namespace PHPUnit\Framework {
    /**
     * Overlay: class/interface names are symbol types; createMock / createStub / getMockBuilder
     * return a double of T (PHPDoc `@template RealInstanceType`).
     */
    // @overlay-against: class TestCase extends \PHPUnit\Framework\Assert implements \PHPUnit\Framework\Reorderable, \PHPUnit\Framework\SelfDescribing, \PHPUnit\Framework\Test
    partial class TestCase {
        /**
         * @template RealInstanceType of object
         * @param class-string<RealInstanceType> $type
         */
        // @overlay-against: function createStub(string $type): \PHPUnit\Framework\MockObject\Stub
        protected static function createStub<RealInstanceType extends object>(__ClassName<RealInstanceType>|__InterfaceName<RealInstanceType> $type): \PHPUnit\Framework\MockObject\Stub&RealInstanceType;

        /**
         * @template RealInstanceType of object
         * @param class-string<RealInstanceType> $type
         */
        // @overlay-against: function createMock(string $type): \PHPUnit\Framework\MockObject\MockObject
        protected function createMock<RealInstanceType extends object>(__ClassName<RealInstanceType>|__InterfaceName<RealInstanceType> $type): \PHPUnit\Framework\MockObject\MockObject&RealInstanceType;

        /**
         * @template RealInstanceType of object
         * @param class-string<RealInstanceType> $className
         */
        // @overlay-against: function getMockBuilder(string $className): \PHPUnit\Framework\MockObject\MockBuilder
        protected function getMockBuilder<RealInstanceType extends object>(__ClassName<RealInstanceType>|__InterfaceName<RealInstanceType> $className): \PHPUnit\Framework\MockObject\MockBuilder<RealInstanceType>;
    }

    /**
     * Overlay: assertion class/interface names are symbol types.
     */
    // @overlay-against: class Assert
    partial class Assert {
        /**
         * @template ExpectedType of object
         * @param class-string<ExpectedType> $expected
         */
        // @overlay-against: function assertInstanceOf(string $expected, mixed $actual, string $message): void
        public static function assertInstanceOf<ExpectedType extends object>(__ClassName<ExpectedType>|__InterfaceName<ExpectedType> $expected, mixed $actual, string $message = ''): void;

        // @overlay-against: function assertIsArray(mixed $actual, string $message): void
        public static function assertIsArray(mixed $actual, string $message = ''): $actual is array;

        // @overlay-against: function assertIsBool(mixed $actual, string $message): void
        public static function assertIsBool(mixed $actual, string $message = ''): $actual is bool;

        // @overlay-against: function assertIsCallable(mixed $actual, string $message): void
        public static function assertIsCallable(mixed $actual, string $message = ''): $actual is callable;

        // @overlay-against: function assertIsFloat(mixed $actual, string $message): void
        public static function assertIsFloat(mixed $actual, string $message = ''): $actual is float;

        // @overlay-against: function assertIsInt(mixed $actual, string $message): void
        public static function assertIsInt(mixed $actual, string $message = ''): $actual is int;

        // @overlay-against: function assertIsIterable(mixed $actual, string $message): void
        public static function assertIsIterable(mixed $actual, string $message = ''): $actual is iterable;

        // @overlay-against: function assertIsNumeric(mixed $actual, string $message): void
        public static function assertIsNumeric(mixed $actual, string $message = ''): $actual is int|float|string;

        // @overlay-against: function assertIsObject(mixed $actual, string $message): void
        public static function assertIsObject(mixed $actual, string $message = ''): $actual is object;

        // @overlay-against: function assertIsResource(mixed $actual, string $message): void
        public static function assertIsResource(mixed $actual, string $message = ''): $actual is resource;

        // @overlay-against: function assertIsScalar(mixed $actual, string $message): void
        public static function assertIsScalar(mixed $actual, string $message = ''): $actual is int|float|string|bool;

        // @overlay-against: function assertIsString(mixed $actual, string $message): void
        public static function assertIsString(mixed $actual, string $message = ''): $actual is string;

        // @overlay-against: function assertContainsOnlyArray(iterable $haystack, string $message): void
        public static function assertContainsOnlyArray(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<array>;

        // @overlay-against: function assertContainsOnlyBool(iterable $haystack, string $message): void
        public static function assertContainsOnlyBool(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<bool>;

        // @overlay-against: function assertContainsOnlyCallable(iterable $haystack, string $message): void
        public static function assertContainsOnlyCallable(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<callable>;

        // @overlay-against: function assertContainsOnlyFloat(iterable $haystack, string $message): void
        public static function assertContainsOnlyFloat(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<float>;

        // @overlay-against: function assertContainsOnlyInt(iterable $haystack, string $message): void
        public static function assertContainsOnlyInt(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<int>;

        // @overlay-against: function assertContainsOnlyIterable(iterable $haystack, string $message): void
        public static function assertContainsOnlyIterable(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<iterable>;

        // @overlay-against: function assertContainsOnlyNull(iterable $haystack, string $message): void
        public static function assertContainsOnlyNull(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<null>;

        // @overlay-against: function assertContainsOnlyNumeric(iterable $haystack, string $message): void
        public static function assertContainsOnlyNumeric(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<int|float|string>;

        // @overlay-against: function assertContainsOnlyObject(iterable $haystack, string $message): void
        public static function assertContainsOnlyObject(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<object>;

        // @overlay-against: function assertContainsOnlyResource(iterable $haystack, string $message): void
        public static function assertContainsOnlyResource(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<resource>;

        // @overlay-against: function assertContainsOnlyScalar(iterable $haystack, string $message): void
        public static function assertContainsOnlyScalar(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<int|float|string|bool>;

        // @overlay-against: function assertContainsOnlyString(iterable $haystack, string $message): void
        public static function assertContainsOnlyString(iterable<mixed> $haystack, string $message = ''): $haystack is iterable<string>;

        /**
         * @param \__ClassName<T>|\__InterfaceName<T> $className
         */
        // @overlay-against: function assertContainsOnlyInstancesOf(string $className, iterable $haystack, string $message): void
        public static function assertContainsOnlyInstancesOf<T extends object>(__ClassName<T>|__InterfaceName<T> $className, iterable<mixed> $haystack, string $message = ''): $haystack is iterable<T>;

        /**
         * @param callable(CallbackInput): bool $callback
         */
        // @overlay-against: function callback(callable $callback): \PHPUnit\Framework\Constraint\Callback
        public static function callback<CallbackInput = mixed>(callable(CallbackInput): bool $callback): \PHPUnit\Framework\Constraint\Callback<CallbackInput>;
    }

    /**
     * `@internal` stringification used by TestCase.
     */
    interface SelfDescribing {
        public function toString(): string;
    }

    /**
     * `@internal` dependency record returned by Reorderable.
     */
    final class ExecutionOrderDependency {
    }

    /**
     * `@internal` suite-order hooks used by TestCase.
     */
    interface Reorderable {
        public function sortId(): string;

        /**
         * @return array<int, \PHPUnit\Framework\ExecutionOrderDependency>
         */
        public function provides(): array<int, \PHPUnit\Framework\ExecutionOrderDependency>;

        /**
         * @return array<int, \PHPUnit\Framework\ExecutionOrderDependency>
         */
        public function requires(): array<int, \PHPUnit\Framework\ExecutionOrderDependency>;
    }

    /**
     * Failed-assertion error omitted by Layer 1.
     */
    class AssertionFailedError extends \Exception implements \PHPUnit\Framework\SelfDescribing {
        public function toString(): string;
    }
}

namespace PHPUnit\Framework\MockObject {
    /**
     * Mock-object exception marker omitted by Layer 1.
     */
    interface Exception {
    }

    /**
     * Invocation record used by mock matchers.
     */
    class Invocation {
    }
}

namespace PHPUnit\Framework\MockObject\Rule {
    /**
     * Invocation-count matcher base omitted by Layer 1.
     */
    class InvocationOrder {
    }

    class AnyInvokedCount extends \PHPUnit\Framework\MockObject\Rule\InvocationOrder {
    }

    class InvokedCount extends \PHPUnit\Framework\MockObject\Rule\InvocationOrder {
    }

    class InvokedAtLeastCount extends \PHPUnit\Framework\MockObject\Rule\InvocationOrder {
    }

    class InvokedAtLeastOnce extends \PHPUnit\Framework\MockObject\Rule\InvocationOrder {
    }

    class InvokedAtMostCount extends \PHPUnit\Framework\MockObject\Rule\InvocationOrder {
    }
}

namespace PHPUnit\Framework\MockObject\Stub {
    /**
     * Stub configuration object named by TestCase helpers.
     */
    interface Stub {
    }

    class Exception {
    }
}

namespace PHPUnit\Event {
    /**
     * Event facade / emitter omitted by Layer 1 (`@internal`).
     */
    final class Facade {
    }

    interface Emitter {
    }
}

namespace PHPUnit\TestRunner\TestResult {
    /**
     * Passed-test accumulator omitted by Layer 1.
     */
    final class PassedTests {
    }
}

namespace PHPUnit\Runner {
    /**
     * Coverage coordinator omitted by Layer 1.
     */
    final class CodeCoverage {
    }
}

namespace PHPUnit\TextUI\Output {
    /**
     * Printer used by TextUI result printers.
     */
    interface Printer {
    }
}
