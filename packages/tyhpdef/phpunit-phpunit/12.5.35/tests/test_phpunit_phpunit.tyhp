<?tyhp

function test_assert_same(): void
{
    \PHPUnit\Framework\Assert::assertSame(1, 1);
}

function test_assert_true(): void
{
    \PHPUnit\Framework\Assert::assertTrue(true);
}

function test_assert_directory_missing(): void
{
    \PHPUnit\Framework\Assert::assertDirectoryDoesNotExist('/tmp/tyhp-phpunit-missing');
}

function test_assert_instance_of(): void
{
    \PHPUnit\Framework\Assert::assertInstanceOf(\Exception::class, new \Exception('phpunit'));
}

function test_testcase_type(\PHPUnit\Framework\TestCase $case): \PHPUnit\Framework\TestCase
{
    return $case;
}

function test_assertion_failed_error(): \PHPUnit\Framework\AssertionFailedError
{
    return new \PHPUnit\Framework\AssertionFailedError();
}
