<?tyhp

function test_phpunit_version_supports_test_attribute(): \PHPStan\TrinaryLogic
{
    return (new \PHPStan\Rules\PHPUnit\PHPUnitVersion(12, 5))->supportsTestAttribute();
}

function test_phpunit_version_detector(\PHPStan\Rules\PHPUnit\PHPUnitVersionDetector $detector): \PHPStan\Rules\PHPUnit\PHPUnitVersion
{
    return $detector->createPHPUnitVersion();
}
