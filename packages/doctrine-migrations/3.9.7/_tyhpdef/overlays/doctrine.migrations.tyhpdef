<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * CLI commands extend Symfony Console (`extern` cannot be extended).
 * Migrator and GlobFinder returns match the interfaces.
 */

namespace Doctrine\Migrations {
    /**
     * Interface return is SQL grouped by version. Layer 1 left a bare array.
     */
    // @overlay-against: class DbalMigrator implements \Doctrine\Migrations\Migrator
    partial class DbalMigrator {
        /**
         * @return array<string, array<int|string, \Doctrine\Migrations\Query\Query>>
         */
        // @overlay-against: function migrate(\Doctrine\Migrations\Metadata\MigrationPlanList $migrationsPlan, \Doctrine\Migrations\MigratorConfiguration $migratorConfiguration): array
        public function migrate(\Doctrine\Migrations\Metadata\MigrationPlanList $migrationsPlan, \Doctrine\Migrations\MigratorConfiguration $migratorConfiguration): array<string, array<int|string, \Doctrine\Migrations\Query\Query>>;
    }
}

namespace Doctrine\Migrations\Finder {
    /**
     * Interface return is a list of class names. Layer 1 left a bare array.
     */
    // @overlay-against: class GlobFinder extends \Doctrine\Migrations\Finder\Finder
    partial class GlobFinder {
        /**
         * @return array<int|string, string>
         */
        // @overlay-against: function findMigrations(string $directory, string|null $namespace): array
        public function findMigrations(string $directory, string|null $namespace = null): array<int|string, string>;
    }
}

namespace Doctrine\Migrations\Provider {
    /**
     * Internal lazy schema uses Symfony VarExporter (`extern` trait).
     */
    // @overlay-against: class LazySchema extends \Doctrine\DBAL\Schema\Schema implements \Symfony\Component\VarExporter\LazyProxyTrait
    omit class LazySchema {
    }
}

namespace Doctrine\Migrations\Tools\Console {
    /**
     * Console runner returns Symfony Console Application (`extern` cannot be
     * constructed as a real return type in tests).
     */
    // @overlay-against: class ConsoleRunner
    omit class ConsoleRunner {
    }
}

namespace Doctrine\Migrations\Tools\Console\Command {
    /**
     * CLI commands extend Symfony Console Command (`extern` cannot be extended).
     */
    // @overlay-against: class DoctrineCommand extends \Symfony\Component\Console\Command\Command
    omit class DoctrineCommand {
    }

    // @overlay-against: class CurrentCommand extends \Doctrine\Migrations\Tools\Console\Command\DoctrineCommand
