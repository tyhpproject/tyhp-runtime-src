<?tyhp

function test_events_migrating(): string
{
    return \Doctrine\Migrations\Events::onMigrationsMigrating;
}

function test_configuration_transactional(): bool
{
    $c = new \Doctrine\Migrations\Configuration\Configuration();
    $c->setTransactional(true);
    return $c->isTransactional();
}

function test_configuration_directories(\Doctrine\Migrations\Configuration\Configuration $c): array<string, string>
{
    $c->addMigrationsDirectory('App\\Migrations', '/app/migrations');
    return $c->getMigrationDirectories();
}

function test_from_connection(
    \Doctrine\Migrations\Configuration\Migration\ConfigurationLoader $configurationLoader,
    \Doctrine\Migrations\Configuration\Connection\ConnectionLoader $connectionLoader,
): \Doctrine\Migrations\DependencyFactory
{
    return \Doctrine\Migrations\DependencyFactory::fromConnection($configurationLoader, $connectionLoader);
}

function test_existing_connection(\Doctrine\DBAL\Connection $connection): \Doctrine\Migrations\Configuration\Connection\ExistingConnection
{
    return new \Doctrine\Migrations\Configuration\Connection\ExistingConnection($connection);
}

function test_migration_is_transactional(\Doctrine\Migrations\AbstractMigration $migration): bool
{
    return $migration->isTransactional();
}
