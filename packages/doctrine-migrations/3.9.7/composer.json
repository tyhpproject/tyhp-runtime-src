{
  "name": "tyhpdef/doctrine-migrations",
  "description": "Tyhp type definitions for the Composer package doctrine/migrations (3.9.7).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "3.9.7.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/doctrine-dbal": "@dev",
        "tyhpdef/doctrine-event-manager": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/psr-cache": "@dev",
        "tyhpdef/php-ext-mysqli": "@dev",
        "tyhpdef/php-ext-pdo": "@dev",
        "tyhpdef/php-ext-pgsql": "@dev",
        "tyhpdef/php-ext-sqlite3": "@dev",
        "tyhpdef/php-ext-bcmath": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "doctrine/migrations": "3.9.7"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/doctrine-dbal": "@dev",
    "tyhpdef/doctrine-event-manager": "@dev",
    "tyhpdef/psr-log": "@dev",
    "tyhpdef/psr-cache": "@dev",
    "tyhpdef/php-ext-mysqli": "@dev",
    "tyhpdef/php-ext-pdo": "@dev",
    "tyhpdef/php-ext-pgsql": "@dev",
    "tyhpdef/php-ext-sqlite3": "@dev",
    "tyhpdef/php-ext-bcmath": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../doctrine-dbal/4.4.4"
    },
    {
      "type": "path",
      "url": "../../doctrine-event-manager/2.1.1"
    },
    {
      "type": "path",
      "url": "../../psr-log/3.0.2"
    },
    {
      "type": "path",
      "url": "../../psr-cache/3.0.0"
    },
    {
      "type": "path",
      "url": "../../php-ext-mysqli"
    },
    {
      "type": "path",
      "url": "../../php-ext-pdo"
    },
    {
      "type": "path",
      "url": "../../php-ext-pgsql"
    },
    {
      "type": "path",
      "url": "../../php-ext-sqlite3"
    },
    {
      "type": "path",
      "url": "../../php-ext-bcmath"
    }
  ]
}
