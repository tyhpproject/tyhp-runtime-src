<?tyhp

function test_has_media(\Spatie\MediaLibrary\HasMedia $model): bool
{
    return $model->hasMedia('avatars');
}

function test_add_media(\Spatie\MediaLibrary\HasMedia $model): \Spatie\MediaLibrary\MediaCollections\FileAdder
{
    return $model->addMedia('/tmp/photo.jpg');
}

function test_media_file_name(\Spatie\MediaLibrary\MediaCollections\Models\Media $media): string
{
    return $media->file_name;
}
