{
    "name": "tyhpdef/spatie-laravel-medialibrary",
    "description": "Tyhp type definitions for the Composer package spatie/laravel-medialibrary (11.23.8).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "11.23.8.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": "8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/spatie-image": "@dev",
                "tyhpdef/spatie-laravel-package-tools": "@dev",
                "tyhpdef/maennchen-zipstream-php": "@dev",
                "tyhpdef/psr-http-message": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "spatie/laravel-medialibrary": "11.23.8"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/spatie-image": "@dev",
        "tyhpdef/spatie-laravel-package-tools": "@dev",
        "tyhpdef/maennchen-zipstream-php": "@dev",
        "tyhpdef/psr-http-message": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../laravel-framework/13.32.0"
        },
        {
            "type": "path",
            "url": "../../spatie-image/3.9.6"
        },
        {
            "type": "path",
            "url": "../../spatie-laravel-package-tools/1.93.2"
        },
        {
            "type": "path",
            "url": "../../maennchen-zipstream-php/3.2.2"
        },
        {
            "type": "path",
            "url": "../../psr-http-message/2.0"
        }
    ]
}
