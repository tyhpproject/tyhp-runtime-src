        // @overlay-against: function getFirstMedia(string $collectionName, array|callable $filters): ?\Spatie\MediaLibrary\MediaCollections\Models\Media
        public function getFirstMedia(string $collectionName, MediaFilter $filters): ?\Spatie\MediaLibrary\MediaCollections\Models\Media;

        // @overlay-against: function getLastMedia(string $collectionName, array|callable $filters): ?\Spatie\MediaLibrary\MediaCollections\Models\Media
        public function getLastMedia(string $collectionName, MediaFilter $filters): ?\Spatie\MediaLibrary\MediaCollections\Models\Media;

        // @overlay-against: function getMedia(string $collectionName, array|callable $filters): \Illuminate\Support\Collection
        public function getMedia(string $collectionName = 'default', MediaFilter $filters = []): \Illuminate\Support\Collection;

        // @overlay-against: function updateMedia(array $newMediaArray, string $collectionName): \Illuminate\Support\Collection
        public function updateMedia(array<int, MediaUpdateRow> $newMediaArray, string $collectionName): \Illuminate\Support\Collection;
    }

    // @overlay-against: trait InteractsWithMedia
    partial trait InteractsWithMedia<TMedia extends \Spatie\MediaLibrary\MediaCollections\Models\Media> {
        // @overlay-against: function __sleep(): array
        public function __sleep(): array<int, string>;

        // @overlay-against: function addFromMediaLibraryRequest(?array $mediaLibraryRequestItems): \Spatie\MediaLibraryPro\PendingMediaLibraryRequestHandler
        omit function addFromMediaLibraryRequest();

        // @overlay-against: function addMediaFromBase64(string $base64data, array|string $allowedMimeTypes): \Spatie\MediaLibrary\MediaCollections\FileAdder
        public function addMediaFromBase64(string $base64data, array<int, string>|string ...$allowedMimeTypes): \Spatie\MediaLibrary\MediaCollections\FileAdder;

        // @overlay-against: function addMediaFromUrl(string $url, array|string $allowedMimeTypes): \Spatie\MediaLibrary\MediaCollections\FileAdder
        public function addMediaFromUrl(string $url, array<int, string>|string ...$allowedMimeTypes): \Spatie\MediaLibrary\MediaCollections\FileAdder;

        // @overlay-against: function clearMediaCollectionExcept(string $collectionName, array|\Illuminate\Support\Collection|\Spatie\MediaLibrary\MediaCollections\Models\Media $excludedMedia): \Spatie\MediaLibrary\HasMedia
        public function clearMediaCollectionExcept(string $collectionName = 'default', ExcludedMedia|\Spatie\MediaLibrary\MediaCollections\Models\Media $excludedMedia = []): \Spatie\MediaLibrary\HasMedia;

        // @overlay-against: function getFirstMedia(string $collectionName, mixed $filters): ?\Spatie\MediaLibrary\MediaCollections\Models\Media
        public function getFirstMedia(string $collectionName = 'default', MediaFilter $filters = []): ?\Spatie\MediaLibrary\MediaCollections\Models\Media;

        // @overlay-against: function getLastMedia(string $collectionName, mixed $filters): ?\Spatie\MediaLibrary\MediaCollections\Models\Media
        public function getLastMedia(string $collectionName = 'default', MediaFilter $filters = []): ?\Spatie\MediaLibrary\MediaCollections\Models\Media;

        // @overlay-against: function getMedia(string $collectionName, array|callable $filters): \Spatie\MediaLibrary\MediaCollections\Models\Collections\MediaCollection
        public function getMedia(string $collectionName = 'default', MediaFilter $filters = []): \Spatie\MediaLibrary\MediaCollections\Models\Collections\MediaCollection;

        // @overlay-against: function hasMedia(string $collectionName, array|callable $filters): bool
