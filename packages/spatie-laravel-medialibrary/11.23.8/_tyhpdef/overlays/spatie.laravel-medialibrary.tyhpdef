namespace Spatie\MediaLibrary {
    /**
     * Overlay: media kept by `clearMediaCollectionExcept()`.
     */
    type ExcludedMedia = array<int, \Spatie\MediaLibrary\MediaCollections\Models\Media>|\Illuminate\Support\Collection<int, \Spatie\MediaLibrary\MediaCollections\Models\Media>;

    /**
     * Overlay: a media filter is a custom-property map or a predicate on one media item.
     */
    type MediaFilter = array<string, mixed>|MediaFilterCallback;

    /**
     * Overlay: predicate passed to `getMedia()` / `hasMedia()`.
     */
    type MediaFilterCallback = callable(\Spatie\MediaLibrary\MediaCollections\Models\Media): bool;

    /**
     * Overlay: one row passed to `updateMedia()`. The model key name is dynamic.
     */
    type MediaUpdateRow = array<string, mixed>;

    // @overlay-against: interface HasMedia
    partial interface HasMedia {
        // @overlay-against: function addMultipleMediaFromRequest(array $keys): \Illuminate\Support\Collection
        public function addMultipleMediaFromRequest(array<int, string> $keys): \Illuminate\Support\Collection;

        // @overlay-against: function clearMediaCollectionExcept(string $collectionName, array|\Illuminate\Support\Collection $excludedMedia): \Spatie\MediaLibrary\HasMedia
