        // @overlay-against: function processUnattachedMedia(callable $callable): void
        public function processUnattachedMedia(callable(TMedia, \Spatie\MediaLibrary\MediaCollections\FileAdder): mixed $callable): void;

        // @overlay-against: function syncFromMediaLibraryRequest(?array $mediaLibraryRequestItems): \Spatie\MediaLibraryPro\PendingMediaLibraryRequestHandler
        omit function syncFromMediaLibraryRequest();

        // @overlay-against: function updateMedia(array $newMediaArray, string $collectionName): \Illuminate\Support\Collection
        public function updateMedia(array<int, MediaUpdateRow> $newMediaArray, string $collectionName = 'default'): \Illuminate\Support\Collection;
    }
}

