    // @overlay-against: class Media extends \Illuminate\Database\Eloquent\Model implements \Illuminate\Contracts\Mail\Attachable, \Illuminate\Contracts\Support\Htmlable, \Illuminate\Contracts\Support\Responsable, \Spatie\MediaLibrary\MediaCollections\Models\Concerns\CustomMediaProperties, \Spatie\MediaLibrary\MediaCollections\Models\Concerns\HasUuid, \Spatie\MediaLibrary\MediaCollections\Models\Concerns\IsSorted
