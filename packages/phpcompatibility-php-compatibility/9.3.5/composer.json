{
    "name": "tyhpdef/phpcompatibility-php-compatibility",
    "description": "Tyhp type definitions for the Composer package phpcompatibility/php-compatibility (9.3.5).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "9.3.5.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/squizlabs-php_codesniffer": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "phpcompatibility/php-compatibility": "9.3.5"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/squizlabs-php_codesniffer": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../squizlabs-php_codesniffer/3.13.6"
        }
    ]
}
