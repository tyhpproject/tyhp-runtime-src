<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * PHPCompatibility 9.3 still names PHPCS 2 globals; phpcs 4 is namespaced.
 * Bridge types map those names onto the path-linked phpcs 4 types. Do not modify phpcs.
 * PHPDoc `boolean` is the bool alias.
 */

type boolean = bool;

class PHP_CodeSniffer_File extends \PHP_CodeSniffer\Files\File {
}

interface PHP_CodeSniffer_Sniff extends \PHP_CodeSniffer\Sniffs\Sniff {
}

class PHP_CodeSniffer_Exception extends \PHP_CodeSniffer\Exceptions\RuntimeException {
}

class Generic_Sniffs_NamingConventions_CamelCapsFunctionNameSniff extends \PHP_CodeSniffer\Standards\Generic\Sniffs\NamingConventions\CamelCapsFunctionNameSniff {
}

namespace PHPCompatibility {
    /**
     * One function-call parameter: token span and raw text.
     * Indexes from getFunctionCallParameters() are 1-based.
     */
    type FunctionCallParameter = struct {
        int $start;
        int $end;
        string $raw;
    };

    /**
     * Overlay: PHPCS replacement values and function-call parameter records.
     */
    // @overlay-against: class Sniff implements \PHP_CodeSniffer_Sniff
    partial class Sniff {
        /**
         * @param array<int|string, string> $data
         */
        // @overlay-against: function addMessage(\PHP_CodeSniffer_File $phpcsFile, string $message, int $stackPtr, bool $isError, string $code, array $data): void
        public function addMessage(\PHP_CodeSniffer_File $phpcsFile, string $message, int $stackPtr, bool $isError, string $code = 'Found', array<int|string, string> $data = []): void;

        /**
         * @param array<int|string, mixed> $array
         * @return array<string, mixed>
         */
        // @overlay-against: function arrayKeysToLowercase(array $array): array
        public function arrayKeysToLowercase(array<int|string, mixed> $array): array<string, mixed>;

        /**
         * @return array<int, \PHPCompatibility\FunctionCallParameter>
         */
        // @overlay-against: function getFunctionCallParameters(\PHP_CodeSniffer_File $phpcsFile, int $stackPtr): array
        public function getFunctionCallParameters(\PHP_CodeSniffer_File $phpcsFile, int $stackPtr): array<int, \PHPCompatibility\FunctionCallParameter>;

        /**
         * @return \PHPCompatibility\FunctionCallParameter|false
         */
        // @overlay-against: function getFunctionCallParameter(\PHP_CodeSniffer_File $phpcsFile, int $stackPtr, int $paramOffset): array|false
        public function getFunctionCallParameter(\PHP_CodeSniffer_File $phpcsFile, int $stackPtr, int $paramOffset): \PHPCompatibility\FunctionCallParameter|false;

        /**
         * @param array<int|string, int>|int|null $validScopes
         */
        // @overlay-against: function tokenHasScope(\PHP_CodeSniffer_File $phpcsFile, int $stackPtr, array|int $validScopes): bool
        public function tokenHasScope(\PHP_CodeSniffer_File $phpcsFile, int $stackPtr, array<int|string, int>|int|null $validScopes = null): bool;
    }

    /**
     * Overlay: tokens this sniff listens for.
     */
    // @overlay-against: class AbstractFunctionCallParameterSniff extends \PHPCompatibility\Sniff
    partial class AbstractFunctionCallParameterSniff {
        /**
         * @return array<int|string, int>
         */
        // @overlay-against: function register(): array
        public function register(): array<int|string, int>;
    }
}

