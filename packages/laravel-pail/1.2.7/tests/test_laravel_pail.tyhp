<?tyhp

function test_pail_file(): \Laravel\Pail\File
{
    return new \Laravel\Pail\File('/tmp/pail.pail');
}

function test_pail_file_string(): string
{
    return (string) (new \Laravel\Pail\File('/tmp/pail.pail'));
}

function test_pail_file_exists(): bool
{
    return (new \Laravel\Pail\File('/tmp/pail.pail'))->exists();
}

function test_pail_files(): \Laravel\Pail\Files
{
    return new \Laravel\Pail\Files('/tmp');
}

function test_pail_options_timeout(): int
{
    return (new \Laravel\Pail\Options(30, null, 'info', null, null))->timeout();
}

function test_pail_origin_console(): \Laravel\Pail\ValueObjects\Origin\Console
{
    return new \Laravel\Pail\ValueObjects\Origin\Console('pail');
}

function test_pail_origin_http(): \Laravel\Pail\ValueObjects\Origin\Http
{
    return new \Laravel\Pail\ValueObjects\Origin\Http('GET', '/logs', null, null);
}

function test_pail_origin_queue(): \Laravel\Pail\ValueObjects\Origin\Queue
{
    return new \Laravel\Pail\ValueObjects\Origin\Queue('default', 'App\\Jobs\\Example', null);
}

function test_pail_message_from_json(): \Laravel\Pail\ValueObjects\MessageLogged
{
    return \Laravel\Pail\ValueObjects\MessageLogged::fromJson('{}');
}

function test_pail_logger_factory(): \Laravel\Pail\LoggerFactory
{
    return new \Laravel\Pail\LoggerFactory(new \Laravel\Pail\File('/tmp/pail.pail'));
}

function test_pail_command(): \Laravel\Pail\Console\Commands\PailCommand
{
    return new \Laravel\Pail\Console\Commands\PailCommand();
}

function test_pail_provider(): \Laravel\Pail\PailServiceProvider
{
    return new \Laravel\Pail\PailServiceProvider(new \Illuminate\Foundation\Application());
}

function test_pail_pcntl_guard(): void
{
    \Laravel\Pail\Guards\EnsurePcntlIsAvailable::check();
}
