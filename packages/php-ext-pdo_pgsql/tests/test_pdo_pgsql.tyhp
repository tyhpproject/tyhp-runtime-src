<?tyhp

function test_pdo_pgsql_driver_api(PDO $pdo): int
{
    return $pdo->pgsqlGetPid();
}

// `Pdo\Pgsql` (PHP 8.4+ named PDO driver subclass) is only in scope when
// compiling for `output.phpVersion` >= 8.4 — see tyhp-php8.4.json.
declare(php=">=8.4") {
    function test_pdo_pgsql_driver_class(\Pdo\Pgsql $conn): int
    {
        return $conn->getPid() + \Pdo\Pgsql::TRANSACTION_IDLE;
    }
}
