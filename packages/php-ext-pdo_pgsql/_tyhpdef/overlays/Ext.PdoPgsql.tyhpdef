/**
 * PDO::pgsqlGetNotify() / Pdo\Pgsql::getNotify() with FETCH_ASSOC.
 * `payload` is present when the notification carries a payload.
 */
type PdoPgsqlNotify = struct {
    string $message;
    int $pid;
    ?string $payload;
};

