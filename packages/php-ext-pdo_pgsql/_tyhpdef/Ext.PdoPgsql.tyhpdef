<?tyhpdef
/**
 * Hand-written Layer 1 for pdo_pgsql.
 * Managed PHP does not provision `pdo_pgsql` (TYHP7511); signatures follow
 * PHP 8.2–8.5 docs. PHP 8.4+ `Pdo\Pgsql` is gated. PDO driver methods and
 * `PGSQL_*` constants live in `_tyhpdef/overlays/Ext.PdoPgsql.tyhpdef`.
 */
namespace Pdo {
    /**
     * PDO subclass for the pgsql driver (PHP 8.4+).
     *
     * @link https://www.php.net/manual/en/class.pdo-pgsql.php
     */
    #[\Tyhp\Php(">=8.4")]
    class Pgsql extends \PDO {
        public const int ATTR_DISABLE_PREPARES;
        public const int ATTR_RESULT_MEMORY_SIZE;
        public const int TRANSACTION_IDLE;
        public const int TRANSACTION_ACTIVE;
        public const int TRANSACTION_INTRANS;
        public const int TRANSACTION_INERROR;
        public const int TRANSACTION_UNKNOWN;
        public function copyFromArray(string $tableName, array $rows, string $separator = "\t", string $nullAs = "\\\\N", ?array $fields = null): bool;
        public function copyFromFile(string $tableName, string $filename, string $separator = "\t", string $nullAs = "\\\\N", ?array $fields = null): bool;
        public function copyToArray(string $tableName, string $separator = "\t", string $nullAs = "\\\\N", ?array $fields = null): array|false;
        public function copyToFile(string $tableName, string $filename, string $separator = "\t", string $nullAs = "\\\\N", ?array $fields = null): bool;
        public function getNotify(int $fetchMode = \PDO::FETCH_DEFAULT, int $timeoutMilliseconds = 0): array|false;
        public function getPid(): int;
        public function lobCreate(): string|false;
        public function lobOpen(string $oid, string $mode = "rb");
        public function lobUnlink(string $oid): bool;
        #[\Tyhp\Php(">=8.5")]
        public function setNoticeCallback(?callable $callback): bool;
    }
}
