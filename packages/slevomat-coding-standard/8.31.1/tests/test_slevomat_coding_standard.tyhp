<?tyhp

function test_slevomat_normalize_integer(): int
{
    return \SlevomatCodingStandard\Helpers\SniffSettingsHelper::normalizeInteger('4');
}

function test_slevomat_trailing_comma_register(): array<int, int|string>
{
    $sniff = new \SlevomatCodingStandard\Sniffs\Arrays\TrailingArrayCommaSniff();
    return $sniff->register();
}

function test_slevomat_normalize_array(): array<int, string>
{
    array<int, string> $settings = [];
    $settings[] = ' a ';
    $settings[] = 'b';
    return \SlevomatCodingStandard\Helpers\SniffSettingsHelper::normalizeArray($settings);
}

function test_slevomat_array_token_codes(): array<int, int>
{
    return \SlevomatCodingStandard\Helpers\TokenHelper::ARRAY_TOKEN_CODES;
}
