<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Annotation value is template T; token-code lists are int lists from the PHP source.
 * Fixed array returns are structs. The sniff cache returns the closure result.
 */

namespace SlevomatCodingStandard\Helpers {
    /**
     * Overlay: `ArrayHelper::openClosePointers()` `[opener, closer]` pair.
     */
    type ArrayOpenClosePointers = struct {
        int 0 as $opener;
        int 1 as $closer;
    };

    /**
     * Overlay: `NamespaceHelper::parseNamespaceWithAlias()` `namespace` and `alias` keys.
     */
    type NamespaceWithAlias = struct {
        string $namespace;
        string $alias;
    };

    /**
     * Overlay: PHPDoc `@return T` on getValue().
     */
    // @overlay-against: class Annotation
    partial class Annotation {
        /**
         * @return T
         */
        // @overlay-against: function getValue(): \PHPStan\PhpDocParser\Ast\PhpDoc\PhpDocTagValueNode
        public function getValue(): T;
    }

    /**
     * Overlay: static-analysis doc prefixes are `psalm` and `phpstan`.
     */
    // @overlay-against: class AnnotationHelper
    partial class AnnotationHelper {
        // @overlay-against: const array STATIC_ANALYSIS_PREFIXES
        public const array<int, 'psalm'|'phpstan'> STATIC_ANALYSIS_PREFIXES;
    }

    /**
     * Overlay: opener and closer token pointers.
     */
    // @overlay-against: class ArrayHelper
    partial class ArrayHelper {
        // @overlay-against: function openClosePointers(array $token): array
        public static function openClosePointers(array<string, array<int, int|string>|int|string> $token): ArrayOpenClosePointers;
    }

    /**
     * Overlay: special-cased global function names, compared as source text.
     */
    // @overlay-against: class FunctionHelper
    partial class FunctionHelper {
        // @overlay-against: const array SPECIAL_FUNCTIONS
        public const array<int, string> SPECIAL_FUNCTIONS;
    }

    /**
     * Overlay: parsed `Namespace` or `Namespace as Alias` setting.
     */
    // @overlay-against: class NamespaceHelper
    partial class NamespaceHelper {
        // @overlay-against: function parseNamespaceWithAlias(string $namespaceOrAlias): array
        public static function parseNamespaceWithAlias(string $namespaceOrAlias): NamespaceWithAlias;
    }

    /**
     * Overlay: cached value is the zero-argument closure return.
     */
    // @overlay-against: class SniffLocalCache
    partial class SniffLocalCache {
        // @overlay-against: function getAndSetIfNotCached(\PHP_CodeSniffer\Files\File $phpcsFile, string $key, \Closure $lazyValue): mixed
        public static function getAndSetIfNotCached<T>(\PHP_CodeSniffer\Files\File $phpcsFile, string $key, \Closure<callable(): T> $lazyValue): T;
    }

    /**
     * Overlay: token-code bags are lists of tokenizer ints.
     */
    // @overlay-against: class TokenHelper
    partial class TokenHelper {
        // @overlay-against: const array NAME_TOKEN_CODES
        public const array<int, int> NAME_TOKEN_CODES;

        // @overlay-against: const array CLASS_KEYWORD_CODES
        public const array<int, int> CLASS_KEYWORD_CODES;

        // @overlay-against: const array ONLY_TYPE_HINT_TOKEN_CODES
        public const array<int, int> ONLY_TYPE_HINT_TOKEN_CODES;

        // @overlay-against: const array TYPE_HINT_TOKEN_CODES
        public const array<int, int> TYPE_HINT_TOKEN_CODES;

        // @overlay-against: const array MODIFIERS_TOKEN_CODES
        public const array<int, int> MODIFIERS_TOKEN_CODES;

        // @overlay-against: const mixed PROPERTY_MODIFIERS_TOKEN_CODES
        public const array<int, int> PROPERTY_MODIFIERS_TOKEN_CODES;

        // @overlay-against: const array ARRAY_TOKEN_CODES
        public const array<int, int> ARRAY_TOKEN_CODES;

        // @overlay-against: const array CLASS_TYPE_TOKEN_CODES
        public const array<int, int> CLASS_TYPE_TOKEN_CODES;

        // @overlay-against: const array CLASS_TYPE_WITH_ANONYMOUS_CLASS_TOKEN_CODES
        public const array<int, int> CLASS_TYPE_WITH_ANONYMOUS_CLASS_TOKEN_CODES;

        // @overlay-against: const array ANNOTATION_TOKEN_CODES
        public const array<int, int> ANNOTATION_TOKEN_CODES;

        // @overlay-against: const array INLINE_COMMENT_TOKEN_CODES
        public const array<int, int> INLINE_COMMENT_TOKEN_CODES;

        // @overlay-against: const array INEFFECTIVE_TOKEN_CODES
        public const array<int, int> INEFFECTIVE_TOKEN_CODES;

        // @overlay-against: const array EARLY_EXIT_TOKEN_CODES
        public const array<int, int> EARLY_EXIT_TOKEN_CODES;

        // @overlay-against: const array FUNCTION_TOKEN_CODES
        public const array<int, int> FUNCTION_TOKEN_CODES;
    }

    /**
     * Overlay: type tags alias `ReferencedName` string constants.
     */
    // @overlay-against: class UseStatement
    partial class UseStatement {
        // @overlay-against: const mixed TYPE_CLASS
        public const string TYPE_CLASS ?? \SlevomatCodingStandard\Helpers\ReferencedName::TYPE_CLASS;

        // @overlay-against: const mixed TYPE_CONSTANT
        public const string TYPE_CONSTANT ?? \SlevomatCodingStandard\Helpers\ReferencedName::TYPE_CONSTANT;

        // @overlay-against: const mixed TYPE_FUNCTION
        public const string TYPE_FUNCTION ?? \SlevomatCodingStandard\Helpers\ReferencedName::TYPE_FUNCTION;
    }
}
