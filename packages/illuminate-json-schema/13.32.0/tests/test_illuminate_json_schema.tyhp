<?tyhp

function test_json_schema_string(): \Illuminate\JsonSchema\Types\StringType
{
    return \Illuminate\JsonSchema\JsonSchema::string();
}

function test_json_schema_object(): \Illuminate\JsonSchema\Types\ObjectType
{
    return \Illuminate\JsonSchema\JsonSchema::object([
        'name' => \Illuminate\JsonSchema\JsonSchema::string(),
        'age' => \Illuminate\JsonSchema\JsonSchema::integer(),
    ]);
}

function test_json_schema_from_array(): \Illuminate\JsonSchema\Types\Type
{
    return \Illuminate\JsonSchema\JsonSchema::fromArray(['type' => 'string']);
}

function test_json_schema_to_array(\Illuminate\JsonSchema\Types\Type $type): array<string, mixed>
{
    return $type->toArray();
}

function test_json_schema_factory(): \Illuminate\JsonSchema\Types\BooleanType
{
    return (new \Illuminate\JsonSchema\JsonSchemaTypeFactory())->boolean();
}
