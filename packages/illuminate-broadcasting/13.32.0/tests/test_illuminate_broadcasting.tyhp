<?tyhp

function test_channel(): \Illuminate\Broadcasting\Channel
{
    return new \Illuminate\Broadcasting\Channel('orders');
}

function test_private_channel(): \Illuminate\Broadcasting\PrivateChannel
{
    return new \Illuminate\Broadcasting\PrivateChannel('orders.1');
}

function test_presence_channel(): \Illuminate\Broadcasting\PresenceChannel
{
    return new \Illuminate\Broadcasting\PresenceChannel('chat');
}

function test_encrypted_private_channel(): \Illuminate\Broadcasting\EncryptedPrivateChannel
{
    return new \Illuminate\Broadcasting\EncryptedPrivateChannel('secret');
}

function test_anonymous_event(): \Illuminate\Broadcasting\AnonymousEvent
{
    return new \Illuminate\Broadcasting\AnonymousEvent('orders');
}
