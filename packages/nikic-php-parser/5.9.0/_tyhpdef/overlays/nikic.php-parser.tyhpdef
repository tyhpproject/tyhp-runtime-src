<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `@internal` TokenPolyfill / TokenEmulator omitted from Layer 1; public Token
 * and lexer emulators implement them. Layer 1 also emits unqualified
 * `Node\…` / `Stmt\…` names from PHPDoc — overlay those to `PhpParser\…`.
 */

namespace PhpParser\Internal {
    /**
     * PHP 8+ token polyfill used by `PhpParser\Token`. Layer 1 omits `@internal`.
     * Does not extend `\PhpToken` (that builtin is not in tyhpdef/php; extern cannot be extended).
     */
    class TokenPolyfill {
        public int $id;
        public string $text;
        public int $line;
        public int $pos;

        public function __construct(int $id, string $text, int $line = -1, int $pos = -1): void;
    }
}

namespace PhpParser\Lexer\TokenEmulator {
    /**
     * One `preprocessCode()` patch: `[offset, operation, replacement]`.
     */
    type CodePatch = struct {
        int 0 as $offset;
        string 1 as $kind;
        string 2 as $text;
    };

    /**
     * Internal emulator base. Layer 1 omits `@internal`.
     */
    abstract class TokenEmulator {
        public abstract function getPhpVersion(): \PhpParser\PhpVersion;

        public abstract function isEmulationNeeded(string $code): bool;

        /**
         * @param array<int, \PhpParser\Token> $tokens
         * @return array<int, \PhpParser\Token>
         */
        public abstract function emulate(string $code, array<int, \PhpParser\Token> $tokens): array<int, \PhpParser\Token>;

        /**
         * @param array<int, \PhpParser\Token> $tokens
         * @return array<int, \PhpParser\Token>
         */
        public abstract function reverseEmulate(string $code, array<int, \PhpParser\Token> $tokens): array<int, \PhpParser\Token>;

        /**
         * @param array<int, \PhpParser\Lexer\TokenEmulator\CodePatch> $patches
         */
        public function preprocessCode(string $code, array<int, \PhpParser\Lexer\TokenEmulator\CodePatch> &$patches): string;
    }
}

namespace PhpParser {
    /**
     * Overlay: parse() returns `PhpParser\Node\Stmt` nodes (L1 used `\Node\Stmt`).
     */
    // @overlay-against: interface Parser
    partial interface Parser {
        /**
         * @return array<int, \PhpParser\Node\Stmt>|null
         */
        // @overlay-against: function parse(string $code, ?\PhpParser\ErrorHandler $errorHandler): array|null
        public function parse(string $code, ?\PhpParser\ErrorHandler $errorHandler = null): array<int, \PhpParser\Node\Stmt>|null;
    }

    /**
     * Overlay: same parse() return as the interface.
     */
    // @overlay-against: class ParserAbstract implements \PhpParser\Parser
    partial class ParserAbstract {
        /**
         * @return array<int, \PhpParser\Node\Stmt>|null
         */
        // @overlay-against: function parse(string $code, ?\PhpParser\ErrorHandler $errorHandler): array|null
        public function parse(string $code, ?\PhpParser\ErrorHandler $errorHandler = null): array<int, \PhpParser\Node\Stmt>|null;
    }
}

