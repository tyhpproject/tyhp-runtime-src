declare(php="<8.5") {
    /**
    * Set miscellaneous runtime FTP options
    *
    * This function controls various runtime options for the specified FTP connection.
    *
    * @param $ftp An FTP\Connection instance.
    * @param $option Currently, the following options are supported: **Supported runtime FTP options** **`FTP_TIMEOUT_SEC`** Changes the timeout in seconds used for all network related functions. `$value` must be an integer that is greater than 0. The default timeout is 90 seconds. **`FTP_AUTOSEEK`** When enabled, GET or PUT requests with a `$resumepos` or `$startpos` parameter will first seek to the requested position within the file. This is enabled by default. **`FTP_USEPASVADDRESS`** When disabled, PHP will ignore the IP address returned by the FTP server in response to the PASV command and instead use the IP address that was supplied in the ftp_connect(). `$value` must be a boolean.
    * @param $value This parameter depends on which `$option` is chosen to be altered.
    * @return Always returns **`true`**.
    * @throws A ValueError is thrown if the `$option` is not supported. A TypeError is thrown if the passed `$value` doesn't match the expected type for the given `$option`.
    *
    * @link https://www.php.net/manual/en/function.ftp-set-option.php
    *
    * @generated from PHP v8.4.23, EXT: ftp v8.4.23
    */
    function ftp_set_option(\FTP\Connection $ftp, int $option, mixed $value): bool;
}
