<?tyhp

function test_ftp_connect_signature(): \FTP\Connection|false
{
    return ftp_connect('127.0.0.1', 21, 1);
}

// `ftp_set_option()` narrows its return type from `bool` to `true` as of PHP 8.5 — only
// in scope when compiling for `output.phpVersion` >= 8.5 — see tyhp-php8.5.json.
declare(php=">=8.5") {
    function test_ftp_set_option_signature(\FTP\Connection $ftp): true
    {
        return ftp_set_option($ftp, FTP_TIMEOUT_SEC, 120);
    }
}
