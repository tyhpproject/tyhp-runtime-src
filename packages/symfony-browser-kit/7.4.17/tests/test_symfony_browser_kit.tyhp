<?tyhp

function test_browser_request(\Symfony\Component\BrowserKit\AbstractBrowser $browser): \Symfony\Component\DomCrawler\Crawler
{
    return $browser->request('GET', '/');
}

function test_browser_click_link(\Symfony\Component\BrowserKit\AbstractBrowser $browser): \Symfony\Component\DomCrawler\Crawler
{
    return $browser->clickLink('Home');
}
