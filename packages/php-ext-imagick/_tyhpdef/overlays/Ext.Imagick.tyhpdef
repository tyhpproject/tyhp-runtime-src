<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Iterator generics, format/histogram lists, pixel-iterator rows, and the
 * fixed version, quantum, size, resolution, and font-metric shapes.
 * Declaration order: TYHPDEF_ORDERING.md.
 */

/**
 * Overlay: `boundingBox` inside `Imagick::queryFontMetrics()`.
 */
type ImagickFontBoundingBox = struct {
    float $x1;
    float $y1;
    float $x2;
    float $y2;
};

/**
 * Overlay: `Imagick::queryFontMetrics()` metric record.
 */
type ImagickFontMetrics = struct {
    float $characterWidth;
    float $characterHeight;
    float $ascender;
    float $descender;
    float $textWidth;
    float $textHeight;
    float $maxHorizontalAdvance;
    ImagickFontBoundingBox $boundingBox;
    float $originX;
    float $originY;
};

/**
 * Overlay: `ImagickPixel::getColor(1)` normalized RGBA in `0..1`.
 */
type ImagickPixelColorFloat = struct {
    float $r;
    float $g;
    float $b;
    ?float $a;
};

/**
 * Overlay: `ImagickPixel::getColor(0)` and `getColor(2)` quantum channel ints.
 */
type ImagickPixelColorInt = struct {
    int $r;
    int $g;
    int $b;
    ?int $a;
};

/**
 * Overlay: `Imagick::getQuantumDepth()` members `quantumDepthLong` and `quantumDepthString`.
 */
type ImagickQuantumDepth = struct {
    int $quantumDepthLong;
    string $quantumDepthString;
};

/**
 * Overlay: `Imagick::getQuantumRange()` members `quantumRangeLong` and `quantumRangeString`.
 */
type ImagickQuantumRange = struct {
    int $quantumRangeLong;
    string $quantumRangeString;
};

/**
 * Overlay: `Imagick::getImageResolution()` keys `x` and `y`.
 */
type ImagickResolution = struct {
    float $x;
    float $y;
};

/**
 * Overlay: `Imagick::getSize()` keys `columns` and `rows`.
 */
type ImagickSize = struct {
    int $columns;
    int $rows;
};

/**
 * Overlay: `Imagick::getVersion()` keys `versionNumber` and `versionString`.
 */
type ImagickVersion = struct {
    int $versionNumber;
    string $versionString;
};

// @overlay-against: class Imagick implements \Stringable, \Iterator, \Traversable, \Countable
partial class Imagick implements \Stringable, \Iterator<int, Imagick>, \Traversable<int, Imagick>, \Countable;

// @overlay-against: class Imagick implements \Stringable, \Iterator, \Traversable, \Countable
partial class Imagick {
    // @overlay-against: function getQuantumDepth(): array
    static public function getQuantumDepth(): ImagickQuantumDepth;

    // @overlay-against: function getQuantumRange(): array
    static public function getQuantumRange(): ImagickQuantumRange;

    // @overlay-against: function getVersion(): array
    static public function getVersion(): ImagickVersion;

    // @overlay-against: function queryFonts(string $pattern): array
    static public function queryFonts(string $pattern = '*'): array<int, string>;

    // @overlay-against: function queryFormats(string $pattern): array
    static public function queryFormats(string $pattern = '*'): array<int, string>;

    // @overlay-against: function getImageHistogram(): array
    public function getImageHistogram(): array<int, ImagickPixel>;

    // @overlay-against: function getImageResolution(): array
    public function getImageResolution(): ImagickResolution;

    // @overlay-against: function getSize(): array
    public function getSize(): ImagickSize;

    // @overlay-against: function queryFontMetrics(\ImagickDraw $settings, string $text, ?bool $multiline): array
    public function queryFontMetrics(\ImagickDraw $settings, string $text, ?bool $multiline = null): ImagickFontMetrics;

    // @overlay-against: function writeImagesFile(mixed $filehandle, ?string $format): bool
    public function writeImagesFile(resource $filehandle, ?string $format = null): bool;
}

// @overlay-against: class ImagickPixel
partial class ImagickPixel {
    // @overlay-against: function getColor(int $normalized): array
    public function getColor(0 $normalized = 0): ImagickPixelColorInt;

    // @overlay-against: function getColor(int $normalized): array
    public function getColor(1 $normalized): ImagickPixelColorFloat;

    // @overlay-against: function getColor(int $normalized): array
    public function getColor(2 $normalized): ImagickPixelColorInt;

    // @overlay-against: function getColor(int $normalized): array
    public function getColor(int $normalized): ImagickPixelColorInt|ImagickPixelColorFloat;
}

// @overlay-against: class ImagickPixelIterator implements \Iterator, \Traversable
partial class ImagickPixelIterator implements \Iterator<int, array<int, ImagickPixel>>, \Traversable<int, array<int, ImagickPixel>>;

// @overlay-against: class ImagickPixelIterator implements \Iterator, \Traversable
partial class ImagickPixelIterator {
    // @overlay-against: function current(): ?array
    public function current(): ?array<int, ImagickPixel>;

    // @overlay-against: function getCurrentIteratorRow(): ?array
    public function getCurrentIteratorRow(): ?array<int, ImagickPixel>;

    // @overlay-against: function getNextIteratorRow(): ?array
    public function getNextIteratorRow(): ?array<int, ImagickPixel>;

    // @overlay-against: function getPreviousIteratorRow(): array
    public function getPreviousIteratorRow(): array<int, ImagickPixel>;
}
