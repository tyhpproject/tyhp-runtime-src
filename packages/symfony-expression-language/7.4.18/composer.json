{
    "name": "tyhpdef/symfony-expression-language",
    "description": "Tyhp type definitions for the Composer package symfony/expression-language (7.4.18).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.4.18.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/symfony-cache": "@dev",
                "tyhpdef/symfony-cache-contracts": "@dev",
                "tyhpdef/psr-cache": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/psr-clock": "@dev",
                "tyhpdef/php-ext-memcached": "@dev",
                "tyhpdef/psr-container": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/expression-language": "7.4.18"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/symfony-cache": "@dev",
        "tyhpdef/symfony-cache-contracts": "@dev",
        "tyhpdef/psr-cache": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/psr-clock": "@dev",
        "tyhpdef/php-ext-memcached": "@dev",
        "tyhpdef/psr-container": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../symfony-cache/7.4.19"
        },
        {
            "type": "path",
            "url": "../../symfony-service-contracts/3.7.3"
        },
        {
            "type": "path",
            "url": "../../symfony-cache-contracts/3.7.1"
        },
        {
            "type": "path",
            "url": "../../psr-cache/3.0.0"
        },
        {
            "type": "path",
            "url": "../../psr-log/3.0.2"
        },
        {
            "type": "path",
            "url": "../../psr-clock/1.0.0"
        },
        {
            "type": "path",
            "url": "../../php-ext-memcached"
        },
        {
            "type": "path",
            "url": "../../psr-container/2.0.2"
        }
    ]
}
