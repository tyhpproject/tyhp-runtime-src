<?tyhp

function test_expression_language_evaluate(): mixed
{
    $el = new \Symfony\Component\ExpressionLanguage\ExpressionLanguage();
    return $el->evaluate('1 + 1');
}

function test_expression_language_compile(): string
{
    $el = new \Symfony\Component\ExpressionLanguage\ExpressionLanguage();
    return $el->compile('1 + 1');
}
