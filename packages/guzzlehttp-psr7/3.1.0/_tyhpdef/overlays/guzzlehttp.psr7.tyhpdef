<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Layer 1 omits `@internal` `NonSerializableStreamTrait`; public stream types use it.
 */

namespace GuzzleHttp\Psr7 {
    /**
     * `Message::parseMessage()` keys. `start-line` is not a Tyhp identifier.
     */
    type ParsedMessage = struct {
        string $body;
        array<string, array<int, string>> $headers;
        string 'start-line' as $startLine;
    };

    /**
     * Overlay: parsed header parameters are a list of string-or-int keyed maps.
     */
    // @overlay-against: class Header
    partial class Header {
        /**
         * @param string|array<int, string> $header
         * @return array<int, array<int|string, string>>
         */
        // @overlay-against: function parse(string|array $header): array
        public static function parse(string|array<int, string> $header): array<int, array<int|string, string>>;
    }

    /**
     * Overlay: parsed messages and header maps.
     */
    // @overlay-against: class Message
    partial class Message {
        /**
         * @return \GuzzleHttp\Psr7\ParsedMessage
         */
        // @overlay-against: function parseMessage(string $message): array
        public static function parseMessage(string $message): \GuzzleHttp\Psr7\ParsedMessage;

        /**
         * @param array<string, array<int|string, string>> $headers Array of headers (each value an array).
         */
        // @overlay-against: function parseRequestUri(string $path, array $headers): string
        public static function parseRequestUri(string $path, array<string, array<int|string, string>> $headers): string;
    }

    /**
     * Internal non-serialize trait used by public stream types.
     */
    trait NonSerializableStreamTrait {
        /**
         * @return array<int|string, mixed>
         */
        public function __serialize(): array<int|string, mixed>;

        /**
         * @param array<int|string, mixed> $data
         */
        public function __unserialize(array<int|string, mixed> $data): void;
    }

    /**
     * Overlay: query maps are string-keyed. Duplicate keys make a value an array, and scalars other than string are accepted, so values stay mixed.
     */
    // @overlay-against: class Query
    partial class Query {
        /**
         * @param array<string, mixed> $params
         */
        // @overlay-against: function build(array $params, int|false $encoding, bool $treatBoolsAsInts): string
        public static function build(array<string, mixed> $params, int|false $encoding, bool $treatBoolsAsInts = true): string;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function parse(string $str, int|bool $urlEncoding): array
        public static function parse(string $str, int|bool $urlEncoding = true): array<string, mixed>;
    }

    /**
     * Overlay: `streamFor` options are `size` and `metadata`.
     */
    // @overlay-against: class Utils
    partial class Utils {
        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function streamFor(resource|string|\Psr\Http\Message\StreamInterface|callable|\Iterator|\Stringable|null $resource, array $options): \Psr\Http\Message\StreamInterface
        public static function streamFor(resource|string|\Psr\Http\Message\StreamInterface|callable|\Iterator|\Stringable|null $resource = '', array<string, mixed> $options = []): \Psr\Http\Message\StreamInterface;
    }

    /**
     * Header maps are original-name to a list of string values.
     * `withHeader` accepts a string or a list of strings.
     */
    // @overlay-against: trait MessageTrait
    partial trait MessageTrait {
        // @overlay-against: function getHeader(string $name): array
        public function getHeader(string $name): array<int, string>;

        // @overlay-against: function getHeaders(): array
        public function getHeaders(): array<string, array<int, string>>;

        // @overlay-against: function withAddedHeader(string $name, mixed $value): \Psr\Http\Message\MessageInterface
        public function withAddedHeader(string $name, string|array<int, string> $value): \Psr\Http\Message\MessageInterface;

        // @overlay-against: function withHeader(string $name, mixed $value): \Psr\Http\Message\MessageInterface
        public function withHeader(string $name, string|array<int, string> $value): \Psr\Http\Message\MessageInterface;
    }
}
