{
  "name": "tyhpdef/nyholm-psr7-server",
  "description": "Tyhp type definitions for the Composer package nyholm/psr7-server (1.1.0).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "1.1.0.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-http-factory": "@dev",
        "tyhpdef/psr-http-message": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "nyholm/psr7-server": "1.1.0"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/psr-http-factory": "@dev",
    "tyhpdef/psr-http-message": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../psr-http-message/2.0"
    },
    {
      "type": "path",
      "url": "../../psr-http-factory/1.1.0"
    }
  ]
}
