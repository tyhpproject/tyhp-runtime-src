<?tyhp

function test_league_event_dispatcher(): \League\Event\EventDispatcher
{
    return new \League\Event\EventDispatcher();
}

function test_league_event_buffered(
    \Psr\EventDispatcher\EventDispatcherInterface $dispatcher
): \League\Event\BufferedEventDispatcher
{
    return new \League\Event\BufferedEventDispatcher($dispatcher);
}

function test_league_event_dispatch(\League\Event\EventDispatcher $dispatcher, object $event): object
{
    return $dispatcher->dispatch($event);
}
