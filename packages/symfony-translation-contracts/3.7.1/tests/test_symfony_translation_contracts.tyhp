<?tyhp

function test_symfony_translation_trans(\Symfony\Contracts\Translation\TranslatorInterface $translator): string
{
    return $translator->trans('hello.world', ['%name%' => 'Tyhp'], 'messages', 'en');
}

function test_symfony_translation_locale(\Symfony\Contracts\Translation\TranslatorInterface $translator): string
{
    return $translator->getLocale();
}

function test_symfony_translation_locale_aware(\Symfony\Contracts\Translation\LocaleAwareInterface $aware, string $locale): string
{
    $aware->setLocale($locale);
    return $aware->getLocale();
}

function test_symfony_translatable(\Symfony\Contracts\Translation\TranslatableInterface $message, \Symfony\Contracts\Translation\TranslatorInterface $translator): string
{
    return $message->trans($translator, 'en');
}
