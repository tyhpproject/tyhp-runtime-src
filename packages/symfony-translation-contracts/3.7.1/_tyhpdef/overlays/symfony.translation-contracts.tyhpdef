<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `trans()` `$parameters` is a string-keyed map (`strtr`); harvest left bare `array`.
 */

namespace Symfony\Contracts\Translation {
    /**
     * Parameters substituted into a message (`%name%` keys and similar).
     * Weak alias: replaces Layer 1 bare `array` (PHPDoc is only “array of parameters”).
     */
    type TranslationParameters = array<string, mixed>;

    /**
     * Overlay: harvest typed `$parameters` as `array`; encode as `array<string, mixed>`.
     */
    // @overlay-against: interface TranslatorInterface
    partial interface TranslatorInterface {
        /**
         * @param string $id The message id (may also be an object that can be cast to string).
         * @param \Symfony\Contracts\Translation\TranslationParameters $parameters An array of parameters for the message.
         * @param ?string $domain The domain for the message or null to use the default.
         * @param ?string $locale The locale or null to use the default.
         * @throws \InvalidArgumentException If the locale contains invalid characters
         */
        // @overlay-against: function trans(string $id, array $parameters, ?string $domain, ?string $locale): string
        public function trans(string $id, \Symfony\Contracts\Translation\TranslationParameters $parameters = [], ?string $domain = null, ?string $locale = null): string;
    }

    /**
     * Overlay: same `$parameters` encoding as the interface. Layer 1 already has `?string $id`.
     */
    // @overlay-against: trait TranslatorTrait
    partial trait TranslatorTrait {
        /**
         * @param ?string $id Message id; null or empty returns `''`.
         * @param \Symfony\Contracts\Translation\TranslationParameters $parameters An array of parameters for the message.
         */
        // @overlay-against: function trans(?string $id, array $parameters, ?string $domain, ?string $locale): string
        public function trans(?string $id, \Symfony\Contracts\Translation\TranslationParameters $parameters = [], ?string $domain = null, ?string $locale = null): string;
    }
}
