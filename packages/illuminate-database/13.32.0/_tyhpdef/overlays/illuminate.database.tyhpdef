<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 */

namespace Illuminate\Database {
    /**
     * One column's `generation` object from `Schema\Builder::getColumns()`.
     */
    type DatabaseColumnGeneration = struct {
        string $type;
        string|null $expression;
    };

    /**
     * One row from `Schema\Builder::getColumns()`.
     */
    type DatabaseColumnInfo = struct {
        string $name;
        string $type;
        string $type_name;
        string|null $collation;
        bool $nullable;
        mixed $default;
        bool $auto_increment;
        string|null $comment;
        DatabaseColumnGeneration|null $generation;
    };

    /**
     * One row from `Schema\Builder::getForeignKeys()`.
     */
    type DatabaseForeignKeyInfo = struct {
        string|null $name;
        array<int, string> $columns;
        string|null $foreign_schema;
        string $foreign_table;
        array<int, string> $foreign_columns;
        string|null $on_update;
        string|null $on_delete;
    };

    /**
     * One row from `Schema\Builder::getIndexes()`.
     */
    type DatabaseIndexInfo = struct {
        string $name;
        array<int, string> $columns;
        string $type;
        bool $unique;
        bool $primary;
    };

    /**
     * `Processor::processColumns()` generation object. `type` may be null.
     */
    type DatabaseProcessedColumnGeneration = struct {
        string|null $type;
        string|null $expression;
    };

    /**
     * One row from `Processor::processColumns()`.
     */
    type DatabaseProcessedColumnInfo = struct {
        string $name;
        string $type;
        string $type_name;
        string|null $collation;
        bool $nullable;
        mixed $default;
        bool $auto_increment;
        string|null $comment;
        DatabaseProcessedColumnGeneration|null $generation;
    };

    /**
     * One row from `Processor::processIndexes()`. `type` may be null.
     */
    type DatabaseProcessedIndexInfo = struct {
        string $name;
        array<int, string> $columns;
        string|null $type;
        bool $unique;
        bool $primary;
    };

    /**
     * One row from `Schema\Builder::getSchemas()`.
     */
    type DatabaseSchemaInfo = struct {
        string $name;
        string|null $path;
        bool $default;
    };

    /**
     * One row from `Schema\Builder::getTables()`.
     */
    type DatabaseTableInfo = struct {
        string $name;
        string|null $schema;
        string $schema_qualified_name;
        int|null $size;
        string|null $comment;
        string|null $collation;
        string|null $engine;
    };

    /**
     * One row from `Schema\Builder::getTypes()`.
     */
    type DatabaseTypeInfo = struct {
        string $name;
        string $schema;
        string $schema_qualified_name;
        string $type;
        string $category;
        bool $implicit;
    };

    /**
     * One row from `Schema\Builder::getViews()`.
     */
    type DatabaseViewInfo = struct {
        string $name;
        string|null $schema;
        string $schema_qualified_name;
        string $definition;
    };

    /**
     * One pretended query from `Connection::pretend()` / `getQueryLog()`.
     * Binding values are whatever the statement bound.
     */
    type QueryLogEntry = struct {
        string $query;
        array<int, mixed> $bindings;
        float|null $time;
    };

    /**
     * `Schema\Builder::parseSchemaAndTable()` pair: schema, then table.
     */
    type SchemaAndTable = struct {
        string|null 0 as $schema;
        string 1 as $table;
    };

    /**
     * Overlay: pretend/query-log rows are `QueryLogEntry` records.
     * The pretend callback receives this connection.
     */
    // @overlay-against: class Connection implements \Illuminate\Database\ConnectionInterface, \Illuminate\Database\DetectsConcurrencyErrors, \Illuminate\Database\DetectsLostConnections, \Illuminate\Database\Concerns\ManagesTransactions, \Illuminate\Support\InteractsWithTime, \Illuminate\Support\Traits\Macroable
    partial class Connection {
        // @overlay-against: function getQueryLog(): array
        public function getQueryLog(): array<int, QueryLogEntry>;
        // @overlay-against: function pretend(\Closure $callback): array
        public function pretend(\Closure<callable(\Illuminate\Database\Connection): mixed> $callback): array<int, QueryLogEntry>;
    }

    /**
     * Overlay: PHPDoc shapes, class-strings, and conditionals harvest left loose.
     */
    // @overlay-against: interface ConnectionInterface
    partial interface ConnectionInterface {
        // @overlay-against: function cursor(string $query, array $bindings, bool $useReadPdo, array $fetchUsing): \Generator
        public function cursor(string $query, array<int, mixed> $bindings = [], bool $useReadPdo = true, array<int, mixed> $fetchUsing = []): \Generator<int, \stdClass>;
        // @overlay-against: function pretend(\Closure $callback): array
        public function pretend(\Closure<callable(\Illuminate\Database\Connection): mixed> $callback): array<int, QueryLogEntry>;
        // @overlay-against: function raw(mixed $value): \Illuminate\Contracts\Database\Query\Expression
        public function raw(string|int|float $value): \Illuminate\Contracts\Database\Query\Expression;
        // @overlay-against: function unprepared(mixed $query): bool
        public function unprepared(string $query): bool;
    }
}

namespace Illuminate\Database\Console\Migrations {
    /**
     * `TableGuesser::guess()` pair: table name, then whether the migration creates it.
     */
    type MigrationTableGuess = struct {
        string 0 as $table;
        bool 1 as $create;
    };

    /**
     * Overlay: pattern lists are regex strings. `guess()` returns the table/create pair.
     */
    // @overlay-against: class TableGuesser
    partial class TableGuesser {
        // @overlay-against: const array CHANGE_PATTERNS ?? []
        public const array<int, string> CHANGE_PATTERNS ?? [];
        // @overlay-against: const array CREATE_PATTERNS ?? []
        public const array<int, string> CREATE_PATTERNS ?? [];
        // @overlay-against: function guess(string $migration): array
        public static function guess(string $migration): MigrationTableGuess;
    }
}

