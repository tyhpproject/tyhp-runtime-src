<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * `orchestra/sidekick` has no wrapper; `Illuminate\Console\Signals` is not on
 * the illuminate-* graph; AttributeParserTAttributes is harvest-only.
 * Do not inline those foreign namespaces.
 */

namespace Orchestra\Testbench {
    /**
     * Overlay: optional `\Orchestra\Testbench\Foundation\Config` is omitted
     * (extends Sidekick).
     */
    // @overlay-against: function container(?string $basePath, callable|null $resolvingCallback, array $options, ?\Orchestra\Testbench\Foundation\Config $config): \Orchestra\Testbench\Foundation\Application
    omit function container();

    // @overlay-against: function laravel_version_compare(string $version, ?string $operator): int|bool
    function laravel_version_compare(string $version, null $operator = null): int;
    // @overlay-against: function laravel_version_compare(string $version, ?string $operator): int|bool
    function laravel_version_compare(string $version, string $operator): bool;
    // @overlay-against: function laravel_version_compare(string $version, ?string $operator): int|bool
    function laravel_version_compare(string $version, ?string $operator = null): int|bool;

    // @overlay-against: function package_version_compare(string $package, string $version, ?string $operator): mixed
    function package_version_compare(string $package, string $version, null $operator = null): int;
    // @overlay-against: function package_version_compare(string $package, string $version, ?string $operator): mixed
    function package_version_compare(string $package, string $version, string $operator): bool;
    // @overlay-against: function package_version_compare(string $package, string $version, ?string $operator): mixed
    function package_version_compare(string $package, string $version, ?string $operator = null): int|bool;

    // @overlay-against: function phpunit_version_compare(string $version, ?string $operator): int|bool
    function phpunit_version_compare(string $version, null $operator = null): int;
    // @overlay-against: function phpunit_version_compare(string $version, ?string $operator): int|bool
    function phpunit_version_compare(string $version, string $operator): bool;
    // @overlay-against: function phpunit_version_compare(string $version, ?string $operator): int|bool
    function phpunit_version_compare(string $version, ?string $operator = null): int|bool;
}

