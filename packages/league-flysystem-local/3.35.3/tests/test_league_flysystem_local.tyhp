<?tyhp

function test_local_adapter(): \League\Flysystem\Local\LocalFilesystemAdapter
{
    return new \League\Flysystem\Local\LocalFilesystemAdapter('/tmp');
}

function test_local_write(\League\Flysystem\Local\LocalFilesystemAdapter $adapter): void
{
    $adapter->write('a.txt', 'hello', new \League\Flysystem\Config());
}

function test_local_read(\League\Flysystem\Local\LocalFilesystemAdapter $adapter): string
{
    return $adapter->read('a.txt');
}

function test_local_exists(\League\Flysystem\Local\LocalFilesystemAdapter $adapter): bool
{
    return $adapter->fileExists('a.txt');
}
