{
    "name": "tyhpdef/giggsey-libphonenumber-for-php",
    "description": "Tyhp type definitions for the Composer package giggsey/libphonenumber-for-php (9.0.39).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "9.0.39.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/giggsey-locale": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "giggsey/libphonenumber-for-php": "9.0.39"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/giggsey-locale": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../giggsey-locale/2.9.0"
        }
    ]
}