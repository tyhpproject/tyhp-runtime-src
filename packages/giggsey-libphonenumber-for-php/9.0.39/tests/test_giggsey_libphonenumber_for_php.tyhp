<?tyhp

function test_phone_util_instance(): \libphonenumber\PhoneNumberUtil
{
    return \libphonenumber\PhoneNumberUtil::getInstance();
}

function test_phone_parse(): \libphonenumber\PhoneNumber
{
    return \libphonenumber\PhoneNumberUtil::getInstance()->parse('+14155552671', 'US');
}

function test_phone_format(\libphonenumber\PhoneNumber $number): string
{
    return \libphonenumber\PhoneNumberUtil::getInstance()->format($number, \libphonenumber\PhoneNumberFormat::E164);
}
