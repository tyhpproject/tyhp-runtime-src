<?tyhp

function test_sniff_register(\PHP_CodeSniffer\Sniffs\Sniff $sniff): array<int|string>
{
    return $sniff->register();
}

function test_file_tokens(\PHP_CodeSniffer\Files\File $file): array<int, array<string, mixed>>
{
    return $file->getTokens();
}

function test_file_add_error(\PHP_CodeSniffer\Files\File $file): bool
{
    return $file->addError('Unexpected token', 0, 'UnexpectedToken');
}

function test_tokens_assignment(): array<int|string, int|string>
{
    return \PHP_CodeSniffer\Util\Tokens::ASSIGNMENT_TOKENS;
}
