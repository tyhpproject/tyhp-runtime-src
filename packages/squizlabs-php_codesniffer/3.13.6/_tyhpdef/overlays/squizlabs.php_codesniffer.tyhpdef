namespace PHP_CodeSniffer\Sniffs {
    // @overlay-against: class AbstractScopeSniff implements \PHP_CodeSniffer\Sniffs\Sniff
    partial class AbstractScopeSniff {
        // @overlay-against: function __construct(array $scopeTokens, array $tokens, bool $listenOutside): void
        public function __construct(array<int, int|string> $scopeTokens, array<int, int|string> $tokens, bool $listenOutside = false): void;
    }
}

namespace PHP_CodeSniffer\Tests\Standards {
    /**
     * The PHP class lives under tests/, outside the src/ harvest glob.
     * Layer 1 subclasses extend it. The PHP parent is PHPUnit's TestCase, which this tyhpdef does not include.
     */
    abstract class AbstractSniffUnitTest {
        public string|null $standardsDir ?? null;

        public string|null $testsDir ?? null;

        protected bool $backupGlobals ?? false;

        /**
         * @return array<int, int>
         */
        protected abstract function getErrorList(): array<int, int>;

        /**
         * @return array<int, int>
         */
        protected abstract function getWarningList(): array<int, int>;

        /**
         * @return array<int, string>
         */
        public function generateFailureMessages(\PHP_CodeSniffer\Files\LocalFile $file): array<int, string>;

        /**
         * @return array<int, string>
         */
        protected function getTestFiles(string $testFileBase): array<int, string>;

        public function setCliValues(string $filename, \PHP_CodeSniffer\Config $config): void;

        protected function setUpPrerequisites(): void;

        protected function shouldSkipTest(): bool;

        final public function testSniff(): void;
    }
}

namespace PHP_CodeSniffer\Tokenizers {
    /**
     * One scope-opener row: which tokens open and close the scope.
     */
    type ScopeOpener = struct {
        array<int|string, int|string> $start;
        array<int|string, int|string> $end;
        bool $strict;
        bool $shared;
        array<int|string, int|string> $with;
    };

    // @overlay-against: class JS extends \PHP_CodeSniffer\Tokenizers\Tokenizer
    partial class JS {
        // @overlay-against: array $scopeOpeners
        public array<int|string, ScopeOpener> $scopeOpeners ?? [];
    }

    // @overlay-against: class PHP extends \PHP_CodeSniffer\Tokenizers\Tokenizer
    partial class PHP {
        // @overlay-against: array $scopeOpeners
        public array<int|string, ScopeOpener> $scopeOpeners ?? [];

        // @overlay-against: function resolveSimpleToken(string $token): array
        public static function resolveSimpleToken(string $token): \PHP_CodeSniffer\Files\RawToken;

        // @overlay-against: function standardiseToken(string|array $token): array
        public static function standardiseToken(string|array<int, int|string> $token): \PHP_CodeSniffer\Files\RawToken;
    }

    // @overlay-against: class Tokenizer
    partial class Tokenizer {
        // @overlay-against: array $ignoredLines
        public array<int, array<string, true|array<string, true>>> $ignoredLines ?? [];

        // @overlay-against: array $scopeOpeners
        public array<int|string, ScopeOpener> $scopeOpeners ?? [];

        // @overlay-against: function getTokens(): array
        public function getTokens(): array<int, \PHP_CodeSniffer\Files\Token>;
    }
}

namespace PHP_CodeSniffer\Util {
    /**
     * One installed coding standard from `getInstalledStandardDetails`.
     */
    type StandardDetails = struct {
        string $path;
        string $name;
        string $namespace;
    };

    // @overlay-against: class Standards
    partial class Standards {
        // @overlay-against: function getInstalledStandardDetails(bool $includeGeneric, string $standardsDir): array
        public static function getInstalledStandardDetails(bool $includeGeneric = false, string $standardsDir = ''): array<string, StandardDetails>;

        // @overlay-against: function getInstalledStandardPaths(): array
        public static function getInstalledStandardPaths(): array<int, string>;

        // @overlay-against: function getInstalledStandards(bool $includeGeneric, string $standardsDir): array
        public static function getInstalledStandards(bool $includeGeneric = false, string $standardsDir = ''): array<string, string>;
    }
}
