<?tyhp

function test_psr_bridge_create_request(
    \Symfony\Bridge\PsrHttpMessage\HttpFoundationFactoryInterface $factory,
    \Psr\Http\Message\ServerRequestInterface $psrRequest,
): \Symfony\Component\HttpFoundation\Request {
    return $factory->createRequest($psrRequest);
}

function test_psr_bridge_create_psr_request(
    \Symfony\Bridge\PsrHttpMessage\HttpMessageFactoryInterface $factory,
    \Symfony\Component\HttpFoundation\Request $request,
): \Psr\Http\Message\ServerRequestInterface {
    return $factory->createRequest($request);
}
