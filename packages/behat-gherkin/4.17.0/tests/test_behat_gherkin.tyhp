<?tyhp

function test_behat_gherkin_manager(): \Behat\Gherkin\Gherkin
{
    $gherkin = new \Behat\Gherkin\Gherkin();
    $gherkin->setBasePath('/tmp');
    return $gherkin;
}

function test_behat_gherkin_feature_tags(): array<int, string>
{
    array<int, string> $tags = [];
    $tags[] = 'wip';
    $feature = new \Behat\Gherkin\Node\FeatureNode(null, null, $tags, null, [], 'Feature', 'en', null, 1);
    return $feature->getTags();
}

function test_behat_gherkin_scenario_tags(): array<int, string>
{
    array<int, string> $tags = [];
    $tags[] = 'wip';
    $scenario = new \Behat\Gherkin\Node\ScenarioNode('hello', $tags, [], 'Scenario', 2);
    return $scenario->getTags();
}
