<?tyhp

function test_pdo_sqlite_driver_api(): int
{
    return PDO::SQLITE_ATTR_BUSY_TIMEOUT;
}

// `Pdo\Sqlite` (PHP 8.4+ named PDO driver subclass) is only in scope when
// compiling for `output.phpVersion` >= 8.4 — see tyhp-php8.4.json.
declare(php=">=8.4") {
    function test_pdo_sqlite_driver_class(\Pdo\Sqlite $conn): int
    {
        return $conn->createFunction("noop", fn (): int => 0) ? \Pdo\Sqlite::ATTR_BUSY_TIMEOUT : 0;
    }
}
