{
    "name": "tyhp/compiler",
    "description": "PHP shim for the Tyhp native compiler CLI (vendor/bin/tyhp)",
    "type": "library",
    "license": "Apache-2.0",
    "version": "805.1.0",
    "keywords": [
        "tyhp",
        "compiler"
    ],
    "homepage": "https://github.com/tyhpproject/tyhp",
    "support": {
        "issues": "https://github.com/tyhpproject/tyhp/issues",
        "source": "https://github.com/tyhpproject/tyhp"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "tyhp/core": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "tyhpdef/php": "@dev",
        "tyhpdef/php-ext-curl": "@dev"
    },
    "bin": [
        "bin/tyhp"
    ],
    "autoload": {
        "psr-4": {
            "Tyhp\\Compiler\\": "src/Tyhp/Compiler/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tyhp\\Compiler\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php"
        },
        {
            "type": "path",
            "url": "../php-ext-curl"
        },
        {
            "type": "path",
            "url": "../dist/tyhp-core/802.latest"
        }
    ],
    "config": {
        "allow-plugins": {
            "tyhp/core": true
        }
    }
}
