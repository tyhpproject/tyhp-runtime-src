<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Parser option bags are string-keyed.
 */

namespace Masterminds {
    /**
     * Overlay: HTML5 option maps are string-keyed.
     */
    // @overlay-against: class HTML5
    partial class HTML5 {
        /**
         * @param array<string, mixed> $defaultOptions
         */
        // @overlay-against: function __construct(array $defaultOptions): void
        public function __construct(array<string, mixed> $defaultOptions = []);

        /**
         * @return array<string, mixed>
         */
        /**
         * @return array<int, string> `Line N, Col N: message` strings from the parser.
         */
        // @overlay-against: function getErrors(): array
        public function getErrors(): array<int, string>;

        // @overlay-against: function getOptions(): array
        public function getOptions(): array<string, mixed>;

        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function loadHTML(string $string, array $options): \DOMDocument
        public function loadHTML(string $string, array<string, mixed> $options = []): \DOMDocument;

        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function saveHTML(mixed $dom, array $options): string
        public function saveHTML(mixed $dom, array<string, mixed> $options = []): string;
    }
}

namespace Masterminds\HTML5\Parser {
    /**
     * Overlay: parser errors are the same line/column strings `HTML5::getErrors()` returns.
     */
    // @overlay-against: class DOMTreeBuilder implements \Masterminds\HTML5\Parser\EventHandler
    partial class DOMTreeBuilder {
        // @overlay-against: function cdata(mixed $data): mixed
        public function cdata(string $data): void;

        // @overlay-against: function comment(mixed $cdata): mixed
        public function comment(string $cdata): void;

        // @overlay-against: function doctype(mixed $name, mixed $idType, mixed $id, mixed $quirks): mixed
        public function doctype(string $name, int $idType = 0, ?string $id = null, bool $quirks = false): void;

        // @overlay-against: function endTag(mixed $name): mixed
        public function endTag(string $name): void;

        // @overlay-against: function eof(): mixed
        public function eof(): void;

        // @overlay-against: function getErrors(): mixed
        public function getErrors(): array<int, string>;

        // @overlay-against: function parseError(mixed $msg, mixed $line, mixed $col): mixed
        public function parseError(string $msg, int $line = 0, int $col = 0): void;

        // @overlay-against: function processingInstruction(mixed $name, mixed $data): mixed
        public function processingInstruction(string $name, ?string $data = null): void;

        // @overlay-against: function setInstructionProcessor(\Masterminds\HTML5\InstructionProcessor $proc): mixed
        public function setInstructionProcessor(\Masterminds\HTML5\InstructionProcessor $proc): void;

        // @overlay-against: function startTag(string $name, array $attributes, bool $selfClosing): int
        public function startTag(string $name, array<string, string> $attributes = [], bool $selfClosing = false): int;

        // @overlay-against: function text(mixed $data): mixed
        public function text(string $data): void;
    }

    /**
     * Overlay: parser events return void except `startTag`, which returns a text mode.
     */
    // @overlay-against: interface EventHandler
    partial interface EventHandler {
        // @overlay-against: function cdata(string $data): mixed
        public function cdata(string $data): void;

        // @overlay-against: function comment(mixed $cdata): mixed
        public function comment(string $cdata): void;

        // @overlay-against: function doctype(string $name, int $idType, string $id, bool $quirks): mixed
        public function doctype(string $name, int $idType = 0, ?string $id = null, bool $quirks = false): void;

        // @overlay-against: function endTag(mixed $name): mixed
        public function endTag(string $name): void;

        // @overlay-against: function eof(): mixed
        public function eof(): void;

        // @overlay-against: function parseError(mixed $msg, mixed $line, mixed $col): mixed
        public function parseError(string $msg, int $line = 0, int $col = 0): void;

        // @overlay-against: function processingInstruction(string $name, string $data): mixed
        public function processingInstruction(string $name, ?string $data = null): void;

        /**
         * @param array<string, string> $attributes
         * @return int One of `Tokenizer::TEXTMODE_*`.
         */
        // @overlay-against: function startTag(string $name, array $attributes, bool $selfClosing): int
        public function startTag(string $name, array<string, string> $attributes = [], bool $selfClosing = false): int;

        // @overlay-against: function text(mixed $cdata): mixed
        public function text(string $cdata): void;
    }
}
