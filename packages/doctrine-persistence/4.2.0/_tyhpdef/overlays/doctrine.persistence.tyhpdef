<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * ObjectRepository / ObjectManager PHPDoc uses T, class-string<T>, and order-by literals.
 */

namespace Doctrine\Persistence {
    /**
     * Registry maps. Layer 1 implementations return bare `array`; the interfaces name the entries.
     */
    // @overlay-against: class AbstractManagerRegistry implements \Doctrine\Persistence\ManagerRegistry
    partial class AbstractManagerRegistry {
        /**
         * @return array<string, string>
         */
        // @overlay-against: function getConnectionNames(): array
        public function getConnectionNames(): array<string, string>;

        /**
         * @return array<string, object>
         */
        // @overlay-against: function getConnections(): array
        public function getConnections(): array<string, object>;

        /**
         * @return array<string, string>
         */
        // @overlay-against: function getManagerNames(): array
        public function getManagerNames(): array<string, string>;

        /**
         * @return array<string, \Doctrine\Persistence\ObjectManager>
         */
        // @overlay-against: function getManagers(): array
        public function getManagers(): array<string, \Doctrine\Persistence\ObjectManager>;
    }

    /**
    * Harvest miss: PHPDoc `@phpstan-param class-string<T>` / `@phpstan-return T|null`
     * / `ObjectRepository<T>` / `ClassMetadata<T>`; L1 still uses `string` and `object`.
     */
    // @overlay-against: interface ObjectManager
    partial interface ObjectManager {
        // @overlay-against: function find(string $className, mixed $id): object|null
        public function find<T extends object>(\__ClassName<T> $className, mixed $id): T|null;

        // @overlay-against: function getClassMetadata(string $className): \Doctrine\Persistence\Mapping\ClassMetadata
        public function getClassMetadata<T extends object>(\__ClassName<T> $className): \Doctrine\Persistence\Mapping\ClassMetadata<T>;

        // @overlay-against: function getRepository(string $className): \Doctrine\Persistence\ObjectRepository
        public function getRepository<T extends object>(\__ClassName<T> $className): \Doctrine\Persistence\ObjectRepository<T>;
    }

    /**
     * Harvest miss: decorator inheritDoc still `string` / `object|null` / unparameterized
     * repository and metadata; PHPDoc on ObjectManager is class-string<T> / T.
     */
    // @overlay-against: class ObjectManagerDecorator implements \Doctrine\Persistence\ObjectManager
    partial class ObjectManagerDecorator {
        // @overlay-against: function find(string $className, mixed $id): object|null
        public function find<T extends object>(\__ClassName<T> $className, mixed $id): T|null;

        // @overlay-against: function getClassMetadata(string $className): \Doctrine\Persistence\Mapping\ClassMetadata
        public function getClassMetadata<T extends object>(\__ClassName<T> $className): \Doctrine\Persistence\Mapping\ClassMetadata<T>;

        // @overlay-against: function getRepository(string $className): \Doctrine\Persistence\ObjectRepository
        public function getRepository<T extends object>(\__ClassName<T> $className): \Doctrine\Persistence\ObjectRepository<T>;
    }

    /**
     * Harvest miss: `@phpstan-return T|null` / `class-string<T>` / order-by literals;
     * L1 still `object|null`, `string`, and `array|null` for `$orderBy`.
     */
    // @overlay-against: interface ObjectRepository
    partial interface ObjectRepository {
        // @overlay-against: function find(mixed $id): object|null
        public function find(mixed $id): T|null;

        /**
         * @param array<string, 'asc'|'desc'|'ASC'|'DESC'>|null $orderBy
         */
        // @overlay-against: function findBy(array $criteria, array|null $orderBy, int|null $limit, int|null $offset): array
        public function findBy(array<string, mixed> $criteria, array<string, 'asc'|'desc'|'ASC'|'DESC'>|null $orderBy = null, int|null $limit = null, int|null $offset = null): array<int, T>;

        // @overlay-against: function findOneBy(array $criteria): object|null
        public function findOneBy(array<string, mixed> $criteria): T|null;

        // @overlay-against: function getClassName(): string
        public function getClassName(): \__ClassName<T>;
    }
}

