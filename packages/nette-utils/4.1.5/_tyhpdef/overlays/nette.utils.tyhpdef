<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Nested array keys, JSON decode maps, iterable generators, and GD color shapes.
 */

namespace Nette\Utils {
    /**
     * Path of keys accepted by `Arrays::get()` / `getRef()`.
     */
    type ArrayKeyPath = string|int|array<int|string, string|int>;

    /**
     * `Helpers::splitClassName()`: namespace (empty when none), then short name.
     */
    type ClassNameParts = struct {
        string 0 as $namespace;
        string 1 as $class;
    };

    /**
     * `Image::rgb()` named channels. Alpha is GD transparency 0..127.
     */
    type GdColor = struct {
        int $red;
        int $green;
        int $blue;
        int $alpha;
    };

    /**
     * One `Iterables::mapWithKeys()` pair: new key, then new value.
     */
    type IterablePair<TKey, TValue> = struct {
        TKey 0 as $key;
        TValue 1 as $value;
    };

    /**
     * `ImageColor::toRGBA()` GD tuple `[R, G, B, alpha]`.
     */
    type RgbaTuple = struct {
        int 0 as $red;
        int 1 as $green;
        int 2 as $blue;
        int 3 as $alpha;
    };

    /**
     * Overlay: path keys, first/last results, and key types follow the element.
     */
    // @overlay-against: class Arrays implements \Nette\StaticClass
    partial class Arrays {
        // @overlay-against: function associate(array $array, string|array $path): array|\stdClass
        public static function associate(array<mixed> $array, string|array<int|string, string> $path): array<int, mixed>|\stdClass;

        /**
         * @return ?V
         */
        // @overlay-against: function first(array $array, ?callable $predicate, ?callable $else): mixed
        public static function first<K extends int|string, V>(array<K, V> $array, null $predicate = null, null $else = null): ?V;

        /**
         * @param callable(V, K, array<K, V>): bool $predicate
         * @return ?V
         */
        // @overlay-against: function first(array $array, ?callable $predicate, ?callable $else): mixed
        public static function first<K extends int|string, V>(array<K, V> $array, callable(V, K, array<K, V>): bool $predicate, null $else = null): ?V;

        /**
         * @param callable(): E $else
         * @return V|E
         */
        // @overlay-against: function first(array $array, ?callable $predicate, ?callable $else): mixed
        public static function first<K extends int|string, V, E>(array<K, V> $array, null $predicate, callable(): E $else): V|E;

        /**
         * @param callable(V, K, array<K, V>): bool $predicate
         * @param callable(): E $else
         * @return V|E
         */
        // @overlay-against: function first(array $array, ?callable $predicate, ?callable $else): mixed
        public static function first<K extends int|string, V, E>(array<K, V> $array, callable(V, K, array<K, V>): bool $predicate, callable(): E $else): V|E;

        /**
         * @param callable(V, K, array<K, V>): bool|null $predicate
         * @return ?K
         */
        // @overlay-against: function firstKey(array $array, ?callable $predicate): int|string|null
        public static function firstKey<K extends int|string, V>(array<K, V> $array, callable(V, K, array<K, V>): bool|null $predicate = null): ?K;

        /**
         * @param array<int|string, T> $array
         * @param \Nette\Utils\ArrayKeyPath $key
         */
        // @overlay-against: function get(array $array, string|int|array $key, ?T $default): ?T
        public static function get<T>(array<int|string, T> $array, \Nette\Utils\ArrayKeyPath $key, ?T $default = null): ?T;

        /**
         * @return ?V
         */
        // @overlay-against: function last(array $array, ?callable $predicate, ?callable $else): mixed
        public static function last<K extends int|string, V>(array<K, V> $array, null $predicate = null, null $else = null): ?V;

        /**
         * @param callable(V, K, array<K, V>): bool $predicate
         * @return ?V
         */
        // @overlay-against: function last(array $array, ?callable $predicate, ?callable $else): mixed
        public static function last<K extends int|string, V>(array<K, V> $array, callable(V, K, array<K, V>): bool $predicate, null $else = null): ?V;

        /**
         * @param callable(): E $else
         * @return V|E
         */
        // @overlay-against: function last(array $array, ?callable $predicate, ?callable $else): mixed
        public static function last<K extends int|string, V, E>(array<K, V> $array, null $predicate, callable(): E $else): V|E;

        /**
         * @param callable(V, K, array<K, V>): bool $predicate
         * @param callable(): E $else
         * @return V|E
         */
        // @overlay-against: function last(array $array, ?callable $predicate, ?callable $else): mixed
        public static function last<K extends int|string, V, E>(array<K, V> $array, callable(V, K, array<K, V>): bool $predicate, callable(): E $else): V|E;

        /**
         * @param callable(V, K, array<K, V>): bool|null $predicate
         * @return ?K
         */
        // @overlay-against: function lastKey(array $array, ?callable $predicate): int|string|null
        public static function lastKey<K extends int|string, V>(array<K, V> $array, callable(V, K, array<K, V>): bool|null $predicate = null): ?K;
    }

    /**
     * File or directory yielded by `Finder`. Omitted from Layer 1 as `@internal`.
     */
    final class FileInfo extends \SplFileInfo {
        public function __construct(string $file, string $relativePath = ''): void;

        public function getRelativePath(): string;

        public function getRelativePathname(): string;

        public function read(): string;

        public function write(string $content): void;
    }

    // @overlay-against: class FileSystem
    partial class FileSystem {
        // @overlay-against: function readLines(string $file, bool $stripNewLines): \Generator
        public static function readLines(string $file, bool $stripNewLines = true): \Generator<int, string>;
    }

    // @overlay-against: class Finder implements \IteratorAggregate
    partial class Finder {
        // @overlay-against: function find(string|array $masks): static
        public static function find(string|array<int|string, string> $masks = []): static;
        // @overlay-against: function findDirectories(string|array $masks): static
        public static function findDirectories(string|array<int|string, string> $masks = []): static;
        // @overlay-against: function findFiles(string|array $masks): static
        public static function findFiles(string|array<int|string, string> $masks = []): static;
        // @overlay-against: function append(string|array|null $paths): static
        public function append(string|array<int|string, string>|null $paths = null): static;
        // @overlay-against: function directories(string|array $masks): static
        public function directories(string|array<int|string, string> $masks = []): static;
        // @overlay-against: function exclude(string|array $masks): static
        public function exclude(string|array<int|string, string> $masks): static;
        // @overlay-against: function files(string|array $masks): static
        public function files(string|array<int|string, string> $masks = []): static;
        // @overlay-against: function from(string|array $paths): static
        public function from(string|array<int|string, string> $paths): static;

        // @overlay-against: function getIterator(): \Generator
        public function getIterator(): \Generator<string, \Nette\Utils\FileInfo>;

        // @overlay-against: function in(string|array $paths): static
        public function in(string|array<int|string, string> $paths): static;
    }

    // @overlay-against: class Helpers
    partial class Helpers {
        // @overlay-against: function splitClassName(string $name): array
        public static function splitClassName(string $name): \Nette\Utils\ClassNameParts;
    }

    // @overlay-against: class Html implements \ArrayAccess, \Countable, \IteratorAggregate, \Nette\HtmlStringable
    partial class Html {
        // @overlay-against: function el(?string $name, array|string|null $attrs): static
        public static function el(?string $name = null, array<string, mixed>|string|null $attrs = null): static;
        // @overlay-against: function create(string $name, array|string|null $attrs): static
        public final function create(string $name, array<string, mixed>|string|null $attrs = null): static;
    }

    // @overlay-against: class Image implements \Nette\SmartObject
    partial class Image {
        // @overlay-against: function rgb(int $red, int $green, int $blue, int $transparency): array
        deprecated public static function rgb(int $red, int $green, int $blue, int $transparency = 0): \Nette\Utils\GdColor;
    }

    // @overlay-against: class ImageColor
    partial class ImageColor {
        // @overlay-against: function toRGBA(): array
        public function toRGBA(): \Nette\Utils\RgbaTuple;
    }

    // @overlay-against: class Iterables implements \Nette\StaticClass
    partial class Iterables {
        /**
         * @param callable(V, K, iterable<K, V>): bool $predicate
         */
        // @overlay-against: function filter(iterable $iterable, callable $predicate): \Generator
        public static function filter<K, V>(iterable<K, V> $iterable, callable(V, K, iterable<K, V>): bool $predicate): \Generator<K, V>;

        /**
         * @param callable(V, K, iterable<K, V>): R $transformer
         */
        // @overlay-against: function map(iterable $iterable, callable $transformer): \Generator
        public static function map<K, V, R>(iterable<K, V> $iterable, callable(V, K, iterable<K, V>): R $transformer): \Generator<K, R>;

        /**
         * @param callable(V, K, iterable<K, V>): ?\Nette\Utils\IterablePair<ResK, ResV> $transformer
         */
        // @overlay-against: function mapWithKeys(iterable $iterable, callable $transformer): \Generator
        public static function mapWithKeys<K, V, ResK, ResV>(iterable<K, V> $iterable, callable(V, K, iterable<K, V>): ?\Nette\Utils\IterablePair<ResK, ResV> $transformer): \Generator<ResK, ResV>;
    }

    /**
     * Overlay: `decode(..., forceArrays: true)` yields arrays. Failures throw `JsonException`.
     */
    // @overlay-against: class Json implements \Nette\StaticClass
    partial class Json {
        /**
         * @param true $forceArrays JSON objects become arrays.
         */
        // @overlay-against: function decode(string $json, bool|int $forceArrays): mixed
        public static function decode(string $json, true $forceArrays): \JsonAssoc;

        /**
         * @param false $forceArrays JSON objects stay `\stdClass`.
         */
        // @overlay-against: function decode(string $json, bool|int $forceArrays): mixed
        public static function decode(string $json, false $forceArrays = false): \JsonObject;

        // @overlay-against: function decode(string $json, bool|int $forceArrays): mixed
        public static function decode(string $json, bool $forceArrays): \JsonAssoc|\JsonObject;

        /**
         * @param int $forceArrays JSON flag bitmask (`JSON_*`), not the bool switch.
         */
        // @overlay-against: function decode(string $json, bool|int $forceArrays): mixed
        public static function decode(string $json, int $forceArrays): \JsonAssoc|\JsonObject;

        // @overlay-against: function encode(mixed $value, bool|int $pretty, bool $asciiSafe, bool $htmlSafe, bool $forceObjects): string
        public static function encode(mixed $value, bool|int $pretty = false, bool $asciiSafe = false, bool $htmlSafe = false, bool $forceObjects = false): string;
    }

    // @overlay-against: class Strings implements \Nette\StaticClass
    partial class Strings {
        // @overlay-against: function replace(string $subject, string|array $pattern, string|callable $replacement, int $limit, bool $captureOffset, bool $unmatchedAsNull, bool $utf8): string
        public static function replace(string $subject, string|array<string, string> $pattern, string|(callable(array<int|string, string|int>): string) $replacement = '', int $limit = -1, bool $captureOffset = false, bool $unmatchedAsNull = false, bool $utf8 = false): string;
    }
}
