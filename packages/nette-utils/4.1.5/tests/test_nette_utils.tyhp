<?tyhp

function test_nette_strings_length(): int
{
    return \Nette\Utils\Strings::length('tyhp');
}

function test_nette_arrays_get(): ?string
{
    return \Nette\Utils\Arrays::get(['a' => 'b'], 'a');
}

function test_nette_arrays_get_path(): mixed
{
    return \Nette\Utils\Arrays::get(['a' => ['b' => 'c']], ['a', 'b']);
}

function test_nette_json_encode(): string
{
    return \Nette\Utils\Json::encode(['ok' => true]);
}

function test_nette_json_decode(): mixed
{
    return \Nette\Utils\Json::decode('{"ok":true}');
}

function test_nette_validators_email(): bool
{
    return \Nette\Utils\Validators::isEmail('user@example.com');
}
