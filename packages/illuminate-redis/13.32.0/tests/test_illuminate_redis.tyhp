<?tyhp

function test_redis_manager(\Illuminate\Redis\RedisManager $redis): \Illuminate\Redis\Connections\Connection
{
    return $redis->connection('default');
}

function test_command_executed(\Illuminate\Redis\Connections\Connection $connection): \Illuminate\Redis\Events\CommandExecuted
{
    return new \Illuminate\Redis\Events\CommandExecuted('get', ['k'], 0.1, $connection);
}
