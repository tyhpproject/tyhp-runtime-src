<?tyhp

function test_curl_init_signature(): CurlHandle|false
{
    return curl_init();
}

// Persistent cURL share handles (`CurlSharePersistentHandle`, `curl_share_init_persistent()`)
// are only in scope when compiling for `output.phpVersion` >= 8.5 — see tyhp-php8.5.json.
declare(php=">=8.5") {
    function test_curl_share_init_persistent(): int
    {
        CurlSharePersistentHandle $share = curl_share_init_persistent([CURL_LOCK_DATA_DNS]);
        return \count($share->options);
    }
}
