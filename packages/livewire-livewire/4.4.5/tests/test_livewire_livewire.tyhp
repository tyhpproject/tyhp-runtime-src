<?tyhp

function test_is_livewire_request(): bool
{
    return \Livewire\Livewire::isLivewireRequest();
}

function test_get_update_uri(): string
{
    return \Livewire\Livewire::getUpdateUri();
}

function test_flush_state(): void
{
    \Livewire\Livewire::flushState();
}

function test_is_running_serverless(): bool
{
    return \Livewire\Livewire::isRunningServerless();
}

function test_original_url(): string
{
    return \Livewire\Livewire::originalUrl();
}

function test_without_lazy_loading(): \Livewire\LivewireManager
{
    return \Livewire\Livewire::withoutLazyLoading();
}

function test_event_bus_on(\Livewire\EventBus $bus): callable
{
    return $bus->on('foo', function (): void {});
}

function test_event_bus_off(\Livewire\EventBus $bus): void
{
    $bus->off('foo', function (): void {});
}
