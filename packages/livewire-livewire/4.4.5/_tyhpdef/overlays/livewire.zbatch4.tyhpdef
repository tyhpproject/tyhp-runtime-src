        // @overlay-against: function hydrate(mixed $value, mixed $meta): mixed
        public function hydrate(mixed $value, array<string, mixed> $meta): \BackedEnum|null;
    }

    // @overlay-against: class FloatSynth extends \Livewire\Mechanisms\HandleComponents\Synthesizers\Synth
    partial class FloatSynth {
        // @overlay-against: mixed $key
        public static string $key ?? 'float';

        // @overlay-against: function match(mixed $target): mixed
        public static function match(mixed $target): bool;

        // @overlay-against: function matchByType(mixed $type): mixed
        public static function matchByType(mixed $type): bool;
    }

    // @overlay-against: class IntSynth extends \Livewire\Mechanisms\HandleComponents\Synthesizers\Synth
    partial class IntSynth {
        // @overlay-against: mixed $key
        public static string $key ?? 'int';

        // @overlay-against: function match(mixed $target): mixed
        public static function match(mixed $target): bool;

        // @overlay-against: function matchByType(mixed $type): mixed
        public static function matchByType(mixed $type): bool;
    }

    // @overlay-against: class StdClassSynth extends \Livewire\Mechanisms\HandleComponents\Synthesizers\Synth implements \Livewire\Mechanisms\HandleComponents\Synthesizers\ArrayShapedSynth
    partial class StdClassSynth {
        // @overlay-against: mixed $key
        public static string $key ?? 'std';

        // @overlay-against: function match(mixed $target): mixed
        public static function match(mixed $target): bool;

        // @overlay-against: function dehydrate(mixed $target, mixed $dehydrateChild): mixed
        public function dehydrate(mixed $target, callable(int|string, mixed): mixed $dehydrateChild): StdClassSynthDehydrated;

        // @overlay-against: function hydrate(mixed $value, mixed $meta, mixed $hydrateChild): mixed
        public function hydrate(mixed $value, mixed $meta, callable(int|string, mixed): mixed $hydrateChild): \stdClass;

        // @overlay-against: function set(mixed $target, mixed $key, mixed $value): mixed
        public function set(mixed &$target, int|string $key, mixed $value): void;
    }

    // @overlay-against: class StringableSynth extends \Livewire\Mechanisms\HandleComponents\Synthesizers\Synth
    partial class StringableSynth {
        // @overlay-against: mixed $key
        public static string $key ?? 'str';

        // @overlay-against: function match(mixed $target): mixed
        public static function match(mixed $target): bool;

        // @overlay-against: function dehydrate(mixed $target): mixed
