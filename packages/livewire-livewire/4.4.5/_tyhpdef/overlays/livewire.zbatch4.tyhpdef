    // @overlay-against: class Synth
    partial class Synth {
        // @overlay-against: function matchByType(mixed $type): mixed
        public static function matchByType(mixed $type): bool;

        // @overlay-against: function __call(mixed $method, mixed $params): mixed
        public function __call(string $method, mixed $params): null;

        // @overlay-against: function get(mixed $target, mixed $key): mixed
        public function get(mixed &$target, int|string $key): mixed;
