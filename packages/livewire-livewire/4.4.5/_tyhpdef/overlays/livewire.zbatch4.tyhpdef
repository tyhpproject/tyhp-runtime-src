        public function dehydrate(array<int|string, mixed> $target, callable(int|string, mixed): mixed $dehydrateChild): ArraySynthDehydrated;

        // @overlay-against: function hydrate(mixed $value, mixed $meta, mixed $hydrateChild): mixed
        public function hydrate(mixed $value, mixed $meta, callable(int|string, mixed): mixed $hydrateChild): mixed;

        // @overlay-against: function set(mixed $target, mixed $key, mixed $value): mixed
        public function set(array<int|string, mixed> &$target, int|string $key, mixed $value): void;

        // @overlay-against: function unset(mixed $target, mixed $key): mixed
        public function unset(array<int|string, mixed> &$target, int|string $key): void;
    }

    // @overlay-against: class CarbonSynth extends \Livewire\Mechanisms\HandleComponents\Synthesizers\Synth
    partial class CarbonSynth {
        // @overlay-against: mixed $key
        public static string $key ?? 'cbn';

        // @overlay-against: mixed $types
        public static CarbonSynthTypeMap $types ?? [
            'native' => \DateTime::class,
            'nativeImmutable' => \DateTimeImmutable::class,
            'carbon' => \Carbon\Carbon::class,
            'carbonImmutable' => \Carbon\CarbonImmutable::class,
            'illuminate' => \Illuminate\Support\Carbon::class,
        ];

        // @overlay-against: function hydrateFromType(mixed $type, mixed $value): mixed
        public static function hydrateFromType(string $type, mixed $value): object|null;

        // @overlay-against: function match(mixed $target): mixed
        public static function match(mixed $target): bool;

        // @overlay-against: function matchByType(mixed $type): mixed
        public static function matchByType(mixed $type): bool;

        // @overlay-against: function dehydrate(mixed $target): mixed
        public function dehydrate(\DateTimeInterface $target): CarbonDehydrated;

        // @overlay-against: function hydrate(mixed $value, mixed $meta): mixed
        public function hydrate(mixed $value, array<string, mixed> $meta): \Carbon\Carbon|\Carbon\CarbonImmutable|\DateTime|\DateTimeImmutable|\Illuminate\Support\Carbon|null;
    }

    // @overlay-against: class CollectionSynth extends \Livewire\Mechanisms\HandleComponents\Synthesizers\ArraySynth implements \Livewire\Mechanisms\HandleComponents\Synthesizers\ArrayShapedSynth
    partial class CollectionSynth {
        // @overlay-against: mixed $key
        public static string $key ?? 'clctn';

        // @overlay-against: function match(mixed $target): mixed
        public static function match(mixed $target): bool;

        // @overlay-against: function dehydrate(mixed $target, mixed $dehydrateChild): mixed
        public function dehydrate(\Illuminate\Support\Collection<int|string, mixed> $target, callable(int|string, mixed): mixed $dehydrateChild): CollectionSynthDehydrated;

        // @overlay-against: function hydrate(mixed $value, mixed $meta, mixed $hydrateChild): mixed
        public function hydrate(array<int|string, mixed> $value, array<string, mixed> $meta, callable(int|string, mixed): mixed $hydrateChild): \Illuminate\Support\Collection<int|string, mixed>;
    }

    // @overlay-against: class EnumSynth extends \Livewire\Mechanisms\HandleComponents\Synthesizers\Synth
    partial class EnumSynth {
        // @overlay-against: mixed $key
        public static string $key ?? 'enm';

        // @overlay-against: function hydrateFromType(mixed $type, mixed $value): mixed
        public static function hydrateFromType(string $type, mixed $value): \BackedEnum|null;

        // @overlay-against: function match(mixed $target): mixed
        public static function match(mixed $target): bool;

        // @overlay-against: function matchByType(mixed $type): mixed
        public static function matchByType(mixed $type): bool;

        // @overlay-against: function dehydrate(mixed $target): mixed
