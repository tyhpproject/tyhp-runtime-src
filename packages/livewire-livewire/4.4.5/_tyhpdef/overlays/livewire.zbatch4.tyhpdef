namespace Livewire\Mechanisms\HandleComponents {
    type ComponentSnapshot = struct {
        string $checksum;
        array<string, mixed> $data;
        array<string, mixed> $memo;
    };

    type ComponentUpdateCall = struct {
        array<string, mixed>|null $metadata;
        string $method;
        array<int, mixed> $params;
    };

    type ComponentUpdateResult = struct {
        ComponentSnapshot 0 as $snapshot;
        array<int|string, mixed> 1 as $effects;
    };

    type FromSnapshotResult = struct {
        mixed 0 as $component;
        ComponentContext 1 as $context;
    };

    // @overlay-against: class Checksum
    partial class Checksum {
        // @overlay-against: function disableRateLimitingForTesting(): mixed
        public static function disableRateLimitingForTesting(): void;

        // @overlay-against: function enableRateLimitingForTesting(): mixed
        public static function enableRateLimitingForTesting(): void;

        // @overlay-against: function generate(mixed $snapshot): mixed
        public static function generate(array<string, mixed> $snapshot): string;

        // @overlay-against: function verify(mixed $snapshot): mixed
        public static function verify(ComponentSnapshot $snapshot): void;
    }

    // @overlay-against: class ComponentContext
    partial class ComponentContext {
        // @overlay-against: mixed $effects
        public array<int|string, mixed> $effects ?? [];

        // @overlay-against: mixed $memo
        public array<int|string, mixed> $memo ?? [];

        // @overlay-against: function addEffect(mixed $key, mixed $value): mixed
        public function addEffect(array<int|string, mixed>|int|string $key, mixed $value): void;

        // @overlay-against: function addMemo(mixed $key, mixed $value): mixed
        public function addMemo(int|string $key, mixed $value): void;

        // @overlay-against: function pushEffect(mixed $key, mixed $value, mixed $iKey): mixed
        public function pushEffect(int|string $key, mixed $value, int|string|null $iKey = null): void;

        // @overlay-against: function pushMemo(mixed $key, mixed $value, mixed $iKey): mixed
        public function pushMemo(int|string $key, mixed $value, int|string|null $iKey = null): void;
    }

    // @overlay-against: class CorruptComponentPayloadException extends \Exception implements \Livewire\Exceptions\BypassViewHandler
    partial class CorruptComponentPayloadException {
        // @overlay-against: function render(mixed $request): mixed
        public function render(mixed $request): false|\Illuminate\Http\Response;
    }

    // @overlay-against: class HandleComponents extends \Livewire\Mechanisms\Mechanism
    partial class HandleComponents {
        // @overlay-against: mixed $componentStack
        public static array<int, mixed> $componentStack ?? [];

        // @overlay-against: mixed $renderStack
        public static array<int, mixed> $renderStack ?? [];

        // @overlay-against: function boot(): mixed
        public function boot(): void;

        // @overlay-against: function fromSnapshot(mixed $snapshot): mixed
        public function fromSnapshot(ComponentSnapshot $snapshot): FromSnapshotResult;

        // @overlay-against: function mount(mixed $name, mixed $params, mixed $key, mixed $slots): mixed
        public function mount(mixed $name, array<int|string, mixed> $params = [], mixed $key = null, mixed $slots = []): mixed;

        // @overlay-against: function snapshot(mixed $component, mixed $context): mixed
        public function snapshot(mixed $component, ComponentContext|null $context = null): ComponentSnapshot;

        // @overlay-against: function update(mixed $snapshot, mixed $updates, mixed $calls): mixed
        public function update(ComponentSnapshot $snapshot, array<string, mixed> $updates, array<int, ComponentUpdateCall> $calls): ComponentUpdateResult;

        // @overlay-against: function updateProperty(mixed $component, mixed $path, mixed $value, mixed $context): mixed
        public function updateProperty(mixed $component, string $path, mixed $value, mixed $context): mixed;
    }

    // @overlay-against: class ViewContext
    partial class ViewContext {
        // @overlay-against: function extractFromEnvironment(mixed $__env): mixed
        public function extractFromEnvironment(mixed $__env): void;

        // @overlay-against: function mergeIntoNewEnvironment(mixed $__env): mixed
        public function mergeIntoNewEnvironment(mixed $__env): void;
    }
}

namespace Livewire\Mechanisms\HandleComponents\Synthesizers {
    type ArraySynthDehydrated = struct {
        array<int|string, mixed> 0 as $value;
        array<string, mixed> 1 as $meta;
    };

    type CarbonDehydrated = struct {
        string 0 as $value;
        CarbonDehydratedMeta 1 as $meta;
    };

    type CarbonDehydratedMeta = struct {
        string|false $type;
    };

    type CarbonSynthTypeMap = struct {
        string $carbon;
        string $carbonImmutable;
        string $illuminate;
        string $native;
        string $nativeImmutable;
    };

    type CollectionSynthDehydrated = struct {
        array<int|string, mixed> 0 as $data;
        CollectionSynthDehydratedMeta 1 as $meta;
    };

    type CollectionSynthDehydratedMeta = struct {
        string $class;
    };

    type EnumSynthDehydrated = struct {
        int|string 0 as $value;
        EnumSynthDehydratedMeta 1 as $meta;
    };

    type EnumSynthDehydratedMeta = struct {
        string $class;
    };

    type StdClassSynthDehydrated = struct {
        array<int|string, mixed> 0 as $data;
        array<string, mixed> 1 as $meta;
    };

    type StringableSynthDehydrated = struct {
        string 0 as $value;
        array<string, mixed> 1 as $meta;
    };

