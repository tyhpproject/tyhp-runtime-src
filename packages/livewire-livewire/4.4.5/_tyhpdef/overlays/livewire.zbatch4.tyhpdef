        // @overlay-against: function setPersistentMiddleware(mixed $middleware): mixed
        public function setPersistentMiddleware(mixed $middleware): void;

        // @overlay-against: function setProvider(\Livewire\LivewireServiceProvider $provider): mixed
        public function setProvider(\Livewire\LivewireServiceProvider $provider): void;

        // @overlay-against: function updateProperty(mixed $component, mixed $path, mixed $value): mixed
        public function updateProperty(mixed $component, mixed $path, mixed $value): void;

        // @overlay-against: function withCookie(mixed $name, mixed $value): mixed
