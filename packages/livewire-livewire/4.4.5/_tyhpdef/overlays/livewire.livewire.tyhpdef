<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Laravel Dusk is not on this exclusive-set include graph; omit types and
 * members that name `\Laravel\Dusk\Browser`. Do not inline `\Laravel\Dusk\*`.
 */

namespace Livewire {
    /**
     * Overlay: `test` matches `LivewireManager::test`. The component name is a
     * class-string, a component instance, or a list of components.
     */
    // @overlay-against: class Livewire extends \Illuminate\Support\Facades\Facade
    partial class Livewire {
        // @overlay-against: function test(mixed $name, mixed $params): \Livewire\Features\SupportTesting\Testable
        public static function test<TComponent extends \Livewire\Component>(__ClassName<TComponent>|TComponent|string|array<int|string, \Livewire\Component> $name, array $params = []): \Livewire\Features\SupportTesting\Testable<TComponent>;
    }
}

namespace Livewire\Features\SupportTesting {
    /**
     * Overlay: Dusk browser macros are typed against `\Laravel\Dusk\Browser`.
     */
    // @overlay-against: class DuskBrowserMacros
    omit class DuskBrowserMacros {
    }

    /**
     * Overlay: `create` returns `\Laravel\Dusk\Browser` (unowned here).
     */
    // @overlay-against: class DuskTestable
    partial class DuskTestable {
        // @overlay-against: function create(mixed $components, mixed $params, mixed $queryParams): \Laravel\Dusk\Browser
        omit function create();
    }
}
