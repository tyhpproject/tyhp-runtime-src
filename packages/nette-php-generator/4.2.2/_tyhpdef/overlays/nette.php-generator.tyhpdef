        public function fromCallable(callable(mixed ...): mixed $from): \Nette\PhpGenerator\Method|\Nette\PhpGenerator\GlobalFunction|\Nette\PhpGenerator\Closure;
    }

    // @overlay-against: class InterfaceType extends \Nette\PhpGenerator\ClassLike
    partial class InterfaceType {
