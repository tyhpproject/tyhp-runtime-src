 */

namespace Nette\PhpGenerator {
    // @overlay-against: class Attribute
    partial class Attribute {
        // @overlay-against: function __construct(string $name, array $args): void
        public function __construct(string $name, array<int|string, mixed> $args): void;
    }

    /**
    * Overlay: the string arm of `from` is a class name.
    */
    // @overlay-against: class ClassLike
    partial class ClassLike {
        // @overlay-against: function from(string|object $class, bool $withBodies): static
        public static function from(\__ClassName|object $class, bool $withBodies = false): static;
    }

    // @overlay-against: class Factory
    partial class Factory {
