<?tyhp

class OverlayTests_MacroableHost {
    use \Illuminate\Support\Traits\Macroable;
}

function test_macroable_register(): bool
{
    OverlayTests_MacroableHost::macro('ping', static fn (): string => 'pong');
    return OverlayTests_MacroableHost::hasMacro('ping');
}

function test_macroable_flush(): void
{
    OverlayTests_MacroableHost::flushMacros();
}

function test_macroable_mixin(object $mixin): void
{
    OverlayTests_MacroableHost::mixin($mixin, false);
}
