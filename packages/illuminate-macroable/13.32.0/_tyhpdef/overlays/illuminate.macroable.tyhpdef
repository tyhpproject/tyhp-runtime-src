<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Harvest left `$macros` as bare `array` and `__call` parameters as `array`.
 * PHP stores name → object|callable and forwards argument lists.
 */

namespace Illuminate\Support\Traits {
    /**
     * Overlay: macro table is string-keyed; `__call` args are list literals.
     */
    // @overlay-against: trait Macroable
    partial trait Macroable {
        /**
         * @var array<string, object|callable>
         */
        // @overlay-against: array $macros
        protected static array<string, object|callable> $macros ?? [];

        /**
         * @param array<int|string, mixed> $parameters
         */
        // @overlay-against: function __callStatic(string $method, array $parameters): mixed
        public static function __callStatic(string $method, array<int|string, mixed> $parameters): mixed;

        /**
         * @param array<int|string, mixed> $parameters
         */
        // @overlay-against: function __call(string $method, array $parameters): mixed
        public function __call(string $method, array<int|string, mixed> $parameters): mixed;
    }
}
