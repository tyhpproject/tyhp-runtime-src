namespace Spatie\Image {
    /**
     * Overlay: `Color::format()` / `pickColor()` result for one `ColorFormat` case.
     * Rgba and hex are strings, int is an int, array is RGBA components, object is the color.
     */
    type ColorFormatValue = string|int|array<int, int|float>|\Spatie\Image\Drivers\Color;

    // @overlay-against: class Image implements \Spatie\Image\Drivers\ImageDriver, \Spatie\Image\Drivers\Concerns\ValidatesArguments
    partial class Image {
        // @overlay-against: function height(int $height, array $constraints): static
        public function height(int $height, array<int|string, \Spatie\Image\Enums\Constraint> $constraints = []): static;

        /**
         * Overlay: `Image::pickColor()` returns the formatted color.
         */
        // @overlay-against: function pickColor(int $x, int $y, \Spatie\Image\Enums\ColorFormat $colorFormat): mixed
        public function pickColor(int $x, int $y, \Spatie\Image\Enums\ColorFormat $colorFormat): ColorFormatValue;

        // @overlay-against: function resize(int $width, int $height, array $constraints): static
        public function resize(int $width, int $height, array<int|string, \Spatie\Image\Enums\Constraint> $constraints = []): static;

        // @overlay-against: function width(int $width, array $constraints): static
        public function width(int $width, array<int|string, \Spatie\Image\Enums\Constraint> $constraints = []): static;
    }
}

namespace Spatie\Image\Drivers {
    /**
     * Overlay: values `Color::parse()` accepts before it throws `InvalidColor`.
     */
    type ColorInput = string|int|array<int, int|float>|\ImagickPixel|null;

    // @overlay-against: class Color
    partial class Color {
        /**
         * Overlay: `Color::__construct()` parses a color value.
         */
        // @overlay-against: function __construct(mixed $value): void
        public function __construct(ColorInput $value = null): void;

        /**
         * Overlay: `Color::format()` returns the value for the requested format.
         */
        // @overlay-against: function format(\Spatie\Image\Enums\ColorFormat $colorFormat): mixed
        public function format(\Spatie\Image\Enums\ColorFormat $colorFormat): \Spatie\Image\ColorFormatValue;

        /**
         * Overlay: `Color::parse()` accepts a string, int, component list, Imagick pixel, or null.
         */
        // @overlay-against: function parse(mixed $colorValue): self
        public function parse(ColorInput $colorValue): self;
    }

    // @overlay-against: interface ImageDriver
    partial interface ImageDriver {
        /**
         * Overlay: `ImageDriver::pickColor()` returns the formatted color.
         */
        // @overlay-against: function pickColor(int $x, int $y, \Spatie\Image\Enums\ColorFormat $colorFormat): mixed
        public function pickColor(int $x, int $y, \Spatie\Image\Enums\ColorFormat $colorFormat): \Spatie\Image\ColorFormatValue;
    }
}

namespace Spatie\Image\Drivers\Concerns {
    /**
     * Overlay: focal crop returns `[cropWidth, cropHeight, cropX, cropY]`.
     */
    type CalculatesFocalCropAndResizeCoordinatesResult = struct {
        int 0 as $cropWidth;
        int 1 as $cropHeight;
        int 2 as $cropX;
        int 3 as $cropY;
    };

    // @overlay-against: trait CalculatesFocalCropAndResizeCoordinates
    partial trait CalculatesFocalCropAndResizeCoordinates {
        // @overlay-against: function calculateFocalCropAndResizeCoordinates(?int $desiredWidth, ?int $desiredHeight, ?float $cropCenterX, ?float $cropCenterY): array
        public function calculateFocalCropAndResizeCoordinates(?int $desiredWidth, ?int $desiredHeight, ?float $cropCenterX = 50.0, ?float $cropCenterY = 50.0): CalculatesFocalCropAndResizeCoordinatesResult;
    }

    /**
     * Overlay: documented array shape.
     */
    type GetsOrientationFromExifGetOrientationFromExifExif = struct {
        ?int $Orientation;
    };

    // @overlay-against: trait GetsOrientationFromExif
    partial trait GetsOrientationFromExif {
        /**
         * Overlay: `GetsOrientationFromExif::getOrientationFromExif()` uses the documented types.
         */
        // @overlay-against: function getOrientationFromExif(array $exif): \Spatie\Image\Enums\Orientation
        public function getOrientationFromExif(GetsOrientationFromExifGetOrientationFromExifExif $exif): \Spatie\Image\Enums\Orientation;
    }
}
