<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * ExpectDeprecationTrait harvested as `@method` only; CoverageListener implements PHPUnit TestListener.
 */

namespace Symfony\Bridge\PhpUnit {
    /**
     * `[seconds, nanoseconds]` from `ClockMock::hrtime(false)`.
     */
    type HrtimeTuple = struct {
        int 0 as $seconds;
        int 1 as $nanoseconds;
    };

    /**
     * Overlay: PHPUnit 12 does not declare `TestListener`; omit the unwrapped peer.
     */
    // @overlay-against: class CoverageListener implements \PHPUnit\Framework\TestListener, \PHPUnit\Framework\TestListenerDefaultImplementation
    omit class CoverageListener {
    }

    /**
     * Overlay: harvest skipped the trait (`@method` / version gate); vendor declares `expectDeprecation(string): void`.
     */
    trait ExpectDeprecationTrait {
        /**
         * @method void expectDeprecation(string $message)
         */
        public function expectDeprecation(string $message): void;
    }

    /**
     * Overlay: mocked class maps are name => bool. Existence checks match PHP's `string` / `bool` parameters.
     */
    // @overlay-against: class ClassExistsMock
    partial class ClassExistsMock {
        // @overlay-against: function class_exists(mixed $name, mixed $autoload): bool
        public static function class_exists(string $name, bool $autoload = true): bool;

        // @overlay-against: function enum_exists(mixed $name, mixed $autoload): bool
        public static function enum_exists(string $name, bool $autoload = true): bool;

        // @overlay-against: function interface_exists(mixed $name, mixed $autoload): bool
        public static function interface_exists(string $name, bool $autoload = true): bool;

        // @overlay-against: function register(mixed $class): void
        public static function register(string $class): void;

        // @overlay-against: function trait_exists(mixed $name, mixed $autoload): bool
        public static function trait_exists(string $name, bool $autoload = true): bool;

        /**
         * @param array<string, bool> $classes
         */
        // @overlay-against: function withMockedClasses(array $classes): void
        public static function withMockedClasses(array<string, bool> $classes): void;

        /**
         * @param array<string, bool> $enums
         */
        // @overlay-against: function withMockedEnums(array $enums): void
        public static function withMockedEnums(array<string, bool> $enums): void;
    }

    /**
     * Overlay: clock helpers follow the PHP functions they replace. `microtime` / `hrtime` narrow on the bool flag.
     */
    // @overlay-against: class ClockMock
    partial class ClockMock {
        // @overlay-against: function date(mixed $format, mixed $timestamp): string
        public static function date(string $format, ?int $timestamp = null): string;

        // @overlay-against: function gmdate(mixed $format, mixed $timestamp): string
        public static function gmdate(string $format, ?int $timestamp = null): string;

        /**
         * @param false $asNumber
         * @return \Symfony\Bridge\PhpUnit\HrtimeTuple
         */
        // @overlay-against: function hrtime(mixed $asNumber): array|int|float
        public static function hrtime(false $asNumber = false): \Symfony\Bridge\PhpUnit\HrtimeTuple;

        /**
         * @param true $asNumber
         */
        // @overlay-against: function hrtime(mixed $asNumber): array|int|float
        public static function hrtime(true $asNumber): int|float;

        /**
         * @return \Symfony\Bridge\PhpUnit\HrtimeTuple|int|float
         */
        // @overlay-against: function hrtime(mixed $asNumber): array|int|float
        public static function hrtime(bool $asNumber = false): \Symfony\Bridge\PhpUnit\HrtimeTuple|int|float;

        /**
         * @param false $asFloat
         */
        // @overlay-against: function microtime(mixed $asFloat): string|float
        public static function microtime(false $asFloat = false): string;

        /**
         * @param true $asFloat
         */
        // @overlay-against: function microtime(mixed $asFloat): string|float
        public static function microtime(true $asFloat): float;

        // @overlay-against: function microtime(mixed $asFloat): string|float
        public static function microtime(bool $asFloat = false): string|float;

        // @overlay-against: function register(mixed $class): void
        public static function register(string $class): void;

        // @overlay-against: function sleep(mixed $s): int
        public static function sleep(int $s): int;

        // @overlay-against: function usleep(mixed $us): void
        public static function usleep(int $us): void;
    }
}
