<?tyhp

function test_nette_expect_string(): \Nette\Schema\Elements\Type
{
    return \Nette\Schema\Expect::string();
}

function test_nette_expect_structure(): \Nette\Schema\Elements\Structure
{
    return \Nette\Schema\Expect::structure([
        'name' => \Nette\Schema\Expect::string(),
        'age' => \Nette\Schema\Expect::int(),
    ]);
}

function test_nette_processor(\Nette\Schema\Schema $schema): mixed
{
    return (new \Nette\Schema\Processor())->process($schema, ['name' => 'tyhp']);
}
