<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `@method` defaults and associative structure shapes from the PHP source.
 */

namespace Nette\Schema {
    /**
    * Overlay: structure keys are property names; `__callStatic` magic types have defaults.
    */
    // @overlay-against: class Expect
    partial class Expect {
        /**
         * @param array<int|string, mixed> $args
         */
        // @overlay-against: function __callStatic(string $name, array $args): \Nette\Schema\Elements\Type
        public static function __callStatic(string $name, array<int|string, mixed> $args): \Nette\Schema\Elements\Type;

        // @overlay-against: function bool(mixed $default): \Nette\Schema\Elements\Type
        public static function bool(mixed $default = null): \Nette\Schema\Elements\Type<bool>;

        // @overlay-against: function int(mixed $default): \Nette\Schema\Elements\Type
        public static function int(mixed $default = null): \Nette\Schema\Elements\Type<int>;

        // @overlay-against: function string(mixed $default): \Nette\Schema\Elements\Type
        public static function string(mixed $default = null): \Nette\Schema\Elements\Type<string>;

        /**
         * @param array<int|string, \Nette\Schema\Schema> $shape
         */
        // @overlay-against: function structure(array $shape): \Nette\Schema\Elements\Structure
        public static function structure(array<int|string, \Nette\Schema\Schema> $shape): \Nette\Schema\Elements\Structure<array<int|string, mixed>>;
    }

    /**
     * Overlay: completed value is the schema's type parameter. Input stays mixed.
     */
    // @overlay-against: class Processor
    partial class Processor {
        // @overlay-against: function process(\Nette\Schema\Schema $schema, mixed $data): mixed
        public function process<T>(\Nette\Schema\Schema<T> $schema, mixed $data): T;

        /**
         * @param array<int|string, mixed> $dataset
         */
        // @overlay-against: function processMultiple(\Nette\Schema\Schema $schema, array $dataset): mixed
        public function processMultiple<T>(\Nette\Schema\Schema<T> $schema, array<int|string, mixed> $dataset): T;
    }

    /**
     * Overlay: completed value is the schema's type parameter.
     */
    // @overlay-against: interface Schema
    partial interface Schema<T = mixed>;

    // @overlay-against: interface Schema
    partial interface Schema {
        // @overlay-against: function complete(mixed $value, \Nette\Schema\Context $context): mixed
        public function complete(mixed $value, \Nette\Schema\Context $context): T;

        // @overlay-against: function completeDefault(\Nette\Schema\Context $context): mixed
        public function completeDefault(\Nette\Schema\Context $context): T;
    }
}

namespace Nette\Schema\Elements {
    /**
     * Internal trait omitted from Layer 1 (`@internal`).
     */
    trait Base {
        /**
         * @param callable(mixed): bool $handler
         */
        public function assert(callable(mixed): bool $handler, ?string $description = null): self;

        /**
         * @param callable(mixed): mixed $handler
         */
        public function before(callable(mixed): mixed $handler): self;

        public function castTo(string $type): self;

        public function completeDefault(\Nette\Schema\Context $context): mixed;

        public function default(mixed $value): self;

        public function deprecated(string $message = 'The item %path% is deprecated.'): self;

        public function required(bool $state = true): self;

        /**
         * @param callable(mixed, \Nette\Schema\Context): mixed $handler
         */
        public function transform(callable(mixed, \Nette\Schema\Context): mixed $handler): self;
    }

    // @overlay-against: class Structure implements \Nette\Schema\Schema, \Nette\Schema\Elements\Base
    partial class Structure<T = array<int|string, mixed>> implements \Nette\Schema\Schema<T>;

    // @overlay-against: class Structure implements \Nette\Schema\Schema, \Nette\Schema\Elements\Base
    partial class Structure {
        // @overlay-against: function extend(array|self $shape): self
        public function extend(array<int|string, \Nette\Schema\Schema>|self $shape): self;
    }

    // @overlay-against: class Type implements \Nette\Schema\Schema, \Nette\Schema\Elements\Base
    partial class Type<T = mixed> implements \Nette\Schema\Schema<T>;
}
