<?tyhp

namespace Tyhp;

/**
 * Compile-time PHP version gate. The constructor argument is a Composer version-constraint
 * string evaluated against the project's `output.phpVersion` (for example `">=8.4"` or
 * `">=8.2 <8.4"`). Inactive declarations are omitted at bind time; the attribute and this
 * class declaration are omitted from emitted PHP (`#[\Tyhp\NoEmit]`).
 *
 * Positional `#[\Tyhp\Php(">=8.4")]` and named `#[\Tyhp\Php(version: ">=8.4")]` are equivalent.
 *
 * Illegal on `struct` and `extension` (Tyhp or tyhpdef) — wrap those in `declare(php=…) { }`.
 */

#[\Attribute(\Attribute::TARGET_ALL)]
#[\Tyhp\NoEmit()]
final class Php
{
    public function __construct(
        public readonly string $version,
    ): void {}
}
