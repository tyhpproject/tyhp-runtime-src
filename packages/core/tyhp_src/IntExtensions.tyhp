<?tyhp

namespace Tyhp;

global use extension \Tyhp\IntExtensions;

extension IntExtensions extends int {
    #[\Tyhp\Optimize\Pure]
    fn abs(): int => \abs($this);

    #[\Tyhp\Optimize\Pure]
    fn clamp(int $min, int $max): int => \max($min, \min($max, $this));

    #[\Tyhp\Optimize\Pure]
    fn isEven(): bool => $this % 2 === 0;

    #[\Tyhp\Optimize\Pure]
    fn isOdd(): bool => $this % 2 !== 0;

    #[\Tyhp\Optimize\Pure]
    fn isPositive(): bool => $this > 0;

    #[\Tyhp\Optimize\Pure]
    fn isNegative(): bool => $this < 0;

    #[\Tyhp\Optimize\Pure]
    fn isZero(): bool => $this === 0;

    #[\Tyhp\Optimize\Pure]
    fn between(int $min, int $max): bool => $this >= $min && $this <= $max;

    #[\Tyhp\Optimize\Pure]
    fn sign(): int => $this <=> 0;

    #[\Tyhp\Optimize\Pure]
    fn max(int ...$values): int => \max($this, ...$values);

    #[\Tyhp\Optimize\Pure]
    fn min(int ...$values): int => \min($this, ...$values);

    #[\Tyhp\Optimize\Pure]
    fn pow(int $exponent): int|float => $this ** $exponent;

    #[\Tyhp\Optimize\Pure]
    fn __toString(): string => (string)$this;

    #[\Tyhp\Optimize\Pure]
    fn __toFloat(): float => (float)$this;

    #[\Tyhp\Optimize\Pure]
    fn __toBool(): bool => (bool)$this;

    #[\Tyhp\Optimize\Pure]
    fn toBase(int $base): string => \base_convert((string)$this, 10, $base);

    #[\Tyhp\Optimize\Pure]
    fn toHex(): string => \dechex($this);

    #[\Tyhp\Optimize\Pure]
    fn toOctal(): string => \decoct($this);

    #[\Tyhp\Optimize\Pure]
    fn toBinary(): string => \decbin($this);

    #[\Tyhp\Optimize\Pure]
    fn format(int $decimals = 0, string $decimalSeparator = '.', string $thousandsSeparator = ','): string => \number_format($this, $decimals, $decimalSeparator, $thousandsSeparator);
}
