<?tyhp

namespace Tyhp;

/**
 * Compile-time constraint to not emit the declaration to PHP.  Used for built-in Tyhp attributes that are for compile time only attributes.
 * During emit time, the usage of the target attribute will be removed (after it is processed) and the declaration will not be emitted to PHP.
 *
 * Used to remove `\Tyhp\NoEmit`, `\Tyhp\Php`, and `\Tyhp\PhpType` declarations and usages at compile time (will not appear in the emitted PHP).
 */
#[\Attribute(
    \Attribute::TARGET_CLASS
)]
#[\Tyhp\NoEmit()]
final class NoEmit
{
    public function __construct(): void {}
}
