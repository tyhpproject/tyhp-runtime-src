<?tyhp

namespace Tyhp;

global use extension \Tyhp\StringExtensions;
global use extension \Tyhp\StringExtensionsVersioned;

extension StringExtensions extends string {
    #[\Tyhp\Optimize\Pure]
    fn reverse(): string => \implode('', \array_reverse(\Tyhp\StringHelper::strSplit($this)));

    #[\Tyhp\Optimize\Pure]
    function match(string $pattern, 0 $flags = 0, int $offset = 0): ?\PregMatchSet;
    function match(string $pattern, 256 $flags, int $offset = 0): ?\PregMatchSetOffset;
    function match(string $pattern, 512 $flags, int $offset = 0): ?\PregMatchSetNullable;
    function match(string $pattern, 768 $flags, int $offset = 0): ?\PregMatchSetOffsetNullable;
    function match(
        string $pattern,
        int $flags = 0,
        int $offset = 0
    ): \PregMatchSetNullable|\PregMatchSetOffset|\PregMatchSetOffsetNullable|null {
        \PregMatchSetNullable|\PregMatchSetOffset|\PregMatchSetOffsetNullable $matches = [];
        if (\preg_match($pattern, $this, $matches, $flags, $offset) === 1) {
            return $matches;
        }

        return null;
    }

    #[\Tyhp\Optimize\Pure]
    function matchAll(string $pattern, 0|1 $flags = 0, int $offset = 0): \PregMatchAllSet|false;
    function matchAll(string $pattern, 2 $flags, int $offset = 0): \PregMatchAllList|false;
    function matchAll(string $pattern, 256 $flags, int $offset = 0): \PregOffsetCaptureAllSet|false;
    function matchAll(string $pattern, 512 $flags, int $offset = 0): \PregMatchAllSetNullable|false;
    function matchAll(string $pattern, 768 $flags, int $offset = 0): \PregOffsetCaptureAllSetNullable|false;
    function matchAll(
        string $pattern,
        int $flags = 0,
        int $offset = 0
    ): array<int|string, mixed>|false {
        array<int|string, mixed> $matches = [];
        if (\preg_match_all($pattern, $this, $matches, $flags, $offset) === false) {
            return false;
        }

        return $matches;
    }

    #[\Tyhp\Optimize\Pure]
    fn length(): int => \Tyhp\StringHelper::strlen($this);

    #[\Tyhp\Optimize\Pure]
    fn byteLength(): int => \strlen($this);

    #[\Tyhp\Optimize\Pure]
    fn isEmpty(): bool => $this === '';

    #[\Tyhp\Optimize\Pure]
    fn isNotEmpty(): bool => $this !== '';

    #[\Tyhp\Optimize\Pure]
    fn contains(string $needle): bool => \str_contains($this, $needle);

    #[\Tyhp\Optimize\Pure]
    fn containsIgnoreCase(string $needle): bool => \Tyhp\StringHelper::stripos($this, $needle) !== false;

    #[\Tyhp\Optimize\Pure]
    fn startsWith(string $prefix): bool => \str_starts_with($this, $prefix);

    #[\Tyhp\Optimize\Pure]
    fn endsWith(string $suffix): bool => \str_ends_with($this, $suffix);

    #[\Tyhp\Optimize\Pure]
    fn indexOf(string $needle, int $offset = 0): int|false => \Tyhp\StringHelper::strpos($this, $needle, $offset);

    #[\Tyhp\Optimize\Pure]
    fn lastIndexOf(string $needle, int $offset = 0): int|false => \Tyhp\StringHelper::strrpos($this, $needle, $offset);

    #[\Tyhp\Optimize\Pure]
    fn indexOfIgnoreCase(string $needle, int $offset = 0): int|false => \Tyhp\StringHelper::stripos($this, $needle, $offset);

    #[\Tyhp\Optimize\Pure]
    fn substring(int $start, ?int $length = null): string => \Tyhp\StringHelper::substr($this, $start, $length);

    #[\Tyhp\Optimize\Pure]
    fn charAt(int $index): string => \Tyhp\StringHelper::substr($this, $index, 1);

    #[\Tyhp\Optimize\Pure]
    fn first(int $length = 1): string => \Tyhp\StringHelper::substr($this, 0, $length);

    #[\Tyhp\Optimize\Pure]
    fn last(int $length = 1): string => \Tyhp\StringHelper::substr($this, -$length);

    #[\Tyhp\Optimize\Pure]
    fn chunk(int $length = 1): array<int, string> => \Tyhp\StringHelper::strSplit($this, $length);

    #[\Tyhp\Optimize\Pure]
    fn toLower(): string => \Tyhp\StringHelper::strtolower($this);

    #[\Tyhp\Optimize\Pure]
    fn toUpper(): string => \Tyhp\StringHelper::strtoupper($this);

    #[\Tyhp\Optimize\Pure]
    fn ucWords(): string => \Tyhp\StringHelper::ucWords($this);

    #[\Tyhp\Optimize\Pure]
    fn trim(string $characters = " \t\n\r\0\x0B"): string => \trim($this, $characters);

    #[\Tyhp\Optimize\Pure]
    fn trimLeft(string $characters = " \t\n\r\0\x0B"): string => \ltrim($this, $characters);

    #[\Tyhp\Optimize\Pure]
    fn trimRight(string $characters = " \t\n\r\0\x0B"): string => \rtrim($this, $characters);

    #[\Tyhp\Optimize\Pure]
    fn replace(
        string|array<int|string, string> $search,
        string|array<int|string, string> $replace
    ): string => \str_replace($search, $replace, $this);

    #[\Tyhp\Optimize\Pure]
    fn replaceIgnoreCase(
        string|array<int|string, string> $search,
        string|array<int|string, string> $replace
    ): string => \str_ireplace($search, $replace, $this);

    #[\Tyhp\Optimize\Pure]
    fn regexReplace(string $pattern, string $replacement): string|null => \preg_replace($pattern, $replacement, $this);

    #[\Tyhp\Optimize\Pure]
    fn split(string $delimiter, int $limit = \PHP_INT_MAX): array<int, string> => \explode($delimiter, $this, $limit);

    #[\Tyhp\Optimize\Pure]
    function regexSplit(string $pattern, int $limit = -1, 0|1|2|3 $flags = 0): array<int, string>|false;
    function regexSplit(string $pattern, int $limit, 4|5|6|7 $flags): array<int, \PregOffsetCapture>|false;
    fn regexSplit(string $pattern, int $limit = -1, int $flags = 0): array<int, string>|array<int, \PregOffsetCapture>|false => \preg_split($pattern, $this, $limit, $flags);

    #[\Tyhp\Optimize\Pure]
    fn repeat(int $times): string => \str_repeat($this, $times);

    #[\Tyhp\Optimize\Pure]
    fn byteReverse(): string => \strrev($this);

    #[\Tyhp\Optimize\Pure]
    fn wordWrap(int $width = 75, string $break = "\n", bool $cutLongWords = false): string => \wordwrap($this, $width, $break, $cutLongWords);

    #[\Tyhp\Optimize\Pure]
    function wordCount(0 $format = 0, ?string $characters = null): int;
    function wordCount(1 $format, ?string $characters = null): array<int, string>;
    function wordCount(2 $format, ?string $characters = null): array<int, string>;
    fn wordCount(int $format = 0, ?string $characters = null): array<int, string>|int => \str_word_count($this, $format, $characters);

    #[\Tyhp\Optimize\Pure]
    fn format(mixed ...$args): string => \sprintf($this, ...$args);

    #[\Tyhp\Optimize\Pure]
    fn base64Encode(): string => \base64_encode($this);

    #[\Tyhp\Optimize\Pure]
    fn base64Decode(bool $strict = false): string|false => \base64_decode($this, $strict);

    #[\Tyhp\Optimize\Pure]
    fn urlEncode(): string => \urlencode($this);

    #[\Tyhp\Optimize\Pure]
    fn urlDecode(): string => \urldecode($this);

    #[\Tyhp\Optimize\Pure]
    fn rawUrlEncode(): string => \rawurlencode($this);

    #[\Tyhp\Optimize\Pure]
    fn rawUrlDecode(): string => \rawurldecode($this);

    #[\Tyhp\Optimize\Pure]
    fn htmlEncode(int $flags = \ENT_QUOTES | \ENT_SUBSTITUTE | \ENT_HTML401, bool $doubleEncode = true): string => \htmlspecialchars($this, $flags, null, $doubleEncode);

    #[\Tyhp\Optimize\Pure]
    fn htmlDecode(int $flags = \ENT_QUOTES | \ENT_SUBSTITUTE | \ENT_HTML401): string => \htmlspecialchars_decode($this, $flags);

    #[\Tyhp\Optimize\Pure]
    fn htmlEntities(int $flags = \ENT_QUOTES | \ENT_SUBSTITUTE | \ENT_HTML401, bool $doubleEncode = true): string => \htmlentities($this, $flags, null, $doubleEncode);

    #[\Tyhp\Optimize\Pure]
    fn nl2Br(bool $useXhtml = true): string => \nl2br($this, $useXhtml);

    #[\Tyhp\Optimize\Pure]
    fn stripTags(array<int|string, string>|string|null $allowedTags = null): string => \strip_tags($this, $allowedTags);

    #[\Tyhp\Optimize\Pure]
    fn md5(bool $binary = false): string => \md5($this, $binary);

    #[\Tyhp\Optimize\Pure]
    fn sha1(bool $binary = false): string => \sha1($this, $binary);

    #[\Tyhp\Optimize\Pure]
    fn hash(string $algorithm, bool $binary = false): string => \hash($algorithm, $this, $binary);

    #[\Tyhp\Optimize\Pure]
    fn crc32(): int => \crc32($this);

    #[\Tyhp\Optimize\Pure]
    fn __toInt(): int => \intval($this);

    #[\Tyhp\Optimize\Pure]
    fn __toFloat(): float => \floatval($this);

    #[\Tyhp\Optimize\Pure]
    fn __toBool(): bool => (bool)$this;

    #[\Tyhp\Optimize\Pure]
    fn isNumeric(): bool => \is_numeric($this);

    #[\Tyhp\Optimize\Pure]
    fn matches(string $pattern): bool => \preg_match($pattern, $this) === 1;

    #[\Tyhp\Optimize\Pure]
    fn regexQuote(string $delimiter = '/'): string => \preg_quote($this, $delimiter);

    #[\Tyhp\Optimize\Pure]
    fn convertEncoding(string $toEncoding, array|string|null $fromEncoding = null): string|false => \Tyhp\StringHelper::convertEncoding($this, $toEncoding, $fromEncoding);

    #[\Tyhp\Optimize\Pure]
    fn detectEncoding(): string|false => \Tyhp\StringHelper::detectEncoding($this);

    #[\Tyhp\Optimize\Pure]
    fn ord(): int|false => \Tyhp\StringHelper::ord($this);

    #[\Tyhp\Optimize\Pure]
    function jsonDecode(
        bool $associative = true,
        int $depth = 512,
        int $flags = 0
    ): \JsonAssoc|\JsonObject|null {
        return \json_decode($this, $associative, $depth, $flags);
    }

    #[\Tyhp\Optimize\Pure]
    function jsonDecodeAs<T extends struct>(int $depth = 512, int $flags = 0): T
    {
        return Json::decode<T>($this, $depth, $flags);
    }

    function jsonTryDecodeAs<T extends struct>(T &$out, int $depth = 512, int $flags = 0): bool
    {
        return Json::tryDecode<T>($this, $out, $depth, $flags);
    }
}

declare(php="<8.3") {
    extension StringExtensionsVersioned extends string {
        #[\Tyhp\Optimize\Pure]
        fn pad(int $length, string $padString = ' ', int $padType = \STR_PAD_RIGHT): string => \str_pad($this, $length, $padString, $padType);

        #[\Tyhp\Optimize\Pure]
        fn padLeft(int $length, string $padString = ' '): string => \str_pad($this, $length, $padString, \STR_PAD_LEFT);

        #[\Tyhp\Optimize\Pure]
        fn padRight(int $length, string $padString = ' '): string => \str_pad($this, $length, $padString, \STR_PAD_RIGHT);

        #[\Tyhp\Optimize\Pure]
        fn ucFirst(): string => \Tyhp\StringHelper::strtoupper(\Tyhp\StringHelper::substr($this, 0, 1)) . \Tyhp\StringHelper::substr($this, 1);

        #[\Tyhp\Optimize\Pure]
        fn lcFirst(): string => \Tyhp\StringHelper::strtolower(\Tyhp\StringHelper::substr($this, 0, 1)) . \Tyhp\StringHelper::substr($this, 1);
    }
}

declare(php=">=8.3 <8.4") {
    extension StringExtensionsVersioned extends string {
        #[\Tyhp\Optimize\Pure]
        fn pad(int $length, string $padString = ' ', int $padType = \STR_PAD_RIGHT): string => \Tyhp\StringHelper::strPad($this, $length, $padString, $padType);

        #[\Tyhp\Optimize\Pure]
        fn padLeft(int $length, string $padString = ' '): string => \Tyhp\StringHelper::strPad($this, $length, $padString, \STR_PAD_LEFT);

        #[\Tyhp\Optimize\Pure]
        fn padRight(int $length, string $padString = ' '): string => \Tyhp\StringHelper::strPad($this, $length, $padString, \STR_PAD_RIGHT);

        #[\Tyhp\Optimize\Pure]
        fn ucFirst(): string => \Tyhp\StringHelper::strtoupper(\Tyhp\StringHelper::substr($this, 0, 1)) . \Tyhp\StringHelper::substr($this, 1);

        #[\Tyhp\Optimize\Pure]
        fn lcFirst(): string => \Tyhp\StringHelper::strtolower(\Tyhp\StringHelper::substr($this, 0, 1)) . \Tyhp\StringHelper::substr($this, 1);
    }
}

declare(php=">=8.4") {
    extension StringExtensionsVersioned extends string {
        #[\Tyhp\Optimize\Pure]
        fn pad(int $length, string $padString = ' ', int $padType = \STR_PAD_RIGHT): string => \Tyhp\StringHelper::strPad($this, $length, $padString, $padType);

        #[\Tyhp\Optimize\Pure]
        fn padLeft(int $length, string $padString = ' '): string => \Tyhp\StringHelper::strPad($this, $length, $padString, \STR_PAD_LEFT);

        #[\Tyhp\Optimize\Pure]
        fn padRight(int $length, string $padString = ' '): string => \Tyhp\StringHelper::strPad($this, $length, $padString, \STR_PAD_RIGHT);

        #[\Tyhp\Optimize\Pure]
        fn ucFirst(): string => \Tyhp\StringHelper::ucFirst($this);

        #[\Tyhp\Optimize\Pure]
        fn lcFirst(): string => \Tyhp\StringHelper::lcFirst($this);
    }
}