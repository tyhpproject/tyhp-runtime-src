<?tyhp

namespace Tyhp;

/**
 * Compile-time opt-out from Mechanism C property tracking.
 *
 * On a property or promoted constructor parameter, that slot does not trigger or
 * receive set checks / `setPropertyType`. On a class, the same applies to every
 * generic-typed instance property on that class after trait flatten (including
 * promoted properties). Runtime-use constructs (`typeof`, `default`, `is`,
 * `new T`, forwarded type arguments) still force class tracking.
 *
 * Usages of this attribute and this class declaration are omitted from emitted PHP
 * (`#[\Tyhp\NoEmit]`).
 */
#[\Attribute(\Attribute::TARGET_CLASS | \Attribute::TARGET_PROPERTY | \Attribute::TARGET_PARAMETER)]
#[\Tyhp\NoEmit()]
final class EraseGeneric
{
    public function __construct(): void {}
}
