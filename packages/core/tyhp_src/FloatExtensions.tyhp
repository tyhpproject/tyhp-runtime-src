<?tyhp

namespace Tyhp;

global use extension \Tyhp\FloatExtensions;

extension FloatExtensions extends float {
    #[\Tyhp\Optimize\Pure]
    fn abs(): float => \abs($this);

    #[\Tyhp\Optimize\Pure]
    fn ceil(): int => (int)\ceil($this);

    #[\Tyhp\Optimize\Pure]
    fn floor(): int => (int)\floor($this);

    #[\Tyhp\Optimize\Pure]
    fn round(int $precision = 0, int $mode = \PHP_ROUND_HALF_UP): float => \round($this, $precision, $mode);

    #[\Tyhp\Optimize\Pure]
    fn clamp(float $min, float $max): float => \max($min, \min($max, $this));

    #[\Tyhp\Optimize\Pure]
    fn isNan(): bool => \is_nan($this);

    #[\Tyhp\Optimize\Pure]
    fn isInfinite(): bool => \is_infinite($this);

    #[\Tyhp\Optimize\Pure]
    fn isFinite(): bool => \is_finite($this);

    #[\Tyhp\Optimize\Pure]
    fn isPositive(): bool => $this > 0.0;

    #[\Tyhp\Optimize\Pure]
    fn isNegative(): bool => $this < 0.0;

    #[\Tyhp\Optimize\Pure]
    fn isZero(): bool => $this == 0.0;

    #[\Tyhp\Optimize\Pure]
    fn between(float $min, float $max): bool => $this >= $min && $this <= $max;

    #[\Tyhp\Optimize\Pure]
    fn sign(): int => $this <=> 0.0;

    #[\Tyhp\Optimize\Pure]
    fn max(float $value, float ...$values): float => \max($this, $value, ...$values);

    #[\Tyhp\Optimize\Pure]
    fn min(float $value, float ...$values): float => \min($this, $value, ...$values);

    #[\Tyhp\Optimize\Pure]
    fn pow(float $exponent): float => $this ** $exponent;

    #[\Tyhp\Optimize\Pure]
    fn sqrt(): float => \sqrt($this);

    #[\Tyhp\Optimize\Pure]
    fn log(float $base = \M_E): float => \log($this, $base);

    #[\Tyhp\Optimize\Pure]
    fn sin(): float => \sin($this);

    #[\Tyhp\Optimize\Pure]
    fn cos(): float => \cos($this);

    #[\Tyhp\Optimize\Pure]
    fn tan(): float => \tan($this);

    #[\Tyhp\Optimize\Pure]
    fn fmod(float $divisor): float => \fmod($this, $divisor);

    #[\Tyhp\Optimize\Pure]
    fn __toString(): string => (string)$this;

    #[\Tyhp\Optimize\Pure]
    fn __toInt(): int => (int)$this;

    #[\Tyhp\Optimize\Pure]
    fn __toBool(): bool => (bool)$this;

    #[\Tyhp\Optimize\Pure]
    fn format(int $decimals = 0, string $decimalSeparator = '.', string $thousandsSeparator = ','): string => \number_format($this, $decimals, $decimalSeparator, $thousandsSeparator);
}
