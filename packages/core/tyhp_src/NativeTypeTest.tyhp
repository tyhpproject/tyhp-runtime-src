<?tyhp

namespace Tyhp;

/**
 * Compile-time marker on a free function or concrete static method with a
 * type-guard return (`$param is T`). `$x is T` / `$x instanceof T` emit a call
 * to that callable (`\is_string($x)` or `\Foo::isString($x)`) instead of
 * `\Tyhp\Type::is`. `T` is the guard type, not an attribute argument.
 *
 * Usages of this attribute and this class declaration are omitted from emitted PHP
 * (`#[\Tyhp\NoEmit]`).
 */
#[\Attribute(\Attribute::TARGET_METHOD | \Attribute::TARGET_FUNCTION)]
#[\Tyhp\NoEmit()]
final class NativeTypeTest
{
    public function __construct(): void {}
}
