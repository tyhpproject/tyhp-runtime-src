<?tyhp

namespace Tyhp;

global use extension \Tyhp\BoolExtensions;

extension BoolExtensions extends bool {
    #[\Tyhp\Optimize\Pure]
    fn __toString(): string => $this ? 'true' : 'false';

    #[\Tyhp\Optimize\Pure]
    fn __toInt(): int => (int)$this;

    #[\Tyhp\Optimize\Pure]
    fn not(): bool => !$this;

    #[\Tyhp\Optimize\Pure]
    fn and(bool $other): bool => $this && $other;

    #[\Tyhp\Optimize\Pure]
    fn or(bool $other): bool => $this || $other;
}
