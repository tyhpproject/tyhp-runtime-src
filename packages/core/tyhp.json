{
    "quiet": false,
    "locale": "en-US",
    "type": "library",
    "suppressWarnings": [
        "TYHP8027"
    ],
    "include": [
        "./tyhp_src/**/*.tyhp"
    ],
    "exclude": [],
    "output": {
        "path": "../dist/tyhp-core/{phpVersion.id}.{version.major}.{version.minor}/src",
        "phpVersion": "8.2"
    },
    "build": {
        "generateSourcemap": true,
        "sourcemapIncludeContent": false
    }
}
