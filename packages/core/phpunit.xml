<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="core-composer-plugin">
            <directory>tests/Composer</directory>
            <exclude>tests/Composer/stubs</exclude>
        </testsuite>
        <testsuite name="core-runtime">
            <file>tests/StringHelperTest.php</file>
            <file>tests/TypeTest.php</file>
            <file>tests/GenericTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
