namespace BcMath {
    declare(php=">=8.4") {
        /**
         * Overlay: `Number::divmod()` `[quotient, remainder]` pair.
         */
        type NumberDivMod = struct {
            Number 0 as $quotient;
            Number 1 as $remainder;
        };
    }

    #[\Tyhp\Php(">=8.4")]
    // @overlay-against: class Number implements \Stringable
    partial class Number {
        // @overlay-against: function compare(\BcMath\Number|string|int $num, ?int $scale): int
        public function compare(\BcMath\Number|string|int $num, ?int $scale = null): -1|0|1;

        // @overlay-against: function divmod(\BcMath\Number|string|int $num, ?int $scale): array
        public function divmod(\BcMath\Number|string|int $num, ?int $scale = null): NumberDivMod;

        operator +(self $value): self;
        operator -(self $value): self;
        operator ++(self $value): self;
        operator --(self $value): self;

        operator *(self $left, self|string|int $right): self;
        operator /(self $left, self|string|int $right): self;
        operator %(self $left, self|string|int $right): self;
        operator +(self $left, self|string|int $right): self;
        operator -(self $left, self|string|int $right): self;
        operator **(self $left, self|string|int $right): self;

        operator <=>(self $left, self|string|int $right): -1|0|1;
        operator <(self $left, self|string|int $right): bool;
        operator <=(self $left, self|string|int $right): bool;
        operator >(self $left, self|string|int $right): bool;
        operator >=(self $left, self|string|int $right): bool;
        operator ==(self $left, self|string|int $right): bool;
        operator !=(self $left, self|string|int $right): bool;

        operator convert(int $value): self;
        operator convert(string $value): self;
        operator convert(self $value): string;
        operator convert(self $value): bool;
    }
}

/**
 * Overlay: `bcdivmod()` `[quotient, remainder]` pair of numeric strings.
 */
type BcDivMod = struct {
    string 0 as $quotient;
    string 1 as $remainder;
};

// @overlay-against: function bccomp(string $num1, string $num2, ?int $scale): int
function bccomp(string $num1, string $num2, ?int $scale = null): -1|0|1;

declare(php=">=8.4") {
    // @overlay-against: function bcdivmod(string $num1, string $num2, ?int $scale): array
    function bcdivmod(string $num1, string $num2, ?int $scale = null): BcDivMod;
}
