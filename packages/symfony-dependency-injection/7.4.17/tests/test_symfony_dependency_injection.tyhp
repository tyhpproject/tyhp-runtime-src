<?tyhp

function test_di_register_and_has(): bool
{
    $container = new \Symfony\Component\DependencyInjection\ContainerBuilder();
    $container->register('std', \stdClass::class);
    return $container->has('std');
}

function test_di_set_and_get(): ?object
{
    $container = new \Symfony\Component\DependencyInjection\ContainerBuilder();
    $container->set('std', new \stdClass());
    return $container->get('std');
}

function test_di_definition_class(): ?string
{
    $definition = new \Symfony\Component\DependencyInjection\Definition();
    $definition->setClass(\stdClass::class);
    return $definition->getClass();
}
