<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * MatcherAssert::assertThat is a 1–3 argument API in the PHP source (`func_get_args`).
 * Description implementors use the Description signatures.
 * Instance-of matchers take a class name.
 */

namespace Hamcrest {
    /**
     * Overlay: Description append signatures.
     */
    // @overlay-against: class BaseDescription implements \Hamcrest\Description
    partial class BaseDescription {
        // @overlay-against: function appendDescriptionOf(\Hamcrest\SelfDescribing $value): mixed
        public function appendDescriptionOf(\Hamcrest\SelfDescribing $value): static;

        // @overlay-against: function appendList(string $start, string $separator, string $end, iterable $values): self
        public function appendList(string $start, string $separator, string $end, iterable<\Hamcrest\SelfDescribing> $values): self;

        // @overlay-against: function appendValueList(string $start, string $separator, string $end, iterable $values): self
        public function appendValueList(string $start, string $separator, string $end, iterable<mixed> $values): self;
    }

    /**
     * Overlay: assertThat arities from MatcherAssert.php.
     */
    // @overlay-against: class MatcherAssert
    partial class MatcherAssert {
        /**
         * Boolean expression form.
         */
        // @overlay-against: function assertThat(): void
        public static function assertThat(mixed $expression): void;

        /**
         * Value plus matcher.
         */
        // @overlay-against: function assertThat(): void
        public static function assertThat(mixed $actual, \Hamcrest\Matcher $matcher): void;

        /**
         * Identifier plus boolean expression.
         */
        // @overlay-against: function assertThat(): void
        public static function assertThat(mixed $identifier, mixed $expression): void;

        /**
         * Identifier, actual value, and matcher or value wrapped with IsEqual.
         */
        // @overlay-against: function assertThat(): void
        public static function assertThat(mixed $identifier, mixed $actual, mixed $matcherOrValue): void;
    }

    /**
     * Overlay: instance-of factories take a class name.
     */
    // @overlay-against: class Matchers
    partial class Matchers {
        // @overlay-against: function anInstanceOf(string $theClass): \Hamcrest\Core\IsInstanceOf
        public static function anInstanceOf(__ClassName $theClass): \Hamcrest\Core\IsInstanceOf;

        // @overlay-against: function any(string $theClass): \Hamcrest\Core\IsInstanceOf
        public static function any(__ClassName $theClass): \Hamcrest\Core\IsInstanceOf;
    }

    /**
     * Overlay: Description list signatures.
     */
    // @overlay-against: class NullDescription implements \Hamcrest\Description
    partial class NullDescription {
        // @overlay-against: function appendList(string $start, string $separator, string $end, mixed $values): self
        public function appendList(string $start, string $separator, string $end, iterable<\Hamcrest\SelfDescribing> $values): self;

        // @overlay-against: function appendValueList(string $start, string $separator, string $end, mixed $values): self
        public function appendValueList(string $start, string $separator, string $end, iterable<mixed> $values): self;
    }

    // @overlay-against: class Matchers
    partial class Matchers {
        // @overlay-against: function is(mixed $value): \Hamcrest\Core\Is
        public static function is(mixed $value): \Hamcrest\Core\HamcrestCoreIs;
    }
}

namespace Hamcrest\Arrays {
    /**
     * Overlay: `featureValueOf` returns `count($array)`.
     */
    // @overlay-against: class IsArrayWithSize extends \Hamcrest\FeatureMatcher
    partial class IsArrayWithSize {
        // @overlay-against: function featureValueOf(mixed $array): mixed
        protected function featureValueOf(mixed $array): int;
    }
}

namespace Hamcrest\Collection {
    /**
     * Overlay: `featureValueOf` counts the traversable and returns that int.
     */
    // @overlay-against: class IsTraversableWithSize extends \Hamcrest\FeatureMatcher
    partial class IsTraversableWithSize {
        // @overlay-against: function featureValueOf(mixed $actual): mixed
        protected function featureValueOf(mixed $actual): int;
    }
}

namespace Hamcrest\Core {
    /**
     * Overlay: instance-of checks take a class name.
     */
    // @overlay-against: class IsInstanceOf extends \Hamcrest\DiagnosingMatcher
    partial class IsInstanceOf {
        // @overlay-against: function anInstanceOf(string $theClass): self
        public static function anInstanceOf(__ClassName $theClass): self;

        // @overlay-against: function __construct(string $theClass): void
        public function __construct(__ClassName $theClass): void;
    }

    // PHP class `Hamcrest\Core\Is`. The Tyhp name cannot be `Is`.
    // @overlay-against: class Is extends \Hamcrest\BaseMatcher
    partial class \Hamcrest\Core\Is as HamcrestCoreIs;
}
