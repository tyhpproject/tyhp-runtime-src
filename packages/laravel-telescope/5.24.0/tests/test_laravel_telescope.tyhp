<?tyhp

function test_telescope_incoming_entry(): \Laravel\Telescope\IncomingEntry
{
    return new \Laravel\Telescope\IncomingEntry(['uri' => '/']);
}

function test_telescope_incoming_entry_type(): \Laravel\Telescope\IncomingEntry
{
    return (new \Laravel\Telescope\IncomingEntry(['uri' => '/']))->type(\Laravel\Telescope\EntryType::REQUEST);
}

function test_telescope_entry_types(): array
{
    return \Laravel\Telescope\EntryType::all();
}

function test_telescope_cache_watcher(): \Laravel\Telescope\Watchers\CacheWatcher
{
    return new \Laravel\Telescope\Watchers\CacheWatcher([]);
}

function test_telescope_is_recording(): bool
{
    return \Laravel\Telescope\Telescope::isRecording();
}

function test_telescope_entry_model_factory(): \Laravel\Telescope\Database\Factories\EntryModelFactory
{
    return new \Laravel\Telescope\Database\Factories\EntryModelFactory();
}
