<?tyhp

function test_serializer_serialize(\Symfony\Component\Serializer\SerializerInterface $serializer): string
{
    return $serializer->serialize(['name' => 'Ada'], 'json');
}

function test_serializer_deserialize(\Symfony\Component\Serializer\SerializerInterface $serializer): mixed
{
    return $serializer->deserialize('{"name":"Ada"}', 'array', 'json');
}
