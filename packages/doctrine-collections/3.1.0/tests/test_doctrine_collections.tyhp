<?tyhp

function test_array_collection_new(): \Doctrine\Common\Collections\ArrayCollection<int|string, string>
{
    return new \Doctrine\Common\Collections\ArrayCollection<int|string, string>(['a', 'b']);
}

function test_array_collection_add(\Doctrine\Common\Collections\ArrayCollection<int|string, string> $c): void
{
    $c->add('c');
}

function test_array_collection_to_array(\Doctrine\Common\Collections\ArrayCollection<int|string, string> $c): array<int|string, string>
{
    return $c->toArray();
}

function test_criteria_order(): \Doctrine\Common\Collections\Criteria
{
    return \Doctrine\Common\Collections\Criteria::create()->orderBy([
        'name' => \Doctrine\Common\Collections\Order::Ascending,
    ]);
}

function test_collection_contains(\Doctrine\Common\Collections\Collection<int, string> $c): bool
{
    return $c->contains('a');
}
