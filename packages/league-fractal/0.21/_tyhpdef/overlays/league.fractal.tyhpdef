namespace League\Fractal\Serializer {
    /**
     * `ArraySerializer::cursor()` returns this under `cursor`.
     */
    type ArraySerializerCursorBody = struct {
        mixed $current;
        mixed $prev;
        mixed $next;
        int|null $count;
    };

    /**
     * `ArraySerializer::cursor()` return value.
     */
    type ArraySerializerCursorResult = struct {
        ArraySerializerCursorBody $cursor;
    };

    /**
     * `ArraySerializer::paginator()` page block. Empty `links` is cast to an object.
     */
    type ArraySerializerPagination = struct {
        int $total;
        int $count;
        int $per_page;
        int $current_page;
        int $total_pages;
        array<string, string>|object $links;
    };

    /**
     * `ArraySerializer::paginator()` return value.
     */
    type ArraySerializerPaginatorResult = struct {
        ArraySerializerPagination $pagination;
    };

    /**
     * `DataArraySerializer` wraps the payload under `data`.
     */
    type DataArraySerializerResult = struct {
        array<int|string, mixed> $data;
    };

    // @overlay-against: class ArraySerializer extends \League\Fractal\Serializer\SerializerAbstract
    partial class ArraySerializer {
        /**
         * Overlay: `collection()` keys the payload by the resource key or `data`.
         */
        // @overlay-against: function collection(?string $resourceKey, array $data): array
        public function collection(?string $resourceKey, array<int|string, mixed> $data): array<string, array<int|string, mixed>>;

        /**
         * Overlay: `cursor()` returns `current`, `prev`, `next`, and `count`.
         */
        // @overlay-against: function cursor(\League\Fractal\Pagination\CursorInterface $cursor): array
        public function cursor(\League\Fractal\Pagination\CursorInterface $cursor): ArraySerializerCursorResult;

        /**
         * Overlay: `paginator()` returns the pagination block, with `links` as an object when empty.
         */
        // @overlay-against: function paginator(\League\Fractal\Pagination\PaginatorInterface $paginator): array
        public function paginator(\League\Fractal\Pagination\PaginatorInterface $paginator): ArraySerializerPaginatorResult;
    }

    // @overlay-against: class DataArraySerializer extends \League\Fractal\Serializer\ArraySerializer
    partial class DataArraySerializer {
        /**
         * Overlay: `collection()` returns `['data' => $data]`.
         */
        // @overlay-against: function collection(?string $resourceKey, array $data): array
        public function collection(?string $resourceKey, array<int|string, mixed> $data): DataArraySerializerResult;

        /**
         * Overlay: `item()` returns `['data' => $data]`.
         */
        // @overlay-against: function item(?string $resourceKey, array $data): array
        public function item(?string $resourceKey, array<int|string, mixed> $data): DataArraySerializerResult;

        /**
         * Overlay: `null()` returns `['data' => []]`.
         */
        // @overlay-against: function null(): ?array
        public function null(): DataArraySerializerResult;
    }

    // @overlay-against: class JsonApiSerializer extends \League\Fractal\Serializer\ArraySerializer
    partial class JsonApiSerializer {
        /**
         * Overlay: `getMandatoryFields()` returns `['id']`.
         */
        // @overlay-against: function getMandatoryFields(): array
        public function getMandatoryFields(): array<int, string>;
    }

    // @overlay-against: interface Serializer
    partial interface Serializer {
        /**
         * Overlay: mandatory fields are a list of field names.
         */
        // @overlay-against: function getMandatoryFields(): array
        public function getMandatoryFields(): array<int, string>;
    }

    // @overlay-against: class SerializerAbstract implements \League\Fractal\Serializer\Serializer
    partial class SerializerAbstract {
        /**
         * Overlay: `getMandatoryFields()` returns a list of field names.
         */
        // @overlay-against: function getMandatoryFields(): array
        public function getMandatoryFields(): array<int, string>;
    }
}

