<?tyhp

function test_encrypter_construct(): \Illuminate\Encryption\Encrypter
{
    return new \Illuminate\Encryption\Encrypter(str_repeat('a', 32), 'aes-256-cbc');
}

function test_encrypter_supported(): bool
{
    return \Illuminate\Encryption\Encrypter::supported(str_repeat('a', 32), 'aes-256-cbc');
}
