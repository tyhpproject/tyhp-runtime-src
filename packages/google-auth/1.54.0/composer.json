{
    "name": "tyhpdef/google-auth",
    "description": "Tyhp type definitions for the Composer package google/auth (1.54.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.54.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-cache": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/psr-http-message": "@dev",
                "tyhpdef/guzzlehttp-guzzle": "@dev",
                "tyhpdef/guzzlehttp-psr7": "@dev",
                "tyhpdef/guzzlehttp-promises": "@dev",
                "tyhpdef/firebase-php-jwt": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "google/auth": "1.54.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-cache": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/guzzlehttp-guzzle": "@dev",
        "tyhpdef/guzzlehttp-psr7": "@dev",
        "tyhpdef/guzzlehttp-promises": "@dev",
        "tyhpdef/firebase-php-jwt": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../psr-cache/3.0.0"
        },
        {
            "type": "path",
            "url": "../../psr-log/3.0.2"
        },
        {
            "type": "path",
            "url": "../../psr-http-message/2.0"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-guzzle/8.2.0"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-psr7/3.1.0"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-promises/3.0.2"
        },
        {
            "type": "path",
            "url": "../../firebase-php-jwt/7.1.1"
        }
    ]
}
