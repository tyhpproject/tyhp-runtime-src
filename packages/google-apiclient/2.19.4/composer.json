{
    "name": "tyhpdef/google-apiclient",
    "description": "Tyhp type definitions for the Composer package google/apiclient (2.19.4).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.19.4.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
