<?tyhp

function test_psr_container_has(\Psr\Container\ContainerInterface $container, string $id): bool
{
    return $container->has($id);
}

function test_psr_container_get_mixed(\Psr\Container\ContainerInterface $container, string $id): mixed
{
    return $container->get($id);
}

function test_psr_container_get_class_string(\Psr\Container\ContainerInterface $container): \stdClass
{
    return $container->get(\stdClass::class);
}

function test_psr_container_get_generic_string(\Psr\Container\ContainerInterface $container): string
{
    return $container->get<string>('app.name');
}

function test_psr_container_not_found_is_container_exception(\Psr\Container\NotFoundExceptionInterface $e): \Psr\Container\ContainerExceptionInterface
{
    return $e;
}
