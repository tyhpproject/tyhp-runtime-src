<?tyhp

namespace OverlayTests\SymfonyFrameworkBundleFail;

class FailController extends \Symfony\Bundle\FrameworkBundle\Controller\AbstractController
{
    public function redirectPublic(mixed $route): \Symfony\Component\HttpFoundation\RedirectResponse
    {
        return $this->redirectToRoute($route);
    }
}

function redirect_route_must_be_string(FailController $controller): \Symfony\Component\HttpFoundation\RedirectResponse
{
    return $controller->redirectPublic(123);
}
