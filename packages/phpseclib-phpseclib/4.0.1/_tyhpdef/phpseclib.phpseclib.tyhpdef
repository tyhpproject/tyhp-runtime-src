        *    |                                                 // decrypt the content of the $in variable   |
        *    |                 $ciphertext .= $in;                                                          |
        *    |             }                                                                                |
        *    |             return $ciphertext;                                                              |
        *    |     }                                                                                        |
        *    | }                                                                                            |
