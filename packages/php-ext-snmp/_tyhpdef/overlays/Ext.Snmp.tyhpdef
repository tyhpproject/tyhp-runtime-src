 * Overlay: several OIDs — map of values, or false on error.
 */
// @overlay-against: function snmp2_get(string $hostname, string $community, array|string $object_id, int $timeout, int $retries): mixed
function snmp2_get(string $hostname, string $community, array<int, string> $object_id, int $timeout = -1, int $retries = -1): array<string, mixed>|false;

