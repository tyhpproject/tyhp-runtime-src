/**
 * Overlay: `SNMP::$info` remote-agent tuple `[address, port, timeout, retries]`.
 */
type SnmpAgentInfo = struct {
    string 0 as $address;
    int 1 as $port;
    int 2 as $timeout;
    int 3 as $retries;
};

/**
 * Overlay: one OID — a single value (string / typed object depending on valueretrieval).
 */
