{
    "name": "tyhpdef/symfony-security-core",
    "description": "Tyhp type definitions for the Composer package symfony/security-core (7.4.18).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.4.18.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
                "tyhpdef/symfony-password-hasher": "@dev",
                "tyhpdef/symfony-expression-language": "@dev",
                "tyhpdef/psr-event-dispatcher": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/security-core": "7.4.18"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
        "tyhpdef/symfony-password-hasher": "@dev",
        "tyhpdef/symfony-expression-language": "@dev",
        "tyhpdef/psr-event-dispatcher": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../symfony-event-dispatcher-contracts/3.7.1"
        },
        {
            "type": "path",
            "url": "../../symfony-service-contracts/3.7.3"
        },
        {
            "type": "path",
            "url": "../../symfony-password-hasher/7.4.8"
        },
        {
            "type": "path",
            "url": "../../symfony-expression-language/7.4.18"
        },
        {
            "type": "path",
            "url": "../../psr-event-dispatcher/1.0.0"
        }
    ]
}
