namespace Symfony\Component\Security\Core\Authentication\Token {
    /**
     * AbstractToken::__serialize returns the user, a fixed authenticated flag, cleared credentials, attributes, and role names.
     */
    type AbstractTokenState = struct {
        ?\Symfony\Component\Security\Core\User\UserInterface 0 as $user;
        true 1 as $authenticated;
        null 2 as $clearedCredentials;
        array<string, mixed> 3 as $attributes;
        array<int, string> 4 as $roles;
    };
    /**
     * UsernamePasswordToken and PreAuthenticatedToken share this payload: cleared credentials, firewall name, parent state.
