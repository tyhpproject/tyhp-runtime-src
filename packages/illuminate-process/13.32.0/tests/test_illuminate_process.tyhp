<?tyhp

function test_process_factory(): \Illuminate\Process\Factory
{
    return new \Illuminate\Process\Factory();
}

function test_process_command(): \Illuminate\Process\PendingProcess
{
    return (new \Illuminate\Process\Factory())->command('echo ok');
}

function test_fake_process_result(): \Illuminate\Process\FakeProcessResult
{
    return new \Illuminate\Process\FakeProcessResult('echo ok', 0, 'ok');
}
