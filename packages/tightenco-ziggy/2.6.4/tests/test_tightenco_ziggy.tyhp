<?tyhp

function test_ziggy_clear_routes(): void
{
    \Tighten\Ziggy\Ziggy::clearRoutes();
}

function test_ziggy_to_array(): array
{
    return (new \Tighten\Ziggy\Ziggy())->toArray();
}

function test_ziggy_to_json(): string
{
    return (new \Tighten\Ziggy\Ziggy())->toJson();
}

function test_blade_route_generator(): string
{
    return (new \Tighten\Ziggy\BladeRouteGenerator())->generate();
}

function test_ziggy_filter(): \Tighten\Ziggy\Ziggy
{
    return (new \Tighten\Ziggy\Ziggy())->filter();
}

function test_output_json(\Tighten\Ziggy\Ziggy $ziggy): string
{
    return (string) (new \Tighten\Ziggy\Output\Json($ziggy));
}

function test_output_script(\Tighten\Ziggy\Ziggy $ziggy): string
{
    return (string) (new \Tighten\Ziggy\Output\Script($ziggy, 'route'));
}
