<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Inertia PHPDoc uses `array-key` for page props; Layer 1 wrote `mixed` keys
 * which do not satisfy `array`’s KeyIntOrString bound. Do not inline foreign
 * namespaces.
 */

namespace Inertia {
    /**
     * Overlay: `$next` is invoked with the request and its return is not inspected.
     */
    // @overlay-against: class EncryptHistoryMiddleware
    partial class EncryptHistoryMiddleware {
        // @overlay-against: function handle(\Illuminate\Http\Request $request, \Closure $next): \Symfony\Component\HttpFoundation\Response
        public function handle(\Illuminate\Http\Request $request, \Closure<callable(\Illuminate\Http\Request): mixed> $next): \Symfony\Component\HttpFoundation\Response;
    }

    /**
     * Overlay: `share` and `render` maps use `array-key` (`int|string`).
     */
    // @overlay-against: class Inertia extends \Illuminate\Support\Facades\Facade
    partial class Inertia {
        /**
         * @param string|array<int|string, mixed>|\Illuminate\Contracts\Support\Arrayable<int|string, mixed>|\Inertia\ProvidesInertiaProperties $key
         */
        // @overlay-against: function share(string|array|\Illuminate\Contracts\Support\Arrayable|\Inertia\ProvidesInertiaProperties $key, mixed $value): void
        public static function share(string|array<int|string, mixed>|\Illuminate\Contracts\Support\Arrayable<int|string, mixed>|\Inertia\ProvidesInertiaProperties $key, mixed $value = null): void;
        /**
         * @param array<int|string, mixed>|\Illuminate\Contracts\Support\Arrayable<int|string, mixed>|\Inertia\ProvidesInertiaProperties $props
         */
        // @overlay-against: function render(\BackedEnum|\UnitEnum|string $component, array|\Illuminate\Contracts\Support\Arrayable|\Inertia\ProvidesInertiaProperties $props): \Inertia\Response
        public static function render(\BackedEnum|\UnitEnum|string $component, array<int|string, mixed>|\Illuminate\Contracts\Support\Arrayable<int|string, mixed>|\Inertia\ProvidesInertiaProperties $props = []): \Inertia\Response;
    }

    /**
     * Overlay: `$next($request)` is used as a Symfony response.
     */
    // @overlay-against: class Middleware
    partial class Middleware {
        // @overlay-against: function handle(\Illuminate\Http\Request $request, \Closure $next): \Symfony\Component\HttpFoundation\Response
        public function handle(\Illuminate\Http\Request $request, \Closure<callable(\Illuminate\Http\Request): \Symfony\Component\HttpFoundation\Response> $next): \Symfony\Component\HttpFoundation\Response;
    }

    /**
     * Overlay: constructor props are array-key maps per the PHP sources.
     */
    // @overlay-against: class Response implements \Illuminate\Contracts\Support\Responsable, \Illuminate\Support\Traits\Macroable
    partial class Response {
        /**
         * @param array<int|string, mixed> $sharedProps
         * @param array<int|string, mixed> $props
         */
        // @overlay-against: function __construct(string $component, array $sharedProps, array $props, string $rootView, string $version, bool $encryptHistory, ?\Closure $urlResolver): void
        public function __construct(string $component, array<int|string, mixed> $sharedProps, array<int|string, mixed> $props, string $rootView = 'app', string $version = '', bool $encryptHistory = false, ?\Closure $urlResolver = null): void;
    }

    /**
     * Overlay: `flash` keys are `array<string, mixed>`; `render` props are array-key maps.
     */
    // @overlay-against: class ResponseFactory implements \Illuminate\Support\Traits\Macroable
    partial class ResponseFactory {
        /**
         * @param \BackedEnum|\UnitEnum|string|array<string, mixed> $key
         */
        // @overlay-against: function flash(\BackedEnum|\UnitEnum|string|array $key, mixed $value): self
        public function flash(\BackedEnum|\UnitEnum|string|array<string, mixed> $key, mixed $value = null): self;
        /**
         * @param array<int|string, mixed>|\Illuminate\Contracts\Support\Arrayable<int|string, mixed>|\Inertia\ProvidesInertiaProperties $props
         */
        // @overlay-against: function render(\BackedEnum|\UnitEnum|string $component, array|\Illuminate\Contracts\Support\Arrayable|\Inertia\ProvidesInertiaProperties $props): \Inertia\Response
        public function render(\BackedEnum|\UnitEnum|string $component, array<int|string, mixed>|\Illuminate\Contracts\Support\Arrayable<int|string, mixed>|\Inertia\ProvidesInertiaProperties $props = []): \Inertia\Response;
    }
}

namespace Inertia {
    // @overlay-against: trait MergesProps
    partial trait MergesProps {
        // @overlay-against: function append(bool|string|array $path, ?string $matchOn): static
        public function append(bool|string|array<int|string, string> $path = true, ?string $matchOn = null): static;
        // @overlay-against: function matchOn(string|array $matchOn): static
        public function matchOn(string|array<int, string> $matchOn): static;
        // @overlay-against: function prepend(bool|string|array $path, ?string $matchOn): static
        public function prepend(bool|string|array<int|string, string> $path = true, ?string $matchOn = null): static;
    }

    // @overlay-against: class Response implements \Illuminate\Contracts\Support\Responsable, \Illuminate\Support\Traits\Macroable
    partial class Response {
        // @overlay-against: function flash(\BackedEnum|\UnitEnum|string|array $key, mixed $value): self
        public function flash(\BackedEnum|\UnitEnum|string|array<string, mixed> $key, mixed $value = null): self;
    }

    // @overlay-against: class ResponseFactory implements \Illuminate\Support\Traits\Macroable
    partial class ResponseFactory {
