         */
        // @overlay-against: function handleExceptionsUsing(callable $callback): void
        public function handleExceptionsUsing(callable(\Inertia\ExceptionResponse): mixed $callback): void;

        // @overlay-against: function withoutSsr(array|string $paths): void
        public function withoutSsr(array<int, string>|string $paths): void;
    }
}

namespace Inertia\DevTools {
    /**
     * Overlay: omitted body captures are status plus a reason string.
     */
    type CapturedBodyOmitted = struct {
        string $status;
        string $reason;
    };

    /**
     * Overlay: present body captures keep the original value.
     */
    type CapturedBodyPresent = struct {
        string $status;
        mixed $value;
    };

    /**
     * Overlay: `routePayload()` always sets name, uri, and action; actionSource is optional.
     */
    type RoutePayload = struct {
        mixed $name;
        string $uri;
        mixed $action;
        ?SourceLocation $actionSource;
    };

    /**
     * Overlay: caller, share, and action lookups return a file and a line.
     */
    type SourceLocation = struct {
        string $file;
        int $line;
    };

    // @overlay-against: class IncomingEntryBuilder implements \Inertia\DevTools\RedactsSensitiveData
    partial class IncomingEntryBuilder {
        // @overlay-against: function captureBodyValue(mixed $value): array
        protected function captureBodyValue(mixed $value): CapturedBodyOmitted|CapturedBodyPresent;

        // @overlay-against: function routePayload(array $payload): array|null
        protected function routePayload(array<string, mixed> $payload): RoutePayload|null;
    }

    // @overlay-against: class SourceLocator
    partial class SourceLocator {
        // @overlay-against: function captureCallerSource(): array|null
        public function captureCallerSource(): SourceLocation|null;

        // @overlay-against: function resolveActionSource(?string $action, mixed $uses): array|null
        public function resolveActionSource(?string $action, mixed $uses = null): SourceLocation|null;

        // @overlay-against: function resolveShareSource(\ReflectionMethod $reflection, string $key): array|null
        public function resolveShareSource(\ReflectionMethod $reflection, string $key): SourceLocation|null;

        // @overlay-against: function shareSourceFallback(\ReflectionMethod $reflection): array|null
        public function shareSourceFallback(\ReflectionMethod $reflection): SourceLocation|null;
    }
}

