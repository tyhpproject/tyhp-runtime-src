<?tyhp

function test_inertia_render(): \Inertia\Response
{
    return \Inertia\Inertia::render('Home', []);
}

function test_inertia_set_root_view(): void
{
    \Inertia\Inertia::setRootView('app');
}

function test_inertia_always(): \Inertia\AlwaysProp
{
    return \Inertia\Inertia::always('shared');
}

function test_inertia_optional(): \Inertia\OptionalProp
{
    return \Inertia\Inertia::optional(function (): string {
        return 'lazy';
    });
}

function test_inertia_location(): \Symfony\Component\HttpFoundation\Response
{
    return \Inertia\Inertia::location('/home');
}

function test_inertia_response(): \Inertia\Response
{
    return (new \Inertia\Response('Users/Index', [], []))->with('foo', 'bar')->rootView('app');
}

function test_inertia_get_shared(): mixed
{
    return \Inertia\Inertia::getShared(null, null);
}
