<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Declaration order: TYHPDEF_ORDERING.md.
 * Dba\Connection vs resource by PHP version; handlers/list/key_split shapes.
 */

/**
 * Overlay: `dba_key_split()` `[group, value_name]` pair.
 */
type DbaSplitKey = struct {
    string 0 as $group;
    string 1 as $value_name;
};

// @overlay-against: function dba_handlers(bool $full_info): array
function dba_handlers(false $full_info = false): array<int, string>;
// @overlay-against: function dba_handlers(bool $full_info): array
function dba_handlers(true $full_info): array<string, string>;
// @overlay-against: function dba_handlers(bool $full_info): array
function dba_handlers(bool $full_info = false): array<int, string>|array<string, string>;

// @overlay-against: function dba_key_split(string|false|null $key): array|false
function dba_key_split(string|false|null $key): DbaSplitKey|false;

// @overlay-against: function dba_list(): array
function dba_list(): array<int, string>;

declare(php="<8.4") {
    // @overlay-against: function dba_close(mixed $dba): void
    function dba_close(resource $dba): void;
    // @overlay-against: function dba_delete(array|string $key, mixed $dba): bool
    function dba_delete(DbaSplitKey|string $key, resource $dba): bool;
    // @overlay-against: function dba_exists(array|string $key, mixed $dba): bool
    function dba_exists(DbaSplitKey|string $key, resource $dba): bool;
    // @overlay-against: function dba_fetch(array|string $key, mixed $dba, mixed $skip): string|false
    function dba_fetch(DbaSplitKey|string $key, resource $dba, int $skip = 0): string|false;
    // @overlay-against: function dba_firstkey(mixed $dba): string|false
    function dba_firstkey(resource $dba): string|false;
    // @overlay-against: function dba_insert(array|string $key, string $value, mixed $dba): bool
    function dba_insert(DbaSplitKey|string $key, string $value, resource $dba): bool;
    // @overlay-against: function dba_nextkey(mixed $dba): string|false
    function dba_nextkey(resource $dba): string|false;
    // @overlay-against: function dba_open(string $path, string $mode, ?string $handler, int $permission, int $map_size, ?int $flags)
    function dba_open(string $path, string $mode, ?string $handler = null, int $permission = 420, int $map_size = 0, ?int $flags = null): resource|false;
    // @overlay-against: function dba_optimize(mixed $dba): bool
    function dba_optimize(resource $dba): bool;
    // @overlay-against: function dba_popen(string $path, string $mode, ?string $handler, int $permission, int $map_size, ?int $flags)
    function dba_popen(string $path, string $mode, ?string $handler = null, int $permission = 420, int $map_size = 0, ?int $flags = null): resource|false;
    // @overlay-against: function dba_replace(array|string $key, string $value, mixed $dba): bool
    function dba_replace(DbaSplitKey|string $key, string $value, resource $dba): bool;
    // @overlay-against: function dba_sync(mixed $dba): bool
    function dba_sync(resource $dba): bool;
}

declare(php=">=8.4") {
    // @overlay-against: function dba_delete(array|string $key, \Dba\Connection $dba): bool
    function dba_delete(DbaSplitKey|string $key, \Dba\Connection $dba): bool;
    // @overlay-against: function dba_exists(array|string $key, \Dba\Connection $dba): bool
    function dba_exists(DbaSplitKey|string $key, \Dba\Connection $dba): bool;
    // @overlay-against: function dba_fetch(array|string $key, mixed $dba, mixed $skip): string|false
    function dba_fetch(DbaSplitKey|string $key, \Dba\Connection $dba, int $skip = 0): string|false;
    // @overlay-against: function dba_insert(array|string $key, string $value, \Dba\Connection $dba): bool
    function dba_insert(DbaSplitKey|string $key, string $value, \Dba\Connection $dba): bool;
    // @overlay-against: function dba_replace(array|string $key, string $value, \Dba\Connection $dba): bool
    function dba_replace(DbaSplitKey|string $key, string $value, \Dba\Connection $dba): bool;
}
