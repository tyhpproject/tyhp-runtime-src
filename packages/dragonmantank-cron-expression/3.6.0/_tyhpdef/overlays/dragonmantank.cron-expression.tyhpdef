         */
        // @overlay-against: function getMultipleRunDates(int $total, string|\DateTimeInterface|null $currentTime, bool $invert, bool $allowCurrentDate, null|string $timeZone): array
        public function getMultipleRunDates(int $total, string|\DateTimeInterface|null $currentTime = 'now', bool $invert = false, bool $allowCurrentDate = false, null|string $timeZone = null): array<int|string, \DateTime>;

        /**
         * @return array<int|string, string>
         */
        // @overlay-against: function getParts(): array
        public function getParts(): array<int|string, string>;

        /**
         * @var array<string, string>
         */
        // @overlay-against: const array MAPPINGS
        public const array<string, string> MAPPINGS ?? [
            '@yearly' => '0 0 1 1 *',
            '@annually' => '0 0 1 1 *',
            '@monthly' => '0 0 1 * *',
            '@weekly' => '0 0 * * 0',
            '@daily' => '0 0 * * *',
            '@midnight' => '0 0 * * *',
            '@hourly' => '0 * * * *',
        ];
    }

