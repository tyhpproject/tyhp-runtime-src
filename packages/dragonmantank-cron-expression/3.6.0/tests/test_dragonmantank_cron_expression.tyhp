<?tyhp

function test_cron_new(): \Cron\CronExpression
{
    return new \Cron\CronExpression('* * * * *');
}

function test_cron_valid(): bool
{
    return \Cron\CronExpression::isValidExpression('0 0 * * *');
}

function test_cron_next(\Cron\CronExpression $cron): \DateTime
{
    return $cron->getNextRunDate('now');
}

function test_cron_due(\Cron\CronExpression $cron): bool
{
    return $cron->isDue('now');
}

function test_cron_multiple(\Cron\CronExpression $cron): array<int|string, \DateTime>
{
    return $cron->getMultipleRunDates(3);
}
