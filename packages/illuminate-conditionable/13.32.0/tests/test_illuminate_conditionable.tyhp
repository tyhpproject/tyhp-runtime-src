<?tyhp

class OverlayTests_ConditionableHost {
    use \Illuminate\Support\Traits\Conditionable;

    public function label(): string
    {
        return 'ok';
    }
}

function test_conditionable_when(): mixed
{
    $h = new OverlayTests_ConditionableHost();
    return $h->when(true, static function (OverlayTests_ConditionableHost $x): OverlayTests_ConditionableHost {
        return $x;
    });
}

function test_conditionable_unless(): mixed
{
    $h = new OverlayTests_ConditionableHost();
    return $h->unless(false, static function (OverlayTests_ConditionableHost $x): OverlayTests_ConditionableHost {
        return $x;
    });
}

function test_conditionable_proxy(): \Illuminate\Support\HigherOrderWhenProxy
{
    return new \Illuminate\Support\HigherOrderWhenProxy(new OverlayTests_ConditionableHost());
}
