<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Shared type aliases and array-shape structs used by the other Monolog overlays.
 */

namespace Monolog {
    /**
     * Monolog all-caps level names (`Level::getName()` / `Level::NAMES`).
     */
    type LevelName = 'DEBUG'|'INFO'|'NOTICE'|'WARNING'|'ERROR'|'CRITICAL'|'ALERT'|'EMERGENCY';

    /**
     * Names accepted by `Level::fromName()` (Monolog, PSR-3, and enum case names).
     */
    type LevelNameInput = LevelName|'Debug'|'Info'|'Notice'|'Warning'|'Error'|'Critical'|'Alert'|'Emergency'|'debug'|'info'|'notice'|'warning'|'error'|'critical'|'alert'|'emergency';

    /**
     * Values accepted wherever Monolog takes a level (int value, name, or `Level`).
     */
    type LevelInput = int|string|\Monolog\Level;

    /**
     * PSR-3 / Monolog context and extra maps (string keys, mixed values).
     */
    type LogContext = array<string, mixed>;

    /**
     * Offset keys supported by `LogRecord` `ArrayAccess`.
     */
    type LogRecordOffset = 'message'|'level'|'context'|'level_name'|'channel'|'datetime'|'extra'|'formatted';

    /**
     * Processor callable: record in, record out.
     */
    type ProcessorCallback = callable(\Monolog\LogRecord): \Monolog\LogRecord;

    /**
     * `Logger::setExceptionHandler()` callback.
     */
    type ExceptionHandlerCallback = callable(\Throwable, \Monolog\LogRecord): void;

    /**
     * Nested-handler factory used by Filter / FingersCrossed / Sampling / LogMonster.
     */
    type HandlerFactoryCallback = callable(?\Monolog\LogRecord, \Monolog\Handler\HandlerInterface): \Monolog\Handler\HandlerInterface;

    /**
     * Overlay: `LogRecord::toArray()` shape.
     */
    type LogRecordArray = struct {
        string $channel;
        \Monolog\LogContext $context;
        \DateTimeImmutable $datetime;
        \Monolog\LogContext $extra;
        int $level;
        string $level_name;
        string $message;
    };
}
