namespace OverlayTests\PsrHttpFactoryFail;

function createUploadedFile_error_not_int(\Psr\Http\Message\UploadedFileFactoryInterface $factory, \Psr\Http\Message\StreamInterface $stream): \Psr\Http\Message\UploadedFileInterface
{
    return $factory->createUploadedFile($stream, null, 'ok');
}
