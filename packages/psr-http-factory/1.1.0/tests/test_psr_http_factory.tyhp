<?tyhp

function test_psr_http_factory_request(\Psr\Http\Message\RequestFactoryInterface $factory, \Psr\Http\Message\UriInterface $uri): \Psr\Http\Message\RequestInterface
{
    return $factory->createRequest('GET', $uri);
}

function test_psr_http_factory_response(\Psr\Http\Message\ResponseFactoryInterface $factory): \Psr\Http\Message\ResponseInterface
{
    return $factory->createResponse(201, 'Created');
}

function test_psr_http_factory_server_request(\Psr\Http\Message\ServerRequestFactoryInterface $factory): \Psr\Http\Message\ServerRequestInterface
{
    return $factory->createServerRequest('POST', '/submit', ['REQUEST_METHOD' => 'POST']);
}

function test_psr_http_factory_stream(\Psr\Http\Message\StreamFactoryInterface $factory): \Psr\Http\Message\StreamInterface
{
    return $factory->createStream('body');
}

function test_psr_http_factory_uploaded_file_default_error(\Psr\Http\Message\UploadedFileFactoryInterface $factory, \Psr\Http\Message\StreamInterface $stream): \Psr\Http\Message\UploadedFileInterface
{
    return $factory->createUploadedFile($stream);
}

function test_psr_http_factory_uri(\Psr\Http\Message\UriFactoryInterface $factory): \Psr\Http\Message\UriInterface
{
    return $factory->createUri('https://example.com/');
}
