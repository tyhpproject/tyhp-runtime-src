<?tyhp

function test_app_variable_environment(): string
{
    $app = new \Symfony\Bridge\Twig\AppVariable();
    $app->setEnvironment('dev');
    $app->setDebug(true);
    return $app->getEnvironment();
}

function test_app_variable_debug(): bool
{
    $app = new \Symfony\Bridge\Twig\AppVariable();
    $app->setDebug(false);
    return $app->getDebug();
}
