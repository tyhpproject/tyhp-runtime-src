<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * PHP 8.1+ connections are `\PgSql\Connection`. Layer 1 leaves some
 * `$connection` parameters as `mixed`; this overlay last-wins those plus
 * query-parameter and fetch array types. One-argument forms still use the
 * (deprecated) default connection.
 */

type PgSqlVersion = struct {
    ?string $client;
    ?int $protocol;
    ?string $server;
};

// @overlay-against: function pg_convert(\PgSql\Connection $connection, string $table_name, array $values, int $flags): array|false
function pg_convert(\PgSql\Connection $connection, string $table_name, array<string, mixed> $values, int $flags = 0): array<string, string>|false;
// @overlay-against: function pg_copy_to(\PgSql\Connection $connection, string $table_name, string $separator, string $null_as): array|false
function pg_copy_to(\PgSql\Connection $connection, string $table_name, string $separator = '\t', string $null_as = '\\\\N'): array<int, string>|false;
// @overlay-against: function pg_delete(\PgSql\Connection $connection, string $table_name, array $conditions, int $flags): string|bool
function pg_delete(\PgSql\Connection $connection, string $table_name, array<string, mixed> $conditions, int $flags = PGSQL_DML_EXEC): string|bool;
// @overlay-against: function pg_escape_bytea(mixed $connection, string $string): string
function pg_escape_bytea(\PgSql\Connection $connection, string $string): string;
// @overlay-against: function pg_escape_bytea(mixed $connection, string $string): string
function pg_escape_bytea(string $string): string;
// @overlay-against: function pg_escape_identifier(mixed $connection, string $string): string|false
function pg_escape_identifier(\PgSql\Connection $connection, string $string): string|false;
// @overlay-against: function pg_escape_identifier(mixed $connection, string $string): string|false
function pg_escape_identifier(string $string): string|false;
// @overlay-against: function pg_escape_literal(mixed $connection, string $string): string|false
function pg_escape_literal(\PgSql\Connection $connection, string $string): string|false;
// @overlay-against: function pg_escape_literal(mixed $connection, string $string): string|false
function pg_escape_literal(string $string): string|false;
// @overlay-against: function pg_escape_string(mixed $connection, string $string): string
function pg_escape_string(\PgSql\Connection $connection, string $string): string;
// @overlay-against: function pg_escape_string(mixed $connection, string $string): string
function pg_escape_string(string $string): string;
// @overlay-against: function pg_exec(mixed $connection, string $query): \PgSql\Result|false
function pg_exec(\PgSql\Connection $connection, string $query): \PgSql\Result|false;
// @overlay-against: function pg_exec(mixed $connection, string $query): \PgSql\Result|false
function pg_exec(string $query): \PgSql\Result|false;
// @overlay-against: function pg_execute(mixed $connection, mixed $statement_name, array $params): \PgSql\Result|false
function pg_execute(\PgSql\Connection $connection, string $statement_name, array<int, mixed> $params): \PgSql\Result|false;
// @overlay-against: function pg_execute(mixed $connection, mixed $statement_name, array $params): \PgSql\Result|false
function pg_execute(string $statement_name, array<int, mixed> $params): \PgSql\Result|false;
/**
 * PGSQL_ASSOC (`1`, default).
 */
// @overlay-against: function pg_fetch_all(\PgSql\Result $result, int $mode): array
function pg_fetch_all(\PgSql\Result $result, 1 $mode = PGSQL_ASSOC): array<int, array<string, mixed>>;
/**
 * PGSQL_NUM (`2`).
 */
// @overlay-against: function pg_fetch_all(\PgSql\Result $result, int $mode): array
function pg_fetch_all(\PgSql\Result $result, 2 $mode): array<int, array<int, mixed>>;
/**
 * PGSQL_BOTH (`3`).
 */
// @overlay-against: function pg_fetch_all(\PgSql\Result $result, int $mode): array
function pg_fetch_all(\PgSql\Result $result, 3 $mode): array<int, array<int|string, mixed>>;
// @overlay-against: function pg_fetch_all(\PgSql\Result $result, int $mode): array
function pg_fetch_all(\PgSql\Result $result, int $mode): array<int, array<int|string, mixed>>;
// @overlay-against: function pg_fetch_all_columns(\PgSql\Result $result, int $field): array
function pg_fetch_all_columns(\PgSql\Result $result, int $field = 0): array<int, string|null>;
/**
 * PGSQL_ASSOC (`1`).
 */
// @overlay-against: function pg_fetch_array(\PgSql\Result $result, ?int $row, int $mode): array|false
function pg_fetch_array(\PgSql\Result $result, ?int $row, 1 $mode): array<string, mixed>|false;
/**
 * PGSQL_NUM (`2`).
 */
// @overlay-against: function pg_fetch_array(\PgSql\Result $result, ?int $row, int $mode): array|false
function pg_fetch_array(\PgSql\Result $result, ?int $row, 2 $mode): array<int, mixed>|false;
/**
 * PGSQL_BOTH (`3`, default).
 */
// @overlay-against: function pg_fetch_array(\PgSql\Result $result, ?int $row, int $mode): array|false
function pg_fetch_array(\PgSql\Result $result, ?int $row = null, 3 $mode = PGSQL_BOTH): array<int|string, mixed>|false;
// @overlay-against: function pg_fetch_array(\PgSql\Result $result, ?int $row, int $mode): array|false
function pg_fetch_array(\PgSql\Result $result, ?int $row, int $mode): array<int|string, mixed>|false;
// @overlay-against: function pg_fetch_assoc(\PgSql\Result $result, ?int $row): array|false
function pg_fetch_assoc(\PgSql\Result $result, ?int $row = null): array<string, mixed>|false;
// @overlay-against: function pg_fetch_result(\PgSql\Result $result, mixed $row, string|int $field): string|false|null
function pg_fetch_result(\PgSql\Result $result, string|int $field): string|false|null;
// @overlay-against: function pg_fetch_result(\PgSql\Result $result, mixed $row, string|int $field): string|false|null
function pg_fetch_result(\PgSql\Result $result, int $row, string|int $field): string|false|null;
// @overlay-against: function pg_fetch_row(\PgSql\Result $result, ?int $row, int $mode): array|false
function pg_fetch_row(\PgSql\Result $result, ?int $row = null, int $mode = PGSQL_NUM): array<int, mixed>|false;
// @overlay-against: function pg_field_is_null(\PgSql\Result $result, mixed $row, string|int $field): int|false
function pg_field_is_null(\PgSql\Result $result, string|int $field): int|false;
// @overlay-against: function pg_field_is_null(\PgSql\Result $result, mixed $row, string|int $field): int|false
function pg_field_is_null(\PgSql\Result $result, int $row, string|int $field): int|false;
// @overlay-against: function pg_field_prtlen(\PgSql\Result $result, mixed $row, string|int $field): int|false
function pg_field_prtlen(\PgSql\Result $result, string|int $field): int|false;
// @overlay-against: function pg_field_prtlen(\PgSql\Result $result, mixed $row, string|int $field): int|false
function pg_field_prtlen(\PgSql\Result $result, int $row, string|int $field): int|false;
// @overlay-against: function pg_get_notify(\PgSql\Connection $connection, int $mode): array|false
function pg_get_notify(\PgSql\Connection $connection, int $mode = PGSQL_ASSOC): array<int|string, mixed>|false;
// @overlay-against: function pg_insert(\PgSql\Connection $connection, string $table_name, array $values, int $flags): \PgSql\Result|string|bool
function pg_insert(\PgSql\Connection $connection, string $table_name, array<string, mixed> $values, int $flags = PGSQL_DML_EXEC): \PgSql\Result|string|bool;
// @overlay-against: function pg_last_notice(\PgSql\Connection $connection, int $mode): array|string|bool
function pg_last_notice(\PgSql\Connection $connection, 1 $mode = PGSQL_NOTICE_LAST): string|false;
// @overlay-against: function pg_last_notice(\PgSql\Connection $connection, int $mode): array|string|bool
function pg_last_notice(\PgSql\Connection $connection, 2 $mode): array<int, string>|false;
// @overlay-against: function pg_last_notice(\PgSql\Connection $connection, int $mode): array|string|bool
function pg_last_notice(\PgSql\Connection $connection, 3 $mode): bool;
// @overlay-against: function pg_last_notice(\PgSql\Connection $connection, int $mode): array|string|bool
function pg_last_notice(\PgSql\Connection $connection, int $mode = PGSQL_NOTICE_LAST): array<int, string>|string|bool;
// @overlay-against: function pg_lo_create(mixed $connection, mixed $oid): string|int|false
function pg_lo_create(\PgSql\Connection $connection, mixed $oid): string|int|false;
// @overlay-against: function pg_lo_create(mixed $connection, mixed $oid): string|int|false
function pg_lo_create(mixed $oid): string|int|false;
// @overlay-against: function pg_lo_export(mixed $connection, mixed $oid, mixed $filename): bool
function pg_lo_export(\PgSql\Connection $connection, int $oid, string $filename): bool;
// @overlay-against: function pg_lo_import(mixed $connection, mixed $filename, mixed $oid): string|int|false
function pg_lo_import(\PgSql\Connection $connection, string $filename, int|string $oid): string|int|false;
// @overlay-against: function pg_lo_open(mixed $connection, mixed $oid, string $mode): \PgSql\Lob|false
function pg_lo_open(\PgSql\Connection $connection, int $oid, string $mode): \PgSql\Lob|false;
// @overlay-against: function pg_lo_unlink(mixed $connection, mixed $oid): bool
function pg_lo_unlink(\PgSql\Connection $connection, int $oid): bool;
// @overlay-against: function pg_meta_data(\PgSql\Connection $connection, string $table_name, bool $extended): array|false
function pg_meta_data(\PgSql\Connection $connection, string $table_name, bool $extended = false): array<string, array<string, mixed>>|false;
// @overlay-against: function pg_parameter_status(mixed $connection, string $name): string|false
function pg_parameter_status(\PgSql\Connection $connection, string $name): string|false;
// @overlay-against: function pg_parameter_status(mixed $connection, string $name): string|false
function pg_parameter_status(string $name): string|false;
// @overlay-against: function pg_prepare(mixed $connection, string $statement_name, string $query): \PgSql\Result|false
function pg_prepare(\PgSql\Connection $connection, string $statement_name, string $query): \PgSql\Result|false;
// @overlay-against: function pg_prepare(mixed $connection, string $statement_name, string $query): \PgSql\Result|false
function pg_prepare(string $statement_name, string $query): \PgSql\Result|false;
// @overlay-against: function pg_put_line(mixed $connection, string $query): bool
function pg_put_line(\PgSql\Connection $connection, string $query): bool;
// @overlay-against: function pg_put_line(mixed $connection, string $query): bool
function pg_put_line(string $query): bool;
// @overlay-against: function pg_query(mixed $connection, string $query): \PgSql\Result|false
function pg_query(\PgSql\Connection $connection, string $query): \PgSql\Result|false;
// @overlay-against: function pg_query(mixed $connection, string $query): \PgSql\Result|false
function pg_query(string $query): \PgSql\Result|false;
// @overlay-against: function pg_query_params(mixed $connection, mixed $query, array $params): \PgSql\Result|false
function pg_query_params(\PgSql\Connection $connection, string $query, array<int, mixed> $params): \PgSql\Result|false;
// @overlay-against: function pg_query_params(mixed $connection, mixed $query, array $params): \PgSql\Result|false
function pg_query_params(string $query, array<int, mixed> $params): \PgSql\Result|false;
// @overlay-against: function pg_select(\PgSql\Connection $connection, string $table_name, array $conditions, int $flags, int $mode): array|string|false
function pg_select(\PgSql\Connection $connection, string $table_name, array<string, mixed> $conditions = [], int $flags = PGSQL_DML_EXEC, 1 $mode = PGSQL_ASSOC): array<int, array<string, mixed>>|string|false;
// @overlay-against: function pg_select(\PgSql\Connection $connection, string $table_name, array $conditions, int $flags, int $mode): array|string|false
function pg_select(\PgSql\Connection $connection, string $table_name, array<string, mixed> $conditions, int $flags, 2 $mode): array<int, array<int, mixed>>|string|false;
// @overlay-against: function pg_select(\PgSql\Connection $connection, string $table_name, array $conditions, int $flags, int $mode): array|string|false
function pg_select(\PgSql\Connection $connection, string $table_name, array<string, mixed> $conditions, int $flags, 3 $mode): array<int, array<int|string, mixed>>|string|false;
// @overlay-against: function pg_select(\PgSql\Connection $connection, string $table_name, array $conditions, int $flags, int $mode): array|string|false
function pg_select(\PgSql\Connection $connection, string $table_name, array<string, mixed> $conditions = [], int $flags = PGSQL_DML_EXEC, int $mode = PGSQL_ASSOC): array<int, array<int|string, mixed>>|string|false;
// @overlay-against: function pg_send_execute(\PgSql\Connection $connection, string $statement_name, array $params): int|bool
function pg_send_execute(\PgSql\Connection $connection, string $statement_name, array<int, mixed> $params): int|bool;
// @overlay-against: function pg_send_query_params(\PgSql\Connection $connection, string $query, array $params): int|bool
function pg_send_query_params(\PgSql\Connection $connection, string $query, array<int, mixed> $params): int|bool;
// @overlay-against: function pg_set_client_encoding(mixed $connection, string $encoding): int
function pg_set_client_encoding(\PgSql\Connection $connection, string $encoding): int;
