function pg_update(\PgSql\Connection $connection, string $table_name, array<string, mixed> $values, array<string, mixed> $conditions, int $flags = PGSQL_DML_EXEC): string|bool;
// @overlay-against: function pg_version(?\PgSql\Connection $connection): array
function pg_version(?\PgSql\Connection $connection = null): PgSqlVersion;

#[\Tyhp\Php("<8.5")]
