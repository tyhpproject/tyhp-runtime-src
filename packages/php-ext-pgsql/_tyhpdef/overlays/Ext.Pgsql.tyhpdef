function pg_copy_from(\PgSql\Connection $connection, string $table_name, array<int, string> $rows, string $separator = '\t', string $null_as = '\\\\N'): bool;

#[\Tyhp\Php(">=8.4")]
// @overlay-against: function pg_jit(?\PgSql\Connection $connection): array
function pg_jit(?\PgSql\Connection $connection = null): array<string, string>;

