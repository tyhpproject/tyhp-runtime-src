{
    "name": "tyhpdef/orchestra-testbench",
    "description": "Tyhp type definitions for the Composer package orchestra/testbench (11.2.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "11.2.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/orchestra-testbench-core": "@dev",
                "tyhpdef/phpunit-phpunit": "@dev",
                "tyhpdef/mockery-mockery": "@dev",
                "tyhpdef/fakerphp-faker": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "orchestra/testbench": "11.2.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/orchestra-testbench-core": "@dev",
        "tyhpdef/phpunit-phpunit": "@dev",
        "tyhpdef/mockery-mockery": "@dev",
        "tyhpdef/fakerphp-faker": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../orchestra-testbench-core/11.4.0"
        },
        {
            "type": "path",
            "url": "../../phpunit-phpunit/12.5.35"
        },
        {
            "type": "path",
            "url": "../../mockery-mockery/1.6.15"
        },
        {
            "type": "path",
            "url": "../../fakerphp-faker/1.24.1"
        }
    ]
}
