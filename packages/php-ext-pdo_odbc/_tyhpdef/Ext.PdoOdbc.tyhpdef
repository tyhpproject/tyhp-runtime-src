<?tyhpdef
/**
 * Hand-written Layer 1 for pdo_odbc.
 * Managed PHP does not provision `pdo_odbc` (TYHP7511); signatures follow
 * PHP 8.2–8.5 docs. PHP 8.4+ `Pdo\Odbc` is gated. PDO driver constants live
 * in `_tyhpdef/overlays/Ext.PdoOdbc.tyhpdef`.
 *
 * @link https://www.php.net/manual/en/ref.pdo-odbc.php
 */
namespace Pdo {
    /**
     * PDO subclass for the ODBC driver (PHP 8.4+).
     *
     * @link https://www.php.net/manual/en/class.pdo-odbc.php
     */
    #[\Tyhp\Php(">=8.4")]
    class Odbc extends \PDO {
        public const int ATTR_USE_CURSOR_LIBRARY;
        public const int ATTR_ASSUME_UTF8;
        public const int SQL_USE_IF_NEEDED;
        public const int SQL_USE_DRIVER;
        public const int SQL_USE_ODBC;
    }
}

const string PDO_ODBC_TYPE;
