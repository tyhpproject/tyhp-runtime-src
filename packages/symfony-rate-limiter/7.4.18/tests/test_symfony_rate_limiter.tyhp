<?tyhp

function test_rate_limiter_consume(\Symfony\Component\RateLimiter\LimiterInterface $limiter): \Symfony\Component\RateLimiter\RateLimit
{
    return $limiter->consume(1);
}

function test_rate_limiter_factory_create(\Symfony\Component\RateLimiter\RateLimiterFactory $factory): \Symfony\Component\RateLimiter\LimiterInterface
{
    return $factory->create('login');
}
