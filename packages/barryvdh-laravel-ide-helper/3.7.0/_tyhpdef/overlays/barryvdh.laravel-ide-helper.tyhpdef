<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * `barryvdh/reflection-docblock` has no wrapper. Do not inline `\Barryvdh\Reflection\*`.
 */

namespace Barryvdh\LaravelIdeHelper {
    // @overlay-against: class Method
    partial class Method {
        // @overlay-against: function getReturnTag(\Barryvdh\Reflection\DocBlock|null $phpdoc): \Barryvdh\Reflection\DocBlock\Tag\ReturnTag|null
        omit function getReturnTag();
        // @overlay-against: function normalizeDescription(\Barryvdh\Reflection\DocBlock $phpdoc): mixed
        omit function normalizeDescription();
        // @overlay-against: function normalizeParams(\Barryvdh\Reflection\DocBlock $phpdoc): mixed
        omit function normalizeParams();
        // @overlay-against: function normalizeReturn(\Barryvdh\Reflection\DocBlock $phpdoc): mixed
        omit function normalizeReturn();
        // @overlay-against: function getInheritDoc(\ReflectionMethod $reflectionMethod): \Barryvdh\Reflection\DocBlock
        omit function getInheritDoc();
    }
}

namespace Barryvdh\LaravelIdeHelper\Console {
    // @overlay-against: class ModelsCommand extends \Illuminate\Console\Command
    partial class ModelsCommand {
        // @overlay-against: function getDocBlockContext(\Reflector $reflector): \Barryvdh\Reflection\DocBlock\Context
        omit function getDocBlockContext();
    }
}

namespace Barryvdh\LaravelIdeHelper {
    // @overlay-against: class Alias
    partial class Alias {
        // @overlay-against: function addClass(array|string $classes): mixed
        public function addClass(array<int, string>|string $classes): void;

        // @overlay-against: function getDocComment(mixed $prefix): mixed
        public function getDocComment(string $prefix = "\t\t"): string;

        // @overlay-against: function getMethods(): array|array
        public function getMethods(): array<int, \Barryvdh\LaravelIdeHelper\Method>;

        // @overlay-against: function getPhpDocTemplates(mixed $prefix): string
        public function getPhpDocTemplates(string $prefix = "\t\t"): string;

        // @overlay-against: function getShortName(): mixed
        public function getShortName(): string;

        // @overlay-against: function shouldExtendParentClass(): mixed
        public function shouldExtendParentClass(): bool;
    }

    // @overlay-against: class Generator
    partial class Generator {
        // @overlay-against: function generateEloquent(): mixed
        public function generateEloquent(): string;
    }

    // @overlay-against: class IdeHelperServiceProvider extends \Illuminate\Support\ServiceProvider implements \Illuminate\Contracts\Support\DeferrableProvider
    partial class IdeHelperServiceProvider {
        // @overlay-against: function provides(): array
        public function provides(): array<int, string>;
    }
}

namespace Barryvdh\LaravelIdeHelper\Console {
    // @overlay-against: class ModelsCommand extends \Illuminate\Console\Command
    partial class ModelsCommand {
        // @overlay-against: function setMethod(mixed $name, mixed $type, mixed $arguments, mixed $comment): mixed
        public function setMethod(string $name, string $type = '', array<int|string, mixed> $arguments = [], string $comment = ''): void;

        // @overlay-against: function setProperty(string $name, string|null $type, bool|null $read, bool|null $write, string|null $comment, bool $nullable): mixed
        public function setProperty(string $name, string|null $type = null, bool|null $read = null, bool|null $write = null, string|null $comment = '', bool $nullable = false): void;

        // @overlay-against: function unsetMethod(mixed $name): mixed
        public function unsetMethod(string $name): void;
    }
}

namespace Barryvdh\LaravelIdeHelper\Listeners {
    // @overlay-against: class GenerateModelHelper
    partial class GenerateModelHelper {
        // @overlay-against: function handle(\Illuminate\Console\Events\CommandFinished $event): mixed
        public function handle(\Illuminate\Console\Events\CommandFinished $event): void;
    }
}
