<?tyhp

function test_alias_add_class(): mixed
{
    $config = new \Illuminate\Config\Repository();
    $alias = new \Barryvdh\LaravelIdeHelper\Alias($config, 'Auth', 'Illuminate\\Support\\Facades\\Auth');
    return $alias->addClass('Illuminate\\Auth\\AuthManager');
}

function test_alias_classtype(): string
{
    $config = new \Illuminate\Config\Repository();
    return (new \Barryvdh\LaravelIdeHelper\Alias($config, 'Auth', 'Illuminate\\Support\\Facades\\Auth'))->getClasstype();
}
