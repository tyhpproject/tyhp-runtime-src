<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `xml_parse_into_struct()` value/index shapes and typed expat handler
 * callables. Layer 1 gates the setters at 8.4 (`mixed` vs `callable|string|null`);
 * this overlay keeps those gates and narrows `callable`. Not Pure.
 */

/**
 * One element of the `$values` list filled by `xml_parse_into_struct()`.
 * `value` / `attributes` are present only when the parser saw character data
 * or attributes on that tag.
 */
type XmlParseStructValue = struct {
    string $tag;
    'open'|'close'|'complete'|'cdata' $type;
    int $level;
    ?string $value;
    ?array<string, string> $attributes;
};

type XmlCharacterDataHandler = callable(\XMLParser, string): void;
type XmlDefaultHandler = callable(\XMLParser, string): void;
type XmlEndElementHandler = callable(\XMLParser, string): void;
type XmlEndNamespaceDeclHandler = callable(\XMLParser, string|false): void;
type XmlExternalEntityRefHandler = callable(\XMLParser, string, string|false, string, string|false): bool;
type XmlNotationDeclHandler = callable(\XMLParser, string, string|false, string, string|false): void;
type XmlProcessingInstructionHandler = callable(\XMLParser, string, string): void;
type XmlStartElementHandler = callable(\XMLParser, string, array<string, string>): void;
type XmlStartNamespaceDeclHandler = callable(\XMLParser, string|false, string): void;
type XmlUnparsedEntityDeclHandler = callable(\XMLParser, string, string|false, string, string|false, string|false): void;

// @overlay-against: function xml_parse_into_struct(\XMLParser $parser, string $data, mixed $values, mixed $index): int|false
function xml_parse_into_struct(\XMLParser $parser, string $data, array<int, XmlParseStructValue> &$values, ?array<string, array<int, int>> &$index = null): int|false;

declare(php="<8.4") {
    // @overlay-against: function xml_set_character_data_handler(\XMLParser $parser, mixed $handler): true
    function xml_set_character_data_handler(\XMLParser $parser, XmlCharacterDataHandler|string|null $handler): true;
    // @overlay-against: function xml_set_default_handler(\XMLParser $parser, mixed $handler): true
    function xml_set_default_handler(\XMLParser $parser, XmlDefaultHandler|string|null $handler): true;
    // @overlay-against: function xml_set_element_handler(\XMLParser $parser, mixed $start_handler, mixed $end_handler): true
    function xml_set_element_handler(\XMLParser $parser, XmlStartElementHandler|string|null $start_handler, XmlEndElementHandler|string|null $end_handler): true;
    // @overlay-against: function xml_set_end_namespace_decl_handler(\XMLParser $parser, mixed $handler): true
    function xml_set_end_namespace_decl_handler(\XMLParser $parser, XmlEndNamespaceDeclHandler|string|null $handler): true;
    // @overlay-against: function xml_set_external_entity_ref_handler(\XMLParser $parser, mixed $handler): true
    function xml_set_external_entity_ref_handler(\XMLParser $parser, XmlExternalEntityRefHandler|string|null $handler): true;
    // @overlay-against: function xml_set_notation_decl_handler(\XMLParser $parser, mixed $handler): true
    function xml_set_notation_decl_handler(\XMLParser $parser, XmlNotationDeclHandler|string|null $handler): true;
    // @overlay-against: function xml_set_processing_instruction_handler(\XMLParser $parser, mixed $handler): true
    function xml_set_processing_instruction_handler(\XMLParser $parser, XmlProcessingInstructionHandler|string|null $handler): true;
    // @overlay-against: function xml_set_start_namespace_decl_handler(\XMLParser $parser, mixed $handler): true
    function xml_set_start_namespace_decl_handler(\XMLParser $parser, XmlStartNamespaceDeclHandler|string|null $handler): true;
    // @overlay-against: function xml_set_unparsed_entity_decl_handler(\XMLParser $parser, mixed $handler): true
    function xml_set_unparsed_entity_decl_handler(\XMLParser $parser, XmlUnparsedEntityDeclHandler|string|null $handler): true;
}

declare(php=">=8.4") {
    // @overlay-against: function xml_set_character_data_handler(\XMLParser $parser, callable|string|null $handler): true
    function xml_set_character_data_handler(\XMLParser $parser, XmlCharacterDataHandler|string|null $handler): true;
    // @overlay-against: function xml_set_default_handler(\XMLParser $parser, callable|string|null $handler): true
    function xml_set_default_handler(\XMLParser $parser, XmlDefaultHandler|string|null $handler): true;
    // @overlay-against: function xml_set_element_handler(\XMLParser $parser, callable|string|null $start_handler, callable|string|null $end_handler): true
    function xml_set_element_handler(\XMLParser $parser, XmlStartElementHandler|string|null $start_handler, XmlEndElementHandler|string|null $end_handler): true;
    // @overlay-against: function xml_set_end_namespace_decl_handler(\XMLParser $parser, callable|string|null $handler): true
    function xml_set_end_namespace_decl_handler(\XMLParser $parser, XmlEndNamespaceDeclHandler|string|null $handler): true;
    // @overlay-against: function xml_set_external_entity_ref_handler(\XMLParser $parser, callable|string|null $handler): true
    function xml_set_external_entity_ref_handler(\XMLParser $parser, XmlExternalEntityRefHandler|string|null $handler): true;
    // @overlay-against: function xml_set_notation_decl_handler(\XMLParser $parser, callable|string|null $handler): true
    function xml_set_notation_decl_handler(\XMLParser $parser, XmlNotationDeclHandler|string|null $handler): true;
    // @overlay-against: function xml_set_processing_instruction_handler(\XMLParser $parser, callable|string|null $handler): true
    function xml_set_processing_instruction_handler(\XMLParser $parser, XmlProcessingInstructionHandler|string|null $handler): true;
    // @overlay-against: function xml_set_start_namespace_decl_handler(\XMLParser $parser, callable|string|null $handler): true
    function xml_set_start_namespace_decl_handler(\XMLParser $parser, XmlStartNamespaceDeclHandler|string|null $handler): true;
    // @overlay-against: function xml_set_unparsed_entity_decl_handler(\XMLParser $parser, callable|string|null $handler): true
    function xml_set_unparsed_entity_decl_handler(\XMLParser $parser, XmlUnparsedEntityDeclHandler|string|null $handler): true;
}
