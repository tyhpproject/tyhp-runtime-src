<?tyhp

function test_driver_detector_mysql(): string
{
    return \PHPStan\Doctrine\Driver\DriverDetector::MYSQLI;
}

function test_driver_detect(\Doctrine\DBAL\Connection $connection): ?string
{
    return (new \PHPStan\Doctrine\Driver\DriverDetector())->detect($connection);
}

function test_doctrine_diagnose_extension(\PHPStan\Type\Doctrine\ObjectMetadataResolver $resolver, \PHPStan\Doctrine\Driver\DriverDetector $detector): \PHPStan\Doctrine\DoctrineDiagnoseExtension
{
    return new \PHPStan\Doctrine\DoctrineDiagnoseExtension($resolver, $detector);
}
