{
  "name": "tyhpdef/phpdocumentor-reflection-docblock",
  "description": "Tyhp type definitions for the Composer package phpdocumentor/reflection-docblock (6.0.3).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "6.0.3.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/phpdocumentor-type-resolver": "@dev",
        "tyhpdef/phpdocumentor-reflection-common": "@dev",
        "tyhpdef/phpstan-phpdoc-parser": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "phpdocumentor/reflection-docblock": "6.0.3"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/phpdocumentor-type-resolver": "@dev",
    "tyhpdef/phpdocumentor-reflection-common": "@dev",
    "tyhpdef/phpstan-phpdoc-parser": "@dev"
  },
    "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../phpdocumentor-type-resolver/2.0.0"
    },
    {
      "type": "path",
      "url": "../../phpdocumentor-reflection-common/2.2.0"
    },
    {
      "type": "path",
      "url": "../../phpstan-phpdoc-parser/2.3.5"
    }
  ]
}
