<?tyhp

function test_docblock_factory(): \phpDocumentor\Reflection\DocBlockFactoryInterface
{
    return \phpDocumentor\Reflection\DocBlockFactory::createInstance();
}

function test_docblock_create(\phpDocumentor\Reflection\DocBlockFactoryInterface $factory): \phpDocumentor\Reflection\DocBlock
{
    return $factory->create('/** @var string $name */');
}
