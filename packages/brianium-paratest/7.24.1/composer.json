{
    "name": "tyhpdef/brianium-paratest",
    "description": "Tyhp type definitions for the Composer package brianium/paratest (7.24.1).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.24.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.4",
            "require": {
                "tyhpdef/php": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "brianium/paratest": "7.24.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        }
    ]
}