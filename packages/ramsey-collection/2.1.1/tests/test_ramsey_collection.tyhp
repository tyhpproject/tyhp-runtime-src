<?tyhp

function test_ramsey_collection_new(): \Ramsey\Collection\Collection<string>
{
    return new \Ramsey\Collection\Collection<string>('string', ['a', 'b']);
}

function test_ramsey_collection_add(\Ramsey\Collection\Collection<string> $c): bool
{
    return $c->add('c');
}

function test_ramsey_collection_to_array(\Ramsey\Collection\Collection<string> $c): array<int|string, mixed>
{
    return $c->toArray();
}

function test_ramsey_collection_count(\Ramsey\Collection\Collection<int> $c): int
{
    return $c->count();
}
