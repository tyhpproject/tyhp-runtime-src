<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * startingFromFrame is a fluent filter; Layer 1 returned mixed.
 */

namespace Spatie\Backtrace {
    /**
     * Overlay: snippet lines are keyed by source line number.
     */
    type FrameSnippetLine = struct {
        int $line_number;
        string $text;
    };

    /**
     * Overlay: frame filters stay on Backtrace.
     */
    // @overlay-against: class Backtrace
    partial class Backtrace {
        // @overlay-against: function startingFromFrame(\Closure $startingFromFrameClosure): mixed
        public function startingFromFrame(\Closure $startingFromFrameClosure): self;
    }

    // @overlay-against: class Backtrace
    partial class Backtrace {
        /**
         * Overlay: `Backtrace::reduceArguments()` uses the documented types.
         */
        // @overlay-against: function reduceArguments(array|\Spatie\Backtrace\Arguments\ArgumentReducers|null $argumentReducers): self
        public function reduceArguments(array<int|string, __ClassName<\Spatie\Backtrace\Arguments\Reducers\ArgumentReducer>|\Spatie\Backtrace\Arguments\Reducers\ArgumentReducer>|\Spatie\Backtrace\Arguments\ArgumentReducers|null $argumentReducers = null): self;
    }

    // @overlay-against: class Frame
    partial class Frame {
        // @overlay-against: array|null $arguments
        public array<int|string, mixed>|null $arguments ?? null;

        // @overlay-against: function __construct(string $file, int $lineNumber, ?array $arguments, ?string $method, ?string $class, ?object $object, bool $isApplicationFrame, ?string $textSnippet, ?string $trimmedFilePath): void
        public function __construct(string $file, int $lineNumber, array<int|string, mixed>|null $arguments, ?string $method = null, ?string $class = null, ?object $object = null, bool $isApplicationFrame = false, ?string $textSnippet = null, ?string $trimmedFilePath = null): void;

        // @overlay-against: function getSnippet(int $lineCount): array
        public function getSnippet(int $lineCount): array<int, string>;

        // @overlay-against: function getSnippetProperties(int $lineCount): array
        public function getSnippetProperties(int $lineCount): array<int, FrameSnippetLine>;
    }
}

namespace Spatie\Backtrace\Arguments {
    /**
     * Overlay: `ProvidedArgument::toArray()` row.
     */
    type ProvidedArgumentArray = struct {
        string $name;
        mixed $value;
        string|null $original_type;
        bool $passed_by_reference;
        bool $is_variadic;
        bool $truncated;
    };

    // @overlay-against: class ArgumentReducers
    partial class ArgumentReducers {
        /**
         * Overlay: `ArgumentReducers::create()` uses the documented types.
         */
        // @overlay-against: function create(array $argumentReducers): self
        public static function create(array<int|string, \Spatie\Backtrace\Arguments\Reducers\ArgumentReducer|__ClassName<\Spatie\Backtrace\Arguments\Reducers\ArgumentReducer>> $argumentReducers): self;

        // @overlay-against: function default(array $extra): self
        public static function default(array<int|string, \Spatie\Backtrace\Arguments\Reducers\ArgumentReducer|__ClassName<\Spatie\Backtrace\Arguments\Reducers\ArgumentReducer>> $extra = []): self;

        // @overlay-against: function minimal(array $extra): self
        public static function minimal(array<int|string, \Spatie\Backtrace\Arguments\Reducers\ArgumentReducer|__ClassName<\Spatie\Backtrace\Arguments\Reducers\ArgumentReducer>> $extra = []): self;
    }

    // @overlay-against: class ProvidedArgument
    partial class ProvidedArgument {
        // @overlay-against: function toArray(): array
        public function toArray(): ProvidedArgumentArray;
    }

    // @overlay-against: class ReduceArgumentsAction
    partial class ReduceArgumentsAction {
        // @overlay-against: function execute(?string $class, ?string $method, ?array $frameArguments): ?array
        public function execute(?string $class, ?string $method, array<int|string, mixed>|null $frameArguments): ?array<int|string, ProvidedArgumentArray>;
    }
}

namespace Spatie\Backtrace\Arguments\ReducedArgument {
    // @overlay-against: class VariadicReducedArgument extends \Spatie\Backtrace\Arguments\ReducedArgument\ReducedArgument
    partial class VariadicReducedArgument {
        // @overlay-against: function __construct(array $value): void
        public function __construct(array<int|string, \Spatie\Backtrace\Arguments\ReducedArgument\ReducedArgument> $value): void;
    }
}

namespace Spatie\Backtrace\CodeSnippets {
    // @overlay-against: class CodeSnippet
    partial class CodeSnippet {
        // @overlay-against: function get(\Spatie\Backtrace\CodeSnippets\SnippetProvider $provider): array
        public function get(\Spatie\Backtrace\CodeSnippets\SnippetProvider $provider): array<int, string>;
    }
}
