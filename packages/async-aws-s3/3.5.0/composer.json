{
    "name": "tyhpdef/async-aws-s3",
    "description": "Tyhp type definitions for the Composer package async-aws/s3 (3.5.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "3.5.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/async-aws-core": "@dev",
                "tyhpdef/symfony-http-client-contracts": "@dev",
                "tyhpdef/psr-log": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "async-aws/s3": "3.5.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/async-aws-core": "@dev",
        "tyhpdef/symfony-http-client-contracts": "@dev",
        "tyhpdef/psr-log": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../async-aws-core/1.30.0"
        },
        {
            "type": "path",
            "url": "../../symfony-http-client-contracts/3.7.3"
        },
        {
            "type": "path",
            "url": "../../psr-log/3.0.2"
        }
    ]
}
