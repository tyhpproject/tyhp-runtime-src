<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under `overlays/stubs/`).
 *
 * `\Laravel\Pulse\Livewire\Card` stays on Layer 1 now that
 * `tyhpdef/livewire-livewire` provides `\Livewire\Component`.
 */

namespace Laravel\Pulse\Recorders\Concerns {
    /**
     * Overlay: documented array shape.
     */
    type LivewireRoutesResolveRoutePathResult = struct {
        string 0 as $_0;
        ?string 1 as $_1;
    };

    // @overlay-against: trait LivewireRoutes
    partial trait LivewireRoutes {
        /**
         * Overlay: `LivewireRoutes::resolveRoutePath()` uses the documented types.
         */
        // @overlay-against: function resolveRoutePath(\Illuminate\Http\Request $request): array
        protected function resolveRoutePath(\Illuminate\Http\Request $request): LivewireRoutesResolveRoutePathResult;
    }
}

namespace Laravel\Pulse {
    /**
     * Overlay: documented array shape.
     */
    type EntryAttributesResult = struct {
        string $key;
        int $timestamp;
        string $type;
        ?int $value;
    };

    /**
     * Overlay: `Value::attributes()` returns these keys.
     */
    type ValueAttributesResult = struct {
        string $key;
        int $timestamp;
        string $type;
        string $value;
    };

    // @overlay-against: class Entry
    partial class Entry {
        /**
         * Overlay: `Entry::attributes()` uses the documented types.
         */
        // @overlay-against: function attributes(): array
        public function attributes(): EntryAttributesResult;
    }

    // @overlay-against: class LegacyUsers implements \Laravel\Pulse\Contracts\ResolvesUsers
    partial class LegacyUsers {
        /**
         * Overlay: `load()` invokes the callback with the key collection and stores a `Collection`.
         */
        // @overlay-against: function __construct(callable $callback): void
        public function __construct(callable(\Illuminate\Support\Collection): \Illuminate\Support\Collection $callback): void;
    }

    // @overlay-against: class Users implements \Laravel\Pulse\Contracts\ResolvesUsers
    partial class Users {
        /**
         * Overlay: `Users::$fieldResolver` uses the documented type.
         */
        // @overlay-against: ?callable $fieldResolver
        protected ?callable(\Illuminate\Contracts\Auth\Authenticatable): mixed $fieldResolver ?? null;

        /**
         * Overlay: `find()` invokes the resolver with the resolved user.
         */
        // @overlay-against: function setFieldResolver(callable $resolver): self
        public function setFieldResolver(callable(\Illuminate\Contracts\Auth\Authenticatable): mixed $resolver): self;
    }

    // @overlay-against: class Value
    partial class Value {
        /**
         * Overlay: `Value::attributes()` returns the constructor fields.
         */
        // @overlay-against: function attributes(): array
        public function attributes(): ValueAttributesResult;
    }
}

namespace Laravel\Pulse\Contracts {
    // @overlay-against: interface Storage
    partial interface Storage {
        /**
         * Overlay: `DatabaseStorage::aggregate()` wraps `$aggregates` into a list of strings.
         */
        // @overlay-against: function aggregate(string $type, string|array $aggregates, \Carbon\CarbonInterval $interval, ?string $orderBy, string $direction, int $limit): \Illuminate\Support\Collection
        public function aggregate(string $type, string|array<int, string> $aggregates, \Carbon\CarbonInterval $interval, ?string $orderBy = null, string $direction = 'desc', int $limit = 101): \Illuminate\Support\Collection;

        /**
         * Overlay: `Storage::aggregateTotal()` uses the sibling `$types` list.
         */
        // @overlay-against: function aggregateTotal(array|string $types, string $aggregate, \Carbon\CarbonInterval $interval): float|\Illuminate\Support\Collection
        public function aggregateTotal(array<int, string>|string $types, string $aggregate, \Carbon\CarbonInterval $interval): float|\Illuminate\Support\Collection;

        /**
         * Overlay: `Storage::aggregateTypes()` uses the sibling `$types` list.
         */
        // @overlay-against: function aggregateTypes(string|array $types, string $aggregate, \Carbon\CarbonInterval $interval, ?string $orderBy, string $direction, int $limit): \Illuminate\Support\Collection
        public function aggregateTypes(string|array<int, string> $types, string $aggregate, \Carbon\CarbonInterval $interval, ?string $orderBy = null, string $direction = 'desc', int $limit = 101): \Illuminate\Support\Collection;
    }
}

namespace Laravel\Pulse\Facades {
    // @overlay-against: class Pulse extends \Illuminate\Support\Facades\Facade
    partial class Pulse {
        /**
         * Overlay: `ConfiguresAfterResolving::afterResolving()` calls `$callback($app->make($class))`.
         */
        // @overlay-against: function afterResolving(\Illuminate\Contracts\Foundation\Application $app, string $class, \Closure $callback): void
        public static function afterResolving(\Illuminate\Contracts\Foundation\Application $app, string $class, \Closure<callable(mixed): mixed> $callback): void;

        /**
         * Overlay: `Pulse::aggregate()` uses `Storage`'s aggregate list.
         */
        // @overlay-against: function aggregate(string $type, string|array $aggregates, \Carbon\CarbonInterval $interval, string|null $orderBy, string $direction, int $limit): \Illuminate\Support\Collection
        public static function aggregate(string $type, string|array<int, string> $aggregates, \Carbon\CarbonInterval $interval, string|null $orderBy, string $direction, int $limit): \Illuminate\Support\Collection;

        /**
         * Overlay: `Pulse::aggregateTotal()` uses `Storage`'s type list.
         */
        // @overlay-against: function aggregateTotal(string|array $types, string $aggregate, \Carbon\CarbonInterval $interval): float|\Illuminate\Support\Collection
        public static function aggregateTotal(string|array<int, string> $types, string $aggregate, \Carbon\CarbonInterval $interval): float|\Illuminate\Support\Collection;

        /**
         * Overlay: `Pulse::aggregateTypes()` uses `Storage`'s type list.
         */
        // @overlay-against: function aggregateTypes(string|array $types, string $aggregate, \Carbon\CarbonInterval $interval, string|null $orderBy, string $direction, int $limit): \Illuminate\Support\Collection
        public static function aggregateTypes(string|array<int, string> $types, string $aggregate, \Carbon\CarbonInterval $interval, string|null $orderBy, string $direction, int $limit): \Illuminate\Support\Collection;

        /**
         * Overlay: `Pulse::authenticatedUserIdResolver()` returns a zero-arg closure of `ResolvesUsers::key()`.
         */
        // @overlay-against: function authenticatedUserIdResolver(): callable
        public static function authenticatedUserIdResolver(): callable(): int|string|null;

        /**
         * Overlay: `Pulse::defaultVendorCacheKeys()` returns a list of cache-key patterns.
         */
        // @overlay-against: function defaultVendorCacheKeys(): array
        public static function defaultVendorCacheKeys(): array<int, string>;

        /**
         * Overlay: `Pulse::graph()` uses `Storage`'s type list.
         */
        // @overlay-against: function graph(array $types, string $aggregate, \Carbon\CarbonInterval $interval): \Illuminate\Support\Collection
        public static function graph(array<int, string> $types, string $aggregate, \Carbon\CarbonInterval $interval): \Illuminate\Support\Collection;

        /**
         * Overlay: `Pulse::ignore()` invokes the callback with no arguments.
         */
        // @overlay-against: function ignore(callable $callback): mixed
        public static function ignore(callable(): mixed $callback): mixed;

        /**
         * Overlay: `Pulse::purge()` uses `Storage`'s type list.
         */
        // @overlay-against: function purge(array $types): void
        public static function purge(array<int, string> $types): void;

        /**
         * Overlay: `Pulse::rescue()` invokes the callback with no arguments.
         */
        // @overlay-against: function rescue(callable $callback): mixed
        public static function rescue(callable(): mixed $callback): mixed;

        /**
         * Overlay: `Pulse::values()` uses `Storage`'s key list.
         */
        // @overlay-against: function values(string $type, array $keys): \Illuminate\Support\Collection
        public static function values(string $type, array<int, string> $keys): \Illuminate\Support\Collection;
    }
}

namespace Laravel\Pulse\Http\Middleware {
    // @overlay-against: class Authorize
    partial class Authorize {
        /**
         * Overlay: `Authorize::handle()` returns `$next($request)`.
         */
        // @overlay-against: function handle(\Illuminate\Http\Request $request, \Closure $next): mixed
        public function handle(\Illuminate\Http\Request $request, \Closure<callable(\Illuminate\Http\Request): mixed> $next): mixed;
    }
}

namespace Laravel\Pulse\Livewire\Concerns {
    /**
     * Overlay: documented array shape.
     */
    type RemembersQueriesRememberResult = struct {
        mixed 0 as $_0;
        float 1 as $_1;
        string 2 as $_2;
    };

    // @overlay-against: trait RemembersQueries
    partial trait RemembersQueries {
        /**
         * Overlay: `RemembersQueries::remember()` uses the documented types.
         */
        // @overlay-against: function remember(callable $query, string $key, \DateTimeInterface|\DateInterval|\Closure|int|null $ttl): array
        protected function remember(callable $query, string $key = '', \DateTimeInterface|\DateInterval|\Closure|int|null $ttl = 5): RemembersQueriesRememberResult;
    }
}
