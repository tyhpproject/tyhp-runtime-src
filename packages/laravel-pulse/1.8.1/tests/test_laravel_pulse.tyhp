{
    return new \Laravel\Pulse\Entry(1, 'cache_hit', 'users');
}

function test_pulse_entry_count(): \Laravel\Pulse\Entry
{
    return (new \Laravel\Pulse\Entry(1, 'cache_hit', 'users'))->count();
}

