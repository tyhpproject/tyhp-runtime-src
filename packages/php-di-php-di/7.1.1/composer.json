{
  "name": "tyhpdef/php-di-php-di",
  "description": "Tyhp type definitions for the Composer package php-di/php-di (7.1.1).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "7.1.1.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/php-di-invoker": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "php-di/php-di": "7.1.1"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/psr-container": "@dev",
    "tyhpdef/php-di-invoker": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../psr-container/2.0.2"
    },
    {
      "type": "path",
      "url": "../../php-di-invoker/2.3.7"
    }
  ]
}
