<?tyhp

function test_php_di_container(): \Psr\Container\ContainerInterface
{
    return new \DI\Container();
}

function test_php_di_get(\DI\Container $c): \stdClass
{
    return $c->get(\stdClass::class);
}

function test_php_di_has(\DI\Container $c): bool
{
    return $c->has(\stdClass::class);
}

function test_php_di_call(\DI\Container $c): mixed
{
    return $c->call(static fn (): int => 1);
}
