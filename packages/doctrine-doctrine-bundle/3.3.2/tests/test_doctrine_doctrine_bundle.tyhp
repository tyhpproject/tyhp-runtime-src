<?tyhp

function test_as_doctrine_listener(): \Doctrine\Bundle\DoctrineBundle\Attribute\AsDoctrineListener
{
    return new \Doctrine\Bundle\DoctrineBundle\Attribute\AsDoctrineListener('postPersist');
}

function test_service_entity_repository_interface(): bool
{
    return true;
}

function test_mapping_driver(\Doctrine\Persistence\Mapping\Driver\MappingDriver $inner, \Psr\Container\ContainerInterface $locator): \Doctrine\Bundle\DoctrineBundle\Mapping\MappingDriver
{
    return new \Doctrine\Bundle\DoctrineBundle\Mapping\MappingDriver($inner, $locator);
}
