<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Fluent setters keep their real return (`static` / `Google2FA`, or void when PHP returns nothing).
 * HMAC algorithms are `sha1` / `sha256` / `sha512`. Secret checks return void.
 */

namespace PragmaRX\Google2FA {
    /**
     * Overlay: setter parameters match the typed getters.
     */
    // @overlay-against: class Google2FA implements \PragmaRX\Google2FA\Support\QRCode, \PragmaRX\Google2FA\Support\Base32
    partial class Google2FA {
        /**
         * HMAC names this instance accepts (`sha1`, `sha256`, `sha512`).
         *
         * @return array<int, 'sha1'|'sha256'|'sha512'>
         */
        // @overlay-against: function getValidAlgorithms(): array
        protected function getValidAlgorithms(): array<int, 'sha1'|'sha256'|'sha512'>;

        // @overlay-against: function setAlgorithm(mixed $algorithm): \PragmaRX\Google2FA\Google2FA
        public function setAlgorithm('sha1'|'sha256'|'sha512' $algorithm): \PragmaRX\Google2FA\Google2FA;

        // @overlay-against: function setEnforceGoogleAuthenticatorCompatibility(mixed $enforceGoogleAuthenticatorCompatibility): static
        public function setEnforceGoogleAuthenticatorCompatibility(bool $enforceGoogleAuthenticatorCompatibility): static;

        // @overlay-against: function setKeyRegeneration(mixed $keyRegeneration): mixed
        public function setKeyRegeneration(int $keyRegeneration): void;

        // @overlay-against: function setOneTimePasswordLength(mixed $oneTimePasswordLength): mixed
        public function setOneTimePasswordLength(int $oneTimePasswordLength): void;

        // @overlay-against: function setSecret(mixed $secret): mixed
        public function setSecret(string $secret): void;

        // @overlay-against: function setWindow(mixed $window): mixed
        public function setWindow(int $window): void;
    }
}

namespace PragmaRX\Google2FA\Support {
    /**
     * Overlay: secret checks throw or return; they do not produce a value.
     */
    // @overlay-against: trait Base32
    partial trait Base32 {
        // @overlay-against: function checkForValidCharacters(string $b32): mixed
        protected function checkForValidCharacters(string $b32): void;

        // @overlay-against: function checkGoogleAuthenticatorCompatibility(string $b32): mixed
        protected function checkGoogleAuthenticatorCompatibility(string $b32): void;

        // @overlay-against: function checkIsBigEnough(string $b32): mixed
        protected function checkIsBigEnough(string $b32): void;

        // @overlay-against: function validateSecret(string $b32): mixed
        protected function validateSecret(string $b32): void;
    }
}
