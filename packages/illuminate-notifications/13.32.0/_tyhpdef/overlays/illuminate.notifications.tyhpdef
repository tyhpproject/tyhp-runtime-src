<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * DatabaseNotification and DatabaseNotificationCollection replace the Layer 1
 * types without Eloquent parents. Members that name MorphTo, Builder, or
 * HasCollection stay off. MorphMany comes from tyhpdef/illuminate-database.
 */

namespace Illuminate\Notifications {
    /**
     * Overlay: keep the harvested DatabaseNotification API without an Eloquent parent.
     * notifiable, scopeRead, and scopeUnread stay off with MorphTo and Builder.
     */
    // @overlay-against: class DatabaseNotification extends \Illuminate\Database\Eloquent\Model implements \Illuminate\Database\Eloquent\HasCollection
    class DatabaseNotification {
        // @overlay-against: string $collectionClass
        protected static string $collectionClass ?? \Illuminate\Notifications\DatabaseNotificationCollection::class;
        // @overlay-against: bool $incrementing
        public bool $incrementing ?? false;
        // @overlay-against: array $casts
        protected array $casts ?? [];
        // @overlay-against: array $guarded
        protected array<string> $guarded ?? [];
        // @overlay-against: string $keyType
        protected string $keyType ?? 'string';
        // @overlay-against: string $table
        protected string $table ?? 'notifications';
        // @overlay-against: function markAsRead(): void
        public function markAsRead(): void;
        // @overlay-against: function markAsUnread(): void
        public function markAsUnread(): void;
        // @overlay-against: function read(): bool
        public function read(): bool;
        // @overlay-against: function unread(): bool
        public function unread(): bool;
    }

    /**
     * Overlay: keep the harvested collection helpers without an Eloquent parent.
     */
    // @overlay-against: class DatabaseNotificationCollection extends \Illuminate\Database\Eloquent\Collection
    class DatabaseNotificationCollection<TKey extends mixed, TModel extends \Illuminate\Notifications\DatabaseNotification> {
        // @overlay-against: function markAsRead(): void
        public function markAsRead(): void;
        // @overlay-against: function markAsUnread(): void
        public function markAsUnread(): void;
    }

    /**
     * Overlay: keep the harvested Notification API and SerializesModels.
     */
    // @overlay-against: class Notification implements \Illuminate\Queue\SerializesModels
    class Notification {
        use \Illuminate\Queue\SerializesModels;
        // @overlay-against: string $id
        public string $id;
        // @overlay-against: string|null $locale
        public string|null $locale;
        // @overlay-against: function broadcastOn(): array
        public function broadcastOn(): array;
        // @overlay-against: function locale(string $locale): static
        public function locale(string $locale): static;
    }
}

namespace Illuminate\Notifications {
    /**
     * Overlay: PHPDoc shapes, class-strings, and conditionals harvest left loose.
     */
    // @overlay-against: class ChannelManager extends \Illuminate\Support\Manager implements \Illuminate\Contracts\Notifications\Dispatcher, \Illuminate\Contracts\Notifications\Factory, \Illuminate\Support\Traits\Macroable, \Illuminate\Support\Queue\Concerns\ResolvesQueueRoutes
    partial class ChannelManager {
