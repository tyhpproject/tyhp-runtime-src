        public function send(\Illuminate\Support\Collection|mixed $notifiables, mixed $notification): void;
        // @overlay-against: function sendNow(mixed $notifiables, mixed $notification, array|null $channels): void
        public function sendNow(\Illuminate\Support\Collection|mixed $notifiables, mixed $notification, array<int, string>|null $channels = null): void;
    }
    /**
     * Overlay: PHPDoc shapes, class-strings, and conditionals harvest left loose.
     */
    // @overlay-against: class NotificationSender implements \Illuminate\Support\Traits\Localizable, \Illuminate\Queue\Attributes\ReadsQueueAttributes
    partial class NotificationSender {
        // @overlay-against: function send(mixed $notifiables, mixed $notification): void
        public function send(\Illuminate\Support\Collection|mixed $notifiables, mixed $notification): void;
