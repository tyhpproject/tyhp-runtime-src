        public function sendNow(\Illuminate\Support\Collection|mixed $notifiables, mixed $notification, array<int, string>|null $channels = null): void;
    }
}

namespace Illuminate\Notifications\Events {
    /**
     * Overlay: broadcast payload values are the notification data. id and type are strings merged in by the event.
     */
    // @overlay-against: class BroadcastNotificationCreated implements \Illuminate\Contracts\Broadcasting\ShouldBroadcast, \Illuminate\Bus\Queueable, \Illuminate\Queue\SerializesModels
    partial class BroadcastNotificationCreated {
        // @overlay-against: array $data
        public array<int|string, mixed> $data ?? [];
        // @overlay-against: function __construct(mixed $notifiable, \Illuminate\Notifications\Notification $notification, array $data): void
        public function __construct(mixed $notifiable, \Illuminate\Notifications\Notification $notification, array<int|string, mixed> $data = []): void;
        // @overlay-against: function broadcastWith(): array
        public function broadcastWith(): array<int|string, mixed>;
    }
}

namespace Illuminate\Notifications\Messages {
    /**
     * Overlay: broadcast message data is a JSON document.
     */
    // @overlay-against: class BroadcastMessage implements \Illuminate\Bus\Queueable
    partial class BroadcastMessage {
