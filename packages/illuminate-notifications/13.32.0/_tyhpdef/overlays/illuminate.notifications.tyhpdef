        public function __construct(array<int|string, mixed> $data): void;
        // @overlay-against: function data(array $data): static
        public function data(array<int|string, mixed> $data): static;
    }

    /**
     * Overlay: database message data is a JSON document.
     */
    // @overlay-against: class DatabaseMessage
    partial class DatabaseMessage {
        // @overlay-against: array $data
        public array<int|string, mixed> $data ?? [];
        // @overlay-against: function __construct(array $data): void
        public function __construct(array<int|string, mixed> $data = []): void;
    }
}

namespace Illuminate\Notifications\Messages {
    /**
     * Overlay: mail view data is a string-keyed map. The view argument may be a list of view names.
     */
    // @overlay-against: class MailMessage extends \Illuminate\Notifications\Messages\SimpleMessage implements \Illuminate\Contracts\Support\Renderable, \Illuminate\Support\Traits\Conditionable
    partial class MailMessage {
        // @overlay-against: function markdown(string $view, array $data): static
        public function markdown(string $view, array<string, mixed> $data = []): static;
        // @overlay-against: function text(string $textView, array $data): static
        public function text(string $textView, array<string, mixed> $data = []): static;
        // @overlay-against: function view(array|string $view, array $data): static
        public function view(array<int, string>|string $view, array<string, mixed> $data = []): static;
    }
}
