<?tyhp

function test_unique_entity_message(): string
{
    $constraint = new \Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity();
    return $constraint->message;
}

function test_map_entity_class(): ?string
{
    $map = new \Symfony\Bridge\Doctrine\Attribute\MapEntity();
    $map->class = 'App\\Entity\\User';
    return $map->class;
}
