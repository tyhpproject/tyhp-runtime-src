namespace Symfony\Bridge\Doctrine {
    /**
     * One lazy listener registered as `[event names, listener or service id]`.
     */
    type DoctrineListenerSpec = struct {
        array<int, string> 0 as $events;
        string|object 1 as $listener;
    };

    /**
     * Overlay: constructor tuples and listener maps. Harvest left bare `array`.
     */
    // @overlay-against: class ContainerAwareEventManager extends \Doctrine\Common\EventManager
    partial class ContainerAwareEventManager {
        /**
         * @param array<int, \Symfony\Bridge\Doctrine\DoctrineListenerSpec> $listeners
         */
        // @overlay-against: function __construct(\Psr\Container\ContainerInterface $container, array $listeners): void
        public function __construct(\Psr\Container\ContainerInterface $container, array<int, \Symfony\Bridge\Doctrine\DoctrineListenerSpec> $listeners = []): void;

        /**
         * @param string|array<int, string> $events
         */
        // @overlay-against: function addEventListener(string|array $events, object|string $listener): void
        public function addEventListener(string|array<int, string> $events, object|string $listener): void;

        /**
         * @return array<string, array<string, object|string>>
         */
        // @overlay-against: function getAllListeners(): array
        public function getAllListeners(): array<string, array<string, object|string>>;

        /**
         * @return array<string, object|string>
         */
        // @overlay-against: function getListeners(string $event): array
        public function getListeners(string $event): array<string, object|string>;

        /**
         * @param string|array<int, string> $events
         */
        // @overlay-against: function removeEventListener(string|array $events, object|string $listener): void
        public function removeEventListener(string|array<int, string> $events, object|string $listener): void;
    }
}

