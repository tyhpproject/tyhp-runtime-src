<?tyhp

function test_oauth2_generic_provider(): \League\OAuth2\Client\Provider\GenericProvider
{
    return new \League\OAuth2\Client\Provider\GenericProvider([
        'clientId' => 'demo-id',
        'clientSecret' => 'demo-secret',
        'redirectUri' => 'https://example.com/callback',
        'urlAuthorize' => 'https://example.com/authorize',
        'urlAccessToken' => 'https://example.com/token',
        'urlResourceOwnerDetails' => 'https://example.com/user',
    ]);
}

function test_oauth2_authorization_url(\League\OAuth2\Client\Provider\GenericProvider $provider): string
{
    return $provider->getAuthorizationUrl(['scope' => ['email']]);
}

function test_oauth2_access_token(): \League\OAuth2\Client\Token\AccessToken
{
    return new \League\OAuth2\Client\Token\AccessToken([
        'access_token' => 'tok',
        'expires_in' => 3600,
    ]);
}

function test_oauth2_token_expired(\League\OAuth2\Client\Token\AccessToken $token): bool
{
    return $token->hasExpired();
}
