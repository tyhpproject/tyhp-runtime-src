<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `gzfile()` line list and incremental deflate/inflate option shapes.
 * Inflate/deflate contexts are already objects in Layer 1.
 * Declaration order: TYHPDEF_ORDERING.md.
 */

/**
 * Overlay: `deflate_init()` / `inflate_init()` `$options` keys.
 */
type ZlibContextOptions = struct {
    ?(string|array<int, string>) $dictionary;
    ?int $level;
    ?int $memory;
    ?int $strategy;
    ?int $window;
};

#[\Tyhp\Optimize\Pure]
// @overlay-against: function gzcompress
partial function gzcompress;

#[\Tyhp\Optimize\Pure]
// @overlay-against: function gzdecode
partial function gzdecode;

#[\Tyhp\Optimize\Pure]
// @overlay-against: function gzdeflate
partial function gzdeflate;

#[\Tyhp\Optimize\Pure]
// @overlay-against: function gzencode
partial function gzencode;

#[\Tyhp\Optimize\Pure]
// @overlay-against: function gzinflate
partial function gzinflate;

#[\Tyhp\Optimize\Pure]
// @overlay-against: function gzuncompress
partial function gzuncompress;

#[\Tyhp\Optimize\Pure]
// @overlay-against: function zlib_decode
partial function zlib_decode;

#[\Tyhp\Optimize\Pure]
// @overlay-against: function zlib_encode
partial function zlib_encode;

declare(php="<8.3") {
    // @overlay-against: function deflate_init(int $encoding, array $options): \DeflateContext|false
    function deflate_init(int $encoding, ZlibContextOptions $options = []): \DeflateContext|false;

    // @overlay-against: function inflate_init(int $encoding, array $options): \InflateContext|false
    function inflate_init(int $encoding, ZlibContextOptions $options = []): \InflateContext|false;
}

declare(php="<8.5") {
    // @overlay-against: function gzfile(string $filename, int $use_include_path): array|false
    function gzfile(string $filename, int $use_include_path = 0): array<int, string>|false;
}

declare(php=">=8.3") {
    // @overlay-against: function deflate_init(int $encoding, object|array $options): \DeflateContext|false
    function deflate_init(int $encoding, object|ZlibContextOptions $options = []): \DeflateContext|false;

    // @overlay-against: function inflate_init(int $encoding, object|array $options): \InflateContext|false
    function inflate_init(int $encoding, object|ZlibContextOptions $options = []): \InflateContext|false;
}

declare(php=">=8.5") {
    // @overlay-against: function gzfile(string $filename, bool $use_include_path): array|false
    function gzfile(string $filename, bool $use_include_path = false): array<int, string>|false;
}
