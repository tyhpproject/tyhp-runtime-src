<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Omits TipTap-typed RichEditor APIs and TipTap extension classes; this wrapper
 * does not include ueberdosis/tiptap-php. Also omits TableSelectLivewireComponent
 * (filament/tables is not required by this wrapper).
 */

