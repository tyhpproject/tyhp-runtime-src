{
    "name": "tyhpdef/pestphp-pest",
    "description": "Tyhp type definitions for the Composer package pestphp/pest (4.7.8).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "4.7.8.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.3",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/phpunit-phpunit": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "pestphp/pest": "4.7.8"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/phpunit-phpunit": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../phpunit-phpunit/12.5.33"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
