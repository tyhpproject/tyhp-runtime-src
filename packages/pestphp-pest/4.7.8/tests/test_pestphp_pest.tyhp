<?tyhp

function test_pest_version(): string
{
    return \Pest\version();
}

function test_pest_expect_construct(): \Pest\Expectation<int>
{
    return new \Pest\Expectation<int>(1);
}

function test_pest_expect_helper(): \Pest\Expectation<int>
{
    int $value = 1;
    return \expect($value);
}

function test_pest_expect_to_be(): \Pest\Expectation<int>
{
    return (new \Pest\Expectation<int>(1))->toBe(1);
}

function test_pest_has_method(): bool
{
    return \Pest\Expectation::hasMethod('toBe');
}
