namespace Pest\Contracts\Plugins {
    interface HandlesArguments {
        /**
         * @param array<int, string> $arguments
         * @return array<int, string>
         */
        public function handleArguments(array<int|string, string> $arguments): array<int|string, string>;
    }
}

namespace Pest\Plugins\Concerns {
    trait HandleArguments {
    }
}

namespace Pest\Plugins\Parallel\Paratest {
    // @overlay-against: class CleanConsoleOutput extends \Symfony\Component\Console\Output\ConsoleOutput
    omit final class CleanConsoleOutput {};
}

namespace Pest {
    /**
     * Overlay: mixin `toBe` from `Pest\Mixins\Expectation`.
     */
    // @overlay-against: class Expectation implements \Pest\Concerns\Extendable, \Pest\Concerns\Pipeable, \Pest\Concerns\Retrievable
    partial class Expectation<TValue> {
        // @overlay-against: function __construct(TValue $value): void
        public function __construct(TValue $value);

        public function toBe(mixed $expected, string $message = ''): self;

        /**
         * @param (callable(\Pest\Expectation<TValue>, int|string): mixed)|null $callback
         */
        // @overlay-against: function each(?callable $callback): \Pest\Expectations\EachExpectation
        public function each(?callable(\Pest\Expectation<TValue>, int|string): mixed $callback = null): \Pest\Expectations\EachExpectation;

        /**
         * @param (callable(\Pest\Expectation<TValue>, \Pest\Expectation<int|string>): void)|TSequenceValue ...$callbacks
         */
        // @overlay-against: function sequence(mixed $callbacks): self
        public function sequence<TSequenceValue>((callable(\Pest\Expectation<TValue>, \Pest\Expectation<int|string>): void)|TSequenceValue ...$callbacks): self;

        /**
         * @param (callable(): TMatchSubject)|TMatchSubject $subject
         * @param array<TMatchSubject, (callable(\Pest\Expectation<TValue>): mixed)|TValue> $expressions
         */
        // @overlay-against: function match(callable|TMatchSubject $subject, array $expressions): self
        public function match<TMatchSubject extends int|string>((callable(): TMatchSubject)|TMatchSubject $subject, array<TMatchSubject, (callable(\Pest\Expectation<TValue>): mixed)|TValue> $expressions): self;

        /**
         * @param (callable(): bool)|bool $condition
         * @param callable(\Pest\Expectation<TValue>): mixed $callback
         */
        // @overlay-against: function unless(callable|bool $condition, callable $callback): \Pest\Expectation
        public function unless((callable(): bool)|bool $condition, callable(\Pest\Expectation<TValue>): mixed $callback): self;

        /**
         * @param (callable(): bool)|bool $condition
         * @param callable(\Pest\Expectation<TValue>): mixed $callback
         */
        // @overlay-against: function when(callable|bool $condition, callable $callback): self
        public function when((callable(): bool)|bool $condition, callable(\Pest\Expectation<TValue>): mixed $callback): self;
    }
}

namespace Pest {
    // @overlay-against: class Expectation implements \Pest\Concerns\Extendable, \Pest\Concerns\Pipeable, \Pest\Concerns\Retrievable
    partial class Expectation {
        // @overlay-against: function toBeUsedIn(array|string $targets): \Pest\Arch\Contracts\ArchExpectation
        public function toBeUsedIn(array<int|string, string>|string $targets): \Pest\Arch\Contracts\ArchExpectation;
        // @overlay-against: function toHaveMethod(array|string $method): \Pest\Arch\Contracts\ArchExpectation
        public function toHaveMethod(array<int|string, string>|string $method): \Pest\Arch\Contracts\ArchExpectation;
        // @overlay-against: function toImplement(array|string $interfaces): \Pest\Arch\Contracts\ArchExpectation
        public function toImplement(array<int|string, string>|string $interfaces): \Pest\Arch\Contracts\ArchExpectation;
        // @overlay-against: function toOnlyBeUsedIn(array|string $targets): \Pest\Arch\Contracts\ArchExpectation
        public function toOnlyBeUsedIn(array<int|string, string>|string $targets): \Pest\Arch\Contracts\ArchExpectation;
        // @overlay-against: function toOnlyImplement(array|string $interfaces): \Pest\Arch\Contracts\ArchExpectation
        public function toOnlyImplement(array<int|string, string>|string $interfaces): \Pest\Arch\Contracts\ArchExpectation;
        // @overlay-against: function toOnlyUse(array|string $targets): \Pest\Arch\Contracts\ArchExpectation
        public function toOnlyUse(array<int|string, string>|string $targets): \Pest\Arch\Contracts\ArchExpectation;
        // @overlay-against: function toUse(array|string $targets): \Pest\Arch\Contracts\ArchExpectation
        public function toUse(array<int|string, string>|string $targets): \Pest\Arch\Contracts\ArchExpectation;
        // @overlay-against: function toUseTraits(array|string $traits): \Pest\Arch\Contracts\ArchExpectation
        public function toUseTraits(array<int|string, string>|string $traits): \Pest\Arch\Contracts\ArchExpectation;
    }
}

