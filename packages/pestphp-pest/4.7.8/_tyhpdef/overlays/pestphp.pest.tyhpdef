<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Global Pest helpers from `src/Functions.php` are `fallback function` because each PHP declaration is inside `function_exists`. `toBe` comes from the Expectation mixin.
 * Hollow types fill names Layer 1 referenced but did not emit.
 */

extern interface \Symfony\Component\Console\Output\OutputInterface;
extern class \Symfony\Component\Console\Output\ConsoleOutput;
extern class \NunoMaduro\Collision\Adapters\Phpunit\State;
extern class \PHPUnit\TestRunner\TestResult\TestResult;

fallback function expect<TValue>(TValue $value): \Pest\Expectation<TValue>;

fallback function expect(): \Pest\Expectation<null>;

fallback function test(string $description, ?\Closure $closure = null): \Pest\PendingCalls\TestCall;

fallback function test(?string $description = null, ?\Closure $closure = null): \Pest\Support\HigherOrderTapProxy|\Pest\PendingCalls\TestCall;

fallback function it(string $description, ?\Closure $closure = null): \Pest\PendingCalls\TestCall;

fallback function describe(string $description, \Closure $tests): \Pest\PendingCalls\DescribeCall;

fallback function beforeEach(?\Closure $closure = null): \Pest\PendingCalls\BeforeEachCall;

fallback function afterEach(?\Closure $closure = null): \Pest\PendingCalls\AfterEachCall;

