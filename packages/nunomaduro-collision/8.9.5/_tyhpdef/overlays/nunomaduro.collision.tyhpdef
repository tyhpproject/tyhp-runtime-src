<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Laravel adapters name Illuminate types this package does not require — omit.
 * `TestOutcome` extends `\PHPUnit\Framework\Exception`, which the PHPUnit
 * wrapper does not declare; omit rather than inventing a hollow Exception.
 * Whoops / PHPUnit / Symfony Console are path-linked.
 */

namespace NunoMaduro\Collision {
    // @overlay-against: class ArgumentFormatter
    partial class ArgumentFormatter {
        // @overlay-against: function format(array $arguments, bool $recursive): string
        public function format(array<int, mixed> $arguments, bool $recursive = true): string;
    }

    /**
     * Overlay: themes map a name to a style or a list of styles.
     */
    // @overlay-against: class ConsoleColor
    partial class ConsoleColor {
        // @overlay-against: function addTheme(string $name, array|string $styles): void
        public function addTheme(string $name, array<int, string>|string $styles): void;

        // @overlay-against: function apply(array|string $style, string $text): string
        public function apply(array<int, string>|string $style, string $text): string;

        /**
         * @return array<int, string>
         */
        // @overlay-against: function getPossibleStyles(): array
        public function getPossibleStyles(): array<int, string>;

        /**
         * @return array<string, array<int, string>|string>
         */
        // @overlay-against: function getThemes(): array
        public function getThemes(): array<string, array<int, string>|string>;

        /**
         * @param array<string, array<int, string>|string> $themes
         */
        // @overlay-against: function setThemes(array $themes): void
        public function setThemes(array<string, array<int, string>|string> $themes): void;
    }
}

namespace NunoMaduro\Collision\Adapters\Laravel {
    // @overlay-against: class CollisionServiceProvider extends \Illuminate\Support\ServiceProvider
    omit class CollisionServiceProvider {
    }

    // @overlay-against: class ExceptionHandler implements \Illuminate\Contracts\Debug\ExceptionHandler
    omit final class ExceptionHandler {
    }

    // @overlay-against: class IgnitionSolutionsRepository implements \NunoMaduro\Collision\Contracts\SolutionsRepository
    omit final class IgnitionSolutionsRepository {
    }

    // @overlay-against: class Inspector extends \Whoops\Exception\Inspector
    omit final class Inspector {
    }
}

namespace NunoMaduro\Collision\Adapters\Laravel\Commands {
    // @overlay-against: class TestCommand extends \Illuminate\Console\Command
    omit class TestCommand {
    }
}

namespace NunoMaduro\Collision\Adapters\Laravel\Exceptions {
    // @overlay-against: class NotSupportedYetException extends \RuntimeException implements \NunoMaduro\Collision\Contracts\RenderlessEditor, \NunoMaduro\Collision\Contracts\RenderlessTrace
    omit final class NotSupportedYetException {
    }

    // @overlay-against: class RequirementsException extends \RuntimeException implements \NunoMaduro\Collision\Contracts\RenderlessEditor, \NunoMaduro\Collision\Contracts\RenderlessTrace
    omit final class RequirementsException {
    }
}

namespace NunoMaduro\Collision\Exceptions {
    /**
     * Overlay: extends `\PHPUnit\Framework\Exception`, which is not in the
     * PHPUnit wrapper Layer 1. Do not invent a hollow PHPUnit Exception.
     */
    // @overlay-against: class TestOutcome extends \PHPUnit\Framework\Exception
    omit final class TestOutcome {
    }
}

extern class \PHPUnit\TestRunner\TestResult\TestResult;
extern class \SebastianBergmann\CodeCoverage\Node\File;
