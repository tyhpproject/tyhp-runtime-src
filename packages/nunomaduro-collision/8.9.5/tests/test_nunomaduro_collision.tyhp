<?tyhp

function test_collision_provider(): \NunoMaduro\Collision\Provider
{
    return new \NunoMaduro\Collision\Provider();
}

function test_collision_register(\NunoMaduro\Collision\Provider $provider): \NunoMaduro\Collision\Provider
{
    return $provider->register();
}

function test_collision_handler(\NunoMaduro\Collision\Provider $provider): \NunoMaduro\Collision\Handler
{
    return $provider->getHandler();
}
