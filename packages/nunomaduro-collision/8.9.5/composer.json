{
    "name": "tyhpdef/nunomaduro-collision",
    "description": "Tyhp type definitions for the Composer package nunomaduro/collision (8.9.5).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "8.9.5.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/filp-whoops": "@dev",
                "tyhpdef/symfony-console": "@dev",
                "tyhpdef/phpunit-phpunit": "@dev",
                "tyhpdef/nunomaduro-termwind": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/symfony-event-dispatcher-contracts": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "nunomaduro/collision": "^8.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/filp-whoops": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/phpunit-phpunit": "@dev",
        "tyhpdef/nunomaduro-termwind": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/symfony-event-dispatcher-contracts": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../filp-whoops/2.18.4"
        },
        {
            "type": "path",
            "url": "../../symfony-console/7.4.19"
        },
        {
            "type": "path",
            "url": "../../phpunit-phpunit/12.5.35"
        },
        {
            "type": "path",
            "url": "../../nunomaduro-termwind/2.4.0"
        },
        {
            "type": "path",
            "url": "../../psr-log/3.0.2"
        },
        {
            "type": "path",
            "url": "../../psr-container/2.0.2"
        },
        {
            "type": "path",
            "url": "../../symfony-service-contracts/3.7.3"
        },
        {
            "type": "path",
            "url": "../../symfony-event-dispatcher-contracts/3.7.1"
        }
    ]
}
