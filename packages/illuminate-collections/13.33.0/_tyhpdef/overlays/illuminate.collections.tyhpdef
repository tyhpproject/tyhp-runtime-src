<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Global helpers in helpers.php (`collect()`, `value()`, `data_get()`, and the
 * rest of that file) are `fallback function` because each PHP declaration is
 * gated by `function_exists`. Arr PHPDoc type-guards and wrap/from conditionals
 * collapsed to `mixed` / `bool` in Layer 1.
 */

/**
 * Overlay: `collect($items)` is a Collection of those items.
 *
 * @param \Illuminate\Contracts\Support\Arrayable<TKey, TValue>|iterable<TKey, TValue>|null $value
 * @return \Illuminate\Support\Collection<TKey, TValue>
 */
fallback function collect<TKey extends int|string = int|string, TValue = mixed>(\Illuminate\Contracts\Support\Arrayable<TKey, TValue>|iterable<TKey, TValue>|null $value = []): \Illuminate\Support\Collection<TKey, TValue>;

/**
 * Overlay: these helpers are `fallback function` because the PHP declaration is
 * gated by `function_exists`. `value()` keeps PHPDoc `@template TValue`.
 */
fallback function data_fill(mixed &$target, string|array<int|string, mixed> $key, mixed $value): mixed;
fallback function data_forget(mixed &$target, string|array<int|string, mixed>|int|null $key): mixed;
fallback function data_get(mixed $target, string|array<int|string, mixed>|int|null $key, mixed $default = null): mixed;
fallback function data_has(mixed $target, string|array<int|string, mixed>|int|null $key): bool;
fallback function data_set(mixed &$target, string|array<int|string, mixed> $key, mixed $value, bool $overwrite = true): mixed;
fallback function head(array $array): mixed;
fallback function last(array $array): mixed;
fallback function value<TValue>(TValue $value, mixed ...$args): TValue;
fallback function when<TValue, TDefault>(mixed $condition, TValue|\Closure $value, TDefault|\Closure $default = null): TValue|TDefault;

namespace Illuminate\Support {
    /**
     * Overlay: PHPDoc type-guards and wrap/from conditionals that harvest left as `mixed`.
     */
    // @overlay-against: class Arr implements \Illuminate\Support\Traits\Macroable
    partial class Arr {
        /**
         * @return $value is array|\ArrayAccess
         */
        // @overlay-against: function accessible(mixed $value): bool
        public static function accessible(mixed $value): $value is array|\ArrayAccess<mixed, mixed>;

        /**
         * @return $value is array|\Illuminate\Contracts\Support\Arrayable|\Traversable|\Illuminate\Contracts\Support\Jsonable|\JsonSerializable
         */
        // @overlay-against: function arrayable(mixed $value): mixed
        public static function arrayable(mixed $value): $value is array|\Illuminate\Contracts\Support\Arrayable|\Traversable|\Illuminate\Contracts\Support\Jsonable|\JsonSerializable;

        /**
         * Keys and values, in that order.
         */
        // @overlay-against: function divide(array $array): array
        public static function divide<TKey extends mixed, TValue>(array<TKey, TValue> $array): (struct { array<int, TKey> 0 as $keys; array<int, TValue> 1 as $values; });

        /**
         * @return array<int, TValue>
         */
        // @overlay-against: function from(array|\Illuminate\Support\Enumerable|\Illuminate\Contracts\Support\Arrayable|\WeakMap|\Traversable|\Illuminate\Contracts\Support\Jsonable|\JsonSerializable|object $items): mixed
        public static function from<TValue>(\WeakMap<object, TValue> $items): array<int, TValue>;

        /**
         * @return array<TKey, TValue>
         */
        // @overlay-against: function from(array|\Illuminate\Support\Enumerable|\Illuminate\Contracts\Support\Arrayable|\WeakMap|\Traversable|\Illuminate\Contracts\Support\Jsonable|\JsonSerializable|object $items): mixed
        public static function from<TKey extends mixed, TValue>(array<TKey, TValue>|\Illuminate\Support\Enumerable<TKey, TValue>|\Illuminate\Contracts\Support\Arrayable<TKey, TValue>|\Traversable<TKey, TValue>|\Illuminate\Contracts\Support\Jsonable|\JsonSerializable|object $items): array<TKey, TValue>;

        /**
         * Overlay: `$array is list ? false : true` harvests as `mixed`.
         */
        // @overlay-against: function isAssoc(array $array): mixed
        public static function isAssoc(array $array): bool;

        /**
         * Overlay: `$array is list ? true : false` harvests as `mixed`.
         */
        // @overlay-against: function isList(array $array): mixed
        public static function isList(array $array): bool;

        /**
         * Overlay: null wraps to `[]`.
         */
        // @overlay-against: function wrap(array|TValue|null $value): mixed
        public static function wrap(null $value): array;

        /**
         * Overlay: an array is returned as-is.
         */
        // @overlay-against: function wrap(array|TValue|null $value): mixed
        public static function wrap<TKey extends mixed, TValue>(array<TKey, TValue> $value): array<TKey, TValue>;

        /**
         * Overlay: a non-array value is wrapped as a one-element list.
         */
        // @overlay-against: function wrap(array|TValue|null $value): mixed
        public static function wrap<TValue>(TValue $value): array<int, TValue>;
    }
}

namespace Illuminate\Support\Traits {
    /**
     * Overlay: drop trait `__get` so Collection/LazyCollection do not inherit
     * both EnumeratesValues::__get and Macroable::__call for unknown `$name`
     * lookups (TYHP3007). Proxied names stay as explicit properties.
     */
    // @overlay-against: trait EnumeratesValues implements \Illuminate\Support\Traits\Conditionable
    partial trait EnumeratesValues {
        // @overlay-against: function __get(string $key): mixed
        omit public function __get(string $key): mixed;
    }
}

namespace Illuminate\Support {
    /**
     * Overlay: PHPDoc shapes, class-strings, and conditionals harvest left loose.
     */
    // @overlay-against: class Arr implements \Illuminate\Support\Traits\Macroable
    partial class Arr {
        // @overlay-against: function crossJoin(mixed $arrays): array
        public static function crossJoin<TValue>(iterable<TValue> ...$arrays): array<int, array<mixed, TValue>>;
    }
    /**
     * Overlay: PHPDoc shapes, class-strings, and conditionals harvest left loose.
     */
    // @overlay-against: class Collection implements \ArrayAccess, \Illuminate\Contracts\Support\CanBeEscapedWhenCastToString, \Illuminate\Support\Enumerable, \Illuminate\Support\Traits\EnumeratesValues, \Illuminate\Support\Traits\Macroable, \Illuminate\Support\Traits\TransformsToResourceCollection
    partial class Collection {
        // @overlay-against: function chunk(int $size, bool $preserveKeys): mixed
        public function chunk(int $size, bool $preserveKeys = true): static<int, static>|static<int, static<int, TValue>>;
        // @overlay-against: function containsStrict(mixed $key, TValue|null $value): bool
        public function containsStrict((callable(TValue): bool)|TValue|int|string $key, TValue|null $value = null): bool;
        // @overlay-against: function crossJoin(mixed $lists): static
        public function crossJoin<TCrossJoinKey, TCrossJoinValue>(\Illuminate\Contracts\Support\Arrayable<TCrossJoinKey, TCrossJoinValue>|iterable<TCrossJoinKey, TCrossJoinValue> ...$lists): static<int, array<int, TValue|TCrossJoinValue>>;
        // @overlay-against: function nth(int $step, int $offset): mixed
        public function nth(int $step, int $offset = 0): static;
        // @overlay-against: function pop(int $count): mixed
        public function pop(int $count = 1): TValue|null|static<int, TValue>;
        // @overlay-against: function push(mixed $values): static
        public function push(TValue ...$values): static;
        // @overlay-against: function random(callable|int|null $number, bool $preserveKeys): mixed
        public function random(callable|int|null $number = null, bool $preserveKeys = false): TValue|static<int, TValue>;
        // @overlay-against: function shift(mixed $count): mixed
        public function shift(int $count = 1): TValue|null|static<int, TValue>;
        // @overlay-against: function sliding(mixed $size, mixed $step): static
        public function sliding(int $size = 2, int $step = 1): static<int, static>;
        // @overlay-against: function split(int $numberOfGroups): mixed
        public function split(int $numberOfGroups): static<int, static>;
        // @overlay-against: function splitIn(int $numberOfGroups): mixed
        public function splitIn(int $numberOfGroups): static<int, static>;
        // @overlay-against: function unshift(mixed $values): static
        public function unshift(TValue ...$values): static;
        // @overlay-against: function zip(mixed $items): static
        public function zip<TZipValue>(\Illuminate\Contracts\Support\Arrayable<int|string, TZipValue>|iterable<int|string, TZipValue> $items): static<int, static<int, TValue|TZipValue>>;
    }
    /**
     * Overlay: PHPDoc shapes, class-strings, and conditionals harvest left loose.
     */
    // @overlay-against: interface Enumerable
    partial interface Enumerable {
        // @overlay-against: function containsStrict(mixed $key, TValue|null $value): bool
        public function containsStrict((callable(TValue): bool)|TValue|int|string $key, TValue|null $value = null): bool;
        // @overlay-against: function crossJoin(mixed $lists): static
        public function crossJoin<TCrossJoinKey, TCrossJoinValue>(\Illuminate\Contracts\Support\Arrayable<TCrossJoinKey, TCrossJoinValue>|iterable<TCrossJoinKey, TCrossJoinValue> ...$lists): static<int, array<int, TValue|TCrossJoinValue>>;
        // @overlay-against: function keyBy(callable|array|string $keyBy): mixed
        public function keyBy<TNewKey extends mixed>(callable|array|string $keyBy): static<string|int|TNewKey, TValue>;
        // @overlay-against: function mapInto(string $class): static
        public function mapInto<TMapIntoValue>(__ClassName<TMapIntoValue> $class): static<TKey, TMapIntoValue>;
        // @overlay-against: function pipeInto(string $class): TPipeIntoValue
        public function pipeInto<TPipeIntoValue>(__ClassName<TPipeIntoValue> $class): TPipeIntoValue;
        // @overlay-against: function random(int|null $number): mixed
        public function random(int|null $number = null): TValue|static<int, TValue>;
        // @overlay-against: function zip(mixed $items): static
        public function zip<TZipValue>(\Illuminate\Contracts\Support\Arrayable<int|string, TZipValue>|iterable<int|string, TZipValue> $items): static<int, static<int, TValue|TZipValue>>;
    }
    /**
     * Overlay: PHPDoc shapes, class-strings, and conditionals harvest left loose.
     */
    // @overlay-against: class LazyCollection implements \Illuminate\Contracts\Support\CanBeEscapedWhenCastToString, \Illuminate\Support\Enumerable, \Illuminate\Support\Traits\EnumeratesValues, \Illuminate\Support\Traits\Macroable
    partial class LazyCollection {
        // @overlay-against: function range(int $from, int $to, int $step, mixed $args): mixed
        public static function range(int $from, int $to, int $step = 1, mixed ...$args): static<int, int>;
        // @overlay-against: function chunk(int $size, bool $preserveKeys): mixed
        public function chunk(int $size, bool $preserveKeys = true): static<int, static>|static<int, static<int, TValue>>;
        // @overlay-against: function containsStrict(mixed $key, TValue|null $value): bool
        public function containsStrict((callable(TValue): bool)|TValue|int|string $key, TValue|null $value = null): bool;
        // @overlay-against: function nth(int $step, int $offset): mixed
        public function nth(int $step, int $offset = 0): static;
        // @overlay-against: function random(int|null $number, bool $preserveKeys): mixed
        public function random(int|null $number = null, bool $preserveKeys = false): TValue|static<int, TValue>;
        // @overlay-against: function sliding(mixed $size, mixed $step): static
        public function sliding(int $size = 2, int $step = 1): static<int, static>;
        // @overlay-against: function splitIn(int $numberOfGroups): mixed
        public function splitIn(int $numberOfGroups): static<int, static>;
        // @overlay-against: function zip(mixed $items): static
        public function zip<TZipValue>(\Illuminate\Contracts\Support\Arrayable<int|string, TZipValue>|iterable<int|string, TZipValue> $items): static<int, static<int, TValue|TZipValue>>;
    }
}

namespace Illuminate\Support\Traits {
    /**
