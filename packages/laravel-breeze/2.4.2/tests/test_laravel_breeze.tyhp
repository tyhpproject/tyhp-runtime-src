<?tyhp

function test_breeze_install_command(): \Laravel\Breeze\Console\InstallCommand
{
    return new \Laravel\Breeze\Console\InstallCommand();
}

function test_breeze_install_handle(\Laravel\Breeze\Console\InstallCommand $command): int|null
{
    return $command->handle();
}

function test_breeze_service_provider(\Illuminate\Contracts\Foundation\Application $app): \Laravel\Breeze\BreezeServiceProvider
{
    return new \Laravel\Breeze\BreezeServiceProvider($app);
}

function test_breeze_provides(\Laravel\Breeze\BreezeServiceProvider $provider): array
{
    return $provider->provides();
}
