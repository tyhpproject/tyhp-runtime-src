<?tyhp

function test_type_resolve(): \phpDocumentor\Reflection\Type
{
    $resolver = new \phpDocumentor\Reflection\TypeResolver();
    return $resolver->resolve('string');
}

function test_fqsen_resolve(): \phpDocumentor\Reflection\Fqsen
{
    return (new \phpDocumentor\Reflection\FqsenResolver())->resolve('\\Foo\\Bar');
}
