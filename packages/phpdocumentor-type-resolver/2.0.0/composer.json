{
    "name": "tyhpdef/phpdocumentor-type-resolver",
    "description": "Tyhp type definitions for the Composer package phpdocumentor/type-resolver (2.0.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.0.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/phpdocumentor-reflection-common": "@dev",
                "tyhpdef/phpstan-phpdoc-parser": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "phpdocumentor/type-resolver": "2.0.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/phpdocumentor-reflection-common": "@dev",
        "tyhpdef/phpstan-phpdoc-parser": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../phpdocumentor-reflection-common/2.2.0"
        },
        {
            "type": "path",
            "url": "../../phpstan-phpdoc-parser/2.3.5"
        }
    ]
}
