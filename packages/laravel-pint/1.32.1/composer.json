{
    "name": "tyhpdef/laravel-pint",
    "description": "Tyhp type definitions for the Composer package laravel/pint (1.32.1).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.32.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/friendsofphp-php-cs-fixer": "@dev",
                "tyhpdef/illuminate-view": "@dev",
                "tyhpdef/laravel-prompts": "@dev",
                "tyhpdef/nunomaduro-termwind": "@dev",
                "tyhpdef/composer-semver": "@dev",
                "tyhpdef/symfony-process": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "laravel/pint": "1.32.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/friendsofphp-php-cs-fixer": "@dev",
        "tyhpdef/illuminate-view": "@dev",
        "tyhpdef/laravel-prompts": "@dev",
        "tyhpdef/nunomaduro-termwind": "@dev",
        "tyhpdef/composer-semver": "@dev",
        "tyhpdef/symfony-process": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../laravel-framework/13.32.0"
        },
        {
            "type": "path",
            "url": "../../friendsofphp-php-cs-fixer/3.95.25"
        },
        {
            "type": "path",
            "url": "../../illuminate-view/13.32.0"
        },
        {
            "type": "path",
            "url": "../../laravel-prompts/0.3.24"
        },
        {
            "type": "path",
            "url": "../../nunomaduro-termwind/2.4.0"
        },
        {
            "type": "path",
            "url": "../../composer-semver/3.4.4"
        },
        {
            "type": "path",
            "url": "../../symfony-process/7.4.19"
        }
    ]
}
