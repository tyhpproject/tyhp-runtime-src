{
  "name": "tyhpdef/nesbot-carbon",
  "description": "Tyhp type definitions for the Composer package nesbot/carbon (3.14.0).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "3.14.0.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-clock": "@dev",
        "tyhpdef/symfony-translation": "@dev",
        "tyhpdef/symfony-clock": "@dev",
        "tyhpdef/symfony-translation-contracts": "@dev",
        "tyhpdef/php-ext-intl": "@dev",
        "tyhpdef/php-ext-dom": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "nesbot/carbon": "3.14.0"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/psr-clock": "@dev",
    "tyhpdef/symfony-translation": "@dev",
    "tyhpdef/symfony-clock": "@dev",
    "tyhpdef/symfony-translation-contracts": "@dev",
    "tyhpdef/php-ext-intl": "@dev",
    "tyhpdef/php-ext-dom": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../php"
    },
    {
      "type": "path",
      "url": "../../psr-clock/1.0.0"
    },
    {
      "type": "path",
      "url": "../../symfony-translation/7.4.17"
    },
    {
      "type": "path",
      "url": "../../symfony-clock/7.4.8"
    },
    {
      "type": "path",
      "url": "../../symfony-translation-contracts/3.7.1"
    },
    {
      "type": "path",
      "url": "../../php-ext-intl"
    },
    {
      "type": "path",
      "url": "../../php-ext-dom"
    }
  ]
}
