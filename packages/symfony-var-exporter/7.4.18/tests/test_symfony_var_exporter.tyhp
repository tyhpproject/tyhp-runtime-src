<?tyhp

function test_var_exporter_export(): string
{
    return \Symfony\Component\VarExporter\VarExporter::export(['a' => 1]);
}

function test_var_exporter_instantiate(): \stdClass
{
    return \Symfony\Component\VarExporter\Instantiator::instantiate(\stdClass::class, ['name' => 'tyhp']);
}

function test_var_exporter_hydrate(\stdClass $object): \stdClass
{
    return \Symfony\Component\VarExporter\Hydrator::hydrate($object, ['name' => 'done']);
}
