<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Instantiator/Hydrator class-string maps; VarExporter found-class map; omit deprecated lazy traits.
 */

namespace Symfony\Component\VarExporter {
    /**
     * Overlay: PHPDoc `@param array<class-string, array<string, mixed>> $scopedProperties`.
     * Harvest used `array<string, …>` keys.
     */
    // @overlay-against: class Hydrator
    partial class Hydrator {
        /**
         * @param T $instance
         * @param array<string, mixed> $properties
         * @param array<\__ClassName<object>, array<string, mixed>> $scopedProperties
         */
        // @overlay-against: function hydrate(T $instance, array $properties, array $scopedProperties): T
        public static function hydrate<T extends object>(T $instance, array<string, mixed> $properties = [], array<\__ClassName<object>, array<string, mixed>> $scopedProperties = []): T;
    }

    /**
     * Overlay: PHPDoc `@param class-string<T> $class` and class-string scoped-property keys.
     */
    // @overlay-against: class Instantiator
    partial class Instantiator {
        /**
         * @param \__ClassName<T> $class
         * @param array<string, mixed> $properties
         * @param array<\__ClassName<object>, array<string, mixed>> $scopedProperties
         */
        // @overlay-against: function instantiate(string $class, array $properties, array $scopedProperties): T
        public static function instantiate<T extends object>(\__ClassName<T> $class, array<string, mixed> $properties = [], array<\__ClassName<object>, array<string, mixed>> $scopedProperties = []): T;
    }

    /**
     * Overlay: deprecated lazy traits `use` an internal trait omitted from Layer 1.
     */
    // @overlay-against: trait LazyGhostTrait implements \Symfony\Component\VarExporter\Internal\LazyObjectTrait
    omit trait LazyGhostTrait {
    }

    /**
     * Overlay: deprecated lazy traits `use` an internal trait omitted from Layer 1.
     */
    // @overlay-against: trait LazyProxyTrait implements \Symfony\Component\VarExporter\Internal\LazyObjectTrait
    omit trait LazyProxyTrait {
    }

    /**
     * Overlay: PHPDoc `@param array<class-string, class-string> &$foundClasses`; harvest left bare `array`.
     */
    // @overlay-against: class VarExporter
    partial class VarExporter {
        /**
         * @param array<\__ClassName<object>, \__ClassName<object>> $foundClasses
         */
        // @overlay-against: function export(mixed $value, ?bool $isStaticValue, array $foundClasses): string
        public static function export(mixed $value, ?bool &$isStaticValue = null, array<\__ClassName<object>, \__ClassName<object>> &$foundClasses = []): string;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `ProxyHelper`.
     */
    // @overlay-against: class ProxyHelper
    partial class ProxyHelper {
        /**
         * @param array<\ReflectionClass> $interfaces
         */
        // @overlay-against: function generateLazyProxy(?\ReflectionClass $class, array $interfaces): string
        public static function generateLazyProxy(?\ReflectionClass $class, array<\ReflectionClass> $interfaces = []): string;
    }
}
