{
    "name": "tyhpdef/spatie-flare-client-php",
    "description": "Tyhp type definitions for the Composer package spatie/flare-client-php (2.10.2).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.10.2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/spatie-error-solutions": "@dev",
                "tyhpdef/spatie-backtrace": "@dev",
                "tyhpdef/symfony-http-foundation": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/symfony-var-dumper": "@dev",
                "tyhpdef/guzzlehttp-guzzle": "@dev",
                "tyhpdef/php-ext-curl": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "spatie/flare-client-php": "2.10.2"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/spatie-error-solutions": "@dev",
        "tyhpdef/spatie-backtrace": "@dev",
        "tyhpdef/symfony-http-foundation": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/symfony-var-dumper": "@dev",
        "tyhpdef/guzzlehttp-guzzle": "@dev",
        "tyhpdef/php-ext-curl": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../php-ext-curl"
        },
        {
            "type": "path",
            "url": "../../spatie-error-solutions/2.0.5"
        },
        {
            "type": "path",
            "url": "../../spatie-backtrace/1.8.2"
        },
        {
            "type": "path",
            "url": "../../symfony-http-foundation/7.4.19"
        },
        {
            "type": "path",
            "url": "../../psr-container/2.0.2"
        },
        {
            "type": "path",
            "url": "../../symfony-var-dumper/7.4.18"
        },
        {
            "type": "path",
            "url": "../../guzzlehttp-guzzle/7.15.5"
        }
    ]
}
