/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Request cookies are a map, per the Layer 1 PHPDoc.
 * Optional Laravel / Ignition peers are unowned — extern.
 */

namespace Spatie\FlareClient {
    /**
     * Overlay: pipeline callable accepted by `Flare::registerMiddleware()`.
     */
    type FlareMiddlewarePipe = callable(\Spatie\FlareClient\Report, \Closure<callable(\Spatie\FlareClient\Report): mixed>): mixed;

    /**
     * Overlay: callback passed to `Flare::report()` and `Flare::reportMessage()`.
     */
    type FlareReportCallback = callable(\Spatie\FlareClient\Report): void;

    /**
     * Overlay: documented array shape.
     */
    type FrameToArrayResult = struct {
        bool $application_frame;
        array<int|string, mixed>|null $arguments;
        string|null $class;
        array<int, string> $code_snippet;
        string $file;
        int $line_number;
        string|null $method;
    };

