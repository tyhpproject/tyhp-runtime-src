{
    "name": "tyhpdef/async-aws-core",
    "description": "Tyhp type definitions for the Composer package async-aws/core (1.30.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.30.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-http-client-contracts": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/psr-cache": "@dev",
                "tyhpdef/symfony-cache-contracts": "@dev",
                "tyhpdef/symfony-http-client": "@dev",
                "tyhpdef/async-aws-s3": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "async-aws/core": "1.30.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-http-client-contracts": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/psr-cache": "@dev",
        "tyhpdef/symfony-cache-contracts": "@dev",
        "tyhpdef/symfony-http-client": "@dev",
        "tyhpdef/async-aws-s3": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../symfony-http-client-contracts/3.7.3"
        },
        {
            "type": "path",
            "url": "../../psr-log/3.0.2"
        },
        {
            "type": "path",
            "url": "../../symfony-service-contracts/3.7.3"
        },
        {
            "type": "path",
            "url": "../../psr-cache/3.0.0"
        },
        {
            "type": "path",
            "url": "../../symfony-cache-contracts/3.7.1"
        },
        {
            "type": "path",
            "url": "../../symfony-http-client/7.4.19"
        },
        {
            "type": "path",
            "url": "../../async-aws-s3/3.5.0"
        }
    ]
}
