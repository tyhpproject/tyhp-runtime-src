<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Hook handlers are class names.
 * Language-server protocol types and Composer ClassLoader are unowned — extern.
 */

extern class \Composer\Autoload\ClassLoader;
extern class \LanguageServerProtocol\CompletionItem;
extern class \LanguageServerProtocol\Position;
extern class \LanguageServerProtocol\Range;
extern class \LanguageServerProtocol\SignatureInformation;

namespace Psalm {
    /**
     * `Codebase::getCompletionDataAtPosition` tuple.
     */
    type CompletionAtPosition = struct {
        string 0 as $type;
        CompletionGap 1 as $gap;
        int 2 as $offset;
    };

    /**
     * Gap token from `Codebase::getCompletionDataAtPosition`.
     */
    type CompletionGap = "->"|"::"|"["|"symbol";

    /**
     * `Codebase::getFunctionArgumentAtPosition` tuple.
     */
    type FunctionArgumentAtPosition = struct {
        string 0 as $symbol;
        int 1 as $argument;
        \LanguageServerProtocol\Range 2 as $range;
    };

    /**
     * `CodeLocation` selection and snippet offsets.
     */
    type IntBounds = struct {
        int 0 as $start;
        int 1 as $end;
    };

    /**
     * One `Config::getIssueHandlerSuppressions` row.
     */
    type IssueHandlerSuppression = struct {
        string $type;
        int $index;
        int $count;
    };

    /**
     * One `Config::getPluginClasses` row.
     */
    type PluginClassEntry = struct {
        string $class;
        ?\SimpleXMLElement $config;
    };

    /**
     * `Codebase::getReferenceAtPosition` tuple.
     */
    type ReferenceAtPosition = struct {
        string 0 as $symbol;
        \LanguageServerProtocol\Range 1 as $range;
    };

    type TraversableKeyValue = struct {
        \Psalm\Type\Union 0 as $key;
        \Psalm\Type\Union 1 as $value;
    };

    // @overlay-against: class Codebase
    partial class Codebase {
        // @overlay-against: array $use_referencing_locations
        public array<string, array<int, \Psalm\CodeLocation>> $use_referencing_locations;
        // @overlay-against: function getCompletionDataAtPosition(string $file_path, \LanguageServerProtocol\Position $position): array|null
        public function getCompletionDataAtPosition(string $file_path, \LanguageServerProtocol\Position $position): ?CompletionAtPosition;
        // @overlay-against: function getFunctionArgumentAtPosition(string $file_path, \LanguageServerProtocol\Position $position): array|null
        public function getFunctionArgumentAtPosition(string $file_path, \LanguageServerProtocol\Position $position): ?FunctionArgumentAtPosition;
        // @overlay-against: function getKeyValueParamsForTraversableObject(\Psalm\Type\Atomic $type): array
        public function getKeyValueParamsForTraversableObject(\Psalm\Type\Atomic $type): TraversableKeyValue;
        // @overlay-against: function getReferenceAtPosition(string $file_path, \LanguageServerProtocol\Position $position): array|null
        public function getReferenceAtPosition(string $file_path, \LanguageServerProtocol\Position $position): ?ReferenceAtPosition;
    }

    // @overlay-against: class CodeLocation implements \Psalm\Storage\ImmutableNonCloneableTrait
    partial class CodeLocation {
        // @overlay-against: function getSelectionBounds(): array
        public function getSelectionBounds(): IntBounds;
        // @overlay-against: function getSnippetBounds(): array
        public function getSnippetBounds(): IntBounds;
    }

    // @overlay-against: class Config
    partial class Config {
        // @overlay-against: function addUniversalObjectCrate(string $class): void
        public function addUniversalObjectCrate(\__ClassName $class): void;
        // @overlay-against: function getIssueHandlerSuppressions(): array
        public function getIssueHandlerSuppressions(): array<int, IssueHandlerSuppression>;
        // @overlay-against: function getPluginClasses(): array
        public function getPluginClasses(): array<int, PluginClassEntry>;
        // @overlay-against: function getPredefinedFunctions(): array
        public function getPredefinedFunctions(): array<string, bool>;
        // @overlay-against: function getUniversalObjectCrates(): array
        public function getUniversalObjectCrates(): array<int, string>;
        // @overlay-against: function safeSetAdvancedErrorLevel(string $issue_key, array $config, ?string $default_error_level): void
        public function safeSetAdvancedErrorLevel(string $issue_key, array<int|string, array<string, mixed>> $config, ?string $default_error_level = null): void;
        // @overlay-against: function setAdvancedErrorLevel(string $issue_key, array $config, ?string $default_error_level): void
        public function setAdvancedErrorLevel(string $issue_key, array<int|string, array<string, mixed>> $config, ?string $default_error_level = null): void;
    }

    // @overlay-against: class IssueBuffer
    partial class IssueBuffer {
        // @overlay-against: function accepts(\Psalm\Issue\CodeIssue $e, array $suppressed_issues, bool $is_fixable): bool
        public static function accepts(\Psalm\Issue\CodeIssue $e, array<int|string, string> $suppressed_issues = [], bool $is_fixable = false): bool;
        // @overlay-against: function maybeAdd(\Psalm\Issue\CodeIssue $e, array $suppressed_issues, bool $is_fixable): void
        public static function maybeAdd(\Psalm\Issue\CodeIssue $e, array<int|string, string> $suppressed_issues = [], bool $is_fixable = false): void;
        // @overlay-against: function isSuppressed(\Psalm\Issue\CodeIssue $e, array $suppressed_issues): bool
        public static function isSuppressed(\Psalm\Issue\CodeIssue $e, array<int|string, string> $suppressed_issues = []): bool;
    }

    // @overlay-against: class PluginFileExtensionsSocket implements \Psalm\Plugin\FileExtensionsInterface
    partial class PluginFileExtensionsSocket {
        // @overlay-against: function addFileTypeScanner(string $fileExtension, string $className): void
        public function addFileTypeScanner(string $fileExtension, \__ClassName $className): void;
        // @overlay-against: function addFileTypeAnalyzer(string $fileExtension, string $className): void
        public function addFileTypeAnalyzer(string $fileExtension, \__ClassName $className): void;
    }

    // @overlay-against: class Report
    partial class Report {
        // @overlay-against: function getMapping(): array
        public static function getMapping(): array<string, string>;
    }
}

namespace Psalm\Plugin {
    /**
     * Overlay: hook handlers are class names.
     */
    // @overlay-against: interface RegistrationInterface
    partial interface RegistrationInterface {
        /**
         * @param \__ClassName $handler
         */
        // @overlay-against: function registerHooksFromClass(string $handler): void
        public function registerHooksFromClass(\__ClassName $handler): void;
    }
}

namespace Psalm\Issue {
    // @overlay-against: class InternalClass extends \Psalm\Issue\ClassIssue
    partial class InternalClass {
        // @overlay-against: function listToPhrase(array $words): string
        public static function listToPhrase(array<int|string, string> $words): string;
    }
}

namespace Psalm\Plugin\EventHandler\Event {
    // @overlay-against: class MethodReturnTypeProviderEvent
    partial class MethodReturnTypeProviderEvent {
        // @overlay-against: function getTemplateTypeParameters(): ?array
        public function getTemplateTypeParameters(): array<int, \Psalm\Type\Union>|null;
    }
}

namespace Psalm\Type {
    // @overlay-against: class MutableUnion implements \Psalm\Type\TypeNode, \Psalm\Type\UnionTrait
    partial class MutableUnion {
        // @overlay-against: function setTypes(array $types): self
        public function setTypes(array<int|string, \Psalm\Type\Atomic> $types): self;
    }

    // @overlay-against: class Reconciler
    partial class Reconciler {
        // @overlay-against: function breakUpPathIntoParts(string $path): array
        public static function breakUpPathIntoParts(string $path): array<int, string>;
    }

    // @overlay-against: class TypeVisitor
    partial class TypeVisitor {
        // @overlay-against: function traverseArray(array $nodes): void
        public function traverseArray(array<int|string, \Psalm\Type\TypeNode> $nodes): void;
    }

    // @overlay-against: class Union implements \Psalm\Type\TypeNode, \Psalm\Storage\ImmutableNonCloneableTrait, \Psalm\Type\UnionTrait
    partial class Union {
        // @overlay-against: function setTypes(array $types): self
        public function setTypes(array<int|string, \Psalm\Type\Atomic> $types): self;
    }

    // @overlay-against: trait UnionTrait
    partial trait UnionTrait {
        // @overlay-against: function __construct(array $types, \Psalm\Type\UnionTProperties $properties): void
        public function __construct(array<int|string, \Psalm\Type\Atomic> $types, \Psalm\Type\UnionTProperties $properties = []): void;
        // @overlay-against: function getAtomicTypes(): array
        public function getAtomicTypes(): array<string, \Psalm\Type\Atomic>;
    }
}

namespace Psalm\Type\Atomic {
    // @overlay-against: class TGenericObject extends \Psalm\Type\Atomic\TNamedObject implements \Psalm\Type\Atomic\GenericTrait
    partial class TGenericObject {
        // @overlay-against: array $type_params
        public array<int, \Psalm\Type\Union> $type_params;
        // @overlay-against: function __construct(string $value, array $type_params, bool $remapped_params, bool $is_static, array $extra_types, bool $from_docblock): void
        public function __construct(string $value, array<int|string, \Psalm\Type\Union> $type_params, bool $remapped_params = false, bool $is_static = false, array<string, \Psalm\Type\Atomic\TNamedObject|\Psalm\Type\Atomic\TTemplateParam|\Psalm\Type\Atomic\TIterable|\Psalm\Type\Atomic\TObjectWithProperties|\Psalm\Type\Atomic\TCallableObject> $extra_types = [], bool $from_docblock = false): void;
    }

    // @overlay-against: class TKeyedArray extends \Psalm\Type\Atomic implements \Psalm\Storage\UnserializeMemoryUsageSuppressionTrait
    partial class TKeyedArray {
        // @overlay-against: function make(array $properties, array $class_strings, array|null $fallback_params, bool $is_list, bool $from_docblock): self|\Psalm\Type\Atomic\TArray
        public static function make(array<string|int, \Psalm\Type\Union> $properties, array<string, bool> $class_strings = null, array|null $fallback_params = null, bool $is_list = false, bool $from_docblock = false): self|\Psalm\Type\Atomic\TArray;
        // @overlay-against: function makeCallable(array $properties, array $class_strings, bool $is_list, bool $from_docblock): self
        public static function makeCallable(array<string|int, \Psalm\Type\Union> $properties, array<string, bool> $class_strings = null, bool $is_list = false, bool $from_docblock = false): self;
        // @overlay-against: function setProperties(array $properties): self|\Psalm\Type\Atomic\TArray
        public function setProperties(array<string|int, \Psalm\Type\Union> $properties): self|\Psalm\Type\Atomic\TArray;
    }
}
