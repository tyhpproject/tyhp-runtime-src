<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Declaration order: TYHPDEF_ORDERING.md.
 * List and map returns for key, hash, set, and list commands, plus fixed
 * BLPOP / TIME shapes. Pipeline mode still returns the client object.
 */

/**
 * Overlay: `BLPOP` / `BRPOP` reply is the key and the popped element.
 */
type RedisBlockingPop = struct {
    string 0 as $key;
    string 1 as $element;
};

/**
 * Overlay: one `GEOPOS` coordinate pair. Missing members are `null` in the list.
 */
type RedisGeoPosition = struct {
    string 0 as $longitude;
    string 1 as $latitude;
};

/**
 * Overlay: `TIME` reply, seconds then microseconds, both decimal strings.
 */
type RedisTime = struct {
    string 0 as $seconds;
    string 1 as $microseconds;
};

// @overlay-against: class Redis
partial class Redis {
