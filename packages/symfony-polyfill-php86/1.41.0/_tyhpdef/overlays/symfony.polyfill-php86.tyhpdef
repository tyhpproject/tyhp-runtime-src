<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * PHP 8.6 symbols this polyfill defines below 8.6. tyhpdef/php does not declare them.
 * Other polyfill shims are already typed by tyhpdef/php.
 */

declare(php="<8.6") {
    /**
     * Polyfill of PHP 8.6 `clamp()`. Returns `$value` when it lies between `$min` and `$max`, otherwise the nearer bound.
     *
     * @param V $value
     * @param L $min
     * @param H $max
     * @return V|L|H
     */
    function clamp<V = mixed, L = mixed, H = mixed>(V $value, L $min, H $max): V|L|H;
}

declare(php="<8.6") {
    /**
     * Polyfill of the PHP 8.6 `SortDirection` enum.
     */
    enum SortDirection {
        case Ascending;
        case Descending;
    }
}
