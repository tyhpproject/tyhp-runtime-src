{
  "name": "tyhpdef/spatie-laravel-error-share",
  "description": "Tyhp type definitions for the Composer package spatie/laravel-error-share (1.0.10).",
  "keywords": [
    "dev",
    "static analysis"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "version": "1.0.10.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "tyhp": {
      "interopContractVersion": 1,
      "php-version": ">=8.2",
      "require": {
        "tyhpdef/php": "@dev",
        "tyhpdef/spatie-laravel-package-tools": "@dev"
      },
      "package": {
        "include": [
          "./_tyhpdef/*.tyhpdef",
          "./_tyhpdef/extensions/*.tyhpdef"
        ],
        "overlay": [
          "./_tyhpdef/overlays/stubs/*.tyhpdef",
          "./_tyhpdef/overlays/*.tyhpdef"
        ]
      }
    }
  },
  "require": {
    "php": ">=8.2",
    "spatie/laravel-error-share": "1.0.10"
  },
  "require-dev": {
    "tyhpdef/php": "@dev",
    "tyhpdef/spatie-laravel-package-tools": "@dev"
  },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../spatie-laravel-package-tools/1.93.2"
        }
    ]
}
