<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `@internal` binding trait (PHP `if (enum_exists)`). ORM id generators come from Layer 1
 * now that `tyhpdef/doctrine-orm` is path-linked.
 * DBAL column maps are string-keyed. `convertToDatabaseValue()` accepts a UUID,
 * a string (including `Stringable`), or null.
 */

namespace Ramsey\Uuid\Doctrine {
    /**
     * Value accepted by `convertToDatabaseValue()` before it is stored.
     */
    type UuidDatabaseValue = \Ramsey\Uuid\UuidInterface|string|\Stringable|null;

    /**
     * Doctrine column options passed to `getSQLDeclaration()`.
     */
    type UuidColumn = array<string, mixed>;

    /**
     * Internal trait omitted from Layer 1 (`@internal`, PHP `if (enum_exists)`).
     */
    trait GetBindingTypeImplementation {
        public function getBindingType(): \Doctrine\DBAL\ParameterType;
    }

    // @overlay-against: class UuidBinaryOrderedTimeType extends \Doctrine\DBAL\Types\Type implements \Ramsey\Uuid\Doctrine\GetBindingTypeImplementation
    partial class UuidBinaryOrderedTimeType {
        // @overlay-against: function convertToDatabaseValue(mixed $value, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): ?string
        public function convertToDatabaseValue(\Ramsey\Uuid\Doctrine\UuidDatabaseValue $value, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): ?string;

        // @overlay-against: function getSQLDeclaration(array $column, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): string
        public function getSQLDeclaration(\Ramsey\Uuid\Doctrine\UuidColumn $column, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): string;
    }

    // @overlay-against: class UuidBinaryType extends \Doctrine\DBAL\Types\Type implements \Ramsey\Uuid\Doctrine\GetBindingTypeImplementation
    partial class UuidBinaryType {
        // @overlay-against: function convertToDatabaseValue(mixed $value, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): ?string
        public function convertToDatabaseValue(\Ramsey\Uuid\Doctrine\UuidDatabaseValue $value, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): ?string;

        // @overlay-against: function getSQLDeclaration(array $column, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): string
        public function getSQLDeclaration(\Ramsey\Uuid\Doctrine\UuidColumn $column, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): string;
    }

    // @overlay-against: class UuidType extends \Doctrine\DBAL\Types\GuidType
    partial class UuidType {
        // @overlay-against: function convertToDatabaseValue(mixed $value, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): ?string
        public function convertToDatabaseValue(\Ramsey\Uuid\Doctrine\UuidDatabaseValue $value, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): ?string;

        // @overlay-against: function getMappedDatabaseTypes(\Doctrine\DBAL\Platforms\AbstractPlatform $platform): array
        public function getMappedDatabaseTypes(\Doctrine\DBAL\Platforms\AbstractPlatform $platform): array<int, string>;
    }
}
