<?tyhp

function test_uuid_type_name(): string
{
    return \Ramsey\Uuid\Doctrine\UuidType::NAME;
}

function test_uuid_binary_type_name(): string
{
    return \Ramsey\Uuid\Doctrine\UuidBinaryType::NAME;
}

function test_uuid_type_to_php(\Ramsey\Uuid\Doctrine\UuidType $type, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): ?\Ramsey\Uuid\UuidInterface
{
    return $type->convertToPHPValue('6ba7b810-9dad-11d1-80b4-00c04fd430c8', $platform);
}

function test_uuid_type_to_db(\Ramsey\Uuid\Doctrine\UuidType $type, \Ramsey\Uuid\UuidInterface $uuid, \Doctrine\DBAL\Platforms\AbstractPlatform $platform): ?string
{
    return $type->convertToDatabaseValue($uuid, $platform);
}

function test_uuid_orm_generator(): \Ramsey\Uuid\Doctrine\UuidGenerator
{
    return new \Ramsey\Uuid\Doctrine\UuidGenerator();
}
