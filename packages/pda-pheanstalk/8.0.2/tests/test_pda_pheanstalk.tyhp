<?tyhp

function test_pheanstalk_create(): \Pheanstalk\Pheanstalk
{
    return \Pheanstalk\Pheanstalk::create('127.0.0.1');
}

function test_pheanstalk_put(\Pheanstalk\Pheanstalk $client): \Pheanstalk\Contract\JobIdInterface
{
    $client->useTube(new \Pheanstalk\Values\TubeName('default'));
    return $client->put('payload');
}
