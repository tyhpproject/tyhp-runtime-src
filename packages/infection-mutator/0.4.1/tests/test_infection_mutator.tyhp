<?tyhp

function test_mutator_definition(): \Infection\Mutator\Definition
{
    return new \Infection\Mutator\Definition(
        'Removes unused addition',
        \Infection\Mutator\MutatorCategory::SEMANTIC_REDUCTION,
        null,
        '- $a + $b'
    );
}

function test_mutator_name(\Infection\Mutator\Mutator $mutator): string
{
    return $mutator->getName();
}

function test_mutator_can_mutate(\Infection\Mutator\Mutator $mutator, \PhpParser\Node $node): bool
{
    return $mutator->canMutate($node);
}
