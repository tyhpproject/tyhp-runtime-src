<?tyhp

function test_enable_tracking(): void
{
    \Doctrine\Deprecations\Deprecation::enableTrackingDeprecations();
}

function test_trigger_string_arg(): void
{
    \Doctrine\Deprecations\Deprecation::trigger('doctrine/dbal', 'https://example.com/deprecation', 'unused %s', 'column');
}

function test_triggered_count(): int
{
    return \Doctrine\Deprecations\Deprecation::getUniqueTriggeredDeprecationsCount();
}

function test_triggered_map(): array<string, int>
{
    return \Doctrine\Deprecations\Deprecation::getTriggeredDeprecations();
}

function test_enable_with_logger(\Psr\Log\LoggerInterface $logger): void
{
    \Doctrine\Deprecations\Deprecation::enableWithPsrLogger($logger);
}
