<?tyhp

function test_flysystem_new(\League\Flysystem\FilesystemAdapter $adapter): \League\Flysystem\Filesystem
{
    return new \League\Flysystem\Filesystem($adapter, ['visibility' => 'public']);
}

function test_flysystem_write(\League\Flysystem\FilesystemOperator $fs): void
{
    $fs->write('readme.txt', 'hello', ['visibility' => 'public']);
}

function test_flysystem_read(\League\Flysystem\FilesystemOperator $fs): string
{
    return $fs->read('readme.txt');
}

function test_flysystem_listing(\League\Flysystem\Filesystem $fs): array<int, \League\Flysystem\StorageAttributes>
{
    return $fs->listContents('/', false)->toArray();
}

function test_flysystem_config_get(): mixed
{
    return (new \League\Flysystem\Config(['visibility' => 'private']))->get('visibility');
}
