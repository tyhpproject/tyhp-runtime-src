<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * `@internal` array-access trait plus listing/config maps from the PHP source.
 */

namespace League\Flysystem {
    /**
     * Internal trait omitted from Layer 1 (`@internal`). Used by attribute DTOs.
     */
    trait ProxyArrayAccessToProperties {
        public function offsetExists(mixed $offset): bool;

        public function offsetGet(mixed $offset): mixed;

        public function offsetSet(mixed $offset, mixed $value): void;

        public function offsetUnset(mixed $offset): void;
    }

    /**
     * Overlay: listing filter/map keep the directory listing type argument.
     */
    // @overlay-against: class DirectoryListing implements \IteratorAggregate
    partial class DirectoryListing {
        /**
         * @param callable(T): bool $filter
         */
        // @overlay-against: function filter(callable $filter): \League\Flysystem\DirectoryListing
        public function filter(callable(T): bool $filter): self;

        /**
         * @param callable(T): R $mapper
         */
        // @overlay-against: function map(callable $mapper): \League\Flysystem\DirectoryListing
        public function map<R>(callable(T): R $mapper): \League\Flysystem\DirectoryListing<R>;

        /**
         * @return \Traversable<int|string, T>
         */
        // @overlay-against: function getIterator(): \Traversable
        public function getIterator(): \Traversable<int|string, T>;
    }

    /**
     * Overlay: config bags are string-keyed option maps.
     */
    // @overlay-against: class Config
    partial class Config {
        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function __construct(array $options): void
        public function __construct(array<string, mixed> $options = []): void;

        /**
         * @param array<string, mixed> $options
         */
        // @overlay-against: function extend(array $options): \League\Flysystem\Config
        public function extend(array<string, mixed> $options): \League\Flysystem\Config;

        /**
         * @param array<string, mixed> $defaults
         */
        // @overlay-against: function withDefaults(array $defaults): \League\Flysystem\Config
        public function withDefaults(array<string, mixed> $defaults): \League\Flysystem\Config;

        /**
         * @return array<string, mixed>
         */
        // @overlay-against: function toArray(): array
        public function toArray(): array<string, mixed>;
    }

    /**
     * Overlay: stream and listing signatures match `FilesystemAdapter`.
     */
    // @overlay-against: class DecoratedAdapter implements \League\Flysystem\FilesystemAdapter
    partial class DecoratedAdapter {
        /**
         * @return iterable<\League\Flysystem\StorageAttributes>
         */
        // @overlay-against: function listContents(string $path, bool $deep): iterable
        public function listContents(string $path, bool $deep): iterable<\League\Flysystem\StorageAttributes>;

        /**
         * @return resource
         */
        // @overlay-against: function readStream(string $path): mixed
        public function readStream(string $path): resource;

        /**
         * @param resource $contents
         */
        // @overlay-against: function writeStream(string $path, mixed $contents, \League\Flysystem\Config $config): void
        public function writeStream(string $path, resource $contents, \League\Flysystem\Config $config): void;
    }

    /**
     * Overlay: operator config maps and listing element type from PHPDoc.
     */
    // @overlay-against: class Filesystem implements \League\Flysystem\FilesystemOperator, \League\Flysystem\CalculateChecksumFromStream
    partial class Filesystem {
        /**
         * @param array<string, mixed> $config
         */
        // @overlay-against: function __construct(\League\Flysystem\FilesystemAdapter $adapter, array $config, ?\League\Flysystem\PathNormalizer $pathNormalizer, ?\League\Flysystem\UrlGeneration\PublicUrlGenerator $publicUrlGenerator, ?\League\Flysystem\UrlGeneration\TemporaryUrlGenerator $temporaryUrlGenerator): void
        public function __construct(\League\Flysystem\FilesystemAdapter $adapter, array<string, mixed> $config = [], ?\League\Flysystem\PathNormalizer $pathNormalizer = null, ?\League\Flysystem\UrlGeneration\PublicUrlGenerator $publicUrlGenerator = null, ?\League\Flysystem\UrlGeneration\TemporaryUrlGenerator $temporaryUrlGenerator = null): void;

        /**
         * @return resource
         */
        // @overlay-against: function readStream(string $location): mixed
        public function readStream(string $location): resource;

        /**
         * @param array<string, mixed> $config
         */
        // @overlay-against: function write(string $location, string $contents, array $config): void
        public function write(string $location, string $contents, array<string, mixed> $config = []): void;

        /**
         * @param resource $contents
         * @param array<string, mixed> $config
         */
        // @overlay-against: function writeStream(string $location, mixed $contents, array $config): void
        public function writeStream(string $location, resource $contents, array<string, mixed> $config = []): void;

        /**
         * @return \League\Flysystem\DirectoryListing<\League\Flysystem\StorageAttributes>
         */
        // @overlay-against: function listContents(string $location, bool $deep): \League\Flysystem\DirectoryListing
        public function listContents(string $location, bool $deep = self::LIST_SHALLOW): \League\Flysystem\DirectoryListing<\League\Flysystem\StorageAttributes>;

        /**
         * @param array<string, mixed> $config
         */
        // @overlay-against: function copy(string $source, string $destination, array $config): void
        public function copy(string $source, string $destination, array<string, mixed> $config = []): void;

        /**
         * @param array<string, mixed> $config
         */
        // @overlay-against: function move(string $source, string $destination, array $config): void
        public function move(string $source, string $destination, array<string, mixed> $config = []): void;
    }

    /**
     * Overlay: `fromArray` reads string attribute names.
     */
    // @overlay-against: class DirectoryAttributes implements \League\Flysystem\StorageAttributes, \League\Flysystem\ProxyArrayAccessToProperties
    partial class DirectoryAttributes {
        /**
         * @param array<string, mixed> $attributes
         */
        // @overlay-against: function fromArray(array $attributes): self
        public static function fromArray(array<string, mixed> $attributes): self;
    }

    /**
     * Overlay: `fromArray` reads string attribute names.
     */
    // @overlay-against: class FileAttributes implements \League\Flysystem\StorageAttributes, \League\Flysystem\ProxyArrayAccessToProperties
    partial class FileAttributes {
        /**
         * @param array<string, mixed> $attributes
         */
        // @overlay-against: function fromArray(array $attributes): self
        public static function fromArray(array<string, mixed> $attributes): self;
    }

    /**
     * Overlay: both attribute DTOs index string keys.
     */
    // @overlay-against: interface StorageAttributes
    partial interface StorageAttributes {
        /**
         * @param array<string, mixed> $attributes
         */
        // @overlay-against: function fromArray(array $attributes): \League\Flysystem\StorageAttributes
        public static function fromArray(array<string, mixed> $attributes): \League\Flysystem\StorageAttributes;
    }

    /**
     * Overlay: `readStream()` matches `FilesystemReader`.
     */
    // @overlay-against: class MountManager implements \League\Flysystem\FilesystemOperator
    partial class MountManager {
        /**
         * @return resource
         */
        // @overlay-against: function readStream(string $location): mixed
        public function readStream(string $location): resource;
    }
}
