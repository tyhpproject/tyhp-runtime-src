<?tyhp

function test_lock_factory_create(): bool
{
    $factory = new \Symfony\Component\Lock\LockFactory(new \Symfony\Component\Lock\Store\InMemoryStore());
    $lock = $factory->createLock('resource', 30.0);
    return $lock->acquire();
}

function test_lock_key(): string
{
    $key = new \Symfony\Component\Lock\Key('orders');
    return (string) $key;
}

function test_lock_no_lock(): bool
{
    return (new \Symfony\Component\Lock\NoLock())->acquire();
}
