namespace Symfony\Component\Lock {
    /**
     * Payload of `Key::__serialize`. `state` values are whatever `setState` stored.
     */
    type KeySerialized = struct {
        string $resource;
        ?float $expiringTime;
        array<string, mixed> $state;
    };

    /**
     * Overlay: serialized key fields. Unserialize also accepts the private `\0Class\0prop` keys, so that parameter stays a string map.
     */
    // @overlay-against: class Key implements \Stringable
    partial class Key {
        /**
         * @return \Symfony\Component\Lock\KeySerialized
         */
        // @overlay-against: function __serialize(): array
        public function __serialize(): \Symfony\Component\Lock\KeySerialized;

        /**
         * @param array<string, mixed> $data
         */
        // @overlay-against: function __unserialize(array $data): void
        public function __unserialize(array<string, mixed> $data): void;
    }
}
