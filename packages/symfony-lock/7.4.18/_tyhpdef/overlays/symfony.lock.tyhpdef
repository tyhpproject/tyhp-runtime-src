        private function getHashedKey(\Symfony\Component\Lock\Key $key): string;

        private function getUniqueToken(\Symfony\Component\Lock\Key $key): string;

        private function init(array<string, mixed> $options, float $gcProbability, int $initialTtl): void;

        private function randomlyPrune(): void;
    }

    /**
     * Overlay: PHPDoc shapes harvest left loose on `CombinedStore`.
