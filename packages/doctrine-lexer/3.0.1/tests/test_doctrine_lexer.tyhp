<?tyhp

function test_doctrine_token(): \Doctrine\Common\Lexer\Token<string, string>
{
    return new \Doctrine\Common\Lexer\Token<string, string>('select', 'T_SELECT', 0);
}

function test_doctrine_token_is_a(\Doctrine\Common\Lexer\Token<string, string> $token): bool
{
    return $token->isA('T_SELECT', 'T_FROM');
}

function test_doctrine_lexer_set_input(\Doctrine\Common\Lexer\AbstractLexer<string, string> $lexer): void
{
    $lexer->setInput('SELECT 1');
}

function test_doctrine_lexer_next_any(\Doctrine\Common\Lexer\AbstractLexer<string, string> $lexer): bool
{
    return $lexer->isNextTokenAny(['T_SELECT', 'T_FROM']);
}
