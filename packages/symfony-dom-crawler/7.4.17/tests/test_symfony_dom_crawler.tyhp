<?tyhp

function test_crawler_filter_text(): string
{
    $crawler = new \Symfony\Component\DomCrawler\Crawler('<html><body><p class="hi">Hello</p></body></html>');
    return $crawler->filter('p.hi')->text();
}

function test_crawler_attr(): ?string
{
    $crawler = new \Symfony\Component\DomCrawler\Crawler('<a href="/next">Next</a>');
    return $crawler->filter('a')->attr('href');
}
