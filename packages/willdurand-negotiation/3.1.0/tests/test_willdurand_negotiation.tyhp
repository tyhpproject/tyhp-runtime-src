<?tyhp

function test_willdurand_negotiator_best(\Negotiation\Negotiator $negotiator, string $header): ?\Negotiation\AcceptHeader
{
    return $negotiator->getBest($header, ['text/html', 'application/json']);
}

function test_willdurand_accept_parts(\Negotiation\Accept $accept): string
{
    return $accept->getBasePart();
}

function test_willdurand_has_parameter(\Negotiation\BaseAccept $accept, string $key): bool
{
    return $accept->hasParameter($key);
}
