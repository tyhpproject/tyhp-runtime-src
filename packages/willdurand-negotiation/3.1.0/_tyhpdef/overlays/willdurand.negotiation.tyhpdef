<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * Priorities are header strings. Parameter maps are string to string.
 * PHPDoc `integer` / `boolean` names from Layer 1 are not Tyhp types.
 */

namespace Negotiation {
    /**
     * `Negotiator::splitSubPart()` pair: subtype, then the segment after `+`.
     */
    type PlusSubPart = struct {
        string 0 as $subPart;
        string 1 as $plusPart;
    };

    // @overlay-against: class AbstractNegotiator
    partial class AbstractNegotiator {
        // @overlay-against: function getBest(string $header, array $priorities, mixed $strict): \Negotiation\AcceptHeader|null
        public function getBest(string $header, array<int|string, string> $priorities, bool $strict = false): \Negotiation\AcceptHeader|null;

        // @overlay-against: function match(\Negotiation\AcceptHeader $header, \Negotiation\AcceptHeader $priority, integer $index): \Negotiation\AcceptMatch|null
        protected function match(\Negotiation\AcceptHeader $header, \Negotiation\AcceptHeader $priority, int $index): \Negotiation\AcceptMatch|null;
    }

    // @overlay-against: class Accept extends \Negotiation\BaseAccept implements \Negotiation\AcceptHeader
    partial class Accept {
        // @overlay-against: function __construct(mixed $value): void
        public function __construct(string $value): void;
    }

    // @overlay-against: class AcceptLanguage extends \Negotiation\BaseAccept implements \Negotiation\AcceptHeader
    partial class AcceptLanguage {
        // @overlay-against: function __construct(mixed $value): void
        public function __construct(string $value): void;
    }

    // @overlay-against: class AcceptMatch
    partial class AcceptMatch {
        // @overlay-against: function reduce(array $carry, \Negotiation\AcceptMatch $match): array
        public static function reduce(array<int, \Negotiation\AcceptMatch> $carry, \Negotiation\AcceptMatch $match): array<int, \Negotiation\AcceptMatch>;

        // @overlay-against: function __construct(mixed $quality, mixed $score, mixed $index): void
        public function __construct(float $quality, int $score, int $index): void;
    }

    // @overlay-against: class BaseAccept
    partial class BaseAccept {
        // @overlay-against: function getParameter(string $key, mixed $default): string|null
        public function getParameter<T = null>(string $key, T $default = null): string|T;

        // @overlay-against: function getParameters(): array
        public function getParameters(): array<string, string>;

        // @overlay-against: function hasParameter(string $key): boolean
        public function hasParameter(string $key): bool;
    }

    // @overlay-against: class CharsetNegotiator extends \Negotiation\AbstractNegotiator
    partial class CharsetNegotiator {
        // @overlay-against: function acceptFactory(mixed $accept): mixed
        protected function acceptFactory(string $accept): \Negotiation\AcceptCharset;
    }

    // @overlay-against: class EncodingNegotiator extends \Negotiation\AbstractNegotiator
    partial class EncodingNegotiator {
        // @overlay-against: function acceptFactory(mixed $accept): mixed
        protected function acceptFactory(string $accept): \Negotiation\AcceptEncoding;
    }

    // @overlay-against: class LanguageNegotiator extends \Negotiation\AbstractNegotiator
    partial class LanguageNegotiator {
        // @overlay-against: function acceptFactory(mixed $accept): mixed
        protected function acceptFactory(string $accept): \Negotiation\AcceptLanguage;

        // @overlay-against: function match(\Negotiation\AcceptHeader $acceptLanguage, \Negotiation\AcceptHeader $priority, mixed $index): mixed
        protected function match(\Negotiation\AcceptHeader $acceptLanguage, \Negotiation\AcceptHeader $priority, int $index): \Negotiation\AcceptMatch|null;
    }

    // @overlay-against: class Negotiator extends \Negotiation\AbstractNegotiator
    partial class Negotiator {
        // @overlay-against: function acceptFactory(mixed $accept): mixed
        protected function acceptFactory(string $accept): \Negotiation\Accept;

        // @overlay-against: function match(\Negotiation\AcceptHeader $accept, \Negotiation\AcceptHeader $priority, mixed $index): mixed
        protected function match(\Negotiation\AcceptHeader $accept, \Negotiation\AcceptHeader $priority, int $index): \Negotiation\AcceptMatch|null;

        // @overlay-against: function splitSubPart(mixed $subPart): mixed
        protected function splitSubPart(string $subPart): PlusSubPart;
    }
}
