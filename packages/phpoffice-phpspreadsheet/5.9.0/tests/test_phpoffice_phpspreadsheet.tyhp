<?tyhp

function test_spreadsheet_create(): \PhpOffice\PhpSpreadsheet\Spreadsheet
{
    return new \PhpOffice\PhpSpreadsheet\Spreadsheet();
}

function test_spreadsheet_sheet(\PhpOffice\PhpSpreadsheet\Spreadsheet $spreadsheet): \PhpOffice\PhpSpreadsheet\Worksheet\Worksheet
{
    return $spreadsheet->getActiveSheet();
}

function test_spreadsheet_cell(\PhpOffice\PhpSpreadsheet\Worksheet\Worksheet $sheet): \PhpOffice\PhpSpreadsheet\Cell\Cell
{
    return $sheet->getCell('A1');
}
