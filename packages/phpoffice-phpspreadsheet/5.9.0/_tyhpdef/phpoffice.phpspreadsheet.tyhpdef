        *  *                             Descending = -1 (self::ORDER_DESCENDING)
        *  *                        additional arrays or ranges for multi-level sorting
        * @return mixed The sorted values from the sort range
        * @generated
        */
        public static function sortBy(mixed $sortArray, mixed ...$args): mixed;
    }
