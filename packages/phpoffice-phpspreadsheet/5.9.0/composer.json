{
    "name": "tyhpdef/phpoffice-phpspreadsheet",
    "description": "Tyhp type definitions for the Composer package phpoffice/phpspreadsheet (5.9.0).",
    "keywords": [
        "dev",
        "static analysis"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "5.9.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-simple-cache": "@dev",
                "tyhpdef/php-ext-dom": "@dev",
                "tyhpdef/php-ext-zip": "@dev",
                "tyhpdef/php-ext-simplexml": "@dev",
                "tyhpdef/php-ext-xmlwriter": "@dev",
                "tyhpdef/php-ext-gd": "@dev",
                "tyhpdef/maennchen-zipstream-php": "@dev",
                "tyhpdef/psr-http-message": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "phpoffice/phpspreadsheet": "5.9.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-simple-cache": "@dev",
        "tyhpdef/php-ext-dom": "@dev",
        "tyhpdef/php-ext-zip": "@dev",
        "tyhpdef/php-ext-simplexml": "@dev",
        "tyhpdef/php-ext-xmlwriter": "@dev",
        "tyhpdef/php-ext-gd": "@dev",
        "tyhpdef/maennchen-zipstream-php": "@dev",
        "tyhpdef/psr-http-message": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../php"
        },
        {
            "type": "path",
            "url": "../../php-ext-dom"
        },
        {
            "type": "path",
            "url": "../../php-ext-zip"
        },
        {
            "type": "path",
            "url": "../../php-ext-simplexml"
        },
        {
            "type": "path",
            "url": "../../php-ext-xmlwriter"
        },
        {
            "type": "path",
            "url": "../../php-ext-gd"
        },
        {
            "type": "path",
            "url": "../../psr-simple-cache/3.0.0"
        },
        {
            "type": "path",
            "url": "../../maennchen-zipstream-php/3.2.2"
        },
        {
            "type": "path",
            "url": "../../psr-http-message/2.0"
        }
    ]
}
