<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: `_tyhpdef/overlays/*.tyhpdef` (not under overlays/stubs/).
 * purify() accepts an omitted config (PHPDoc allows HTMLPurifier_Config::create() inputs).
 */

type ParsedContents = struct {
    string|null 1 as $contentModel;
    string|null 0 as $contentModelType;
};

type TinyMceAllowedList = struct {
    array<string, bool> 1 as $attributes;
    array<string, bool> 0 as $elements;
};

/**
 * Overlay: omitted config is null, matching the PHP default.
 */
// @overlay-against: class HTMLPurifier
partial class HTMLPurifier {
    // @overlay-against: function purify(string $html, \HTMLPurifier_Config $config): string
    public function purify(string $html, ?\HTMLPurifier_Config $config = null): string;
}

/**
 * Overlay: Zipper PHPDoc `Tuple` / `Original` are not types.
 */
// @overlay-against: class HTMLPurifier_Zipper
partial class HTMLPurifier_Zipper {
    // @overlay-against: function fromArray(mixed $array): Tuple
    public static function fromArray(mixed $array): mixed;

    // @overlay-against: function next(mixed $t): Original
    public function next(mixed $t): mixed;

    // @overlay-against: function advance(mixed $t, mixed $n): Original
    public function advance(mixed $t, mixed $n): mixed;

    // @overlay-against: function prev(mixed $t): Original
    public function prev(mixed $t): mixed;

    // @overlay-against: function delete(): Original
    public function delete(): mixed;
}

/**
 * Attribute bags are associative. Values stay mixed.
 */
// @overlay-against: class HTMLPurifier_AttrTransform
partial class HTMLPurifier_AttrTransform {
    // @overlay-against: function transform(array $attr, \HTMLPurifier_Config $config, \HTMLPurifier_Context $context): array
    public function transform(array<string, mixed> $attr, \HTMLPurifier_Config $config, \HTMLPurifier_Context $context): array<string, mixed>;
}

