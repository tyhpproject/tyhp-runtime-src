<?tyhp

function test_mime_address(): string
{
    return \Symfony\Component\Mime\Address::create('dev@example.com')->getAddress();
}

function test_mime_email(): string
{
    $email = (new \Symfony\Component\Mime\Email())
        ->from('from@example.com')
        ->to('to@example.com')
        ->subject('Hello')
        ->text('plain')
        ->html('<p>hi</p>');
    return $email->getSubject() ?? '';
}

function test_mime_types(): array<int, string>
{
    return (new \Symfony\Component\Mime\MimeTypes())->getMimeTypes('json');
}
