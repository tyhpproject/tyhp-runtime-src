<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Translator `get()` is a string for a simple key, or a nested array of lines.
 */

namespace Illuminate\Translation {
    /**
     * `Translator::parseKey()` triple: namespace, group, then item.
     */
    type ParsedTranslationKey = struct {
        string 0 as $namespace;
        string 1 as $group;
        string 2 as $item;
    };

    /**
     * Overlay: array-loader `load()` is a string-keyed message map.
     */
    // @overlay-against: class ArrayLoader implements \Illuminate\Contracts\Translation\Loader
    partial class ArrayLoader {
        // @overlay-against: function addMessages(string $locale, string $group, array $messages, string|null $namespace): static
        public function addMessages(string $locale, string $group, array<string, mixed> $messages, string|null $namespace = null): static;
        // @overlay-against: function load(string $locale, string $group, string|null $namespace): array
        public function load(string $locale, string $group, string|null $namespace = null): array<string, mixed>;
    }

    /**
     * Overlay: loader paths are directory lists.
     */
    // @overlay-against: class FileLoader implements \Illuminate\Contracts\Translation\Loader
    partial class FileLoader {
        // @overlay-against: function jsonPaths(): array
        public function jsonPaths(): array<int, string>;
        // @overlay-against: function paths(): array
        public function paths(): array<int, string>;
    }

    /**
     * Overlay: `choose()` picks a plural line.
     */
    // @overlay-against: class MessageSelector
    partial class MessageSelector {
        // @overlay-against: function choose(string $line, int|float $number, string $locale): mixed
        public function choose(string $line, int|float $number, string $locale): string;
        // @overlay-against: function getPluralIndex(string $locale, int|float $number): int
        public function getPluralIndex(string $locale, int|float $number): int;
    }

    /**
     * Overlay: deferred services are the translator and the loader.
     */
    // @overlay-against: class TranslationServiceProvider extends \Illuminate\Support\ServiceProvider implements \Illuminate\Contracts\Support\DeferrableProvider
    partial class TranslationServiceProvider {
        // @overlay-against: function provides(): array
        public function provides(): array<int, string>;
    }

    /**
     * Overlay: a translation key is namespace, group, and item.
     */
    // @overlay-against: class Translator extends \Illuminate\Support\NamespacedItemResolver implements \Illuminate\Contracts\Translation\Translator, \Illuminate\Support\Traits\Macroable, \Illuminate\Support\Traits\ReflectsClosures
    partial class Translator {
        // @overlay-against: function parseKey(string $key): array
        public function parseKey(string $key): ParsedTranslationKey;
    }
}
