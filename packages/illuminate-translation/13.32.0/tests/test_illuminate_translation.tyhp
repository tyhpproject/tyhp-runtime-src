<?tyhp

function test_array_loader(): \Illuminate\Translation\ArrayLoader
{
    return new \Illuminate\Translation\ArrayLoader();
}

function test_message_selector(): string
{
    return (new \Illuminate\Translation\MessageSelector())->choose('a|b', 1, 'en');
}

function test_translator(): \Illuminate\Translation\Translator
{
    return new \Illuminate\Translation\Translator(new \Illuminate\Translation\ArrayLoader(), 'en');
}
