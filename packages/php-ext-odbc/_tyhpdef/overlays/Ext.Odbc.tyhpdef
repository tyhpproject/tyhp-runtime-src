<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Array shapes and result-identifier returns. Layer 1 already gates
 * `resource` vs `\Odbc\Connection` / `\Odbc\Result` at PHP 8.4.
 */

/**
 * odbc_data_source() row: DSN server name and description.
 */
type OdbcDataSource = struct {
    string $description;
    string $server;
};

