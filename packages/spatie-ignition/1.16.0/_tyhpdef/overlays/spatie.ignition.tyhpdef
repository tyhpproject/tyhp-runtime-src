        /**
         * @param array<int, mixed> $metaData
         */
        // @overlay-against: function glow(string $name, string $messageLevel, array $metaData): self
        public function glow(string $name, string $messageLevel = 'info', array<int, mixed> $metaData = []): self;

        /**
         * @param array<int, \Spatie\ErrorSolutions\Contracts\HasSolutionsForThrowable|\__ClassName> $solutionProviders
         */
        // @overlay-against: function addSolutionProviders(array $solutionProviders): self
        public function addSolutionProviders(array<int, \Spatie\ErrorSolutions\Contracts\HasSolutionsForThrowable|\__ClassName> $solutionProviders): self;
    }

    // @overlay-against: class Ignition
    partial class Ignition {
        /**
         * Overlay: `Ignition::resolveDocumentationLink()` uses the documented types.
         */
        // @overlay-against: function resolveDocumentationLink(callable $callable): self
        public function resolveDocumentationLink(callable(\Throwable): mixed $callable): self;

        // @overlay-against: function configureFlare(callable $callable): self
