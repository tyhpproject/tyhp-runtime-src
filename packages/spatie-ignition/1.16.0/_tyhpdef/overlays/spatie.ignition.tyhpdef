}

namespace Spatie\Ignition\Config {
    /**
     * Overlay: `FileConfigManager::getPersistentInfo()` returns the settings file location.
     */
    type FileConfigManagerPersistentInfo = struct {
        string $name;
        string $path;
        string $file;
    };

    // @overlay-against: class FileConfigManager implements \Spatie\Ignition\Contracts\ConfigManager
    partial class FileConfigManager {
        /**
         * Overlay: `FileConfigManager::getPersistentInfo()` returns the settings file location.
         */
        // @overlay-against: function getPersistentInfo(): array
        public function getPersistentInfo(): FileConfigManagerPersistentInfo;

        /**
         * Overlay: `FileConfigManager::load()` reads a JSON object.
         */
        // @overlay-against: function load(): array
        public function load(): array<string, mixed>;

        /**
         * Overlay: `FileConfigManager::save()` writes a JSON object.
         */
        // @overlay-against: function save(array $options): bool
        public function save(array<string, mixed> $options): bool;
    }

    /**
     * Overlay: config arrays implement Illuminate Arrayable from tyhpdef/illuminate-contracts.
     */
    // @overlay-against: class IgnitionConfig implements \Illuminate\Contracts\Support\Arrayable
    partial class IgnitionConfig implements \Illuminate\Contracts\Support\Arrayable<string, string|bool|array<string, mixed>|null>;
}

namespace Spatie\Ignition\Contracts {
    // @overlay-against: interface ConfigManager
    partial interface ConfigManager {
        /**
         * Overlay: `ConfigManager::getPersistentInfo()` returns the settings file location.
         */
        // @overlay-against: function getPersistentInfo(): array
        public function getPersistentInfo(): \Spatie\Ignition\Config\FileConfigManagerPersistentInfo;

        /**
         * Overlay: `ConfigManager::load()` is a JSON object.
         */
        // @overlay-against: function load(): array
        public function load(): array<string, mixed>;

        /**
         * Overlay: `ConfigManager::save()` writes a JSON object.
         */
        // @overlay-against: function save(array $options): bool
        public function save(array<string, mixed> $options): bool;
    }
}

