<?tyhpdef
/**
 * LAYER 3 (hand overlay) — Tyhp-authored. Never regenerated.
 * Path: _tyhpdef/overlays/*.tyhpdef  (not under overlays/stubs/)
 * Declaration order: TYHPDEF_ORDERING.md.
 * Cursor iterator generics, BSON document maps, and driver option bags.
 * BSON documents stay `array<string, mixed>|object`: the document is open.
 */

namespace MongoDB\BSON {
    /**
     * Overlay: BSON document. Keys are strings; values stay open.
     */
    type BsonDocument = array<string, mixed>|object;

    /**
     * Overlay: `setTypeMap()` / `toPHP()` `$typeMap`.
     * Values are `"array"`, `"object"`, `"bson"`, or a class name.
     */
    type BsonTypeMap = struct {
        ?string $array;
        ?string $document;
        ?string $root;
    };

    // @overlay-against: class Binary implements \MongoDB\BSON\Type, \MongoDB\BSON\BinaryInterface, \JsonSerializable, \Stringable
    partial class Binary {
        // @overlay-against: function fromVector(array $vector, \MongoDB\BSON\VectorType $vectorType): self
        static public function fromVector(array<int, int|float> $vector, \MongoDB\BSON\VectorType $vectorType): self;
    }

    // @overlay-against: class Document implements \IteratorAggregate, \ArrayAccess, \MongoDB\BSON\Type, \Stringable
    partial class Document implements \IteratorAggregate<string, mixed>, \ArrayAccess<string, mixed>, \MongoDB\BSON\Type, \Stringable;
    // @overlay-against: class Document implements \IteratorAggregate, \ArrayAccess, \MongoDB\BSON\Type, \Stringable
    partial class Document {
        // @overlay-against: function fromPHP(array|object $value): \MongoDB\BSON\Document
        static public function fromPHP(BsonDocument $value): \MongoDB\BSON\Document;
        // @overlay-against: function toPHP(?array $typeMap): array|object
        public function toPHP(?BsonTypeMap $typeMap = null): BsonDocument;
    }

    // @overlay-against: class Javascript implements \MongoDB\BSON\Type, \MongoDB\BSON\JavascriptInterface, \JsonSerializable, \Stringable
    partial class Javascript {
        // @overlay-against: function __construct(string $javascript, array|object|null $scope): void
        public function __construct(string $javascript, ?BsonDocument $scope = null);
    }

    // @overlay-against: class PackedArray implements \IteratorAggregate, \ArrayAccess, \MongoDB\BSON\Type, \Stringable
    partial class PackedArray implements \IteratorAggregate<int, mixed>, \ArrayAccess<int, mixed>, \MongoDB\BSON\Type, \Stringable;
    // @overlay-against: class PackedArray implements \IteratorAggregate, \ArrayAccess, \MongoDB\BSON\Type, \Stringable
    partial class PackedArray {
        // @overlay-against: function fromPHP(array $value): \MongoDB\BSON\PackedArray
        static public function fromPHP(array<int, mixed> $value): \MongoDB\BSON\PackedArray;
        // @overlay-against: function toPHP(?array $typeMap): array|object
        public function toPHP(?BsonTypeMap $typeMap = null): array<int, mixed>|object;
    }
}

namespace MongoDB\Driver {
    /**
     * Overlay: driver option bag. Keys are strings; values stay open.
     */
    type DriverOptions = array<string, mixed>;

    // @overlay-against: class BulkWrite implements \Countable
    partial class BulkWrite {
        // @overlay-against: function __construct(array $options): void
        public function __construct(?DriverOptions $options = null);
        // @overlay-against: function delete(array|object $filter, array|null $deleteOptions): void
        public function delete(\MongoDB\BSON\BsonDocument $filter, ?DriverOptions $deleteOptions = null): void;
        // @overlay-against: function insert(array|object $document): mixed
        public function insert(\MongoDB\BSON\BsonDocument $document): mixed;
        // @overlay-against: function update(array|object $filter, array|object $newObj, array|null $updateOptions): mixed
        public function update(\MongoDB\BSON\BsonDocument $filter, \MongoDB\BSON\BsonDocument $newObj, ?DriverOptions $updateOptions = null): mixed;
    }

    // @overlay-against: class BulkWriteCommand implements \Countable
    partial class BulkWriteCommand {
        // @overlay-against: function __construct(array|null $options): void
        public function __construct(?DriverOptions $options = null);
        // @overlay-against: function deleteMany(string $namespace, array|object $filter, array|null $options): void
        public function deleteMany(string $namespace, \MongoDB\BSON\BsonDocument $filter, ?DriverOptions $options = null): void;
        // @overlay-against: function deleteOne(string $namespace, array|object $filter, array|null $options): void
        public function deleteOne(string $namespace, \MongoDB\BSON\BsonDocument $filter, ?DriverOptions $options = null): void;
        // @overlay-against: function insertOne(string $namespace, array|object $document): mixed
        public function insertOne(string $namespace, \MongoDB\BSON\BsonDocument $document): mixed;
        // @overlay-against: function replaceOne(string $namespace, array|object $filter, array|object $replacement, array|null $options): void
        public function replaceOne(string $namespace, \MongoDB\BSON\BsonDocument $filter, \MongoDB\BSON\BsonDocument $replacement, ?DriverOptions $options = null): void;
        // @overlay-against: function updateMany(string $namespace, array|object $filter, array|object $update, array|null $options): void
        public function updateMany(string $namespace, \MongoDB\BSON\BsonDocument $filter, \MongoDB\BSON\BsonDocument $update, ?DriverOptions $options = null): void;
        // @overlay-against: function updateOne(string $namespace, array|object $filter, array|object $update, array|null $options): void
        public function updateOne(string $namespace, \MongoDB\BSON\BsonDocument $filter, \MongoDB\BSON\BsonDocument $update, ?DriverOptions $options = null): void;
    }

    // @overlay-against: class ClientEncryption
    partial class ClientEncryption {
        // @overlay-against: function __construct(array $options): void
        public function __construct(DriverOptions $options);
        // @overlay-against: function encryptExpression(array|object $expr, array|null $options): object
        public function encryptExpression(\MongoDB\BSON\BsonDocument $expr, ?DriverOptions $options = null): object;
        // @overlay-against: function rewrapManyDataKey(array|object $filter, array|null $options): object
        public function rewrapManyDataKey(\MongoDB\BSON\BsonDocument $filter, ?DriverOptions $options = null): object;
    }

    // @overlay-against: class Command
    partial class Command {
        // @overlay-against: function __construct(array|object $document, array|null $commandOptions): void
        public function __construct(\MongoDB\BSON\BsonDocument $document, ?DriverOptions $commandOptions = null);
    }

    // @overlay-against: class Cursor implements \MongoDB\Driver\CursorInterface
    partial class Cursor implements \MongoDB\Driver\CursorInterface, \Iterator<int, array|object>;
    // @overlay-against: class Cursor implements \MongoDB\Driver\CursorInterface
    partial class Cursor {
        // @overlay-against: function setTypeMap(array $typemap): void
        public function setTypeMap(\MongoDB\BSON\BsonTypeMap $typemap): void;
    }

    // @overlay-against: interface CursorInterface
    partial interface CursorInterface extends \Iterator<int, array|object>;
    // @overlay-against: interface CursorInterface
    partial interface CursorInterface {
        // @overlay-against: function setTypeMap(array $typemap): void
        public function setTypeMap(\MongoDB\BSON\BsonTypeMap $typemap): void;
    }

    // @overlay-against: class Manager
    partial class Manager {
        // @overlay-against: function __construct(?string $uri, array|null $uriOptions, array|null $driverOptions): void
        public function __construct(?string $uri = null, ?DriverOptions $uriOptions = null, ?DriverOptions $driverOptions = null);
        // @overlay-against: function createClientEncryption(array $options): \MongoDB\Driver\ClientEncryption
        public function createClientEncryption(DriverOptions $options): \MongoDB\Driver\ClientEncryption;
        // @overlay-against: function executeBulkWrite(string $namespace, \MongoDB\Driver\BulkWrite $bulk, array|null $options): \MongoDB\Driver\WriteResult
        public function executeBulkWrite(string $namespace, \MongoDB\Driver\BulkWrite $bulk, ?DriverOptions $options = null): \MongoDB\Driver\WriteResult;
        // @overlay-against: function executeBulkWriteCommand(\MongoDB\Driver\BulkWriteCommand $bulkWriteCommand, array|null $options): \MongoDB\Driver\BulkWriteCommandResult
        public function executeBulkWriteCommand(\MongoDB\Driver\BulkWriteCommand $bulkWriteCommand, ?DriverOptions $options = null): \MongoDB\Driver\BulkWriteCommandResult;
        // @overlay-against: function executeCommand(string $db, \MongoDB\Driver\Command $command, array|null $options): \MongoDB\Driver\CursorInterface
        public function executeCommand(string $db, \MongoDB\Driver\Command $command, ?DriverOptions $options = null): \MongoDB\Driver\CursorInterface;
        // @overlay-against: function executeQuery(string $namespace, \MongoDB\Driver\Query $query, array|null $options): \MongoDB\Driver\CursorInterface
        public function executeQuery(string $namespace, \MongoDB\Driver\Query $query, ?DriverOptions $options = null): \MongoDB\Driver\CursorInterface;
        // @overlay-against: function executeReadCommand(string $db, \MongoDB\Driver\Command $command, array|null $options): \MongoDB\Driver\CursorInterface
        public function executeReadCommand(string $db, \MongoDB\Driver\Command $command, ?DriverOptions $options = null): \MongoDB\Driver\CursorInterface;
        // @overlay-against: function executeReadWriteCommand(string $db, \MongoDB\Driver\Command $command, array|null $options): \MongoDB\Driver\CursorInterface
        public function executeReadWriteCommand(string $db, \MongoDB\Driver\Command $command, ?DriverOptions $options = null): \MongoDB\Driver\CursorInterface;
        // @overlay-against: function executeWriteCommand(string $db, \MongoDB\Driver\Command $command, array|null $options): \MongoDB\Driver\CursorInterface
        public function executeWriteCommand(string $db, \MongoDB\Driver\Command $command, ?DriverOptions $options = null): \MongoDB\Driver\CursorInterface;
        // @overlay-against: function getEncryptedFieldsMap(): array|object|null
        public function getEncryptedFieldsMap(): ?\MongoDB\BSON\BsonDocument;
        // @overlay-against: function startSession(array|null $options): \MongoDB\Driver\Session
        public function startSession(?DriverOptions $options = null): \MongoDB\Driver\Session;
    }

    // @overlay-against: class Query
    partial class Query {
        // @overlay-against: function __construct(array|object $filter, array|null $queryOptions): void
        public function __construct(\MongoDB\BSON\BsonDocument $filter, ?DriverOptions $queryOptions = null);
    }

    // @overlay-against: class ReadPreference implements \MongoDB\BSON\Serializable
    partial class ReadPreference {
        // @overlay-against: function __construct(string $mode, array|null $tagSets, array|null $options): void
        public function __construct(string $mode, ?array<int, array<string, string>> $tagSets = null, ?DriverOptions $options = null);
        // @overlay-against: function getTagSets(): array
        public function getTagSets(): array<int, array<string, string>>;
    }

    // @overlay-against: class Server
    partial class Server {
        // @overlay-against: function executeBulkWrite(string $namespace, \MongoDB\Driver\BulkWrite $bulkWrite, array|null $options): \MongoDB\Driver\WriteResult
        public function executeBulkWrite(string $namespace, \MongoDB\Driver\BulkWrite $bulkWrite, ?DriverOptions $options = null): \MongoDB\Driver\WriteResult;
        // @overlay-against: function executeBulkWriteCommand(\MongoDB\Driver\BulkWriteCommand $bulkWriteCommand, array|null $options): \MongoDB\Driver\BulkWriteCommandResult
        public function executeBulkWriteCommand(\MongoDB\Driver\BulkWriteCommand $bulkWriteCommand, ?DriverOptions $options = null): \MongoDB\Driver\BulkWriteCommandResult;
        // @overlay-against: function executeCommand(string $db, \MongoDB\Driver\Command $command, array|null $options): \MongoDB\Driver\CursorInterface
        public function executeCommand(string $db, \MongoDB\Driver\Command $command, ?DriverOptions $options = null): \MongoDB\Driver\CursorInterface;
        // @overlay-against: function executeQuery(string $namespace, \MongoDB\Driver\Query $query, array|\MongoDB\Driver\ReadPreference|null $options): \MongoDB\Driver\CursorInterface
        public function executeQuery(string $namespace, \MongoDB\Driver\Query $query, DriverOptions|\MongoDB\Driver\ReadPreference|null $options = null): \MongoDB\Driver\CursorInterface;
        // @overlay-against: function executeReadCommand(string $db, \MongoDB\Driver\Command $command, array|null $options): \MongoDB\Driver\CursorInterface
        public function executeReadCommand(string $db, \MongoDB\Driver\Command $command, ?DriverOptions $options = null): \MongoDB\Driver\CursorInterface;
        // @overlay-against: function executeReadWriteCommand(string $db, \MongoDB\Driver\Command $command, array|null $options): \MongoDB\Driver\CursorInterface
        public function executeReadWriteCommand(string $db, \MongoDB\Driver\Command $command, ?DriverOptions $options = null): \MongoDB\Driver\CursorInterface;
        // @overlay-against: function executeWriteCommand(string $db, \MongoDB\Driver\Command $command, array|null $options): \MongoDB\Driver\CursorInterface
        public function executeWriteCommand(string $db, \MongoDB\Driver\Command $command, ?DriverOptions $options = null): \MongoDB\Driver\CursorInterface;
    }

    // @overlay-against: class Session
    partial class Session {
        // @overlay-against: function advanceClusterTime(array|object $clusterTime): void
        public function advanceClusterTime(\MongoDB\BSON\BsonDocument $clusterTime): void;
        // @overlay-against: function startTransaction(array|object $options): void
        public function startTransaction(?\MongoDB\BSON\BsonDocument $options = null): void;
    }
}
