<?tyhp

function test_php_http_discovery_psr17(): \Psr\Http\Message\RequestFactoryInterface
{
    return \Http\Discovery\Psr17FactoryDiscovery::findRequestFactory();
}

function test_php_http_discovery_psr18(): \Psr\Http\Client\ClientInterface
{
    return \Http\Discovery\Psr18ClientDiscovery::find();
}

function test_php_http_discovery_async(): \Http\Client\HttpAsyncClient
{
    return \Http\Discovery\HttpAsyncClientDiscovery::find();
}

function test_php_http_discovery_psr17_factory(): \Http\Discovery\Psr17Factory
{
    return new \Http\Discovery\Psr17Factory();
}

function test_php_http_discovery_from_globals(\Http\Discovery\Psr17Factory $factory): \Psr\Http\Message\ServerRequestInterface
{
    return $factory->createServerRequestFromGlobals(['REQUEST_METHOD' => 'GET', 'HTTP_HOST' => 'example.com']);
}

function test_php_http_discovery_psr18_client(\Psr\Http\Client\ClientInterface $client, \Psr\Http\Message\RequestInterface $request): \Psr\Http\Message\ResponseInterface
{
    return (new \Http\Discovery\Psr18Client($client))->sendRequest($request);
}

function test_php_http_discovery_safe_class_exists(): bool
{
    return \Http\Discovery\ClassDiscovery::safeClassExists(\stdClass::class);
}

function test_php_http_discovery_message_factory(): \Http\Message\MessageFactory
{
    return \Http\Discovery\MessageFactoryDiscovery::find();
}
