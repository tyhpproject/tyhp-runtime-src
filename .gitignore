# macOS
.DS_Store
._*

# .NET (compiler is the sibling checkout, not this repo)
bin/
obj/
TestResults/

# tyhp/compiler package: Composer bin is packages/tyhp/compiler/bin/tyhp.
!packages/tyhp/compiler/bin/
!packages/tyhp/compiler/bin/**
packages/tyhp/compiler/native/
packages/tyhp/compiler/.phpunit.cache/
packages/tyhp/core/.phpunit.cache/

# Emit, Composer installs, and local test output
build/
dist/
out/
packages/dist/
packages/tyhp/*/vendor/
packages/tyhpdef/*/vendor/
packages/tyhpdef/*/*/vendor/
packages/tyhp/*/tests/build/
packages/tyhpdef/*/tests/build/
packages/tyhpdef/*/*/tests/build/
**/.phpunit.cache/

tyhp.pid
.tyhp-cache/
tyhp-build-state.json

*.bak
*.bak.*

# Local Cursor state. The two package rules below are part of this repo.
.cursor/*
!.cursor/rules/
.cursor/rules/*
!.cursor/rules/runtime-package-compile-failures.mdc
!.cursor/rules/runtime-generated-php-no-git-restore.mdc
!.cursor/rules/tyhp.mdc
!.cursor/skills/
.cursor/skills/*
!.cursor/skills/tyhp

# Packagist MAIN API token for scripts/publish-runtime-packages.sh
packagist.credentials
scripts/packagist.credentials

# Repos already confirmed on tyhpproject-packages (publish-runtime-packages.sh)
.github-repo-cache

__pycache__/

# generate_tyhpdef snapshots (cwd when new-php-ext.sh runs from this repo)
tyhpdef_gen/

packages/tyhpdef-issues.txt

# Scan cache and generated public metapackages (not source)
.packagist-scan-cache/
.public-meta/
