# macOS
.DS_Store
._*

# .NET (compiler is the sibling checkout, not this repo)
bin/
obj/
TestResults/

# tyhp/compiler package: Composer bin is packages/compiler/bin/tyhp.
!packages/compiler/bin/
!packages/compiler/bin/**
packages/compiler/native/
packages/compiler/.phpunit.cache/
packages/core/.phpunit.cache/

# Emit, Composer installs, and local test output
build/
dist/
out/
packages/dist/
packages/*/vendor/
packages/*/*/vendor/
packages/*/tests/build/
packages/*/*/tests/build/
**/.phpunit.cache/

tyhp.pid
.tyhp-cache/
tyhp-build-state.json

*.bak
*.bak.*

# Local Cursor state. The two package rules below are part of this repo.
.cursor/*
!.cursor/rules/
.cursor/rules/*
!.cursor/rules/runtime-package-compile-failures.mdc
!.cursor/rules/runtime-generated-php-no-git-restore.mdc

# Packagist MAIN API token for scripts/publish-runtime-packages.sh
packagist.credentials
scripts/packagist.credentials

__pycache__/

# generate_tyhpdef snapshots (cwd when new-php-ext.sh runs from this repo)
tyhpdef_gen/

packages/tyhpdef-issues.txt

# Scan cache and generated public metapackages (not source)
.packagist-scan-cache/
.public-meta/
