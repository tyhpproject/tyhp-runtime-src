# Copy to scripts/packagist.credentials (gitignored).
# MAIN API token from https://packagist.org/profile/
# Used by scripts/publish-runtime-packages.sh and scripts/update-packagist-packages.sh.
# The publish script creates missing packages with --create-packagist-packages
# and, whenever this file exists, queues an update for repos Packagist has not crawled.
PACKAGIST_USERNAME=
PACKAGIST_API_TOKEN=
